    {
        let buf = make_pattern_buf(256 * 1024, 0xAA);
        let path = format!("{}/tdefl_compressor_ops.perf.bin", dir);
        fs::write(&path, &buf).unwrap();
        lines.push(format!("perf tdefl_compressor_ops {}", path));
    }

    {
        let src = make_pattern_buf(256 * 1024, 0x33);
        let flags = unsafe { tdefl_create_comp_flags_from_zip_params(6, 15, 0) } as i32;
        let mut out = vec![0u8; 512 * 1024];
        let sz = unsafe {
            tdefl_compress_mem_to_mem(
                out.as_mut_ptr() as *mut ::core::ffi::c_void, out.len(),
                src.as_ptr() as *const ::core::ffi::c_void, src.len(), flags,
            )
        };
        let path = format!("{}/tinfl_heap_callback.perf.bin", dir);
        fs::write(&path, &out[..sz]).unwrap();
        lines.push(format!("perf tinfl_heap_callback {}", path));
    }

    {
        let data = make_pattern_buf(64 * 1024, 0x55);
        let z = make_zip_archive(&[(b"big.bin\0", &data)], 6);
        let path = format!("{}/zip_validate.perf.bin", dir);
        fs::write(&path, &z).unwrap();
        lines.push(format!("perf zip_validate {}", path));
    }

    {
        let data = make_pattern_buf(64 * 1024, 0x66);
        let z = make_zip_archive(&[(b"iter.bin\0", &data)], 6);
        let path = format!("{}/zip_iter_extract.perf.bin", dir);
        fs::write(&path, &z).unwrap();
        lines.push(format!("perf zip_iter_extract {}", path));
