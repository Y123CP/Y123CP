    // tinfl_decompress_raw: large compressed buffer
    {
        let src = make_pattern_buf(512 * 1024, 0x77);
        let flags = unsafe {
            miniz_raw::src::miniz_tdef::tdefl_create_comp_flags_from_zip_params(6, -15, 0)
        } as i32;
        let mut out = vec![0u8; 1024 * 1024];
        let sz = unsafe {
            tdefl_compress_mem_to_mem(
                out.as_mut_ptr() as *mut ::core::ffi::c_void,
                out.len(),
                src.as_ptr() as *const ::core::ffi::c_void,
                src.len(),
                flags,
            )
        };
        let path = format!("{}/tinfl_decompress_raw.perf.bin", dir);
        fs::write(&path, &out[..sz]).unwrap();
        lines.push(format!("perf tinfl_decompress_raw {}", path));
    }

    // checksum_ops: large buffer
    {
        let buf = make_pattern_buf(1024 * 1024, 0xBB);
        let path = format!("{}/checksum_ops.perf.bin", dir);
        fs::write(&path, &buf).unwrap();
        lines.push(format!("perf checksum_ops {}", path));
    }

    // zip_roundtrip: moderately large buffer
    {
        let buf = make_pattern_buf(256 * 1024, 0xDD);
        let path = format!("{}/zip_roundtrip.perf.bin", dir);
        fs::write(&path, &buf).unwrap();
        lines.push(format!("perf zip_roundtrip {}", path));
    }

    lines
}
