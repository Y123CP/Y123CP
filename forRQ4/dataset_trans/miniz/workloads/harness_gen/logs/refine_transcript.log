fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(5) ^ x
}

fn checksum_bytes(data: &[u8]) -> u64 {
    let mut h: u64 = 0;
    for &b in data {
        h = h.wrapping_mul(131).wrapping_add(b as u64);
    }
    h
}

const MZ_OK: i32 = 0;
const MZ_STREAM_END: i32 = 1;
const MZ_FINISH: i32 = 4;
const MZ_NO_FLUSH: i32 = 0;
const TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF: i32 = 2;

const SENTINEL_NO_ZIP: u64 = 0xDE_AD00_01;
const SENTINEL_NO_EXT1: u64 = 0xDE_AD00_02;
const SENTINEL_NO_EXT2: u64 = 0xDE_AD00_03;
const SENTINEL_NO_ALLOC: u64 = 0xDE_AD00_04;
const SENTINEL_FAIL_1111: u64 = 0xFA_110001;
const SENTINEL_FAIL_2222: u64 = 0xFA_110002;
const SENTINEL_FAIL_3333: u64 = 0xFA_110003;
const SENTINEL_ALLOC_OK: u64 = 0xA1_1C0000;
const SENTINEL_DEAD_HEAP: u64 = 0xDE_AD0005;
const SENTINEL_DEAD_4: u64 = 0xDE_AD0006;
const SENTINEL_DEAD_7: u64 = 0xDE_AD0007;
const SENTINEL_BAD_0021: u64 = 0xBAD_0021;
const SENTINEL_BAD_1111: u64 = 0xBAD_1111;
const SENTINEL_CB_FAIL: u64 = 0xCB_FA11;
const SENTINEL_FIO_FAIL: u64 = 0xF1_0FA11;
const SENTINEL_SRC_FAIL: u64 = 0x5C_FA11_01;
const SENTINEL_SRC_RD_FAIL: u64 = 0x5C_FA11_02;
const SENTINEL_PNG_FAIL_BASE: u64 = 0xF0_000001;
const SENTINEL_PNG_FL2_BASE: u64 = 0xF0_000002;
const SENTINEL_PNG_SIM: u64 = 0xF0_000003;

unsafe fn create_zip_archive(entries: &[(&[u8], &[u8])], level: u32) -> (*mut ::core::ffi::c_void, usize) {
    let mut zip_w = MaybeUninit::<mz_zip_archive>::zeroed();
    let pz_w = zip_w.as_mut_ptr();
    mz_zip_zero_struct(pz_w);

    let ret = mz_zip_writer_init_heap(pz_w, 0, 0);
    if ret == 0 {
        mz_zip_writer_end(pz_w);
        return (ptr::null_mut(), 0);
    }

    for (name, data) in entries {
        let ret = mz_zip_writer_add_mem(
            pz_w,
            name.as_ptr() as *const i8,
            data.as_ptr() as *const ::core::ffi::c_void,
            data.len(),
            level,
        );
        if ret == 0 {
            mz_zip_writer_end(pz_w);
            return (ptr::null_mut(), 0);
        }
    }

    let mut archive_buf: *mut ::core::ffi::c_void = ptr::null_mut();
    let mut archive_size: usize = 0;

    let ret = mz_zip_writer_finalize_heap_archive(pz_w, &mut archive_buf, &mut archive_size);
    if ret == 0 {
        mz_zip_writer_end(pz_w);
        return (ptr::null_mut(), 0);
    }

    mz_zip_writer_end(pz_w);
    (archive_buf, archive_size)
}

fn op_compress_decompress(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;

    for _ in 0..iters {
        unsafe {
            let source_len = data.len() as u64;
            let bound = mz_compressBound(source_len);
            let mut comp_buf: Vec<u8> = vec![0u8; bound as usize];
            let mut comp_len: u64 = bound;

            let ret = mz_compress(
                comp_buf.as_mut_ptr(),
                &mut comp_len,
                data.as_ptr(),
                source_len,
            );

            if ret != MZ_OK {
                last_err = ret;
                digest = fold(digest, ret as u64);
                digest = fold(digest, data.len() as u64);
                continue;
            }

            let mut comp_buf2: Vec<u8> = vec![0u8; bound as usize];
            let mut comp_len2: u64 = bound;
            let ret_c2 = mz_compress2(
                comp_buf2.as_mut_ptr(),
                &mut comp_len2,
                data.as_ptr(),
                source_len,
                1,
            );
            digest = fold(digest, ret_c2 as u64);
            digest = fold(digest, comp_len2);

            let mut decomp_buf: Vec<u8> = vec![0u8; data.len() + 1];
            let mut decomp_len: u64 = decomp_buf.len() as u64;

            let ret2 = mz_uncompress(
                decomp_buf.as_mut_ptr(),
                &mut decomp_len,
                comp_buf.as_ptr(),
                comp_len,
            );

            if ret2 != MZ_OK {
                last_err = ret2;
                digest = fold(digest, ret2 as u64);
                digest = fold(digest, comp_len);
                continue;
            }

            let mut decomp_buf2: Vec<u8> = vec![0u8; data.len() + 1];
            let mut decomp_len2: u64 = decomp_buf2.len() as u64;
            let mut src_len2: u64 = comp_len;
            let ret3 = mz_uncompress2(
                decomp_buf2.as_mut_ptr(),
                &mut decomp_len2,
                comp_buf.as_ptr(),
                &mut src_len2,
            );

            let cs = checksum_bytes(&decomp_buf[..decomp_len as usize]);
            digest = fold(digest, comp_len);
            digest = fold(digest, decomp_len);
            digest = fold(digest, cs);
            digest = fold(digest, ret3 as u64);
            last_err = 0;
        }
    }

    format!("op=compress_decompress err={} digest={:016x}", last_err, digest)
}

fn op_deflate_inflate_stream(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;

    for _ in 0..iters {
        unsafe {
            let mut stream = MaybeUninit::<mz_stream>::zeroed();
            let s = stream.as_mut_ptr();

            let ret = mz_deflateInit(s, 6);
            if ret != MZ_OK {
                last_err = ret;
                digest = fold(digest, ret as u64);
                continue;
            }

            let bound = mz_deflateBound(s, data.len() as u64);
            let mut comp_buf: Vec<u8> = vec![0u8; bound as usize];

            (*s).next_in = data.as_ptr();
            (*s).avail_in = data.len() as u32;
            (*s).next_out = comp_buf.as_mut_ptr();
            (*s).avail_out = comp_buf.len() as u32;

            let dret = mz_deflate(s, MZ_FINISH);
            let comp_size = (*s).total_out;

            mz_deflateEnd(s);

            if dret != MZ_STREAM_END {
                last_err = dret;
                digest = fold(digest, dret as u64);
                continue;
            }

            let mut istream = MaybeUninit::<mz_stream>::zeroed();
            let is = istream.as_mut_ptr();

            let ret2 = mz_inflateInit(is);
            if ret2 != MZ_OK {
                last_err = ret2;
                digest = fold(digest, ret2 as u64);
                continue;
            }

            let mut decomp_buf: Vec<u8> = vec![0u8; data.len() + 1];

            (*is).next_in = comp_buf.as_ptr();
            (*is).avail_in = comp_size as u32;
            (*is).next_out = decomp_buf.as_mut_ptr();
            (*is).avail_out = decomp_buf.len() as u32;

            let iret = mz_inflate(is, MZ_FINISH);
            let decomp_size = (*is).total_out;

            mz_inflateEnd(is);

            let cs = checksum_bytes(&decomp_buf[..decomp_size as usize]);
            digest = fold(digest, dret as u64);
            digest = fold(digest, comp_size);
            digest = fold(digest, iret as u64);
            digest = fold(digest, decomp_size);
            digest = fold(digest, cs);
            last_err = 0;
        }
    }

    format!("op=deflate_inflate_stream err={} digest={:016x}", last_err, digest)
}

fn op_deflate_reset_reuse(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;

    for _ in 0..iters {
        unsafe {
            let mut stream = MaybeUninit::<mz_stream>::zeroed();
            let s = stream.as_mut_ptr();

            let ret = mz_deflateInit2(s, 6, 8, -15, 9, 0);
            if ret != MZ_OK {
                last_err = ret;
                digest = fold(digest, ret as u64);
                continue;
            }

            let bound = mz_deflateBound(s, data.len() as u64);
            let mut comp_buf: Vec<u8> = vec![0u8; bound as usize];

            (*s).next_in = data.as_ptr();
            (*s).avail_in = data.len() as u32;
            (*s).next_out = comp_buf.as_mut_ptr();
            (*s).avail_out = comp_buf.len() as u32;

            let dret = mz_deflate(s, MZ_FINISH);
            let comp_size1 = (*s).total_out;
            digest = fold(digest, dret as u64);
            digest = fold(digest, comp_size1);

            let rret = mz_deflateReset(s);
            digest = fold(digest, rret as u64);

            if rret == MZ_OK {
                let mut comp_buf2: Vec<u8> = vec![0u8; bound as usize];
                (*s).next_in = data.as_ptr();
                (*s).avail_in = data.len() as u32;
                (*s).next_out = comp_buf2.as_mut_ptr();
                (*s).avail_out = comp_buf2.len() as u32;

                let dret2 = mz_deflate(s, MZ_FINISH);
                let comp_size2 = (*s).total_out;
                digest = fold(digest, dret2 as u64);
                digest = fold(digest, comp_size2);
            }

            mz_deflateEnd(s);

            if dret == MZ_STREAM_END {
                let mut istream = MaybeUninit::<mz_stream>::zeroed();
                let is = istream.as_mut_ptr();

                let ret2 = mz_inflateInit2(is, -15);
                if ret2 == MZ_OK {
                    let mut decomp_buf: Vec<u8> = vec![0u8; data.len() + 1];
                    (*is).next_in = comp_buf.as_ptr();
                    (*is).avail_in = comp_size1 as u32;
                    (*is).next_out = decomp_buf.as_mut_ptr();
                    (*is).avail_out = decomp_buf.len() as u32;

                    let iret = mz_inflate(is, MZ_FINISH);
                    let decomp_size = (*is).total_out;
                    digest = fold(digest, iret as u64);
                    digest = fold(digest, decomp_size);

                    let irret = mz_inflateReset(is);
                    digest = fold(digest, irret as u64);

                    mz_inflateEnd(is);
                }
            }

            last_err = 0;
        }
    }

    format!("op=deflate_reset_reuse err={} digest={:016x}", last_err, digest)
}

fn op_tinfl_decompress_raw(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let failed_sentinel = usize::MAX;

    for _ in 0..iters {
        unsafe {
            let out_cap: usize = 1024 * 1024;
            let mut out_buf: Vec<u8> = vec![0u8; out_cap];

            let ret = tinfl_decompress_mem_to_mem(
                out_buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                out_cap,
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len(),
                TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF,
            );

            if ret == failed_sentinel {
                digest = fold(digest, ret as u64);
                digest = fold(digest, data.len() as u64);
                let end = data.len().min(64);
                digest = fold(digest, checksum_bytes(&data[..end]));
            } else {
                let cs = checksum_bytes(&out_buf[..ret]);
                digest = fold(digest, ret as u64);
                digest = fold(digest, cs);
            }
        }
    }

    format!("op=tinfl_decompress_raw digest={:016x}", digest)
}

unsafe extern "C" fn tinfl_put_buf_callback(
    p_buf: *const ::core::ffi::c_void,
    len: i32,
    p_user: *mut ::core::ffi::c_void,
) -> i32 {
    if !p_user.is_null() && !p_buf.is_null() && len > 0 {
        let digest_ptr = p_user as *mut u64;
        let sl = std::slice::from_raw_parts(p_buf as *const u8, len as usize);
        let cs = checksum_bytes(sl);
        *digest_ptr = fold(*digest_ptr, cs);
        *digest_ptr = fold(*digest_ptr, len as u64);
    }
    1
}

fn op_tinfl_heap_callback(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    let input_cs = checksum_bytes(data);
    digest = fold(digest, input_cs);
    digest = fold(digest, data.len() as u64);

    for _ in 0..iters {
        unsafe {
            {
                let mut out_len: usize = 0;
                let ptr_out = tinfl_decompress_mem_to_heap(
                    data.as_ptr() as *const ::core::ffi::c_void,
                    data.len(),
                    &mut out_len,
                    0,
                );

                if ptr_out.is_null() {
                    digest = fold(digest, SENTINEL_DEAD_HEAP);
                    digest = fold(digest, out_len as u64);
                } else {
                    let sl = std::slice::from_raw_parts(ptr_out as *const u8, out_len);
                    let cs = checksum_bytes(sl);
                    digest = fold(digest, out_len as u64);
                    digest = fold(digest, cs);
                    mz_free(ptr_out);
                }
            }

            {
                let mut out_len2: usize = 0;
                let ptr_out2 = tinfl_decompress_mem_to_heap(
                    data.as_ptr() as *const ::core::ffi::c_void,
                    data.len(),
                    &mut out_len2,
                    TINFL_FLAG_USING_NON_WRAPPING_OUTPUT_BUF,
                );

                if ptr_out2.is_null() {
                    digest = fold(digest, SENTINEL_DEAD_7);
                    digest = fold(digest, out_len2 as u64);
                } else {
                    let sl = std::slice::from_raw_parts(ptr_out2 as *const u8, out_len2);
                    let cs = checksum_bytes(sl);
                    digest = fold(digest, out_len2 as u64);
                    digest = fold(digest, cs);
                    mz_free(ptr_out2);
                }
            }

            {
                let mut cb_digest: u64 = 0;
                let mut src_len = data.len();

                let ret = tinfl_decompress_mem_to_callback(
                    data.as_ptr() as *const ::core::ffi::c_void,
                    &mut src_len,
                    Some(tinfl_put_buf_callback),
                    &mut cb_digest as *mut u64 as *mut ::core::ffi::c_void,
                    0,
                );
                digest = fold(digest, ret as u64);
                digest = fold(digest, src_len as u64);
                digest = fold(digest, cb_digest);
            }

            {
                let decomp = tinfl_decompressor_alloc();
                if !decomp.is_null() {
                    tinfl_decompressor_free(decomp);
                    digest = fold(digest, SENTINEL_ALLOC_OK);
                }
            }

            {
                let max_out = 1024 * 1024usize;
                let mut decomp_buf: Vec<u8> = vec![0u8; max_out];
                let mut decomp_len: u64 = max_out as u64;

                let ret = mz_uncompress(
                    decomp_buf.as_mut_ptr(),
                    &mut decomp_len,
                    data.as_ptr(),
                    data.len() as u64,
                );

                digest = fold(digest, ret as u64);
                if ret == MZ_OK {
                    let cs = checksum_bytes(&decomp_buf[..decomp_len as usize]);
                    digest = fold(digest, decomp_len);
                    digest = fold(digest, cs);
                } else {
                    digest = fold(digest, decomp_len);
                }
            }
        }
    }

    format!("op=tinfl_heap_callback digest={:016x}", digest)
}

fn op_checksum_ops(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let adler = mz_adler32(1, data.as_ptr(), data.len());
            let crc = mz_crc32(0, data.as_ptr(), data.len());

            let half = data.len() / 2;
            let adler1 = mz_adler32(1, data.as_ptr(), half);
            let adler2 = mz_adler32(adler1, data.as_ptr().add(half), data.len() - half);
            let crc1 = mz_crc32(0, data.as_ptr(), half);
            let crc2 = mz_crc32(crc1, data.as_ptr().add(half), data.len() - half);

            digest = fold(digest, adler);
            digest = fold(digest, crc);
            digest = fold(digest, adler2);
            digest = fold(digest, crc2);
        }
    }

    format!("op=checksum_ops digest={:016x}", digest)
}

fn op_zip_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;

    let archive_name = b"test_file.bin\0";
    let archive_name2 = b"second_file.txt\0";

    for _ in 0..iters {
        unsafe {
            let half = data.len() / 2;
            let data1 = &data[..half];
            let data2 = &data[half..];

            let entries: Vec<(&[u8], &[u8])> = vec![
                (archive_name.as_ref(), data1),
                (archive_name2.as_ref(), data2),
            ];

            let (archive_buf, archive_size) = create_zip_archive(&entries, 6);
            if archive_buf.is_null() {
                last_err = -1;
                digest = fold(digest, SENTINEL_NO_ZIP);
                continue;
            }

            let mut zip_r = MaybeUninit::<mz_zip_archive>::zeroed();
            let pz_r = zip_r.as_mut_ptr();
            mz_zip_zero_struct(pz_r);

            let ret = mz_zip_reader_init_mem(pz_r, archive_buf, archive_size, 0);
            if ret == 0 {
                last_err = -4;
                digest = fold(digest, SENTINEL_DEAD_4);
                mz_free(archive_buf);
                continue;
            }

            let num_files = mz_zip_reader_get_num_files(pz_r);
            digest = fold(digest, num_files as u64);

            let mode = mz_zip_get_mode(pz_r);
            let ztype = mz_zip_get_type(pz_r);
            let is_z64 = mz_zip_is_zip64(pz_r);
            let cd_size = mz_zip_get_central_dir_size(pz_r);
            let arc_size = mz_zip_get_archive_size(pz_r);
            let start_ofs = mz_zip_get_archive_file_start_offset(pz_r);
            let cfile = mz_zip_get_cfile(pz_r);

            digest = fold(digest, mode as u64);
            digest = fold(digest, ztype as u64);
            digest = fold(digest, is_z64 as u64);
            digest = fold(digest, cd_size as u64);
            digest = fold(digest, arc_size);
            digest = fold(digest, start_ofs);
            digest = fold(digest, cfile as u64);

            let err = mz_zip_peek_last_error(pz_r);
            let err_str = mz_zip_get_error_string(err);
            if !err_str.is_null() {
                let s = CStr::from_ptr(err_str);
                digest = fold(digest, checksum_bytes(s.to_bytes()));
            }

            let _ = mz_zip_clear_last_error(pz_r);
            let _ = mz_zip_set_last_error(pz_r, 0);
            let _ = mz_zip_get_last_error(pz_r);

            for i in 0..num_files {
                let mut stat = MaybeUninit::<mz_zip_archive_file_stat>::zeroed();
                let pstat = stat.as_mut_ptr();
                let stat_ok = mz_zip_reader_file_stat(pz_r, i, pstat);
                if stat_ok != 0 {
                    digest = fold(digest, (*pstat).m_uncomp_size);
                    digest = fold(digest, (*pstat).m_comp_size);
                }

                let mut fname_buf = [0i8; 256];
                let fname_len = mz_zip_reader_get_filename(
                    pz_r, i, fname_buf.as_mut_ptr(), 256,
                );
                digest = fold(digest, fname_len as u64);

                let is_dir = mz_zip_reader_is_file_a_directory(pz_r, i);
                let is_enc = mz_zip_reader_is_file_encrypted(pz_r, i);
                let is_sup = mz_zip_reader_is_file_supported(pz_r, i);
                digest = fold(digest, is_dir as u64);
                digest = fold(digest, is_enc as u64);
                digest = fold(digest, is_sup as u64);
            }

            let loc = mz_zip_reader_locate_file(
                pz_r,
                archive_name.as_ptr() as *const i8,
                ptr::null(),
                0,
            );
            digest = fold(digest, loc as u64);

            let mut idx: u32 = 0;
            let loc2 = mz_zip_reader_locate_file_v2(
                pz_r,
                archive_name2.as_ptr() as *const i8,
                ptr::null(),
                0,
                &mut idx,
            );
            digest = fold(digest, loc2 as u64);
            digest = fold(digest, idx as u64);

            let mut extracted_size: usize = 0;
            let extracted = mz_zip_reader_extract_to_heap(pz_r, 0, &mut extracted_size, 0);
            if !extracted.is_null() {
                let sl = std::slice::from_raw_parts(extracted as *const u8, extracted_size);
                digest = fold(digest, checksum_bytes(sl));
                mz_free(extracted);
            }

            let mut ext_size2: usize = 0;
            let ext2 = mz_zip_reader_extract_file_to_heap(
                pz_r,
                archive_name2.as_ptr() as *const i8,
                &mut ext_size2,
                0,
            );
            if !ext2.is_null() {
                let sl = std::slice::from_raw_parts(ext2 as *const u8, ext_size2);
                digest = fold(digest, checksum_bytes(sl));
                mz_free(ext2);
            }

            if num_files > 0 {
                let mut stat = MaybeUninit::<mz_zip_archive_file_stat>::zeroed();
                mz_zip_reader_file_stat(pz_r, 0, stat.as_mut_ptr());
                let uncomp = (*stat.as_ptr()).m_uncomp_size as usize;
                if uncomp > 0 && uncomp < 1024 * 1024 {
                    let mut buf = vec![0u8; uncomp];
                    let ret = mz_zip_reader_extract_to_mem(
                        pz_r, 0,
                        buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                        uncomp, 0,
                    );
                    digest = fold(digest, ret as u64);

                    let mut buf2 = vec![0u8; uncomp];
                    let mut read_buf = vec![0u8; 65536];
                    let ret2 = mz_zip_reader_extract_to_mem_no_alloc(
                        pz_r, 0,
                        buf2.as_mut_ptr() as *mut ::core::ffi::c_void,
                        uncomp, 0,
                        read_buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                        read_buf.len(),
                    );
                    digest = fold(digest, ret2 as u64);

                    let mut buf3 = vec![0u8; uncomp];
                    let ret3 = mz_zip_reader_extract_file_to_mem(
                        pz_r,
                        archive_name.as_ptr() as *const i8,
                        buf3.as_mut_ptr() as *mut ::core::ffi::c_void,
                        uncomp, 0,
                    );
                    digest = fold(digest, ret3 as u64);

                    let mut buf4 = vec![0u8; uncomp];
                    let mut read_buf2 = vec![0u8; 65536];
                    let ret4 = mz_zip_reader_extract_file_to_mem_no_alloc(
                        pz_r,
                        archive_name.as_ptr() as *const i8,
                        buf4.as_mut_ptr() as *mut ::core::ffi::c_void,
                        uncomp, 0,
                        read_buf2.as_mut_ptr() as *mut ::core::ffi::c_void,
                        read_buf2.len(),
                    );
                    digest = fold(digest, ret4 as u64);
                }
            }

            let vret = mz_zip_validate_archive(pz_r, 0);
            digest = fold(digest, vret as u64);

            if num_files > 0 {
                let vfret = mz_zip_validate_file(pz_r, 0, 0);
                digest = fold(digest, vfret as u64);
            }

            if archive_size > 0 {
                let rd_size = 64usize.min(archive_size);
                let mut rd_buf = vec![0u8; rd_size];
                let rd = mz_zip_read_archive_data(
                    pz_r, 0,
                    rd_buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                    rd_buf.len(),
                );
                digest = fold(digest, rd as u64);
            }

            unsafe extern "C" fn write_cb(
                _opaque: *mut ::core::ffi::c_void,
                _ofs: u64,
                _buf: *const ::core::ffi::c_void,
                n: usize,
            ) -> usize {
                n
            }

            if num_files > 0 {
                let cret = mz_zip_reader_extract_to_callback(
                    pz_r, 0, Some(write_cb), ptr::null_mut(), 0,
                );
                digest = fold(digest, cret as u64);

                let cret2 = mz_zip_reader_extract_file_to_callback(
                    pz_r,
                    archive_name.as_ptr() as *const i8,
                    Some(write_cb),
                    ptr::null_mut(),
                    0,
                );
                digest = fold(digest, cret2 as u64);
            }

            mz_zip_reader_end(pz_r);
            mz_free(archive_buf);
            last_err = 0;
        }
    }

    format!("op=zip_roundtrip err={} digest={:016x}", last_err, digest)
}

fn op_zip_extended(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;

    for _ in 0..iters {
        unsafe {
            let mut zip_w = MaybeUninit::<mz_zip_archive>::zeroed();
            let pz_w = zip_w.as_mut_ptr();
            mz_zip_zero_struct(pz_w);

            let ret = mz_zip_writer_init_heap_v2(pz_w, 0, 0, 0);
            if ret == 0 {
                mz_zip_writer_end(pz_w);
                digest = fold(digest, SENTINEL_FAIL_1111);
                continue;
            }

            let name = b"data.bin\0";
            let comment = b"test comment\0";

            let ret = mz_zip_writer_add_mem_ex(
                pz_w,
                name.as_ptr() as *const i8,
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len(),
                comment.as_ptr() as *const ::core::ffi::c_void,
                (comment.len() - 1) as u16,
                6,
                0, 0,
            );
            if ret == 0 {
                mz_zip_writer_end(pz_w);
                digest = fold(digest, SENTINEL_FAIL_2222);
                continue;
            }

            let name2 = b"data2.bin\0";
            let extra = b"extra_local\0";
            let extra_c = b"extra_central\0";
            let ret_v2 = mz_zip_writer_add_mem_ex_v2(
                pz_w,
                name2.as_ptr() as *const i8,
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len().min(256),
                ptr::null(),
                0,
                1,
                0, 0,
                ptr::null_mut(),
                extra.as_ptr() as *const i8,
                (extra.len() - 1) as u32,
                extra_c.as_ptr() as *const i8,
                (extra_c.len() - 1) as u32,
            );
            digest = fold(digest, ret_v2 as u64);

            let mut archive_buf: *mut ::core::ffi::c_void = ptr::null_mut();
            let mut archive_size: usize = 0;
            let ret = mz_zip_writer_finalize_heap_archive(pz_w, &mut archive_buf, &mut archive_size);
            if ret == 0 {
                mz_zip_writer_end(pz_w);
                digest = fold(digest, SENTINEL_FAIL_3333);
                continue;
            }
            mz_zip_writer_end(pz_w);

            digest = fold(digest, archive_size as u64);

            let mut val_err: mz_zip_error = 0;
            let vret = mz_zip_validate_mem_archive(
                archive_buf,
                archive_size,
                0,
                &mut val_err,
            );
            digest = fold(digest, vret as u64);
            digest = fold(digest, val_err as u64);

            let mut buf_owned = true;

            let mut zip_r = MaybeUninit::<mz_zip_archive>::zeroed();
            let pz_r = zip_r.as_mut_ptr();
            mz_zip_zero_struct(pz_r);

            let ret = mz_zip_reader_init_mem(pz_r, archive_buf, archive_size, 0);
            if ret != 0 {
                let num = mz_zip_reader_get_num_files(pz_r);
                digest = fold(digest, num as u64);

                if num > 0 {
                    let iter = mz_zip_reader_extract_iter_new(pz_r, 0, 0);
                    if !iter.is_null() {
                        let mut buf = vec![0u8; 4096];
                        loop {
                            let n = mz_zip_reader_extract_iter_read(
                                iter,
                                buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                                buf.len(),
                            );
                            if n == 0 { break; }
                            digest = fold(digest, checksum_bytes(&buf[..n]));
                        }
                        mz_zip_reader_extract_iter_free(iter);
                    }

                    let fiter = mz_zip_reader_extract_file_iter_new(
                        pz_r,
                        name.as_ptr() as *const i8,
                        0,
                    );
                    if !fiter.is_null() {
                        let mut buf = vec![0u8; 4096];
                        loop {
                            let n = mz_zip_reader_extract_iter_read(
                                fiter,
                                buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                                buf.len(),
                            );
                            if n == 0 { break; }
                            digest = fold(digest, checksum_bytes(&buf[..n]));
                        }
                        mz_zip_reader_extract_iter_free(fiter);
                    }
                }

                let wret = mz_zip_writer_init_from_reader_v2(pz_r, ptr::null(), 0);
                if wret != 0 {
                    let name3 = b"extra.bin\0";
                    let extra_data = b"hello extra";
                    let aret = mz_zip_writer_add_mem(
                        pz_r,
                        name3.as_ptr() as *const i8,
                        extra_data.as_ptr() as *const ::core::ffi::c_void,
                        extra_data.len(),
                        1,
                    );
                    digest = fold(digest, aret as u64);

                    mz_zip_writer_finalize_archive(pz_r);
                    mz_zip_writer_end(pz_r);
                    buf_owned = false;
                } else {
                    mz_zip_reader_end(pz_r);
                }
            }

            if buf_owned {
                mz_free(archive_buf);
            }
            last_err = 0;
        }
    }

    format!("op=zip_extended err={} digest={:016x}", last_err, digest)
}

fn op_zip_iter_extract(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let mut zip_r = MaybeUninit::<mz_zip_archive>::zeroed();
            let pz_r = zip_r.as_mut_ptr();
            mz_zip_zero_struct(pz_r);

            let ret = mz_zip_reader_init_mem(
                pz_r,
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len(),
                0,
            );
            if ret == 0 {
                digest = fold(digest, SENTINEL_BAD_0021);
                mz_zip_end(pz_r);
                continue;
            }

            let num = mz_zip_reader_get_num_files(pz_r);
            digest = fold(digest, num as u64);

            for i in 0..num.min(10) {
                let iter = mz_zip_reader_extract_iter_new(pz_r, i, 0);
                if !iter.is_null() {
                    let mut buf = vec![0u8; 4096];
                    let mut total = 0usize;
                    loop {
                        let n = mz_zip_reader_extract_iter_read(
                            iter,
                            buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                            buf.len(),
                        );
                        if n == 0 { break; }
                        total += n;
                        digest = fold(digest, checksum_bytes(&buf[..n]));
                    }
                    mz_zip_reader_extract_iter_free(iter);
                    digest = fold(digest, total as u64);
                }
            }

            mz_zip_reader_end(pz_r);
        }
    }

    format!("op=zip_iter_extract digest={:016x}", digest)
}

fn op_mz_misc(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let ver = mz_version();
            if !ver.is_null() {
                let s = CStr::from_ptr(ver);
                digest = fold(digest, checksum_bytes(s.to_bytes()));
            }

            for code in &[-6, -5, -4, -3, -2, -1, 0, 1, 2] {
                let e = mz_error(*code);
                if !e.is_null() {
                    let s = CStr::from_ptr(e);
                    digest = fold(digest, checksum_bytes(s.to_bytes()));
                }
            }

            for code in 0u32..20u32 {
                let e = mz_zip_get_error_string(code);
                if !e.is_null() {
                    let s = CStr::from_ptr(e);
                    digest = fold(digest, checksum_bytes(s.to_bytes()));
                }
            }

            let adler = mz_adler32(1, data.as_ptr(), data.len().min(64));
            digest = fold(digest, adler);
        }
    }

    format!("op=mz_misc digest={:016x}", digest)
}

fn op_zip_file_ops(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let tmp_dir = std::env::temp_dir();
            let unique_id = checksum_bytes(data) & 0xFFFF;
            let zip_path = tmp_dir.join(format!("harness_test_{}.zip", unique_id));
            let zip_path_str = format!("{}\0", zip_path.display());
            let zip_path_c = zip_path_str.as_ptr() as *const i8;

            let _ = fs::remove_file(&zip_path);

            let archive_name = b"entry.bin\0";

            let ret = mz_zip_add_mem_to_archive_file_in_place(
                zip_path_c,
                archive_name.as_ptr() as *const i8,
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len(),
                ptr::null(),
                0,
                6,
            );
            digest = fold(digest, ret as u64);

            let archive_name2 = b"entry2.bin\0";
            let mut err: mz_zip_error = 0;
            let ret2 = mz_zip_add_mem_to_archive_file_in_place_v2(
                zip_path_c,
                archive_name2.as_ptr() as *const i8,
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len().min(128),
                ptr::null(),
                0,
                1,
                &mut err,
            );
            digest = fold(digest, ret2 as u64);
            digest = fold(digest, err as u64);

            let mut ext_size: usize = 0;
            let ext = mz_zip_extract_archive_file_to_heap(
                zip_path_c,
                archive_name.as_ptr() as *const i8,
                &mut ext_size,
                0,
            );
            if !ext.is_null() {
                let sl = std::slice::from_raw_parts(ext as *const u8, ext_size);
                digest = fold(digest, checksum_bytes(sl));
                mz_free(ext);
            } else {
                digest = fold(digest, SENTINEL_NO_EXT1);
            }

            let mut ext_size2: usize = 0;
            let mut err2: mz_zip_error = 0;
            let ext2 = mz_zip_extract_archive_file_to_heap_v2(
                zip_path_c,
                archive_name2.as_ptr() as *const i8,
                ptr::null(),
                &mut ext_size2,
                0,
                &mut err2,
            );
            if !ext2.is_null() {
                let sl = std::slice::from_raw_parts(ext2 as *const u8, ext_size2);
                digest = fold(digest, checksum_bytes(sl));
                mz_free(ext2);
            } else {
                digest = fold(digest, SENTINEL_NO_EXT2);
            }
            digest = fold(digest, err2 as u64);

            let mut val_err: mz_zip_error = 0;
            let vfret = mz_zip_validate_file_archive(zip_path_c, 0, &mut val_err);
            digest = fold(digest, vfret as u64);
            digest = fold(digest, val_err as u64);

            {
                let mut zip_rf = MaybeUninit::<mz_zip_archive>::zeroed();
                let pz_rf = zip_rf.as_mut_ptr();
                mz_zip_zero_struct(pz_rf);

                let ret_rf = mz_zip_reader_init_file(pz_rf, zip_path_c, 0);
                if ret_rf != 0 {
                    let num = mz_zip_reader_get_num_files(pz_rf);
                    digest = fold(digest, num as u64);

                    if num > 0 {
                        let out_path = tmp_dir.join(format!("harness_out_{}.bin", unique_id));
                        let out_path_str = format!("{}\0", out_path.display());
                        let out_path_c = out_path_str.as_ptr() as *const i8;

                        let ef_ret = mz_zip_reader_extract_to_file(pz_rf, 0, out_path_c, 0);
                        digest = fold(digest, ef_ret as u64);

                        if ef_ret != 0 {
                            if let Ok(extracted_data) = fs::read(&out_path) {
                                digest = fold(digest, checksum_bytes(&extracted_data));
                            }
                        }

                        let out_path2 = tmp_dir.join(format!("harness_out2_{}.bin", unique_id));
                        let out_path2_str = format!("{}\0", out_path2.display());
                        let out_path2_c = out_path2_str.as_ptr() as *const i8;

                        let eff_ret = mz_zip_reader_extract_file_to_file(
                            pz_rf,
                            archive_name.as_ptr() as *const i8,
                            out_path2_c,
                            0,
                        );
                        digest = fold(digest, eff_ret as u64);

                        let _ = fs::remove_file(&out_path);
                        let _ = fs::remove_file(&out_path2);

                        let cfile_path = tmp_dir.join(format!("harness_cfile_{}.bin", unique_id));
                        let cfile_path_str = format!("{}\0", cfile_path.display());
                        let wb_mode = b"wb\0";
                        let cf = fopen(cfile_path_str.as_ptr() as *const i8, wb_mode.as_ptr() as *const i8);
                        if !cf.is_null() {
                            let ecf_ret = mz_zip_reader_extract_to_cfile(pz_rf, 0, cf, 0);
                            digest = fold(digest, ecf_ret as u64);
                            fclose(cf);
                        }

                        let cfile_path2 = tmp_dir.join(format!("harness_cfile2_{}.bin", unique_id));
                        let cfile_path2_str = format!("{}\0", cfile_path2.display());
                        let cf2 = fopen(cfile_path2_str.as_ptr() as *const i8, wb_mode.as_ptr() as *const i8);
                        if !cf2.is_null() {
                            let ecf2_ret = mz_zip_reader_extract_file_to_cfile(
                                pz_rf,
                                archive_name.as_ptr() as *const i8,
                                cf2,
                                0,
                            );
                            digest = fold(digest, ecf2_ret as u64);
                            fclose(cf2);
                        }

                        let _ = fs::remove_file(&cfile_path);
                        let _ = fs::remove_file(&cfile_path2);
                    }

                    let wret = mz_zip_writer_init_from_reader(pz_rf, zip_path_c);
                    if wret != 0 {
                        let add_name = b"added_from_reader.bin\0";
                        let add_data = b"from_reader_data";
                        let aret = mz_zip_writer_add_mem(
                            pz_rf,
                            add_name.as_ptr() as *const i8,
                            add_data.as_ptr() as *const ::core::ffi::c_void,
                            add_data.len(),
                            1,
                        );
                        digest = fold(digest, aret as u64);
                        mz_zip_writer_finalize_archive(pz_rf);
                        mz_zip_writer_end(pz_rf);
                    } else {
                        mz_zip_reader_end(pz_rf);
                    }
                } else {
                    mz_zip_end(pz_rf);
                }
            }

            let _ = fs::remove_file(&zip_path);
        }
    }

    format!("op=zip_file_ops digest={:016x}", digest)
}

fn op_zip_validate(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let mut val_err: mz_zip_error = 0;
            let vret = mz_zip_validate_mem_archive(
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len(),
                0,
                &mut val_err,
            );
            digest = fold(digest, vret as u64);
            digest = fold(digest, val_err as u64);

            let mut zip_r = MaybeUninit::<mz_zip_archive>::zeroed();
            let pz_r = zip_r.as_mut_ptr();
            mz_zip_zero_struct(pz_r);

            let ret = mz_zip_reader_init_mem(
                pz_r,
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len(),
                0,
            );
            if ret != 0 {
                let num = mz_zip_reader_get_num_files(pz_r);
                digest = fold(digest, num as u64);

                let va = mz_zip_validate_archive(pz_r, 0);
                digest = fold(digest, va as u64);

                for i in 0..num.min(10) {
                    let vf = mz_zip_validate_file(pz_r, i, 0);
                    digest = fold(digest, vf as u64);
                }

                mz_zip_reader_end(pz_r);
            } else {
                digest = fold(digest, SENTINEL_BAD_1111);
                mz_zip_end(pz_r);
            }
        }
    }

    format!("op=zip_validate digest={:016x}", digest)
}

fn op_tdefl_compressor_ops(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let comp = tdefl_compressor_alloc();
            if comp.is_null() {
                digest = fold(digest, SENTINEL_NO_ALLOC);
                continue;
            }

            let flags = tdefl_create_comp_flags_from_zip_params(1, -15, 0) as i32
                | 0x00080000;
            let status = tdefl_init(comp, None, ptr::null_mut(), flags);
            digest = fold(digest, status as u64);

            if status == 0 {
                let mut out_buf = vec![0u8; data.len() + 4096];
                let mut in_size = data.len();
                let mut out_size = out_buf.len();

                let cret = tdefl_compress(
                    comp,
                    data.as_ptr() as *const ::core::ffi::c_void,
                    &mut in_size,
                    out_buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                    &mut out_size,
                    4,
                );
                digest = fold(digest, cret as u64);
                digest = fold(digest, out_size as u64);

                let adler = tdefl_get_adler32(comp);
                digest = fold(digest, adler as u64);

                let prev = tdefl_get_prev_return_status(comp);
                digest = fold(digest, prev as u64);

                if cret == 1 && out_size > 0 {
                    let mut dec_buf = vec![0u8; data.len() + 1];
                    let dret = tinfl_decompress_mem_to_mem(
                        dec_buf.as_mut_ptr() as *mut ::core::ffi::c_void,
                        dec_buf.len(),
                        out_buf.as_ptr() as *const ::core::ffi::c_void,
                        out_size,
                        0,
                    );
                    digest = fold(digest, dret as u64);
                }
            }

            tdefl_compressor_free(comp);

            {
                let comp2 = tdefl_compressor_alloc();
                if !comp2.is_null() {
                    unsafe extern "C" fn tdefl_output_cb(
                        p_buf: *const ::core::ffi::c_void,
                        len: i32,
                        p_user: *mut ::core::ffi::c_void,
                    ) -> i32 {
                        if !p_user.is_null() && !p_buf.is_null() && len > 0 {
                            let d = p_user as *mut u64;
                            let sl = std::slice::from_raw_parts(p_buf as *const u8, len as usize);
                            *d = fold(*d, checksum_bytes(sl));
                        }
                        1
                    }

                    let mut cb_digest: u64 = 0;
                    let flags2 = tdefl_create_comp_flags_from_zip_params(6, -15, 0) as i32;
                    let st = tdefl_init(
                        comp2,
                        Some(tdefl_output_cb),
                        &mut cb_digest as *mut u64 as *mut ::core::ffi::c_void,
                        flags2,
                    );
                    if st == 0 {
                        let bret = tdefl_compress_buffer(
                            comp2,
                            data.as_ptr() as *const ::core::ffi::c_void,
                            data.len(),
                            4,
                        );
                        digest = fold(digest, bret as u64);
                        digest = fold(digest, cb_digest);
                    }
                    tdefl_compressor_free(comp2);
                }
            }

            {
                unsafe extern "C" fn output_cb2(
                    p_buf: *const ::core::ffi::c_void,
                    len: i32,
                    p_user: *mut ::core::ffi::c_void,
                ) -> i32 {
                    if !p_user.is_null() && !p_buf.is_null() && len > 0 {
                        let d = p_user as *mut u64;
                        let sl = std::slice::from_raw_parts(p_buf as *const u8, len as usize);
                        *d = fold(*d, checksum_bytes(sl));
                    }
                    1
                }

                let mut out_digest: u64 = 0;
                let flags_o = tdefl_create_comp_flags_from_zip_params(6, -15, 0) as i32;
                let oret = tdefl_compress_mem_to_output(
                    data.as_ptr() as *const ::core::ffi::c_void,
                    data.len(),
                    Some(output_cb2),
                    &mut out_digest as *mut u64 as *mut ::core::ffi::c_void,
                    flags_o,
                );
                digest = fold(digest, oret as u64);
                digest = fold(digest, out_digest);
            }

            let flags2 = tdefl_create_comp_flags_from_zip_params(6, 15, 0) as i32;
            let mut heap_len: usize = 0;
            let heap_ptr = tdefl_compress_mem_to_heap(
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len(),
                &mut heap_len,
                flags2,
            );
            if !heap_ptr.is_null() {
                digest = fold(digest, heap_len as u64);
                let sl = std::slice::from_raw_parts(heap_ptr as *const u8, heap_len);
                digest = fold(digest, checksum_bytes(&sl[..heap_len.min(256)]));
                mz_free(heap_ptr);
            }

            let flags3 = tdefl_create_comp_flags_from_zip_params(6, 15, 0) as i32;
            let mut out3 = vec![0u8; data.len() + 4096];
            let sz3 = tdefl_compress_mem_to_mem(
                out3.as_mut_ptr() as *mut ::core::ffi::c_void,
                out3.len(),
                data.as_ptr() as *const ::core::ffi::c_void,
                data.len(),
                flags3,
            );
            digest = fold(digest, sz3 as u64);
        }
    }

    format!("op=tdefl_compressor_ops digest={:016x}", digest)
}

fn op_png_write(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let w = if !data.is_empty() { (data[0] as i32 % 16) + 1 } else { 4 };
            let h = if data.len() > 1 { (data[1] as i32 % 16) + 1 } else { 4 };

            for num_chans in 1..=4i32 {
                let pixel_count = (w * h * num_chans) as usize;
                let mut pixel_data = vec![0u8; pixel_count];
                for i in 0..pixel_count {
                    let data_len = data.len().max(1);
                    let src_idx = if data.len() > 2 {
                        2 + (i % (data.len() - 2).max(1))
                    } else {
                        i % data_len
                    };
                    if src_idx < data.len() {
                        pixel_data[i] = data[src_idx];
                    }
                }

                let mut png_len: usize = 0;
                let png_ptr = tdefl_write_image_to_png_file_in_memory_ex(
                    pixel_data.as_ptr() as *const ::core::ffi::c_void,
                    w, h, num_chans,
                    &mut png_len,
                    6,
                    0,
                );
                if !png_ptr.is_null() && png_len > 0 {
                    let sl = std::slice::from_raw_parts(png_ptr as *const u8, png_len);
                    digest = fold(digest, checksum_bytes(&sl[..png_len.min(512)]));
                    digest = fold(digest, png_len as u64);
                    mz_free(png_ptr);
                } else {
                    digest = fold(digest, SENTINEL_PNG_FAIL_BASE.wrapping_add(num_chans as u64));
                }

                let mut png_len2: usize = 0;
                let png_ptr2 = tdefl_write_image_to_png_file_in_memory_ex(
                    pixel_data.as_ptr() as *const ::core::ffi::c_void,
                    w, h, num_chans,
                    &mut png_len2,
                    1,
                    1,
                );
                if !png_ptr2.is_null() && png_len2 > 0 {
                    let sl = std::slice::from_raw_parts(png_ptr2 as *const u8, png_len2);
                    digest = fold(digest, checksum_bytes(&sl[..png_len2.min(512)]));
                    digest = fold(digest, png_len2 as u64);
                    mz_free(png_ptr2);
                } else {
                    digest = fold(digest, SENTINEL_PNG_FL2_BASE.wrapping_add(num_chans as u64));
                }
            }

            {
                let w2 = 8;
                let h2 = 8;
                let chans = 3;
                let pixel_count = (w2 * h2 * chans) as usize;
                let mut pixels = vec![0u8; pixel_count];
                let data_len = data.len().max(1);
                for i in 0..pixel_count {
                    pixels[i] = data[i % data_len];
                }
                let mut png_len3: usize = 0;
                let png_ptr3 = tdefl_write_image_to_png_file_in_memory(
                    pixels.as_ptr() as *const ::core::ffi::c_void,
                    w2, h2, chans,
                    &mut png_len3,
                );
                if !png_ptr3.is_null() && png_len3 > 0 {
                    let sl = std::slice::from_raw_parts(png_ptr3 as *const u8, png_len3);
                    digest = fold(digest, checksum_bytes(&sl[..png_len3.min(512)]));
                    digest = fold(digest, png_len3 as u64);
                    mz_free(png_ptr3);
                } else {
                    digest = fold(digest, SENTINEL_PNG_SIM);
                }
            }

            digest = fold(digest, data.len() as u64);
        }
    }

    format!("op=png_write digest={:016x}", digest)
}

fn op_zip_file_io(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let tmp_dir = std::env::temp_dir();
            let unique_id = checksum_bytes(data) & 0xFFFF;
            let zip_path = tmp_dir.join(format!("harness_fio_{}.zip", unique_id));
            let zip_path_str = format!("{}\0", zip_path.display());
            let zip_path_c = zip_path_str.as_ptr() as *const i8;

            let _ = fs::remove_file(&zip_path);

            {
                let mut zip_w = MaybeUninit::<mz_zip_archive>::zeroed();
                let pz_w = zip_w.as_mut_ptr();
                mz_zip_zero_struct(pz_w);

                let ret = mz_zip_writer_init_file(pz_w, zip_path_c, 0);
                if ret != 0 {
                    let name = b"file_entry.bin\0";
                    let aret = mz_zip_writer_add_mem(
                        pz_w,
                        name.as_ptr() as *const i8,
                        data.as_ptr() as *const ::core::ffi::c_void,
                        data.len(),
                        6,
                    );
                    digest = fold(digest, aret as u64);

                    let src_file_path = tmp_dir.join(format!("harness_src_{}.bin", unique_id));
                    let _ = fs::write(&src_file_path, data);
                    let src_file_str = format!("{}\0", src_file_path.display());
                    let src_file_c = src_file_str.as_ptr() as *const i8;

                    let af_ret = mz_zip_writer_add_file(
                        pz_w,
                        b"from_file.bin\0".as_ptr() as *const i8,
                        src_file_c,
                        ptr::null(),
                        0,
                        6,
                    );
                    digest = fold(digest, af_ret as u64);

                    let _ = fs::remove_file(&src_file_path);

                    mz_zip_writer_finalize_archive(pz_w);
                    mz_zip_writer_end(pz_w);

                    let mut zip_r = MaybeUninit::<mz_zip_archive>::zeroed();
                    let pz_r = zip_r.as_mut_ptr();
                    mz_zip_zero_struct(pz_r);

                    let rret = mz_zip_reader_init_file_v2(pz_r, zip_path_c, 0, 0, 0);
                    if rret != 0 {
                        let num = mz_zip_reader_get_num_files(pz_r);
                        digest = fold(digest, num as u64);

                        for i in 0..num.min(5) {
                            let mut esize: usize = 0;
                            let eptr = mz_zip_reader_extract_to_heap(pz_r, i, &mut esize, 0);
                            if !eptr.is_null() {
                                let sl = std::slice::from_raw_parts(eptr as *const u8, esize);
                                digest = fold(digest, checksum_bytes(sl));
                                mz_free(eptr);
                            }
                        }
                        mz_zip_reader_end(pz_r);
                    } else {
                        mz_zip_end(pz_r);
                    }
                } else {
                    mz_zip_writer_end(pz_w);
                    digest = fold(digest, SENTINEL_FIO_FAIL);
                }
            }

            {
                let cfile_zip_path = tmp_dir.join(format!("harness_cfw_{}.zip", unique_id));
                let cfile_zip_str = format!("{}\0", cfile_zip_path.display());
                let wb_mode = b"wb\0";
                let cf = fopen(cfile_zip_str.as_ptr() as *const i8, wb_mode.as_ptr() as *const i8);
                if !cf.is_null() {
                    let mut zip_cw = MaybeUninit::<mz_zip_archive>::zeroed();
                    let pz_cw = zip_cw.as_mut_ptr();
                    mz_zip_zero_struct(pz_cw);

                    let cw_ret = mz_zip_writer_init_cfile(pz_cw, cf, 0);
                    if cw_ret != 0 {
                        let name = b"cfile_entry.bin\0";
                        let aret = mz_zip_writer_add_mem(
                            pz_cw,
                            name.as_ptr() as *const i8,
                            data.as_ptr() as *const ::core::ffi::c_void,
                            data.len().min(256),
                            1,
                        );
                        digest = fold(digest, aret as u64);

                        let src_cfile_path = tmp_dir.join(format!("harness_csrc_{}.bin", unique_id));
                        let _ = fs::write(&src_cfile_path, &data[..data.len().min(128)]);
                        let src_cfile_str = format!("{}\0", src_cfile_path.display());
                        let rb_mode = b"rb\0";
                        let src_cf = fopen(src_cfile_str.as_ptr() as *const i8, rb_mode.as_ptr() as *const i8);
                        if !src_cf.is_null() {
                            let acf_ret = mz_zip_writer_add_cfile(
                                pz_cw,
                                b"from_cfile.bin\0".as_ptr() as *const i8,
                                src_cf,
                                data.len().min(128) as u64,
                                ptr::null(),
                                ptr::null(),
                                0,
                                6,
                                ptr::null(),
                                0,
                                ptr::null(),
                                0,
                            );
                            digest = fold(digest, acf_ret as u64);
                            fclose(src_cf);
                        }
                        let _ = fs::remove_file(&src_cfile_path);

                        mz_zip_writer_finalize_archive(pz_cw);
                        mz_zip_writer_end(pz_cw);
                    } else {
                        mz_zip_writer_end(pz_cw);
                    }
                    fclose(cf);

                    let rb_mode = b"rb\0";
                    let cf_r = fopen(cfile_zip_str.as_ptr() as *const i8, rb_mode.as_ptr() as *const i8);
                    if !cf_r.is_null() {
                        let mut zip_cr = MaybeUninit::<mz_zip_archive>::zeroed();
                        let pz_cr = zip_cr.as_mut_ptr();
                        mz_zip_zero_struct(pz_cr);

                        let cr_ret = mz_zip_reader_init_cfile(pz_cr, cf_r, 0, 0);
                        if cr_ret != 0 {
                            let num = mz_zip_reader_get_num_files(pz_cr);
                            digest = fold(digest, num as u64);
                            mz_zip_reader_end(pz_cr);
                        } else {
                            mz_zip_end(pz_cr);
                        }
                        fclose(cf_r);
                    }
                }
                let _ = fs::remove_file(&tmp_dir.join(format!("harness_cfw_{}.zip", unique_id)));
            }

            let _ = fs::remove_file(&zip_path);
        }
    }

    format!("op=zip_file_io digest={:016x}", digest)
}

fn op_zip_writer_callback(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            unsafe extern "C" fn heap_write_cb(
                opaque: *mut ::core::ffi::c_void,
                ofs: u64,
                buf: *const ::core::ffi::c_void,
                n: usize,
            ) -> usize {
                if opaque.is_null() || buf.is_null() || n == 0 {
                    return 0;
                }
                let vec_ptr = opaque as *mut Vec<u8>;
                let vec = &mut *vec_ptr;
                let end = ofs as usize + n;
                if end > vec.len() {
                    vec.resize(end, 0);
                }
                let sl = std::slice::from_raw_parts(buf as *const u8, n);
                vec[ofs as usize..end].copy_from_slice(sl);
                n
            }

            let mut output_buf: Vec<u8> = Vec::new();

            let mut zip_w = MaybeUninit::<mz_zip_archive>::zeroed();
            let pz_w = zip_w.as_mut_ptr();
            mz_zip_zero_struct(pz_w);

            (*pz_w).m_pWrite = Some(heap_write_cb);
            (*pz_w).m_pIO_opaque = &mut output_buf as *mut Vec<u8> as *mut ::core::ffi::c_void;

            let ret = mz_zip_writer_init(pz_w, 0);
            if ret != 0 {
                let name = b"cb_entry.bin\0";
                let aret = mz_zip_writer_add_mem(
                    pz_w,
                    name.as_ptr() as *const i8,
                    data.as_ptr() as *const ::core::ffi::c_void,
                    data.len(),
                    6,
                );
                digest = fold(digest, aret as u64);

                unsafe extern "C" fn read_cb(
                    opaque: *mut ::core::ffi::c_void,
                    _ofs: u64,
                    buf: *mut ::core::ffi::c_void,
                    n: usize,
                ) -> usize {
                    if opaque.is_null() || buf.is_null() || n == 0 {
                        return 0;
                    }
                    let info = opaque as *mut (usize, *const u8, usize);
                    let (ref mut pos, data_ptr, data_len) = *info;
                    let remaining = data_len.saturating_sub(*pos);
                    let to_read = n.min(remaining);
                    if to_read > 0 {
                        std::ptr::copy_nonoverlapping(data_ptr.add(*pos), buf as *mut u8, to_read);
                        *pos += to_read;
                    }
                    to_read
                }

                let mut read_info: (usize, *const u8, usize) = (0, data.as_ptr(), data.len());
                let rcb_ret = mz_zip_writer_add_read_buf_callback(
                    pz_w,
                    b"from_callback.bin\0".as_ptr() as *const i8,
                    Some(read_cb),
                    &mut read_info as *mut _ as *mut ::core::ffi::c_void,
                    data.len() as u64,
                    ptr::null(),
                    ptr::null(),
                    0,
                    6,
                    ptr::null(),
                    0,
                    ptr::null(),
                    0,
                );
                digest = fold(digest, rcb_ret as u64);

                let fret = mz_zip_writer_finalize_archive(pz_w);
                digest = fold(digest, fret as u64);
                mz_zip_writer_end(pz_w);

                digest = fold(digest, output_buf.len() as u64);
                digest = fold(digest, checksum_bytes(&output_buf[..output_buf.len().min(256)]));

                if !output_buf.is_empty() {
                    let mut val_err: mz_zip_error = 0;
                    let vret = mz_zip_validate_mem_archive(
                        output_buf.as_ptr() as *const ::core::ffi::c_void,
                        output_buf.len(),
                        0,
                        &mut val_err,
                    );
                    digest = fold(digest, vret as u64);
                    digest = fold(digest, val_err as u64);
                }
            } else {
                mz_zip_writer_end(pz_w);
                digest = fold(digest, SENTINEL_CB_FAIL);
            }
        }
    }

    format!("op=zip_writer_callback digest={:016x}", digest)
}

fn op_zip_from_reader(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let half = data.len() / 2;
            let entries: Vec<(&[u8], &[u8])> = vec![
                (b"src1.bin\0", &data[..half]),
                (b"src2.bin\0", &data[half..]),
            ];
            let (src_buf, src_size) = create_zip_archive(&entries, 6);
            if src_buf.is_null() {
                digest = fold(digest, SENTINEL_SRC_FAIL);
                continue;
            }

            let mut zip_src = MaybeUninit::<mz_zip_archive>::zeroed();
            let pz_src = zip_src.as_mut_ptr();
            mz_zip_zero_struct(pz_src);

            let ret = mz_zip_reader_init_mem(pz_src, src_buf, src_size, 0);
            if ret == 0 {
                mz_free(src_buf);
                digest = fold(digest, SENTINEL_SRC_RD_FAIL);
                continue;
            }

            let num_src = mz_zip_reader_get_num_files(pz_src);
            digest = fold(digest, num_src as u64);

            let mut zip_dst = MaybeUninit::<mz_zip_archive>::zeroed();
            let pz_dst = zip_dst.as_mut_ptr();
            mz_zip_zero_struct(pz_dst);

            let wret = mz_zip_writer_init_heap(pz_dst, 0, 0);
            if wret != 0 {
                for i in 0..num_src {
                    let afr_ret = mz_zip_writer_add_from_zip_reader(pz_dst, pz_src, i);
                    digest = fold(digest, afr_ret as u64);
                }

                let mut dst_buf: *mut ::core::ffi::c_void = ptr::null_mut();
                let mut dst_size: usize = 0;
                let fret = mz_zip_writer_finalize_heap_archive(pz_dst, &mut dst_buf, &mut dst_size);
                digest = fold(digest, fret as u64);
                digest = fold(digest, dst_size as u64);

                if fret != 0 && !dst_buf.is_null() {
                    let mut val_err: mz_zip_error = 0;
                    let vret = mz_zip_validate_mem_archive(dst_buf, dst_size, 0, &mut val_err);
                    digest = fold(digest, vret as u64);

                    let mut zip_verify = MaybeUninit::<mz_zip_archive>::zeroed();
                    let pz_v = zip_verify.as_mut_ptr();
                    mz_zip_zero_struct(pz_v);
                    let vr = mz_zip_reader_init_mem(pz_v, dst_buf, dst_size, 0);
                    if vr != 0 {
                        let num_v = mz_zip_reader_get_num_files(pz_v);
                        digest = fold(digest, num_v as u64);
                        for i in 0..num_v.min(10) {
                            let mut esize: usize = 0;
                            let eptr = mz_zip_reader_extract_to_heap(pz_v, i, &mut esize, 0);
                            if !eptr.is_null() {
                                let sl = std::slice::from_raw_parts(eptr as *const u8, esize);
                                digest = fold(digest, checksum_bytes(sl));
                                mz_free(eptr);
                            }
                        }
                        mz_zip_reader_end(pz_v);
                    } else {
                        mz_zip_end(pz_v);
                    }
                }

                mz_zip_writer_end(pz_dst);
            } else {
                mz_zip_writer_end(pz_dst);
            }

            mz_zip_reader_end(pz_src);
            mz_free(src_buf);
        }
    }

    format!("op=zip_from_reader digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("compress_decompress", op_compress_decompress as fn(&[u8], u64) -> String),
        ("deflate_inflate_stream", op_deflate_inflate_stream as fn(&[u8], u64) -> String),
        ("tinfl_decompress_raw", op_tinfl_decompress_raw as fn(&[u8], u64) -> String),
        ("checksum_ops", op_checksum_ops as fn(&[u8], u64) -> String),
        ("zip_roundtrip", op_zip_roundtrip as fn(&[u8], u64) -> String),
        ("zip_extended", op_zip_extended as fn(&[u8], u64) -> String),
        ("deflate_reset_reuse", op_deflate_reset_reuse as fn(&[u8], u64) -> String),
        ("mz_misc", op_mz_misc as fn(&[u8], u64) -> String),
        ("zip_file_ops", op_zip_file_ops as fn(&[u8], u64) -> String),
        ("zip_validate", op_zip_validate as fn(&[u8], u64) -> String),
        ("zip_iter_extract", op_zip_iter_extract as fn(&[u8], u64) -> String),
        ("tdefl_compressor_ops", op_tdefl_compressor_ops as fn(&[u8], u64) -> String),
        ("tinfl_heap_callback", op_tinfl_heap_callback as fn(&[u8], u64) -> String),
        ("png_write", op_png_write as fn(&[u8], u64) -> String),
        ("zip_file_io", op_zip_file_io as fn(&[u8], u64) -> String),
        ("zip_writer_callback", op_zip_writer_callback as fn(&[u8], u64) -> String),
        ("zip_from_reader", op_zip_from_reader as fn(&[u8], u64) -> String),
    ]
}

fn make_pattern_buf(size: usize, seed: u8) -> Vec<u8> {
    let mut buf = Vec::with_capacity(size);
    let mut v = seed;
    for _ in 0..size {
        buf.push(v);
        v = v.wrapping_mul(7).wrapping_add(13);
    }
    buf
}

fn make_repeating_buf(size: usize) -> Vec<u8> {
    let mut buf = Vec::with_capacity(size);
    for i in 0..size {
        buf.push((0x41 + (i % 26)) as u8);
    }
    buf
}

fn make_zip_archive(entries: &[(&[u8], &[u8])], level: u32) -> Vec<u8> {
    unsafe {
        let (buf, size) = create_zip_archive(entries, level);
        if buf.is_null() {
            return Vec::new();
        }
        let sl = std::slice::from_raw_parts(buf as *const u8, size);
        let v = sl.to_vec();
        mz_free(buf);
        v
    }
}

fn compress_zlib(data: &[u8]) -> Vec<u8> {
    unsafe {
        let source_len = data.len() as u64;
        let bound = mz_compressBound(source_len);
        let mut comp_buf: Vec<u8> = vec![0u8; bound as usize];
        let mut comp_len: u64 = bound;

        let ret = mz_compress(
            comp_buf.as_mut_ptr(),
            &mut comp_len,
            data.as_ptr(),
            source_len,
        );

        if ret != MZ_OK {
            return Vec::new();
        }
        comp_buf.truncate(comp_len as usize);
        comp_buf
    }
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    {
        let s1 = make_repeating_buf(4096);
        let s2 = make_pattern_buf(4096, 0xAB);
        let p1 = format!("{}/compress_decompress.1.bin", dir);
        let p2 = format!("{}/compress_decompress.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed compress_decompress {}", p1));
        lines.push(format!("seed compress_decompress {}", p2));
    }

    {
        let s1 = make_repeating_buf(4096);
        let s2 = make_pattern_buf(4096, 0xCD);
        let p1 = format!("{}/deflate_inflate_stream.1.bin", dir);
        let p2 = format!("{}/deflate_inflate_stream.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed deflate_inflate_stream {}", p1));
        lines.push(format!("seed deflate_inflate_stream {}", p2));
    }

    {
        let src1 = make_repeating_buf(4096);
        let src2 = make_pattern_buf(4096, 0xEF);
        let flags = unsafe { tdefl_create_comp_flags_from_zip_params(6, -15, 0) } as i32;

        let mut out1 = vec![0u8; 8192];
        let mut out2 = vec![0u8; 8192];

        let sz1 = unsafe {
            tdefl_compress_mem_to_mem(
                out1.as_mut_ptr() as *mut ::core::ffi::c_void, out1.len(),
                src1.as_ptr() as *const ::core::ffi::c_void, src1.len(), flags,
            )
        };
        let sz2 = unsafe {
            tdefl_compress_mem_to_mem(
                out2.as_mut_ptr() as *mut ::core::ffi::c_void, out2.len(),
                src2.as_ptr() as *const ::core::ffi::c_void, src2.len(), flags,
            )
        };

        let p1 = format!("{}/tinfl_decompress_raw.1.bin", dir);
        let p2 = format!("{}/tinfl_decompress_raw.2.bin", dir);
        fs::write(&p1, &out1[..sz1]).unwrap();
        fs::write(&p2, &out2[..sz2]).unwrap();
        lines.push(format!("seed tinfl_decompress_raw {}", p1));
        lines.push(format!("seed tinfl_decompress_raw {}", p2));
    }

    {
        let s1 = make_repeating_buf(4096);
        let s2 = make_pattern_buf(4096, 0x37);
        let p1 = format!("{}/checksum_ops.1.bin", dir);
        let p2 = format!("{}/checksum_ops.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed checksum_ops {}", p1));
        lines.push(format!("seed checksum_ops {}", p2));
    }

    {
        let s1 = make_repeating_buf(2048);
        let s2 = make_pattern_buf(2048, 0x55);
        let p1 = format!("{}/zip_roundtrip.1.bin", dir);
        let p2 = format!("{}/zip_roundtrip.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed zip_roundtrip {}", p1));
        lines.push(format!("seed zip_roundtrip {}", p2));
    }

    {
        let s1 = make_repeating_buf(2048);
        let s2 = make_pattern_buf(2048, 0x77);
        let p1 = format!("{}/zip_extended.1.bin", dir);
        let p2 = format!("{}/zip_extended.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed zip_extended {}", p1));
        lines.push(format!("seed zip_extended {}", p2));
    }

    {
        let s1 = make_repeating_buf(4096);
        let s2 = make_pattern_buf(4096, 0x11);
        let p1 = format!("{}/deflate_reset_reuse.1.bin", dir);
        let p2 = format!("{}/deflate_reset_reuse.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed deflate_reset_reuse {}", p1));
        lines.push(format!("seed deflate_reset_reuse {}", p2));
    }

    {
        let s1 = make_repeating_buf(256);
        let s2 = make_pattern_buf(256, 0x99);
        let p1 = format!("{}/mz_misc.1.bin", dir);
        let p2 = format!("{}/mz_misc.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed mz_misc {}", p1));
        lines.push(format!("seed mz_misc {}", p2));
    }

    {
        let s1 = make_repeating_buf(1024);
        let s2 = make_pattern_buf(1024, 0xBB);
        let p1 = format!("{}/zip_file_ops.1.bin", dir);
        let p2 = format!("{}/zip_file_ops.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed zip_file_ops {}", p1));
        lines.push(format!("seed zip_file_ops {}", p2));
    }

    {
        let data1 = make_repeating_buf(512);
        let data2 = make_pattern_buf(512, 0xCC);
        let z1 = make_zip_archive(&[(b"a.bin\0", &data1)], 6);
        let z2 = make_zip_archive(&[(b"b.bin\0", &data2), (b"c.bin\0", &data1)], 1);
        let p1 = format!("{}/zip_validate.1.bin", dir);
        let p2 = format!("{}/zip_validate.2.bin", dir);
        fs::write(&p1, &z1).unwrap();
        fs::write(&p2, &z2).unwrap();
        lines.push(format!("seed zip_validate {}", p1));
        lines.push(format!("seed zip_validate {}", p2));
    }

    {
        let data1 = make_repeating_buf(1024);
        let data2 = make_pattern_buf(1024, 0xDD);
        let z1 = make_zip_archive(&[(b"x.bin\0", &data1), (b"y.bin\0", &data2)], 6);
        let z2 = make_zip_archive(&[(b"z.bin\0", &data2)], 0);
        let p1 = format!("{}/zip_iter_extract.1.bin", dir);
        let p2 = format!("{}/zip_iter_extract.2.bin", dir);
        fs::write(&p1, &z1).unwrap();
        fs::write(&p2, &z2).unwrap();
        lines.push(format!("seed zip_iter_extract {}", p1));
        lines.push(format!("seed zip_iter_extract {}", p2));
    }

    {
        let s1 = make_repeating_buf(4096);
        let s2 = make_pattern_buf(4096, 0xEE);
        let p1 = format!("{}/tdefl_compressor_ops.1.bin", dir);
        let p2 = format!("{}/tdefl_compressor_ops.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed tdefl_compressor_ops {}", p1));
        lines.push(format!("seed tdefl_compressor_ops {}", p2));
    }

    {
        let src1 = make_repeating_buf(4096);
        let src2 = make_pattern_buf(4096, 0xAA);

        let comp1 = compress_zlib(&src1);
        let comp2 = compress_zlib(&src2);

        let p1 = format!("{}/tinfl_heap_callback.1.bin", dir);
        let p2 = format!("{}/tinfl_heap_callback.2.bin", dir);
        fs::write(&p1, &comp1).unwrap();
        fs::write(&p2, &comp2).unwrap();
        lines.push(format!("seed tinfl_heap_callback {}", p1));
        lines.push(format!("seed tinfl_heap_callback {}", p2));
    }

    {
        let s1 = make_pattern_buf(512, 0x42);
        let s2 = make_pattern_buf(512, 0x84);
        let p1 = format!("{}/png_write.1.bin", dir);
        let p2 = format!("{}/png_write.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed png_write {}", p1));
        lines.push(format!("seed png_write {}", p2));
    }

    {
        let s1 = make_repeating_buf(1024);
        let s2 = make_pattern_buf(1024, 0x33);
        let p1 = format!("{}/zip_file_io.1.bin", dir);
        let p2 = format!("{}/zip_file_io.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed zip_file_io {}", p1));
        lines.push(format!("seed zip_file_io {}", p2));
    }

    {
        let s1 = make_repeating_buf(2048);
        let s2 = make_pattern_buf(2048, 0x44);
        let p1 = format!("{}/zip_writer_callback.1.bin", dir);
        let p2 = format!("{}/zip_writer_callback.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed zip_writer_callback {}", p1));
        lines.push(format!("seed zip_writer_callback {}", p2));
    }

    {
        let s1 = make_repeating_buf(2048);
        let s2 = make_pattern_buf(2048, 0x56);
        let p1 = format!("{}/zip_from_reader.1.bin", dir);
        let p2 = format!("{}/zip_from_reader.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed zip_from_reader {}", p1));
        lines.push(format!("seed zip_from_reader {}", p2));
    }

    lines
}

