        fs::write(&path, &buf).unwrap();
        lines.push(format!("perf zip_from_reader {}", path));
    }

    // mz_misc: exercises mz_version() and mz_error() in a loop.
    // The op uses data only for a small adler32 call, but the main work is
    // iterating over mz_error/mz_version/mz_zip_get_error_string calls.
    // A large input ensures the adler32 portion is non-trivial, and the
    // iters parameter drives the mz_error/mz_version calls many times.
    {
        let buf = make_pattern_buf(256 * 1024, 0xCC);
        let path = format!("{}/mz_misc.perf.bin", dir);
        fs::write(&path, &buf).unwrap();
        lines.push(format!("perf mz_misc {}", path));
    }

    lines
}
