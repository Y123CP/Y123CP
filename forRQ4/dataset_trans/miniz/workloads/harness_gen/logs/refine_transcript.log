    // and mz_zip_reader_end -> mz_zip_end is exercised on a substantial archive.
    {
        let z = make_many_entry_zip(50, 4096, 0x55, 6);
        let path = format!("{}/zip_validate.perf.bin", dir);
        fs::write(&path, &z).unwrap();
