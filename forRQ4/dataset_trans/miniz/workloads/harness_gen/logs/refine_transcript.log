/// Build a large zip archive with many entries so that zip operations
/// (validate, iter-extract, etc.) exercise the full zip reader/writer
/// pipeline including mz_zip_end at scale.
fn make_many_entry_zip(entry_count: usize, entry_data_size: usize, seed: u8, level: u32) -> Vec<u8> {
    let mut entries: Vec<(Vec<u8>, Vec<u8>)> = Vec::with_capacity(entry_count);
    for i in 0..entry_count {
        // Create unique null-terminated name for each entry
        let name = format!("entry_{:04}.bin\0", i);
        let data = make_pattern_buf(entry_data_size, seed.wrapping_add(i as u8));
        entries.push((name.into_bytes(), data));
    }

    // Convert to the format create_zip_archive expects
    let entry_refs: Vec<(&[u8], &[u8])> = entries
        .iter()
        .map(|(n, d)| (n.as_slice(), d.as_slice()))
        .collect();

    make_zip_archive(&entry_refs, level)
}

