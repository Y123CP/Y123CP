    }

    {
        let buf = make_pattern_buf(2048, 0x99);
        let path = format!("{}/zip_file_io.perf.bin", dir);
        fs::write(&path, &buf).unwrap();
        lines.push(format!("perf zip_file_io {}", path));
    }

    {
        let buf = make_pattern_buf(4096, 0xAA);
        let path = format!("{}/zip_writer_callback.perf.bin", dir);
        fs::write(&path, &buf).unwrap();
        lines.push(format!("perf zip_writer_callback {}", path));
    }

    {
        let buf = make_pattern_buf(4096, 0xBB);
        let path = format!("{}/zip_from_reader.perf.bin", dir);
        fs::write(&path, &buf).unwrap();
        lines.push(format!("perf zip_from_reader {}", path));
    }

    lines
}

