          "replacement_function_source": "unsafe fn LZ4F_makeBlock(\n    mut dst: *mut c_void,\n    mut src: *const c_void,\n    mut srcSize: size_t,\n    mut compress: compressFunc_t,\n    mut lz4ctx: *mut c_void,\n    mut level: c_int,\n    mut cdict: *const LZ4F_CDict,\n    mut crcFlag: LZ4F_blockChecksum_t,\n) -> size_t {\n    let c_size_ptr = dst as *mut BYTE;\n    let data_ptr = c_size_ptr.wrapping_add(BHSize);\n    let dst_capacity: c_int = if srcSize > 1 { srcSize as c_int - 1 } else { 1 };\n\n    let mut c_size = compress.expect(\"non-null function pointer\")(\n        lz4ctx,\n        src as *const c_char,\n        data_ptr as *mut c_char,\n        srcSize as c_int,\n        dst_capacity,\n        level,\n        cdict,\n    ) as U32;\n\n    if c_size == 0 || (c_size as size_t) >= srcSize {\n        c_size = srcSize as U32;\n        LZ4F_writeLE32(\n            c_size_ptr as *mut c_void,\n            c_size | LZ4F_BLOCKUNCOMPRESSED_FLAG as U32,\n        );\n        // SAFETY: data_ptr points to the block payload area in dst, src points to srcSize readable bytes, and memcpy permits non-overlapping raw byte copy as required by the caller contract of this unsafe function.\n        unsafe { memcpy(data_ptr as *mut c_void, src, srcSize) };\n    } else {\n        LZ4F_writeLE32(c_size_ptr as *mut c_void, c_size);\n    }\n\n    if crcFlag as u64 != 0 {\n        let crc32 = XXH32(data_ptr as *const c_void, c_size as size_t, 0 as c_uint) as U32;\n        let crc_ptr = data_ptr.wrapping_add(c_size as usize);\n        LZ4F_writeLE32(crc_ptr as *mut c_void, crc32);\n    }\n\n    BHSize\n        .wrapping_add(c_size as size_t)\n        .wrapping_add((crcFlag as U32 as size_t).wrapping_mul(BFSize))\n}",
          "rule_id": "freeform",
