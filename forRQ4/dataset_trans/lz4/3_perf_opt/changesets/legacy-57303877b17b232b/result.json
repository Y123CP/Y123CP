          "replacement_function_source": "// Applied rules: [III④]\n// Skipped rules: []\n#[inline(always)]\nunsafe fn XXH32_endian_align(\n    mut input: *const c_void,\n    mut len: size_t,\n    mut seed: U32,\n    mut endian: XXH_endianness,\n    mut align: XXH_alignment,\n) -> U32 {\n    // SAFETY: `input` is the caller-provided buffer base for `len` bytes; this\n    // function only creates a shared slice view over that exact range, does not\n    // mutate through it, and no `&mut` aliases are introduced here.\n    let bytes = unsafe { core::slice::from_raw_parts(input as *const BYTE, len) };\n    let mut h32: U32;\n\n    if len >= 16 as size_t {\n        let mut chunks = bytes[..(len & !(15 as size_t))].chunks_exact(16);\n        let mut v1: U32 = seed.wrapping_add(PRIME32_1).wrapping_add(PRIME32_2);\n        let mut v2: U32 = seed.wrapping_add(PRIME32_2);\n        let mut v3: U32 = seed;\n        let mut v4: U32 = seed.wrapping_sub(PRIME32_1);\n\n        for chunk in &mut chunks {\n            v1 = XXH32_round(\n                v1,\n                XXH_readLE32_align(chunk.as_ptr() as *const c_void, endian, align),\n            );\n            v2 = XXH32_round(\n                v2,\n                XXH_readLE32_align(chunk[4..].as_ptr() as *const c_void, endian, align),\n            );\n            v3 = XXH32_round(\n                v3,\n                XXH_readLE32_align(chunk[8..].as_ptr() as *const c_void, endian, align),\n            );\n            v4 = XXH32_round(\n                v4,\n                XXH_readLE32_align(chunk[12..].as_ptr() as *const c_void, endian, align),\n            );\n        }\n\n        h32 = (v1 << 1 as c_int | v1 >> 32 as c_int - 1 as c_int)\n            .wrapping_add(v2 << 7 as c_int | v2 >> 32 as c_int - 7 as c_int)\n            .wrapping_add(v3 << 12 as c_int | v3 >> 32 as c_int - 12 as c_int)\n            .wrapping_add(v4 << 18 as c_int | v4 >> 32 as c_int - 18 as c_int);\n    } else {\n        h32 = seed.wrapping_add(PRIME32_5);\n    }\n\n    h32 = h32.wrapping_add(len as U32);\n    let tail_len = len & 15 as size_t;\n    let tail_ptr = bytes.as_ptr().wrapping_add(len.wrapping_sub(tail_len)) as *const c_void;\n    XXH32_finalize(h32, tail_ptr, tail_len, endian, align)\n}",
