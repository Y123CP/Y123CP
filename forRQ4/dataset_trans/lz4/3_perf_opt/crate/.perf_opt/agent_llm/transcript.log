        let p32: *const U32 = &raw mut (*state).mem32 as *mut uint32_t;
        (*state).v1 = XXH32_round(
            (*state).v1 as U32,
            XXH_readLE32(p32 as *const c_void, endian),
        ) as uint32_t;
        (*state).v2 = XXH32_round(
            (*state).v2 as U32,
            XXH_readLE32(p32.add(1) as *const c_void, endian),
        ) as uint32_t;
        (*state).v3 = XXH32_round(
            (*state).v3 as U32,
            XXH_readLE32(p32.add(2) as *const c_void, endian),
        ) as uint32_t;
        (*state).v4 = XXH32_round(
            (*state).v4 as U32,
            XXH_readLE32(p32.add(3) as *const c_void, endian),
        ) as uint32_t;

        remaining = &remaining[fill..];
        (*state).memsize = 0 as uint32_t;
