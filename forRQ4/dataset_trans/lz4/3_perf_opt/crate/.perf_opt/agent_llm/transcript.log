unsafe fn XXH32_update_endian(
    mut state: *mut XXH32_state_t,
    mut input: *const c_void,
    mut len: size_t,
    mut endian: XXH_endianness,
) -> XXH_errorcode {
    if input.is_null() {
        return XXH_ERROR;
    }

    // SAFETY: `input` is explicitly checked non-null above; `len` is the stable L1
    // length parameter for this region; this creates a read-only view only, and no
    // Rust reference to the same input backing memory exists across this scope.
