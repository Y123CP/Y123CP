#[inline(always)]
unsafe fn XXH32_endian_align(
    mut input: *const c_void,
    mut len: size_t,
    mut seed: U32,
    mut endian: XXH_endianness,
    mut align: XXH_alignment,
) -> U32 {
    // SAFETY: `input` is the caller-provided buffer base for `len` bytes; this
    // function only creates a shared slice view over that exact range, does not
    // mutate through it, and no `&mut` aliases are introduced here.
    let bytes = unsafe { core::slice::from_raw_parts(input as *const BYTE, len) };
    let mut h32: U32;

    if len >= 16 as size_t {
        let mut chunks = bytes[..(len & !(15 as size_t))].chunks_exact(16);
        let mut v1: U32 = seed.wrapping_add(PRIME32_1).wrapping_add(PRIME32_2);
        let mut v2: U32 = seed.wrapping_add(PRIME32_2);
        let mut v3: U32 = seed;
        let mut v4: U32 = seed.wrapping_sub(PRIME32_1);

        for chunk in &mut chunks {
            v1 = XXH32_round(
                v1,
                XXH_readLE32_align(chunk.as_ptr() as *const c_void, endian, align),
            );
            v2 = XXH32_round(
                v2,
                XXH_readLE32_align(chunk[4..].as_ptr() as *const c_void, endian, align),
            );
            v3 = XXH32_round(
                v3,
                XXH_readLE32_align(chunk[8..].as_ptr() as *const c_void, endian, align),
            );
            v4 = XXH32_round(
                v4,
                XXH_readLE32_align(chunk[12..].as_ptr() as *const c_void, endian, align),
            );
        }

        h32 = (v1 << 1 as c_int | v1 >> 32 as c_int - 1 as c_int)
            .wrapping_add(v2 << 7 as c_int | v2 >> 32 as c_int - 7 as c_int)
            .wrapping_add(v3 << 12 as c_int | v3 >> 32 as c_int - 12 as c_int)
            .wrapping_add(v4 << 18 as c_int | v4 >> 32 as c_int - 18 as c_int);
    } else {
        h32 = seed.wrapping_add(PRIME32_5);
    }

    h32 = h32.wrapping_add(len as U32);
    let tail_len = len & 15 as size_t;
    let tail_ptr = bytes.as_ptr().wrapping_add(len.wrapping_sub(tail_len)) as *const c_void;
    XXH32_finalize(h32, tail_ptr, tail_len, endian, align)
}
```
