#[inline(always)]
unsafe fn LZ4HC_countBack(
    ip_0: *const BYTE,
    match_0: *const BYTE,
    iMin: *const BYTE,
    mMin: *const BYTE,
) -> c_int {
    let min: c_int = (if iMin.offset_from(ip_0) as c_long > mMin.offset_from(match_0) as c_long {
        iMin.offset_from(ip_0) as c_long
    } else {
        mMin.offset_from(match_0) as c_long
    }) as c_int;

    let mut back: c_int = 0 as c_int;

    let mut steps4: c_int = ((-min) - 4 as c_int) / 4 as c_int;
    while steps4 >= 0 {
        let cur_back = -(steps4 * 4 as c_int + 4 as c_int);
        let v: U32 = LZ4_read32(
            ip_0.offset(cur_back as isize) as *const c_void,
        ) as U32
            ^ LZ4_read32(
                match_0.offset(cur_back as isize) as *const c_void,
            ) as U32;
        if v != 0 {
            return cur_back + 4 as c_int - LZ4HC_NbCommonBytes32(v) as c_int;
        }
        steps4 -= 1;
    }

    back = if min < 0 {
        let rem = (-min) & 3 as c_int;
        -rem
