fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9E37_79B1_85EB_CA87)
}

fn checksum_bytes(data: &[u8]) -> u64 {
    let mut acc = 0u64;
    for &b in data {
        acc = fold(acc, b as u64);
    }
    fold(acc, data.len() as u64)
}

fn as_c_int_len(n: usize) -> i32 {
    if n > i32::MAX as usize {
        i32::MAX
    } else {
        n as i32
    }
}

fn split_for_dict(data: &[u8]) -> (usize, usize) {
    let n = data.len();
    if n == 0 {
        return (0, 0);
    }
    let dict = n.min(65536).min(n / 3 + (n > 2) as usize);
    let rem = n.saturating_sub(dict);
    let b1 = if rem == 0 { 0 } else { rem / 2 + (rem % 2) };
    (dict, b1)
}

fn realistic_text_payload(reps: usize) -> Vec<u8> {
    let mut v = Vec::new();
    for i in 0..reps {
        let line = format!(
            "{{\"ts\":\"2024-01-{:02}T12:{:02}:{:02}Z\",\"level\":\"INFO\",\"service\":\"auth\",\"msg\":\"user login\",\"user\":\"user{:05}\",\"tenant\":\"acme\",\"ip\":\"10.0.{}.{}\",\"path\":\"/api/v1/session\",\"status\":200,\"retry\":false,\"tags\":[\"web\",\"prod\",\"login\"],\"meta\":{{\"region\":\"us-east-1\",\"build\":\"2024.01\",\"shard\":{},\"feature\":\"rollout-a\"}}}}\n",
            (i % 28) + 1,
            i % 60,
            (i * 7) % 60,
            i % 10000,
            (i / 251) % 256,
            i % 256,
            i % 32
        );
        v.extend_from_slice(line.as_bytes());
        if i % 8 == 0 {
            v.extend_from_slice(b"GET /healthz 200 ok service=auth cache=warm region=us-east-1\n");
        }
        if i % 16 == 0 {
            v.extend_from_slice(
                b"{\"event\":\"config_refresh\",\"keys\":[\"feature_a\",\"feature_b\",\"timeout_ms\"],\"ok\":true}\n",
            );
        }
        if i % 11 == 0 {
            v.extend_from_slice(b"cookie=session=abcdef0123456789; secure; httponly; samesite=lax\n");
        }
    }
    v
}

fn realistic_binary_payload(reps: usize) -> Vec<u8> {
    let mut v = Vec::new();
    for i in 0..reps {
        v.extend_from_slice(b"PKT0");
        v.extend_from_slice(&(i as u32).to_le_bytes());
        v.extend_from_slice(&((i as u32).wrapping_mul(17)).to_le_bytes());
        v.extend_from_slice(b"HDR:alpha;type=telemetry;ver=1;");
        v.extend_from_slice(&[((i & 0xff) as u8), (((i >> 3) & 0xff) as u8), 0x7f, 0x00]);
