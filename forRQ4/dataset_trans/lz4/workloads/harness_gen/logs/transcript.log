```rust
use std::fs;
use std::mem::MaybeUninit;
use std::ptr;

use lz4_raw::src::lz4::{
    LZ4_compressBound, LZ4_compress_default, LZ4_compress_fast_continue, LZ4_createStream,
    LZ4_decompress_safe, LZ4_freeStream, LZ4_resetStream, LZ4_saveDict, LZ4_stream_t,
};
use lz4_raw::src::lz4hc::LZ4_compress_HC;
use lz4_raw::src::lz4frame::{
    LZ4F_compressFrame, LZ4F_compressFrameBound, LZ4F_createDecompressionContext,
    LZ4F_decompress, LZ4F_freeDecompressionContext, LZ4F_isError,
    LZ4F_preferences_t, LZ4F_decompressOptions_t, LZ4F_dctx,
};
use lz4_raw::src::xxhash::{
    XXH32, XXH32_canonicalFromHash, XXH32_canonical_t, XXH32_createState, XXH32_digest,
    XXH32_freeState, XXH32_hashFromCanonical, XXH32_reset, XXH32_update,
    XXH64, XXH64_canonicalFromHash, XXH64_canonical_t, XXH64_createState, XXH64_digest,
    XXH64_freeState, XXH64_hashFromCanonical, XXH64_reset, XXH64_update,
};

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(5) ^ x
}

fn xor_fold_bytes(data: &[u8]) -> u64 {
    let mut h: u64 = 0;
    for (i, &b) in data.iter().enumerate() {
        h = h.wrapping_add((b as u64).wrapping_mul(i as u64).wrapping_add(1));
    }
    h
}

pub fn op_compress_decompress(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;

    for _ in 0..iters {
        unsafe {
            let src_size = data.len() as i32;
            if src_size == 0 {
                // Empty input: fold zeros
                digest = fold(digest, 0);
                continue;
            }
            let bound = LZ4_compressBound(src_size);
            if bound <= 0 {
                last_err = -1;
                digest = fold(digest, 0);
                continue;
            }
            let mut compressed: Vec<u8> = vec![0u8; bound as usize];
            let comp_size = LZ4_compress_default(
                data.as_ptr() as *const i8,
                compressed.as_mut_ptr() as *mut i8,
                src_size,
                bound,
            );
            if comp_size <= 0 {
                last_err = comp_size;
                digest = fold(digest, comp_size as u64);
                continue;
            }
            let mut decompressed: Vec<u8> = vec![0u8; src_size as usize];
            let decomp_size = LZ4_decompress_safe(
                compressed.as_ptr() as *const i8,
                decompressed.as_mut_ptr() as *mut i8,
                comp_size,
                src_size,
            );
            if decomp_size < 0 {
                last_err = decomp_size;
                digest = fold(digest, decomp_size as u64);
                continue;
            }
            let iter_digest = fold(
                fold(comp_size as u64, decomp_size as u64),
                xor_fold_bytes(&decompressed[..decomp_size as usize]),
            );
            digest = fold(digest, iter_digest);
        }
    }
    format!("op=compress_decompress err={} digest={:016x}", last_err, digest)
}

pub fn op_compress_hc_decompress(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;

    for _ in 0..iters {
        unsafe {
            let src_size = data.len() as i32;
            if src_size == 0 {
                digest = fold(digest, 0);
                continue;
            }
            let bound = LZ4_compressBound(src_size);
            if bound <= 0 {
                last_err = -1;
                digest = fold(digest, 0);
                continue;
            }
            let mut compressed: Vec<u8> = vec![0u8; bound as usize];
            let comp_size = LZ4_compress_HC(
                data.as_ptr() as *const i8,
                compressed.as_mut_ptr() as *mut i8,
                src_size,
                bound,
                9, // high compression level
            );
            if comp_size <= 0 {
                last_err = comp_size;
                digest = fold(digest, comp_size as u64);
                continue;
            }
            let mut decompressed: Vec<u8> = vec![0u8; src_size as usize];
            let decomp_size = LZ4_decompress_safe(
                compressed.as_ptr() as *const i8,
                decompressed.as_mut_ptr() as *mut i8,
                comp_size,
                src_size,
            );
            if decomp_size < 0 {
                last_err = decomp_size;
                digest = fold(digest, decomp_size as u64);
                continue;
            }
            let iter_digest = fold(
                fold(comp_size as u64, decomp_size as u64),
                xor_fold_bytes(&decompressed[..decomp_size as usize]),
            );
            digest = fold(digest, iter_digest);
        }
    }
    format!("op=compress_hc_decompress err={} digest={:016x}", last_err, digest)
}

pub fn op_frame_round_trip(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: u64 = 0;

    for _ in 0..iters {
        unsafe {
            let src_size = data.len();
            let prefs: LZ4F_preferences_t = std::mem::zeroed();
            let frame_bound = LZ4F_compressFrameBound(src_size, &prefs);
            if frame_bound == 0 {
                digest = fold(digest, 0);
                continue;
            }
            let mut compressed: Vec<u8> = vec![0u8; frame_bound];
            let comp_size = LZ4F_compressFrame(
                compressed.as_mut_ptr() as *mut _,
                frame_bound,
                data.as_ptr() as *const _,
                src_size,
                &prefs,
            );
            if LZ4F_isError(comp_size) != 0 {
                last_err = comp_size as u64;
                digest = fold(digest, comp_size as u64);
                continue;
            }

            // Decompress
            let mut dctx: *mut LZ4F_dctx = ptr::null_mut();
            let ret = LZ4F_createDecompressionContext(&mut dctx, 100);
            if LZ4F_isError(ret) != 0 || dctx.is_null() {
                last_err = ret as u64;
                digest = fold(digest, ret as u64);
                continue;
            }

            // Allocate generous decompression buffer
            let decomp_cap = src_size + 1024;
            let mut decompressed: Vec<u8> = vec![0u8; decomp_cap];
            let mut dst_size = decomp_cap;
            let mut src_consumed = comp_size;
            let opts: LZ4F_decompressOptions_t = std::mem::zeroed();

            let result = LZ4F_decompress(
                dctx,
                decompressed.as_mut_ptr() as *mut _,
                &mut dst_size,
                compressed.as_ptr() as *const _,
                &mut src_consumed,
                &opts,
            );

            if LZ4F_isError(result) != 0 {
                last_err = result as u64;
                LZ4F_freeDecompressionContext(dctx);
                digest = fold(digest, result as u64);
                continue;
            }

            let iter_digest = fold(
                fold(comp_size as u64, dst_size as u64),
                xor_fold_bytes(&decompressed[..dst_size]),
            );
            digest = fold(digest, iter_digest);

            LZ4F_freeDecompressionContext(dctx);
        }
    }
    format!("op=frame_round_trip err={} digest={:016x}", last_err, digest)
}

pub fn op_streaming_compress(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;
    let chunk_size: usize = 4096;

    for _ in 0..iters {
        unsafe {
            let stream = LZ4_createStream();
            if stream.is_null() {
                last_err = -1;
                digest = fold(digest, 0);
                continue;
            }
            LZ4_resetStream(stream);

            let mut total_comp_size: u64 = 0;
            let mut all_decomp_xor: u64 = 0;
            let mut save_buf: Vec<u8> = vec![0u8; 65536];
            let mut had_error = false;

            let mut offset = 0usize;
            while offset < data.len() {
                let end = std::cmp::min(offset + chunk_size, data.len());
                let chunk = &data[offset..end];
                let chunk_len = chunk.len() as i32;

                let bound = LZ4_compressBound(chunk_len);
                if bound <= 0 {
                    last_err = -2;
                    had_error = true;
                    break;
                }
                let mut comp_buf: Vec<u8> = vec![0u8; bound as usize];
                let comp_size = LZ4_compress_fast_continue(
                    stream,
                    chunk.as_ptr() as *const i8,
                    comp_buf.as_mut_ptr() as *mut i8,
                    chunk_len,
                    bound,
                    1,
                );
                if comp_size <= 0 {
                    last_err = comp_size;
                    had_error = true;
                    break;
                }
                total_comp_size = total_comp_size.wrapping_add(comp_size as u64);

                // Decompress this chunk independently
                let mut decomp_buf: Vec<u8> = vec![0u8; chunk_len as usize];
                let decomp_size = LZ4_decompress_safe(
                    comp_buf.as_ptr() as *const i8,
                    decomp_buf.as_mut_ptr() as *mut i8,
                    comp_size,
                    chunk_len,
                );
                if decomp_size < 0 {
                    last_err = decomp_size;
                    had_error = true;
                    break;
                }
                all_decomp_xor = fold(all_decomp_xor, xor_fold_bytes(&decomp_buf[..decomp_size as usize]));

                // Save dict
                LZ4_saveDict(
                    stream,
                    save_buf.as_mut_ptr() as *mut i8,
                    save_buf.len() as i32,
                );

                offset = end;
            }

            LZ4_freeStream(stream);

            if had_error {
                digest = fold(digest, last_err as u64);
            } else {
                let iter_digest = fold(total_comp_size, all_decomp_xor);
                digest = fold(digest, iter_digest);
            }
        }
    }
    format!("op=streaming_compress err={} digest={:016x}", last_err, digest)
}

pub fn op_xxhash_digest(data: &[u8], iters: u64) -> String {
    let mut digest: u64 = 0;
    let mut last_err: i32 = 0;

    for _ in 0..iters {
        unsafe {
            let seed32: u32 = 0;
            let seed64: u64 = 0;

            // One-shot XXH32
            let h32_oneshot = XXH32(data.as_ptr() as *const _, data.len(), seed32);

            // One-shot XXH64
            let h64_oneshot = XXH64(data.as_ptr() as *const _, data.len(), seed64 as u64);

            // Streaming XXH32
            let state32 = XXH32_createState();
            let h32_streaming = if !state32.is_null() {
                XXH32_reset(state32, seed32);
                XXH32_update(state32, data.as_ptr() as *const _, data.len());
                let d = XXH32_digest(state32);
                XXH32_freeState(state32);
                d
            } else {
                last_err = -1;
                0
            };

            // Streaming XXH64
            let state64 = XXH64_createState();
            let h64_streaming = if !state64.is_null() {
                XXH64_reset(state64, seed64 as u64);
                XXH64_update(state64, data.as_ptr() as *const _, data.len());
                let d = XXH64_digest(state64);
                XXH64_freeState(state64);
                d
            } else {
                last_err = -2;
                0
            };

            // Canonical round-trips for XXH32
            let mut canon32 = MaybeUninit::<XXH32_canonical_t>::zeroed();
            XXH32_canonicalFromHash(canon32.as_mut_ptr(), h32_oneshot);
            let h32_rt = XXH32_hashFromCanonical(canon32.as_ptr());

            // Canonical round-trips for XXH64
            let mut canon64 = MaybeUninit::<XXH64_canonical_t>::zeroed();
            XXH64_canonicalFromHash(canon64.as_mut_ptr(), h64_oneshot);
            let h64_rt = XXH64_hashFromCanonical(canon64.as_ptr());

            // Combine all hashes
            let iter_digest = fold(
                fold(
                    fold(h32_oneshot as u64, h32_streaming as u64),
                    h64_oneshot as u64,
                ),
                fold(
                    fold(h64_streaming as u64, h32_rt as u64),
                    h64_rt as u64,
                ),
            );
            digest = fold(digest, iter_digest);
        }
    }
    format!("op=xxhash_digest err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("compress_decompress", op_compress_decompress as fn(&[u8], u64) -> String),
        ("compress_hc_decompress", op_compress_hc_decompress as fn(&[u8], u64) -> String),
        ("frame_round_trip", op_frame_round_trip as fn(&[u8], u64) -> String),
        ("streaming_compress", op_streaming_compress as fn(&[u8], u64) -> String),
        ("xxhash_digest", op_xxhash_digest as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // Pattern 1: 1024 bytes, 0..255 repeated 4 times
    let mut pat1 = Vec::with_capacity(1024);
    for _ in 0..4 {
        for b in 0u8..=255 {
            pat1.push(b);
        }
    }

    // Pattern 2: 2048 bytes, 255..0 repeated 8 times
    let mut pat2 = Vec::with_capacity(2048);
    for _ in 0..8 {
        for b in (0u8..=255).rev() {
            pat2.push(b);
        }
    }

    let op_names = [
        "compress_decompress",
        "compress_hc_decompress",
        "frame_round_trip",
        "streaming_compress",
        "xxhash_digest",
    ];

    for op in &op_names {
        let path1 = format!("{}/{}.1.bin", dir, op);
        let path2 = format!("{}/{}.2.bin", dir, op);
        fs::write(&path1, &pat1).unwrap();
        fs::write(&path2, &pat2).unwrap();
        lines.push(format!("seed {} {}", op, path1));
        lines.push(format!("seed {} {}", op, path2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // Generate a large buffer: 512 KB of semi-compressible data
    let size = 512 * 1024;
    let mut big = Vec::with_capacity(size);
    let mut val: u32 = 0x12345678;
    for _ in 0..size {
        // Simple PRNG for deterministic semi-random data
        val = val.wrapping_mul(1103515245).wrapping_add(12345);
        big.push((val >> 16) as u8);
    }

    // compress_decompress
    {
        let path = format!("{}/compress_decompress.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf compress_decompress {}", path));
    }

    // compress_hc_decompress
    {
        let path = format!("{}/compress_hc_decompress.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf compress_hc_decompress {}", path));
    }

    // frame_round_trip
    {
        let path = format!("{}/frame_round_trip.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf frame_round_trip {}", path));
    }

    // streaming_compress
    {
        let path = format!("{}/streaming_compress.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf streaming_compress {}", path));
    }

    // xxhash_digest
    {
        let path = format!("{}/xxhash_digest.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf xxhash_digest {}", path));
    }

    lines
}
