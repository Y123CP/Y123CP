                            produced.extend_from_slice(&dst[..dst_sz]);
                        }
                        consumed = consumed.saturating_add(src_part);

                        if LZ4F_isError(drc) != 0 || drc == 0 || (src_part == 0 && dst_sz == 0) {
                            break;
                        }
                    }
                    iter = fold(iter, produced.len() as u64);
                    iter = fold(iter, checksum_bytes(&produced));

                    LZ4F_resetDecompressionContext(dctx);
                    let mut produced2 = Vec::<u8>::new();
                    let mut consumed2 = 0usize;
                    let mut steps2 = 0u64;
                    let mut dopts = zeroed_dopts();
                    dopts.stableDst = 1;
                    while consumed2 < data.len() && steps2 < 1_000_000 {
                        steps2 += 1;
                        let mut dst = vec![0u8; 32 * 1024];
                        let mut dst_sz = dst.len();
                        let mut src_part = data.len() - consumed2;
                        let drc = LZ4F_decompress_usingDict(
                            dctx,
                            dst.as_mut_ptr() as *mut _,
                            &mut dst_sz,
                            data[consumed2..].as_ptr() as *const _,
                            &mut src_part,
                            ptr::null(),
                            0,
                            &dopts as *const _,
                        );
                        iter = fold(iter, drc as u64);
                        iter = fold(iter, src_part as u64);
                        iter = fold(iter, dst_sz as u64);
                        if dst_sz > 0 {
                            produced2.extend_from_slice(&dst[..dst_sz]);
                        }
                        consumed2 = consumed2.saturating_add(src_part);
                        if LZ4F_isError(drc) != 0 || drc == 0 || (src_part == 0 && dst_sz == 0) {
                            break;
                        }
                    }
                    iter = fold(iter, produced2.len() as u64);
                    iter = fold(iter, checksum_bytes(&produced2));
                } else {
                    let code = LZ4F_getErrorCode(info_rc);
                    let name = LZ4F_getErrorName(info_rc);
                    iter = fold(iter, code as u64);
                    iter = fold(iter, (!name.is_null()) as u64);
                    if !name.is_null() {
                        iter = fold(iter, checksum_bytes(CStr::from_ptr(name).to_bytes()));
                    }
                }
            }

            let frc = LZ4F_freeDecompressionContext(dctx);
            iter = fold(iter, frc as u64);
            if LZ4F_isError(frc) != 0 {
                last_err = frc as u64;
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_frame_decompress err={} digest={:016x}", last_err, digest)
}

fn op_lz4_hc_block_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            let src_len = as_c_int_len(data.len());
            let bound = LZ4_compressBound(src_len);

            iter = fold(iter, LZ4_sizeofStateHC() as u64);
            iter = fold(iter, LZ4_sizeofStreamStateHC() as u64);
            iter = fold(iter, bound as u64);

            if data.is_empty() || bound <= 0 {
                last_err = bound;
                digest = fold(digest, iter);
                continue;
            }

            let mut compressed = vec![0u8; bound as usize];
            let csz = LZ4_compress_HC(
                data.as_ptr() as *const i8,
                compressed.as_mut_ptr() as *mut i8,
                src_len,
                bound,
                9,
            );
            last_err = csz;
            iter = fold(iter, csz as u64);

            if csz > 0 {
                let mut decomp = vec![0u8; data.len()];
                let dsz = LZ4_decompress_safe(
                    compressed.as_ptr() as *const i8,
                    decomp.as_mut_ptr() as *mut i8,
                    csz,
                    src_len,
                );
                last_err = dsz;
                iter = fold(iter, dsz as u64);
                iter = fold(iter, (dsz == src_len && decomp == data) as u64);
                if dsz > 0 {
                    iter = fold(iter, checksum_bytes(&decomp[..dsz as usize]));
                }
            }

            let state_sz = LZ4_sizeofStateHC();
            if state_sz > 0 {
                let mut hc_state = vec![0u8; state_sz as usize];
                let mut out = vec![0u8; bound as usize];

                let e1 = LZ4_compress_HC_extStateHC(
                    hc_state.as_mut_ptr() as *mut _,
                    data.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    bound,
                    10,
                );
                last_err = e1;
                iter = fold(iter, e1 as u64);

                let e2 = LZ4_compressHC(
                    data.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                );
                last_err = e2;
                iter = fold(iter, e2 as u64);

                let e3 = LZ4_compressHC2(
                    data.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    11,
                );
                last_err = e3;
                iter = fold(iter, e3 as u64);

                let mut src_size = src_len;
                let e4 = LZ4_compress_HC_destSize(
                    hc_state.as_mut_ptr() as *mut _,
                    data.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    &mut src_size,
                    (bound / 2).max(1),
                    12,
                );
                last_err = e4;
                iter = fold(iter, e4 as u64);
                iter = fold(iter, src_size as u64);
            }

            let (dict_len, body_len) = split_for_dict(data);
            let stream = LZ4_createStreamHC();
            iter = fold(iter, (!stream.is_null()) as u64);

            if !stream.is_null() {
                LZ4_resetStreamHC(stream, 9);
                LZ4_setCompressionLevel(stream, 10);
                LZ4_favorDecompressionSpeed(stream, 0);

                let loaded = LZ4_loadDictHC(
                    stream,
                    if dict_len == 0 {
                        ptr::null()
                    } else {
                        data.as_ptr() as *const i8
                    },
                    as_c_int_len(dict_len),
                );
                last_err = loaded;
                iter = fold(iter, loaded as u64);

                if dict_len > 0 && body_len > 0 {
                    let body = &data[dict_len..dict_len + body_len];
                    let cap = LZ4_compressBound(as_c_int_len(body.len()));
                    iter = fold(iter, cap as u64);
                    if cap > 0 {
                        let mut c = vec![0u8; cap as usize];
                        let csz2 = LZ4_compress_HC_continue(
                            stream,
                            body.as_ptr() as *const i8,
                            c.as_mut_ptr() as *mut i8,
                            as_c_int_len(body.len()),
                            cap,
                        );
                        last_err = csz2;
                        iter = fold(iter, csz2 as u64);

                        let old_csz = LZ4_compressHC_continue(
                            stream,
                            body.as_ptr() as *const i8,
                            c.as_mut_ptr() as *mut i8,
                            as_c_int_len(body.len()),
                        );
                        iter = fold(iter, old_csz as u64);

                        let old_lim = LZ4_compressHC_limitedOutput_continue(
                            stream,
                            body.as_ptr() as *const i8,
                            c.as_mut_ptr() as *mut i8,
                            as_c_int_len(body.len()),
                            cap,
                        );
                        iter = fold(iter, old_lim as u64);

                        let mut body_src = as_c_int_len(body.len());
                        let csz3 = LZ4_compress_HC_continue_destSize(
                            stream,
                            body.as_ptr() as *const i8,
                            c.as_mut_ptr() as *mut i8,
                            &mut body_src,
                            (cap / 2).max(1),
                        );
                        iter = fold(iter, csz3 as u64);
                        iter = fold(iter, body_src as u64);

                        if csz2 > 0 {
                            let mut d = vec![0u8; body.len()];
                            let dsz = LZ4_decompress_safe_usingDict(
                                c.as_ptr() as *const i8,
                                d.as_mut_ptr() as *mut i8,
                                csz2,
                                as_c_int_len(d.len()),
                                data.as_ptr() as *const i8,
                                as_c_int_len(dict_len),
                            );
                            last_err = dsz;
                            iter = fold(iter, dsz as u64);
                            iter = fold(iter, (dsz == as_c_int_len(body.len()) && d == body) as u64);
                            if dsz > 0 {
                                iter = fold(iter, checksum_bytes(&d[..dsz as usize]));
                            }

                            let mut d2 = vec![0u8; body.len()];
                            let fsz = LZ4_decompress_fast_usingDict(
                                c.as_ptr() as *const i8,
                                d2.as_mut_ptr() as *mut i8,
                                as_c_int_len(d2.len()),
                                data.as_ptr() as *const i8,
                                as_c_int_len(dict_len),
                            );
                            last_err = fsz;
                            iter = fold(iter, fsz as u64);
                            iter = fold(iter, checksum_bytes(&d2));
                        }

                        let mut saved = vec![0u8; dict_len.max(1)];
                        let ssz = LZ4_saveDictHC(
                            stream,
                            saved.as_mut_ptr() as *mut i8,
                            as_c_int_len(saved.len()),
                        );
                        iter = fold(iter, ssz as u64);
                    }
                }

                let frc = LZ4_freeStreamHC(stream);
                iter = fold(iter, frc as u64);
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_hc_block_roundtrip err={} digest={:016x}", last_err, digest)
}

fn op_lz4_frame_compress_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            iter = fold(iter, LZ4F_getVersion() as u64);

            let mut prefs = zeroed_prefs();
            prefs.compressionLevel = 9;
            prefs.autoFlush = 0;
            prefs.frameInfo.blockMode = LZ4F_blockLinked;
            prefs.frameInfo.blockSizeID = LZ4F_max256KB;
            prefs.frameInfo.contentChecksumFlag = LZ4F_contentChecksumEnabled;
            prefs.frameInfo.blockChecksumFlag = LZ4F_blockChecksumEnabled;
            prefs.frameInfo.contentSize = data.len() as u64;
            prefs.frameInfo.dictID = 0x1234_5678;

            let bound = LZ4F_compressFrameBound(data.len(), &prefs as *const _);
            iter = fold(iter, bound as u64);
            if bound == 0 {
                digest = fold(digest, iter);
                continue;
            }

            let mut one_shot = vec![0u8; bound];
            let one_sz = LZ4F_compressFrame(
                one_shot.as_mut_ptr() as *mut _,
                one_shot.len(),
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr() as *const _
                },
                data.len(),
                &prefs as *const _,
            );
            last_err = one_sz as u64;
            iter = fold(iter, one_sz as u64);
            if LZ4F_isError(one_sz) == 0 && one_sz <= one_shot.len() {
                one_shot.truncate(one_sz);
                iter = fold(iter, checksum_bytes(&one_shot));
            }

            let dict_len = data.len().min(8192);
            let dict = &data[..dict_len];
            let cdict = LZ4F_createCDict(
                if dict.is_empty() {
                    ptr::null()
                } else {
                    dict.as_ptr() as *const _
                },
                dict.len(),
            );
            let cdict2 = LZ4F_createCDict_advanced(
                zeroed_custom_mem(),
                if dict.is_empty() {
                    ptr::null()
                } else {
                    dict.as_ptr() as *const _
                },
                dict.len(),
            );
            iter = fold(iter, (!cdict.is_null()) as u64);
            iter = fold(iter, (!cdict2.is_null()) as u64);

            let mut cctx: *mut LZ4F_cctx = ptr::null_mut();
            let crc = LZ4F_createCompressionContext(&mut cctx as *mut *mut _, LZ4F_getVersion());
            iter = fold(iter, crc as u64);
            last_err = crc as u64;

            if LZ4F_isError(crc) == 0 && !cctx.is_null() {
                iter = fold(iter, LZ4F_cctx_size(cctx) as u64);

                let mut out = vec![0u8; bound.saturating_add(4096)];
                let mut pos = 0usize;
                let mut hdr = vec![0u8; 256];

                let hsz = LZ4F_compressBegin(
                    cctx,
                    hdr.as_mut_ptr() as *mut _,
                    hdr.len(),
                    &prefs as *const _,
                );
                iter = fold(iter, hsz as u64);
                last_err = hsz as u64;

                if LZ4F_isError(hsz) == 0 && hsz <= hdr.len() {
                    out[pos..pos + hsz].copy_from_slice(&hdr[..hsz]);
                    pos += hsz;

                    let mut copts = zeroed_copts();
                    copts.stableSrc = 1;

                    let p1 = data.len() / 3;
                    let p2 = (data.len() * 2) / 3;
                    for part in [&data[..p1], &data[p1..p2], &data[p2..]] {
                        let need =
                            LZ4F_compressBound(part.len(), &prefs as *const _).saturating_add(64);
                        if pos + need > out.len() {
                            out.resize(pos + need, 0);
                        }
                        let wsz = LZ4F_compressUpdate(
                            cctx,
                            out[pos..].as_mut_ptr() as *mut _,
                            out.len() - pos,
                            if part.is_empty() {
                                ptr::null()
                            } else {
                                part.as_ptr() as *const _
                            },
                            part.len(),
                            &copts as *const _,
                        );
                        iter = fold(iter, wsz as u64);
                        last_err = wsz as u64;
                        if LZ4F_isError(wsz) != 0 {
                            break;
                        }
                        pos += wsz;
                    }

                    let fsz = LZ4F_flush(
                        cctx,
                        out[pos..].as_mut_ptr() as *mut _,
                        out.len() - pos,
                        &copts as *const _,
                    );
                    iter = fold(iter, fsz as u64);
                    last_err = fsz as u64;
                    if LZ4F_isError(fsz) == 0 {
                        pos += fsz;
                    }

                    let esz = LZ4F_compressEnd(
                        cctx,
                        out[pos..].as_mut_ptr() as *mut _,
                        out.len() - pos,
                        &copts as *const _,
                    );
                    iter = fold(iter, esz as u64);
                    last_err = esz as u64;
                    if LZ4F_isError(esz) == 0 {
                        pos += esz;
                    }
                    out.truncate(pos);
                    iter = fold(iter, checksum_bytes(&out));

                    let mut dctx: *mut LZ4F_dctx = ptr::null_mut();
                    let drc =
                        LZ4F_createDecompressionContext(&mut dctx as *mut *mut _, LZ4F_getVersion());
                    iter = fold(iter, drc as u64);
                    if LZ4F_isError(drc) == 0 && !dctx.is_null() {
                        let mut produced = Vec::new();
                        let mut consumed = 0usize;
                        while consumed < out.len() {
                            let mut dst = vec![0u8; 64 * 1024];
                            let mut dst_sz = dst.len();
                            let mut src_sz = out.len() - consumed;
                            let r = LZ4F_decompress(
                                dctx,
                                dst.as_mut_ptr() as *mut _,
                                &mut dst_sz,
                                out[consumed..].as_ptr() as *const _,
                                &mut src_sz,
                                ptr::null(),
                            );
                            iter = fold(iter, r as u64);
                            iter = fold(iter, src_sz as u64);
                            iter = fold(iter, dst_sz as u64);
                            if dst_sz > 0 {
                                produced.extend_from_slice(&dst[..dst_sz]);
                            }
                            consumed += src_sz;
                            if LZ4F_isError(r) != 0 || r == 0 || (src_sz == 0 && dst_sz == 0) {
                                break;
                            }
                        }
                        iter = fold(iter, produced.len() as u64);
                        iter = fold(iter, checksum_bytes(&produced));
                        let frc = LZ4F_freeDecompressionContext(dctx);
                        iter = fold(iter, frc as u64);
                    }
                }

                if !cdict.is_null() {
                    let mut tmp = vec![0u8; bound.max(1)];
                    let sz = LZ4F_compressFrame_usingCDict(
                        cctx,
                        tmp.as_mut_ptr() as *mut _,
                        tmp.len(),
                        if data.is_empty() {
                            ptr::null()
                        } else {
                            data.as_ptr() as *const _
                        },
                        data.len(),
                        cdict,
                        &prefs as *const _,
                    );
                    iter = fold(iter, sz as u64);
                    if LZ4F_isError(sz) == 0 && sz <= tmp.len() {
                        tmp.truncate(sz);
                        iter = fold(iter, checksum_bytes(&tmp));
                    }
                }

                if !cdict2.is_null() {
                    let mut hdr2 = vec![0u8; 256];
                    let h2 = LZ4F_compressBegin_usingCDict(
                        cctx,
                        hdr2.as_mut_ptr() as *mut _,
                        hdr2.len(),
                        cdict2,
                        &prefs as *const _,
                    );
                    iter = fold(iter, h2 as u64);
                }

                let mut hdr3 = vec![0u8; 256];
                let h3 = LZ4F_compressBegin_usingDict(
                    cctx,
                    hdr3.as_mut_ptr() as *mut _,
                    hdr3.len(),
                    if dict.is_empty() {
                        ptr::null()
                    } else {
                        dict.as_ptr() as *const _
                    },
                    dict.len(),
                    &prefs as *const _,
                );
                iter = fold(iter, h3 as u64);

                let frc = LZ4F_freeCompressionContext(cctx);
                iter = fold(iter, frc as u64);
            }

            if !cdict.is_null() {
                LZ4F_freeCDict(cdict);
            }
            if !cdict2.is_null() {
                LZ4F_freeCDict(cdict2);
            }

            digest = fold(digest, iter);
        }
    }

    format!(
        "op=lz4_frame_compress_roundtrip err={} digest={:016x}",
        last_err, digest
    )
}

fn op_lz4_legacy_api_mix(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            let src_len = as_c_int_len(data.len());
            let bound = LZ4_compressBound(src_len);
            iter = fold(iter, bound as u64);

            if data.is_empty() || bound <= 0 {
                last_err = bound;
                digest = fold(digest, iter);
                continue;
            }

            let mut out = vec![0u8; bound as usize];
            let csz = LZ4_compress_default(
                data.as_ptr() as *const i8,
                out.as_mut_ptr() as *mut i8,
                src_len,
                bound,
            );
            last_err = csz;
            iter = fold(iter, csz as u64);

            if csz > 0 {
                let mut d1 = vec![0u8; data.len()];
                let u1 = LZ4_uncompress(
                    out.as_ptr() as *const i8,
                    d1.as_mut_ptr() as *mut i8,
                    src_len,
                );
                iter = fold(iter, u1 as u64);
                if u1 >= 0 {
                    iter = fold(iter, checksum_bytes(&d1));
                }

                let mut d2 = vec![0u8; data.len()];
                let u2 = LZ4_uncompress_unknownOutputSize(
                    out.as_ptr() as *const i8,
                    d2.as_mut_ptr() as *mut i8,
                    csz,
                    src_len,
                );
                last_err = u2;
                iter = fold(iter, u2 as u64);
                if u2 > 0 {
                    iter = fold(iter, checksum_bytes(&d2[..u2 as usize]));
                }
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_legacy_api_mix err={} digest={:016x}", last_err, digest)
}

fn fopen_path(path: &Path, mode: &str) -> *mut CFile {
    let c_path = match CString::new(path.to_string_lossy().as_bytes()) {
        Ok(s) => s,
        Err(_) => return ptr::null_mut(),
    };
    let c_mode = match CString::new(mode) {
        Ok(s) => s,
        Err(_) => return ptr::null_mut(),
    };
    unsafe { fopen(c_path.as_ptr(), c_mode.as_ptr()) }
}

fn op_lz4_file_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            let mut prefs = zeroed_prefs();
            prefs.compressionLevel = 4;
            prefs.frameInfo.blockMode = LZ4F_blockLinked;
            prefs.frameInfo.blockSizeID = LZ4F_max256KB;
            prefs.frameInfo.contentChecksumFlag = LZ4F_contentChecksumEnabled;
            prefs.frameInfo.contentSize = data.len() as u64;

            let tmp = std::env::temp_dir();
            let out_path = tmp.join("lz4_raw_harness_file_roundtrip.tmp.lz4");

            let mut writer: *mut LZ4_writeFile_t = ptr::null_mut();
            let mut reader: *mut LZ4_readFile_t = ptr::null_mut();

            let fpw = fopen_path(&out_path, "wb");
            iter = fold(iter, (!fpw.is_null()) as u64);
            if !fpw.is_null() {
                let file_prefs: *const LZ4F_preferences_file_t =
                    (&prefs as *const LZ4F_preferences_t).cast::<LZ4F_preferences_file_t>();
                let wrc = LZ4F_writeOpen(&mut writer as *mut *mut _, fpw as *mut _, file_prefs);
                iter = fold(iter, wrc as u64);
                last_err = wrc as u64;

                if LZ4F_isError(wrc) == 0 && !writer.is_null() {
                    let wsz = LZ4F_write(
                        writer,
                        if data.is_empty() {
                            ptr::null()
                        } else {
                            data.as_ptr() as *const _
                        },
                        data.len(),
                    );
                    iter = fold(iter, wsz as u64);
                    last_err = wsz as u64;

                    let wcl = LZ4F_writeClose(writer);
                    iter = fold(iter, wcl as u64);
                    last_err = wcl as u64;
                    writer = ptr::null_mut();
                }

                let crc = fclose(fpw);
                iter = fold(iter, crc as u64);
            }

            if let Ok(bytes) = fs::read(&out_path) {
                iter = fold(iter, bytes.len() as u64);
                iter = fold(iter, checksum_bytes(&bytes));
            }

            let fpr = fopen_path(&out_path, "rb");
            iter = fold(iter, (!fpr.is_null()) as u64);
            if !fpr.is_null() {
                let rrc = LZ4F_readOpen(&mut reader as *mut *mut _, fpr as *mut _);
                iter = fold(iter, rrc as u64);
                last_err = rrc as u64;

                if !reader.is_null() {
                    let mut out = Vec::new();
                    let mut steps = 0u64;
                    loop {
                        steps += 1;
                        if steps > 1_000_000 {
                            break;
                        }
                        let mut buf = vec![0u8; 32 * 1024];
                        let got = LZ4F_read(reader, buf.as_mut_ptr() as *mut _, buf.len());
                        iter = fold(iter, got as u64);
                        if got == 0 || got > buf.len() {
                            break;
                        }
                        out.extend_from_slice(&buf[..got]);
                    }
                    iter = fold(iter, out.len() as u64);
                    iter = fold(iter, checksum_bytes(&out));

                    let rcl = LZ4F_readClose(reader);
                    iter = fold(iter, rcl as u64);
                    last_err = rcl as u64;
                    reader = ptr::null_mut();
                }

                let crc = fclose(fpr);
                iter = fold(iter, crc as u64);
            }

            let _ = fs::remove_file(&out_path);
            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_file_roundtrip err={} digest={:016x}", last_err, digest)
}

fn op_xxhash_streaming(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            iter = fold(iter, XXH_versionNumber() as u64);

            let seed32 = 0x1234_5678u32;
            let seed64 = 0x0123_4567_89ab_cdefu64;

            let h32 = XXH32(
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr() as *const _
                },
                data.len(),
                seed32,
            );
            let h64 = XXH64(
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr() as *const _
                },
                data.len(),
                seed64,
            );
            iter = fold(iter, h32 as u64);
            iter = fold(iter, h64);

            let s32 = XXH32_createState();
            let s32b = XXH32_createState();
            iter = fold(iter, (!s32.is_null()) as u64);
            iter = fold(iter, (!s32b.is_null()) as u64);
            if !s32.is_null() && !s32b.is_null() {
                let rc = XXH32_reset(s32, seed32);
                iter = fold(iter, rc as u64);
                last_err = rc;

                let p1 = data.len() / 3;
                let p2 = (data.len() * 2) / 3;
                let rc1 = XXH32_update(
                    s32,
                    if p1 == 0 {
                        ptr::null()
                    } else {
                        data[..p1].as_ptr() as *const _
                    },
                    p1,
                );
                let rc2 = XXH32_update(
                    s32,
                    if p2 > p1 {
                        data[p1..p2].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    p2.saturating_sub(p1),
                );
                XXH32_copyState(s32b, s32);
                let rc3 = XXH32_update(
                    s32,
                    if data.len() > p2 {
                        data[p2..].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    data.len().saturating_sub(p2),
                );
                let rc4 = XXH32_update(
                    s32b,
                    if data.len() > p2 {
                        data[p2..].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    data.len().saturating_sub(p2),
                );
                iter = fold(iter, rc1 as u64);
                iter = fold(iter, rc2 as u64);
                iter = fold(iter, rc3 as u64);
                iter = fold(iter, rc4 as u64);
                last_err = rc4;

                let d32 = XXH32_digest(s32);
                let d32b = XXH32_digest(s32b);
                iter = fold(iter, d32 as u64);
                iter = fold(iter, d32b as u64);
                iter = fold(iter, (d32 == h32) as u64);
                iter = fold(iter, (d32b == h32) as u64);

                let mut canon32 = MaybeUninit::<XXH32_canonical_t>::zeroed();
                XXH32_canonicalFromHash(canon32.as_mut_ptr(), d32);
                let rt32 = XXH32_hashFromCanonical(canon32.as_ptr());
                iter = fold(iter, rt32 as u64);
                iter = fold(iter, (rt32 == d32) as u64);

                let frc1 = XXH32_freeState(s32);
                let frc2 = XXH32_freeState(s32b);
                iter = fold(iter, frc1 as u64);
                iter = fold(iter, frc2 as u64);
            } else {
                if !s32.is_null() {
                    let frc = XXH32_freeState(s32);
                    iter = fold(iter, frc as u64);
                }
                if !s32b.is_null() {
                    let frc = XXH32_freeState(s32b);
                    iter = fold(iter, frc as u64);
                }
            }

            let s64 = XXH64_createState();
            let s64b = XXH64_createState();
            iter = fold(iter, (!s64.is_null()) as u64);
            iter = fold(iter, (!s64b.is_null()) as u64);
            if !s64.is_null() && !s64b.is_null() {
                let rc = XXH64_reset(s64, seed64);
                iter = fold(iter, rc as u64);
                last_err = rc;

                let p1 = data.len() / 4;
                let p2 = data.len() / 2;
                let p3 = (data.len() * 3) / 4;
                let rc1 = XXH64_update(
                    s64,
                    if p1 == 0 {
                        ptr::null()
                    } else {
                        data[..p1].as_ptr() as *const _
                    },
                    p1,
                );
                let rc2 = XXH64_update(
                    s64,
                    if p2 > p1 {
                        data[p1..p2].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    p2.saturating_sub(p1),
                );
                let rc3 = XXH64_update(
                    s64,
                    if p3 > p2 {
                        data[p2..p3].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    p3.saturating_sub(p2),
                );
                XXH64_copyState(s64b, s64);
                let rc4 = XXH64_update(
                    s64,
                    if data.len() > p3 {
                        data[p3..].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    data.len().saturating_sub(p3),
                );
                let rc5 = XXH64_update(
                    s64b,
                    if data.len() > p3 {
                        data[p3..].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    data.len().saturating_sub(p3),
                );
                iter = fold(iter, rc1 as u64);
                iter = fold(iter, rc2 as u64);
                iter = fold(iter, rc3 as u64);
                iter = fold(iter, rc4 as u64);
                iter = fold(iter, rc5 as u64);
                last_err = rc5;

                let d64 = XXH64_digest(s64);
                let d64b = XXH64_digest(s64b);
                iter = fold(iter, d64);
                iter = fold(iter, d64b);
                iter = fold(iter, (d64 == h64) as u64);
                iter = fold(iter, (d64b == h64) as u64);

                let mut canon64 = MaybeUninit::<XXH64_canonical_t>::zeroed();
                XXH64_canonicalFromHash(canon64.as_mut_ptr(), d64);
                let rt64 = XXH64_hashFromCanonical(canon64.as_ptr());
                iter = fold(iter, rt64);
                iter = fold(iter, (rt64 == d64) as u64);

                let frc1 = XXH64_freeState(s64);
                let frc2 = XXH64_freeState(s64b);
                iter = fold(iter, frc1 as u64);
                iter = fold(iter, frc2 as u64);
            } else {
                if !s64.is_null() {
                    let frc = XXH64_freeState(s64);
                    iter = fold(iter, frc as u64);
                }
                if !s64b.is_null() {
                    let frc = XXH64_freeState(s64b);
                    iter = fold(iter, frc as u64);
                }
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=xxhash_streaming err={} digest={:016x}", last_err, digest)
}

fn op_lz4_api_sweep(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let work = extended_input(data, 96 * 1024);
            let mut iter = checksum_bytes(&work);
            let src_len = as_c_int_len(work.len());
            let bound = LZ4_compressBound(src_len);
            iter = fold(iter, bound as u64);
            iter = fold(iter, LZ4_decoderRingBufferSize(64 * 1024) as u64);
            if bound <= 0 {
                last_err = bound;
                digest = fold(digest, iter);
                continue;
            }

            let mut out = vec![0u8; bound as usize];
            let c0 = LZ4_compress_fast(
                work.as_ptr() as *const i8,
                out.as_mut_ptr() as *mut i8,
                src_len,
                bound,
                2,
            );
            last_err = c0;
            iter = fold(iter, c0 as u64);

            let c1 = LZ4_compress(
                work.as_ptr() as *const i8,
                out.as_mut_ptr() as *mut i8,
                src_len,
            );
            last_err = c1;
            iter = fold(iter, c1 as u64);

            let c2 = LZ4_compress_limitedOutput(
                work.as_ptr() as *const i8,
                out.as_mut_ptr() as *mut i8,
                src_len,
                bound,
            );
            last_err = c2;
            iter = fold(iter, c2 as u64);

            let state_sz = LZ4_sizeofState();
            iter = fold(iter, state_sz as u64);
            if state_sz > 0 {
                let mut state = vec![0u8; state_sz as usize];
                let c3 = LZ4_compress_withState(
                    state.as_mut_ptr() as *mut _,
                    work.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                );
                last_err = c3;
                iter = fold(iter, c3 as u64);

                let c4 = LZ4_compress_limitedOutput_withState(
                    state.as_mut_ptr() as *mut _,
                    work.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    bound,
                );
                last_err = c4;
                iter = fold(iter, c4 as u64);

                let mut legacy_in = vec![0i8; (work.len() + 64 * 1024 + 32).max(1)];
                let rcs =
                    LZ4_resetStreamState(state.as_mut_ptr() as *mut _, legacy_in.as_mut_ptr());
                last_err = rcs;
                iter = fold(iter, rcs as u64);
            }

            let prefix_len = work.len().min(60 * 1024).max(1).min(work.len().saturating_sub(1));
            let body = &work[prefix_len..];
            let body_len = body.len().min(24 * 1024);
            let body = &body[..body_len];
            let prefix = &work[..prefix_len];
            let body_src_len = as_c_int_len(body.len());
            let body_bound = LZ4_compressBound(body_src_len).max(1);
            iter = fold(iter, prefix_len as u64);
            iter = fold(iter, body_len as u64);

            let mut enc = LZ4_createStream();
            let mut dict_stream = LZ4_createStream();
            let mut dec = LZ4_createStreamDecode();
            iter = fold(iter, (!enc.is_null()) as u64);
            iter = fold(iter, (!dict_stream.is_null()) as u64);
            iter = fold(iter, (!dec.is_null()) as u64);

            if !enc.is_null() && !dict_stream.is_null() && !dec.is_null() && body_len > 0 {
                LZ4_resetStream(enc);
                LZ4_resetStream_fast(enc);
                LZ4_resetStream(dict_stream);

                let ld1 =
                    LZ4_loadDict(dict_stream, prefix.as_ptr() as *const i8, as_c_int_len(prefix.len()));
                let ld2 =
                    LZ4_loadDictSlow(enc, prefix.as_ptr() as *const i8, as_c_int_len(prefix.len()));
                iter = fold(iter, ld1 as u64);
                iter = fold(iter, ld2 as u64);

                LZ4_attach_dictionary(enc, dict_stream as *const _);

                let mut tmp = vec![0u8; body_bound as usize];
                let cc1 = LZ4_compress_continue(
                    enc,
                    body.as_ptr() as *const i8,
                    tmp.as_mut_ptr() as *mut i8,
                    body_src_len,
                );
                last_err = cc1;
                iter = fold(iter, cc1 as u64);

                let cc2 = LZ4_compress_limitedOutput_continue(
                    enc,
                    body.as_ptr() as *const i8,
                    tmp.as_mut_ptr() as *mut i8,
                    body_src_len,
                    body_bound,
                );
                last_err = cc2;
                iter = fold(iter, cc2 as u64);

                let cc3 = LZ4_compress_fast_continue(
                    enc,
                    body.as_ptr() as *const i8,
                    tmp.as_mut_ptr() as *mut i8,
                    body_src_len,
                    body_bound,
                    1,
                );
                last_err = cc3;
                iter = fold(iter, cc3 as u64);

                let cc4 = LZ4_compress_forceExtDict(
                    enc,
                    body.as_ptr() as *const i8,
                    tmp.as_mut_ptr() as *mut i8,
                    body_src_len,
                );
                last_err = cc4;
                iter = fold(iter, cc4 as u64);

                if cc3 > 0 {
                    let ssd =
                        LZ4_setStreamDecode(dec, prefix.as_ptr() as *const i8, as_c_int_len(prefix.len()));
                    iter = fold(iter, ssd as u64);

                    let mut d1 = vec![0u8; body.len()];
                    let r1 = LZ4_decompress_safe_continue(
                        dec,
                        tmp.as_ptr() as *const i8,
                        d1.as_mut_ptr() as *mut i8,
                        cc3,
                        as_c_int_len(d1.len()),
                    );
                    last_err = r1;
                    iter = fold(iter, r1 as u64);
                    if r1 > 0 {
                        iter = fold(iter, checksum_bytes(&d1[..r1 as usize]));
                    }

                    let mut d2 = vec![0u8; body.len()];
                    let ssd2 =
                        LZ4_setStreamDecode(dec, prefix.as_ptr() as *const i8, as_c_int_len(prefix.len()));
                    iter = fold(iter, ssd2 as u64);
                    let r2 = LZ4_decompress_fast_continue(
                        dec,
                        tmp.as_ptr() as *const i8,
                        d2.as_mut_ptr() as *mut i8,
                        as_c_int_len(d2.len()),
                    );
                    last_err = r2;
                    iter = fold(iter, r2 as u64);
                    iter = fold(iter, checksum_bytes(&d2));

                    let mut d3 = vec![0u8; body.len()];
                    let r3 = LZ4_decompress_safe_usingDict(
                        tmp.as_ptr() as *const i8,
                        d3.as_mut_ptr() as *mut i8,
                        cc3,
                        as_c_int_len(d3.len()),
                        prefix.as_ptr() as *const i8,
                        as_c_int_len(prefix.len()),
                    );
                    last_err = r3;
                    iter = fold(iter, r3 as u64);
                    if r3 > 0 {
                        iter = fold(iter, checksum_bytes(&d3[..r3 as usize]));
                    }

                    let mut d4 = vec![0u8; body.len()];
                    let target = as_c_int_len(body.len() / 2 + body.len() % 2);
                    let r4 = LZ4_decompress_safe_partial_usingDict(
                        tmp.as_ptr() as *const i8,
                        d4.as_mut_ptr() as *mut i8,
                        cc3,
                        target,
                        as_c_int_len(d4.len()),
                        prefix.as_ptr() as *const i8,
                        as_c_int_len(prefix.len()),
                    );
                    last_err = r4;
                    iter = fold(iter, r4 as u64);
                    if r4 > 0 {
                        iter = fold(iter, checksum_bytes(&d4[..r4 as usize]));
                    }

                    let mut d5 = vec![0u8; body.len()];
                    let r5 = LZ4_decompress_safe_forceExtDict(
                        tmp.as_ptr() as *const i8,
                        d5.as_mut_ptr() as *mut i8,
                        cc3,
                        as_c_int_len(d5.len()),
                        prefix.as_ptr() as *const _,
                        prefix.len(),
                    );
                    last_err = r5;
                    iter = fold(iter, r5 as u64);
                    if r5 > 0 {
                        iter = fold(iter, checksum_bytes(&d5[..r5 as usize]));
                    }

                    let mut d6 = vec![0u8; body.len()];
                    let r6 = LZ4_decompress_safe_partial_forceExtDict(
                        tmp.as_ptr() as *const i8,
                        d6.as_mut_ptr() as *mut i8,
                        cc3,
                        target,
                        as_c_int_len(d6.len()),
                        prefix.as_ptr() as *const _,
                        prefix.len(),
                    );
                    last_err = r6;
                    iter = fold(iter, r6 as u64);
                    if r6 > 0 {
                        iter = fold(iter, checksum_bytes(&d6[..r6 as usize]));
                    }
                }
            }

            if prefix_len <= 64 * 1024 && body_len > 0 {
                let joined = [&prefix[..], body].concat();
                let mut prefix_stream = LZ4_createStream();
                let mut block1 = vec![0u8; LZ4_compressBound(as_c_int_len(prefix.len())).max(1) as usize];
                let mut block2 = vec![0u8; LZ4_compressBound(as_c_int_len(body.len())).max(1) as usize];
                iter = fold(iter, (!prefix_stream.is_null()) as u64);
                if !prefix_stream.is_null() {
                    let b1 = LZ4_compress_fast_continue(
                        prefix_stream,
                        joined[..prefix.len()].as_ptr() as *const i8,
                        block1.as_mut_ptr() as *mut i8,
                        as_c_int_len(prefix.len()),
                        as_c_int_len(block1.len()),
                        1,
                    );
                    iter = fold(iter, b1 as u64);
                    let b2 = LZ4_compress_fast_continue(
                        prefix_stream,
                        joined[prefix.len()..].as_ptr() as *const i8,
                        block2.as_mut_ptr() as *mut i8,
                        as_c_int_len(body.len()),
                        as_c_int_len(block2.len()),
                        1,
                    );
                    last_err = b2;
                    iter = fold(iter, b2 as u64);

                    if b2 > 0 {
                        let mut buf = vec![0u8; prefix.len() + body.len()];
                        buf[..prefix.len()].copy_from_slice(prefix);

                        let r1 = LZ4_decompress_safe_withPrefix64k(
                            block2.as_ptr() as *const i8,
                            buf[prefix.len()..].as_mut_ptr() as *mut i8,
                            b2,
                            as_c_int_len(body.len()),
                        );
                        last_err = r1;
                        iter = fold(iter, r1 as u64);
                        if r1 > 0 {
                            iter = fold(iter, checksum_bytes(&buf[prefix.len()..prefix.len() + r1 as usize]));
                        }

                        let mut buf2 = vec![0u8; prefix.len() + body.len()];
                        buf2[..prefix.len()].copy_from_slice(prefix);
                        let r2 = LZ4_decompress_fast_withPrefix64k(
                            block2.as_ptr() as *const i8,
                            buf2[prefix.len()..].as_mut_ptr() as *mut i8,
                            as_c_int_len(body.len()),
                        );
                        last_err = r2;
                        iter = fold(iter, r2 as u64);
                        iter = fold(iter, checksum_bytes(&buf2[prefix.len()..]));
                    }

                    let _ = LZ4_freeStream(prefix_stream);
                }
            }

            let mut old_input = vec![0i8; work.len() + 128 * 1024 + 32];
            let old_state = LZ4_create(old_input.as_mut_ptr());
            iter = fold(iter, (!old_state.is_null()) as u64);
            if !old_state.is_null() {
                let rs = LZ4_resetStreamState(old_state, old_input.as_mut_ptr());
                last_err = rs;
                iter = fold(iter, rs as u64);

                let slid = LZ4_slideInputBuffer(old_state);
                let off = if slid.is_null() {
                    0usize
                } else {
                    (slid as usize).wrapping_sub(old_input.as_ptr() as usize)
                };
                iter = fold(iter, off as u64);
            }

            if !enc.is_null() {
                let rc = LZ4_freeStream(enc);
                iter = fold(iter, rc as u64);
            }
            if !dict_stream.is_null() {
                let rc = LZ4_freeStream(dict_stream);
                iter = fold(iter, rc as u64);
            }
            if !dec.is_null() {
                let rc = LZ4_freeStreamDecode(dec);
                iter = fold(iter, rc as u64);
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_api_sweep err={} digest={:016x}", last_err, digest)
}

fn op_lz4hc_legacy_sweep(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let work = extended_input(data, 80 * 1024);
            let mut iter = checksum_bytes(&work);
            let src_len = as_c_int_len(work.len());
            let bound = LZ4_compressBound(src_len).max(1);
            let hc_state_sz = LZ4_sizeofStateHC();
            iter = fold(iter, bound as u64);
            iter = fold(iter, hc_state_sz as u64);

            let mut out = vec![0u8; bound as usize];
            let c1 = LZ4_compressHC_limitedOutput(
                work.as_ptr() as *const i8,
                out.as_mut_ptr() as *mut i8,
                src_len,
                bound,
            );
            last_err = c1;
            iter = fold(iter, c1 as u64);

            let c2 = LZ4_compressHC2_limitedOutput(
                work.as_ptr() as *const i8,
                out.as_mut_ptr() as *mut i8,
                src_len,
                bound,
                10,
            );
            last_err = c2;
            iter = fold(iter, c2 as u64);

            if hc_state_sz > 0 {
                let mut state = vec![0u8; hc_state_sz as usize];

                let a = LZ4_compressHC_withStateHC(
                    state.as_mut_ptr() as *mut _,
                    work.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                );
                last_err = a;
                iter = fold(iter, a as u64);

                let b = LZ4_compressHC_limitedOutput_withStateHC(
                    state.as_mut_ptr() as *mut _,
                    work.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    bound,
                );
                last_err = b;
                iter = fold(iter, b as u64);

                let c = LZ4_compressHC2_withStateHC(
                    state.as_mut_ptr() as *mut _,
                    work.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    11,
                );
                last_err = c;
                iter = fold(iter, c as u64);

                let d = LZ4_compressHC2_limitedOutput_withStateHC(
                    state.as_mut_ptr() as *mut _,
                    work.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    bound,
                    12,
                );
                last_err = d;
                iter = fold(iter, d as u64);

                let e = LZ4_compress_HC_extStateHC_fastReset(
                    state.as_mut_ptr() as *mut _,
                    work.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    bound,
                    9,
                );
                last_err = e;
                iter = fold(iter, e as u64);

                let mut inbuf = vec![0i8; work.len() + 128 * 1024 + 32];
                let rs = LZ4_resetStreamStateHC(state.as_mut_ptr() as *mut _, inbuf.as_mut_ptr());
                last_err = rs;
                iter = fold(iter, rs as u64);
            }

            let prefix_len = work.len().min(48 * 1024).max(1).min(work.len().saturating_sub(1));
            let body_len = (work.len() - prefix_len).min(20 * 1024);
            let prefix = &work[..prefix_len];
            let body = &work[prefix_len..prefix_len + body_len];
            let body_bound = LZ4_compressBound(as_c_int_len(body.len())).max(1);

            let dict_stream = LZ4_createStreamHC();
            let work_stream = LZ4_createStreamHC();
            iter = fold(iter, (!dict_stream.is_null()) as u64);
            iter = fold(iter, (!work_stream.is_null()) as u64);
            if !dict_stream.is_null() && !work_stream.is_null() && body_len > 0 {
                LZ4_resetStreamHC(dict_stream, 9);
                LZ4_resetStreamHC_fast(work_stream, 10);
                let ld = LZ4_loadDictHC(
                    dict_stream,
                    prefix.as_ptr() as *const i8,
                    as_c_int_len(prefix.len()),
                );
                iter = fold(iter, ld as u64);
                LZ4_attach_HC_dictionary(work_stream, dict_stream as *const _);

                let mut cbuf = vec![0u8; body_bound as usize];
                let r1 = LZ4_compress_HC_continue(
                    work_stream,
                    body.as_ptr() as *const i8,
                    cbuf.as_mut_ptr() as *mut i8,
                    as_c_int_len(body.len()),
                    body_bound,
                );
                last_err = r1;
                iter = fold(iter, r1 as u64);

                let r2 = LZ4_compressHC_continue(
                    work_stream,
                    body.as_ptr() as *const i8,
                    cbuf.as_mut_ptr() as *mut i8,
                    as_c_int_len(body.len()),
                );
                last_err = r2;
                iter = fold(iter, r2 as u64);

                let r3 = LZ4_compressHC_limitedOutput_continue(
                    work_stream,
                    body.as_ptr() as *const i8,
                    cbuf.as_mut_ptr() as *mut i8,
                    as_c_int_len(body.len()),
                    body_bound,
                );
                last_err = r3;
                iter = fold(iter, r3 as u64);
            }
            if !dict_stream.is_null() {
                let rc = LZ4_freeStreamHC(dict_stream);
                iter = fold(iter, rc as u64);
            }
            if !work_stream.is_null() {
                let rc = LZ4_freeStreamHC(work_stream);
                iter = fold(iter, rc as u64);
            }

            let mut old_in = vec![0i8; work.len() + 128 * 1024 + 32];
            let old = LZ4_createHC(old_in.as_ptr());
            iter = fold(iter, (!old.is_null()) as u64);
            if !old.is_null() && body_len > 0 {
                let rs = LZ4_resetStreamStateHC(old, old_in.as_mut_ptr());
                last_err = rs;
                iter = fold(iter, rs as u64);

                let mut cbuf = vec![0u8; body_bound as usize];
                let z1 = LZ4_compressHC2_continue(
                    old,
                    body.as_ptr() as *const i8,
                    cbuf.as_mut_ptr() as *mut i8,
                    as_c_int_len(body.len()),
                    9,
                );
                last_err = z1;
                iter = fold(iter, z1 as u64);

                let z2 = LZ4_compressHC2_limitedOutput_continue(
                    old,
                    body.as_ptr() as *const i8,
                    cbuf.as_mut_ptr() as *mut i8,
                    as_c_int_len(body.len()),
                    body_bound,
                    10,
                );
                last_err = z2;
                iter = fold(iter, z2 as u64);

                let slid = LZ4_slideInputBufferHC(old);
                let off = if slid.is_null() {
                    0usize
                } else {
                    (slid as usize).wrapping_sub(old_in.as_ptr() as usize)
                };
                iter = fold(iter, off as u64);

                let frc = LZ4_freeHC(old);
                iter = fold(iter, frc as u64);
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4hc_legacy_sweep err={} digest={:016x}", last_err, digest)
}

fn op_lz4_frame_misc(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for _ in 0..iters {
        unsafe {
            let work = extended_input(data, 48 * 1024);
            let mut iter = checksum_bytes(&work);
            iter = fold(iter, LZ4F_getVersion() as u64);
            iter = fold(iter, LZ4F_compressionLevel_max() as u64);
            iter = fold(iter, LZ4F_getBlockSize(LZ4F_max64KB) as u64);
            iter = fold(iter, LZ4F_getBlockSize(LZ4F_max256KB) as u64);
            iter = fold(iter, LZ4F_getBlockSize(LZ4F_max1MB) as u64);
            iter = fold(iter, LZ4F_getBlockSize(LZ4F_max4MB) as u64);

            let mut cctx: *mut LZ4F_cctx = ptr::null_mut();
            let rc = LZ4F_createCompressionContext(&mut cctx as *mut *mut _, LZ4F_getVersion());
            iter = fold(iter, rc as u64);
            last_err = rc as u64;
            if LZ4F_isError(rc) != 0 || cctx.is_null() {
                digest = fold(digest, iter);
                continue;
            }

            let mut prefs = zeroed_prefs();
            prefs.compressionLevel = LZ4F_compressionLevel_max();
            prefs.autoFlush = 1;
            prefs.frameInfo.blockMode = LZ4F_blockLinked;
            prefs.frameInfo.blockSizeID = LZ4F_max64KB;
            prefs.frameInfo.contentChecksumFlag = LZ4F_contentChecksumEnabled;
            prefs.frameInfo.blockChecksumFlag = LZ4F_blockChecksumEnabled;
            prefs.frameInfo.contentSize = work.len() as u64;

            let mut hdr = vec![0u8; 256];
            let hsz = LZ4F_compressBegin(
                cctx,
                hdr.as_mut_ptr() as *mut _,
                hdr.len(),
                &prefs as *const _,
            );
            iter = fold(iter, hsz as u64);
            last_err = hsz as u64;

            if LZ4F_isError(hsz) == 0 && hsz <= hdr.len() {
                let mut out = Vec::new();
                out.extend_from_slice(&hdr[..hsz]);

                let mut copts = zeroed_copts();
                copts.stableSrc = 1;

                let p1 = work.len() / 2;
                let parts = [&work[..p1], &work[p1..]];
                for (idx, part) in parts.into_iter().enumerate() {
                    let need = LZ4F_compressBound(part.len(), &prefs as *const _).saturating_add(64);
                    let start = out.len();
                    out.resize(start + need, 0);
                    let wrote = if idx == 0 {
                        LZ4F_uncompressedUpdate(
                            cctx,
                            out[start..].as_mut_ptr() as *mut _,
                            out.len() - start,
                            if part.is_empty() {
                                ptr::null()
                            } else {
                                part.as_ptr() as *const _
                            },
                            part.len(),
                            &copts as *const _,
                        )
                    } else {
                        LZ4F_compressUpdate(
                            cctx,
                            out[start..].as_mut_ptr() as *mut _,
                            out.len() - start,
                            if part.is_empty() {
                                ptr::null()
                            } else {
                                part.as_ptr() as *const _
                            },
                            part.len(),
                            &copts as *const _,
                        )
                    };
                    iter = fold(iter, wrote as u64);
                    last_err = wrote as u64;
                    if LZ4F_isError(wrote) != 0 {
                        break;
                    }
                    out.truncate(start + wrote);
                }

                let start = out.len();
                out.resize(start + 256, 0);
                let endsz = LZ4F_compressEnd(
                    cctx,
                    out[start..].as_mut_ptr() as *mut _,
                    out.len() - start,
                    &copts as *const _,
                );
                iter = fold(iter, endsz as u64);
                last_err = endsz as u64;
                if LZ4F_isError(endsz) == 0 {
                    out.truncate(start + endsz);
                    iter = fold(iter, checksum_bytes(&out));

                    let mut dctx: *mut LZ4F_dctx = ptr::null_mut();
                    let drc =
                        LZ4F_createDecompressionContext(&mut dctx as *mut *mut _, LZ4F_getVersion());
                    iter = fold(iter, drc as u64);
                    if LZ4F_isError(drc) == 0 && !dctx.is_null() {
                        let mut produced = Vec::new();
                        let mut consumed = 0usize;
                        while consumed < out.len() {
                            let mut dst = vec![0u8; 32 * 1024];
                            let mut dst_sz = dst.len();
                            let mut src_sz = out.len() - consumed;
                            let rr = LZ4F_decompress(
                                dctx,
                                dst.as_mut_ptr() as *mut _,
                                &mut dst_sz,
                                out[consumed..].as_ptr() as *const _,
                                &mut src_sz,
                                ptr::null(),
                            );
                            iter = fold(iter, rr as u64);
                            iter = fold(iter, src_sz as u64);
                            iter = fold(iter, dst_sz as u64);
                            if dst_sz > 0 {
                                produced.extend_from_slice(&dst[..dst_sz]);
                            }
                            consumed += src_sz;
                            if LZ4F_isError(rr) != 0 || rr == 0 || (src_sz == 0 && dst_sz == 0) {
                                break;
                            }
                        }
                        iter = fold(iter, produced.len() as u64);
                        iter = fold(iter, checksum_bytes(&produced));
                        let frc = LZ4F_freeDecompressionContext(dctx);
                        iter = fold(iter, frc as u64);
                    }
                }
            }

            let bad_bytes = [0u8, 1, 2, 3, 4, 5, 6, 7];
            let mut dctx: *mut LZ4F_dctx = ptr::null_mut();
            let drc = LZ4F_createDecompressionContext(&mut dctx as *mut *mut _, LZ4F_getVersion());
            iter = fold(iter, drc as u64);
            if LZ4F_isError(drc) == 0 && !dctx.is_null() {
                let mut fi = MaybeUninit::<LZ4F_frameInfo_t>::zeroed();
                let mut src_sz = bad_bytes.len();
                let bad = LZ4F_getFrameInfo(
                    dctx,
                    fi.as_mut_ptr(),
                    bad_bytes.as_ptr() as *const _,
                    &mut src_sz,
                );
                last_err = bad as u64;
                iter = fold(iter, bad as u64);
                let code = LZ4F_getErrorCode(bad);
                let name = LZ4F_getErrorName(bad);
                iter = fold(iter, code as u64);
                iter = fold(iter, (!name.is_null()) as u64);
                if !name.is_null() {
                    iter = fold(iter, checksum_bytes(CStr::from_ptr(name).to_bytes()));
                }
                let frc = LZ4F_freeDecompressionContext(dctx);
                iter = fold(iter, frc as u64);
            }

            let frc = LZ4F_freeCompressionContext(cctx);
            iter = fold(iter, frc as u64);
            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_frame_misc err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        (
            "lz4_block_roundtrip",
            op_lz4_block_roundtrip as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_frame_decompress",
            op_lz4_frame_decompress as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_hc_block_roundtrip",
            op_lz4_hc_block_roundtrip as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_frame_compress_roundtrip",
            op_lz4_frame_compress_roundtrip as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_legacy_api_mix",
            op_lz4_legacy_api_mix as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_file_roundtrip",
            op_lz4_file_roundtrip as fn(&[u8], u64) -> String,
        ),
        (
            "xxhash_streaming",
            op_xxhash_streaming as fn(&[u8], u64) -> String,
        ),
        ("lz4_api_sweep", op_lz4_api_sweep as fn(&[u8], u64) -> String),
        (
            "lz4hc_legacy_sweep",
            op_lz4hc_legacy_sweep as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_frame_misc",
            op_lz4_frame_misc as fn(&[u8], u64) -> String,
        ),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let raw1 = realistic_text_payload(220);
    let raw2 = realistic_binary_payload(320);
    let raw3 = realistic_mixed_payload(180);
    let raw4 = extended_input(&raw2, 96 * 1024);
    let raw5 = extended_input(&raw3, 80 * 1024);
    let frame1 = make_frame_bytes(&raw1);
    let frame2 = make_frame_bytes_streaming(&raw3, &raw3[..raw3.len().min(4096)], true);

    let seeds: [(&str, &Vec<u8>, &Vec<u8>); 10] = [
        ("lz4_block_roundtrip", &raw1, &raw2),
        ("lz4_frame_decompress", &frame1, &frame2),
        ("lz4_hc_block_roundtrip", &raw2, &raw3),
        ("lz4_frame_compress_roundtrip", &raw1, &raw3),
        ("lz4_legacy_api_mix", &raw1, &raw2),
        ("lz4_file_roundtrip", &raw2, &raw3),
        ("xxhash_streaming", &raw1, &raw2),
        ("lz4_api_sweep", &raw4, &raw5),
        ("lz4hc_legacy_sweep", &raw5, &raw4),
        ("lz4_frame_misc", &raw3, &raw1),
    ];

    for (op, a, b) in seeds {
        let p1 = format!("{}/{}.1.bin", dir, op);
        let p2 = format!("{}/{}.2.bin", dir, op);
        let _ = fs::write(&p1, a);
        let _ = fs::write(&p2, b);
        lines.push(format!("seed {} {}", op, p1));
        lines.push(format!("seed {} {}", op, p2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let big_text = realistic_text_payload(40_000);
    let big_bin = realistic_binary_payload(45_000);
    let big_mix = {
        let mut v = Vec::with_capacity(big_text.len() + big_bin.len() + 1024);
        v.extend_from_slice(&big_text);
        v.extend_from_slice(b"\n====\n");
        v.extend_from_slice(&big_bin);
        v.extend_from_slice(b"\nfooter=done repeated repeated repeated repeated\n");
        v
    };
    let big_ext = extended_input(&big_mix, 6 * 1024 * 1024);

    for (op, bytes) in [
        ("lz4_block_roundtrip", &big_mix),
        ("lz4_hc_block_roundtrip", &big_mix),
        ("lz4_frame_compress_roundtrip", &big_mix),
        ("lz4_legacy_api_mix", &big_mix),
        ("lz4_file_roundtrip", &big_mix),
        ("xxhash_streaming", &big_mix),
        ("lz4_api_sweep", &big_ext),
        ("lz4hc_legacy_sweep", &big_ext),
        ("lz4_frame_misc", &big_mix),
    ] {
        let path = format!("{}/{}.perf.bin", dir, op);
        let _ = fs::write(&path, bytes);
        lines.push(format!("perf {} {}", op, path));
    }

    let frame = make_frame_bytes_streaming(&big_mix, &big_mix[..big_mix.len().min(8192)], true);
    let frame_path = format!("{}/lz4_frame_decompress.perf.bin", dir);
    let _ = fs::write(&frame_path, &frame);
    lines.push(format!("perf {} {}", "lz4_frame_decompress", frame_path));

    lines
}

