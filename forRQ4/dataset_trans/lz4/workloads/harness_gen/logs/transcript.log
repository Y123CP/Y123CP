unsafe fn zeroed_prefs() -> LZ4F_preferences_t {
    unsafe { MaybeUninit::<LZ4F_preferences_t>::zeroed().assume_init() }
}

unsafe fn zeroed_copts() -> LZ4F_compressOptions_t {
    unsafe { MaybeUninit::<LZ4F_compressOptions_t>::zeroed().assume_init() }
}

unsafe fn zeroed_dopts() -> LZ4F_decompressOptions_t {
    unsafe { MaybeUninit::<LZ4F_decompressOptions_t>::zeroed().assume_init() }
}

unsafe fn zeroed_custom_mem() -> LZ4F_CustomMem {
    unsafe { MaybeUninit::<LZ4F_CustomMem>::zeroed().assume_init() }
}

fn lz4f_extra_bound(prefs: &LZ4F_preferences_t) -> usize {
    unsafe { LZ4F_compressBound(0, prefs as *const _).saturating_add(256) }
}

fn make_frame_bytes(src: &[u8]) -> Vec<u8> {
    unsafe {
        let mut prefs = zeroed_prefs();
        prefs.compressionLevel = 3;
        prefs.autoFlush = 0;
        prefs.frameInfo.blockMode = LZ4F_blockLinked;
        prefs.frameInfo.blockSizeID = LZ4F_max256KB;
        prefs.frameInfo.contentChecksumFlag = LZ4F_contentChecksumEnabled;
        prefs.frameInfo.blockChecksumFlag = LZ4F_blockChecksumEnabled;
        prefs.frameInfo.contentSize = src.len() as u64;

        let bound = LZ4F_compressFrameBound(src.len(), &prefs as *const _);
        if bound == 0 {
            return Vec::new();
        }
        let mut out = vec![0u8; bound];
        let written = LZ4F_compressFrame(
            out.as_mut_ptr() as *mut _,
            out.len(),
            if src.is_empty() {
                ptr::null()
            } else {
                src.as_ptr() as *const _
            },
            src.len(),
            &prefs as *const _,
        );
        if LZ4F_isError(written) != 0 || written > out.len() {
            Vec::new()
        } else {
            out.truncate(written);
            out
        }
    }
}

fn make_frame_bytes_streaming(src: &[u8], dict: &[u8], use_cdict: bool) -> Vec<u8> {
    unsafe {
        let mut prefs = zeroed_prefs();
        prefs.compressionLevel = 9;
        prefs.autoFlush = 0;
        prefs.frameInfo.blockMode = LZ4F_blockLinked;
        prefs.frameInfo.blockSizeID = LZ4F_max256KB;
        prefs.frameInfo.contentChecksumFlag = LZ4F_contentChecksumEnabled;
        prefs.frameInfo.blockChecksumFlag = LZ4F_blockChecksumEnabled;
        prefs.frameInfo.contentSize = src.len() as u64;

        let mut cctx: *mut LZ4F_cctx = ptr::null_mut();
        let crc = LZ4F_createCompressionContext(&mut cctx as *mut *mut _, LZ4F_getVersion());
        if LZ4F_isError(crc) != 0 || cctx.is_null() {
            return Vec::new();
        }

        let initial = LZ4F_compressFrameBound(src.len(), &prefs as *const _)
            .saturating_add(lz4f_extra_bound(&prefs))
            .saturating_add(256);
        let mut out = vec![0u8; initial.max(512)];
        let mut pos = 0usize;
        let mut hdr = vec![0u8; 256];

        let hsz = if use_cdict {
            let cdict = LZ4F_createCDict(
                if dict.is_empty() {
                    ptr::null()
                } else {
                    dict.as_ptr() as *const _
                },
                dict.len(),
            );
            if cdict.is_null() {
                LZ4F_compressBegin(
                    cctx,
                    hdr.as_mut_ptr() as *mut _,
                    hdr.len(),
                    &prefs as *const _,
                )
            } else {
                let rc = LZ4F_compressBegin_usingCDict(
                    cctx,
                    hdr.as_mut_ptr() as *mut _,
                    hdr.len(),
                    cdict,
                    &prefs as *const _,
                );
                LZ4F_freeCDict(cdict);
                rc
            }
        } else {
            LZ4F_compressBegin_usingDict(
                cctx,
                hdr.as_mut_ptr() as *mut _,
                hdr.len(),
                if dict.is_empty() {
                    ptr::null()
                } else {
                    dict.as_ptr() as *const _
                },
                dict.len(),
                &prefs as *const _,
            )
        };

        if LZ4F_isError(hsz) != 0 || hsz > hdr.len() {
            let _ = LZ4F_freeCompressionContext(cctx);
            return Vec::new();
        }
        if pos + hsz > out.len() {
            out.resize(pos + hsz, 0);
        }
        out[pos..pos + hsz].copy_from_slice(&hdr[..hsz]);
        pos += hsz;

        let mut copts = zeroed_copts();
        copts.stableSrc = 1;

        let mut off = 0usize;
        while off < src.len() {
            let end = (off + 32 * 1024).min(src.len());
            let part = &src[off..end];
            let need = LZ4F_compressBound(part.len(), &prefs as *const _).saturating_add(64);
            if pos + need > out.len() {
                out.resize(pos + need, 0);
            }
            let wsz = LZ4F_compressUpdate(
                cctx,
                out[pos..].as_mut_ptr() as *mut _,
                out.len() - pos,
                if part.is_empty() {
                    ptr::null()
                } else {
                    part.as_ptr() as *const _
                },
                part.len(),
                &copts as *const _,
            );
            if LZ4F_isError(wsz) != 0 || wsz > out.len() - pos {
                let _ = LZ4F_freeCompressionContext(cctx);
                return Vec::new();
            }
            pos += wsz;
            off = end;
        }

        let flush_need = lz4f_extra_bound(&prefs);
        if pos + flush_need > out.len() {
            out.resize(pos + flush_need, 0);
        }
        let fsz = LZ4F_flush(
            cctx,
            out[pos..].as_mut_ptr() as *mut _,
            out.len() - pos,
            &copts as *const _,
        );
        if LZ4F_isError(fsz) != 0 || fsz > out.len() - pos {
            let _ = LZ4F_freeCompressionContext(cctx);
            return Vec::new();
        }
        pos += fsz;

        let end_need = lz4f_extra_bound(&prefs);
        if pos + end_need > out.len() {
            out.resize(pos + end_need, 0);
        }
        let esz = LZ4F_compressEnd(
            cctx,
            out[pos..].as_mut_ptr() as *mut _,
            out.len() - pos,
            &copts as *const _,
        );
        let _ = LZ4F_freeCompressionContext(cctx);
        if LZ4F_isError(esz) != 0 || esz > out.len() - pos {
            return Vec::new();
        }
        pos += esz;
        out.truncate(pos);
        out
    }
}

fn op_lz4_block_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            iter = fold(iter, LZ4_versionNumber() as u64);

            let vstr = LZ4_versionString();
            iter = fold(iter, (!vstr.is_null()) as u64);
            if !vstr.is_null() {
                iter = fold(iter, checksum_bytes(CStr::from_ptr(vstr).to_bytes()));
            }

            let src_len = as_c_int_len(data.len());
            let bound = LZ4_compressBound(src_len);
            iter = fold(iter, bound as u64);
            iter = fold(iter, LZ4_sizeofState() as u64);
            iter = fold(iter, LZ4_sizeofStreamState() as u64);

            if data.is_empty() || bound <= 0 {
                last_err = bound;
                digest = fold(digest, iter);
                continue;
            }

            let mut compressed = vec![0u8; bound as usize];
            let csz = LZ4_compress_default(
                data.as_ptr() as *const i8,
                compressed.as_mut_ptr() as *mut i8,
                src_len,
                bound,
            );
            last_err = csz;
            iter = fold(iter, csz as u64);

            if csz > 0 {
                let mut decomp = vec![0u8; data.len()];
                let dsz = LZ4_decompress_safe(
                    compressed.as_ptr() as *const i8,
                    decomp.as_mut_ptr() as *mut i8,
                    csz,
                    src_len,
                );
                last_err = dsz;
                iter = fold(iter, dsz as u64);
                iter = fold(iter, (dsz == src_len && decomp == data) as u64);
                if dsz > 0 {
                    iter = fold(iter, checksum_bytes(&decomp[..dsz as usize]));
                }

                let mut fast = vec![0u8; data.len()];
                let fsz = LZ4_decompress_fast(
                    compressed.as_ptr() as *const i8,
                    fast.as_mut_ptr() as *mut i8,
                    src_len,
                );
                last_err = fsz;
                iter = fold(iter, fsz as u64);
                iter = fold(iter, checksum_bytes(&fast));

                let mut partial = vec![0u8; data.len()];
                let target = as_c_int_len(data.len() / 2 + data.len() % 2);
                let psz = LZ4_decompress_safe_partial(
                    compressed.as_ptr() as *const i8,
                    partial.as_mut_ptr() as *mut i8,
                    csz,
                    target,
                    src_len,
                );
                last_err = psz;
                iter = fold(iter, psz as u64);
                if psz > 0 {
                    iter = fold(iter, checksum_bytes(&partial[..psz as usize]));
                }
            }

            let state_sz = LZ4_sizeofState();
            if state_sz > 0 {
                let mut state = vec![0u8; state_sz as usize];
                let mut out2 = vec![0u8; bound.max(1) as usize];

                let c2 = LZ4_compress_fast_extState(
                    state.as_mut_ptr() as *mut _,
                    data.as_ptr() as *const i8,
                    out2.as_mut_ptr() as *mut i8,
                    src_len,
                    bound,
                    2,
                );
                last_err = c2;
                iter = fold(iter, c2 as u64);

                let c3 = LZ4_compress_fast_extState_fastReset(
                    state.as_mut_ptr() as *mut _,
                    data.as_ptr() as *const i8,
                    out2.as_mut_ptr() as *mut i8,
                    src_len,
                    bound,
                    3,
                );
                last_err = c3;
                iter = fold(iter, c3 as u64);

                let mut src_size = src_len;
                let c4 = LZ4_compress_destSize(
                    data.as_ptr() as *const i8,
                    out2.as_mut_ptr() as *mut i8,
                    &mut src_size,
                    (bound / 2).max(1),
                );
                last_err = c4;
                iter = fold(iter, c4 as u64);
                iter = fold(iter, src_size as u64);

                let mut src_size2 = src_len;
                let c5 = LZ4_compress_destSize_extState(
                    state.as_mut_ptr() as *mut _,
                    data.as_ptr() as *const i8,
                    out2.as_mut_ptr() as *mut i8,
                    &mut src_size2,
                    (bound / 2).max(1),
                    4,
                );
                last_err = c5;
                iter = fold(iter, c5 as u64);
                iter = fold(iter, src_size2 as u64);
            }

            let (dict_len, body_len) = split_for_dict(data);
            let enc = LZ4_createStream();
            let dec = LZ4_createStreamDecode();
            iter = fold(iter, (!enc.is_null()) as u64);
            iter = fold(iter, (!dec.is_null()) as u64);

            if !enc.is_null() && !dec.is_null() && dict_len > 0 && body_len > 0 {
                let body = &data[dict_len..dict_len + body_len];
                let cap = LZ4_compressBound(as_c_int_len(body.len()));
                if cap > 0 {
                    let loaded = LZ4_loadDict(enc, data.as_ptr() as *const i8, as_c_int_len(dict_len));
                    let setd = LZ4_setStreamDecode(dec, data.as_ptr() as *const i8, as_c_int_len(dict_len));
                    iter = fold(iter, loaded as u64);
                    iter = fold(iter, setd as u64);

                    let mut c = vec![0u8; cap as usize];
                    let csz2 = LZ4_compress_fast_continue(
                        enc,
                        body.as_ptr() as *const i8,
                        c.as_mut_ptr() as *mut i8,
                        as_c_int_len(body.len()),
                        cap,
                        1,
                    );
                    last_err = csz2;
                    iter = fold(iter, csz2 as u64);

                    if csz2 > 0 {
                        let mut d = vec![0u8; body.len()];
                        let dsz2 = LZ4_decompress_safe_continue(
                            dec,
                            c.as_ptr() as *const i8,
                            d.as_mut_ptr() as *mut i8,
                            csz2,
                            as_c_int_len(d.len()),
                        );
                        last_err = dsz2;
                        iter = fold(iter, dsz2 as u64);
                        iter = fold(iter, (dsz2 == as_c_int_len(body.len()) && d == body) as u64);
                        if dsz2 > 0 {
                            iter = fold(iter, checksum_bytes(&d[..dsz2 as usize]));
                        }
                    }

                    let mut saved = vec![0u8; dict_len.max(1)];
                    let saved_sz =
                        LZ4_saveDict(enc, saved.as_mut_ptr() as *mut i8, as_c_int_len(saved.len()));
                    iter = fold(iter, saved_sz as u64);
                }
            }

            if !enc.is_null() {
                let rc = LZ4_freeStream(enc);
                iter = fold(iter, rc as u64);
            }
            if !dec.is_null() {
                let rc = LZ4_freeStreamDecode(dec);
                iter = fold(iter, rc as u64);
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_block_roundtrip err={} digest={:016x}", last_err, digest)
}

fn op_lz4_frame_decompress(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            iter = fold(iter, LZ4F_getVersion() as u64);

            let mut dctx: *mut LZ4F_dctx = ptr::null_mut();
            let rc = LZ4F_createDecompressionContext(&mut dctx as *mut *mut _, LZ4F_getVersion());
            iter = fold(iter, rc as u64);
            last_err = rc as u64;
            if LZ4F_isError(rc) != 0 || dctx.is_null() {
                digest = fold(digest, iter);
                continue;
            }

            let dctx2 =
                LZ4F_createDecompressionContext_advanced(zeroed_custom_mem(), LZ4F_getVersion());
            iter = fold(iter, (!dctx2.is_null()) as u64);
            if !dctx2.is_null() {
                iter = fold(iter, LZ4F_dctx_size(dctx2) as u64);
                let frc = LZ4F_freeDecompressionContext(dctx2);
                iter = fold(iter, frc as u64);
            }

            iter = fold(iter, LZ4F_dctx_size(dctx) as u64);

            if !data.is_empty() {
                let hdr = LZ4F_headerSize(data.as_ptr() as *const _, data.len());
                iter = fold(iter, hdr as u64);

                let mut fi = MaybeUninit::<LZ4F_frameInfo_t>::zeroed();
                let mut src_sz = data.len();
                let info_rc = LZ4F_getFrameInfo(
                    dctx,
                    fi.as_mut_ptr(),
                    data.as_ptr() as *const _,
                    &mut src_sz,
                );
                iter = fold(iter, info_rc as u64);
                iter = fold(iter, src_sz as u64);
                last_err = info_rc as u64;

                if LZ4F_isError(info_rc) == 0 {
                    let info = fi.assume_init();
                    iter = fold(iter, info.blockSizeID as u64);
                    iter = fold(iter, info.blockMode as u64);
                    iter = fold(iter, info.contentChecksumFlag as u64);
                    iter = fold(iter, info.blockChecksumFlag as u64);
                    iter = fold(iter, info.contentSize);
                    iter = fold(iter, info.dictID as u64);

                    let mut produced = Vec::<u8>::new();
                    let mut consumed = src_sz.min(data.len());
                    let mut steps = 0u64;
                    while consumed < data.len() && steps < 1_000_000 {
                        steps += 1;
                        let mut dst = vec![0u8; 64 * 1024];
                        let mut dst_sz = dst.len();
                        let mut src_part = data.len() - consumed;
                        let drc = LZ4F_decompress(
                            dctx,
                            dst.as_mut_ptr() as *mut _,
                            &mut dst_sz,
                            data[consumed..].as_ptr() as *const _,
                            &mut src_part,
                            ptr::null(),
                        );
                        iter = fold(iter, drc as u64);
                        iter = fold(iter, src_part as u64);
                        iter = fold(iter, dst_sz as u64);
                        last_err = drc as u64;

                        if dst_sz > 0 {
                            produced.extend_from_slice(&dst[..dst_sz]);
                        }
                        consumed = consumed.saturating_add(src_part);

                        if LZ4F_isError(drc) != 0 || drc == 0 || (src_part == 0 && dst_sz == 0) {
                            break;
                        }
                    }
                    iter = fold(iter, produced.len() as u64);
                    iter = fold(iter, checksum_bytes(&produced));

                    LZ4F_resetDecompressionContext(dctx);
                    let mut produced2 = Vec::<u8>::new();
                    let mut consumed2 = 0usize;
                    let mut steps2 = 0u64;
                    let mut dopts = zeroed_dopts();
                    dopts.stableDst = 1;
                    while consumed2 < data.len() && steps2 < 1_000_000 {
                        steps2 += 1;
                        let mut dst = vec![0u8; 32 * 1024];
                        let mut dst_sz = dst.len();
                        let mut src_part = data.len() - consumed2;
                        let drc = LZ4F_decompress_usingDict(
                            dctx,
                            dst.as_mut_ptr() as *mut _,
                            &mut dst_sz,
                            data[consumed2..].as_ptr() as *const _,
                            &mut src_part,
                            ptr::null(),
                            0,
                            &dopts as *const _,
                        );
                        iter = fold(iter, drc as u64);
                        iter = fold(iter, src_part as u64);
                        iter = fold(iter, dst_sz as u64);
                        if dst_sz > 0 {
                            produced2.extend_from_slice(&dst[..dst_sz]);
                        }
                        consumed2 = consumed2.saturating_add(src_part);
                        if LZ4F_isError(drc) != 0 || drc == 0 || (src_part == 0 && dst_sz == 0) {
                            break;
                        }
                    }
                    iter = fold(iter, produced2.len() as u64);
                    iter = fold(iter, checksum_bytes(&produced2));
                } else {
                    let code = LZ4F_getErrorCode(info_rc);
                    let name = LZ4F_getErrorName(info_rc);
                    iter = fold(iter, code as u64);
                    iter = fold(iter, (!name.is_null()) as u64);
                    if !name.is_null() {
                        iter = fold(iter, checksum_bytes(CStr::from_ptr(name).to_bytes()));
                    }
                }
            }

            let frc = LZ4F_freeDecompressionContext(dctx);
            iter = fold(iter, frc as u64);
            if LZ4F_isError(frc) != 0 {
                last_err = frc as u64;
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_frame_decompress err={} digest={:016x}", last_err, digest)
}

fn op_lz4_hc_block_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            let src_len = as_c_int_len(data.len());
            let bound = LZ4_compressBound(src_len);

            iter = fold(iter, LZ4_sizeofStateHC() as u64);
            iter = fold(iter, LZ4_sizeofStreamStateHC() as u64);
            iter = fold(iter, bound as u64);

            if data.is_empty() || bound <= 0 {
                last_err = bound;
                digest = fold(digest, iter);
                continue;
            }

            let mut compressed = vec![0u8; bound as usize];
            let csz = LZ4_compress_HC(
                data.as_ptr() as *const i8,
                compressed.as_mut_ptr() as *mut i8,
                src_len,
                bound,
                9,
            );
            last_err = csz;
            iter = fold(iter, csz as u64);

            if csz > 0 {
                let mut decomp = vec![0u8; data.len()];
                let dsz = LZ4_decompress_safe(
                    compressed.as_ptr() as *const i8,
                    decomp.as_mut_ptr() as *mut i8,
                    csz,
                    src_len,
                );
                last_err = dsz;
                iter = fold(iter, dsz as u64);
                iter = fold(iter, (dsz == src_len && decomp == data) as u64);
                if dsz > 0 {
                    iter = fold(iter, checksum_bytes(&decomp[..dsz as usize]));
                }
            }

            let state_sz = LZ4_sizeofStateHC();
            if state_sz > 0 {
                let mut hc_state = vec![0u8; state_sz as usize];
                let mut out = vec![0u8; bound as usize];

                let e1 = LZ4_compress_HC_extStateHC(
                    hc_state.as_mut_ptr() as *mut _,
                    data.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    bound,
                    10,
                );
                last_err = e1;
                iter = fold(iter, e1 as u64);

                let e2 = LZ4_compressHC(
                    data.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                );
                last_err = e2;
                iter = fold(iter, e2 as u64);

                let e3 = LZ4_compressHC2(
                    data.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    src_len,
                    11,
                );
                last_err = e3;
                iter = fold(iter, e3 as u64);

                let mut src_size = src_len;
                let e4 = LZ4_compress_HC_destSize(
                    hc_state.as_mut_ptr() as *mut _,
                    data.as_ptr() as *const i8,
                    out.as_mut_ptr() as *mut i8,
                    &mut src_size,
                    (bound / 2).max(1),
                    12,
                );
                last_err = e4;
                iter = fold(iter, e4 as u64);
                iter = fold(iter, src_size as u64);
            }

            let (dict_len, body_len) = split_for_dict(data);
            let stream = LZ4_createStreamHC();
            iter = fold(iter, (!stream.is_null()) as u64);

            if !stream.is_null() {
                LZ4_resetStreamHC(stream, 9);
                LZ4_setCompressionLevel(stream, 10);
                LZ4_favorDecompressionSpeed(stream, 0);

                let loaded = LZ4_loadDictHC(
                    stream,
                    if dict_len == 0 {
                        ptr::null()
                    } else {
                        data.as_ptr() as *const i8
                    },
                    as_c_int_len(dict_len),
                );
                last_err = loaded;
                iter = fold(iter, loaded as u64);

                if dict_len > 0 && body_len > 0 {
                    let body = &data[dict_len..dict_len + body_len];
                    let cap = LZ4_compressBound(as_c_int_len(body.len()));
                    iter = fold(iter, cap as u64);
                    if cap > 0 {
                        let mut c = vec![0u8; cap as usize];
                        let csz2 = LZ4_compress_HC_continue(
                            stream,
                            body.as_ptr() as *const i8,
                            c.as_mut_ptr() as *mut i8,
                            as_c_int_len(body.len()),
                            cap,
                        );
                        last_err = csz2;
                        iter = fold(iter, csz2 as u64);

                        let old_csz = LZ4_compressHC_continue(
                            stream,
                            body.as_ptr() as *const i8,
                            c.as_mut_ptr() as *mut i8,
                            as_c_int_len(body.len()),
                        );
                        iter = fold(iter, old_csz as u64);

                        let old_lim = LZ4_compressHC_limitedOutput_continue(
                            stream,
                            body.as_ptr() as *const i8,
                            c.as_mut_ptr() as *mut i8,
                            as_c_int_len(body.len()),
                            cap,
                        );
                        iter = fold(iter, old_lim as u64);

                        let mut body_src = as_c_int_len(body.len());
                        let csz3 = LZ4_compress_HC_continue_destSize(
                            stream,
                            body.as_ptr() as *const i8,
                            c.as_mut_ptr() as *mut i8,
                            &mut body_src,
                            (cap / 2).max(1),
                        );
                        iter = fold(iter, csz3 as u64);
                        iter = fold(iter, body_src as u64);

                        if csz2 > 0 {
                            let mut d = vec![0u8; body.len()];
                            let dsz = LZ4_decompress_safe_usingDict(
                                c.as_ptr() as *const i8,
                                d.as_mut_ptr() as *mut i8,
                                csz2,
                                as_c_int_len(d.len()),
                                data.as_ptr() as *const i8,
                                as_c_int_len(dict_len),
                            );
                            last_err = dsz;
                            iter = fold(iter, dsz as u64);
                            iter = fold(iter, (dsz == as_c_int_len(body.len()) && d == body) as u64);
                            if dsz > 0 {
                                iter = fold(iter, checksum_bytes(&d[..dsz as usize]));
                            }

                            let mut d2 = vec![0u8; body.len()];
                            let fsz = LZ4_decompress_fast_usingDict(
                                c.as_ptr() as *const i8,
                                d2.as_mut_ptr() as *mut i8,
                                as_c_int_len(d2.len()),
                                data.as_ptr() as *const i8,
                                as_c_int_len(dict_len),
                            );
                            last_err = fsz;
                            iter = fold(iter, fsz as u64);
                            iter = fold(iter, checksum_bytes(&d2));
                        }

                        let mut saved = vec![0u8; dict_len.max(1)];
                        let ssz = LZ4_saveDictHC(
                            stream,
                            saved.as_mut_ptr() as *mut i8,
                            as_c_int_len(saved.len()),
                        );
                        iter = fold(iter, ssz as u64);
                    }
                }

                let frc = LZ4_freeStreamHC(stream);
                iter = fold(iter, frc as u64);
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_hc_block_roundtrip err={} digest={:016x}", last_err, digest)
}

fn op_lz4_frame_compress_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            iter = fold(iter, LZ4F_getVersion() as u64);

            let mut prefs = zeroed_prefs();
            prefs.compressionLevel = 9;
            prefs.autoFlush = 0;
            prefs.frameInfo.blockMode = LZ4F_blockLinked;
            prefs.frameInfo.blockSizeID = LZ4F_max256KB;
            prefs.frameInfo.contentChecksumFlag = LZ4F_contentChecksumEnabled;
            prefs.frameInfo.blockChecksumFlag = LZ4F_blockChecksumEnabled;
            prefs.frameInfo.contentSize = data.len() as u64;
            prefs.frameInfo.dictID = 0x1234_5678;

            let bound = LZ4F_compressFrameBound(data.len(), &prefs as *const _);
            iter = fold(iter, bound as u64);
            if bound == 0 {
                digest = fold(digest, iter);
                continue;
            }

            let mut one_shot = vec![0u8; bound];
            let one_sz = LZ4F_compressFrame(
                one_shot.as_mut_ptr() as *mut _,
                one_shot.len(),
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr() as *const _
                },
                data.len(),
                &prefs as *const _,
            );
            last_err = one_sz as u64;
            iter = fold(iter, one_sz as u64);
            if LZ4F_isError(one_sz) == 0 && one_sz <= one_shot.len() {
                one_shot.truncate(one_sz);
                iter = fold(iter, checksum_bytes(&one_shot));
            }

            let dict_len = data.len().min(8192);
            let dict = &data[..dict_len];
            let cdict = LZ4F_createCDict(
                if dict.is_empty() {
                    ptr::null()
                } else {
                    dict.as_ptr() as *const _
                },
                dict.len(),
            );
            let cdict2 = LZ4F_createCDict_advanced(
                zeroed_custom_mem(),
                if dict.is_empty() {
                    ptr::null()
                } else {
                    dict.as_ptr() as *const _
                },
                dict.len(),
            );
            iter = fold(iter, (!cdict.is_null()) as u64);
            iter = fold(iter, (!cdict2.is_null()) as u64);

            let mut cctx: *mut LZ4F_cctx = ptr::null_mut();
            let crc = LZ4F_createCompressionContext(&mut cctx as *mut *mut _, LZ4F_getVersion());
            iter = fold(iter, crc as u64);
            last_err = crc as u64;

            if LZ4F_isError(crc) == 0 && !cctx.is_null() {
                iter = fold(iter, LZ4F_cctx_size(cctx) as u64);

                let mut out = vec![
                    0u8;
                    bound
                        .saturating_add(lz4f_extra_bound(&prefs))
                        .saturating_add(256)
                        .max(512)
                ];
                let mut pos = 0usize;
                let mut hdr = vec![0u8; 256];

                let hsz = LZ4F_compressBegin(
                    cctx,
                    hdr.as_mut_ptr() as *mut _,
                    hdr.len(),
                    &prefs as *const _,
                );
                iter = fold(iter, hsz as u64);
                last_err = hsz as u64;

                if LZ4F_isError(hsz) == 0 && hsz <= hdr.len() {
                    if pos + hsz > out.len() {
                        out.resize(pos + hsz, 0);
                    }
                    out[pos..pos + hsz].copy_from_slice(&hdr[..hsz]);
                    pos += hsz;

                    let mut copts = zeroed_copts();
                    copts.stableSrc = 1;

                    let p1 = data.len() / 3;
                    let p2 = (data.len() * 2) / 3;
                    for part in [&data[..p1], &data[p1..p2], &data[p2..]] {
                        let need =
                            LZ4F_compressBound(part.len(), &prefs as *const _).saturating_add(64);
                        if pos + need > out.len() {
                            out.resize(pos + need, 0);
                        }
                        let wsz = LZ4F_compressUpdate(
                            cctx,
                            out[pos..].as_mut_ptr() as *mut _,
                            out.len() - pos,
                            if part.is_empty() {
                                ptr::null()
                            } else {
                                part.as_ptr() as *const _
                            },
                            part.len(),
                            &copts as *const _,
                        );
                        iter = fold(iter, wsz as u64);
                        last_err = wsz as u64;
                        if LZ4F_isError(wsz) != 0 || wsz > out.len() - pos {
                            break;
                        }
                        pos += wsz;
                    }

                    let flush_need = lz4f_extra_bound(&prefs);
                    if pos + flush_need > out.len() {
                        out.resize(pos + flush_need, 0);
                    }
                    let fsz = LZ4F_flush(
                        cctx,
                        out[pos..].as_mut_ptr() as *mut _,
                        out.len() - pos,
                        &copts as *const _,
                    );
                    iter = fold(iter, fsz as u64);
                    last_err = fsz as u64;
                    if LZ4F_isError(fsz) == 0 && fsz <= out.len() - pos {
                        pos += fsz;
                    }

                    let end_need = lz4f_extra_bound(&prefs);
                    if pos + end_need > out.len() {
                        out.resize(pos + end_need, 0);
                    }
                    let esz = LZ4F_compressEnd(
                        cctx,
                        out[pos..].as_mut_ptr() as *mut _,
                        out.len() - pos,
                        &copts as *const _,
                    );
                    iter = fold(iter, esz as u64);
                    last_err = esz as u64;
                    if LZ4F_isError(esz) == 0 && esz <= out.len() - pos {
                        pos += esz;
                    }
                    out.truncate(pos);
                    iter = fold(iter, checksum_bytes(&out));

                    let mut dctx: *mut LZ4F_dctx = ptr::null_mut();
                    let drc =
                        LZ4F_createDecompressionContext(&mut dctx as *mut *mut _, LZ4F_getVersion());
                    iter = fold(iter, drc as u64);
                    if LZ4F_isError(drc) == 0 && !dctx.is_null() {
                        let mut produced = Vec::new();
                        let mut consumed = 0usize;
                        while consumed < out.len() {
                            let mut dst = vec![0u8; 64 * 1024];
                            let mut dst_sz = dst.len();
                            let mut src_sz = out.len() - consumed;
                            let r = LZ4F_decompress(
                                dctx,
                                dst.as_mut_ptr() as *mut _,
                                &mut dst_sz,
                                out[consumed..].as_ptr() as *const _,
                                &mut src_sz,
                                ptr::null(),
                            );
                            iter = fold(iter, r as u64);
                            iter = fold(iter, src_sz as u64);
                            iter = fold(iter, dst_sz as u64);
                            if dst_sz > 0 {
                                produced.extend_from_slice(&dst[..dst_sz]);
                            }
                            consumed += src_sz;
                            if LZ4F_isError(r) != 0 || r == 0 || (src_sz == 0 && dst_sz == 0) {
                                break;
                            }
                        }
                        iter = fold(iter, produced.len() as u64);
                        iter = fold(iter, checksum_bytes(&produced));
                        let frc = LZ4F_freeDecompressionContext(dctx);
                        iter = fold(iter, frc as u64);
                    }
                }

                if !cdict.is_null() {
                    let mut tmp = vec![0u8; bound.max(1)];
                    let sz = LZ4F_compressFrame_usingCDict(
                        cctx,
                        tmp.as_mut_ptr() as *mut _,
                        tmp.len(),
                        if data.is_empty() {
                            ptr::null()
                        } else {
                            data.as_ptr() as *const _
                        },
                        data.len(),
                        cdict,
                        &prefs as *const _,
                    );
                    iter = fold(iter, sz as u64);
                    if LZ4F_isError(sz) == 0 && sz <= tmp.len() {
                        tmp.truncate(sz);
                        iter = fold(iter, checksum_bytes(&tmp));
                    }
                }

                if !cdict2.is_null() {
                    let mut hdr2 = vec![0u8; 256];
                    let h2 = LZ4F_compressBegin_usingCDict(
                        cctx,
                        hdr2.as_mut_ptr() as *mut _,
                        hdr2.len(),
                        cdict2,
                        &prefs as *const _,
                    );
                    iter = fold(iter, h2 as u64);
                }

                let mut hdr3 = vec![0u8; 256];
                let h3 = LZ4F_compressBegin_usingDict(
                    cctx,
                    hdr3.as_mut_ptr() as *mut _,
                    hdr3.len(),
                    if dict.is_empty() {
                        ptr::null()
                    } else {
                        dict.as_ptr() as *const _
                    },
                    dict.len(),
                    &prefs as *const _,
                );
                iter = fold(iter, h3 as u64);

                let frc = LZ4F_freeCompressionContext(cctx);
                iter = fold(iter, frc as u64);
            }

            if !cdict.is_null() {
                LZ4F_freeCDict(cdict);
            }
            if !cdict2.is_null() {
                LZ4F_freeCDict(cdict2);
            }

            digest = fold(digest, iter);
        }
    }

    format!(
        "op=lz4_frame_compress_roundtrip err={} digest={:016x}",
        last_err, digest
    )
}

fn op_lz4_legacy_api_mix(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            let src_len = as_c_int_len(data.len());
            let bound = LZ4_compressBound(src_len);
            iter = fold(iter, bound as u64);

            if data.is_empty() || bound <= 0 {
                last_err = bound;
                digest = fold(digest, iter);
                continue;
            }

            let mut out = vec![0u8; bound as usize];
            let csz = LZ4_compress_default(
                data.as_ptr() as *const i8,
                out.as_mut_ptr() as *mut i8,
                src_len,
                bound,
            );
            last_err = csz;
            iter = fold(iter, csz as u64);

            if csz > 0 {
                let mut d1 = vec![0u8; data.len()];
                let u1 = LZ4_uncompress(
                    out.as_ptr() as *const i8,
                    d1.as_mut_ptr() as *mut i8,
                    src_len,
                );
                iter = fold(iter, u1 as u64);
                if u1 >= 0 {
                    iter = fold(iter, checksum_bytes(&d1));
                }

                let mut d2 = vec![0u8; data.len()];
                let u2 = LZ4_uncompress_unknownOutputSize(
                    out.as_ptr() as *const i8,
                    d2.as_mut_ptr() as *mut i8,
                    csz,
                    src_len,
                );
                last_err = u2;
                iter = fold(iter, u2 as u64);
                if u2 > 0 {
                    iter = fold(iter, checksum_bytes(&d2[..u2 as usize]));
                }
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_legacy_api_mix err={} digest={:016x}", last_err, digest)
}

fn fopen_path(path: &Path, mode: &str) -> *mut CFile {
    let c_path = match CString::new(path.to_string_lossy().as_bytes()) {
        Ok(s) => s,
        Err(_) => return ptr::null_mut(),
    };
    let c_mode = match CString::new(mode) {
        Ok(s) => s,
        Err(_) => return ptr::null_mut(),
    };
    unsafe { fopen(c_path.as_ptr(), c_mode.as_ptr()) }
}

fn op_lz4_file_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            let mut prefs = zeroed_prefs();
            prefs.compressionLevel = 4;
            prefs.frameInfo.blockMode = LZ4F_blockLinked;
            prefs.frameInfo.blockSizeID = LZ4F_max256KB;
            prefs.frameInfo.contentChecksumFlag = LZ4F_contentChecksumEnabled;
            prefs.frameInfo.contentSize = data.len() as u64;

            let tmp = std::env::temp_dir();
            let out_path = tmp.join("lz4_raw_harness_file_roundtrip.tmp.lz4");

            let mut writer: *mut LZ4_writeFile_t = ptr::null_mut();
            let mut reader: *mut LZ4_readFile_t = ptr::null_mut();

            let fpw = fopen_path(&out_path, "wb");
            iter = fold(iter, (!fpw.is_null()) as u64);
            if !fpw.is_null() {
                let file_prefs: *const LZ4F_preferences_file_t =
                    (&prefs as *const LZ4F_preferences_t).cast::<LZ4F_preferences_file_t>();
                let wrc = LZ4F_writeOpen(&mut writer as *mut *mut _, fpw as *mut _, file_prefs);
                iter = fold(iter, wrc as u64);
                last_err = wrc as u64;

                if LZ4F_isError(wrc) == 0 && !writer.is_null() {
                    let wsz = LZ4F_write(
                        writer,
                        if data.is_empty() {
                            ptr::null()
                        } else {
                            data.as_ptr() as *const _
                        },
                        data.len(),
                    );
                    iter = fold(iter, wsz as u64);
                    last_err = wsz as u64;

                    let wcl = LZ4F_writeClose(writer);
                    iter = fold(iter, wcl as u64);
                    last_err = wcl as u64;
                    writer = ptr::null_mut();
                }

                let crc = fclose(fpw);
                iter = fold(iter, crc as u64);
            }

            if let Ok(bytes) = fs::read(&out_path) {
                iter = fold(iter, bytes.len() as u64);
                iter = fold(iter, checksum_bytes(&bytes));
            }

            let fpr = fopen_path(&out_path, "rb");
            iter = fold(iter, (!fpr.is_null()) as u64);
            if !fpr.is_null() {
                let rrc = LZ4F_readOpen(&mut reader as *mut *mut _, fpr as *mut _);
                iter = fold(iter, rrc as u64);
                last_err = rrc as u64;

                if !reader.is_null() {
                    let mut out = Vec::new();
                    let mut steps = 0u64;
                    loop {
                        steps += 1;
                        if steps > 1_000_000 {
                            break;
                        }
                        let mut buf = vec![0u8; 32 * 1024];
                        let got = LZ4F_read(reader, buf.as_mut_ptr() as *mut _, buf.len());
                        iter = fold(iter, got as u64);
                        if got == 0 || got > buf.len() {
                            break;
                        }
                        out.extend_from_slice(&buf[..got]);
                    }
                    iter = fold(iter, out.len() as u64);
                    iter = fold(iter, checksum_bytes(&out));

                    let rcl = LZ4F_readClose(reader);
                    iter = fold(iter, rcl as u64);
                    last_err = rcl as u64;
                    reader = ptr::null_mut();
                }

                let crc = fclose(fpr);
                iter = fold(iter, crc as u64);
            }

            let _ = fs::remove_file(&out_path);
            digest = fold(digest, iter);
        }
    }

    format!("op=lz4_file_roundtrip err={} digest={:016x}", last_err, digest)
}

fn op_xxhash_streaming(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut iter = checksum_bytes(data);
            iter = fold(iter, XXH_versionNumber() as u64);

            let seed32 = 0x1234_5678u32;
            let seed64 = 0x0123_4567_89ab_cdefu64;

            let h32 = XXH32(
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr() as *const _
                },
                data.len(),
                seed32,
            );
            let h64 = XXH64(
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr() as *const _
                },
                data.len(),
                seed64,
            );
            iter = fold(iter, h32 as u64);
            iter = fold(iter, h64);

            let s32 = XXH32_createState();
            let s32b = XXH32_createState();
            iter = fold(iter, (!s32.is_null()) as u64);
            iter = fold(iter, (!s32b.is_null()) as u64);
            if !s32.is_null() && !s32b.is_null() {
                let rc = XXH32_reset(s32, seed32);
                iter = fold(iter, rc as u64);
                last_err = rc;

                let p1 = data.len() / 3;
                let p2 = (data.len() * 2) / 3;
                let rc1 = XXH32_update(
                    s32,
                    if p1 == 0 {
                        ptr::null()
                    } else {
                        data[..p1].as_ptr() as *const _
                    },
                    p1,
                );
                let rc2 = XXH32_update(
                    s32,
                    if p2 > p1 {
                        data[p1..p2].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    p2.saturating_sub(p1),
                );
                XXH32_copyState(s32b, s32);
                let rc3 = XXH32_update(
                    s32,
                    if data.len() > p2 {
                        data[p2..].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    data.len().saturating_sub(p2),
                );
                let rc4 = XXH32_update(
                    s32b,
                    if data.len() > p2 {
                        data[p2..].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    data.len().saturating_sub(p2),
                );
                iter = fold(iter, rc1 as u64);
                iter = fold(iter, rc2 as u64);
                iter = fold(iter, rc3 as u64);
                iter = fold(iter, rc4 as u64);
                last_err = rc4;

                let d32 = XXH32_digest(s32);
                let d32b = XXH32_digest(s32b);
                iter = fold(iter, d32 as u64);
                iter = fold(iter, d32b as u64);
                iter = fold(iter, (d32 == h32) as u64);
                iter = fold(iter, (d32b == h32) as u64);

                let mut canon32 = MaybeUninit::<XXH32_canonical_t>::zeroed();
                XXH32_canonicalFromHash(canon32.as_mut_ptr(), d32);
                let rt32 = XXH32_hashFromCanonical(canon32.as_ptr());
                iter = fold(iter, rt32 as u64);
                iter = fold(iter, (rt32 == d32) as u64);

                let frc1 = XXH32_freeState(s32);
                let frc2 = XXH32_freeState(s32b);
                iter = fold(iter, frc1 as u64);
                iter = fold(iter, frc2 as u64);
            } else {
                if !s32.is_null() {
                    let frc = XXH32_freeState(s32);
                    iter = fold(iter, frc as u64);
                }
                if !s32b.is_null() {
                    let frc = XXH32_freeState(s32b);
                    iter = fold(iter, frc as u64);
                }
            }

            let s64 = XXH64_createState();
            let s64b = XXH64_createState();
            iter = fold(iter, (!s64.is_null()) as u64);
            iter = fold(iter, (!s64b.is_null()) as u64);
            if !s64.is_null() && !s64b.is_null() {
                let rc = XXH64_reset(s64, seed64);
                iter = fold(iter, rc as u64);
                last_err = rc;

                let p1 = data.len() / 4;
                let p2 = data.len() / 2;
                let p3 = (data.len() * 3) / 4;
                let rc1 = XXH64_update(
                    s64,
                    if p1 == 0 {
                        ptr::null()
                    } else {
                        data[..p1].as_ptr() as *const _
                    },
                    p1,
                );
                let rc2 = XXH64_update(
                    s64,
                    if p2 > p1 {
                        data[p1..p2].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    p2.saturating_sub(p1),
                );
                let rc3 = XXH64_update(
                    s64,
                    if p3 > p2 {
                        data[p2..p3].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    p3.saturating_sub(p2),
                );
                XXH64_copyState(s64b, s64);
                let rc4 = XXH64_update(
                    s64,
                    if data.len() > p3 {
                        data[p3..].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    data.len().saturating_sub(p3),
                );
                let rc5 = XXH64_update(
                    s64b,
                    if data.len() > p3 {
                        data[p3..].as_ptr() as *const _
                    } else {
                        ptr::null()
                    },
                    data.len().saturating_sub(p3),
                );
                iter = fold(iter, rc1 as u64);
                iter = fold(iter, rc2 as u64);
                iter = fold(iter, rc3 as u64);
                iter = fold(iter, rc4 as u64);
                iter = fold(iter, rc5 as u64);
                last_err = rc5;

                let d64 = XXH64_digest(s64);
                let d64b = XXH64_digest(s64b);
                iter = fold(iter, d64);
                iter = fold(iter, d64b);
                iter = fold(iter, (d64 == h64) as u64);
                iter = fold(iter, (d64b == h64) as u64);

                let mut canon64 = MaybeUninit::<XXH64_canonical_t>::zeroed();
                XXH64_canonicalFromHash(canon64.as_mut_ptr(), d64);
                let rt64 = XXH64_hashFromCanonical(canon64.as_ptr());
                iter = fold(iter, rt64);
                iter = fold(iter, (rt64 == d64) as u64);

                let frc1 = XXH64_freeState(s64);
                let frc2 = XXH64_freeState(s64b);
                iter = fold(iter, frc1 as u64);
                iter = fold(iter, frc2 as u64);
            } else {
                if !s64.is_null() {
                    let frc = XXH64_freeState(s64);
                    iter = fold(iter, frc as u64);
                }
                if !s64b.is_null() {
                    let frc = XXH64_freeState(s64b);
                    iter = fold(iter, frc as u64);
                }
            }

            digest = fold(digest, iter);
        }
    }

    format!("op=xxhash_streaming err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        (
            "lz4_block_roundtrip",
            op_lz4_block_roundtrip as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_frame_decompress",
            op_lz4_frame_decompress as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_hc_block_roundtrip",
            op_lz4_hc_block_roundtrip as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_frame_compress_roundtrip",
            op_lz4_frame_compress_roundtrip as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_legacy_api_mix",
            op_lz4_legacy_api_mix as fn(&[u8], u64) -> String,
        ),
        (
            "lz4_file_roundtrip",
            op_lz4_file_roundtrip as fn(&[u8], u64) -> String,
        ),
        (
            "xxhash_streaming",
            op_xxhash_streaming as fn(&[u8], u64) -> String,
        ),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let raw1 = realistic_text_payload(220);
    let raw2 = realistic_binary_payload(320);
    let raw3 = realistic_mixed_payload(180);
    let frame1 = make_frame_bytes(&raw1);
    let frame2 = make_frame_bytes_streaming(&raw3, &raw3[..raw3.len().min(4096)], true);

    let seeds: [(&str, &Vec<u8>, &Vec<u8>); 7] = [
        ("lz4_block_roundtrip", &raw1, &raw2),
        ("lz4_frame_decompress", &frame1, &frame2),
        ("lz4_hc_block_roundtrip", &raw2, &raw3),
        ("lz4_frame_compress_roundtrip", &raw1, &raw3),
        ("lz4_legacy_api_mix", &raw1, &raw2),
        ("lz4_file_roundtrip", &raw2, &raw3),
        ("xxhash_streaming", &raw1, &raw2),
    ];

    for (op, a, b) in seeds {
        let p1 = format!("{}/{}.1.bin", dir, op);
        let p2 = format!("{}/{}.2.bin", dir, op);
        let _ = fs::write(&p1, a);
        let _ = fs::write(&p2, b);
        lines.push(format!("seed {} {}", op, p1));
        lines.push(format!("seed {} {}", op, p2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let big_text = realistic_text_payload(5_500);
    let big_bin = realistic_binary_payload(6_500);
    let big_mix = {
        let mut v = Vec::with_capacity(big_text.len() + big_bin.len() + 4096);
        v.extend_from_slice(&big_text);
        v.extend_from_slice(b"\n====\n");
        v.extend_from_slice(&big_bin);
        v.extend_from_slice(b"\nfooter=done repeated repeated repeated repeated\n");
        v
    };

    for (op, bytes) in [
        ("lz4_block_roundtrip", &big_mix),
        ("lz4_hc_block_roundtrip", &big_mix),
        ("lz4_frame_compress_roundtrip", &big_mix),
        ("lz4_legacy_api_mix", &big_mix),
        ("lz4_file_roundtrip", &big_mix),
        ("xxhash_streaming", &big_mix),
    ] {
        let path = format!("{}/{}.perf.bin", dir, op);
        let _ = fs::write(&path, bytes);
        lines.push(format!("perf {} {}", op, path));
    }

    let dict_len = big_mix.len().min(8192);
    let frame = make_frame_bytes_streaming(&big_mix, &big_mix[..dict_len], true);
    let frame_path = format!("{}/lz4_frame_decompress.perf.bin", dir);
    let _ = fs::write(&frame_path, &frame);
    lines.push(format!("perf {} {}", "lz4_frame_decompress", frame_path));

    lines
}
