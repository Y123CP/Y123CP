set i 0
while {$i < 5} { inc i }
print [expr $i * 10]
set code {print concat-worked}
eval $code
print [char 65][char 66]
set joined [concat "[list a b]" "[list c d]"]
print $joined
set n 10
dec n 3
print $n
set hay "the quick brown fox"
print [index $hay 2] [indexof "quick" $hay] [slice $hay 4 9]
print [quote {raw $text here}]
try { error "boom" } { print "caught: error" }
print [unusedname]
store /tmp/lil_vw_store.txt "stored-content-42"
print [read /tmp/lil_vw_store.txt]
