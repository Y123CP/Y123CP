```rust
use std::fs;
use std::ptr;

use lil_raw::src::lil::{
    lil_alloc_double, lil_alloc_integer, lil_alloc_list, lil_alloc_string,
    lil_alloc_string_len, lil_append_char, lil_append_string, lil_append_string_len,
    lil_append_val, lil_arg, lil_call, lil_callback, lil_clone_value, lil_embedded,
    lil_error, lil_eval_expr, lil_free, lil_free_list, lil_free_value, lil_freemem,
    lil_get_data, lil_get_var, lil_get_var_or, lil_list_append, lil_list_get,
    lil_list_size, lil_list_to_value, lil_new, lil_parse, lil_parse_value,
    lil_pop_env, lil_push_env, lil_register, lil_set_data, lil_set_error,
    lil_set_error_at, lil_set_var, lil_subst_to_list, lil_subst_to_value,
    lil_to_boolean, lil_to_double, lil_to_integer, lil_to_string, lil_unused_name,
    lil_write, lil_free_env, lil_alloc_env,
    lil_t, lil_value_t,
};

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(1) ^ x
}

fn fold_bytes(acc: u64, bytes: &[u8]) -> u64 {
    let mut h = acc;
    for &b in bytes {
        h = fold(h, b as u64);
    }
    h
}

unsafe fn cstr_bytes(p: *const ::core::ffi::c_char) -> &'static [u8] {
    if p.is_null() {
        return &[];
    }
    let mut len = 0usize;
    while *p.add(len) != 0 {
        len += 1;
    }
    std::slice::from_raw_parts(p as *const u8, len)
}

unsafe fn fold_value(h: u64, v: lil_value_t) -> u64 {
    if v.is_null() {
        return fold(h, 0xDEADu64);
    }
    let s = lil_to_string(v);
    let bytes = cstr_bytes(s);
    let h = fold_bytes(h, bytes);
    let i = lil_to_integer(v);
    let h = fold(h, i as u64);
    let b = lil_to_boolean(v);
    fold(h, b as u64)
}

unsafe fn fold_error(h: u64, lil: lil_t) -> (u64, i32) {
    let mut err_msg: *const ::core::ffi::c_char = ptr::null();
    let mut err_pos: usize = 0;
    let err_flag = lil_error(lil, &mut err_msg, &mut err_pos);
    let h = fold(h, err_flag as u64);
    let h = fold(h, err_pos as u64);
    if !err_msg.is_null() {
        let h = fold_bytes(h, cstr_bytes(err_msg));
        (h, err_flag)
    } else {
        (h, err_flag)
    }
}

unsafe fn run_script(lil: lil_t, script: &[u8]) -> (u64, lil_value_t) {
    let mut code_buf: Vec<u8> = script.to_vec();
    code_buf.push(0);
    let result = lil_parse(
        lil,
        code_buf.as_ptr() as *const ::core::ffi::c_char,
        script.len(),
        0,
    );
    let h = fold_value(0u64, result);
    (h, result)
}

unsafe fn run_script_fold(lil: lil_t, script: &[u8], h: u64) -> u64 {
    let (h2, result) = run_script(lil, script);
    let h = fold(h, h2);
    if !result.is_null() {
        lil_free_value(result);
    }
    h
}

fn op_parse_eval(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }
            let mut code_buf: Vec<u8> = data.to_vec();
            code_buf.push(0);
            let result = lil_parse(
                lil,
                code_buf.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
                0,
            );
            let mut h = fold_value(0u64, result);
            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;
            if !result.is_null() {
                lil_free_value(result);
            }
            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=parse_eval err={} digest={:016x}", last_err, digest)
}

fn op_value_ops(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let int_seed: i64 = {
                let mut buf = [0u8; 8];
                for (i, &b) in data.iter().enumerate().take(8) {
                    buf[i] = b;
                }
                i64::from_le_bytes(buf)
            };

            let dbl_seed: f64 = {
                let mut buf = [0u8; 8];
                for i in 8..data.len().min(16) {
                    buf[i - 8] = data[i];
                }
                f64::from_le_bytes(buf)
            };

            let str_start = data.len().min(16);
            let str_data = &data[str_start..];

            let mut str_buf: Vec<u8> = str_data.to_vec();
            str_buf.push(0);
            let v_str = lil_alloc_string(str_buf.as_ptr() as *const ::core::ffi::c_char);
            let v_str_len = lil_alloc_string_len(
                str_buf.as_ptr() as *const ::core::ffi::c_char,
                str_data.len(),
            );
            let v_int = lil_alloc_integer(int_seed);
            let v_dbl = lil_alloc_double(dbl_seed);
            let v_clone = lil_clone_value(v_str);

            let ch = if !str_data.is_empty() {
                str_data[0] as ::core::ffi::c_char
            } else {
                b'X' as ::core::ffi::c_char
            };
            lil_append_char(v_clone, ch);
            lil_append_string(v_clone, b"_appended\0".as_ptr() as *const ::core::ffi::c_char);
            lil_append_string_len(v_clone, b"XYZ".as_ptr() as *const ::core::ffi::c_char, 3);
            lil_append_val(v_clone, v_int);

            let mut h = fold_value(0u64, v_clone);
            let dbl_val = lil_to_double(v_clone);
            h = fold(h, dbl_val.to_bits());
            h = fold(h, lil_to_integer(v_int) as u64);
            h = fold(h, lil_to_double(v_dbl).to_bits());

            let v_null = lil_clone_value(ptr::null_mut());
            h = fold_value(h, v_null);
            if !v_null.is_null() {
                lil_free_value(v_null);
            }

            lil_free_value(v_str);
            lil_free_value(v_str_len);
            lil_free_value(v_int);
            lil_free_value(v_dbl);
            lil_free_value(v_clone);

            digest = fold(digest, h);
        }
    }
    format!("op=value_ops digest={:016x}", digest)
}

fn op_list_ops(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let segments: Vec<&[u8]> = data.split(|&b| b == 0).collect();
            let list = lil_alloc_list();

            for seg in &segments {
                let v = if seg.is_empty() {
                    lil_alloc_string_len(ptr::null(), 0)
                } else {
                    lil_alloc_string_len(
                        seg.as_ptr() as *const ::core::ffi::c_char,
                        seg.len(),
                    )
                };
                lil_list_append(list, v);
            }

            let size = lil_list_size(list);
            let mut h = fold(0u64, size as u64);

            for i in 0..size {
                let elem = lil_list_get(list, i);
                h = fold_value(h, elem);
            }

            let list_val = lil_list_to_value(list, 1);
            h = fold_value(h, list_val);

            let list_val2 = lil_list_to_value(list, 0);
            h = fold_value(h, list_val2);

            let sub_list = lil_subst_to_list(lil, list_val);
            if !sub_list.is_null() {
                let sub_size = lil_list_size(sub_list);
                h = fold(h, sub_size as u64);
                lil_free_list(sub_list);
            }

            let sub_val = lil_subst_to_value(lil, list_val);
            if !sub_val.is_null() {
                h = fold_value(h, sub_val);
                lil_free_value(sub_val);
            }

            lil_free_value(list_val);
            lil_free_value(list_val2);
            lil_free_list(list);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=list_ops digest={:016x}", digest)
}

unsafe extern "C" fn dummy_cmd(
    _lil: lil_t,
    _argc: usize,
    _argv: *mut lil_value_t,
) -> lil_value_t {
    lil_alloc_string(b"dummy_result\0".as_ptr() as *const ::core::ffi::c_char)
}

fn op_env_var_register(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let split_pos = data.iter().position(|&b| b == 0).unwrap_or(data.len().min(32)).min(32);
            let name_data = &data[..split_pos];
            let val_start = if split_pos < data.len() { split_pos + 1 } else { data.len() };
            let val_data = &data[val_start..];

            let mut name_buf: Vec<u8> = if name_data.is_empty() {
                b"x".to_vec()
            } else {
                name_data.iter().filter(|&&b| b != 0).copied().collect()
            };
            if name_buf.is_empty() {
                name_buf = b"x".to_vec();
            }
            name_buf.push(0);

            let mut val_buf: Vec<u8> = val_data.to_vec();
            val_buf.push(0);

            lil_push_env(lil);

            let val_v = lil_alloc_string(val_buf.as_ptr() as *const ::core::ffi::c_char);
            lil_set_var(lil, name_buf.as_ptr() as *const ::core::ffi::c_char, val_v, 1);
            lil_free_value(val_v);

            let got = lil_get_var(lil, name_buf.as_ptr() as *const ::core::ffi::c_char);
            let mut h = fold_value(0u64, got);

            let def_val = lil_alloc_string(b"default\0".as_ptr() as *const ::core::ffi::c_char);
            let got_or = lil_get_var_or(
                lil,
                b"nonexistent_var\0".as_ptr() as *const ::core::ffi::c_char,
                def_val,
            );
            h = fold_value(h, got_or);
            lil_free_value(def_val);

            let gval = lil_alloc_string(b"globalval\0".as_ptr() as *const ::core::ffi::c_char);
            lil_set_var(lil, b"gvar\0".as_ptr() as *const ::core::ffi::c_char, gval, 0);
            lil_free_value(gval);

            lil_register(lil, b"dummycmd\0".as_ptr() as *const ::core::ffi::c_char, Some(dummy_cmd));

            let call_result = lil_call(lil, b"dummycmd\0".as_ptr() as *const ::core::ffi::c_char, 0, ptr::null_mut());
            if !call_result.is_null() {
                h = fold_value(h, call_result);
                lil_free_value(call_result);
            }

            let arg1 = lil_alloc_string(b"arg1val\0".as_ptr() as *const ::core::ffi::c_char);
            let arg2 = lil_alloc_string(b"arg2val\0".as_ptr() as *const ::core::ffi::c_char);
            let mut args = [arg1, arg2];
            let call_result2 = lil_call(lil, b"dummycmd\0".as_ptr() as *const ::core::ffi::c_char, 2, args.as_mut_ptr());
            if !call_result2.is_null() {
                h = fold_value(h, call_result2);
                lil_free_value(call_result2);
            }
            lil_free_value(arg1);
            lil_free_value(arg2);

            let uname = lil_unused_name(lil, b"__tmp\0".as_ptr() as *const ::core::ffi::c_char);
            if !uname.is_null() {
                h = fold_value(h, uname);
                lil_free_value(uname);
            }

            let mut user_data: u64 = 0x12345678;
            lil_set_data(lil, &mut user_data as *mut u64 as *mut ::core::ffi::c_void);
            let got_data = lil_get_data(lil);
            if !got_data.is_null() {
                let dval = *(got_data as *const u64);
                h = fold(h, dval);
            }
            lil_set_data(lil, ptr::null_mut());

            lil_set_error(lil, b"test error\0".as_ptr() as *const ::core::ffi::c_char);
            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_set_error_at(lil, 42, b"positional error\0".as_ptr() as *const ::core::ffi::c_char);
            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_write(lil, b"hello from harness\0".as_ptr() as *const ::core::ffi::c_char);

            let env = lil_alloc_env(ptr::null_mut());
            if !env.is_null() {
                lil_free_env(env);
            }

            lil_pop_env(lil);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=env_var_register err={} digest={:016x}", last_err, digest)
}

fn op_expr_eval(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let mut code_buf: Vec<u8> = data.to_vec();
            code_buf.push(0);

            let expr_val = lil_alloc_string(code_buf.as_ptr() as *const ::core::ffi::c_char);
            let result = lil_eval_expr(lil, expr_val);

            let mut h = fold_value(0u64, result);
            if !result.is_null() {
                let r_dbl = lil_to_double(result);
                h = fold(h, r_dbl.to_bits());
                lil_free_value(result);
            }

            let pv_result = lil_parse_value(lil, expr_val, 0);
            h = fold_value(h, pv_result);
            if !pv_result.is_null() {
                lil_free_value(pv_result);
            }

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free_value(expr_val);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=expr_eval err={} digest={:016x}", last_err, digest)
}

fn op_comprehensive_parse(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    let scripts: &[&[u8]] = &[
        b"set a 10; set b 20; expr $a + $b",
        b"if {expr 1} {set r yes} {set r no}; set r",
        b"if {expr 0} {set r yes} {set r no}; set r",
        b"func myfn {x y} {return [expr $x + $y]}; myfn 3 4",
        b"count {a b c d e}",
        b"list a b c d",
        b"set x hello; subst {$x world}",
        b"quote {hello world}",
        b"char 65",
        b"charat hello 1",
        b"codeat hello 0",
        b"substr hello 1 3",
        b"strpos hello ll",
        b"length hello",
        b"trim {  hello  }",
        b"strcmp abc def",
        b"strcmp abc abc",
        b"streq abc abc",
        b"expr 10 % 3",
        b"expr 0xff & 0x0f",
        b"expr 1 << 4",
        b"expr 5 == 5",
        b"expr 1 && 1",
        b"expr 1 || 0",
        b"set a [expr 2 + 3]; set b [expr $a * 2]; set b",
        b"",
        b"#comment line\nset x 1",
        b"set x {braced string with spaces}; set x",
