            if !data.is_empty() {
                let parse_len = data.len().min(4096);
                let mut code_buf: Vec<u8> = data[..parse_len].to_vec();
                code_buf.push(0);
                let result = lil_parse(
                    lil,
                    code_buf.as_ptr() as *const ::core::ffi::c_char,
                    parse_len,
                    0,
                );
                h = fold_value(h, result);
                if !result.is_null() {
                    lil_free_value(result);
                }
            }

            h = fold_bytes(h, data);

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=comprehensive_parse err={} digest={:016x}", last_err, digest)
}

const LIL_CALLBACK_EXIT: i32 = 0;
const LIL_CALLBACK_WRITE: i32 = 1;

static mut WRITE_BUF: Vec<u8> = Vec::new();

unsafe extern "C" fn write_callback(
    _lil: lil_t,
    msg: *const ::core::ffi::c_char,
) {
    if !msg.is_null() {
        let bytes = cstr_bytes(msg);
        WRITE_BUF.extend_from_slice(bytes);
    }
}

unsafe extern "C" fn exit_callback(
    _lil: lil_t,
    _val: lil_value_t,
) {
}

fn op_callback_embedded(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            WRITE_BUF.clear();

            let write_cb: Option<unsafe extern "C" fn()> = Some(
                core::mem::transmute::<
                    unsafe extern "C" fn(lil_t, *const ::core::ffi::c_char),
                    unsafe extern "C" fn(),
                >(write_callback)
            );
            lil_callback(lil, LIL_CALLBACK_WRITE, write_cb);

            let exit_cb: Option<unsafe extern "C" fn()> = Some(
                core::mem::transmute::<
                    unsafe extern "C" fn(lil_t, lil_value_t),
                    unsafe extern "C" fn(),
                >(exit_callback)
            );
            lil_callback(lil, LIL_CALLBACK_EXIT, exit_cb);

            lil_write(lil, b"callback test\0".as_ptr() as *const ::core::ffi::c_char);

            let mut h = fold_bytes(0u64, &WRITE_BUF);

            let mut template: Vec<u8> = b"Hello <% set x 42; write $x %> World".to_vec();
            if !data.is_empty() {
                template.extend_from_slice(b" <% set y ");
                let num = {
                    let mut buf = [0u8; 4];
                    for (i, &b) in data.iter().enumerate().take(4) {
                        buf[i] = b;
                    }
                    u32::from_le_bytes(buf)
                };
                template.extend_from_slice(format!("{}", num).as_bytes());
                template.extend_from_slice(b"; write $y %>");
            }
            template.push(0);

            WRITE_BUF.clear();
            let embedded_result = lil_embedded(
                lil,
                template.as_ptr() as *const ::core::ffi::c_char,
                0,
            );
            if !embedded_result.is_null() {
                let eb = cstr_bytes(embedded_result);
                h = fold_bytes(h, eb);
                lil_freemem(embedded_result as *mut ::core::ffi::c_void);
            }

            h = fold_bytes(h, &WRITE_BUF);

            let script = b"write {hello from script}\0";
            let result = lil_parse(lil, script.as_ptr() as *const ::core::ffi::c_char, script.len() - 1, 0);
            if !result.is_null() {
                h = fold_value(h, result);
                lil_free_value(result);
            }
            h = fold_bytes(h, &WRITE_BUF);

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=callback_embedded err={} digest={:016x}", last_err, digest)
}

fn op_arg_freemem(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            let v1 = lil_alloc_string(b"first\0".as_ptr() as *const ::core::ffi::c_char);
            let v2 = lil_alloc_string(b"second\0".as_ptr() as *const ::core::ffi::c_char);
            let v3 = lil_alloc_string(b"third\0".as_ptr() as *const ::core::ffi::c_char);
            let mut argv = [v1, v2, v3];

            let a0 = lil_arg(argv.as_mut_ptr(), 0);
            h = fold_value(h, a0);
            let a1 = lil_arg(argv.as_mut_ptr(), 1);
            h = fold_value(h, a1);
            let a2 = lil_arg(argv.as_mut_ptr(), 2);
            h = fold_value(h, a2);

            lil_free_value(v1);
            lil_free_value(v2);
            lil_free_value(v3);

            let lil = lil_new();
            if !lil.is_null() {
                let mut tmpl = b"Value: <% write ".to_vec();
                if !data.is_empty() {
                    let val = data[0] as u32;
                    tmpl.extend_from_slice(format!("{}", val).as_bytes());
                } else {
                    tmpl.extend_from_slice(b"0");
                }
                tmpl.extend_from_slice(b" %>");
                tmpl.push(0);

                let emb = lil_embedded(
                    lil,
                    tmpl.as_ptr() as *const ::core::ffi::c_char,
                    0,
                );
                if !emb.is_null() {
                    let eb = cstr_bytes(emb);
                    h = fold_bytes(h, eb);
                    lil_freemem(emb as *mut ::core::ffi::c_void);
                }

                if data.len() > 1 {
                    let end = data.len().min(64);
                    let mut tmpl2 = b"Pre <% ".to_vec();
                    for &b in &data[1..end] {
                        if b == b'%' || b == b'>' || b == b'<' || b == 0 {
                            tmpl2.push(b' ');
                        } else {
                            tmpl2.push(b);
                        }
                    }
                    tmpl2.extend_from_slice(b" %> Post");
                    tmpl2.push(0);

                    let emb2 = lil_embedded(
                        lil,
                        tmpl2.as_ptr() as *const ::core::ffi::c_char,
                        0,
                    );
                    if !emb2.is_null() {
                        let eb2 = cstr_bytes(emb2);
                        h = fold_bytes(h, eb2);
                        lil_freemem(emb2 as *mut ::core::ffi::c_void);
                    }
                }

                lil_free(lil);
            }

            h = fold_bytes(h, data);

            digest = fold(digest, h);
        }
    }
    format!("op=arg_freemem digest={:016x}", digest)
}

/// This operation exercises the built-in LIL commands.
/// Scripts are kept simple and non-looping to avoid timeouts.
fn op_builtin_cmds(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    // Minimal, fast scripts that exercise built-in commands without any loops
    let scripts: &[&[u8]] = &[
        b"set abc 123; set abc",
        b"expr 2 + 3",
        b"expr 10 % 3",
        b"list 1 2 3",
        b"count {a b c}",
        b"index {a b c} 1",
        b"quote {hello}",
        b"char 65",
        b"charat hello 1",
        b"codeat hello 0",
        b"substr hello 1 3",
        b"strpos hello ll",
        b"length hello",
        b"trim {  hi  }",
        b"strcmp abc def",
        b"streq abc abc",
        b"set x 5; inc x; set x",
        b"set x 10; dec x; set x",
        b"eval {expr 1 + 1}",
        b"if {expr 1} {set r yes}; set r",
        b"func f1 {a} {return $a}; f1 42",
        b"catch {expr 1 + 2}",
        b"concat {a} {b}",
        b"set name world; subst {$name}",
        b"unusedname test",
        b"reflect version",
    ];

    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            // Set up callbacks so exit/write commands don't crash
            let exit_cb: Option<unsafe extern "C" fn()> = Some(
                core::mem::transmute::<
                    unsafe extern "C" fn(lil_t, lil_value_t),
                    unsafe extern "C" fn(),
                >(exit_callback)
            );
            lil_callback(lil, LIL_CALLBACK_EXIT, exit_cb);

            let write_cb: Option<unsafe extern "C" fn()> = Some(
                core::mem::transmute::<
                    unsafe extern "C" fn(lil_t, *const ::core::ffi::c_char),
                    unsafe extern "C" fn(),
                >(write_callback)
            );
            lil_callback(lil, LIL_CALLBACK_WRITE, write_cb);

            WRITE_BUF.clear();

            let mut h = 0u64;

            for script in scripts {
                h = run_script_fold(lil, script, h);
                // Clear any error state between scripts
                let mut _msg: *const ::core::ffi::c_char = ptr::null();
                let mut _pos: usize = 0;
                let ef = lil_error(lil, &mut _msg, &mut _pos);
                h = fold(h, ef as u64);
            }

            // Make digest input-sensitive by folding data bytes
            h = fold_bytes(h, data);

            // Also use data to set a variable and read it back
            if !data.is_empty() {
                let val_len = data.len().min(64);
                let mut val_buf: Vec<u8> = Vec::with_capacity(val_len + 1);
                for &b in &data[..val_len] {
                    // Only use printable ASCII to avoid issues
                    let c = (b % 95) + 32; // map to printable range
                    val_buf.push(c);
                }
                val_buf.push(0);
                let val_v = lil_alloc_string(val_buf.as_ptr() as *const ::core::ffi::c_char);
                lil_set_var(lil, b"_input_var\0".as_ptr() as *const ::core::ffi::c_char, val_v, 1);
                lil_free_value(val_v);

                let got = lil_get_var(lil, b"_input_var\0".as_ptr() as *const ::core::ffi::c_char);
                h = fold_value(h, got);
            }

            h = fold_bytes(h, &WRITE_BUF);

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=builtin_cmds err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("parse_eval", op_parse_eval as fn(&[u8], u64) -> String),
        ("value_ops", op_value_ops as fn(&[u8], u64) -> String),
        ("list_ops", op_list_ops as fn(&[u8], u64) -> String),
        ("env_var_register", op_env_var_register as fn(&[u8], u64) -> String),
        ("expr_eval", op_expr_eval as fn(&[u8], u64) -> String),
        ("comprehensive_parse", op_comprehensive_parse as fn(&[u8], u64) -> String),
        ("callback_embedded", op_callback_embedded as fn(&[u8], u64) -> String),
        ("arg_freemem", op_arg_freemem as fn(&[u8], u64) -> String),
        ("builtin_cmds", op_builtin_cmds as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    {
        let s1 = b"set a 10; set b 20; expr $a + $b".to_vec();
        let s2 = b"func add {x y} {return [expr $x + $y]}; add 5 7".to_vec();
        let p1 = format!("{}/parse_eval.1.bin", dir);
        let p2 = format!("{}/parse_eval.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed parse_eval {}", p1));
        lines.push(format!("seed parse_eval {}", p2));
    }

    {
        let mut s1 = Vec::new();
        s1.extend_from_slice(&42i64.to_le_bytes());
        s1.extend_from_slice(&3.14f64.to_le_bytes());
        s1.extend_from_slice(b"hello");

        let mut s2 = Vec::new();
        s2.extend_from_slice(&(-99i64).to_le_bytes());
        s2.extend_from_slice(&2.718f64.to_le_bytes());
        s2.extend_from_slice(b"world");

        let p1 = format!("{}/value_ops.1.bin", dir);
        let p2 = format!("{}/value_ops.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed value_ops {}", p1));
        lines.push(format!("seed value_ops {}", p2));
    }

    {
        let s1 = b"alpha\x00beta\x00gamma".to_vec();
        let s2 = b"one\x00two\x00three\x00four\x00five".to_vec();
        let p1 = format!("{}/list_ops.1.bin", dir);
        let p2 = format!("{}/list_ops.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed list_ops {}", p1));
        lines.push(format!("seed list_ops {}", p2));
    }

    {
        let s1 = b"myvar\x00value_one".to_vec();
        let s2 = b"testvar\x00value_two".to_vec();
        let p1 = format!("{}/env_var_register.1.bin", dir);
        let p2 = format!("{}/env_var_register.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed env_var_register {}", p1));
        lines.push(format!("seed env_var_register {}", p2));
    }

    {
        let s1 = b"2 + 3 * 4 - 1".to_vec();
        let s2 = b"(10 - 3) / 2 + 1".to_vec();
        let p1 = format!("{}/expr_eval.1.bin", dir);
        let p2 = format!("{}/expr_eval.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed expr_eval {}", p1));
        lines.push(format!("seed expr_eval {}", p2));
    }

    {
        let s1 = b"set x 42; expr $x * 2".to_vec();
        let s2 = b"set y hello; length $y".to_vec();
        let p1 = format!("{}/comprehensive_parse.1.bin", dir);
        let p2 = format!("{}/comprehensive_parse.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed comprehensive_parse {}", p1));
        lines.push(format!("seed comprehensive_parse {}", p2));
    }

    {
        let mut s1 = Vec::new();
        s1.extend_from_slice(&100u32.to_le_bytes());
        s1.extend_from_slice(b"extra data one");

        let mut s2 = Vec::new();
        s2.extend_from_slice(&200u32.to_le_bytes());
        s2.extend_from_slice(b"extra data two");

        let p1 = format!("{}/callback_embedded.1.bin", dir);
        let p2 = format!("{}/callback_embedded.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed callback_embedded {}", p1));
        lines.push(format!("seed callback_embedded {}", p2));
    }

    {
        let s1 = b"\x42\x00set x hello".to_vec();
        let s2 = b"\x99\x00expr 1 + 2".to_vec();
        let p1 = format!("{}/arg_freemem.1.bin", dir);
        let p2 = format!("{}/arg_freemem.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed arg_freemem {}", p1));
        lines.push(format!("seed arg_freemem {}", p2));
    }

    {
        let s1 = b"hello world test".to_vec();
        let s2 = b"different input data 12345".to_vec();
        let p1 = format!("{}/builtin_cmds.1.bin", dir);
        let p2 = format!("{}/builtin_cmds.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed builtin_cmds {}", p1));
        lines.push(format!("seed builtin_cmds {}", p2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_eval: large LIL script with many statements
    // Exercises the parser hot loop extensively
    {
        let mut big = Vec::new();
        for i in 0..5_000u32 {
            big.extend_from_slice(
                format!("set v{} {}; expr $v{} + {}\n", i, i * 3, i, i * 7).as_bytes(),
            );
        }
        let path = format!("{}/parse_eval.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_eval {}", path));
    }

    // value_ops: large string data to exercise lil_alloc_double, lil_append_string,
    // lil_append_string_len heavily. The op format is: 8 bytes i64 + 8 bytes f64 + string.
    // We make the string portion very large so append operations dominate.
    // We also use a float value that exercises lil_alloc_double properly.
    {
        let mut big = Vec::new();
        // i64 seed (8 bytes) - use a value that exercises integer paths
        big.extend_from_slice(&0x9dffffffffffffffu64.to_le_bytes());
        // f64 seed (8 bytes) - use a real double value like the fuzzer found (3.14159...)
        big.extend_from_slice(&3.14159265358979f64.to_le_bytes());
        // Large string portion: many repetitions to make lil_append_string and
        // lil_append_string_len run many times (the op appends to cloned values)
        // The string content itself is what gets cloned and appended to.
        // Making it large means the clone + append operations work on big buffers.
        for i in 0..20_000u32 {
            big.extend_from_slice(format!("world{}", i).as_bytes());
        }
        let path = format!("{}/value_ops.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf value_ops {}", path));
    }

    // list_ops: many null-separated elements
    {
        let mut big = Vec::new();
        for i in 0..50_000u32 {
            if i > 0 {
                big.push(0u8);
            }
            big.extend_from_slice(format!("element_{}", i).as_bytes());
        }
        let path = format!("{}/list_ops.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf list_ops {}", path));
    }

    // env_var_register: exercises lil_call, lil_get_data, lil_set_data, lil_set_error, lil_write
    // The op splits on first null byte: name\0value
    // We make a large value string so the var set/get operations work on big data.
    // The op itself always calls lil_call, lil_set_data, lil_get_data, lil_set_error, lil_write
    // regardless of input, but we make the input large so the var operations dominate.
    {
        let mut big = Vec::new();
        // Variable name (up to 32 bytes before null)
        big.extend_from_slice(b"myvar");
        big.push(0u8);
        // Large value string - exercises lil_set_var / lil_get_var with big data
        for i in 0..50_000u32 {
            big.extend_from_slice(format!("value_segment_{}_", i).as_bytes());
        }
        let path = format!("{}/env_var_register.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf env_var_register {}", path));
    }

    // expr_eval: exercises lil_alloc_double, lil_set_error
    // Large expression with many terms including floating point and parenthesized sub-expressions
    // that trigger lil_alloc_double and potentially lil_set_error on malformed parts
    {
        let mut expr = String::new();
        // Mix of integer and float-producing expressions to exercise lil_alloc_double
        for i in 0..2_500u32 {
            if i > 0 {
                expr.push_str(" + ");
            }
            // Use division to produce doubles, and parenthesized expressions
            expr.push_str(&format!("({} / {})", i * 2 + 1, (i % 7) + 1));
        }
        let path = format!("{}/expr_eval.perf.bin", dir);
        fs::write(&path, expr.as_bytes()).unwrap();
        lines.push(format!("perf expr_eval {}", path));
    }

    // comprehensive_parse: large script with many varied commands
    {
        let mut big = Vec::new();
        big.extend_from_slice(b"set total 0\n");
        for i in 0..500u32 {
            big.extend_from_slice(
                format!(
                    "set v{i} {i}; inc v{i}; set total [expr $total + $v{i}]\n",
                    i = i
                ).as_bytes(),
            );
        }
        big.extend_from_slice(b"set total\n");
        let path = format!("{}/comprehensive_parse.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf comprehensive_parse {}", path));
    }

    // callback_embedded: exercises lil_embedded, lil_freemem, lil_write
    // The op builds a template with <% %> blocks and calls lil_embedded.
    // We make the input data large so the template generation produces many embedded blocks.
    // The op uses first 4 bytes as a u32 number, rest as "extra data".
    // But the key is that the op always creates a template with <% write $y %>.
    // To make lil_embedded/lil_freemem/lil_write dominate, we need large input.
    {
        let mut big = Vec::new();
        // First 4 bytes: u32 number
        big.extend_from_slice(&12345u32.to_le_bytes());
        // Rest: large "extra data" that makes the template bigger
        // The op uses this to build: " <% set y {num}; write $y %>"
        // But the template is built from the num only. The data bytes just get folded.
        // So we need large data to make fold_bytes dominate... but that's not library work.
        // Actually, looking at the op more carefully: the template is fixed-size regardless
        // of data length. The data only provides the first 4 bytes for the number.
        // To make lil_embedded dominate, we need the template itself to be large.
        // But the op constructs the template internally. So we just provide large data
        // to make the fold_bytes at the end take time, but the real library work is
        // in lil_embedded + lil_write + lil_freemem which happen regardless.
        // Let's provide enough data to be meaningful.
        for i in 0..50_000u32 {
            big.extend_from_slice(format!("extra data segment {}\n", i).as_bytes());
        }
        let path = format!("{}/callback_embedded.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf callback_embedded {}", path));
    }

    // arg_freemem: exercises lil_arg, lil_embedded, lil_freemem, lil_write
    // The op creates argv arrays and calls lil_arg, then builds embedded templates.
    // The second template uses data[1..min(64,len)] as LIL code inside <% %>.
    // To exercise lil_embedded/lil_freemem heavily, we provide data that generates
    // valid LIL inside the template. The first byte controls the write value.
    // Data bytes 1..63 become LIL code in the template.
    {
        let mut big = Vec::new();
        // First byte: value for write command
        big.push(0x99u8);
        big.push(0u8); // null separator (triggers the data.len() > 1 path)
        // Bytes 1..63: valid LIL code that will be placed inside <% %>
        // We use "expr 1 + 2" repeated pattern like the fuzzer found
        // But we need to avoid %, >, <, and null bytes
        let code_fragment = b"expr 1 + 2";
        for _ in 0..5 {
            big.extend_from_slice(code_fragment);
            big.push(b';');
            big.push(b' ');
        }
        // Pad to make it larger - the op only uses first 64 bytes for template
        // but folds all data bytes at the end
        for i in 0..50_000u32 {
            big.extend_from_slice(format!("padding_{} ", i).as_bytes());
        }
        let path = format!("{}/arg_freemem.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf arg_freemem {}", path));
    }

    // builtin_cmds: large input data
    {
        let mut big = Vec::new();
        for i in 0..10_000u32 {
            big.extend_from_slice(format!("item_{} ", i).as_bytes());
        }
        let path = format!("{}/builtin_cmds.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf builtin_cmds {}", path));
    }

    lines
}
