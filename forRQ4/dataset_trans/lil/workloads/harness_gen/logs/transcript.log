        ),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let parse1 = b"h one two 3\nh \"hello world\" {brace text} 17\nappend a b c\nset vv 10\n".to_vec();
    let parse2 = b"h alpha\\ beta \"quoted value\" {x y z}\nh 10 20 30\nappend left {middle part} right\nexpr 1 + 2 * 3\n".to_vec();

    let subst1 = b"$a/$b {$a $b} $c $d".to_vec();
    let subst2 = b"prefix-$c-[$a]-{$b $a} $a$c :: $d".to_vec();

    let native1 = b"red\ngreen\nblue\n42\n".to_vec();
    let native2 = b"first\0second field\0third\0123\0tail".to_vec();

    let expr1 = b"12\n34\ntext-field\n$ignored".to_vec();
    let expr2 = b"\x01\x02shifts\ncompare\nlogic\nappend".to_vec();

    let matrix1 = b"alpha\nbeta gamma\ndelta\n".to_vec();
    let matrix2 = b"one two\nthree-four\nfive/six\nseven:eight\n".to_vec();

    let items: [(&str, usize, Vec<u8>); 10] = [
        ("parse_registered_script", 1, parse1),
        ("parse_registered_script", 2, parse2),
        ("subst_list_pipeline", 1, subst1),
        ("subst_list_pipeline", 2, subst2),
        ("native_call_state", 1, native1),
        ("native_call_state", 2, native2),
        ("expr_embedded_builtins", 1, expr1),
        ("expr_embedded_builtins", 2, expr2),
        ("builtin_script_matrix", 1, matrix1),
        ("builtin_script_matrix", 2, matrix2),
    ];

    for (op, idx, bytes) in items {
        let path = format!("{}/{}.{}.bin", dir, op, idx);
        let _ = fs::write(&path, &bytes);
        out.push(format!("seed {} {}", op, path));
    }

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let mut big_parse = Vec::new();
    let mut i = 0u32;
    while i < 180_000 {
        let line = format!(
            "h item{} {} \"quoted {} {}\" {{block {} {} {}}}\nappend x{} y{} z{}\n",
            i,
            i.wrapping_mul(7),
            i % 97,
            i % 13,
            i,
            i.wrapping_mul(3),
            i ^ 0x55aa,
            i % 29,
            i % 31,
            i % 37
        );
        big_parse.extend_from_slice(line.as_bytes());
        i += 1;
    }
    let parse_path = format!("{}/parse_registered_script.perf.bin", dir);
    let _ = fs::write(&parse_path, &big_parse);
    out.push(format!("perf parse_registered_script {}", parse_path));

    let mut big_expr = Vec::new();
    let mut j = 0u32;
    while j < 220_000 {
        let line = format!(
            "{}\n{}\nfield-{}\nlogic-{}-{}-{}\n",
            j % 97,
            (j.wrapping_mul(13)) % 89,
            j,
            j % 7,
            j % 11,
            j % 13
        );
        big_expr.extend_from_slice(line.as_bytes());
        j += 1;
    }
    let expr_path = format!("{}/expr_embedded_builtins.perf.bin", dir);
    let _ = fs::write(&expr_path, &big_expr);
    out.push(format!("perf expr_embedded_builtins {}", expr_path));

    let mut big_matrix = Vec::new();
    let mut k = 0u32;
    while k < 120_000 {
        let line = format!(
            "field{}\nvalue {} {}\npath/{}/{}\n",
            k,
            k % 101,
            k.wrapping_mul(17) % 257,
            k % 37,
            k % 19
        );
        big_matrix.extend_from_slice(line.as_bytes());
        k += 1;
    }
    let matrix_path = format!("{}/builtin_script_matrix.perf.bin", dir);
    let _ = fs::write(&matrix_path, &big_matrix);
    out.push(format!("perf builtin_script_matrix {}", matrix_path));

    out
}
