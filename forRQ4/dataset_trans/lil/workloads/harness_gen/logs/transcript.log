        s1.extend_from_slice(b"hello");

        let mut s2 = Vec::new();
        s2.extend_from_slice(&(-99i64).to_le_bytes());
        s2.extend_from_slice(&2.718f64.to_le_bytes());
        s2.extend_from_slice(b"world");

        let p1 = format!("{}/value_ops.1.bin", dir);
        let p2 = format!("{}/value_ops.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed value_ops {}", p1));
        lines.push(format!("seed value_ops {}", p2));
    }

    // list_ops seeds
    {
        let s1 = b"alpha\x00beta\x00gamma".to_vec();
        let s2 = b"one\x00two\x00three\x00four".to_vec();
        let p1 = format!("{}/list_ops.1.bin", dir);
        let p2 = format!("{}/list_ops.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed list_ops {}", p1));
        lines.push(format!("seed list_ops {}", p2));
    }

    // env_var_register seeds
    {
        let s1 = b"myvar\x00value_one".to_vec();
        let s2 = b"testvar\x00value_two".to_vec();
        let p1 = format!("{}/env_var_register.1.bin", dir);
        let p2 = format!("{}/env_var_register.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed env_var_register {}", p1));
        lines.push(format!("seed env_var_register {}", p2));
    }

    // expr_eval seeds
    {
        let s1 = b"2 + 3 * 4".to_vec();
        let s2 = b"(10 - 3) / 2 + 1".to_vec();
        let p1 = format!("{}/expr_eval.1.bin", dir);
        let p2 = format!("{}/expr_eval.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed expr_eval {}", p1));
        lines.push(format!("seed expr_eval {}", p2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_eval: large LIL script
    {
        let mut big = Vec::new();
        for i in 0..10_000u32 {
            big.extend_from_slice(
                format!("set v{} {}; expr $v{} + {}\n", i, i * 3, i, i * 7).as_bytes(),
            );
        }
        let path = format!("{}/parse_eval.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_eval {}", path));
    }

    // list_ops: many list elements
    {
        let mut big = Vec::new();
        for i in 0..50_000u32 {
            if i > 0 {
                big.push(0u8);
            }
            big.extend_from_slice(format!("element_{}", i).as_bytes());
        }
        let path = format!("{}/list_ops.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf list_ops {}", path));
    }

    // expr_eval: long expression
    {
        let mut expr = String::new();
        for i in 0..5_000u32 {
            if i > 0 {
                expr.push_str(" + ");
            }
            expr.push_str(&format!("{}", i));
        }
        let path = format!("{}/expr_eval.perf.bin", dir);
        fs::write(&path, expr.as_bytes()).unwrap();
        lines.push(format!("perf expr_eval {}", path));
    }

    lines
}
