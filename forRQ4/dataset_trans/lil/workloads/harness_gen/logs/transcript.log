pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let parse1 = b"h one two 3\nh \"hello world\" {brace text} 17\n".to_vec();
    let parse2 = b"h alpha\\ beta \"quoted value\" {x y z}\nh 10 20 30\nh { spaced\tblock } tail\n".to_vec();

    let subst1 = b"$a/$b {$a $b} $c".to_vec();
    let subst2 = b"prefix-$c-[$a]-{$b $a} $a$c".to_vec();

    let native1 = b"red\ngreen\nblue\n42\n".to_vec();
    let native2 = b"first\0second field\0third\0123\0tail".to_vec();

    let items: [(&str, usize, Vec<u8>); 6] = [
        ("parse_registered_script", 1, parse1),
        ("parse_registered_script", 2, parse2),
        ("subst_list_pipeline", 1, subst1),
        ("subst_list_pipeline", 2, subst2),
        ("native_call_state", 1, native1),
        ("native_call_state", 2, native2),
    ];

    for (op, idx, bytes) in items {
        let path = format!("{}/{}.{}.bin", dir, op, idx);
        let _ = fs::write(&path, &bytes);
        out.push(format!("seed {} {}", op, path));
    }

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut big = Vec::new();
    let mut i = 0u32;
    while i < 180_000 {
        let line = format!(
            "h item{} {} \"quoted {} {}\" {{block {} {} {}}}\n",
            i,
            i.wrapping_mul(7),
            i % 97,
            i % 13,
            i,
            i.wrapping_mul(3),
            i ^ 0x55aa
        );
        big.extend_from_slice(line.as_bytes());
        i += 1;
    }
    let path = format!("{}/parse_registered_script.perf.bin", dir);
    let _ = fs::write(&path, &big);
    vec![format!("perf parse_registered_script {}", path)]
}
