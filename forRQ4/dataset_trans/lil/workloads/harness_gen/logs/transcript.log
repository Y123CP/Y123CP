            digest = fold(digest, (!env.is_null()) as u64);
            let local_bytes = if fields.len() > 1 { fields[1] } else { b"local" };
            let _ = lil_set_var(lil, b"localv\0".as_ptr() as *const c_char, alloc_bytes(local_bytes), 1);

