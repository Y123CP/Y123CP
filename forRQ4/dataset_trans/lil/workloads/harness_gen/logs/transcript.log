    {
        let s1 = b"set x 42; expr $x * 2".to_vec();
        let s2 = b"set y hello; length $y".to_vec();
        let p1 = format!("{}/comprehensive_parse.1.bin", dir);
        let p2 = format!("{}/comprehensive_parse.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed comprehensive_parse {}", p1));
        lines.push(format!("seed comprehensive_parse {}", p2));
    }

    {
        let mut s1 = Vec::new();
        s1.extend_from_slice(&100u32.to_le_bytes());
        s1.extend_from_slice(b"extra data one");

        let mut s2 = Vec::new();
        s2.extend_from_slice(&200u32.to_le_bytes());
        s2.extend_from_slice(b"extra data two");

        let p1 = format!("{}/callback_embedded.1.bin", dir);
        let p2 = format!("{}/callback_embedded.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed callback_embedded {}", p1));
        lines.push(format!("seed callback_embedded {}", p2));
    }

    {
        let s1 = b"\x42\x00set x hello".to_vec();
        let s2 = b"\x99\x00expr 1 + 2".to_vec();
        let p1 = format!("{}/arg_freemem.1.bin", dir);
        let p2 = format!("{}/arg_freemem.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed arg_freemem {}", p1));
        lines.push(format!("seed arg_freemem {}", p2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    {
        let mut big = Vec::new();
        for i in 0..5_000u32 {
            big.extend_from_slice(
                format!("set v{} {}; expr $v{} + {}\n", i, i * 3, i, i * 7).as_bytes(),
            );
        }
        let path = format!("{}/parse_eval.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_eval {}", path));
    }

    {
        let mut big = Vec::new();
        big.extend_from_slice(b"set total 0\n");
        for i in 0..500u32 {
            big.extend_from_slice(
                format!(
                    "set v{i} {i}; inc v{i}; set total [expr $total + $v{i}]\n",
                    i = i
                ).as_bytes(),
            );
        }
        big.extend_from_slice(b"result $total\n");
        let path = format!("{}/comprehensive_parse.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf comprehensive_parse {}", path));
    }

    {
        let mut big = Vec::new();
        for i in 0..50_000u32 {
            if i > 0 {
                big.push(0u8);
            }
            big.extend_from_slice(format!("element_{}", i).as_bytes());
        }
        let path = format!("{}/list_ops.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf list_ops {}", path));
    }

    {
        let mut expr = String::new();
        for i in 0..5_000u32 {
            if i > 0 {
                expr.push_str(" + ");
            }
            expr.push_str(&format!("{}", i));
        }
        let path = format!("{}/expr_eval.perf.bin", dir);
        fs::write(&path, expr.as_bytes()).unwrap();
        lines.push(format!("perf expr_eval {}", path));
    }

    lines
}

