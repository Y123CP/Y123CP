```rust
use std::fs;
use std::ptr;

use lil_raw::src::lil::{
    lil_alloc_double, lil_alloc_integer, lil_alloc_list, lil_alloc_string,
    lil_alloc_string_len, lil_append_char, lil_append_string, lil_append_string_len,
    lil_append_val, lil_arg, lil_call, lil_callback, lil_clone_value, lil_embedded,
    lil_error, lil_eval_expr, lil_free, lil_free_list, lil_free_value, lil_freemem,
    lil_get_data, lil_get_var, lil_get_var_or, lil_list_append, lil_list_get,
    lil_list_size, lil_list_to_value, lil_new, lil_parse, lil_parse_value,
    lil_pop_env, lil_push_env, lil_register, lil_set_data, lil_set_error,
    lil_set_error_at, lil_set_var, lil_subst_to_list, lil_subst_to_value,
    lil_to_boolean, lil_to_double, lil_to_integer, lil_to_string, lil_unused_name,
    lil_write, lil_free_env, lil_alloc_env,
    lil_func_proc_t, lil_t, lil_value_t, lil_callback_proc_t,
};

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(1) ^ x
}

fn fold_bytes(acc: u64, bytes: &[u8]) -> u64 {
    let mut h = acc;
    for &b in bytes {
        h = fold(h, b as u64);
    }
    h
}

unsafe fn cstr_bytes(p: *const ::core::ffi::c_char) -> &'static [u8] {
    if p.is_null() {
        return &[];
    }
    let mut len = 0usize;
    while *p.add(len) != 0 {
        len += 1;
    }
    std::slice::from_raw_parts(p as *const u8, len)
}

unsafe fn fold_value(h: u64, v: lil_value_t) -> u64 {
    if v.is_null() {
        return fold(h, 0xDEADu64);
    }
    let s = lil_to_string(v);
    let bytes = cstr_bytes(s);
    let h = fold_bytes(h, bytes);
    let i = lil_to_integer(v);
    let h = fold(h, i as u64);
    let b = lil_to_boolean(v);
    fold(h, b as u64)
}

unsafe fn fold_error(h: u64, lil: lil_t) -> (u64, i32) {
    let mut err_msg: *const ::core::ffi::c_char = ptr::null();
    let mut err_pos: usize = 0;
    let err_flag = lil_error(lil, &mut err_msg, &mut err_pos);
    let h = fold(h, err_flag as u64);
    let h = fold(h, err_pos as u64);
    if !err_msg.is_null() {
        let h = fold_bytes(h, cstr_bytes(err_msg));
        (h, err_flag)
    } else {
        (h, err_flag)
    }
}

fn op_parse_eval(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }
            let mut code_buf: Vec<u8> = data.to_vec();
            code_buf.push(0);
            let result = lil_parse(
                lil,
                code_buf.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
                0,
            );
            let mut h = fold_value(0u64, result);
            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;
            if !result.is_null() {
                lil_free_value(result);
            }
            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=parse_eval err={} digest={:016x}", last_err, digest)
}

fn op_value_ops(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let int_seed: i64 = if data.len() >= 8 {
                let mut buf = [0u8; 8];
                buf.copy_from_slice(&data[..8]);
                i64::from_le_bytes(buf)
            } else {
                let mut buf = [0u8; 8];
                for (i, &b) in data.iter().enumerate().take(8) {
                    buf[i] = b;
                }
                i64::from_le_bytes(buf)
            };

            let dbl_seed: f64 = if data.len() >= 16 {
                let mut buf = [0u8; 8];
                buf.copy_from_slice(&data[8..16]);
                f64::from_le_bytes(buf)
            } else if data.len() > 8 {
                let mut buf = [0u8; 8];
                for i in 8..data.len().min(16) {
                    buf[i - 8] = data[i];
                }
                f64::from_le_bytes(buf)
            } else {
                0.0
            };

            let str_start = data.len().min(16);
            let str_data = &data[str_start..];

            let mut str_buf: Vec<u8> = str_data.to_vec();
            str_buf.push(0);
            let v_str = lil_alloc_string(str_buf.as_ptr() as *const ::core::ffi::c_char);
            let v_str_len = lil_alloc_string_len(
                str_buf.as_ptr() as *const ::core::ffi::c_char,
                str_data.len(),
            );
            let v_int = lil_alloc_integer(int_seed);
            let v_dbl = lil_alloc_double(dbl_seed);
            let v_clone = lil_clone_value(v_str);

            let ch = if !str_data.is_empty() {
                str_data[0] as ::core::ffi::c_char
            } else {
                b'X' as ::core::ffi::c_char
            };
            lil_append_char(v_clone, ch);
            lil_append_string(v_clone, b"_appended\0".as_ptr() as *const ::core::ffi::c_char);
            lil_append_string_len(v_clone, b"XYZ".as_ptr() as *const ::core::ffi::c_char, 3);
            lil_append_val(v_clone, v_int);

            let mut h = fold_value(0u64, v_clone);
            let dbl_val = lil_to_double(v_clone);
            h = fold(h, dbl_val.to_bits());
            h = fold(h, lil_to_integer(v_int) as u64);
            h = fold(h, lil_to_double(v_dbl).to_bits());

            // Also test null value handling
            let v_null = lil_clone_value(ptr::null_mut());
            h = fold_value(h, v_null);
            if !v_null.is_null() {
                lil_free_value(v_null);
            }

            lil_free_value(v_str);
            lil_free_value(v_str_len);
            lil_free_value(v_int);
            lil_free_value(v_dbl);
            lil_free_value(v_clone);

            digest = fold(digest, h);
        }
    }
    format!("op=value_ops digest={:016x}", digest)
}

fn op_list_ops(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let segments: Vec<&[u8]> = data.split(|&b| b == 0).collect();
            let list = lil_alloc_list();

            for seg in &segments {
                let v = if seg.is_empty() {
                    lil_alloc_string_len(ptr::null(), 0)
                } else {
                    lil_alloc_string_len(
                        seg.as_ptr() as *const ::core::ffi::c_char,
                        seg.len(),
                    )
                };
                lil_list_append(list, v);
            }

            let size = lil_list_size(list);
            let mut h = fold(0u64, size as u64);

            for i in 0..size {
                let elem = lil_list_get(list, i);
                h = fold_value(h, elem);
            }

            // list_to_value with escape
            let list_val = lil_list_to_value(list, 1);
            h = fold_value(h, list_val);

            // list_to_value without escape
            let list_val2 = lil_list_to_value(list, 0);
            h = fold_value(h, list_val2);

            let sub_list = lil_subst_to_list(lil, list_val);
            if !sub_list.is_null() {
                let sub_size = lil_list_size(sub_list);
                h = fold(h, sub_size as u64);
                lil_free_list(sub_list);
            }

            let sub_val = lil_subst_to_value(lil, list_val);
            if !sub_val.is_null() {
                h = fold_value(h, sub_val);
                lil_free_value(sub_val);
            }

            lil_free_value(list_val);
            lil_free_value(list_val2);
            lil_free_list(list);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=list_ops digest={:016x}", digest)
}

unsafe extern "C" fn dummy_cmd(
    _lil: lil_t,
    _argc: usize,
    _argv: *mut lil_value_t,
) -> lil_value_t {
    lil_alloc_string(b"dummy_result\0".as_ptr() as *const ::core::ffi::c_char)
}

fn op_env_var_register(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let split_pos = data.iter().position(|&b| b == 0).unwrap_or(data.len().min(32)).min(32);
            let name_data = &data[..split_pos];
            let val_start = if split_pos < data.len() { split_pos + 1 } else { data.len() };
            let val_data = &data[val_start..];

            let mut name_buf: Vec<u8> = if name_data.is_empty() {
                b"x".to_vec()
            } else {
                name_data.iter().filter(|&&b| b != 0).copied().collect()
            };
            if name_buf.is_empty() {
                name_buf = b"x".to_vec();
            }
            name_buf.push(0);

            let mut val_buf: Vec<u8> = val_data.to_vec();
            val_buf.push(0);

            lil_push_env(lil);

            let val_v = lil_alloc_string(val_buf.as_ptr() as *const ::core::ffi::c_char);
            lil_set_var(lil, name_buf.as_ptr() as *const ::core::ffi::c_char, val_v, 1);
            lil_free_value(val_v);

            let got = lil_get_var(lil, name_buf.as_ptr() as *const ::core::ffi::c_char);
            let mut h = fold_value(0u64, got);

            let def_val = lil_alloc_string(b"default\0".as_ptr() as *const ::core::ffi::c_char);
            let got_or = lil_get_var_or(
                lil,
                b"nonexistent_var\0".as_ptr() as *const ::core::ffi::c_char,
                def_val,
            );
            h = fold_value(h, got_or);
            lil_free_value(def_val);

            // Set var with local=0 (global)
            let gval = lil_alloc_string(b"globalval\0".as_ptr() as *const ::core::ffi::c_char);
            lil_set_var(lil, b"gvar\0".as_ptr() as *const ::core::ffi::c_char, gval, 0);
            lil_free_value(gval);

            lil_register(lil, b"dummycmd\0".as_ptr() as *const ::core::ffi::c_char, Some(dummy_cmd));

            let call_result = lil_call(lil, b"dummycmd\0".as_ptr() as *const ::core::ffi::c_char, 0, ptr::null_mut());
            if !call_result.is_null() {
                h = fold_value(h, call_result);
                lil_free_value(call_result);
            }

            // Call with args
            let arg1 = lil_alloc_string(b"arg1val\0".as_ptr() as *const ::core::ffi::c_char);
            let arg2 = lil_alloc_string(b"arg2val\0".as_ptr() as *const ::core::ffi::c_char);
            let mut args = [arg1, arg2];
            let call_result2 = lil_call(lil, b"dummycmd\0".as_ptr() as *const ::core::ffi::c_char, 2, args.as_mut_ptr());
            if !call_result2.is_null() {
                h = fold_value(h, call_result2);
                lil_free_value(call_result2);
            }
            lil_free_value(arg1);
            lil_free_value(arg2);

            let uname = lil_unused_name(lil, b"__tmp\0".as_ptr() as *const ::core::ffi::c_char);
            if !uname.is_null() {
                h = fold_value(h, uname);
                lil_free_value(uname);
            }

            let mut user_data: u64 = 0x12345678;
            lil_set_data(lil, &mut user_data as *mut u64 as *mut ::core::ffi::c_void);
            let got_data = lil_get_data(lil);
            if !got_data.is_null() {
                let dval = *(got_data as *const u64);
                h = fold(h, dval);
            }
            lil_set_data(lil, ptr::null_mut());

            lil_set_error(lil, b"test error\0".as_ptr() as *const ::core::ffi::c_char);
            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_set_error_at(lil, 42, b"positional error\0".as_ptr() as *const ::core::ffi::c_char);
            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_write(lil, b"hello from harness\0".as_ptr() as *const ::core::ffi::c_char);

            // Test alloc_env / free_env
            let env = lil_alloc_env(ptr::null_mut());
            if !env.is_null() {
                lil_free_env(env);
            }

            lil_pop_env(lil);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=env_var_register err={} digest={:016x}", last_err, digest)
}

fn op_expr_eval(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let mut code_buf: Vec<u8> = data.to_vec();
            code_buf.push(0);

            let expr_val = lil_alloc_string(code_buf.as_ptr() as *const ::core::ffi::c_char);
            let result = lil_eval_expr(lil, expr_val);

            let mut h = fold_value(0u64, result);
            if !result.is_null() {
                let r_dbl = lil_to_double(result);
                h = fold(h, r_dbl.to_bits());
                lil_free_value(result);
            }

            // Also test parse_value
            let pv_result = lil_parse_value(lil, expr_val, 0);
            h = fold_value(h, pv_result);
            if !pv_result.is_null() {
                lil_free_value(pv_result);
            }

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free_value(expr_val);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=expr_eval err={} digest={:016x}", last_err, digest)
}

/// This operation exercises all the built-in LIL commands to reach the fnc_* functions
fn op_comprehensive_parse(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    // We have a large set of built-in scripts to exercise, plus we append user data
    let scripts: &[&[u8]] = &[
        // fnc_set, fnc_expr, fnc_if, fnc_return, fnc_result
        b"set a 10; set b 20; expr $a + $b",
        b"if {expr 1} {set r yes} {set r no}; result $r",
        b"if {expr 0} {set r yes} {set r no}; result $r",
        // fnc_func, fnc_return
        b"func myfn {x y} {return [expr $x + $y]}; myfn 3 4",
        // fnc_for
        b"set s 0; for {set i 0} {expr $i < 5} {inc i} {set s [expr $s + $i]}; result $s",
        // fnc_while
        b"set i 0; set s 0; while {expr $i < 5} {set s [expr $s + $i]; inc i}; result $s",
        // fnc_foreach
        b"set s {}; foreach x {a b c d} {append s $x}; result $s",
        // fnc_foreach with two vars
        b"set s {}; foreach {k v} {a 1 b 2 c 3} {append s $k$v}; result $s",
        // fnc_count
        b"count {a b c d e}",
        // fnc_list
        b"list a b c d",
        // fnc_append
        b"set L {}; append L hello; append L world; result $L",
        // fnc_slice
        b"slice {a b c d e} 1 3",
        // fnc_filter
        b"filter x {1 2 3 4 5 6} {expr $x > 3}",
        // fnc_concat
        b"concat {a b} {c d}",
        // fnc_subst
        b"set x hello; subst {$x world}",
        // fnc_quote
        b"quote {hello world}",
        // fnc_char
        b"char 65",
        // fnc_charat
        b"charat hello 1",
        // fnc_codeat
        b"codeat hello 0",
        // fnc_substr
        b"substr hello 1 3",
        // fnc_strpos
        b"strpos hello ll",
        // fnc_length
        b"length hello",
        // fnc_trim, fnc_ltrim, fnc_rtrim
        b"trim {  hello  }",
        b"ltrim {  hello  }",
        b"rtrim {  hello  }",
        // fnc_strcmp
        b"strcmp abc def",
        b"strcmp abc abc",
        // fnc_streq
        b"streq abc abc",
        b"streq abc def",
        // fnc_repstr
        b"repstr {hello world} world universe",
        // fnc_split
        b"split {a,b,c,d} ,",
        // fnc_lmap
        b"lmap {a b c} {x y z} {result $x-$y-$z}",
        // fnc_eval
        b"eval {expr 2 + 3}",
        // fnc_topeval
        b"topeval {set topvar 42}",
        // fnc_upeval
        b"func outer {} {set x 10; func inner {} {upeval {set x 20}}; inner; result $x}; outer",
        // fnc_downeval
        b"func outer2 {} {downeval {result done}}; outer2",
        // fnc_enveval
        b"func myenv {} {enveval {set zz 99}; result $zz}; myenv",
        // fnc_jaileval
        b"jaileval {expr 1 + 2}",
        // fnc_inc, fnc_dec
        b"set n 10; inc n; inc n 5; dec n; dec n 2; result $n",
        // fnc_read (returns empty in non-interactive)
        b"set r [read]; result $r",
        // fnc_store / fnc_source - skip file ops, just test store to /dev/null-like
        // fnc_print, fnc_write
        b"write hello; print world",
        // fnc_error
        b"catch {error test_error_msg}",
        // fnc_exit
        b"catch {exit 0}",
        // fnc_catcher
        b"catcher {set e}; error oops; result $e",
        // fnc_watch
        b"set wv 0; watch wv {set wv [expr $wv + 1]}; set wv 5; result $wv",
        // fnc_hasprop, fnc_setprop, fnc_getprop, fnc_delprop (if available)
        // fnc_reflect
        b"reflect funcs",
        b"reflect vars",
        b"reflect globals",
        b"reflect has-func set",
        // fnc_rename
        b"func oldfn {} {return old}; rename oldfn newfn; newfn",
        // fnc_unusedname
        b"unusedname __test",
        // fnc_random
        b"random",
        // fnc_catch
        b"catch {error boom}",
        // Complex nested
        b"func fib {n} {if {expr $n <= 1} {return $n}; return [expr [fib [expr $n - 1]] + [fib [expr $n - 2]]]}; fib 8",
        // String operations
        b"set s [char 72]; append s [char 101]; append s [char 108]; result $s",
        // Expression operators
        b"expr 10 % 3",
        b"expr 0xff & 0x0f",
        b"expr 1 << 4",
        b"expr 256 >> 4",
        b"expr 0xff ^ 0x0f",
        b"expr 0xff | 0x100",
        b"expr !0",
        b"expr ~0xff",
        b"expr 5 == 5",
        b"expr 5 != 3",
        b"expr 5 > 3",
        b"expr 5 < 3",
        b"expr 5 >= 5",
        b"expr 5 <= 5",
        b"expr 1 && 1",
        b"expr 1 || 0",
        // Dollar substitution, bracket substitution
        b"set a [expr 2 + 3]; set b [expr $a * 2]; result $b",
        // Quoted strings with escapes
        b"set s \"hello\\nworld\"; result $s",
        // Empty and edge cases
        b"",
        b"#comment line\nset x 1",
        b"set x {braced string with spaces}; result $x",
    ];

    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let mut h = 0u64;

            // Run all built-in scripts
            for script in scripts {
                let mut code_buf: Vec<u8> = script.to_vec();
                code_buf.push(0);
                let result = lil_parse(
                    lil,
                    code_buf.as_ptr() as *const ::core::ffi::c_char,
                    script.len(),
                    0,
                );
                h = fold_value(h, result);
                if !result.is_null() {
                    lil_free_value(result);
                }
                // Clear error state for next script
                let mut _msg: *const ::core::ffi::c_char = ptr::null();
                let mut _pos: usize = 0;
                let _ = lil_error(lil, &mut _msg, &mut _pos);
            }

            // Now also parse user-provided data
            if !data.is_empty() {
                let mut code_buf: Vec<u8> = data.to_vec();
                code_buf.push(0);
                let result = lil_parse(
                    lil,
                    code_buf.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    0,
                );
                h = fold_value(h, result);
                if !result.is_null() {
                    lil_free_value(result);
                }
            }

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=comprehensive_parse err={} digest={:016x}", last_err, digest)
}

/// Callback types from the LIL source
const LIL_CALLBACK_EXIT: i32 = 0;
const LIL_CALLBACK_WRITE: i32 = 1;
const LIL_CALLBACK_READ: i32 = 2;
const LIL_CALLBACK_STORE: i32 = 3;
const LIL_CALLBACK_SOURCE: i32 = 4;
const LIL_CALLBACK_ERROR: i32 = 5;
const LIL_CALLBACK_SETVAR: i32 = 6;
const LIL_CALLBACK_GETVAR: i32 = 7;

// We need a write callback
static mut WRITE_BUF: Vec<u8> = Vec::new();

unsafe extern "C" fn write_callback(
    _lil: lil_t,
    msg: *const ::core::ffi::c_char,
) {
    if !msg.is_null() {
        let bytes = cstr_bytes(msg);
        WRITE_BUF.extend_from_slice(bytes);
    }
}

unsafe extern "C" fn exit_callback(
    _lil: lil_t,
    val: lil_value_t,
) {
    // Just consume the exit - don't actually exit
    let _ = val;
}

fn op_callback_embedded(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            // Set write callback
            WRITE_BUF.clear();
            lil_callback(
                lil,
                LIL_CALLBACK_WRITE,
                write_callback as lil_callback_proc_t,
            );
            lil_callback(
                lil,
                LIL_CALLBACK_EXIT,
                exit_callback as lil_callback_proc_t,
            );

            // Test lil_write with callback
            lil_write(lil, b"callback test\0".as_ptr() as *const ::core::ffi::c_char);

            let mut h = fold_bytes(0u64, &WRITE_BUF);

            // Test lil_embedded
            // Create a template with embedded LIL code
            let mut template: Vec<u8> = b"Hello <% set x 42; write $x %> World".to_vec();
            // Also append some user data to make it input-sensitive
            if data.len() > 0 {
                template.extend_from_slice(b" <% set y ");
                // Use first few bytes as a number
                let num = if data.len() >= 4 {
                    let mut buf = [0u8; 4];
                    buf.copy_from_slice(&data[..4]);
                    u32::from_le_bytes(buf)
                } else {
                    let mut buf = [0u8; 4];
                    for (i, &b) in data.iter().enumerate().take(4) {
                        buf[i] = b;
                    }
                    u32::from_le_bytes(buf)
                };
                template.extend_from_slice(format!("{}", num).as_bytes());
                template.extend_from_slice(b"; write $y %>");
            }
            template.push(0);

            WRITE_BUF.clear();
            let embedded_result = lil_embedded(
                lil,
                template.as_ptr() as *const ::core::ffi::c_char,
                0,
            );
            if !embedded_result.is_null() {
                let eb = cstr_bytes(embedded_result);
                h = fold_bytes(h, eb);
                // Free with lil_freemem
                lil_freemem(embedded_result as *mut ::core::ffi::c_void);
            }

            // Also fold the write buffer contents
            h = fold_bytes(h, &WRITE_BUF);

            // Parse something that triggers write callback
            let script = b"write {hello from script}\0";
            let result = lil_parse(lil, script.as_ptr() as *const ::core::ffi::c_char, script.len() - 1, 0);
            if !result.is_null() {
                h = fold_value(h, result);
                lil_free_value(result);
            }
            h = fold_bytes(h, &WRITE_BUF);

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=callback_embedded err={} digest={:016x}", last_err, digest)
}

fn op_arg_freemem(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Test lil_arg
            let v1 = lil_alloc_string(b"first\0".as_ptr() as *const ::core::ffi::c_char);
            let v2 = lil_alloc_string(b"second\0".as_ptr() as *const ::core::ffi::c_char);
            let v3 = lil_alloc_string(b"third\0".as_ptr() as *const ::core::ffi::c_char);
            let mut argv = [v1, v2, v3];

            let a0 = lil_arg(argv.as_mut_ptr(), 0);
            h = fold_value(h, a0);
            let a1 = lil_arg(argv.as_mut_ptr(), 1);
            h = fold_value(h, a1);
            let a2 = lil_arg(argv.as_mut_ptr(), 2);
            h = fold_value(h, a2);

            lil_free_value(v1);
            lil_free_value(v2);
            lil_free_value(v3);

            // Test lil_freemem with a string allocated by lil_embedded or similar
            // We can test it with lil_embedded
            let lil = lil_new();
            if !lil.is_null() {
                // Create input-sensitive embedded template
                let mut tmpl = b"Value: <% write ".to_vec();
                if data.len() > 0 {
                    // Use data bytes as a simple number
                    let val = data[0] as u32;
                    tmpl.extend_from_slice(format!("{}", val).as_bytes());
                } else {
                    tmpl.extend_from_slice(b"0");
                }
                tmpl.extend_from_slice(b" %>");
                tmpl.push(0);

                let emb = lil_embedded(
                    lil,
                    tmpl.as_ptr() as *const ::core::ffi::c_char,
                    0,
                );
                if !emb.is_null() {
                    let eb = cstr_bytes(emb);
                    h = fold_bytes(h, eb);
                    lil_freemem(emb as *mut ::core::ffi::c_void);
                }

                // Also test with user data as LIL code in embedded
                if data.len() > 1 {
                    let mut tmpl2 = b"Pre <% ".to_vec();
                    // Sanitize: replace % and > to avoid breaking template
                    for &b in &data[1..data.len().min(64)] {
                        if b == b'%' || b == b'>' || b == b'<' || b == 0 {
                            tmpl2.push(b' ');
                        } else {
                            tmpl2.push(b);
                        }
                    }
                    tmpl2.extend_from_slice(b" %> Post");
                    tmpl2.push(0);

                    let emb2 = lil_embedded(
                        lil,
                        tmpl2.as_ptr() as *const ::core::ffi::c_char,
                        0,
                    );
                    if !emb2.is_null() {
                        let eb2 = cstr_bytes(emb2);
                        h = fold_bytes(h, eb2);
                        lil_freemem(emb2 as *mut ::core::ffi::c_void);
                    }
                }

                lil_free(lil);
            }

            // Also fold raw data for input sensitivity
            h = fold_bytes(h, data);

            digest = fold(digest, h);
        }
    }
    format!("op=arg_freemem digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("parse_eval", op_parse_eval as fn(&[u8], u64) -> String),
        ("value_ops", op_value_ops as fn(&[u8], u64) -> String),
        ("list_ops", op_list_ops as fn(&[u8], u64) -> String),
        ("env_var_register", op_env_var_register as fn(&[u8], u64) -> String),
        ("expr_eval", op_expr_eval as fn(&[u8], u64) -> String),
        ("comprehensive_parse", op_comprehensive_parse as fn(&[u8], u64) -> String),
        ("callback_embedded", op_callback_embedded as fn(&[u8], u64) -> String),
        ("arg_freemem", op_arg_freemem as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_eval seeds - exercise many built-in commands
