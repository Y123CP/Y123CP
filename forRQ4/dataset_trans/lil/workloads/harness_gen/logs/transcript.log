```rust
use std::fs;
use std::ptr;

use lil_raw::src::lil::{
    lil_alloc_double, lil_alloc_integer, lil_alloc_list, lil_alloc_string,
    lil_alloc_string_len, lil_append_char, lil_append_string, lil_append_string_len,
    lil_append_val, lil_call, lil_clone_value, lil_error, lil_eval_expr, lil_free,
    lil_free_list, lil_free_value, lil_get_data, lil_get_var, lil_get_var_or,
    lil_list_append, lil_list_get, lil_list_size, lil_list_to_value, lil_new,
    lil_parse, lil_pop_env, lil_push_env, lil_register, lil_set_data, lil_set_error,
    lil_set_error_at, lil_set_var, lil_subst_to_list, lil_subst_to_value,
    lil_to_boolean, lil_to_double, lil_to_integer, lil_to_string, lil_unused_name,
    lil_write, lil_free_env,
    lil_func_proc_t, lil_t, lil_value_t,
};

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(1) ^ x
}

fn fold_bytes(acc: u64, bytes: &[u8]) -> u64 {
    let mut h = acc;
    for &b in bytes {
        h = fold(h, b as u64);
    }
    h
}

unsafe fn cstr_bytes(p: *const ::core::ffi::c_char) -> &'static [u8] {
    if p.is_null() {
        return &[];
    }
    let mut len = 0usize;
    while *p.add(len) != 0 {
        len += 1;
    }
    std::slice::from_raw_parts(p as *const u8, len)
}

fn op_parse_eval(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }
            // Make a null-terminated copy of data
            let mut code_buf: Vec<u8> = data.to_vec();
            code_buf.push(0);
            let result = lil_parse(
                lil,
                code_buf.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
                0,
            );
            let result_str = lil_to_string(result);
            let rbytes = cstr_bytes(result_str);
            let mut h = fold_bytes(0u64, rbytes);

            let mut err_msg: *const ::core::ffi::c_char = ptr::null();
            let mut err_pos: usize = 0;
            let err_flag = lil_error(lil, &mut err_msg, &mut err_pos);
            last_err = err_flag;
            h = fold(h, err_flag as u64);
            h = fold(h, err_pos as u64);

            if !result.is_null() {
                lil_free_value(result);
            }
            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=parse_eval err={} digest={:016x}", last_err, digest)
}

fn op_value_ops(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            // Extract integer seed (first 8 bytes)
            let int_seed: i64 = if data.len() >= 8 {
                let mut buf = [0u8; 8];
                buf.copy_from_slice(&data[..8]);
                i64::from_le_bytes(buf)
            } else {
                let mut buf = [0u8; 8];
                for (i, &b) in data.iter().enumerate().take(8) {
                    buf[i] = b;
                }
                i64::from_le_bytes(buf)
            };

            // Extract double seed (next 8 bytes)
            let dbl_seed: f64 = if data.len() >= 16 {
                let mut buf = [0u8; 8];
                buf.copy_from_slice(&data[8..16]);
                f64::from_le_bytes(buf)
            } else if data.len() > 8 {
                let mut buf = [0u8; 8];
                let start = 8;
                let end = data.len().min(16);
                for i in start..end {
                    buf[i - start] = data[i];
                }
                f64::from_le_bytes(buf)
            } else {
                0.0
            };

            // Remainder as string content
            let str_start = data.len().min(16);
            let str_data = &data[str_start..];

            // Allocate string value
            let mut str_buf: Vec<u8> = str_data.to_vec();
            str_buf.push(0);
            let v_str = lil_alloc_string(str_buf.as_ptr() as *const ::core::ffi::c_char);

            // Allocate string_len value
            let v_str_len = lil_alloc_string_len(
                str_buf.as_ptr() as *const ::core::ffi::c_char,
                str_data.len(),
            );

            // Allocate integer value
            let v_int = lil_alloc_integer(int_seed);

            // Allocate double value
            let v_dbl = lil_alloc_double(dbl_seed);

            // Clone v_str
            let v_clone = lil_clone_value(v_str);

            // Append a char to clone
            let ch = if !str_data.is_empty() {
                str_data[0] as ::core::ffi::c_char
            } else {
                b'X' as ::core::ffi::c_char
            };
            lil_append_char(v_clone, ch);

            // Append string
            let append_str = b"_appended\0";
            lil_append_string(v_clone, append_str.as_ptr() as *const ::core::ffi::c_char);

            // Append string_len
            let append_str2 = b"XYZ";
            lil_append_string_len(
                v_clone,
                append_str2.as_ptr() as *const ::core::ffi::c_char,
                3,
            );

            // Append val (append v_int's string representation to v_clone)
            lil_append_val(v_clone, v_int);

            // Now digest the final composed value (v_clone)
            let final_str = lil_to_string(v_clone);
            let fbytes = cstr_bytes(final_str);
            let mut h = fold_bytes(0u64, fbytes);

            let final_int = lil_to_integer(v_clone);
            h = fold(h, final_int as u64);

            let final_dbl = lil_to_double(v_clone);
            h = fold(h, final_dbl.to_bits());

            let final_bool = lil_to_boolean(v_clone);
            h = fold(h, final_bool as u64);

            // Also fold in the integer and double values
            let int_val = lil_to_integer(v_int);
            h = fold(h, int_val as u64);
            let dbl_val = lil_to_double(v_dbl);
            h = fold(h, dbl_val.to_bits());

            // Free all values
            lil_free_value(v_str);
            lil_free_value(v_str_len);
            lil_free_value(v_int);
            lil_free_value(v_dbl);
            lil_free_value(v_clone);

            digest = fold(digest, h);
        }
    }
    format!("op=value_ops digest={:016x}", digest)
}

fn op_list_ops(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            // Split data on 0x00
            let segments: Vec<&[u8]> = data.split(|&b| b == 0).collect();

            let list = lil_alloc_list();

            for seg in &segments {
                let v = if seg.is_empty() {
                    lil_alloc_string_len(ptr::null(), 0)
                } else {
                    lil_alloc_string_len(
                        seg.as_ptr() as *const ::core::ffi::c_char,
                        seg.len(),
                    )
                };
                lil_list_append(list, v);
            }

            let size = lil_list_size(list);
            let mut h = fold(0u64, size as u64);

            // Digest each element
            for i in 0..size {
                let elem = lil_list_get(list, i);
                let s = lil_to_string(elem);
                let sbytes = cstr_bytes(s);
                h = fold_bytes(h, sbytes);
            }

            // list_to_value
            let list_val = lil_list_to_value(list, 1);
            let lv_str = lil_to_string(list_val);
            let lv_bytes = cstr_bytes(lv_str);
            h = fold_bytes(h, lv_bytes);

            // subst_to_list round-trip
            let sub_list = lil_subst_to_list(lil, list_val);
            if !sub_list.is_null() {
                let sub_size = lil_list_size(sub_list);
                h = fold(h, sub_size as u64);
                lil_free_list(sub_list);
            }

            // subst_to_value
            let sub_val = lil_subst_to_value(lil, list_val);
            if !sub_val.is_null() {
                let sv_str = lil_to_string(sub_val);
                let sv_bytes = cstr_bytes(sv_str);
                h = fold_bytes(h, sv_bytes);
                lil_free_value(sub_val);
            }

            lil_free_value(list_val);
            lil_free_list(list);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=list_ops digest={:016x}", digest)
}

// Dummy native command callback for lil_register
unsafe extern "C" fn dummy_cmd(
    _lil: lil_t,
    _argc: usize,
    _argv: *mut lil_value_t,
) -> lil_value_t {
    lil_alloc_string(b"dummy_result\0".as_ptr() as *const ::core::ffi::c_char)
}

fn op_env_var_register(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            // Split on first 0x00 or at 32 bytes
            let split_pos = data.iter().position(|&b| b == 0).unwrap_or(data.len().min(32)).min(32);
            let name_data = &data[..split_pos];
            let val_start = if split_pos < data.len() { split_pos + 1 } else { data.len() };
            let val_data = &data[val_start..];

            // Make null-terminated name; ensure non-empty
            let mut name_buf: Vec<u8> = if name_data.is_empty() {
                b"x".to_vec()
            } else {
                // Filter out null bytes from name
                name_data.iter().filter(|&&b| b != 0).copied().collect()
            };
            if name_buf.is_empty() {
                name_buf = b"x".to_vec();
            }
            name_buf.push(0);

            // Make null-terminated value
            let mut val_buf: Vec<u8> = val_data.to_vec();
            val_buf.push(0);

            // Push env
            lil_push_env(lil);

            // Set var
            let val_v = lil_alloc_string(val_buf.as_ptr() as *const ::core::ffi::c_char);
            lil_set_var(
                lil,
                name_buf.as_ptr() as *const ::core::ffi::c_char,
                val_v,
                1,
            );
            lil_free_value(val_v);

            // Get var
            let got = lil_get_var(lil, name_buf.as_ptr() as *const ::core::ffi::c_char);
            let got_str = lil_to_string(got);
            let got_bytes = cstr_bytes(got_str);
            let mut h = fold_bytes(0u64, got_bytes);

            // Get var or default
            let def_val = lil_alloc_string(b"default\0".as_ptr() as *const ::core::ffi::c_char);
            let got_or = lil_get_var_or(
                lil,
                b"nonexistent_var\0".as_ptr() as *const ::core::ffi::c_char,
                def_val,
            );
            let got_or_str = lil_to_string(got_or);
            let got_or_bytes = cstr_bytes(got_or_str);
            h = fold_bytes(h, got_or_bytes);
            lil_free_value(def_val);

            // Register dummy command
            lil_register(
                lil,
                b"dummycmd\0".as_ptr() as *const ::core::ffi::c_char,
                Some(dummy_cmd),
            );

            // Call the dummy command
            let call_result = lil_call(
                lil,
                b"dummycmd\0".as_ptr() as *const ::core::ffi::c_char,
                0,
                ptr::null_mut(),
            );
            if !call_result.is_null() {
                let cr_str = lil_to_string(call_result);
                let cr_bytes = cstr_bytes(cr_str);
                h = fold_bytes(h, cr_bytes);
                let cr_int = lil_to_integer(call_result);
                h = fold(h, cr_int as u64);
                lil_free_value(call_result);
            }

            // unused_name
            let uname = lil_unused_name(
                lil,
                b"__tmp\0".as_ptr() as *const ::core::ffi::c_char,
            );
            if !uname.is_null() {
                let un_str = lil_to_string(uname);
                let un_bytes = cstr_bytes(un_str);
                h = fold_bytes(h, un_bytes);
                lil_free_value(uname);
            }

            // set_data / get_data
            let mut user_data: u64 = 0x12345678;
            lil_set_data(lil, &mut user_data as *mut u64 as *mut ::core::ffi::c_void);
            let got_data = lil_get_data(lil);
            if !got_data.is_null() {
                let dval = *(got_data as *const u64);
                h = fold(h, dval);
            }
            // Clear data before lil_free to avoid dangling
            lil_set_data(lil, ptr::null_mut());

            // set_error / error
            lil_set_error(
                lil,
                b"test error\0".as_ptr() as *const ::core::ffi::c_char,
            );
            let mut err_msg: *const ::core::ffi::c_char = ptr::null();
            let mut err_pos: usize = 0;
            let err_flag = lil_error(lil, &mut err_msg, &mut err_pos);
            last_err = err_flag;
            h = fold(h, err_flag as u64);
            h = fold(h, err_pos as u64);

            // set_error_at
            lil_set_error_at(
                lil,
                42,
                b"positional error\0".as_ptr() as *const ::core::ffi::c_char,
            );
            let err_flag2 = lil_error(lil, &mut err_msg, &mut err_pos);
            h = fold(h, err_flag2 as u64);
            h = fold(h, err_pos as u64);

            // lil_write
            lil_write(lil, b"hello from harness\0".as_ptr() as *const ::core::ffi::c_char);

            // Pop env
            lil_pop_env(lil);

            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=env_var_register err={} digest={:016x}", last_err, digest)
}

fn op_expr_eval(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            // Make null-terminated string from data
            let mut code_buf: Vec<u8> = data.to_vec();
            code_buf.push(0);

            let expr_val = lil_alloc_string(code_buf.as_ptr() as *const ::core::ffi::c_char);
            let result = lil_eval_expr(lil, expr_val);

            let mut h = 0u64;
            if !result.is_null() {
                let r_str = lil_to_string(result);
                let r_bytes = cstr_bytes(r_str);
                h = fold_bytes(h, r_bytes);

                let r_int = lil_to_integer(result);
                h = fold(h, r_int as u64);

                let r_dbl = lil_to_double(result);
                h = fold(h, r_dbl.to_bits());

                lil_free_value(result);
            }

            let mut err_msg: *const ::core::ffi::c_char = ptr::null();
            let mut err_pos: usize = 0;
            let err_flag = lil_error(lil, &mut err_msg, &mut err_pos);
            last_err = err_flag;
            h = fold(h, err_flag as u64);
            h = fold(h, err_pos as u64);

            lil_free_value(expr_val);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=expr_eval err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("parse_eval", op_parse_eval as fn(&[u8], u64) -> String),
        ("value_ops", op_value_ops as fn(&[u8], u64) -> String),
        ("list_ops", op_list_ops as fn(&[u8], u64) -> String),
        ("env_var_register", op_env_var_register as fn(&[u8], u64) -> String),
        ("expr_eval", op_expr_eval as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_eval seeds
    {
        let s1 = b"set a 10; set b 20; expr $a + $b".to_vec();
        let s2 = b"set x hello; set y world; concat $x $y".to_vec();
        let p1 = format!("{}/parse_eval.1.bin", dir);
        let p2 = format!("{}/parse_eval.2.bin", dir);
        fs::write(&p1, &s1).unwrap();
        fs::write(&p2, &s2).unwrap();
        lines.push(format!("seed parse_eval {}", p1));
        lines.push(format!("seed parse_eval {}", p2));
    }

    // value_ops seeds
    {
        let mut s1 = Vec::new();
        s1.extend_from_slice(&42i64.to_le_bytes());
