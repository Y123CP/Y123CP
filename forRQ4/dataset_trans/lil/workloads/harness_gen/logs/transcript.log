pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    {
        let mut big = Vec::new();
        for i in 0..5_000u32 {
            big.extend_from_slice(
                format!("set v{} {}; expr $v{} + {}\n", i, i * 3, i, i * 7).as_bytes(),
            );
        }
        let path = format!("{}/parse_eval.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_eval {}", path));
    }

    {
        let mut big = Vec::new();
        big.extend_from_slice(b"set total 0\n");
        for i in 0..500u32 {
            big.extend_from_slice(
                format!(
                    "set v{i} {i}; inc v{i}; set total [expr $total + $v{i}]\n",
                    i = i
                ).as_bytes(),
            );
        }
        big.extend_from_slice(b"result $total\n");
        let path = format!("{}/comprehensive_parse.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf comprehensive_parse {}", path));
    }

    {
        let mut big = Vec::new();
        for i in 0..50_000u32 {
            if i > 0 {
                big.push(0u8);
            }
            big.extend_from_slice(format!("element_{}", i).as_bytes());
        }
        let path = format!("{}/list_ops.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf list_ops {}", path));
    }

    {
        let mut expr = String::new();
        for i in 0..5_000u32 {
            if i > 0 {
                expr.push_str(" + ");
            }
            expr.push_str(&format!("{}", i));
        }
        let path = format!("{}/expr_eval.perf.bin", dir);
        fs::write(&path, expr.as_bytes()).unwrap();
        lines.push(format!("perf expr_eval {}", path));
    }

    // Perf for builtin_cmds: large input data (just bytes to fold, no parsing)
    {
        let mut big = Vec::new();
        for i in 0..10_000u32 {
            big.extend_from_slice(format!("item_{} ", i).as_bytes());
        }
        let path = format!("{}/builtin_cmds.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf builtin_cmds {}", path));
    }

    lines
}
