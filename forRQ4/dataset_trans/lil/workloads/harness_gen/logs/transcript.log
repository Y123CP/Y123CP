use lil_raw::src::lil::*;
use std::ffi::{c_char, c_void, CStr};
use std::fs;
use std::ptr;

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9E37_79B1_85EB_CA87)
}

fn fold_bytes(mut acc: u64, bytes: &[u8]) -> u64 {
    acc = fold(acc, bytes.len() as u64);
    for &b in bytes {
        acc = fold(acc, b as u64);
    }
    acc
}

unsafe fn cstr_bytes<'a>(p: *const c_char) -> &'a [u8] {
    if p.is_null() {
        &[]
    } else {
        CStr::from_ptr(p).to_bytes()
    }
}

unsafe fn value_bytes<'a>(v: lil_value_t) -> &'a [u8] {
    cstr_bytes(lil_to_string(v))
}

unsafe fn alloc_bytes(bytes: &[u8]) -> lil_value_t {
    lil_alloc_string_len(bytes.as_ptr() as *const c_char, bytes.len() as size_t)
}

unsafe fn alloc_static_z(bytes: &'static [u8]) -> lil_value_t {
    lil_alloc_string(bytes.as_ptr() as *const c_char)
}

fn split_fields(data: &[u8]) -> Vec<&[u8]> {
    let mut fields = Vec::new();
    let mut start = 0usize;
    let mut i = 0usize;
    while i < data.len() {
        if data[i] == b'\n' || data[i] == 0 {
            if start != i {
                fields.push(&data[start..i]);
            }
            start = i + 1;
        }
        i += 1;
    }
    if start < data.len() {
        fields.push(&data[start..]);
    }
    if fields.is_empty() {
        fields.push(b"");
    }
    fields
}

fn byte_num(data: &[u8], idx: usize, add: u64) -> u64 {
    let b = if data.is_empty() {
        0
    } else {
        data[idx % data.len()] as u64
    };
    1 + ((b + add) % 97)
}

fn sanitize_ascii(data: &[u8], limit: usize) -> Vec<u8> {
    let mut out = Vec::new();
    let mut i = 0usize;
    while i < data.len() && out.len() < limit {
        let b = data[i];
        let ch = match b {
            b'a'..=b'z'
            | b'A'..=b'Z'
            | b'0'..=b'9'
            | b' '
            | b'_'
            | b'-'
            | b'.'
            | b'/'
            | b':'
            | b'+'
            | b'*'
            | b'='
            | b'<'
            | b'>'
            | b'!'
            | b'?'
            | b'['
            | b']'
            | b'('
            | b')'
            | b'{'
            | b'}'
            | b','
            | b';' => b,
            _ => b'_',
        };
        out.push(ch);
        i += 1;
    }
    if out.is_empty() {
        out.extend_from_slice(b"empty");
    }
    out
}

fn make_exprs(data: &[u8]) -> [String; 4] {
    let a = byte_num(data, 0, 1);
    let b = byte_num(data, 1, 3);
    let c = byte_num(data, 2, 5);
    let d = byte_num(data, 3, 7);
    let e = byte_num(data, 4, 9);
    let f = byte_num(data, 5, 11);
    let g = byte_num(data, 6, 13);
    let h = byte_num(data, 7, 15);
    [
        format!("(({} + {}) * {} - {}) / {}", a, b, c, d, e),
        format!("(({} << 2) | {}) & {} != {}", b, c, d + 1, e),
        format!("!0 && (({} > {}) || ({} == {})) + ~{}", f, a, g, g, b),
        format!("(({} <= {}) && ({} >= {})) || (({} ^ {}) != 0)", h, a, c, d, e, f),
    ]
}

fn seed_subst_vars(lil: lil_t, extra: &[u8]) {
    unsafe {
        let va = alloc_bytes(b"alpha");
        let vb = alloc_bytes(b"beta gamma");
        let vc = alloc_bytes(b"123");
        let vd = alloc_bytes(extra);
        let ve = alloc_bytes(b"one two three four");
        let vf = alloc_bytes(b"7 8 9");
        let _ = lil_set_var(lil, b"a\0".as_ptr() as *const c_char, va, 0);
        let _ = lil_set_var(lil, b"b\0".as_ptr() as *const c_char, vb, 0);
        let _ = lil_set_var(lil, b"c\0".as_ptr() as *const c_char, vc, 0);
        let _ = lil_set_var(lil, b"d\0".as_ptr() as *const c_char, vd, 0);
        let _ = lil_set_var(lil, b"listv\0".as_ptr() as *const c_char, ve, 0);
        let _ = lil_set_var(lil, b"nums\0".as_ptr() as *const c_char, vf, 0);
    }
}

#[derive(Default)]
struct ParseCtx {
    calls: u64,
    total_argc: u64,
    concat_len: u64,
    int_checksum: u64,
    byte_checksum: u64,
}

unsafe extern "C" fn parse_native(lil: lil_t, argc: size_t, argv: *mut lil_value_t) -> lil_value_t {
    let data = lil_get_data(lil) as *mut ParseCtx;
    if !data.is_null() {
        let ctx = &mut *data;
        ctx.calls = ctx.calls.wrapping_add(1);
        ctx.total_argc = ctx.total_argc.wrapping_add(argc as u64);
    }

    let out = lil_alloc_string_len(b"".as_ptr() as *const c_char, 0);
    let _ = lil_append_string(out, b"cmd".as_ptr() as *const c_char);
    let _ = lil_append_char(out, b':' as c_char);

    let mut first = true;
    let mut local_int_sum = 0u64;
    let mut local_len = 0u64;
    let mut local_digest = 0u64;

    let mut i = 0usize;
    while i < argc as usize {
        let arg = *argv.add(i);
        let cloned = lil_clone_value(arg);
        let s = value_bytes(cloned);

        if !first {
            let _ = lil_append_char(out, b'|' as c_char);
        }
        first = false;
        let _ = lil_append_val(out, cloned);

        local_len = local_len.wrapping_add(s.len() as u64);
        local_digest = fold_bytes(local_digest, s);
        local_int_sum = local_int_sum.wrapping_add(lil_to_integer(cloned) as i64 as u64);

        lil_free_value(cloned);
        i += 1;
    }

    let suffix = format!(":{}:{}", local_len, local_int_sum);
    let _ = lil_append_string_len(out, suffix.as_ptr() as *const c_char, suffix.len() as size_t);

    if !data.is_null() {
        let ctx = &mut *data;
        ctx.concat_len = ctx.concat_len.wrapping_add(local_len);
        ctx.int_checksum = ctx.int_checksum.wrapping_add(local_int_sum);
        ctx.byte_checksum = fold(ctx.byte_checksum, local_digest);
    }

    out
}

fn op_parse_registered_script(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    let mut last_pos = 0usize;

    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xFFFF_FFFF);
                continue;
            }

            let mut ctx = Box::<ParseCtx>::default();
            lil_set_data(lil, (&mut *ctx as *mut ParseCtx).cast::<c_void>());

            let reg = lil_register(lil, b"h\0".as_ptr() as *const c_char, Some(parse_native));
            digest = fold(digest, reg as u64);

            seed_subst_vars(lil, data);

            let direct_script = alloc_bytes(data);
            let direct_res = lil_parse_value(lil, direct_script, 0);
            digest = fold_bytes(digest, value_bytes(direct_res));
            if !direct_res.is_null() {
                lil_free_value(direct_res);
            }
            if !direct_script.is_null() {
                lil_free_value(direct_script);
            }

            let res = lil_parse(lil, data.as_ptr() as *const c_char, data.len() as size_t, 0);

            digest = fold_bytes(digest, value_bytes(res));
            digest = fold(digest, ctx.calls);
            digest = fold(digest, ctx.total_argc);
            digest = fold(digest, ctx.concat_len);
            digest = fold(digest, ctx.int_checksum);
            digest = fold(digest, ctx.byte_checksum);

            let mut msg_ptr: *const c_char = ptr::null();
            let mut pos: size_t = 0;
            last_err = lil_error(lil, &mut msg_ptr, &mut pos);
            last_pos = pos as usize;
            digest = fold(digest, last_err as u64);
            digest = fold(digest, last_pos as u64);
            digest = fold_bytes(digest, cstr_bytes(msg_ptr));

            if !res.is_null() {
                lil_free_value(res);
            }
            lil_free(lil);
        }
    }

    format!(
        "op=parse_registered_script err={} pos={} digest={:016x}",
        last_err, last_pos, digest
    )
}

fn op_subst_list_pipeline(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            seed_subst_vars(lil, data);

            let code = alloc_bytes(data);
            let list = lil_subst_to_list(lil, code);
            let val_direct = lil_subst_to_value(lil, code);

            let list_sz = if list.is_null() { 0 } else { lil_list_size(list) as usize };
            digest = fold(digest, list_sz as u64);

            let mut manual = lil_alloc_list();
            digest = fold(digest, (!manual.is_null()) as u64);

            let mut i = 0usize;
            while i < list_sz {
                let elem = lil_list_get(list, i as size_t);
                let cloned = lil_clone_value(elem);
                digest = fold_bytes(digest, value_bytes(elem));
                if !manual.is_null() && !cloned.is_null() {
                    lil_list_append(manual, cloned);
                } else if !cloned.is_null() {
                    lil_free_value(cloned);
                }
                i += 1;
            }

            let extra = alloc_static_z(b"tail\0");
            if !manual.is_null() && !extra.is_null() {
                lil_list_append(manual, extra);
            } else if !extra.is_null() {
                lil_free_value(extra);
            }

            let list_val = if list.is_null() {
                ptr::null_mut()
            } else {
                lil_list_to_value(list, 1)
            };
            let manual_val = if manual.is_null() {
                ptr::null_mut()
            } else {
                lil_list_to_value(manual, 0)
            };

            digest = fold_bytes(digest, value_bytes(list_val));
            digest = fold_bytes(digest, value_bytes(manual_val));
            digest = fold_bytes(digest, value_bytes(val_direct));

            if !manual_val.is_null() {
                lil_free_value(manual_val);
            }
            if !list_val.is_null() {
                lil_free_value(list_val);
            }
            if !val_direct.is_null() {
                lil_free_value(val_direct);
            }
            if !manual.is_null() {
                lil_free_list(manual);
            }
            if !list.is_null() {
                lil_free_list(list);
            }
            if !code.is_null() {
                lil_free_value(code);
            }
            lil_free(lil);
        }
    }

    format!("op=subst_list_pipeline digest={:016x}", digest)
}

#[derive(Default)]
struct CallCtx {
    argc_sum: u64,
    arg_digest: u64,
    int_sum: u64,
    float_bits_xor: u64,
    bool_sum: u64,
}

unsafe extern "C" fn call_native(lil: lil_t, argc: size_t, argv: *mut lil_value_t) -> lil_value_t {
    let data = lil_get_data(lil) as *mut CallCtx;
    if !data.is_null() {
        (*data).argc_sum = (*data).argc_sum.wrapping_add(argc as u64);
    }

    let out = lil_alloc_string_len(b"".as_ptr() as *const c_char, 0);
    let _ = lil_append_string(out, b"ret[".as_ptr() as *const c_char);

    let mut i = 0usize;
    while i < argc as usize {
        let arg = lil_arg(argv, i as size_t);
        let s = value_bytes(arg);
        let iv = lil_to_integer(arg) as i64 as u64;
        let dv = lil_to_double(arg).to_bits();
        let bv = lil_to_boolean(arg) as u64;

        if i != 0 {
            let _ = lil_append_char(out, b',' as c_char);
        }
        let _ = lil_append_string_len(out, s.as_ptr() as *const c_char, s.len() as size_t);

        if !data.is_null() {
            let ctx = &mut *data;
            ctx.arg_digest = fold_bytes(ctx.arg_digest, s);
            ctx.int_sum = ctx.int_sum.wrapping_add(iv);
            ctx.float_bits_xor ^= dv;
            ctx.bool_sum = ctx.bool_sum.wrapping_add(bv);
        }
        i += 1;
    }

    let _ = lil_append_char(out, b']' as c_char);
    out
}

fn op_native_call_state(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    let mut last_pos = 0usize;

    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xBEEF);
                continue;
            }

            let mut ctx = Box::<CallCtx>::default();
            lil_set_data(lil, (&mut *ctx as *mut CallCtx).cast::<c_void>());
            digest = fold(digest, (!lil_get_data(lil).is_null()) as u64);

            let reg = lil_register(lil, b"hc\0".as_ptr() as *const c_char, Some(call_native));
            digest = fold(digest, reg as u64);

            let fields = split_fields(data);

            let _ = lil_set_var(lil, b"x\0".as_ptr() as *const c_char, alloc_bytes(fields[0]), 0);
            let _ = lil_set_var(
                lil,
                b"n\0".as_ptr() as *const c_char,
                lil_alloc_integer(fields.len() as lilint_t),
                0,
            );

            let env = lil_push_env(lil);
            digest = fold(digest, (!env.is_null()) as u64);

            let local_bytes = if fields.len() > 1 { fields[1] } else { b"local" };
            let _ = lil_set_var(
                lil,
                b"localv\0".as_ptr() as *const c_char,
                alloc_bytes(local_bytes),
                1,
            );

            let got_x = lil_get_var(lil, b"x\0".as_ptr() as *const c_char);
            digest = fold_bytes(digest, value_bytes(got_x));

            let def = alloc_bytes(b"fallback");
            let got_missing = lil_get_var_or(lil, b"missing\0".as_ptr() as *const c_char, def);
            digest = fold_bytes(digest, value_bytes(got_missing));
            lil_free_value(def);

            let unused = lil_unused_name(lil, b"tmp\0".as_ptr() as *const c_char);
            digest = fold_bytes(digest, value_bytes(unused));
            if !unused.is_null() {
                lil_free_value(unused);
            }

            let mut argv_vals: Vec<lil_value_t> = Vec::new();
            let take_n = if fields.len() > 6 { 6 } else { fields.len() };
            let mut i = 0usize;
            while i < take_n {
                argv_vals.push(alloc_bytes(fields[i]));
                i += 1;
            }
            argv_vals.push(lil_alloc_integer(data.len() as lilint_t));
            argv_vals.push(lil_alloc_double(
                (fields.len() as f64) + ((data.len() % 17) as f64 / 10.0),
            ));

            let ret = lil_call(
                lil,
                b"hc\0".as_ptr() as *const c_char,
                argv_vals.len() as size_t,
                argv_vals.as_mut_ptr(),
            );

            digest = fold_bytes(digest, value_bytes(ret));
            digest = fold(digest, lil_to_integer(ret) as i64 as u64);
            digest ^= lil_to_double(ret).to_bits();
            digest = fold(digest, lil_to_boolean(ret) as u64);

            digest = fold(digest, ctx.argc_sum);
            digest = fold(digest, ctx.arg_digest);
            digest = fold(digest, ctx.int_sum);
            digest ^= ctx.float_bits_xor;
            digest = fold(digest, ctx.bool_sum);

            if data.len() & 1 == 1 {
                lil_set_error(lil, b"odd-input\0".as_ptr() as *const c_char);
            }

            let mut msg_ptr: *const c_char = ptr::null();
            let mut pos: size_t = 0;
            last_err = lil_error(lil, &mut msg_ptr, &mut pos);
            last_pos = pos as usize;
            digest = fold(digest, last_err as u64);
            digest = fold(digest, last_pos as u64);
            digest = fold_bytes(digest, cstr_bytes(msg_ptr));

            lil_pop_env(lil);

            if !ret.is_null() {
                lil_free_value(ret);
            }
            for v in argv_vals {
                if !v.is_null() {
                    lil_free_value(v);
                }
            }
            lil_free(lil);
        }
    }

    format!(
        "op=native_call_state err={} pos={} digest={:016x}",
        last_err, last_pos, digest
    )
}

fn op_expr_embedded_builtins(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    let mut last_pos = 0usize;

    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0x1234_5678);
                continue;
            }

            seed_subst_vars(lil, data);
            lil_callback(lil, 0, None);
            lil_callback(lil, 1, None);
            lil_callback(lil, 2, None);

            let scratch_env = lil_alloc_env(ptr::null_mut());
            digest = fold(digest, (!scratch_env.is_null()) as u64);
            if !scratch_env.is_null() {
                lil_free_env(scratch_env);
            }

            let exprs = make_exprs(data);
            let mut i = 0usize;
            while i < exprs.len() {
                let v = alloc_bytes(exprs[i].as_bytes());
                let r = lil_eval_expr(lil, v);
                digest = fold_bytes(digest, value_bytes(r));
                digest = fold(digest, lil_to_integer(r) as i64 as u64);
                digest ^= lil_to_double(r).to_bits();
                digest = fold(digest, lil_to_boolean(r) as u64);
                if !r.is_null() {
                    lil_free_value(r);
                }
                if !v.is_null() {
                    lil_free_value(v);
                }
                i += 1;
            }

            let safe = sanitize_ascii(data, 40);
            let mut embedded = Vec::new();
            embedded.extend_from_slice(b"pre:$a|$b|$c|$d|");
            embedded.extend_from_slice(&safe);
            embedded.push(0);
            let emb_ptr = lil_embedded(lil, embedded.as_ptr() as *const c_char, 0);
            digest = fold_bytes(digest, cstr_bytes(emb_ptr));
            if !emb_ptr.is_null() {
                lil_freemem(emb_ptr.cast::<c_void>());
            }

            lil_write(lil, b"\0".as_ptr() as *const c_char);

            let fields = split_fields(data);

            let mut set_args = vec![
                alloc_static_z(b"dyn\0"),
                alloc_bytes(if fields.is_empty() { b"" } else { fields[0] }),
            ];
            let set_ret = lil_call(
                lil,
                b"set\0".as_ptr() as *const c_char,
                set_args.len() as size_t,
                set_args.as_mut_ptr(),
            );
            digest = fold_bytes(digest, value_bytes(set_ret));
            if !set_ret.is_null() {
                lil_free_value(set_ret);
            }
            for v in set_args {
                if !v.is_null() {
                    lil_free_value(v);
                }
            }

            let mut append_args = vec![
                alloc_bytes(b"lhs"),
                alloc_bytes(if fields.len() > 1 { fields[1] } else { b"rhs" }),
                alloc_bytes(if fields.len() > 2 { fields[2] } else { b"tail" }),
            ];
            let append_ret = lil_call(
                lil,
                b"append\0".as_ptr() as *const c_char,
                append_args.len() as size_t,
                append_args.as_mut_ptr(),
            );
            digest = fold_bytes(digest, value_bytes(append_ret));
            if !append_ret.is_null() {
                lil_free_value(append_ret);
            }
            for v in append_args {
                if !v.is_null() {
                    lil_free_value(v);
                }
            }

            let expr_arg = alloc_bytes(exprs[0].as_bytes());
            let mut expr_args = vec![expr_arg];
            let expr_ret = lil_call(
                lil,
                b"expr\0".as_ptr() as *const c_char,
                expr_args.len() as size_t,
                expr_args.as_mut_ptr(),
            );
            digest = fold_bytes(digest, value_bytes(expr_ret));
            if !expr_ret.is_null() {
                lil_free_value(expr_ret);
            }
            for v in expr_args {
                if !v.is_null() {
                    lil_free_value(v);
                }
            }

            let script = b"append foo bar baz\nset zz 41\nappend $zz qux\n";
            let script_val = alloc_bytes(script);
            let parse_ret = lil_parse_value(lil, script_val, 0);
            digest = fold_bytes(digest, value_bytes(parse_ret));
            if !parse_ret.is_null() {
                lil_free_value(parse_ret);
            }
            if !script_val.is_null() {
                lil_free_value(script_val);
            }

            lil_set_error_at(
                lil,
                (data.len() % 31) as size_t,
                b"marked-error\0".as_ptr() as *const c_char,
            );
            let mut msg_ptr: *const c_char = ptr::null();
            let mut pos: size_t = 0;
            last_err = lil_error(lil, &mut msg_ptr, &mut pos);
            last_pos = pos as usize;
            digest = fold(digest, last_err as u64);
            digest = fold(digest, last_pos as u64);
            digest = fold_bytes(digest, cstr_bytes(msg_ptr));

            lil_free(lil);
        }
    }

    format!(
        "op=expr_embedded_builtins err={} pos={} digest={:016x}",
        last_err, last_pos, digest
    )
}

fn op_builtin_script_matrix(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    let mut last_pos = 0usize;

    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xCAFE_BABE);
                continue;
            }

            seed_subst_vars(lil, data);
            let fields = split_fields(data);
            let safe = sanitize_ascii(data, 96);

            digest = fold_bytes(digest, data);
            digest = fold(digest, fields.len() as u64);
            let mut fi = 0usize;
            while fi < fields.len() {
                digest = fold_bytes(digest, fields[fi]);
                fi += 1;
            }
            digest = fold_bytes(digest, &safe);

            let mut script = String::new();
            script.push_str("set x 5\n");
            script.push_str("set y 9\n");
            script.push_str("set msg {hello world}\n");
            script.push_str("set items {aa bb cc dd}\n");
            script.push_str("set nums {1 2 3 4 5}\n");
            script.push_str("set dyn ");
            script.push_str(&String::from_utf8_lossy(&safe));
            script.push('\n');
            script.push_str("append base left right tail\n");
            script.push_str("concat a b c d\n");
            script.push_str("count $items\n");
            script.push_str("index $items 2\n");
            script.push_str("index $items end\n");
            script.push_str("char 65\n");
            script.push_str("charat abcdef 3\n");
            script.push_str("codeat ABC 1\n");
            script.push_str("substr abcdefgh 2 3\n");
            script.push_str("strpos abracadabra bra\n");
            script.push_str("length $msg\n");
            script.push_str("trim {  spaced text  }\n");
            script.push_str("ltrim {  left text}\n");
            script.push_str("rtrim {right text   }\n");
            script.push_str("strcmp alpha beta\n");
            script.push_str("streq same same\n");
            script.push_str("repstr ababab ab XY\n");
            script.push_str("split {a,b,c,d} ,\n");
            script.push_str("filter {1 2 3 4 5 6} {expr $i > 3}\n");
            script.push_str("list $a $b $c $d\n");
            script.push_str("foreach i {10 20 30} {append item $i done}\n");
            script.push_str("for {set i 0} {$i < 4} {inc i} {append loop $i x}\n");
            script.push_str("if {1} {append yes branch} {append no branch}\n");
            script.push_str("while {0} {append never body}\n");
            script.push_str("set n 10\n");
            script.push_str("inc n\n");
            script.push_str("dec n\n");
            script.push_str("expr 1 + 2 * 3\n");
            script.push_str("eval {append eval works now}\n");
            script.push_str("set q {append down level}\n");
            script.push_str("downeval $q\n");
            script.push_str("enveval {append env eval ok}\n");
            script.push_str("set errv [error sample-error]\n");
            script.push_str("try {error forced} handler\n");
            script.push_str("func twice {x} {append $x $x}\n");
            script.push_str("twice zz\n");
            script.push_str("rename twice twice2\n");
            script.push_str("twice2 yy\n");
            script.push_str("unusedname tmp\n");
            script.push_str("source missing_file_name\n");
            script.push_str("catcher {append catcher body}\n");
            script.push_str("set localcopy ");
            script.push_str(&String::from_utf8_lossy(fields[0]));
            script.push('\n');
            script.push_str("append final $localcopy done\n");
            script.push_str("return done\n");

            let script_bytes = script.into_bytes();
            digest = fold(digest, script_bytes.len() as u64);
            digest = fold_bytes(digest, &script_bytes);

            let script_val = alloc_bytes(&script_bytes);
            let res = lil_parse_value(lil, script_val, 0);
            let res_bytes = value_bytes(res);
            digest = fold_bytes(digest, res_bytes);
            digest = fold(digest, res_bytes.len() as u64);
            digest = fold(digest, lil_to_integer(res) as i64 as u64);
            digest ^= lil_to_double(res).to_bits();
            digest = fold(digest, lil_to_boolean(res) as u64);

            let dynv = lil_get_var(lil, b"dyn\0".as_ptr() as *const c_char);
            let localcopy = lil_get_var(lil, b"localcopy\0".as_ptr() as *const c_char);
            let xvar = lil_get_var(lil, b"x\0".as_ptr() as *const c_char);
            let yvar = lil_get_var(lil, b"y\0".as_ptr() as *const c_char);
            let msgv = lil_get_var(lil, b"msg\0".as_ptr() as *const c_char);
            let itemsv = lil_get_var(lil, b"items\0".as_ptr() as *const c_char);
            let numsv = lil_get_var(lil, b"nums\0".as_ptr() as *const c_char);
            let nv = lil_get_var(lil, b"n\0".as_ptr() as *const c_char);
            let errvv = lil_get_var(lil, b"errv\0".as_ptr() as *const c_char);
            digest = fold_bytes(digest, value_bytes(dynv));
            digest = fold_bytes(digest, value_bytes(localcopy));
            digest = fold_bytes(digest, value_bytes(xvar));
            digest = fold_bytes(digest, value_bytes(yvar));
            digest = fold_bytes(digest, value_bytes(msgv));
            digest = fold_bytes(digest, value_bytes(itemsv));
            digest = fold_bytes(digest, value_bytes(numsv));
            digest = fold_bytes(digest, value_bytes(nv));
            digest = fold_bytes(digest, value_bytes(errvv));

            let mut msg_ptr: *const c_char = ptr::null();
            let mut pos: size_t = 0;
            last_err = lil_error(lil, &mut msg_ptr, &mut pos);
            last_pos = pos as usize;
            digest = fold(digest, last_err as u64);
            digest = fold(digest, last_pos as u64);
            digest = fold_bytes(digest, cstr_bytes(msg_ptr));

            if !res.is_null() {
                lil_free_value(res);
            }
            if !script_val.is_null() {
                lil_free_value(script_val);
            }
            lil_free(lil);
        }
    }

    format!(
        "op=builtin_script_matrix err={} pos={} digest={:016x}",
        last_err, last_pos, digest
    )
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        (
