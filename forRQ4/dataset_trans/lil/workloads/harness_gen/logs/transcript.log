fn op_expr_eval(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let mut code_buf: Vec<u8> = data.to_vec();
            code_buf.push(0);

            let expr_val = lil_alloc_string(code_buf.as_ptr() as *const ::core::ffi::c_char);
            let result = lil_eval_expr(lil, expr_val);

            let mut h = fold_value(0u64, result);
            if !result.is_null() {
                let r_dbl = lil_to_double(result);
                h = fold(h, r_dbl.to_bits());
                lil_free_value(result);
            }

            let pv_result = lil_parse_value(lil, expr_val, 0);
            h = fold_value(h, pv_result);
            if !pv_result.is_null() {
                lil_free_value(pv_result);
            }

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free_value(expr_val);
            lil_free(lil);

            digest = fold(digest, h);
        }
    }
    format!("op=expr_eval err={} digest={:016x}", last_err, digest)
}

fn op_comprehensive_parse(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    // Keep a small, fast set of scripts — no recursion, no expensive loops
    let scripts: &[&[u8]] = &[
        b"set a 10; set b 20; expr $a + $b",
        b"if {expr 1} {set r yes} {set r no}; result $r",
        b"if {expr 0} {set r yes} {set r no}; result $r",
        b"func myfn {x y} {return [expr $x + $y]}; myfn 3 4",
        b"count {a b c d e}",
        b"list a b c d",
        b"set x hello; subst {$x world}",
        b"quote {hello world}",
        b"char 65",
        b"charat hello 1",
        b"codeat hello 0",
        b"substr hello 1 3",
        b"strpos hello ll",
        b"length hello",
        b"trim {  hello  }",
        b"strcmp abc def",
        b"strcmp abc abc",
        b"streq abc abc",
        b"expr 10 % 3",
        b"expr 0xff & 0x0f",
        b"expr 1 << 4",
        b"expr 5 == 5",
        b"expr 1 && 1",
        b"expr 1 || 0",
        b"set a [expr 2 + 3]; set b [expr $a * 2]; result $b",
        b"",
        b"#comment line\nset x 1",
        b"set x {braced string with spaces}; result $x",
    ];

    for _ in 0..iters {
        unsafe {
            let lil = lil_new();
            if lil.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let mut h = 0u64;

            for script in scripts {
                let mut code_buf: Vec<u8> = script.to_vec();
                code_buf.push(0);
                let result = lil_parse(
                    lil,
                    code_buf.as_ptr() as *const ::core::ffi::c_char,
                    script.len(),
                    0,
                );
                h = fold_value(h, result);
                if !result.is_null() {
                    lil_free_value(result);
                }
                let mut _msg: *const ::core::ffi::c_char = ptr::null();
                let mut _pos: usize = 0;
                let _ = lil_error(lil, &mut _msg, &mut _pos);
            }

            // Parse user-provided data (limited to avoid timeout on adversarial input)
            if !data.is_empty() {
                // Limit input size to prevent pathological parse times
                let parse_len = data.len().min(4096);
                let mut code_buf: Vec<u8> = data[..parse_len].to_vec();
                code_buf.push(0);
                let result = lil_parse(
                    lil,
                    code_buf.as_ptr() as *const ::core::ffi::c_char,
                    parse_len,
                    0,
                );
                h = fold_value(h, result);
                if !result.is_null() {
                    lil_free_value(result);
                }
            }

            // Also fold raw input bytes so different inputs produce different digests
            h = fold_bytes(h, data);

            let (h2, ef) = fold_error(h, lil);
            h = h2;
            last_err = ef;

            lil_free(lil);
            digest = fold(digest, h);
        }
    }
    format!("op=comprehensive_parse err={} digest={:016x}", last_err, digest)
}

