        unsafe { core::slice::from_raw_parts_mut(entries_ptr, count as usize) };

    // SAFETY: caller provides `key` as a valid NUL-terminated C string.
    let key_cstr = unsafe { core::ffi::CStr::from_ptr(key) };

    let mut i: size_t = 0;
    i = 0 as size_t;
    while i < count {
        let entry = unsafe { entries.get_unchecked_mut(i as usize) };
        // SAFETY: stored hashmap keys are valid NUL-terminated strings created by `strclone`.
        let entry_key = unsafe { core::ffi::CStr::from_ptr(entry.k) };
        if key_cstr == entry_key {
            entry.v = value;
            return;
        }
        i = i.wrapping_add(1);
    }

    (*cell).e = realloc(
        (*cell).e as *mut c_void,
        (::core::mem::size_of::<hashentry_t>() as size_t)
            .wrapping_mul((*cell).c.wrapping_add(1 as size_t)),
    ) as *mut hashentry_t;

    let append_idx = (*cell).c as usize;
    let new_entries_ptr = (*cell).e;
    let new_count = (*cell).c.wrapping_add(1 as size_t);
    // SAFETY: after `realloc`, `new_entries_ptr` is the current bucket storage for
    // `new_count` entries, and this fresh view is created after growth so it does not
    // overlap any pre-realloc slice/view.
    let new_entries: &mut [hashentry_t] =
        unsafe { core::slice::from_raw_parts_mut(new_entries_ptr, new_count as usize) };

    let entry = unsafe { new_entries.get_unchecked_mut(append_idx) };
    entry.k = strclone(key);
    entry.v = value;
    (*cell).c = (*cell).c.wrapping_add(1);
