        let mut cap = have.wrapping_add(have.wrapping_div(2 as size_t));
        if cap < need {
            cap = need;
        }
        if cap < 32 as size_t {
            cap = 32 as size_t;
        }
        realloc((*val).d as *mut c_void, cap) as *mut c_char
