```rust
#[inline]
pub fn lil_append_val(
    mut val: lil_value_t,
    mut v: lil_value_t,
) -> c_int { unsafe {
    let mut new: *mut c_char = ::core::ptr::null_mut::<c_char>();
    if v.is_null() || (*v).l == 0 {
        return 1 as c_int;
    }
    new = realloc(
        (*val).d as *mut c_void,
        (*val).l.wrapping_add((*v).l).wrapping_add(1 as size_t),
    ) as *mut c_char;
    if new.is_null() {
        return 0 as c_int;
    }
    memcpy(
        new.offset((*val).l as isize) as *mut c_void,
        (*v).d as *const c_void,
        (*v).l.wrapping_add(1 as size_t),
    );
    (*val).d = new;
    (*val).l = ((*val).l as c_ulong).wrapping_add((*v).l as c_ulong)
        as size_t as size_t;
    return 1 as c_int;
} }
```

