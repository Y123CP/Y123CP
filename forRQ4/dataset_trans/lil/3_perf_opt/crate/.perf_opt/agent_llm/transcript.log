#[inline]
pub fn lil_append_char(
    mut val: lil_value_t,
    mut ch: c_char,
) -> c_int { unsafe {
    let mut new: *mut c_char = realloc(
        (*val).d as *mut c_void,
        (*val).l.wrapping_add(2 as size_t),
    ) as *mut c_char;
    if new.is_null() {
        return 0 as c_int;
    }
    let fresh10 = (*val).l;
    (*val).l = (*val).l.wrapping_add(1);
    *new.offset(fresh10 as isize) = ch;
    *new.offset((*val).l as isize) = 0 as c_char;
    (*val).d = new;
    return 1 as c_int;
} }
```

