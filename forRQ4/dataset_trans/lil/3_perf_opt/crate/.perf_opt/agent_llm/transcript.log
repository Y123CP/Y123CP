// mutable aliasing.
let bytes = unsafe { core::ffi::CStr::from_ptr(key).to_bytes() };
for &b in bytes {
    hash = (hash << 5 as c_int)
        .wrapping_add(hash)
        .wrapping_add(b as c_ulong);
}
return hash;
```
