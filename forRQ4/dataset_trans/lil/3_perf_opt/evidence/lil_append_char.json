    "rust_source": "pub fn lil_append_char(\n    mut val: lil_value_t,\n    mut ch: c_char,\n) -> c_int { unsafe {\n    let mut new: *mut c_char = realloc(\n        (*val).d as *mut c_void,\n        (*val).l.wrapping_add(2 as size_t),\n    ) as *mut c_char;\n    if new.is_null() {\n        return 0 as c_int;\n    }\n    let fresh10 = (*val).l;\n    (*val).l = (*val).l.wrapping_add(1);\n    *new.offset(fresh10 as isize) = ch;\n    *new.offset((*val).l as isize) = 0 as c_char;\n    (*val).d = new;\n    return 1 as c_int;\n} }",
