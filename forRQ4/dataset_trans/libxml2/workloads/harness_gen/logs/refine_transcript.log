pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let seeds: [(&str, u32, Vec<u8>); 22] = [
        ("html_parse_dump", 1, small_html_seed_one()),
        ("html_parse_dump", 2, small_html_seed_two()),
        ("html_push_parse", 1, small_html_seed_one()),
        ("html_push_parse", 2, small_html_seed_two()),
        ("html_entity_encode", 1, entity_seed_one()),
        ("html_entity_encode", 2, entity_seed_two()),
        ("uri_roundtrip", 1, uri_seed_one()),
        ("uri_roundtrip", 2, uri_seed_two()),
        ("encoding_suite", 1, entity_seed_one()),
        ("encoding_suite", 2, entity_seed_two()),
        ("entities_tree_valid", 1, small_html_seed_one()),
        ("entities_tree_valid", 2, small_html_seed_two()),
        ("globals_threads_memory", 1, entity_seed_one()),
        ("globals_threads_memory", 2, entity_seed_two()),
        ("regexp_pattern", 1, regex_seed_one()),
        ("regexp_pattern", 2, regex_seed_two()),
        ("schema_suite", 1, schema_seed_one()),
        ("schema_suite", 2, schema_seed_two()),
        ("buf_strings_chars", 1, entity_seed_one()),
        ("buf_strings_chars", 2, entity_seed_two()),
        ("writer_save", 1, small_html_seed_one()),
        ("writer_save", 2, small_html_seed_two()),
    ];

    for (op, idx, bytes) in seeds {
        let path = format!("{}/{}.{}.bin", dir, op, idx);
        let _ = fs::write(&path, bytes);
        lines.push(format!("seed {} {}", op, path));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
