fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9e37_79b9_7f4a_7c15)
}

fn checksum(bytes: &[u8]) -> u64 {
    let mut acc = 0xcbf2_9ce4_8422_2325u64;
    for &b in bytes {
        acc ^= b as u64;
        acc = acc.wrapping_mul(0x100_0000_01b3);
    }
    acc
}

fn bounded_i32_len(n: usize) -> c_int {
    if n > c_int::MAX as usize {
        c_int::MAX
    } else {
        n as c_int
    }
}

fn sane_len_i32(n: c_int, cap: usize) -> usize {
    if n <= 0 {
        0
    } else {
        let u = n as usize;
        if u > cap { cap } else { u }
    }
}

fn bytes_with_nul(data: &[u8]) -> Vec<u8> {
    let mut v = Vec::with_capacity(data.len() + 1);
    v.extend_from_slice(data);
    v.push(0);
    v
}

fn split_once_newline(data: &[u8]) -> (&[u8], Option<&[u8]>) {
    for (i, &b) in data.iter().enumerate() {
        if b == b'\n' {
            return (&data[..i], Some(&data[i + 1..]));
        }
    }
    (data, None)
}

unsafe fn c_xml_bytes_len(ptr: *const u8) -> usize {
    if ptr.is_null() {
        return 0;
    }
    let mut n = 0usize;
    while *ptr.add(n) != 0 {
        n += 1;
    }
    n
}

unsafe fn c_xml_len_and_checksum(ptr: *const u8) -> (usize, u64) {
    let len = c_xml_bytes_len(ptr);
    if len == 0 {
        (0, 0)
    } else {
        (len, checksum(std::slice::from_raw_parts(ptr, len)))
    }
}

