    let base_c = bytes_with_nul(base_bytes);
    let mut norm = bytes_with_nul(first);

    let mut digest = 0u64;
    let mut parse_ok_last = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let uri_ptr = xu::xmlParseURI(ref_c.as_ptr() as *const c_char);
            parse_ok_last = (!uri_ptr.is_null()) as u64;
            iter_digest = fold(iter_digest, parse_ok_last);

            if !uri_ptr.is_null() {
                let saved = xu::xmlSaveUri(uri_ptr);
                let (len, sum) = c_xml_len_and_checksum(saved as *const u8);
                iter_digest = fold(iter_digest, len as u64);
                iter_digest = fold(iter_digest, sum);
                if !saved.is_null() {
                    xm::xmlMemFree(saved.cast());
                }
                xu::xmlFreeURI(uri_ptr);
            }

            let uri2 = xu::xmlParseURIRaw(ref_c.as_ptr() as *const c_char, 1);
            iter_digest = fold(iter_digest, (!uri2.is_null()) as u64);
            if !uri2.is_null() {
                let refuri = xu::xmlCreateURI();
                iter_digest = fold(iter_digest, (!refuri.is_null()) as u64);
                if !refuri.is_null() {
                    let pr = xu::xmlParseURIReference(refuri, ref_c.as_ptr() as *const c_char);
                    iter_digest = fold(iter_digest, pr as u32 as u64);
                    let saved2 = xu::xmlSaveUri(refuri);
                    let (l2, s2) = c_xml_len_and_checksum(saved2 as *const u8);
                    iter_digest = fold(iter_digest, l2 as u64);
                    iter_digest = fold(iter_digest, s2);
                    if !saved2.is_null() {
                        xm::xmlMemFree(saved2.cast());
                    }
                    xu::xmlFreeURI(refuri);
                }
                xu::xmlFreeURI(uri2);
            } else {
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
            }

            let escaped = xu::xmlURIEscapeStr(ref_c.as_ptr(), null());
            let (elen, esum) = c_xml_len_and_checksum(escaped as *const u8);
            iter_digest = fold(iter_digest, (!escaped.is_null()) as u64);
            iter_digest = fold(iter_digest, elen as u64);
            iter_digest = fold(iter_digest, esum);
            if !escaped.is_null() {
                xm::xmlMemFree(escaped.cast());
            }

            let escaped2 = xu::xmlURIEscape(ref_c.as_ptr());
            let (elen2, esum2) = c_xml_len_and_checksum(escaped2 as *const u8);
            iter_digest = fold(iter_digest, (!escaped2.is_null()) as u64);
            iter_digest = fold(iter_digest, elen2 as u64);
            iter_digest = fold(iter_digest, esum2);
            if !escaped2.is_null() {
                xm::xmlMemFree(escaped2.cast());
            }

            let built = xu::xmlBuildURI(ref_c.as_ptr(), base_c.as_ptr());
            let (blen, bsum) = c_xml_len_and_checksum(built as *const u8);
            iter_digest = fold(iter_digest, (!built.is_null()) as u64);
            iter_digest = fold(iter_digest, blen as u64);
            iter_digest = fold(iter_digest, bsum);
            if !built.is_null() {
                xm::xmlMemFree(built.cast());
            }

            let rel = xu::xmlBuildRelativeURI(ref_c.as_ptr(), base_c.as_ptr());
            let (rlen, rsum) = c_xml_len_and_checksum(rel as *const u8);
            iter_digest = fold(iter_digest, (!rel.is_null()) as u64);
            iter_digest = fold(iter_digest, rlen as u64);
            iter_digest = fold(iter_digest, rsum);
            if !rel.is_null() {
                xm::xmlMemFree(rel.cast());
            }

            let nrc = xu::xmlNormalizeURIPath(norm.as_mut_ptr() as *mut c_char);
            iter_digest = fold(iter_digest, nrc as u32 as u64);

            let unesc = xu::xmlURIUnescapeString(
                ref_c.as_ptr() as *const c_char,
                bounded_i32_len(first.len()),
                null_mut(),
            );
            let (ulen, usum) = c_xml_len_and_checksum(unesc as *const u8);
            iter_digest = fold(iter_digest, (!unesc.is_null()) as u64);
            iter_digest = fold(iter_digest, ulen as u64);
            iter_digest = fold(iter_digest, usum);
            if !unesc.is_null() {
                xm::xmlMemFree(unesc.cast());
            }

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!(
        "op=uri_roundtrip parse_ok={} digest={:016x}",
        parse_ok_last, digest
    )
}

pub fn op_encoding_suite(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let work_len = bounded_i32_len(data.len());
    let work = &data[..work_len as usize];
    let cap = work.len().saturating_mul(8).saturating_add(64).max(64);

    let a1 = b"latin1\0";
    let a2 = b"harness-latin1\0";
    let p1 = b"UTF-8\0";
    let p2 = b"ISO-8859-1\0";

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            enc::xmlInitCharEncodingHandlers();
            let det = enc::xmlDetectCharEncoding(work.as_ptr(), work_len);
            iter_digest = fold(iter_digest, det as u32 as u64);

            let pe1 = enc::xmlParseCharEncoding(p1.as_ptr() as *const c_char);
            let pe2 = enc::xmlParseCharEncoding(p2.as_ptr() as *const c_char);
            iter_digest = fold(iter_digest, pe1 as u32 as u64);
            iter_digest = fold(iter_digest, pe2 as u32 as u64);

            let n1 = enc::xmlGetCharEncodingName(pe1);
            let n2 = enc::xmlGetCharEncodingName(pe2);
            let (_, s1) = c_xml_len_and_checksum(n1 as *const u8);
            let (_, s2) = c_xml_len_and_checksum(n2 as *const u8);
            iter_digest = fold(iter_digest, s1);
            iter_digest = fold(iter_digest, s2);

            let add_rc =
                enc::xmlAddEncodingAlias(a1.as_ptr() as *const c_char, a2.as_ptr() as *const c_char);
            iter_digest = fold(iter_digest, add_rc as u32 as u64);
            let got = enc::xmlGetEncodingAlias(a2.as_ptr() as *const c_char);
            let (_, gsum) = c_xml_len_and_checksum(got as *const u8);
            iter_digest = fold(iter_digest, (!got.is_null()) as u64);
            iter_digest = fold(iter_digest, gsum);
            let del_rc = enc::xmlDelEncodingAlias(a2.as_ptr() as *const c_char);
            iter_digest = fold(iter_digest, del_rc as u32 as u64);
            enc::xmlCleanupEncodingAliases();

            let mut out1 = vec![0u8; cap];
            let mut outlen1 = bounded_i32_len(cap);
            let mut inlen1 = work_len;
            last_rc = enc::isolat1ToUTF8(out1.as_mut_ptr(), &mut outlen1, work.as_ptr(), &mut inlen1);
            iter_digest = fold(iter_digest, last_rc as u32 as u64);
            iter_digest = fold(iter_digest, sane_len_i32(outlen1, out1.len()) as u64);
            iter_digest = fold(iter_digest, sane_len_i32(inlen1, work.len()) as u64);

            let mut out2 = vec![0u8; cap];
            let mut outlen2 = bounded_i32_len(cap);
            let mut inlen2 = work_len;
            let rc2 = enc::UTF8Toisolat1(out2.as_mut_ptr(), &mut outlen2, work.as_ptr(), &mut inlen2);
            iter_digest = fold(iter_digest, rc2 as u32 as u64);
            iter_digest = fold(iter_digest, sane_len_i32(outlen2, out2.len()) as u64);
            iter_digest = fold(iter_digest, sane_len_i32(inlen2, work.len()) as u64);

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=encoding_suite rc={} digest={:016x}", last_rc, digest)
}

pub fn op_entities_tree_valid(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);

    let qname = b"ns:tag\0";
    let prefix = b"ns\0";
    let local = b"tag\0";
    let amp = b"amp\0";
    let ent_name = b"h_entity\0";
    let ent_content = b"value & more\0";

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let doc = hp::htmlParseDoc(input_c.as_ptr(), null());
            iter_digest = fold(iter_digest, (!doc.is_null()) as u64);

            let vq = xt::xmlValidateQName(qname.as_ptr(), 0);
            let vn = xt::xmlValidateName(qname.as_ptr(), 0);
            let vnc = xt::xmlValidateNCName(local.as_ptr(), 0);
            let vnm = xt::xmlValidateNMToken(qname.as_ptr(), 0);
            iter_digest = fold(iter_digest, vq as u32 as u64);
            iter_digest = fold(iter_digest, vn as u32 as u64);
            iter_digest = fold(iter_digest, vnc as u32 as u64);
            iter_digest = fold(iter_digest, vnm as u32 as u64);

            let mut pre = null_mut();
            let split2 = xt::xmlSplitQName2(qname.as_ptr(), &mut pre);
            let split3_len_ptr = &mut 0i32;
            let split3 = xt::xmlSplitQName3(qname.as_ptr(), split3_len_ptr);
            let built = xt::xmlBuildQName(local.as_ptr(), prefix.as_ptr(), null_mut(), 0);
            let (_, s_pre) = c_xml_len_and_checksum(pre as *const u8);
            let (_, s_s2) = c_xml_len_and_checksum(split2 as *const u8);
            let (_, s_s3) = c_xml_len_and_checksum(split3 as *const u8);
            let (_, s_bq) = c_xml_len_and_checksum(built as *const u8);
            iter_digest = fold(iter_digest, s_pre);
            iter_digest = fold(iter_digest, s_s2);
            iter_digest = fold(iter_digest, *split3_len_ptr as u32 as u64);
            iter_digest = fold(iter_digest, s_s3);
            iter_digest = fold(iter_digest, s_bq);
            if !pre.is_null() {
                xm::xmlMemFree(pre.cast());
            }
            if !split2.is_null() {
                xm::xmlMemFree(split2.cast());
            }
            if !built.is_null() {
                xm::xmlMemFree(built.cast());
            }

            let predef = xe2::xmlGetPredefinedEntity(amp.as_ptr());
            iter_digest = fold(iter_digest, (!predef.is_null()) as u64);

            if !doc.is_null() {
                let a1 = xe2::xmlAddDocEntity(
                    doc as *mut _,
                    ent_name.as_ptr(),
                    1,
                    null(),
                    null(),
                    ent_content.as_ptr(),
                );
                let a2 = xe2::xmlAddDtdEntity(
                    doc as *mut _,
                    ent_name.as_ptr(),
                    1,
                    null(),
                    null(),
                    ent_content.as_ptr(),
                );
                let g1 = xe2::xmlGetDocEntity(doc as *const _, ent_name.as_ptr());
                let g2 = xe2::xmlGetDtdEntity(doc as *mut _, ent_name.as_ptr());
                let g3 = xe2::xmlGetParameterEntity(doc as *mut _, ent_name.as_ptr());
                iter_digest = fold(iter_digest, (!a1.is_null()) as u64);
                iter_digest = fold(iter_digest, (!a2.is_null()) as u64);
                iter_digest = fold(iter_digest, (!g1.is_null()) as u64);
                iter_digest = fold(iter_digest, (!g2.is_null()) as u64);
                iter_digest = fold(iter_digest, (!g3.is_null()) as u64);

                let e1 = xe2::xmlEncodeAttributeEntities(doc as *mut _, input_c.as_ptr());
                let e2 = xe2::xmlEncodeEntitiesReentrant(doc as *mut _, input_c.as_ptr());
                let e3 = xe2::xmlEncodeSpecialChars(doc as *const _, input_c.as_ptr());
                let (l1, s1) = c_xml_len_and_checksum(e1 as *const u8);
                let (l2, s2) = c_xml_len_and_checksum(e2 as *const u8);
                let (l3, s3) = c_xml_len_and_checksum(e3 as *const u8);
                iter_digest = fold(iter_digest, l1 as u64);
                iter_digest = fold(iter_digest, s1);
                iter_digest = fold(iter_digest, l2 as u64);
                iter_digest = fold(iter_digest, s2);
                iter_digest = fold(iter_digest, l3 as u64);
                iter_digest = fold(iter_digest, s3);
                if !e1.is_null() {
                    xm::xmlMemFree(e1.cast());
                }
                if !e2.is_null() {
                    xm::xmlMemFree(e2.cast());
                }
                if !e3.is_null() {
                    xm::xmlMemFree(e3.cast());
                }

                let vctxt = xv::xmlNewValidCtxt();
                iter_digest = fold(iter_digest, (!vctxt.is_null()) as u64);
                if !vctxt.is_null() {
                    xv::xmlFreeValidCtxt(vctxt);
                }

                xt::xmlFreeDoc(doc.cast());
            }

            last_rc = 0;
            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=entities_tree_valid rc={} digest={:016x}", last_rc, digest)
}

pub fn op_globals_threads_memory(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let n = data.len().max(1).min(4096);
    let dup_src = bytes_with_nul(&data[..n.min(data.len())]);

    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            xg::xmlInitGlobals();
            xg::xmlInitGlobalsInternal();
            let gs = xg::xmlGetGlobalState();
            iter_digest = fold(iter_digest, (!gs.is_null()) as u64);
            iter_digest = fold(iter_digest, xg::xmlIsMainThread() as u32 as u64);
            iter_digest = fold(iter_digest, (!xg::__xmlStructuredErrorContext().is_null()) as u64);
            iter_digest = fold(iter_digest, (!xg::__xmlStructuredError().is_null()) as u64);
            iter_digest = fold(iter_digest, (!xg::__xmlLastError().is_null()) as u64);
            iter_digest = fold(iter_digest, (!xg::__xmlGenericError().is_null()) as u64);

            let tid = xth::xmlGetThreadId();
            iter_digest = fold(iter_digest, (tid != 0) as u64);

            let m = xth::xmlNewMutex();
            iter_digest = fold(iter_digest, (!m.is_null()) as u64);
            if !m.is_null() {
                xth::xmlMutexLock(m);
                xth::xmlMutexUnlock(m);
                xth::xmlFreeMutex(m);
            }

            let rm = xth::xmlNewRMutex();
            iter_digest = fold(iter_digest, (!rm.is_null()) as u64);
            if !rm.is_null() {
                xth::xmlRMutexLock(rm);
                xth::xmlRMutexUnlock(rm);
                xth::xmlFreeRMutex(rm);
            }

            let p = xm::xmlMemMalloc(n);
            iter_digest = fold(iter_digest, (!p.is_null()) as u64);
            if !p.is_null() {
                let p2 = xm::xmlMemRealloc(p, n.saturating_mul(2));
                iter_digest = fold(iter_digest, (!p2.is_null()) as u64);
                if !p2.is_null() {
                    xm::xmlMemFree(p2);
                } else {
                    xm::xmlMemFree(p);
                }
            }

            let d = xm::xmlMemoryStrdup(dup_src.as_ptr() as *const c_char);
            let (dlen, dsum) = c_xml_len_and_checksum(d as *const u8);
            iter_digest = fold(iter_digest, (!d.is_null()) as u64);
            iter_digest = fold(iter_digest, dlen as u64);
            iter_digest = fold(iter_digest, dsum);
            if !d.is_null() {
                xm::xmlMemFree(d.cast());
            }

            xg::xmlCleanupGlobalsInternal();
            xg::xmlCleanupGlobals();

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=globals_threads_memory digest={:016x}", digest)
}

pub fn op_regexp_pattern(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let (pat_bytes, text_opt) = split_once_newline(data);
    let text_bytes = text_opt.unwrap_or(data);

    let pat_c = bytes_with_nul(pat_bytes);
    let text_c = bytes_with_nul(text_bytes);
    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let re = xre::xmlRegexpCompile(pat_c.as_ptr());
            iter_digest = fold(iter_digest, (!re.is_null()) as u64);
            if !re.is_null() {
                let det = xre::xmlRegexpIsDeterminist(re);
                let rc = xre::xmlRegexpExec(re, text_c.as_ptr());
                iter_digest = fold(iter_digest, det as u32 as u64);
                iter_digest = fold(iter_digest, rc as u32 as u64);
                last_rc = rc;
                xre::xmlRegFreeRegexp(re);
            }

            let p = xpat::xmlPatterncompile(pat_c.as_ptr(), null_mut(), 0, null_mut());
            iter_digest = fold(iter_digest, (!p.is_null()) as u64);
            if !p.is_null() {
                let sc = xpat::xmlPatternGetStreamCtxt(p);
                iter_digest = fold(iter_digest, (!sc.is_null()) as u64);
                if !sc.is_null() {
                    let w = xpat::xmlStreamWantsAnyNode(sc);
                    let sp1 = xpat::xmlStreamPush(sc, b"root\0".as_ptr(), null());
                    let sp2 = xpat::xmlStreamPushAttr(sc, b"id\0".as_ptr(), null());
                    let sp3 = xpat::xmlStreamPushNode(sc, b"item\0".as_ptr(), null(), 1);
                    let sp4 = xpat::xmlStreamPop(sc);
                    iter_digest = fold(iter_digest, w as u32 as u64);
                    iter_digest = fold(iter_digest, sp1 as u32 as u64);
                    iter_digest = fold(iter_digest, sp2 as u32 as u64);
                    iter_digest = fold(iter_digest, sp3 as u32 as u64);
                    iter_digest = fold(iter_digest, sp4 as u32 as u64);
                    xpat::xmlFreeStreamCtxt(sc);
                }
                xpat::xmlFreePattern(p);
            }

            xxp::xmlXPathInit();
            iter_digest = fold(iter_digest, xxp::xmlXPathIsNaN(f64::NAN) as u32 as u64);
            iter_digest = fold(iter_digest, xxp::xmlXPathIsInf(f64::INFINITY) as u32 as u64);

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=regexp_pattern rc={} digest={:016x}", last_rc, digest)
}

pub fn op_schema_suite(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let rinit = xrg::xmlRelaxNGInitTypes();
            iter_digest = fold(iter_digest, rinit as u32 as u64);
            let rctxt = xrg::xmlRelaxNGNewMemParserCtxt(
                input_c.as_ptr() as *const c_char,
                bounded_i32_len(data.len()),
            );
            iter_digest = fold(iter_digest, (!rctxt.is_null()) as u64);
            if !rctxt.is_null() {
                let fr = xrg::xmlRelaxParserSetFlag(rctxt, 0);
                iter_digest = fold(iter_digest, fr as u32 as u64);
                xrg::xmlRelaxNGSetParserErrors(rctxt, None, None, null_mut());
                let mut e = None;
                let mut w = None;
                let mut ctx = null_mut();
                let gr = xrg::xmlRelaxNGGetParserErrors(rctxt, &mut e, &mut w, &mut ctx);
                iter_digest = fold(iter_digest, gr as u32 as u64);
                let schema = xrg::xmlRelaxNGParse(rctxt);
                iter_digest = fold(iter_digest, (!schema.is_null()) as u64);
                if !schema.is_null() {
                    xrg::xmlRelaxNGFree(schema);
                }
                xrg::xmlRelaxNGFreeParserCtxt(rctxt);
            }
            xrg::xmlRelaxNGCleanupTypes();

            let sinit = xst::xmlSchemaInitTypes();
            iter_digest = fold(iter_digest, sinit as u32 as u64);
            let built = xst::xmlSchemaGetBuiltInType(1 as xst::xmlSchemaValType);
            iter_digest = fold(iter_digest, (!built.is_null()) as u64);
            if !built.is_null() {
                let bf = xst::xmlSchemaIsBuiltInTypeFacet(built, 0);
                iter_digest = fold(iter_digest, bf as u32 as u64);
            }

            let pctxt = xsd::xmlSchemaNewMemParserCtxt(
                input_c.as_ptr() as *const c_char,
                bounded_i32_len(data.len()),
            );
            iter_digest = fold(iter_digest, (!pctxt.is_null()) as u64);
            if !pctxt.is_null() {
                let facet = xsd::xmlSchemaNewFacet();
                iter_digest = fold(iter_digest, (!facet.is_null()) as u64);
                if !facet.is_null() {
                    let cfr = xsd::xmlSchemaCheckFacet(
                        facet,
                        built as *mut _,
                        pctxt,
                        b"name\0".as_ptr(),
                    );
                    iter_digest = fold(iter_digest, cfr as u32 as u64);
                    xsd::xmlSchemaFreeFacet(facet);
                }
                let sch = xsd::xmlSchemaParse(pctxt);
                iter_digest = fold(iter_digest, (!sch.is_null()) as u64);
                if !sch.is_null() {
                    xsd::xmlSchemaFree(sch);
                }
                xsd::xmlSchemaFreeParserCtxt(pctxt);
            }
            xst::xmlSchemaCleanupTypes();

            let sctxt = xsct::xmlSchematronNewMemParserCtxt(
                input_c.as_ptr() as *const c_char,
                bounded_i32_len(data.len()),
            );
            iter_digest = fold(iter_digest, (!sctxt.is_null()) as u64);
            if !sctxt.is_null() {
                let sch = xsct::xmlSchematronParse(sctxt);
                iter_digest = fold(iter_digest, (!sch.is_null()) as u64);
                if !sch.is_null() {
                    let vctxt = xsct::xmlSchematronNewValidCtxt(sch, 0);
                    iter_digest = fold(iter_digest, (!vctxt.is_null()) as u64);
                    if !vctxt.is_null() {
                        xsct::xmlSchematronSetValidStructuredErrors(vctxt, None, null_mut());
                        let doc = hp::htmlParseDoc(input_c.as_ptr(), null());
                        if !doc.is_null() {
                            last_rc = xsct::xmlSchematronValidateDoc(vctxt, doc as *mut _);
                            iter_digest = fold(iter_digest, last_rc as u32 as u64);
                            xt::xmlFreeDoc(doc.cast());
                        }
                        xsct::xmlSchematronFreeValidCtxt(vctxt);
                    }
                    xsct::xmlSchematronFree(sch);
                }
                xsct::xmlSchematronFreeParserCtxt(sctxt);
            }

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=schema_suite rc={} digest={:016x}", last_rc, digest)
}

pub fn op_buf_strings_chars(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);

    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let b = xb::xmlBufCreateSize(data.len().max(64));
            iter_digest = fold(iter_digest, (!b.is_null()) as u64);
            if !b.is_null() {
                let sch0 = xb::xmlBufGetAllocationScheme(b);
                let set_rc = xb::xmlBufSetAllocationScheme(b, 0 as xb::xmlBufferAllocationScheme);
                let grow_rc = xb::xmlBufGrow(b, bounded_i32_len(data.len().max(16)));
                let content = xb::xmlBufContent(b);
                let (_, csum) = c_xml_len_and_checksum(content as *const u8);
                iter_digest = fold(iter_digest, sch0 as u32 as u64);
                iter_digest = fold(iter_digest, set_rc as u32 as u64);
                iter_digest = fold(iter_digest, grow_rc as u32 as u64);
                iter_digest = fold(iter_digest, csum);
                let shr = xb::xmlBufShrink(b, (data.len() / 2) as usize);
                iter_digest = fold(iter_digest, shr as u64);
                let detached = xb::xmlBufDetach(b);
                let (dlen, dsum) = c_xml_len_and_checksum(detached as *const u8);
                iter_digest = fold(iter_digest, dlen as u64);
                iter_digest = fold(iter_digest, dsum);
                if !detached.is_null() {
                    xm::xmlMemFree(detached.cast());
                }
                xb::xmlBufEmpty(b);
                xb::xmlBufFree(b);
            }

            let s1 = xs::xmlStrdup(input_c.as_ptr());
            let s2 = xs::xmlStrndup(input_c.as_ptr(), bounded_i32_len(data.len().min(32)));
            let s3 = xs::xmlCharStrdup(input_c.as_ptr() as *const c_char);
            let s4 = xs::xmlCharStrndup(
                input_c.as_ptr() as *const c_char,
                bounded_i32_len(data.len().min(32)),
            );
            iter_digest = fold(iter_digest, (!s1.is_null()) as u64);
            iter_digest = fold(iter_digest, (!s2.is_null()) as u64);
            iter_digest = fold(iter_digest, (!s3.is_null()) as u64);
            iter_digest = fold(iter_digest, (!s4.is_null()) as u64);
            iter_digest = fold(iter_digest, xs::xmlStrcmp(input_c.as_ptr(), input_c.as_ptr()) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrEqual(input_c.as_ptr(), input_c.as_ptr()) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrQEqual(b"ns\0".as_ptr(), b"x\0".as_ptr(), b"ns:x\0".as_ptr()) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrncmp(input_c.as_ptr(), input_c.as_ptr(), 4) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrcasecmp(b"AbC\0".as_ptr(), b"aBc\0".as_ptr()) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrncasecmp(b"AbCd\0".as_ptr(), b"aBcE\0".as_ptr(), 3) as u32 as u64);
            if !s1.is_null() {
                xm::xmlMemFree(s1.cast());
            }
            if !s2.is_null() {
                xm::xmlMemFree(s2.cast());
            }
            if !s3.is_null() {
                xm::xmlMemFree(s3.cast());
            }
            if !s4.is_null() {
                xm::xmlMemFree(s4.cast());
            }

            for &b in data.iter().take(32) {
                let v = b as u32;
                iter_digest = fold(iter_digest, xc::xmlIsBaseChar(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsBlank(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsChar(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsCombining(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsDigit(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsExtender(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsIdeographic(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsPubidChar(v) as u32 as u64);
            }

            let cps = [0x41, 0x627, 0x391, 0x30, 0x4e00, 0x2192];
            for &cp in &cps {
                iter_digest = fold(iter_digest, xucc::xmlUCSIsAegeanNumbers(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsAlphabeticPresentationForms(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArabic(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArabicPresentationFormsA(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArabicPresentationFormsB(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArmenian(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArrows(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsBasicLatin(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsBengali(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsBlockElements(cp) as u32 as u64);
            }

            let h = xh::xmlHashCreate(8);
            iter_digest = fold(iter_digest, (!h.is_null()) as u64);
            if !h.is_null() {
                let add1 = xh::xmlHashAddEntry(h, b"k1\0".as_ptr(), input_c.as_ptr() as *mut _);
                let add2 = xh::xmlHashAddEntry2(h, b"k2\0".as_ptr(), b"s2\0".as_ptr(), input_c.as_ptr() as *mut _);
                let add3 = xh::xmlHashAddEntry3(h, b"k3\0".as_ptr(), b"s3\0".as_ptr(), b"t3\0".as_ptr(), input_c.as_ptr() as *mut _);
                let up1 = xh::xmlHashUpdateEntry(h, b"k1\0".as_ptr(), input_c.as_ptr() as *mut _, None);
                let up2 = xh::xmlHashUpdateEntry2(h, b"k2\0".as_ptr(), b"s2\0".as_ptr(), input_c.as_ptr() as *mut _, None);
                let up3 = xh::xmlHashUpdateEntry3(h, b"k3\0".as_ptr(), b"s3\0".as_ptr(), b"t3\0".as_ptr(), input_c.as_ptr() as *mut _, None);
                let lk = xh::xmlHashLookup(h, b"k1\0".as_ptr());
                iter_digest = fold(iter_digest, add1 as u32 as u64);
                iter_digest = fold(iter_digest, add2 as u32 as u64);
                iter_digest = fold(iter_digest, add3 as u32 as u64);
                iter_digest = fold(iter_digest, up1 as u32 as u64);
                iter_digest = fold(iter_digest, up2 as u32 as u64);
                iter_digest = fold(iter_digest, up3 as u32 as u64);
                iter_digest = fold(iter_digest, (!lk.is_null()) as u64);
                xh::xmlHashFree(h, None);
            }

            let _ = xd::xmlInitializeDict();
            xd::xmlInitDictInternal();
            let d = xd::xmlDictCreate();
            iter_digest = fold(iter_digest, (!d.is_null()) as u64);
            if !d.is_null() {
                let d2 = xd::xmlDictCreateSub(d);
                iter_digest = fold(iter_digest, (!d2.is_null()) as u64);
                iter_digest = fold(iter_digest, xd::xmlDictReference(d) as u32 as u64);
                iter_digest = fold(iter_digest, xd::xmlDictSize(d) as u32 as u64);
                iter_digest = fold(iter_digest, xd::xmlDictSetLimit(d, 4096) as u64);
                iter_digest = fold(iter_digest, xd::xmlDictOwns(d, input_c.as_ptr()) as u32 as u64);
                if !d2.is_null() {
                    xd::xmlDictFree(d2);
                }
                xd::xmlDictFree(d);
            }
            xd::xmlCleanupDictInternal();
            xd::xmlDictCleanup();

            xpi::xmlCheckVersion(20900);
            iter_digest = fold(iter_digest, xp::xmlCheckLanguageID(b"en-US\0".as_ptr()) as u32 as u64);
            let nsdb = xp::xmlParserNsCreate();
            iter_digest = fold(iter_digest, (!nsdb.is_null()) as u64);
            if !nsdb.is_null() {
                xp::xmlParserNsFree(nsdb);
            }
            iter_digest = fold(iter_digest, xpi::xmlIsLetter(b'A' as c_int) as u32 as u64);

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=buf_strings_chars digest={:016x}", digest)
}

pub fn op_writer_save(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);
    let out_path = temp_path("save", input_sum, "xml");

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let mut wdoc: xw::xmlDocPtr = null_mut();
            let writer = xw::xmlNewTextWriterDoc(&mut wdoc, 0);
            iter_digest = fold(iter_digest, (!writer.is_null()) as u64);
            if !writer.is_null() {
                let r1 = xw::xmlTextWriterStartDocument(
                    writer,
                    b"1.0\0".as_ptr() as *const c_char,
                    b"UTF-8\0".as_ptr() as *const c_char,
                    null(),
                );
                let r2 = xw::xmlTextWriterStartComment(writer);
                let r3 = xw::xmlTextWriterEndDocument(writer);
                iter_digest = fold(iter_digest, r1 as u32 as u64);
                iter_digest = fold(iter_digest, r2 as u32 as u64);
                iter_digest = fold(iter_digest, r3 as u32 as u64);
                xw::xmlFreeTextWriter(writer);
            }
            iter_digest = fold(iter_digest, (!wdoc.is_null()) as u64);
            if !wdoc.is_null() {
                xt::xmlFreeDoc(wdoc as *mut _);
            }

            let html_doc = hp::htmlParseDoc(input_c.as_ptr(), null());
            iter_digest = fold(iter_digest, (!html_doc.is_null()) as u64);
            if !html_doc.is_null() {
                if let Some(cpath) = cstring_from_path(&out_path) {
                    let sctxt = xsave::xmlSaveToFilename(cpath.as_ptr(), null(), 0);
                    iter_digest = fold(iter_digest, (!sctxt.is_null()) as u64);
                    if !sctxt.is_null() {
                        let sd = xsave::xmlSaveDoc(sctxt, html_doc as *mut _);
                        let sf = xsave::xmlSaveFlush(sctxt);
                        let sc = xsave::xmlSaveClose(sctxt);
                        iter_digest = fold(iter_digest, sd as u64);
                        iter_digest = fold(iter_digest, sf as u32 as u64);
                        iter_digest = fold(iter_digest, sc as u32 as u64);
                    }
                }

                let fd_path = temp_path("savefd", input_sum, "html");
                let _ = fs::remove_file(&fd_path);
                if let Ok(file) = fs::File::create(&fd_path) {
                    let fd = file.as_raw_fd();
                    let sctxt2 = xsave::xmlSaveToFd(fd as c_int, null(), 0);
                    iter_digest = fold(iter_digest, (!sctxt2.is_null()) as u64);
                    if !sctxt2.is_null() {
                        let sd2 = xsave::xmlSaveDoc(sctxt2, html_doc as *mut _);
                        let sc2 = xsave::xmlSaveClose(sctxt2);
                        iter_digest = fold(iter_digest, sd2 as u64);
                        iter_digest = fold(iter_digest, sc2 as u32 as u64);
                        last_rc = sc2;
                    }
                    drop(file);
                    let _ = fs::remove_file(fd_path);
                }

                xt::xmlFreeDoc(html_doc.cast());
            }

            let win = xio::xmlNormalizeWindowsPath(b"C:\\tmp\\a\\..\\b\\file.xml\0".as_ptr());
            let (wlen, wsum) = c_xml_len_and_checksum(win as *const u8);
            iter_digest = fold(iter_digest, wlen as u64);
            iter_digest = fold(iter_digest, wsum);
            if !win.is_null() {
                xm::xmlMemFree(win.cast());
            }

            iter_digest = fold(iter_digest, xio::xmlCheckFilename(b".\0".as_ptr() as *const c_char) as u32 as u64);
            iter_digest = fold(iter_digest, xio::xmlFileMatch(b"file:///tmp/x.xml\0".as_ptr() as *const c_char) as u32 as u64);
            xio::xmlCleanupInputCallbacks();
            xio::xmlCleanupOutputCallbacks();

            let _ = fs::remove_file(&out_path);

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=writer_save rc={} digest={:016x}", last_rc, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("html_parse_dump", op_html_parse_dump as fn(&[u8], u64) -> String),
        ("html_push_parse", op_html_push_parse as fn(&[u8], u64) -> String),
        ("html_entity_encode", op_html_entity_encode as fn(&[u8], u64) -> String),
        ("uri_roundtrip", op_uri_roundtrip as fn(&[u8], u64) -> String),
        ("encoding_suite", op_encoding_suite as fn(&[u8], u64) -> String),
        ("entities_tree_valid", op_entities_tree_valid as fn(&[u8], u64) -> String),
        ("globals_threads_memory", op_globals_threads_memory as fn(&[u8], u64) -> String),
        ("regexp_pattern", op_regexp_pattern as fn(&[u8], u64) -> String),
        ("schema_suite", op_schema_suite as fn(&[u8], u64) -> String),
        ("buf_strings_chars", op_buf_strings_chars as fn(&[u8], u64) -> String),
        ("writer_save", op_writer_save as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let seeds: [(&str, u32, Vec<u8>); 22] = [
        ("html_parse_dump", 1, small_html_seed_one()),
        ("html_parse_dump", 2, small_html_seed_two()),
        ("html_push_parse", 1, small_html_seed_one()),
        ("html_push_parse", 2, small_html_seed_two()),
        ("html_entity_encode", 1, entity_seed_one()),
        ("html_entity_encode", 2, entity_seed_two()),
        ("uri_roundtrip", 1, uri_seed_one()),
        ("uri_roundtrip", 2, uri_seed_two()),
        ("encoding_suite", 1, entity_seed_one()),
        ("encoding_suite", 2, entity_seed_two()),
        ("entities_tree_valid", 1, small_html_seed_one()),
        ("entities_tree_valid", 2, small_html_seed_two()),
        ("globals_threads_memory", 1, entity_seed_one()),
        ("globals_threads_memory", 2, entity_seed_two()),
        ("regexp_pattern", 1, regex_seed_one()),
        ("regexp_pattern", 2, regex_seed_two()),
        ("schema_suite", 1, schema_seed_one()),
        ("schema_suite", 2, schema_seed_two()),
        ("buf_strings_chars", 1, entity_seed_one()),
        ("buf_strings_chars", 2, entity_seed_two()),
        ("writer_save", 1, small_html_seed_one()),
        ("writer_save", 2, small_html_seed_two()),
    ];

    for (op, idx, bytes) in seeds {
        let path = format!("{}/{}.{}.bin", dir, op, idx);
        let _ = fs::write(&path, bytes);
        lines.push(format!("seed {} {}", op, path));
    }

    lines
}

fn utf8_to_latin1_bytes(data: &[u8]) -> Vec<u8> {
    if data.is_empty() {
        return Vec::new();
    }
    unsafe {
        let mut out = vec![0u8; data.len().saturating_mul(2).saturating_add(32)];
        let mut outlen = bounded_i32_len(out.len());
        let mut inlen = bounded_i32_len(data.len());
        let rc = enc::UTF8Toisolat1(out.as_mut_ptr(), &mut outlen, data.as_ptr(), &mut inlen);
        let produced = sane_len_i32(outlen, out.len());
        let consumed = sane_len_i32(inlen, data.len());
        if rc >= 0 && consumed == data.len() {
            out.truncate(produced);
            return out;
        }
    }
    data.iter().map(|&b| if b < 0x80 { b } else { b'?' }).collect()
}

fn large_latin1_html_document(section_count: u32, rows_per_section: u32, list_items: u32) -> Vec<u8> {
    let mut s = String::new();
    s.push_str("<!DOCTYPE html>\n");
    s.push_str("<html>\n<head>\n");
    s.push_str("<meta charset=\"ISO-8859-1\">\n");
    s.push_str("<meta http-equiv=\"Content-Type\" content=\"text/html; charset=ISO-8859-1\">\n");
    s.push_str("<title>Grand document HTML latin1</title>\n");
    s.push_str("<meta name=\"generator\" content=\"libxml2_raw_harness\">\n");
    s.push_str("<meta name=\"description\" content=\"cafe resume naive jalapeno garcon deja vu\">\n");
    s.push_str("<style>");
    s.push_str("body{font-family:sans-serif}.section{margin:8px 0}.card{border:1px solid #ccc;padding:4px;margin:2px}");
    s.push_str("table{border-collapse:collapse}td,th{border:1px solid #999;padding:2px 4px}");
    s.push_str(".note{color:#444}.grid{display:block}");
    s.push_str("</style>\n");
    s.push_str("</head>\n");
    s.push_str("<body class=\"main\" data-note=\"1 &amp; 2\" lang=\"fr\">\n");
    s.push_str("<!-- grand corpus valide pour parse + dump + push -->\n");
    s.push_str("<div id=\"root\">\n");
    s.push_str("<form id=\"top-form\"><input disabled checked readonly name=\"seed\" value=\"café\"><button disabled>envoyer</button></form>\n");
    s.push_str("<script src=\"/static/app.js?x=1&amp;y=2\" data-src=\"a&lt;b&amp;&amp;c&gt;0\">var x='&not-an-entity;';var y='café';</script>\n");
    for sec in 0..section_count {
        s.push_str(&format!(
            "<section class=\"section grid\" id=\"sec-{}\"><h2>Section {}</h2>\
             <!-- commentaire {}: deja vu, facade, voila, role -->\
             <p class=\"note\">café, naïve, résumé, coöperate, jalapeño, garçon, façade, voilà, rôle, élève &amp; ami.</p>\
             <form id=\"form-{}\"><input disabled checked readonly name=\"name{}\" value=\"café-{}\">\
             <select multiple><option selected>résumé {}</option><option>jalapeño {}</option></select></form>",
            sec, sec, sec, sec, sec, sec, sec, sec
        ));
        s.push_str("<table><tr><th>ID</th><th>Label</th><th>Link</th><th>Flags</th></tr>");
        for row in 0..rows_per_section {
            let id = sec * 1000 + row;
            s.push_str(&format!(
                "<tr class=\"card\"><td>{}</td><td title=\"café &amp; résumé {}\">Entrée {}</td>\
                 <td><a href=\"/catalog/{}/{}?lang=fr&amp;ref=perf#r{}\">ouvrir</a></td>\
                 <td data-a=\"{}\" data-b=\"{}\">checked disabled readonly selected multiple</td></tr>",
                id,
                row,
                id,
                sec,
                row,
                row,
                sec % 11,
                row % 7
            ));
        }
        s.push_str("</table><ul>");
        for item in 0..list_items {
            s.push_str(&format!(
                "<li class=\"card\" data-item=\"{}\" data-text=\"Tom &amp; Jerry &quot;bonjour&quot;\">\
                 <strong>Entrée {}</strong><span> deja vu, facade, cafe, resume, voila, noel, ou est l'hotel? </span></li>",
                item, item
            ));
        }
        s.push_str("</ul>");
        s.push_str("<script src=\"/js/section.js\" defer>if(window&&document){document.title='café';}</script>");
        s.push_str("</section>\n");
    }
    s.push_str("</div>\n</body>\n</html>\n");
    utf8_to_latin1_bytes(s.as_bytes())
}

fn large_html_push_perf_document() -> Vec<u8> {
    large_latin1_html_document(700, 18, 12)
}

fn large_html_dump_perf_document() -> Vec<u8> {
    large_latin1_html_document(560, 24, 16)
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let html_parse_perf = large_html_dump_perf_document();
    let html_parse_path = format!("{}/html_parse_dump.perf.bin", dir);
    let _ = fs::write(&html_parse_path, &html_parse_perf);
    lines.push(format!("perf html_parse_dump {}", html_parse_path));

    let big_html = large_html_push_perf_document();
    let html_push_path = format!("{}/html_push_parse.perf.bin", dir);
    let _ = fs::write(&html_push_path, &big_html);
    lines.push(format!("perf html_push_parse {}", html_push_path));

    let big_text = large_entity_text();
    let entity_path = format!("{}/html_entity_encode.perf.bin", dir);
    let _ = fs::write(&entity_path, &big_text);
    lines.push(format!("perf html_entity_encode {}", entity_path));

    lines
}
