pub fn op_html_parse_dump(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);

    let html_tag = b"script\0";
    let html_ent = b"nbsp\0";
    let bool_attr = b"checked\0";
    let script_attr = b"src\0";
    let utf8_meta = b"UTF-8\0";

    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            xe::xmlResetLastError();
            hp::htmlInitAutoClose();

            let tag_hit = (!hp::htmlTagLookup(html_tag.as_ptr()).is_null()) as u64;
            let ent_hit = (!hp::htmlEntityLookup(html_ent.as_ptr()).is_null()) as u64;
            let ent_v_hit = (!hp::htmlEntityValueLookup(160).is_null()) as u64;
            let bool_hit = ht::htmlIsBooleanAttr(bool_attr.as_ptr()) as u64;
            let script_hit = hp::htmlIsScriptAttribute(script_attr.as_ptr()) as u64;

            let doc = hp::htmlParseDoc(input_c.as_ptr(), null());
            let parse_ok = (!doc.is_null()) as u64;
            let mut meta_found = 0u64;
            let mut meta_set = 0u64;
            let mut out_len = 0usize;
            let mut out_sum = 0u64;
            let mut out_len2 = 0usize;
            let mut out_sum2 = 0u64;

            if !doc.is_null() {
                let meta = ht::htmlGetMetaEncoding(doc.cast());
                meta_found = (!meta.is_null()) as u64;
                meta_set = (ht::htmlSetMetaEncoding(doc.cast(), utf8_meta.as_ptr()) == 0) as u64;

                let mut mem_ptr = null_mut();
                let mut size: c_int = 0;
                ht::htmlDocDumpMemoryFormat(doc.cast(), &mut mem_ptr, &mut size, 1);
                out_len = sane_len_i32(size, size.max(0) as usize);
                if !mem_ptr.is_null() && out_len > 0 {
                    out_sum = checksum(std::slice::from_raw_parts(mem_ptr as *const u8, out_len));
                }
                if !mem_ptr.is_null() {
                    xm::xmlMemFree(mem_ptr.cast());
                }

                let mut mem_ptr2 = null_mut();
                let mut size2: c_int = 0;
                ht::htmlDocDumpMemory(doc.cast(), &mut mem_ptr2, &mut size2);
                out_len2 = sane_len_i32(size2, size2.max(0) as usize);
                if !mem_ptr2.is_null() && out_len2 > 0 {
                    out_sum2 = checksum(std::slice::from_raw_parts(mem_ptr2 as *const u8, out_len2));
                }
                if !mem_ptr2.is_null() {
                    xm::xmlMemFree(mem_ptr2.cast());
                }

                xt::xmlFreeDoc(doc.cast());
            }

            let d1 = hp::htmlNewDoc(null(), null());
            let d2 = hp::htmlNewDocNoDtD(null(), null());
            if !d1.is_null() {
                xt::xmlFreeDoc(d1.cast());
            }
            if !d2.is_null() {
                xt::xmlFreeDoc(d2.cast());
            }

            let errp = xe::xmlGetLastError();
            last_err = if errp.is_null() { 0 } else { (*errp).code };

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, tag_hit);
            iter_digest = fold(iter_digest, ent_hit);
            iter_digest = fold(iter_digest, ent_v_hit);
            iter_digest = fold(iter_digest, bool_hit);
            iter_digest = fold(iter_digest, script_hit);
            iter_digest = fold(iter_digest, parse_ok);
            iter_digest = fold(iter_digest, meta_found);
            iter_digest = fold(iter_digest, meta_set);
            iter_digest = fold(iter_digest, out_len as u64);
            iter_digest = fold(iter_digest, out_sum);
            iter_digest = fold(iter_digest, out_len2 as u64);
            iter_digest = fold(iter_digest, out_sum2);
            iter_digest = fold(iter_digest, input_sum);
            iter_digest = fold(iter_digest, last_err as u32 as u64);
            digest = fold(digest, iter_digest);

            xe::xmlResetLastError();
        }
    }

    format!("op=html_parse_dump err={} digest={:016x}", last_err, digest)
}

pub fn op_html_push_parse(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let chunk_size = 257usize;
    let mut digest = 0u64;
    let mut last_err = 0i32;
    let first_len = data.len().min(chunk_size);

    for _ in 0..iters {
        unsafe {
            let first_ptr = if first_len == 0 {
                null()
            } else {
                data.as_ptr() as *const c_char
            };

            let ctxt = hp::htmlCreatePushParserCtxt(
                null_mut(),
                null_mut(),
                first_ptr,
                bounded_i32_len(first_len),
                null(),
                0 as hp::xmlCharEncoding,
            );

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, (!ctxt.is_null()) as u64);

            last_err = 0;

            if !ctxt.is_null() {
                let mut pos = first_len;
                while pos < data.len() {
                    let n = (data.len() - pos).min(chunk_size);
                    let rc = hp::htmlParseChunk(
                        ctxt,
                        data[pos..].as_ptr() as *const c_char,
                        bounded_i32_len(n),
                        0,
                    );
                    iter_digest = fold(iter_digest, rc as u32 as u64);
                    pos += n;
                }

                let term_rc = hp::htmlParseChunk(ctxt, null(), 0, 1);
                iter_digest = fold(iter_digest, term_rc as u32 as u64);

                let consumed = enc::xmlByteConsumed(ctxt.cast()) as i64;
                iter_digest = fold(iter_digest, consumed as u64);

                let errp = xe::xmlCtxtGetLastError(ctxt.cast());
                last_err = if errp.is_null() { 0 } else { (*errp).code };
                iter_digest = fold(iter_digest, last_err as u32 as u64);

                hp::htmlFreeParserCtxt(ctxt);
            }

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=html_push_parse err={} digest={:016x}", last_err, digest)
}

pub fn op_html_entity_encode(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let in_len = bounded_i32_len(data.len());
    let work = &data[..in_len as usize];
    let cap = work.len().saturating_mul(8).saturating_add(64).max(64);

    let mut digest = 0u64;
    let mut last_rc1 = 0i32;
    let mut last_rc2 = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut out1 = vec![0u8; cap];
            let mut out2 = vec![0u8; cap];

            let mut outlen1 = bounded_i32_len(cap);
            let mut inlen1 = in_len;
            last_rc1 = hp::htmlEncodeEntities(
                out1.as_mut_ptr(),
                &mut outlen1,
                work.as_ptr(),
                &mut inlen1,
                b'"' as c_int,
            );

            let prod1 = sane_len_i32(outlen1, out1.len());
            let cons1 = sane_len_i32(inlen1, work.len());
            let sum1 = checksum(&out1[..prod1]);

            let mut outlen2 = bounded_i32_len(cap);
            let mut inlen2 = in_len;
            last_rc2 = hp::UTF8ToHtml(
                out2.as_mut_ptr(),
                &mut outlen2,
                work.as_ptr(),
                &mut inlen2,
            );

            let prod2 = sane_len_i32(outlen2, out2.len());
            let cons2 = sane_len_i32(inlen2, work.len());
            let sum2 = checksum(&out2[..prod2]);

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, last_rc1 as u32 as u64);
            iter_digest = fold(iter_digest, cons1 as u64);
            iter_digest = fold(iter_digest, prod1 as u64);
            iter_digest = fold(iter_digest, sum1);
            iter_digest = fold(iter_digest, last_rc2 as u32 as u64);
            iter_digest = fold(iter_digest, cons2 as u64);
            iter_digest = fold(iter_digest, prod2 as u64);
            iter_digest = fold(iter_digest, sum2);
            iter_digest = fold(iter_digest, input_sum);

            digest = fold(digest, iter_digest);
        }
    }

    format!(
        "op=html_entity_encode rc1={} rc2={} digest={:016x}",
        last_rc1, last_rc2, digest
    )
}

pub fn op_uri_roundtrip(data: &[u8], iters: u64) -> String {
