fn small_html_seed_two() -> Vec<u8> {
    let mut s = String::new();
    s.push_str("<!DOCTYPE html>\n<html><head><meta charset=\"ISO-8859-1\"><title>Seed Two</title>");
    s.push_str("<meta http-equiv=\"Content-Type\" content=\"text/html; charset=ISO-8859-1\">");
    s.push_str("</head><body><form><input disabled checked name=x value=\"café\"></form>");
    s.push_str("<script data-src=\"a<b&&c>0\">var x='&not-an-entity;';</script>");
    s.push_str("<table><tr><th>A</th><th>B</th></tr>");
    for i in 0..10u32 {
        s.push_str(&format!(
            "<tr><td>{}</td><td>δοκιμή {}</td></tr>",
            i * 7,
            i
        ));
    }
    s.push_str("</table></body></html>\n");
    s.into_bytes()
}

fn large_html_document() -> Vec<u8> {
    let mut s = String::new();
    s.push_str("<!DOCTYPE html>\n<html>\n<head>\n");
    s.push_str("<meta charset=\"UTF-8\">\n");
    s.push_str("<title>Large Deterministic HTML</title>\n");
    s.push_str("<meta name=\"generator\" content=\"libxml2_raw_harness\">\n");
    s.push_str("<style>body{font-family:sans-serif}.card{border:1px solid #ccc;margin:4px;padding:4px}</style>\n");
    s.push_str("</head>\n<body>\n<main>\n");
    for i in 0..12000u32 {
        s.push_str(&format!(
            "<section class=\"card\" id=\"card-{}\" data-kind=\"item\">\
             <h2>Item {}</h2><p>café résumé naïve Пример 你好 &amp; more</p><ul>",
            i, i
        ));
        for j in 0..4u32 {
            s.push_str(&format!(
                "<li data-j=\"{}\"><a href=\"/products/{}/{}?ref=seed&amp;lang=en#frag{}\">Link {}-{}</a></li>",
                j, i, j, j, i, j
            ));
        }
        s.push_str("</ul></section>\n");
    }
    s.push_str("</main>\n</body>\n</html>\n");
    s.into_bytes()
}

