            "<tr><td>{}</td><td>δοκιμή {}</td></tr>",
            i * 7,
            i
        ));
    }
    s.push_str("<div id=\"root\"><a href=\"/r\">r</a><p>tail</p></div>");
    s.push_str("</table></body></html>\n");
    s.into_bytes()
}

