            if !uri_ptr.is_null() {
                let saved = xu::xmlSaveUri(uri_ptr);
                let (len, sum) = c_xml_len_and_checksum(saved as *const u8);
                iter_digest = fold(iter_digest, len as u64);
                iter_digest = fold(iter_digest, sum);
                if !saved.is_null() {
                    xm::xmlMemFree(saved.cast());
                }
                xu::xmlPrintURI(null_mut(), uri_ptr);
                xu::xmlFreeURI(uri_ptr);
            }

            let uri2 = xu::xmlParseURIRaw(ref_c.as_ptr() as *const c_char, 1);
            iter_digest = fold(iter_digest, (!uri2.is_null()) as u64);
            if !uri2.is_null() {
                let refuri = xu::xmlCreateURI();
                iter_digest = fold(iter_digest, (!refuri.is_null()) as u64);
                if !refuri.is_null() {
                    let pr = xu::xmlParseURIReference(refuri, ref_c.as_ptr() as *const c_char);
                    iter_digest = fold(iter_digest, pr as u32 as u64);
                    let saved2 = xu::xmlSaveUri(refuri);
                    let (l2, s2) = c_xml_len_and_checksum(saved2 as *const u8);
                    iter_digest = fold(iter_digest, l2 as u64);
                    iter_digest = fold(iter_digest, s2);
                    if !saved2.is_null() {
                        xm::xmlMemFree(saved2.cast());
                    }
                    xu::xmlFreeURI(refuri);
                } else {
                    iter_digest = fold(iter_digest, 0);
                    iter_digest = fold(iter_digest, 0);
                    iter_digest = fold(iter_digest, 0);
                }
                xu::xmlFreeURI(uri2);
            } else {
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
            }

            let escaped = xu::xmlURIEscapeStr(ref_c.as_ptr(), null());
            let (elen, esum) = c_xml_len_and_checksum(escaped as *const u8);
            iter_digest = fold(iter_digest, (!escaped.is_null()) as u64);
            iter_digest = fold(iter_digest, elen as u64);
            iter_digest = fold(iter_digest, esum);
            if !escaped.is_null() {
                xm::xmlMemFree(escaped.cast());
            }

            let escaped2 = xu::xmlURIEscape(ref_c.as_ptr());
            let (elen2, esum2) = c_xml_len_and_checksum(escaped2 as *const u8);
            iter_digest = fold(iter_digest, (!escaped2.is_null()) as u64);
            iter_digest = fold(iter_digest, elen2 as u64);
            iter_digest = fold(iter_digest, esum2);
            if !escaped2.is_null() {
                xm::xmlMemFree(escaped2.cast());
            }

            let built = xu::xmlBuildURI(ref_c.as_ptr(), base_c.as_ptr());
            let (blen, bsum) = c_xml_len_and_checksum(built as *const u8);
            iter_digest = fold(iter_digest, (!built.is_null()) as u64);
            iter_digest = fold(iter_digest, blen as u64);
            iter_digest = fold(iter_digest, bsum);
            if !built.is_null() {
                xm::xmlMemFree(built.cast());
            }

            let rel = xu::xmlBuildRelativeURI(ref_c.as_ptr(), base_c.as_ptr());
            let (rlen, rsum) = c_xml_len_and_checksum(rel as *const u8);
            iter_digest = fold(iter_digest, (!rel.is_null()) as u64);
            iter_digest = fold(iter_digest, rlen as u64);
            iter_digest = fold(iter_digest, rsum);
            if !rel.is_null() {
                xm::xmlMemFree(rel.cast());
            }

            let nrc = xu::xmlNormalizeURIPath(norm.as_mut_ptr() as *mut c_char);
            iter_digest = fold(iter_digest, nrc as u32 as u64);

            let unesc = xu::xmlURIUnescapeString(
                ref_c.as_ptr() as *const c_char,
                bounded_i32_len(first.len()),
                null_mut(),
            );
            let (ulen, usum) = c_xml_len_and_checksum(unesc as *const u8);
            iter_digest = fold(iter_digest, (!unesc.is_null()) as u64);
            iter_digest = fold(iter_digest, ulen as u64);
            iter_digest = fold(iter_digest, usum);
            if !unesc.is_null() {
                xm::xmlMemFree(unesc.cast());
            }

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!(
        "op=uri_roundtrip parse_ok={} digest={:016x}",
        parse_ok_last, digest
    )
}

pub fn op_encoding_suite(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let work_len = bounded_i32_len(data.len());
    let work = &data[..work_len as usize];
    let cap = work.len().saturating_mul(8).saturating_add(64).max(64);

    let a1 = b"latin1\0";
    let a2 = b"harness-latin1\0";
    let p1 = b"UTF-8\0";
    let p2 = b"ISO-8859-1\0";

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            enc::xmlInitCharEncodingHandlers();
            let mut iter_digest = 0u64;

            let det = enc::xmlDetectCharEncoding(work.as_ptr(), work_len);
            iter_digest = fold(iter_digest, det as u32 as u64);

            let pe1 = enc::xmlParseCharEncoding(p1.as_ptr() as *const c_char);
            let pe2 = enc::xmlParseCharEncoding(p2.as_ptr() as *const c_char);
            iter_digest = fold(iter_digest, pe1 as u32 as u64);
            iter_digest = fold(iter_digest, pe2 as u32 as u64);

            let n1 = enc::xmlGetCharEncodingName(pe1);
            let n2 = enc::xmlGetCharEncodingName(pe2);
            let (_, s1) = c_xml_len_and_checksum(n1 as *const u8);
            let (_, s2) = c_xml_len_and_checksum(n2 as *const u8);
            iter_digest = fold(iter_digest, s1);
            iter_digest = fold(iter_digest, s2);

            let add_rc = enc::xmlAddEncodingAlias(
                a1.as_ptr() as *const c_char,
                a2.as_ptr() as *const c_char,
            );
            iter_digest = fold(iter_digest, add_rc as u32 as u64);
            let got = enc::xmlGetEncodingAlias(a2.as_ptr() as *const c_char);
            let (_, gsum) = c_xml_len_and_checksum(got as *const u8);
            iter_digest = fold(iter_digest, (!got.is_null()) as u64);
            iter_digest = fold(iter_digest, gsum);
            let del_rc = enc::xmlDelEncodingAlias(a2.as_ptr() as *const c_char);
            iter_digest = fold(iter_digest, del_rc as u32 as u64);
            enc::xmlCleanupEncodingAliases();

            let mut out1 = vec![0u8; cap];
            let mut outlen1 = bounded_i32_len(cap);
            let mut inlen1 = work_len;
            last_rc = enc::isolat1ToUTF8(out1.as_mut_ptr(), &mut outlen1, work.as_ptr(), &mut inlen1);
            iter_digest = fold(iter_digest, last_rc as u32 as u64);
            iter_digest = fold(iter_digest, sane_len_i32(outlen1, out1.len()) as u64);
            iter_digest = fold(iter_digest, sane_len_i32(inlen1, work.len()) as u64);

            let mut out2 = vec![0u8; cap];
            let mut outlen2 = bounded_i32_len(cap);
            let mut inlen2 = work_len;
            let rc2 = enc::UTF8Toisolat1(out2.as_mut_ptr(), &mut outlen2, work.as_ptr(), &mut inlen2);
            iter_digest = fold(iter_digest, rc2 as u32 as u64);
            iter_digest = fold(iter_digest, sane_len_i32(outlen2, out2.len()) as u64);
            iter_digest = fold(iter_digest, sane_len_i32(inlen2, work.len()) as u64);

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=encoding_suite rc={} digest={:016x}", last_rc, digest)
}

pub fn op_entities_tree_valid(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);

    let qname = b"ns:tag\0";
    let prefix = b"ns\0";
    let local = b"tag\0";
    let amp = b"amp\0";
    let ent_name = b"h_entity\0";
    let ent_content = b"value & more\0";

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let doc = hp::htmlParseDoc(input_c.as_ptr(), null());
            iter_digest = fold(iter_digest, (!doc.is_null()) as u64);

            let vq = xt::xmlValidateQName(qname.as_ptr(), 0);
            let vn = xt::xmlValidateName(qname.as_ptr(), 0);
            let vnc = xt::xmlValidateNCName(local.as_ptr(), 0);
            let vnm = xt::xmlValidateNMToken(qname.as_ptr(), 0);
            iter_digest = fold(iter_digest, vq as u32 as u64);
            iter_digest = fold(iter_digest, vn as u32 as u64);
            iter_digest = fold(iter_digest, vnc as u32 as u64);
            iter_digest = fold(iter_digest, vnm as u32 as u64);

            let mut pre = null_mut();
            let split2 = xt::xmlSplitQName2(qname.as_ptr(), &mut pre);
            let mut split3_len = 0i32;
            let split3 = xt::xmlSplitQName3(qname.as_ptr(), &mut split3_len);
            let built = xt::xmlBuildQName(local.as_ptr(), prefix.as_ptr(), null_mut(), 0);
            let (_, s_pre) = c_xml_len_and_checksum(pre as *const u8);
            let (_, s_s2) = c_xml_len_and_checksum(split2 as *const u8);
            let (_, s_s3) = c_xml_len_and_checksum(split3 as *const u8);
            let (_, s_bq) = c_xml_len_and_checksum(built as *const u8);
            iter_digest = fold(iter_digest, s_pre);
            iter_digest = fold(iter_digest, s_s2);
            iter_digest = fold(iter_digest, split3_len as u32 as u64);
            iter_digest = fold(iter_digest, s_s3);
            iter_digest = fold(iter_digest, s_bq);
            if !pre.is_null() {
                xm::xmlMemFree(pre.cast());
            }
            if !split2.is_null() {
                xm::xmlMemFree(split2.cast());
            }
            if !built.is_null() {
                xm::xmlMemFree(built.cast());
            }

            let predef = xe2::xmlGetPredefinedEntity(amp.as_ptr());
            iter_digest = fold(iter_digest, (!predef.is_null()) as u64);

            let ec1 = xv::xmlNewElementContent(local.as_ptr(), 1 as xv::xmlElementContentType);
            iter_digest = fold(iter_digest, (!ec1.is_null()) as u64);
            if !ec1.is_null() {
                let ec2 = xv::xmlCopyElementContent(ec1);
                iter_digest = fold(iter_digest, (!ec2.is_null()) as u64);
                let mut buf1 = [0i8; 128];
                let mut buf2 = [0i8; 128];
                xv::xmlSprintfElementContent(buf1.as_mut_ptr(), ec1, 1);
                xv::xmlSnprintfElementContent(buf2.as_mut_ptr(), 128, ec1, 0);
                let (_, b1s) = c_xml_len_and_checksum(buf1.as_ptr() as *const u8);
                let (_, b2s) = c_xml_len_and_checksum(buf2.as_ptr() as *const u8);
                iter_digest = fold(iter_digest, b1s);
                iter_digest = fold(iter_digest, b2s);
                if !ec2.is_null() {
                    xv::xmlFreeElementContent(ec2);
                }
                xv::xmlFreeElementContent(ec1);
            }

            if !doc.is_null() {
                let a1 = xe2::xmlAddDocEntity(
                    doc as *mut _,
                    ent_name.as_ptr(),
                    1,
                    null(),
                    null(),
                    ent_content.as_ptr(),
                );
                let a2 = xe2::xmlAddDtdEntity(
                    doc as *mut _,
                    ent_name.as_ptr(),
                    1,
                    null(),
                    null(),
                    ent_content.as_ptr(),
                );
                let g1 = xe2::xmlGetDocEntity(doc as *const _, ent_name.as_ptr());
                let g2 = xe2::xmlGetDtdEntity(doc as *mut _, ent_name.as_ptr());
                let g3 = xe2::xmlGetParameterEntity(doc as *mut _, ent_name.as_ptr());
                iter_digest = fold(iter_digest, (!a1.is_null()) as u64);
                iter_digest = fold(iter_digest, (!a2.is_null()) as u64);
                iter_digest = fold(iter_digest, (!g1.is_null()) as u64);
                iter_digest = fold(iter_digest, (!g2.is_null()) as u64);
                iter_digest = fold(iter_digest, (!g3.is_null()) as u64);

                let e0 = xe2::xmlNewEntity(
                    doc as *mut _,
                    b"h_new\0".as_ptr(),
                    1,
                    null(),
                    null(),
                    ent_content.as_ptr(),
                );
                iter_digest = fold(iter_digest, (!e0.is_null()) as u64);
                if !e0.is_null() {
                    xe2::xmlFreeEntity(e0);
                }

                let e1 = xe2::xmlEncodeAttributeEntities(doc as *mut _, input_c.as_ptr());
                let e2 = xe2::xmlEncodeEntitiesReentrant(doc as *mut _, input_c.as_ptr());
                let e3 = xe2::xmlEncodeSpecialChars(doc as *const _, input_c.as_ptr());
                let (l1, s1) = c_xml_len_and_checksum(e1 as *const u8);
                let (l2, s2) = c_xml_len_and_checksum(e2 as *const u8);
                let (l3, s3) = c_xml_len_and_checksum(e3 as *const u8);
                iter_digest = fold(iter_digest, l1 as u64);
                iter_digest = fold(iter_digest, s1);
                iter_digest = fold(iter_digest, l2 as u64);
                iter_digest = fold(iter_digest, s2);
                iter_digest = fold(iter_digest, l3 as u64);
                iter_digest = fold(iter_digest, s3);
                if !e1.is_null() {
                    xm::xmlMemFree(e1.cast());
                }
                if !e2.is_null() {
                    xm::xmlMemFree(e2.cast());
                }
                if !e3.is_null() {
                    xm::xmlMemFree(e3.cast());
                }

                let vctxt = xv::xmlNewValidCtxt();
                iter_digest = fold(iter_digest, (!vctxt.is_null()) as u64);
                if !vctxt.is_null() {
                    let model_rc = xv::xmlValidBuildContentModel(vctxt, null_mut());
                    iter_digest = fold(iter_digest, model_rc as u32 as u64);
                    xv::xmlFreeValidCtxt(vctxt);
                }

                xt::xmlFreeDoc(doc.cast());
            }

            last_rc = 0;
            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=entities_tree_valid rc={} digest={:016x}", last_rc, digest)
}

pub fn op_globals_threads_memory(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let n = data.len().max(1).min(4096);
    let dup_src = bytes_with_nul(&data[..n.min(data.len())]);

    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            xg::xmlInitGlobals();
            xg::xmlInitGlobalsInternal();
            let gs = xg::xmlGetGlobalState();
            iter_digest = fold(iter_digest, (!gs.is_null()) as u64);
            if !gs.is_null() {
                xg::xmlInitializeGlobalState(gs);
            }
            iter_digest = fold(iter_digest, xg::xmlIsMainThread() as u32 as u64);
            iter_digest = fold(iter_digest, (!xg::__xmlStructuredErrorContext().is_null()) as u64);
            iter_digest = fold(iter_digest, (!xg::__xmlStructuredError().is_null()) as u64);
            iter_digest = fold(iter_digest, (!xg::__xmlLastError().is_null()) as u64);
            iter_digest = fold(iter_digest, (!xg::__xmlGenericError().is_null()) as u64);

            let tid = xth::xmlGetThreadId();
            iter_digest = fold(iter_digest, (tid != 0) as u64);

            let m = xth::xmlNewMutex();
            iter_digest = fold(iter_digest, (!m.is_null()) as u64);
            if !m.is_null() {
                xth::xmlMutexLock(m);
                xth::xmlMutexUnlock(m);
                xth::xmlCleanupMutex(m);
                xth::xmlFreeMutex(m);
            }

            let rm = xth::xmlNewRMutex();
            iter_digest = fold(iter_digest, (!rm.is_null()) as u64);
            if !rm.is_null() {
                xth::xmlRMutexLock(rm);
                xth::xmlRMutexUnlock(rm);
                xth::xmlFreeRMutex(rm);
            }

            let p = xm::xmlMemMalloc(n);
            iter_digest = fold(iter_digest, (!p.is_null()) as u64);
            if !p.is_null() {
                let ms = xm::xmlMemSize(p);
                iter_digest = fold(iter_digest, ms as u64);
                let p2 = xm::xmlMemRealloc(p, n.saturating_mul(2));
                iter_digest = fold(iter_digest, (!p2.is_null()) as u64);
                if !p2.is_null() {
                    xm::xmlMemFree(p2);
                } else {
                    xm::xmlMemFree(p);
                }
            }

            let p3 = xm::xmlMallocLoc(n, b"h.rs\0".as_ptr() as *const c_char, 7);
            iter_digest = fold(iter_digest, (!p3.is_null()) as u64);
            if !p3.is_null() {
                let p4 = xm::xmlReallocLoc(p3, n.saturating_mul(2), b"h.rs\0".as_ptr() as *const c_char, 8);
                iter_digest = fold(iter_digest, (!p4.is_null()) as u64);
                if !p4.is_null() {
                    xm::xmlMemFree(p4);
                } else {
                    xm::xmlMemFree(p3);
                }
            }

            let p5 = xm::xmlMallocAtomicLoc(n, b"h.rs\0".as_ptr() as *const c_char, 9);
            iter_digest = fold(iter_digest, (!p5.is_null()) as u64);
            if !p5.is_null() {
                xm::xmlMemFree(p5);
            }

            let d = xm::xmlMemoryStrdup(dup_src.as_ptr() as *const c_char);
            let (dlen, dsum) = c_xml_len_and_checksum(d as *const u8);
            iter_digest = fold(iter_digest, (!d.is_null()) as u64);
            iter_digest = fold(iter_digest, dlen as u64);
            iter_digest = fold(iter_digest, dsum);
            if !d.is_null() {
                xm::xmlMemFree(d.cast());
            }

            let d2 = xm::xmlMemStrdupLoc(
                dup_src.as_ptr() as *const c_char,
                b"h.rs\0".as_ptr() as *const c_char,
                10,
            );
            let (d2len, d2sum) = c_xml_len_and_checksum(d2 as *const u8);
            iter_digest = fold(iter_digest, (!d2.is_null()) as u64);
            iter_digest = fold(iter_digest, d2len as u64);
            iter_digest = fold(iter_digest, d2sum);
            if !d2.is_null() {
                xm::xmlMemFree(d2.cast());
            }

            xm::xmlMallocBreakpoint();
            iter_digest = fold(iter_digest, xm::xmlMemUsed() as u32 as u64);

            xg::xmlCleanupGlobalsInternal();
            xg::xmlCleanupGlobals();

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=globals_threads_memory digest={:016x}", digest)
}

pub fn op_regexp_pattern(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let (pat_bytes, text_opt) = split_once_newline(data);
    let text_bytes = text_opt.unwrap_or(data);

    let pat_c = bytes_with_nul(pat_bytes);
    let text_c = bytes_with_nul(text_bytes);
    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let re = xre::xmlRegexpCompile(pat_c.as_ptr());
            iter_digest = fold(iter_digest, (!re.is_null()) as u64);
            if !re.is_null() {
                let det = xre::xmlRegexpIsDeterminist(re);
                let rc = xre::xmlRegexpExec(re, text_c.as_ptr());
                iter_digest = fold(iter_digest, det as u32 as u64);
                iter_digest = fold(iter_digest, rc as u32 as u64);
                last_rc = rc;

                let exec = xre::xmlRegNewExecCtxt(re, None, null_mut());
                iter_digest = fold(iter_digest, (!exec.is_null()) as u64);
                if !exec.is_null() {
                    let p1 = xre::xmlRegExecPushString(exec, text_c.as_ptr(), null_mut());
                    let p2 = xre::xmlRegExecPushString2(exec, text_c.as_ptr(), pat_c.as_ptr(), null_mut());
                    let mut nbval = 0;
                    let mut nbneg = 0;
                    let mut values = null_mut();
                    let mut term = 0;
                    let nx = xre::xmlRegExecNextValues(exec, &mut nbval, &mut nbneg, &mut values, &mut term);
                    let mut errstr = null();
                    let ei = xre::xmlRegExecErrInfo(exec, &mut errstr, &mut nbval, &mut nbneg, &mut values, &mut term);
                    iter_digest = fold(iter_digest, p1 as u32 as u64);
                    iter_digest = fold(iter_digest, p2 as u32 as u64);
                    iter_digest = fold(iter_digest, nx as u32 as u64);
                    iter_digest = fold(iter_digest, ei as u32 as u64);
                    iter_digest = fold(iter_digest, nbval as u32 as u64);
                    iter_digest = fold(iter_digest, nbneg as u32 as u64);
                    iter_digest = fold(iter_digest, term as u32 as u64);
                    let (_, esum) = c_xml_len_and_checksum(errstr as *const u8);
                    iter_digest = fold(iter_digest, esum);
                    xre::xmlRegFreeExecCtxt(exec);
                }

                let f = tmpfile();
                iter_digest = fold(iter_digest, (!f.is_null()) as u64);
                if !f.is_null() {
                    xre::xmlRegexpPrint(f as *mut _, re);
                    fflush(f);
                    fclose(f);
                }

                xre::xmlRegFreeRegexp(re);
            }

            let p = xpat::xmlPatterncompile(pat_c.as_ptr(), null_mut(), 0, null_mut());
            iter_digest = fold(iter_digest, (!p.is_null()) as u64);
            if !p.is_null() {
                let sc = xpat::xmlPatternGetStreamCtxt(p);
                iter_digest = fold(iter_digest, (!sc.is_null()) as u64);
                if !sc.is_null() {
                    let w = xpat::xmlStreamWantsAnyNode(sc);
                    let sp1 = xpat::xmlStreamPush(sc, b"root\0".as_ptr(), null());
                    let sp2 = xpat::xmlStreamPushAttr(sc, b"id\0".as_ptr(), null());
                    let sp3 = xpat::xmlStreamPushNode(sc, b"item\0".as_ptr(), null(), 1);
                    let sp4 = xpat::xmlStreamPop(sc);
                    iter_digest = fold(iter_digest, w as u32 as u64);
                    iter_digest = fold(iter_digest, sp1 as u32 as u64);
                    iter_digest = fold(iter_digest, sp2 as u32 as u64);
                    iter_digest = fold(iter_digest, sp3 as u32 as u64);
                    iter_digest = fold(iter_digest, sp4 as u32 as u64);
                    xpat::xmlFreeStreamCtxt(sc);
                }
                xpat::xmlFreePatternList(p);
            }

            xxp::xmlXPathInit();
            xxp::xmlInitXPathInternal();
            iter_digest = fold(iter_digest, xxp::xmlXPathIsNaN(f64::NAN) as u32 as u64);
            iter_digest = fold(iter_digest, xxp::xmlXPathIsInf(f64::INFINITY) as u32 as u64);

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=regexp_pattern rc={} digest={:016x}", last_rc, digest)
}

pub fn op_schema_suite(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let rinit = xrg::xmlRelaxNGInitTypes();
            iter_digest = fold(iter_digest, rinit as u32 as u64);
            let rctxt = xrg::xmlRelaxNGNewMemParserCtxt(
                input_c.as_ptr() as *const c_char,
                bounded_i32_len(data.len()),
            );
            iter_digest = fold(iter_digest, (!rctxt.is_null()) as u64);
            if !rctxt.is_null() {
                let fr = xrg::xmlRelaxParserSetFlag(rctxt, 0);
                iter_digest = fold(iter_digest, fr as u32 as u64);
                xrg::xmlRelaxNGSetParserErrors(rctxt, None, None, null_mut());
                let mut e = None;
                let mut w = None;
                let mut ctx = null_mut();
                let gr = xrg::xmlRelaxNGGetParserErrors(rctxt, &mut e, &mut w, &mut ctx);
                iter_digest = fold(iter_digest, gr as u32 as u64);
                let schema = xrg::xmlRelaxNGParse(rctxt);
                iter_digest = fold(iter_digest, (!schema.is_null()) as u64);
                if !schema.is_null() {
                    xrg::xmlRelaxNGFree(schema);
                }
                xrg::xmlRelaxNGFreeParserCtxt(rctxt);
            }

            let rdoc = hp::htmlParseDoc(input_c.as_ptr(), null());
            iter_digest = fold(iter_digest, (!rdoc.is_null()) as u64);
            if !rdoc.is_null() {
                let rp = xrg::xmlRelaxNGNewDocParserCtxt(rdoc as *mut _);
                iter_digest = fold(iter_digest, (!rp.is_null()) as u64);
                if !rp.is_null() {
                    let sch = xrg::xmlRelaxNGParse(rp);
                    iter_digest = fold(iter_digest, (!sch.is_null()) as u64);
                    if !sch.is_null() {
                        xrg::xmlRelaxNGFree(sch);
                    }
                    xrg::xmlRelaxNGFreeParserCtxt(rp);
                }
                xt::xmlFreeDoc(rdoc.cast());
            }

            xrg::xmlRelaxNGCleanupTypes();

            let sinit = xst::xmlSchemaInitTypes();
            iter_digest = fold(iter_digest, sinit as u32 as u64);
            let built = xst::xmlSchemaGetBuiltInType(1 as xst::xmlSchemaValType);
            iter_digest = fold(iter_digest, (!built.is_null()) as u64);
            if !built.is_null() {
                let bf = xst::xmlSchemaIsBuiltInTypeFacet(built, 0);
                iter_digest = fold(iter_digest, bf as u32 as u64);
            }

            let pctxt = xsd::xmlSchemaNewMemParserCtxt(
                input_c.as_ptr() as *const c_char,
                bounded_i32_len(data.len()),
            );
            iter_digest = fold(iter_digest, (!pctxt.is_null()) as u64);
            if !pctxt.is_null() {
                let facet = xsd::xmlSchemaNewFacet();
                iter_digest = fold(iter_digest, (!facet.is_null()) as u64);
                if !facet.is_null() {
                    let cfr = xsd::xmlSchemaCheckFacet(
                        facet,
                        built as *mut _,
                        pctxt,
                        b"name\0".as_ptr(),
                    );
                    iter_digest = fold(iter_digest, cfr as u32 as u64);
                    xsd::xmlSchemaFreeFacet(facet);
                }
                let sch = xsd::xmlSchemaParse(pctxt);
                iter_digest = fold(iter_digest, (!sch.is_null()) as u64);
                if !sch.is_null() {
                    let f = tmpfile();
                    iter_digest = fold(iter_digest, (!f.is_null()) as u64);
                    if !f.is_null() {
                        xsd::xmlSchemaDump(f as *mut _, sch);
                        fflush(f);
                        fclose(f);
                    }
                    xsd::xmlSchemaFree(sch);
                }
                xsd::xmlSchemaFreeParserCtxt(pctxt);
            }

            let sdoc = hp::htmlParseDoc(input_c.as_ptr(), null());
            iter_digest = fold(iter_digest, (!sdoc.is_null()) as u64);
            if !sdoc.is_null() {
                let sp = xsd::xmlSchemaNewDocParserCtxt(sdoc as *mut _);
                iter_digest = fold(iter_digest, (!sp.is_null()) as u64);
                if !sp.is_null() {
                    let sch = xsd::xmlSchemaParse(sp);
                    iter_digest = fold(iter_digest, (!sch.is_null()) as u64);
                    if !sch.is_null() {
                        xsd::xmlSchemaFree(sch);
                    }
                    xsd::xmlSchemaFreeParserCtxt(sp);
                }
                xt::xmlFreeDoc(sdoc.cast());
            }

            xst::xmlSchemaCleanupTypes();

            let sctxt = xsct::xmlSchematronNewMemParserCtxt(
                input_c.as_ptr() as *const c_char,
                bounded_i32_len(data.len()),
            );
            iter_digest = fold(iter_digest, (!sctxt.is_null()) as u64);
            if !sctxt.is_null() {
                let sch = xsct::xmlSchematronParse(sctxt);
                iter_digest = fold(iter_digest, (!sch.is_null()) as u64);
                if !sch.is_null() {
                    let vctxt = xsct::xmlSchematronNewValidCtxt(sch, 0);
                    iter_digest = fold(iter_digest, (!vctxt.is_null()) as u64);
                    if !vctxt.is_null() {
                        xsct::xmlSchematronSetValidStructuredErrors(vctxt, None, null_mut());
                        let doc = hp::htmlParseDoc(input_c.as_ptr(), null());
                        if !doc.is_null() {
                            last_rc = xsct::xmlSchematronValidateDoc(vctxt, doc as *mut _);
                            iter_digest = fold(iter_digest, last_rc as u32 as u64);
                            xt::xmlFreeDoc(doc.cast());
                        }
                        xsct::xmlSchematronFreeValidCtxt(vctxt);
                    }
                    xsct::xmlSchematronFree(sch);
                }
                xsct::xmlSchematronFreeParserCtxt(sctxt);
            }

            let sdoc2 = hp::htmlParseDoc(input_c.as_ptr(), null());
            iter_digest = fold(iter_digest, (!sdoc2.is_null()) as u64);
            if !sdoc2.is_null() {
                let p2 = xsct::xmlSchematronNewDocParserCtxt(sdoc2 as *mut _);
                iter_digest = fold(iter_digest, (!p2.is_null()) as u64);
                if !p2.is_null() {
                    let sch = xsct::xmlSchematronParse(p2);
                    iter_digest = fold(iter_digest, (!sch.is_null()) as u64);
                    if !sch.is_null() {
                        xsct::xmlSchematronFree(sch);
                    }
                    xsct::xmlSchematronFreeParserCtxt(p2);
                }
                xt::xmlFreeDoc(sdoc2.cast());
            }

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=schema_suite rc={} digest={:016x}", last_rc, digest)
}

pub fn op_buf_strings_chars(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);

    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let b = xb::xmlBufCreateSize(data.len().max(64));
            iter_digest = fold(iter_digest, (!b.is_null()) as u64);
            if !b.is_null() {
                let sch0 = xb::xmlBufGetAllocationScheme(b);
                let set_rc = xb::xmlBufSetAllocationScheme(b, 0 as xb::xmlBufferAllocationScheme);
                let grow_rc = xb::xmlBufGrow(b, bounded_i32_len(data.len().max(16)));
                let content = xb::xmlBufContent(b);
                let (_, csum) = c_xml_len_and_checksum(content as *const u8);
                iter_digest = fold(iter_digest, sch0 as u32 as u64);
                iter_digest = fold(iter_digest, set_rc as u32 as u64);
                iter_digest = fold(iter_digest, grow_rc as u32 as u64);
                iter_digest = fold(iter_digest, csum);
                let f = tmpfile();
                iter_digest = fold(iter_digest, (!f.is_null()) as u64);
                if !f.is_null() {
                    let dumped = xb::xmlBufDump(f as *mut _, b);
                    iter_digest = fold(iter_digest, dumped as u64);
                    fflush(f);
                    fclose(f);
                }
                let shr = xb::xmlBufShrink(b, (data.len() / 2) as usize);
                iter_digest = fold(iter_digest, shr as u64);
                let detached = xb::xmlBufDetach(b);
                let (dlen, dsum) = c_xml_len_and_checksum(detached as *const u8);
                iter_digest = fold(iter_digest, dlen as u64);
                iter_digest = fold(iter_digest, dsum);
                if !detached.is_null() {
                    xm::xmlMemFree(detached.cast());
                }
                xb::xmlBufEmpty(b);
                xb::xmlBufFree(b);
            }

            let b2 = xb::xmlBufCreate();
            iter_digest = fold(iter_digest, (!b2.is_null()) as u64);
            if !b2.is_null() {
                xb::xmlBufFree(b2);
            }

            let s1 = xs::xmlStrdup(input_c.as_ptr());
            let s2 = xs::xmlStrndup(input_c.as_ptr(), bounded_i32_len(data.len().min(32)));
            let s3 = xs::xmlCharStrdup(input_c.as_ptr() as *const c_char);
            let s4 = xs::xmlCharStrndup(
                input_c.as_ptr() as *const c_char,
                bounded_i32_len(data.len().min(32)),
            );
            iter_digest = fold(iter_digest, (!s1.is_null()) as u64);
            iter_digest = fold(iter_digest, (!s2.is_null()) as u64);
            iter_digest = fold(iter_digest, (!s3.is_null()) as u64);
            iter_digest = fold(iter_digest, (!s4.is_null()) as u64);
            iter_digest = fold(iter_digest, xs::xmlStrcmp(input_c.as_ptr(), input_c.as_ptr()) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrEqual(input_c.as_ptr(), input_c.as_ptr()) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrQEqual(b"ns\0".as_ptr(), b"x\0".as_ptr(), b"ns:x\0".as_ptr()) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrncmp(input_c.as_ptr(), input_c.as_ptr(), 4) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrcasecmp(b"AbC\0".as_ptr(), b"aBc\0".as_ptr()) as u32 as u64);
            iter_digest = fold(iter_digest, xs::xmlStrncasecmp(b"AbCd\0".as_ptr(), b"aBcE\0".as_ptr(), 3) as u32 as u64);
            if !s1.is_null() {
                xm::xmlMemFree(s1.cast());
            }
            if !s2.is_null() {
                xm::xmlMemFree(s2.cast());
            }
            if !s3.is_null() {
                xm::xmlMemFree(s3.cast());
            }
            if !s4.is_null() {
                xm::xmlMemFree(s4.cast());
            }

            for &b in data.iter().take(32) {
                let v = b as u32;
                iter_digest = fold(iter_digest, xc::xmlIsBaseChar(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsBlank(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsChar(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsCombining(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsDigit(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsExtender(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsIdeographic(v) as u32 as u64);
                iter_digest = fold(iter_digest, xc::xmlIsPubidChar(v) as u32 as u64);
            }

            let cps = [0x41, 0x627, 0x391, 0x30, 0x4e00, 0x2192];
            for &cp in &cps {
                iter_digest = fold(iter_digest, xucc::xmlUCSIsAegeanNumbers(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsAlphabeticPresentationForms(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArabic(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArabicPresentationFormsA(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArabicPresentationFormsB(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArmenian(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsArrows(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsBasicLatin(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsBengali(cp) as u32 as u64);
                iter_digest = fold(iter_digest, xucc::xmlUCSIsBlockElements(cp) as u32 as u64);
            }

            xt::xmlSetBufferAllocationScheme(0 as xt::xmlBufferAllocationScheme);
            iter_digest = fold(iter_digest, xt::xmlGetBufferAllocationScheme() as u32 as u64);

            let h = xh::xmlHashCreate(8);
            iter_digest = fold(iter_digest, (!h.is_null()) as u64);
            if !h.is_null() {
                let add1 = xh::xmlHashAddEntry(h, b"k1\0".as_ptr(), input_c.as_ptr() as *mut _);
                let add2 = xh::xmlHashAddEntry2(h, b"k2\0".as_ptr(), b"s2\0".as_ptr(), input_c.as_ptr() as *mut _);
                let add3 = xh::xmlHashAddEntry3(h, b"k3\0".as_ptr(), b"s3\0".as_ptr(), b"t3\0".as_ptr(), input_c.as_ptr() as *mut _);
                let up1 = xh::xmlHashUpdateEntry(h, b"k1\0".as_ptr(), input_c.as_ptr() as *mut _, None);
                let up2 = xh::xmlHashUpdateEntry2(h, b"k2\0".as_ptr(), b"s2\0".as_ptr(), input_c.as_ptr() as *mut _, None);
                let up3 = xh::xmlHashUpdateEntry3(h, b"k3\0".as_ptr(), b"s3\0".as_ptr(), b"t3\0".as_ptr(), input_c.as_ptr() as *mut _, None);
                let lk = xh::xmlHashLookup(h, b"k1\0".as_ptr());
                iter_digest = fold(iter_digest, add1 as u32 as u64);
                iter_digest = fold(iter_digest, add2 as u32 as u64);
                iter_digest = fold(iter_digest, add3 as u32 as u64);
                iter_digest = fold(iter_digest, up1 as u32 as u64);
                iter_digest = fold(iter_digest, up2 as u32 as u64);
                iter_digest = fold(iter_digest, up3 as u32 as u64);
                iter_digest = fold(iter_digest, (!lk.is_null()) as u64);
                xh::xmlHashFree(h, None);
            }

            let _ = xd::xmlInitializeDict();
            xd::xmlInitDictInternal();
            let d = xd::xmlDictCreate();
            iter_digest = fold(iter_digest, (!d.is_null()) as u64);
            if !d.is_null() {
                let d2 = xd::xmlDictCreateSub(d);
                iter_digest = fold(iter_digest, (!d2.is_null()) as u64);
                iter_digest = fold(iter_digest, xd::xmlDictReference(d) as u32 as u64);
                iter_digest = fold(iter_digest, xd::xmlDictSize(d) as u32 as u64);
                iter_digest = fold(iter_digest, xd::xmlDictSetLimit(d, 4096) as u64);
                iter_digest = fold(iter_digest, xd::xmlDictOwns(d, input_c.as_ptr()) as u32 as u64);

                let hd = xh::xmlHashCreateDict(8, d);
                iter_digest = fold(iter_digest, (!hd.is_null()) as u64);
                if !hd.is_null() {
                    xh::xmlHashFree(hd, None);
                }

                if !d2.is_null() {
                    xd::xmlDictFree(d2);
                }
                xd::xmlDictFree(d);
            }
            xd::xmlCleanupDictInternal();
            xd::xmlDictCleanup();

            xpi::xmlCheckVersion(20900);
            iter_digest = fold(iter_digest, xp::xmlCheckLanguageID(b"en-US\0".as_ptr()) as u32 as u64);
            let nsdb = xp::xmlParserNsCreate();
            iter_digest = fold(iter_digest, (!nsdb.is_null()) as u64);
            if !nsdb.is_null() {
                xp::xmlParserNsFree(nsdb);
            }
            iter_digest = fold(iter_digest, xpi::xmlIsLetter(b'A' as c_int) as u32 as u64);

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=buf_strings_chars digest={:016x}", digest)
}

pub fn op_writer_save(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);
    let out_path = temp_path("save", input_sum, "xml");

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let mut wdoc: xw::xmlDocPtr = null_mut();
            let writer = xw::xmlNewTextWriterDoc(&mut wdoc, 0);
            iter_digest = fold(iter_digest, (!writer.is_null()) as u64);
            if !writer.is_null() {
                let r1 = xw::xmlTextWriterStartDocument(writer, b"1.0\0".as_ptr() as *const c_char, b"UTF-8\0".as_ptr() as *const c_char, null());
                let r2 = xw::xmlTextWriterStartComment(writer);
                let r3 = xw::xmlTextWriterEndDocument(writer);
                iter_digest = fold(iter_digest, r1 as u32 as u64);
                iter_digest = fold(iter_digest, r2 as u32 as u64);
                iter_digest = fold(iter_digest, r3 as u32 as u64);
                xw::xmlFreeTextWriter(writer);
            }
            iter_digest = fold(iter_digest, (!wdoc.is_null()) as u64);
            if !wdoc.is_null() {
                xt::xmlFreeDoc(wdoc as *mut _);
            }

            if let Some(cpath) = cstring_from_path(&out_path) {
                let w2 = xw::xmlNewTextWriterFilename(cpath.as_ptr(), 0);
                iter_digest = fold(iter_digest, (!w2.is_null()) as u64);
                if !w2.is_null() {
                    let r1 = xw::xmlTextWriterStartDocument(w2, b"1.0\0".as_ptr() as *const c_char, b"UTF-8\0".as_ptr() as *const c_char, null());
                    let r2 = xw::xmlTextWriterEndDocument(w2);
                    iter_digest = fold(iter_digest, r1 as u32 as u64);
                    iter_digest = fold(iter_digest, r2 as u32 as u64);
                    xw::xmlFreeTextWriter(w2);
                }
            }

            let html_doc = hp::htmlParseDoc(input_c.as_ptr(), null());
            iter_digest = fold(iter_digest, (!html_doc.is_null()) as u64);
            if !html_doc.is_null() {
                if let Some(cpath) = cstring_from_path(&out_path) {
                    let sctxt = xsave::xmlSaveToFilename(cpath.as_ptr(), null(), 0);
                    iter_digest = fold(iter_digest, (!sctxt.is_null()) as u64);
                    if !sctxt.is_null() {
                        let e1 = xsave::xmlSaveSetEscape(sctxt, None);
                        let e2 = xsave::xmlSaveSetAttrEscape(sctxt, None);
                        let sd = xsave::xmlSaveDoc(sctxt, html_doc as *mut _);
                        let sf = xsave::xmlSaveFlush(sctxt);
                        let sc = xsave::xmlSaveClose(sctxt);
                        iter_digest = fold(iter_digest, e1 as u32 as u64);
                        iter_digest = fold(iter_digest, e2 as u32 as u64);
                        iter_digest = fold(iter_digest, sd as u64);
                        iter_digest = fold(iter_digest, sf as u32 as u64);
                        iter_digest = fold(iter_digest, sc as u32 as u64);
                    }
                }

                let fd_path = temp_path("savefd", input_sum, "html");
                let _ = fs::remove_file(&fd_path);
                if let Ok(file) = fs::File::create(&fd_path) {
                    let fd = file.as_raw_fd();
                    let sctxt2 = xsave::xmlSaveToFd(fd as c_int, null(), 0);
                    iter_digest = fold(iter_digest, (!sctxt2.is_null()) as u64);
                    if !sctxt2.is_null() {
                        let sd2 = xsave::xmlSaveDoc(sctxt2, html_doc as *mut _);
                        let sc2 = xsave::xmlSaveClose(sctxt2);
                        iter_digest = fold(iter_digest, sd2 as u64);
                        iter_digest = fold(iter_digest, sc2 as u32 as u64);
                        last_rc = sc2;
                    }
                    drop(file);
                    let _ = fs::remove_file(fd_path);
                }

                let node = first_doc_element(html_doc as *mut xt::xmlDoc);
                iter_digest = fold(iter_digest, (!node.is_null()) as u64);
                if !node.is_null() {
                    let f = tmpfile();
                    iter_digest = fold(iter_digest, (!f.is_null()) as u64);
                    if !f.is_null() {
                        ht::htmlNodeDumpFile(f as *mut _, html_doc as *mut _, node as *mut _);
                        let ndf = ht::htmlNodeDumpFileFormat(
                            f as *mut _,
                            html_doc as *mut _,
                            node as *mut _,
                            null(),
                            1,
                        );
                        iter_digest = fold(iter_digest, ndf as u32 as u64);
                        fflush(f);
                        fclose(f);
                    }
                    let wtree = xw::xmlNewTextWriterTree(html_doc as *mut _, node as *mut _, 0);
                    iter_digest = fold(iter_digest, (!wtree.is_null()) as u64);
                    if !wtree.is_null() {
                        let r1 = xw::xmlTextWriterStartDocument(wtree, b"1.0\0".as_ptr() as *const c_char, null(), null());
                        let r2 = xw::xmlTextWriterEndDocument(wtree);
                        iter_digest = fold(iter_digest, r1 as u32 as u64);
                        iter_digest = fold(iter_digest, r2 as u32 as u64);
                        xw::xmlFreeTextWriter(wtree);
                    }
                    let ns = xt::xmlNewNs(node as *mut _, b"http://example.com/ns\0".as_ptr(), b"ex\0".as_ptr());
                    iter_digest = fold(iter_digest, (!ns.is_null()) as u64);
                    if !ns.is_null() {
                        xt::xmlSetNs(node as *mut _, ns);
                    }
                }

                xt::xmlFreeDoc(html_doc.cast());
            }

            let win = xio::xmlNormalizeWindowsPath(b"C:\\tmp\\a\\..\\b\\file.xml\0".as_ptr());
            let (wlen, wsum) = c_xml_len_and_checksum(win as *const u8);
            iter_digest = fold(iter_digest, wlen as u64);
            iter_digest = fold(iter_digest, wsum);
            if !win.is_null() {
                xm::xmlMemFree(win.cast());
            }

            iter_digest = fold(iter_digest, xio::xmlCheckFilename(b".\0".as_ptr() as *const c_char) as u32 as u64);
            iter_digest = fold(iter_digest, xio::xmlFileMatch(b"file:///tmp/x.xml\0".as_ptr() as *const c_char) as u32 as u64);
            xio::__xmlIOErr(1, 1, b"io\0".as_ptr() as *const c_char);
            xio::__xmlLoaderErr(null_mut(), b"load\0".as_ptr() as *const c_char, b"f.xml\0".as_ptr() as *const c_char);
            iter_digest = fold(iter_digest, xio::xmlPopInputCallbacks() as u32 as u64);
            iter_digest = fold(iter_digest, xio::xmlPopOutputCallbacks() as u32 as u64);
            xio::xmlCleanupInputCallbacks();
            xio::xmlCleanupOutputCallbacks();

            let _ = fs::remove_file(&out_path);

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=writer_save rc={} digest={:016x}", last_rc, digest)
}

pub fn op_reader_debug_xinclude(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let input_c = bytes_with_nul(data);
    let in_path = temp_path("reader", input_sum, "html");
    let _ = fs::write(&in_path, data);
    let cpath = cstring_from_path(&in_path);

    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let doc = hp::htmlParseDoc(input_c.as_ptr(), null());
            iter_digest = fold(iter_digest, (!doc.is_null()) as u64);

            if let Some(ref cp) = cpath {
                let reader = xr::xmlNewTextReaderFilename(cp.as_ptr());
                iter_digest = fold(iter_digest, (!reader.is_null()) as u64);
                if !reader.is_null() {
                    for _ in 0..8 {
                        let rr = xr::xmlTextReaderRead(reader);
                        iter_digest = fold(iter_digest, rr as u32 as u64);
                        if rr <= 0 {
                            break;
                        }
                        let st = xr::xmlTextReaderReadState(reader);
                        iter_digest = fold(iter_digest, st as u32 as u64);
                        let exp = xr::xmlTextReaderExpand(reader);
                        iter_digest = fold(iter_digest, (!exp.is_null()) as u64);
                        let inner = xr::xmlTextReaderReadInnerXml(reader);
                        let outer = xr::xmlTextReaderReadOuterXml(reader);
                        let string = xr::xmlTextReaderReadString(reader);
                        let (l1, s1) = c_xml_len_and_checksum(inner as *const u8);
                        let (l2, s2) = c_xml_len_and_checksum(outer as *const u8);
                        let (l3, s3) = c_xml_len_and_checksum(string as *const u8);
                        iter_digest = fold(iter_digest, l1 as u64);
                        iter_digest = fold(iter_digest, s1);
                        iter_digest = fold(iter_digest, l2 as u64);
                        iter_digest = fold(iter_digest, s2);
                        iter_digest = fold(iter_digest, l3 as u64);
                        iter_digest = fold(iter_digest, s3);
                        if !inner.is_null() {
                            xm::xmlMemFree(inner.cast());
                        }
                        if !outer.is_null() {
                            xm::xmlMemFree(outer.cast());
                        }
                        if !string.is_null() {
                            xm::xmlMemFree(string.cast());
                        }
                        let nx = xr::xmlTextReaderNext(reader);
                        let sib = xr::xmlTextReaderNextSibling(reader);
                        iter_digest = fold(iter_digest, nx as u32 as u64);
                        iter_digest = fold(iter_digest, sib as u32 as u64);
                        break;
                    }
                    xr::xmlFreeTextReader(reader);
                }
            }

            if !doc.is_null() {
                let node = first_doc_element(doc as *mut xt::xmlDoc);
                iter_digest = fold(iter_digest, (!node.is_null()) as u64);

                let xh0 = xlk::xlinkGetDefaultHandler();
                xlk::xlinkSetDefaultHandler(xh0);
                let xd0 = xlk::xlinkGetDefaultDetect();
                xlk::xlinkSetDefaultDetect(xd0);
                iter_digest = fold(iter_digest, (!xh0.is_null()) as u64);
                iter_digest = fold(iter_digest, xd0.map(|_| 1u64).unwrap_or(0));

                if !node.is_null() {
                    let ac = hp::htmlAutoCloseTag(doc as *mut _, b"p\0".as_ptr(), node as *mut _);
                    let ia = hp::htmlIsAutoClosed(doc as *mut _, node as *mut _);
                    let xlrc = xlk::xlinkIsLink(doc as *mut _, node as *mut _);
                    iter_digest = fold(iter_digest, ac as u32 as u64);
                    iter_digest = fold(iter_digest, ia as u32 as u64);
                    iter_digest = fold(iter_digest, xlrc as u32 as u64);

                    let p = xpat::xmlPatterncompile(b"//*\0".as_ptr(), null_mut(), 0, null_mut());
                    iter_digest = fold(iter_digest, (!p.is_null()) as u64);
                    if !p.is_null() {
                        let pm = xpat::xmlPatternMatch(p, node as *mut _);
                        iter_digest = fold(iter_digest, pm as u32 as u64);
                        xpat::xmlFreePattern(p);
                    }

                    let f = tmpfile();
                    iter_digest = fold(iter_digest, (!f.is_null()) as u64);
                    if !f.is_null() {
                        xdbg::xmlDebugDumpString(f as *mut _, input_c.as_ptr());
                        xdbg::xmlDebugDumpOneNode(f as *mut _, node as *mut _, 1);
                        xdbg::xmlDebugDumpNode(f as *mut _, node as *mut _, 1);
                        xdbg::xmlDebugDumpNodeList(f as *mut _, node as *mut _, 1);
                        xdbg::xmlDebugDumpEntities(f as *mut _, doc as *mut _);
                        xdbg::xmlDebugDumpDocumentHead(f as *mut _, doc as *mut _);
                        xdbg::xmlDebugDumpDocument(f as *mut _, doc as *mut _);
                        let chk = xdbg::xmlDebugCheckDocument(f as *mut _, doc as *mut _);
                        iter_digest = fold(iter_digest, chk as u32 as u64);
                        fflush(f);
                        fclose(f);
                    }

                    let xi = xinc::xmlXIncludeNewContext(doc as *mut _);
                    iter_digest = fold(iter_digest, (!xi.is_null()) as u64);
                    if !xi.is_null() {
                        let s1 = xinc::xmlXIncludeSetFlags(xi, 0);
                        let s2 = xinc::xmlXIncludeSetStreamingMode(xi, 0);
                        let p1 = xinc::xmlXIncludeProcessNode(xi, node as *mut _);
                        iter_digest = fold(iter_digest, s1 as u32 as u64);
                        iter_digest = fold(iter_digest, s2 as u32 as u64);
                        iter_digest = fold(iter_digest, p1 as u32 as u64);
                        xinc::xmlXIncludeFreeContext(xi);
                    }

                    let p2 = xinc::xmlXIncludeProcessTree(node as *mut _);
                    let p3 = xinc::xmlXIncludeProcessTreeFlags(node as *mut _, 0);
                    let p4 = xinc::xmlXIncludeProcessTreeFlagsData(node as *mut _, 0, null_mut());
                    iter_digest = fold(iter_digest, p2 as u32 as u64);
                    iter_digest = fold(iter_digest, p3 as u32 as u64);
                    iter_digest = fold(iter_digest, p4 as u32 as u64);
                }

                let p5 = xinc::xmlXIncludeProcess(doc as *mut _);
                let p6 = xinc::xmlXIncludeProcessFlags(doc as *mut _, 0);
                let p7 = xinc::xmlXIncludeProcessFlagsData(doc as *mut _, 0, null_mut());
                iter_digest = fold(iter_digest, p5 as u32 as u64);
                iter_digest = fold(iter_digest, p6 as u32 as u64);
                iter_digest = fold(iter_digest, p7 as u32 as u64);

                let mut out = null_mut();
                let c14n = xc14n::xmlC14NDocDumpMemory(doc as *mut _, null_mut(), 0, null_mut(), 1, &mut out);
                iter_digest = fold(iter_digest, c14n as u32 as u64);
                let (olen, osum) = c_xml_len_and_checksum(out as *const u8);
                iter_digest = fold(iter_digest, olen as u64);
                iter_digest = fold(iter_digest, osum);
                if !out.is_null() {
                    xm::xmlMemFree(out.cast());
                }

                let c14n_path = temp_path("c14n", input_sum, "xml");
                if let Some(cp) = cstring_from_path(&c14n_path) {
                    let csave = xc14n::xmlC14NDocSave(doc as *mut _, null_mut(), 0, null_mut(), 1, cp.as_ptr(), 0);
                    iter_digest = fold(iter_digest, csave as u32 as u64);
                    let _ = fs::remove_file(c14n_path);
                }

                let xpctx = xptr::xmlXPtrNewContext(doc as *mut _, null_mut(), null_mut());
                iter_digest = fold(iter_digest, (!xpctx.is_null()) as u64);
                if !xpctx.is_null() {
                    let cache = xxp::xmlXPathContextSetCache(xpctx as *mut _, 1, 4, 0);
                    iter_digest = fold(iter_digest, cache as u32 as u64);
                    let obj = xptr::xmlXPtrEval(b"//*[@id='root']\0".as_ptr(), xpctx as *mut _);
                    iter_digest = fold(iter_digest, (!obj.is_null()) as u64);
                    if !obj.is_null() {
                        let f = tmpfile();
                        iter_digest = fold(iter_digest, (!f.is_null()) as u64);
                        if !f.is_null() {
                            xxp::xmlXPathDebugDumpObject(f as *mut _, obj as *mut _, 0);
                            fflush(f);
                            fclose(f);
                        }
                    }
                }

                xt::xmlFreeDoc(doc.cast());
            }

            last_rc = 0;
            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    let _ = fs::remove_file(in_path);
    format!("op=reader_debug_xinclude rc={} digest={:016x}", last_rc, digest)
}

pub fn op_catalog_list_module(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let cat_bytes = make_catalog_file_bytes(data);
    let cat_path = temp_path("catalog", input_sum, "xml");
    let _ = fs::write(&cat_path, &cat_bytes);
    let cat_c = cstring_from_path(&cat_path);
    let bad_mod = bytes_with_nul(b"/definitely/nonexistent/libxml2_raw_harness.so");

    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            if let Some(ref cpath) = cat_c {
                let cdoc = xcat::xmlParseCatalogFile(cpath.as_ptr());
                iter_digest = fold(iter_digest, (!cdoc.is_null()) as u64);
                if !cdoc.is_null() {
                    xt::xmlFreeDoc(cdoc as *mut _);
                }

                let catal = xcat::xmlLoadACatalog(cpath.as_ptr());
                iter_digest = fold(iter_digest, (!catal.is_null()) as u64);
                if !catal.is_null() {
                    let add = xcat::xmlACatalogAdd(
                        catal,
                        b"system\0".as_ptr(),
                        b"http://example.com/extra.dtd\0".as_ptr(),
                        b"file:///tmp/extra.dtd\0".as_ptr(),
                    );
                    iter_digest = fold(iter_digest, add as u32 as u64);

                    let r1 = xcat::xmlACatalogResolveSystem(catal, b"http://example.com/sys.dtd\0".as_ptr());
                    let r2 = xcat::xmlACatalogResolvePublic(catal, b"-//EXAMPLE//DTD TEST//EN\0".as_ptr());
                    let r3 = xcat::xmlACatalogResolve(catal, b"-//EXAMPLE//DTD TEST//EN\0".as_ptr(), b"http://example.com/sys.dtd\0".as_ptr());
                    let r4 = xcat::xmlACatalogResolveURI(catal, b"https://example.com/res\0".as_ptr());

                    for r in [r1, r2, r3, r4] {
                        let (l, s) = c_xml_len_and_checksum(r as *const u8);
                        iter_digest = fold(iter_digest, l as u64);
                        iter_digest = fold(iter_digest, s);
                        if !r.is_null() {
                            xm::xmlMemFree(r.cast());
                        }
                    }

                    let f = tmpfile();
                    iter_digest = fold(iter_digest, (!f.is_null()) as u64);
                    if !f.is_null() {
                        xcat::xmlACatalogDump(catal, f as *mut _);
                        fflush(f);
                        fclose(f);
                    }

                    iter_digest = fold(iter_digest, xcat::xmlConvertSGMLCatalog(catal) as u32 as u64);
                    xcat::xmlFreeCatalog(catal);
                }

                let sg = xcat::xmlLoadSGMLSuperCatalog(cpath.as_ptr());
                iter_digest = fold(iter_digest, (!sg.is_null()) as u64);
                if !sg.is_null() {
                    xcat::xmlFreeCatalog(sg);
                }
            }

            let list = xl::xmlListCreate(None, Some(list_str_compare));
            iter_digest = fold(iter_digest, (!list.is_null()) as u64);
            if !list.is_null() {
                let a = b"alpha\0".as_ptr() as *mut c_void;
                let b = b"beta\0".as_ptr() as *mut c_void;
                let c = b"gamma\0".as_ptr() as *mut c_void;
                let i1 = xl::xmlListInsert(list, b);
                let i2 = xl::xmlListAppend(list, a);
                let i3 = xl::xmlListAppend(list, c);
                let s1 = xl::xmlListSearch(list, a);
                let s2 = xl::xmlListReverseSearch(list, c);
                let r1 = xl::xmlListRemoveFirst(list, a);
                let r2 = xl::xmlListRemoveLast(list, c);
                let r3 = xl::xmlListRemoveAll(list, b);
                let e0 = xl::xmlListEmpty(list);
                iter_digest = fold(iter_digest, i1 as u32 as u64);
                iter_digest = fold(iter_digest, i2 as u32 as u64);
                iter_digest = fold(iter_digest, i3 as u32 as u64);
                iter_digest = fold(iter_digest, (!s1.is_null()) as u64);
                iter_digest = fold(iter_digest, (!s2.is_null()) as u64);
                iter_digest = fold(iter_digest, r1 as u32 as u64);
                iter_digest = fold(iter_digest, r2 as u32 as u64);
                iter_digest = fold(iter_digest, r3 as u32 as u64);
                iter_digest = fold(iter_digest, e0 as u32 as u64);
                xl::xmlListClear(list);
                iter_digest = fold(iter_digest, xl::xmlListEmpty(list) as u32 as u64);
                xl::xmlListDelete(list);
            }

            xn::xmlNanoHTTPInit();
            xn::xmlNanoHTTPScanProxy(b"http://proxy.example.invalid:8080/\0".as_ptr() as *const c_char);
            xn::xmlNanoHTTPCleanup();

            let module = xmod::xmlModuleOpen(bad_mod.as_ptr() as *const c_char, 0);
            iter_digest = fold(iter_digest, (!module.is_null()) as u64);
            if !module.is_null() {
                let mut sym = null_mut();
                let sr = xmod::xmlModuleSymbol(module, b"missing_symbol\0".as_ptr() as *const c_char, &mut sym);
                let cl = xmod::xmlModuleClose(module);
                let fr = xmod::xmlModuleFree(module);
                iter_digest = fold(iter_digest, sr as u32 as u64);
                iter_digest = fold(iter_digest, cl as u32 as u64);
                iter_digest = fold(iter_digest, fr as u32 as u64);
            }

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    let _ = fs::remove_file(cat_path);
    format!("op=catalog_list_module digest={:016x}", digest)
}

pub fn op_parser_sax_error(data: &[u8], iters: u64) -> String {
    let input_sum = checksum(data);
    let first_len = data.len().min(127);
    let msg = b"harness message\0";
    let pref = b"pfx\0";

    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let first_ptr = if first_len == 0 {
                null()
            } else {
                data.as_ptr() as *const c_char
            };

            let ctxt = hp::htmlCreatePushParserCtxt(
                null_mut(),
                null_mut(),
                first_ptr,
                bounded_i32_len(first_len),
                null(),
                0 as hp::xmlCharEncoding,
            );

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, (!ctxt.is_null()) as u64);
            last_err = 0;

            if !ctxt.is_null() {
                iter_digest = fold(iter_digest, xsax::xmlSAX2GetLineNumber(ctxt as *mut c_void) as u32 as u64);
                iter_digest = fold(iter_digest, xsax::xmlSAX2GetColumnNumber(ctxt as *mut c_void) as u32 as u64);
                iter_digest = fold(iter_digest, xsax::xmlSAX2IsStandalone(ctxt as *mut c_void) as u32 as u64);
                iter_digest = fold(iter_digest, xsax::xmlSAX2HasInternalSubset(ctxt as *mut c_void) as u32 as u64);
                iter_digest = fold(iter_digest, xsax::xmlSAX2HasExternalSubset(ctxt as *mut c_void) as u32 as u64);

                let pid = xsax::xmlSAX2GetPublicId(ctxt as *mut c_void);
                let sid = xsax::xmlSAX2GetSystemId(ctxt as *mut c_void);
                let (_, ps) = c_xml_len_and_checksum(pid as *const u8);
                let (_, ss) = c_xml_len_and_checksum(sid as *const u8);
                iter_digest = fold(iter_digest, ps);
                iter_digest = fold(iter_digest, ss);

                xsax::xmlSAX2InternalSubset(ctxt as *mut c_void, b"html\0".as_ptr(), null(), null());
                xsax::xmlSAX2ExternalSubset(ctxt as *mut c_void, b"html\0".as_ptr(), null(), null());
                let ri = xsax::xmlSAX2ResolveEntity(ctxt as *mut c_void, null(), null());
                let ge = xsax::xmlSAX2GetEntity(ctxt as *mut c_void, b"amp\0".as_ptr());
                iter_digest = fold(iter_digest, (!ri.is_null()) as u64);
                iter_digest = fold(iter_digest, (!ge.is_null()) as u64);

                let lkup = xp::xmlParserNsLookupSax(ctxt as *mut _, pref.as_ptr());
                let upd = xp::xmlParserNsUpdateSax(ctxt as *mut _, pref.as_ptr(), null_mut());
                iter_digest = fold(iter_digest, (!lkup.is_null()) as u64);
                iter_digest = fold(iter_digest, upd as u32 as u64);

                let np = xp::nodePush(ctxt as *mut _, null_mut());
                let po = xp::nodePop(ctxt as *mut _);
                iter_digest = fold(iter_digest, np as u32 as u64);
                iter_digest = fold(iter_digest, (!po.is_null()) as u64);

                let ip = xp::inputPush(ctxt as *mut _, null_mut());
                let io = xp::inputPop(ctxt as *mut _);
                iter_digest = fold(iter_digest, ip as u32 as u64);
                iter_digest = fold(iter_digest, (!io.is_null()) as u64);

                let wr = xp::xmlWarningMsg(
                    ctxt as *mut _,
                    0 as xp::xmlParserErrors,
                    b"warn\0".as_ptr() as *const c_char,
                    null(),
                    null(),
                );
                iter_digest = fold(iter_digest, wr as u32 as u64);

                let mut handler = None;
                xe::initGenericErrorDefaultFunc(&mut handler);
                xe::xmlSetGenericErrorFunc(null_mut(), handler);
                xe::xmlSetStructuredErrorFunc(null_mut(), None);
                xe::xmlGenericErrorDefaultFunc(null_mut(), msg.as_ptr() as *const c_char);

                xe::xmlParserError(ctxt as *mut c_void, msg.as_ptr() as *const c_char);
                xe::xmlParserWarning(ctxt as *mut c_void, msg.as_ptr() as *const c_char);
                xe::xmlParserValidityError(ctxt as *mut c_void, msg.as_ptr() as *const c_char);

                xpi::xmlErrMemory(ctxt as *mut _, msg.as_ptr() as *const c_char);
                xpi::__xmlErrEncoding(
                    ctxt as *mut _,
                    0 as xpi::xmlParserErrors,
                    msg.as_ptr() as *const c_char,
                    null(),
                    null(),
                );
                xpi::xmlFatalErr(ctxt as *mut _, 0 as xpi::xmlParserErrors, msg.as_ptr() as *const c_char);
                iter_digest = fold(iter_digest, xpi::xmlParserGrow(ctxt as *mut _) as u32 as u64);
                xpi::xmlParserShrink(ctxt as *mut _);
                xpi::xmlHaltParser(ctxt as *mut _);

                if first_len < data.len() {
                    let rc = hp::htmlParseChunk(
                        ctxt,
                        data[first_len..].as_ptr() as *const c_char,
                        bounded_i32_len(data.len() - first_len),
                        0,
                    );
                    iter_digest = fold(iter_digest, rc as u32 as u64);
                }
                let rc2 = hp::htmlParseChunk(ctxt, null(), 0, 1);
                iter_digest = fold(iter_digest, rc2 as u32 as u64);

                let bc = enc::xmlByteConsumed(ctxt.cast()) as i64;
                iter_digest = fold(iter_digest, bc as u64);

                let errp = xe::xmlCtxtGetLastError(ctxt.cast());
                last_err = if errp.is_null() { 0 } else { (*errp).code };
                iter_digest = fold(iter_digest, last_err as u32 as u64);

                hp::htmlFreeParserCtxt(ctxt);
            }

            iter_digest = fold(iter_digest, input_sum);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=parser_sax_error err={} digest={:016x}", last_err, digest)
}

