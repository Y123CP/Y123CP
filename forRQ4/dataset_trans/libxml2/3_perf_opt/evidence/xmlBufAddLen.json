    "rust_source": "pub fn xmlBufAddLen(mut buf: xmlBufPtr, mut len: size_t) -> c_int { unsafe {\n    if buf.is_null() || (*buf).error != 0 {\n        return -(1 as c_int);\n    }\n    if (*buf).size != (*buf).compat_size as size_t {\n        if (*buf).compat_size < INT_MAX as c_uint {\n            (*buf).size = (*buf).compat_size as size_t;\n        }\n    }\n    if (*buf).use_0 != (*buf).compat_use as size_t {\n        if (*buf).compat_use < INT_MAX as c_uint {\n            (*buf).use_0 = (*buf).compat_use as size_t;\n        }\n    }\n    if len >= (*buf).size.wrapping_sub((*buf).use_0) {\n        return -(1 as c_int);\n    }\n    (*buf).use_0 = ((*buf).use_0 as c_ulong).wrapping_add(len as c_ulong)\n        as size_t as size_t;\n    *(*buf).content.offset((*buf).use_0 as isize) = 0 as xmlChar;\n    if (*buf).size < INT_MAX as size_t {\n        (*buf).compat_size = (*buf).size as c_uint;\n    } else {\n        (*buf).compat_size = INT_MAX as c_uint;\n    }\n    if (*buf).use_0 < INT_MAX as size_t {\n        (*buf).compat_use = (*buf).use_0 as c_uint;\n    } else {\n        (*buf).compat_use = INT_MAX as c_uint;\n    }\n    return 0 as c_int;\n} }",
