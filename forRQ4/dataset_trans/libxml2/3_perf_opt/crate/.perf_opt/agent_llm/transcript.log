    while *cur as c_int != 0 as c_int
        && *cur as c_int != '\n' as i32
        && *cur as c_int != '\r' as i32
    {
        let mut len: c_int = (*input).end.offset_from(cur) as c_long as c_int;
        let mut c: c_int = xmlGetUTF8Char(cur as *const c_uchar, &raw mut len);
        if c < 0 as c_int
            || n.wrapping_add(len as c_uint) as usize > content.len().wrapping_sub(1)
        {
            break;
        }
        // SAFETY: `len` comes from `xmlGetUTF8Char` bounded by `(*input).end.offset_from(cur)`,
        // so advancing by `len` stays within the same valid input allocation; this preserves
        // the original variable-width UTF-8 cursor step and creates no references.
        cur = unsafe { cur.offset(len as isize) };
        n = n.wrapping_add(len as c_uint);
    }

    // SAFETY: `start..start+n` is the exact source span accepted by the original cursor walk,
    // so it is valid for reads of `n` bytes within one allocation. `content[..n]` is a distinct
    // stack buffer valid for writes of `n` bytes, and the regions cannot overlap.
    let src = unsafe { ::core::slice::from_raw_parts(start, n as usize) };
    content[..n as usize].copy_from_slice(src);
    content[n as usize] = 0 as xmlChar;

    channel.expect("non-null function pointer")(
        data,
        b"%s\n\0" as *const u8 as *const c_char,
        &raw mut content as *mut xmlChar,
    );

    n = 0 as c_uint;
    let content_limit = content.len().wrapping_sub(2);
    for b in content[..content_limit].iter_mut() {
        if n >= col || *b as c_int == 0 as c_int {
            break;
        }
        if *b as c_int != '\t' as i32 {
            *b = ' ' as i32 as xmlChar;
        }
        n = n.wrapping_add(1);
    }

    let caret_idx = n as usize;
    content[caret_idx] = '^' as i32 as xmlChar;
    content[caret_idx + 1] = 0 as xmlChar;

    channel.expect("non-null function pointer")(
        data,
        b"%s\n\0" as *const u8 as *const c_char,
        &raw mut content as *mut xmlChar,
