#[inline]
pub unsafe fn xmlStrdup(mut cur: *const xmlChar) -> *mut xmlChar {
    let mut p: *const xmlChar = cur;
    if cur.is_null() {
        return ::core::ptr::null_mut::<xmlChar>();
    }
    while *p as c_int != 0 as c_int {
        p = p.offset(1);
    }
    return xmlStrndup(
        cur,
        p.offset_from(cur) as c_long as c_int,
    );
}
