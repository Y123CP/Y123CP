          "replacement_region_source": "unsafe {\n    if regexp.is_null() {\n        return;\n    }\n\n    let xml_free = xmlFree.expect(\"non-null function pointer\");\n    let string = (*regexp).string;\n    if !string.is_null() {\n        xml_free(string as *mut c_void);\n    }\n\n    let states = (*regexp).states;\n    if !states.is_null() {\n        let nb_states = (*regexp).nbStates as usize;\n        // SAFETY: `states` is non-null here, `nb_states` comes from `regexp.nbStates`,\n        // which is not modified in this region, and this function only walks/free each\n        // element before freeing the backing array itself.\n        let states_slice = core::slice::from_raw_parts(states, nb_states);\n        for &state in states_slice.iter() {\n            xmlRegFreeState(state);\n        }\n        xml_free(states as *mut c_void);\n    }\n\n    let atoms = (*regexp).atoms;\n    if !atoms.is_null() {\n        let nb_atoms = (*regexp).nbAtoms as usize;\n        // SAFETY: `atoms` is non-null here, `nb_atoms` comes from `regexp.nbAtoms`,\n        // which is not modified in this region, and this function only walks/free each\n        // element before freeing the backing array itself.\n        let atoms_slice = core::slice::from_raw_parts(atoms, nb_atoms);\n        for &atom in atoms_slice.iter() {\n            xmlRegFreeAtom(atom);\n        }\n        xml_free(atoms as *mut c_void);\n    }\n\n    let counters = (*regexp).counters;\n    if !counters.is_null() {\n        xml_free(counters as *mut c_void);\n    }\n\n    let compact = (*regexp).compact;\n    if !compact.is_null() {\n        xml_free(compact as *mut c_void);\n    }\n\n    let transdata = (*regexp).transdata;\n    if !transdata.is_null() {\n        xml_free(transdata as *mut c_void);\n    }\n\n    let string_map = (*regexp).stringMap;\n    if !string_map.is_null() {\n        let nb_strings = (*regexp).nbstrings as usize;\n        // SAFETY: `string_map` is non-null here, `nb_strings` comes from `regexp.nbstrings`,\n        // which is not modified in this region, and this function only walks/free each\n        // pointed-to string before freeing the backing array itself.\n        let string_map_slice = core::slice::from_raw_parts(string_map, nb_strings);\n        for &s in string_map_slice.iter() {\n            xml_free(s as *mut c_void);\n        }\n        xml_free(string_map as *mut c_void);\n    }\n\n    xml_free(regexp as *mut c_void);\n}",
