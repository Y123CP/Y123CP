    "rust_source": "pub unsafe fn xmlStrdup(mut cur: *const xmlChar) -> *mut xmlChar {\n    let mut p: *const xmlChar = cur;\n    if cur.is_null() {\n        return ::core::ptr::null_mut::<xmlChar>();\n    }\n    while *p as c_int != 0 as c_int {\n        p = p.offset(1);\n    }\n    return xmlStrndup(\n        cur,\n        p.offset_from(cur) as c_long as c_int,\n    );\n}",
