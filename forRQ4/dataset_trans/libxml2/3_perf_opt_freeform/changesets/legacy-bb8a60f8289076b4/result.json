          "replacement_function_source": "fn xmlRegStatePush(mut ctxt: xmlRegParserCtxtPtr) -> xmlRegStatePtr { unsafe {\n    let nb_states = (*ctxt).nbStates;\n    if nb_states >= (*ctxt).maxStates {\n        let new_size = if (*ctxt).maxStates != 0 {\n            (*ctxt).maxStates * 2\n        } else {\n            4\n        } as size_t;\n\n        let tmp = xmlRealloc.expect(\"non-null function pointer\")(\n            (*ctxt).states as *mut c_void,\n            new_size.wrapping_mul(::core::mem::size_of::<xmlRegStatePtr>() as size_t),\n        ) as *mut xmlRegStatePtr;\n\n        if tmp.is_null() {\n            xmlRegexpErrMemory(\n                ctxt,\n                b\"adding state\\0\" as *const u8 as *const c_char,\n            );\n            return ::core::ptr::null_mut();\n        }\n\n        (*ctxt).states = tmp;\n        (*ctxt).maxStates = new_size as c_int;\n    }\n\n    let state = xmlRegNewState(ctxt);\n    if state.is_null() {\n        return ::core::ptr::null_mut();\n    }\n\n    (*state).no = nb_states;\n    (*ctxt).nbStates = nb_states + 1;\n    // SAFETY: `states` has capacity for index `nb_states` due to the growth check above, and `nb_states` is the previous valid insertion index.\n    *(*ctxt).states.add(nb_states as usize) = state;\n    state\n} }",
