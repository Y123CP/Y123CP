          "replacement_function_source": "#[inline]\npub fn xmlBufAddLen(mut buf: xmlBufPtr, mut len: size_t) -> c_int { unsafe {\n    // SAFETY: All raw pointer dereferences below require `buf` to be non-null; this is checked first.\n    if buf.is_null() || (*buf).error != 0 {\n        return -(1 as c_int);\n    }\n\n    // SAFETY: `buf` is non-null as checked above.\n    let b = &mut *buf;\n\n    let compat_size = b.compat_size;\n    if b.size != compat_size as size_t && compat_size < INT_MAX as c_uint {\n        b.size = compat_size as size_t;\n    }\n\n    let compat_use = b.compat_use;\n    if b.use_0 != compat_use as size_t && compat_use < INT_MAX as c_uint {\n        b.use_0 = compat_use as size_t;\n    }\n\n    let size = b.size;\n    let use_0 = b.use_0;\n    if len >= size.wrapping_sub(use_0) {\n        return -(1 as c_int);\n    }\n\n    let new_use = (use_0 as c_ulong).wrapping_add(len as c_ulong) as size_t;\n    b.use_0 = new_use;\n    // SAFETY: Original function assumes `content` points to a writable buffer of at least `new_use + 1` bytes when bounds check above passes; we preserve that exact precondition.\n    *b.content.offset(new_use as isize) = 0 as xmlChar;\n\n    b.compat_size = if size < INT_MAX as size_t {\n        size as c_uint\n    } else {\n        INT_MAX as c_uint\n    };\n\n    b.compat_use = if new_use < INT_MAX as size_t {\n        new_use as c_uint\n    } else {\n        INT_MAX as c_uint\n    };\n\n    0 as c_int\n} }",
