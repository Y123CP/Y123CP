          "replacement_function_source": "#[inline]\npub unsafe fn xmlStrdup(mut cur: *const xmlChar) -> *mut xmlChar {\n    if cur.is_null() {\n        return ::core::ptr::null_mut::<xmlChar>();\n    }\n\n    let mut p = cur;\n\n    loop {\n        // SAFETY: `cur` is expected to point to a valid NUL-terminated xmlChar string;\n        // we advance one byte at a time until the terminating 0 byte is found.\n        if unsafe { *p } == 0 {\n            break;\n        }\n        // SAFETY: same precondition as above; advancing within the same allocated\n        // NUL-terminated string preserves validity until the terminator is reached.\n        p = unsafe { p.add(1) };\n    }\n\n    xmlStrndup(\n        cur,\n        // SAFETY: `p` was derived from `cur` by walking within the same string allocation\n        // up to its terminating NUL, so both pointers are in-bounds of the same object.\n        unsafe { p.offset_from(cur) as c_long as c_int },\n    )\n}",
