          "replacement_function_source": "#[no_mangle]\npub unsafe extern \"C\" fn isolat1ToUTF8(\n    mut out: *mut c_uchar,\n    mut outlen: *mut c_int,\n    mut in_0: *const c_uchar,\n    mut inlen: *mut c_int,\n) -> c_int {\n    let outstart = out;\n    let base = in_0;\n\n    if out.is_null() || in_0.is_null() || outlen.is_null() || inlen.is_null() {\n        return XML_ENC_ERR_INTERNAL as c_int;\n    }\n\n    let out_cap = *outlen as isize;\n    let in_cap = *inlen as isize;\n    let outend = out.offset(out_cap);\n    let inend = in_0.offset(in_cap);\n\n    while in_0 < inend && out < outend.offset(-1) {\n        let byte = *in_0;\n        if byte >= 0x80 {\n            *out = (((byte as c_int >> 6) & 0x1f) | 0xc0) as c_uchar;\n            *out.offset(1) = ((byte as c_int & 0x3f) | 0x80) as c_uchar;\n            out = out.offset(2);\n            in_0 = in_0.offset(1);\n            continue;\n        }\n\n        let out_rem = outend.offset_from(out) as isize;\n        let in_rem = inend.offset_from(in_0) as isize;\n        let max_copy = if in_rem < out_rem { in_rem } else { out_rem };\n\n        let mut n = 0isize;\n        while n < max_copy && *in_0.offset(n) < 0x80 {\n            n += 1;\n        }\n\n        if n != 0 {\n            // SAFETY: `in_0..in_0+n` and `out..out+n` are valid, non-overlapping ranges within the\n            // caller-provided buffers; `n` is bounded by both remaining input and output space.\n            core::ptr::copy_nonoverlapping(in_0, out, n as usize);\n            in_0 = in_0.offset(n);\n            out = out.offset(n);\n        }\n    }\n\n    if in_0 < inend && out < outend && *in_0 < 0x80 {\n        *out = *in_0;\n        out = out.offset(1);\n        in_0 = in_0.offset(1);\n    }\n\n    *outlen = out.offset_from(outstart) as c_int;\n    *inlen = in_0.offset_from(base) as c_int;\n    *outlen\n}",
