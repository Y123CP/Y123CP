          "replacement_function_source": "#[no_mangle]\npub extern \"C\" fn xmlParserGrow(mut ctxt: xmlParserCtxtPtr) -> c_int { unsafe {\n    // SAFETY: `ctxt` is assumed valid by the original function contract.\n    let in_0: xmlParserInputPtr = (*ctxt).input;\n    // SAFETY: `in_0` is assumed valid by the original function contract.\n    let buf: xmlParserInputBufferPtr = (*in_0).buf;\n\n    if buf.is_null() {\n        return 0;\n    }\n\n    // Fast-path cheap exits before pointer-difference work.\n    if (*ctxt).progressive != 0 && (*ctxt).inputNr <= 1 {\n        return 0;\n    }\n    if (*buf).encoder.is_null() && (*buf).readcallback.is_none() {\n        return 0;\n    }\n\n    let buf_error = (*buf).error;\n    if buf_error != 0 {\n        return -1;\n    }\n\n    let cur = (*in_0).cur;\n    let end = (*in_0).end;\n    let base = (*in_0).base;\n    let cur_end = end.offset_from(cur) as ptrdiff_t;\n    let cur_base = cur.offset_from(base) as ptrdiff_t;\n\n    if (cur_end > XML_MAX_LOOKUP_LIMIT as ptrdiff_t || cur_base > XML_MAX_LOOKUP_LIMIT as ptrdiff_t)\n        && (*ctxt).options & XML_PARSE_HUGE as c_int == 0\n    {\n        xmlErrMemory(\n            ctxt,\n            b\"Huge input lookup\\0\" as *const u8 as *const c_char,\n        );\n        xmlHaltParser(ctxt);\n        return -1;\n    }\n\n    if cur_end >= INPUT_CHUNK as ptrdiff_t {\n        return 0;\n    }\n\n    let ret = xmlParserInputBufferGrow(buf, INPUT_CHUNK);\n    xmlBufUpdateInput((*buf).buffer, in_0, cur_base as size_t);\n\n    if ret < 0 {\n        let err = (*buf).error;\n        xmlFatalErr(ctxt, err as xmlParserErrors, ::core::ptr::null::<c_char>());\n        if err == XML_ERR_NO_MEMORY as c_int {\n            xmlHaltParser(ctxt);\n        }\n    }\n\n    ret\n} }",
