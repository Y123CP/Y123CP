          "replacement_function_source": "#[inline]\npub unsafe fn xmlCharStrdup(mut cur: *const c_char) -> *mut xmlChar {\n    if cur.is_null() {\n        return ::core::ptr::null_mut::<xmlChar>();\n    }\n\n    let mut p = cur;\n    loop {\n        // SAFETY: `cur` is non-null and this function preserves the original behavior of\n        // scanning forward byte-by-byte until the first NUL terminator in the same C string.\n        if *p == 0 {\n            break;\n        }\n        // SAFETY: Advancing by one byte is valid under the same precondition as the original\n        // implementation: `cur` points to a valid NUL-terminated C string.\n        p = p.add(1);\n    }\n\n    xmlCharStrndup(\n        cur,\n        // SAFETY: `p` was derived from `cur` by in-bounds forward traversal within the same\n        // NUL-terminated allocation, so `offset_from` is well-defined.\n        p.offset_from(cur) as c_long as c_int,\n    )\n}",
