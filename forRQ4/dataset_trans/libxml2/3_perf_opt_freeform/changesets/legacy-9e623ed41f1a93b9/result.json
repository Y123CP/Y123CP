          "replacement_function_source": "#[inline]\npub fn htmlEntityValueLookup(\n    mut value: c_uint,\n) -> *const htmlEntityDesc {\n    unsafe {\n        let table = &raw const html40EntitiesTable as *const htmlEntityDesc;\n        let mut lo: usize = 0;\n        let mut hi: usize =\n            (::core::mem::size_of::<[htmlEntityDesc; 253]>() as usize)\n                .wrapping_div(::core::mem::size_of::<htmlEntityDesc>() as usize);\n\n        while lo < hi {\n            let mid = lo + ((hi - lo) >> 1);\n            let mid_val = (*table.add(mid)).value; // SAFETY: `mid < hi <= table_len`, so `mid` is in-bounds for the static table.\n            if mid_val < value {\n                lo = mid + 1;\n            } else {\n                hi = mid;\n            }\n        }\n\n        if lo\n            < (::core::mem::size_of::<[htmlEntityDesc; 253]>() as usize)\n                .wrapping_div(::core::mem::size_of::<htmlEntityDesc>() as usize)\n            && (*table.add(lo)).value == value\n        {\n            // SAFETY: `lo < table_len` was checked above, so this points to a valid element of the static table.\n            table.add(lo) as *const htmlEntityDesc\n        } else {\n            ::core::ptr::null::<htmlEntityDesc>()\n        }\n    }\n}",
