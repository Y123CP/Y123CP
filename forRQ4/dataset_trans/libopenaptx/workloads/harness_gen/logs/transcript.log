```rust
use std::fs;
use std::ptr;

use libopenaptx_raw::src::openaptx::{
    aptx_context, aptx_decode, aptx_decode_sync, aptx_decode_sync_finish, aptx_encode,
    aptx_encode_finish, aptx_finish, aptx_init, aptx_reset, size_t,
};

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(1) ^ x
}

fn checksum_bytes(acc: u64, buf: &[u8]) -> u64 {
    let mut h = acc;
    for &b in buf {
        h = fold(h, b as u64);
    }
    h
}

/// Encode operation: takes raw 24-bit LE interleaved stereo PCM, encodes via aptX (non-HD).
fn op_encode(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let ctx = aptx_init(0); // 0 = non-HD
            if ctx.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            // Output buffer: aptX non-HD produces 4 bytes per 24 bytes of input (4 samples * 3 bytes * 2 channels = 24 bytes -> 4 bytes)
            // Be generous with output buffer size
            let out_size = if data.is_empty() { 64 } else { data.len() + 64 };
            let mut output = vec![0u8; out_size];
            let mut written: size_t = 0;

            let processed = aptx_encode(
                ctx,
                data.as_ptr(),
                data.len() as size_t,
                output.as_mut_ptr(),
                output.len() as size_t,
                &mut written,
            );

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, processed as u64);
            iter_digest = fold(iter_digest, written as u64);
            iter_digest = checksum_bytes(iter_digest, &output[..written as usize]);

            // Finish encoding (flush)
            let mut finish_output = vec![0u8; 64];
            let mut finish_written: size_t = 0;
            let finish_ret = aptx_encode_finish(
                ctx,
                finish_output.as_mut_ptr(),
                finish_output.len() as size_t,
                &mut finish_written,
            );

            iter_digest = fold(iter_digest, finish_ret as u64);
            iter_digest = fold(iter_digest, finish_written as u64);
            iter_digest = checksum_bytes(iter_digest, &finish_output[..finish_written as usize]);

            aptx_finish(ctx);

            digest = fold(digest, iter_digest);
        }
    }

    format!("op=encode digest={:016x}", digest)
}

/// Decode operation: takes aptX encoded bitstream, decodes to PCM.
fn op_decode(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let ctx = aptx_init(0);
            if ctx.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            // Output buffer: each 4 bytes of aptX -> 24 bytes of PCM (generous)
            let out_size = if data.is_empty() { 64 } else { data.len() * 8 + 64 };
            let mut output = vec![0u8; out_size];
            let mut written: size_t = 0;

            let processed = aptx_decode(
                ctx,
                data.as_ptr(),
                data.len() as size_t,
                output.as_mut_ptr(),
                output.len() as size_t,
                &mut written,
            );

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, processed as u64);
            iter_digest = fold(iter_digest, written as u64);
            iter_digest = checksum_bytes(iter_digest, &output[..written as usize]);

            aptx_finish(ctx);

            digest = fold(digest, iter_digest);
        }
    }

    format!("op=decode digest={:016x}", digest)
}

/// Decode with sync recovery.
fn op_decode_sync(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let ctx = aptx_init(0);
            if ctx.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let out_size = if data.is_empty() { 64 } else { data.len() * 8 + 64 };
            let mut output = vec![0u8; out_size];
            let mut written: size_t = 0;
            let mut synced: i32 = 0;
            let mut dropped: size_t = 0;

            let processed = aptx_decode_sync(
                ctx,
                data.as_ptr(),
                data.len() as size_t,
                output.as_mut_ptr(),
                output.len() as size_t,
                &mut written,
                &mut synced,
                &mut dropped,
            );

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, processed as u64);
            iter_digest = fold(iter_digest, written as u64);
            iter_digest = fold(iter_digest, synced as u64);
            iter_digest = fold(iter_digest, dropped as u64);
            iter_digest = checksum_bytes(iter_digest, &output[..written as usize]);

            let sync_finish_ret = aptx_decode_sync_finish(ctx);
            iter_digest = fold(iter_digest, sync_finish_ret as u64);

            aptx_finish(ctx);

            digest = fold(digest, iter_digest);
        }
    }

    format!("op=decode_sync digest={:016x}", digest)
}

/// Roundtrip: encode PCM -> decode the encoded data -> checksum decoded PCM.
fn op_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let ctx = aptx_init(0);
            if ctx.is_null() {
                digest = fold(digest, 0xDEAD);
                continue;
            }

            // --- Encode phase ---
            let enc_out_size = if data.is_empty() { 64 } else { data.len() + 64 };
            let mut enc_output = vec![0u8; enc_out_size];
            let mut enc_written: size_t = 0;

            let _enc_processed = aptx_encode(
                ctx,
                data.as_ptr(),
                data.len() as size_t,
                enc_output.as_mut_ptr(),
                enc_output.len() as size_t,
                &mut enc_written,
            );

            // Finish encoding
            let mut finish_output = vec![0u8; 64];
            let mut finish_written: size_t = 0;
            let _finish_ret = aptx_encode_finish(
                ctx,
                finish_output.as_mut_ptr(),
                finish_output.len() as size_t,
                &mut finish_written,
            );

            // Combine encoded data
            let total_encoded_len = (enc_written + finish_written) as usize;
            let mut encoded = Vec::with_capacity(total_encoded_len);
            encoded.extend_from_slice(&enc_output[..enc_written as usize]);
            encoded.extend_from_slice(&finish_output[..finish_written as usize]);

            // --- Reset for decode phase ---
            aptx_reset(ctx);

            // --- Decode phase ---
            let dec_out_size = if encoded.is_empty() { 64 } else { encoded.len() * 8 + 64 };
            let mut dec_output = vec![0u8; dec_out_size];
            let mut dec_written: size_t = 0;

            let _dec_processed = aptx_decode(
                ctx,
                encoded.as_ptr(),
                encoded.len() as size_t,
                dec_output.as_mut_ptr(),
                dec_output.len() as size_t,
                &mut dec_written,
            );

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, dec_written as u64);
            iter_digest = checksum_bytes(iter_digest, &dec_output[..dec_written as usize]);

            aptx_finish(ctx);

            digest = fold(digest, iter_digest);
        }
    }

    format!("op=roundtrip digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("encode", op_encode as fn(&[u8], u64) -> String),
        ("decode", op_decode as fn(&[u8], u64) -> String),
        ("decode_sync", op_decode_sync as fn(&[u8], u64) -> String),
        ("roundtrip", op_roundtrip as fn(&[u8], u64) -> String),
    ]
}

/// Generate a deterministic 24-bit LE stereo PCM buffer with a sine-like pattern.
/// Each sample is 3 bytes (24-bit LE). Stereo = 2 channels.
/// aptX non-HD processes 4 stereo samples at a time = 4 * 2 * 3 = 24 bytes per block.
fn gen_pcm_buffer(freq_param: u32, num_stereo_pairs: usize) -> Vec<u8> {
    // Each stereo pair = 6 bytes (3 bytes left + 3 bytes right)
    // We need multiples of 4 stereo pairs for aptX (24 bytes per aptX sample)
    let pairs = (num_stereo_pairs / 4) * 4; // round down to multiple of 4
    let pairs = if pairs == 0 { 4 } else { pairs };
    let mut buf = Vec::with_capacity(pairs * 6);

    for i in 0..pairs {
        // Deterministic "sine-like" pattern using integer math
        let t = i as u32;
        let left = ((t.wrapping_mul(freq_param).wrapping_add(17)) % 0x1000000) as i32;
        let right = ((t.wrapping_mul(freq_param.wrapping_mul(3)).wrapping_add(31)) % 0x1000000) as i32;

        // Write as 24-bit LE
        let l = left as u32;
        buf.push((l & 0xFF) as u8);
        buf.push(((l >> 8) & 0xFF) as u8);
        buf.push(((l >> 16) & 0xFF) as u8);

        let r = right as u32;
        buf.push((r & 0xFF) as u8);
        buf.push(((r >> 8) & 0xFF) as u8);
        buf.push(((r >> 16) & 0xFF) as u8);
    }

    buf
}

/// Encode a PCM buffer to aptX bitstream using the library.
fn encode_pcm_to_aptx(pcm: &[u8]) -> Vec<u8> {
    unsafe {
        let ctx = aptx_init(0);
        if ctx.is_null() {
            return Vec::new();
        }

        let out_size = pcm.len() + 128;
        let mut output = vec![0u8; out_size];
        let mut written: size_t = 0;

        let _processed = aptx_encode(
            ctx,
            pcm.as_ptr(),
            pcm.len() as size_t,
            output.as_mut_ptr(),
            output.len() as size_t,
            &mut written,
        );

        let mut finish_output = vec![0u8; 64];
        let mut finish_written: size_t = 0;
        let _finish_ret = aptx_encode_finish(
            ctx,
            finish_output.as_mut_ptr(),
            finish_output.len() as size_t,
            &mut finish_written,
        );

        let mut result = Vec::new();
        result.extend_from_slice(&output[..written as usize]);
        result.extend_from_slice(&finish_output[..finish_written as usize]);

        aptx_finish(ctx);

        result
    }
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // Two distinct PCM buffers for encode and roundtrip
    let pcm1 = gen_pcm_buffer(1000, 40); // 40 stereo pairs = 240 bytes
    let pcm2 = gen_pcm_buffer(3700, 40); // different frequency

    // encode seeds
    {
        let path1 = format!("{}/encode.1.bin", dir);
        fs::write(&path1, &pcm1).unwrap();
        lines.push(format!("seed encode {}", path1));

        let path2 = format!("{}/encode.2.bin", dir);
        fs::write(&path2, &pcm2).unwrap();
        lines.push(format!("seed encode {}", path2));
    }

    // roundtrip seeds (same PCM data)
    {
        let path1 = format!("{}/roundtrip.1.bin", dir);
        fs::write(&path1, &pcm1).unwrap();
        lines.push(format!("seed roundtrip {}", path1));

        let path2 = format!("{}/roundtrip.2.bin", dir);
        fs::write(&path2, &pcm2).unwrap();
        lines.push(format!("seed roundtrip {}", path2));
    }

    // Encode PCM to aptX for decode seeds
    let aptx1 = encode_pcm_to_aptx(&pcm1);
    let aptx2 = encode_pcm_to_aptx(&pcm2);

    // decode seeds
    {
        let path1 = format!("{}/decode.1.bin", dir);
        fs::write(&path1, &aptx1).unwrap();
        lines.push(format!("seed decode {}", path1));

        let path2 = format!("{}/decode.2.bin", dir);
        fs::write(&path2, &aptx2).unwrap();
        lines.push(format!("seed decode {}", path2));
    }

    // decode_sync seeds: second one has prepended garbage bytes
    {
        let path1 = format!("{}/decode_sync.1.bin", dir);
        fs::write(&path1, &aptx1).unwrap();
        lines.push(format!("seed decode_sync {}", path1));

        // Prepend some garbage bytes to test sync recovery
        let mut garbage_aptx2 = vec![0xDE, 0xAD, 0xBE, 0xEF, 0x42];
        garbage_aptx2.extend_from_slice(&aptx2);
        let path2 = format!("{}/decode_sync.2.bin", dir);
        fs::write(&path2, &garbage_aptx2).unwrap();
        lines.push(format!("seed decode_sync {}", path2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // Large PCM buffer for encode perf: ~240KB of PCM data
    // 10000 stereo pairs * 6 bytes = 60000 bytes, round to multiple of 24
    let large_pcm = gen_pcm_buffer(2500, 10000);

    {
        let path = format!("{}/encode.perf.bin", dir);
        fs::write(&path, &large_pcm).unwrap();
        lines.push(format!("perf encode {}", path));
    }

    // Large roundtrip
    {
        let path = format!("{}/roundtrip.perf.bin", dir);
        fs::write(&path, &large_pcm).unwrap();
        lines.push(format!("perf roundtrip {}", path));
    }

    // Large encoded data for decode perf
    let large_aptx = encode_pcm_to_aptx(&large_pcm);

    {
        let path = format!("{}/decode.perf.bin", dir);
        fs::write(&path, &large_aptx).unwrap();
        lines.push(format!("perf decode {}", path));
    }

    {
        let path = format!("{}/decode_sync.perf.bin", dir);
        fs::write(&path, &large_aptx).unwrap();
        lines.push(format!("perf decode_sync {}", path));
    }

    lines
}
