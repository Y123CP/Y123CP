```rust
use std::fs;
use std::ptr;

use libopenaptx_raw::src::openaptx::{
    aptx_decode, aptx_decode_sync, aptx_decode_sync_finish, aptx_encode, aptx_encode_finish,
    aptx_finish, aptx_init, aptx_reset,
};

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9E37_79B1_85EB_CA87)
}

fn checksum(bytes: &[u8]) -> u64 {
    let mut acc = 0x243F_6A88_85A3_08D3u64;
    for &b in bytes {
        acc = fold(acc, b as u64);
    }
    acc
}

fn le_i16(v: i16, out: &mut Vec<u8>) {
    out.extend_from_slice(&v.to_le_bytes());
}

fn le_i24(v: i32, out: &mut Vec<u8>) {
    let x = v.clamp(-8_388_608, 8_388_607);
    let b = x.to_le_bytes();
    out.extend_from_slice(&b[..3]);
}

fn make_std_pcm_variant(variant: u32, frames: usize) -> Vec<u8> {
    let mut out = Vec::with_capacity(frames * 4);
    for i in 0..frames {
        let seg = (i / 256) % 8;
        let t = i as i32;
        let base = match variant {
            1 => ((t * 97) & 0x7fff) - 0x4000,
            _ => ((t * 173 + ((t >> 3) * 29)) & 0x7fff) - 0x4000,
        };
        let ramp = (((t * (variant as i32 * 13 + 41)) & 0xffff) - 0x8000) / 2;
        let alt = if ((i / 64) & 1) == 0 { 9000 } else { -9000 };
        let (l, r) = match seg {
            0 => (base / 2, -base / 2),
            1 => (ramp / 3, ramp / 4),
            2 => (0, 0),
            3 => (alt, -alt),
            4 => (((base + ramp) / 3), ((base - ramp) / 3)),
            5 => (((base / 4) + alt), ((-base / 4) - alt)),
            6 => (((t % 1024) - 512) * 20, (((1023 - (t % 1024)) - 512) * 18)),
            _ => (
                (((t * 31) ^ (t * 7)) & 0x7fff) - 0x4000,
                ((((t * 19) ^ (t * 11)) & 0x7fff) - 0x4000) / 2,
            ),
        };
        le_i16(l as i16, &mut out);
        le_i16(r as i16, &mut out);
    }
    out
}

fn make_hd_pcm_variant(variant: u32, frames: usize) -> Vec<u8> {
    let mut out = Vec::with_capacity(frames * 6);
    for i in 0..frames {
        let seg = (i / 192) % 8;
        let t = i as i32;
        let base = match variant {
            1 => ((t * 19_133) & 0x7f_ffff) - 0x40_0000,
            _ => ((t * 27_731 + ((t >> 2) * 1_021)) & 0x7f_ffff) - 0x40_0000,
        };
        let ramp = (((t * (variant as i32 * 997 + 1231)) & 0xff_ffff) - 0x80_0000) / 2;
        let alt = if ((i / 48) & 1) == 0 {
            1_200_000
        } else {
            -1_200_000
        };
        let (l, r) = match seg {
            0 => (base / 2, -base / 2),
            1 => (ramp / 3, ramp / 5),
            2 => (0, 0),
            3 => (alt, -alt),
            4 => ((base + ramp) / 3, (base - ramp) / 3),
            5 => ((base / 4) + alt, (-base / 4) - alt),
            6 => (((t % 4096) - 2048) * 900, (((4095 - (t % 4096)) - 2048) * 700)),
            _ => (
                (((t * 131) ^ (t * 17)) & 0x7f_ffff) - 0x40_0000,
                ((((t * 89) ^ (t * 23)) & 0x7f_ffff) - 0x40_0000) / 2,
            ),
        };
        le_i24(l, &mut out);
        le_i24(r, &mut out);
    }
    out
}

unsafe fn encode_all(hd: i32, input: &[u8]) -> (Vec<u8>, usize, i32, bool) {
    let ctx = aptx_init(hd);
    if ctx.is_null() {
        return (Vec::new(), 0, -1, false);
    }

    let mut produced = Vec::new();
    let mut consumed_total = 0usize;
    let mut ok = true;

    let mut offset = 0usize;
    while offset < input.len() {
        let remaining = input.len() - offset;
        let out_cap = remaining.saturating_mul(2).saturating_add(4096).max(4096);
        let mut out = vec![0u8; out_cap];
        let mut written = 0usize;

        let consumed = aptx_encode(
            ctx,
            input[offset..].as_ptr(),
            remaining,
            out.as_mut_ptr(),
            out.len(),
            &mut written as *mut usize,
        );

        let w = written.min(out.len());
        produced.extend_from_slice(&out[..w]);
        consumed_total = consumed_total.wrapping_add(consumed);

        if consumed == 0 {
            ok = false;
            break;
        }
        offset = offset.saturating_add(consumed.min(remaining));
    }

    let mut flush_out = vec![0u8; 4096];
    let mut flush_written = 0usize;
    let finish_rc = aptx_encode_finish(
        ctx,
        flush_out.as_mut_ptr(),
        flush_out.len(),
        &mut flush_written as *mut usize,
    );
    let fw = flush_written.min(flush_out.len());
    produced.extend_from_slice(&flush_out[..fw]);

    aptx_finish(ctx);
    (produced, consumed_total, finish_rc, ok)
}

unsafe fn decode_all(hd: i32, input: &[u8]) -> (Vec<u8>, usize, bool) {
    let ctx = aptx_init(hd);
    if ctx.is_null() {
        return (Vec::new(), 0, false);
    }

    let mut produced = Vec::new();
    let mut consumed_total = 0usize;
    let mut ok = true;

    let mut offset = 0usize;
    while offset < input.len() {
        let remaining = input.len() - offset;
        let out_cap = remaining.saturating_mul(16).saturating_add(4096).max(4096);
        let mut out = vec![0u8; out_cap];
        let mut written = 0usize;

        let consumed = aptx_decode(
            ctx,
            input[offset..].as_ptr(),
            remaining,
            out.as_mut_ptr(),
            out.len(),
            &mut written as *mut usize,
        );

        let w = written.min(out.len());
        produced.extend_from_slice(&out[..w]);
        consumed_total = consumed_total.wrapping_add(consumed);

        if consumed == 0 {
            ok = false;
            break;
        }
        offset = offset.saturating_add(consumed.min(remaining));
    }

    aptx_finish(ctx);
    (produced, consumed_total, ok)
}

unsafe fn decode_sync_all(input: &[u8]) -> (Vec<u8>, usize, i32, usize, usize, bool) {
    let ctx = aptx_init(1);
    if ctx.is_null() {
        return (Vec::new(), 0, -1, 0, 0, false);
    }

    let mut produced = Vec::new();
    let mut consumed_total = 0usize;
    let mut synced_acc = 0i32;
    let mut dropped_acc = 0usize;
    let mut ok = true;

    let mut offset = 0usize;
    while offset < input.len() {
        let remaining = input.len() - offset;
        let out_cap = remaining.saturating_mul(16).saturating_add(4096).max(4096);
        let mut out = vec![0u8; out_cap];
        let mut written = 0usize;
        let mut synced = 0i32;
        let mut dropped = 0usize;

        let consumed = aptx_decode_sync(
            ctx,
            input[offset..].as_ptr(),
            remaining,
            out.as_mut_ptr(),
            out.len(),
            &mut written as *mut usize,
            &mut synced as *mut i32,
            &mut dropped as *mut usize,
        );

        let w = written.min(out.len());
        produced.extend_from_slice(&out[..w]);
        consumed_total = consumed_total.wrapping_add(consumed);
        synced_acc |= synced;
        dropped_acc = dropped_acc.wrapping_add(dropped);

        if consumed == 0 {
            ok = false;
            break;
        }
        offset = offset.saturating_add(consumed.min(remaining));
    }

    let finish_val = aptx_decode_sync_finish(ctx);
    aptx_finish(ctx);
    (
        produced,
        consumed_total,
        synced_acc,
        dropped_acc,
        finish_val,
        ok,
    )
}

fn run_encode_std_once(data: &[u8]) -> (u64, i32) {
    unsafe {
        let (out, consumed, finish_rc, ok) = encode_all(0, data);
        let mut d = 0u64;
        d = fold(d, consumed as u64);
        d = fold(d, out.len() as u64);
        d = fold(d, finish_rc as u64);
        d = fold(d, checksum(&out));
        d = fold(d, ok as u64);
        (d, finish_rc)
    }
}

fn run_encode_hd_reset_once(data: &[u8]) -> (u64, i32) {
    unsafe {
        let ctx = aptx_init(1);
        if ctx.is_null() {
            let mut d = 0u64;
            d = fold(d, 0);
            d = fold(d, 0);
            d = fold(d, u64::MAX);
            return (d, -1);
        }

        let mut out1 = Vec::new();
        let mut out2 = Vec::new();

        let mut before_ok = true;
        let mut after_ok = true;

        let mut offset = 0usize;
        while offset < data.len() {
            let remaining = data.len() - offset;
            let out_cap = remaining.saturating_mul(2).saturating_add(4096).max(4096);
            let mut buf = vec![0u8; out_cap];
            let mut written = 0usize;
            let consumed = aptx_encode(
                ctx,
                data[offset..].as_ptr(),
                remaining,
                buf.as_mut_ptr(),
                buf.len(),
                &mut written as *mut usize,
            );
            let w = written.min(buf.len());
            out1.extend_from_slice(&buf[..w]);
            if consumed == 0 {
                before_ok = false;
                break;
            }
            offset = offset.saturating_add(consumed.min(remaining));
        }

        aptx_reset(ctx);

        offset = 0usize;
        while offset < data.len() {
            let remaining = data.len() - offset;
            let out_cap = remaining.saturating_mul(2).saturating_add(4096).max(4096);
            let mut buf = vec![0u8; out_cap];
            let mut written = 0usize;
            let consumed = aptx_encode(
                ctx,
                data[offset..].as_ptr(),
                remaining,
                buf.as_mut_ptr(),
                buf.len(),
                &mut written as *mut usize,
            );
            let w = written.min(buf.len());
            out2.extend_from_slice(&buf[..w]);
            if consumed == 0 {
                after_ok = false;
                break;
            }
            offset = offset.saturating_add(consumed.min(remaining));
        }

        let mut flush = vec![0u8; 4096];
        let mut flush_written = 0usize;
        let finish_rc = aptx_encode_finish(
            ctx,
            flush.as_mut_ptr(),
            flush.len(),
            &mut flush_written as *mut usize,
        );
        let fw = flush_written.min(flush.len());
        out2.extend_from_slice(&flush[..fw]);

        aptx_finish(ctx);

        let mut d = 0u64;
        d = fold(d, out1.len() as u64);
        d = fold(d, checksum(&out1));
        d = fold(d, out2.len() as u64);
        d = fold(d, checksum(&out2));
        d = fold(d, finish_rc as u64);
        d = fold(d, before_ok as u64);
        d = fold(d, after_ok as u64);
        (d, finish_rc)
    }
}

fn run_decode_std_once(data: &[u8]) -> (u64, i32) {
    unsafe {
        let (out, consumed, ok) = decode_all(0, data);
        let mut d = 0u64;
        d = fold(d, consumed as u64);
        d = fold(d, out.len() as u64);
        d = fold(d, checksum(&out));
        d = fold(d, ok as u64);
        (d, if ok { 0 } else { -1 })
    }
}

fn run_decode_sync_hd_once(data: &[u8]) -> (u64, i32) {
    unsafe {
        let (out, consumed, synced, dropped, finish_val, ok) = decode_sync_all(data);
        let mut d = 0u64;
        d = fold(d, consumed as u64);
        d = fold(d, out.len() as u64);
        d = fold(d, synced as u64);
        d = fold(d, dropped as u64);
        d = fold(d, finish_val as u64);
        d = fold(d, checksum(&out));
        d = fold(d, ok as u64);
        (d, if ok { synced } else { -1 })
    }
}

pub fn encode_std(data: &[u8], iters: u64) -> String {
    let n = if iters == 0 { 1 } else { iters };
    let mut digest = 0u64;
    let mut last_rc = 0i32;
    for _ in 0..n {
        let (d, rc) = run_encode_std_once(data);
        digest = fold(digest, d);
        last_rc = rc;
    }
    format!("op=encode_std rc={} digest={:016x}", last_rc, digest)
}

pub fn encode_hd_reset(data: &[u8], iters: u64) -> String {
    let n = if iters == 0 { 1 } else { iters };
    let mut digest = 0u64;
    let mut last_rc = 0i32;
    for _ in 0..n {
        let (d, rc) = run_encode_hd_reset_once(data);
        digest = fold(digest, d);
        last_rc = rc;
    }
    format!("op=encode_hd_reset rc={} digest={:016x}", last_rc, digest)
}

pub fn decode_std(data: &[u8], iters: u64) -> String {
    let n = if iters == 0 { 1 } else { iters };
    let mut digest = 0u64;
    let mut last_err = 0i32;
    for _ in 0..n {
        let (d, err) = run_decode_std_once(data);
        digest = fold(digest, d);
        last_err = err;
    }
    format!("op=decode_std err={} digest={:016x}", last_err, digest)
}

pub fn decode_sync_hd(data: &[u8], iters: u64) -> String {
    let n = if iters == 0 { 1 } else { iters };
    let mut digest = 0u64;
    let mut last_state = 0i32;
    for _ in 0..n {
        let (d, state) = run_decode_sync_hd_once(data);
        digest = fold(digest, d);
        last_state = state;
    }
    format!(
        "op=decode_sync_hd state={} digest={:016x}",
        last_state, digest
    )
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("encode_std", encode_std as fn(&[u8], u64) -> String),
        (
            "encode_hd_reset",
            encode_hd_reset as fn(&[u8], u64) -> String,
        ),
        ("decode_std", decode_std as fn(&[u8], u64) -> String),
        (
            "decode_sync_hd",
            decode_sync_hd as fn(&[u8], u64) -> String,
        ),
    ]
}

fn write_file(path: &str, bytes: &[u8]) -> bool {
    if let Some(parent) = std::path::Path::new(path).parent() {
        let _ = fs::create_dir_all(parent);
    }
    fs::write(path, bytes).is_ok()
}

fn make_decode_std_seed(variant: u32, frames: usize) -> Vec<u8> {
    let pcm = make_std_pcm_variant(variant, frames);
    unsafe {
        let (enc, _, _, _) = encode_all(0, &pcm);
        enc
    }
}

fn make_decode_sync_hd_seed(variant: u32, frames: usize, prefix: &[u8]) -> Vec<u8> {
    let pcm = make_hd_pcm_variant(variant, frames);
    unsafe {
        let (enc, _, _, _) = encode_all(1, &pcm);
        let mut out = Vec::with_capacity(prefix.len() + enc.len());
        out.extend_from_slice(prefix);
        out.extend_from_slice(&enc);
        out
    }
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let e1 = make_std_pcm_variant(1, 4096);
    let e2 = make_std_pcm_variant(2, 6144);
    for (idx, bytes) in [(1usize, &e1), (2usize, &e2)] {
        let path = format!("{}/encode_std.{}.bin", dir, idx);
        if write_file(&path, bytes) {
            lines.push(format!("seed encode_std {}", path));
        }
    }

    let h1 = make_hd_pcm_variant(1, 4096);
    let h2 = make_hd_pcm_variant(2, 5632);
    for (idx, bytes) in [(1usize, &h1), (2usize, &h2)] {
        let path = format!("{}/encode_hd_reset.{}.bin", dir, idx);
        if write_file(&path, bytes) {
            lines.push(format!("seed encode_hd_reset {}", path));
        }
    }

    let d1 = make_decode_std_seed(1, 4096);
    let d2 = make_decode_std_seed(2, 6144);
    for (idx, bytes) in [(1usize, &d1), (2usize, &d2)] {
        let path = format!("{}/decode_std.{}.bin", dir, idx);
        if write_file(&path, bytes) {
            lines.push(format!("seed decode_std {}", path));
        }
    }

    let s1 = make_decode_sync_hd_seed(1, 4096, &[0xA5, 0x5A, 0x13, 0x37, 0xC0]);
    let s2 = make_decode_sync_hd_seed(2, 5632, &[0xDE, 0xAD, 0xBE, 0xEF, 0x44, 0x99, 0x12]);
    for (idx, bytes) in [(1usize, &s1), (2usize, &s2)] {
        let path = format!("{}/decode_sync_hd.{}.bin", dir, idx);
        if write_file(&path, bytes) {
            lines.push(format!("seed decode_sync_hd {}", path));
        }
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let pcm_std = make_std_pcm_variant(1, 1_500_000);
    let path = format!("{}/encode_std.perf.bin", dir);
    if write_file(&path, &pcm_std) {
        lines.push(format!("perf encode_std {}", path));
    }

    let pcm_hd = make_hd_pcm_variant(1, 1_100_000);
    let path = format!("{}/encode_hd_reset.perf.bin", dir);
    if write_file(&path, &pcm_hd) {
        lines.push(format!("perf encode_hd_reset {}", path));
    }

    let enc_std = unsafe {
        let (enc, _, _, _) = encode_all(0, &pcm_std);
        enc
    };
    let path = format!("{}/decode_std.perf.bin", dir);
    if write_file(&path, &enc_std) {
        lines.push(format!("perf decode_std {}", path));
    }

    let enc_hd = unsafe {
        let (enc, _, _, _) = encode_all(1, &pcm_hd);
        enc
    };
    let mut sync_perf = Vec::with_capacity(enc_hd.len() + 8);
    sync_perf.extend_from_slice(&[0xF0, 0x0D, 0xCA, 0xFE, 0x01, 0x23, 0x45]);
    sync_perf.extend_from_slice(&enc_hd);
    let path = format!("{}/decode_sync_hd.perf.bin", dir);
    if write_file(&path, &sync_perf) {
        lines.push(format!("perf decode_sync_hd {}", path));
    }

    lines
}
