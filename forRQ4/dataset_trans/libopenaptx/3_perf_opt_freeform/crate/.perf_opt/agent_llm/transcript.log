#[inline]
fn clip_intp2(mut a: int32_t, mut p: c_uint) -> int32_t {
    let limit = (1u32 << p) as int32_t;
    if a < -limit || a > limit - 1 {
        (a >> 31) ^ (limit - 1)
    } else {
        a
    }
}
