        i = i.wrapping_add(1);
    }
    *low_subband_output = clip_intp2(
        subbands[0 as c_int as usize] + subbands[1 as c_int as usize],
        23 as c_uint,
    );
    *high_subband_output = clip_intp2(
        subbands[0 as c_int as usize] - subbands[1 as c_int as usize],
        23 as c_uint,
    );
}
