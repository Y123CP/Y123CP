          "replacement_function_source": "unsafe fn aptx_reconstructed_differences_update(\n    mut prediction: *mut aptx_prediction,\n    mut reconstructed_difference: int32_t,\n    mut order: c_int,\n) -> *mut int32_t {\n    let prediction_view: &mut aptx_prediction = unsafe { &mut *prediction }; // SAFETY: caller provides a valid, uniquely mutable pointer to aptx_prediction for the duration of this function.\n\n    let base = prediction_view.reconstructed_differences.as_mut_ptr();\n    let p = prediction_view.pos as c_int;\n\n    unsafe {\n        // SAFETY: `base` points to the 48-element `reconstructed_differences` array; callers/original code require `order` and `pos` to be in-range for these accesses.\n        *base.add(p as usize) = *base.add((order + p) as usize);\n    }\n\n    let new_p = if p + 1 == order { 0 } else { p + 1 };\n    prediction_view.pos = new_p as int32_t;\n\n    let out = unsafe {\n        // SAFETY: same bounds preconditions as above; `order + new_p` indexes the second half/window exactly as in the original code.\n        base.add((order + new_p) as usize)\n    };\n    unsafe {\n        // SAFETY: `out` was derived from the valid `base` pointer with the same in-bounds preconditions as the original code.\n        *out = reconstructed_difference;\n    }\n    out\n}",
