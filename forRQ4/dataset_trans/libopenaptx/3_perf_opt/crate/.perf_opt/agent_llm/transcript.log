// Applied rules: [III④, C3]
// Skipped rules: [C3.S1: Not chosen: changing `prediction: *mut aptx_prediction` to `&mut aptx_prediction` would require caller analysis and cross-function signature rewrite, while the same local aliasing recovery can be achieved in-body for this private helper.]
unsafe fn aptx_reconstructed_differences_update(
    mut prediction: *mut aptx_prediction,
    mut reconstructed_difference: int32_t,
    mut order: c_int,
) -> *mut int32_t {
    let prediction_view: &mut aptx_prediction = unsafe { &mut *prediction };
    let p: c_int = prediction_view.pos as c_int;
    let next_p: c_int = (p + 1 as c_int) % order;
    let order_usize = order as usize;
    let p_usize = p as usize;
    let next_p_usize = next_p as usize;

    let reconstructed_differences: &mut [int32_t] = &mut prediction_view.reconstructed_differences;
    let (rd1, rd2) = reconstructed_differences.split_at_mut(order_usize);

    rd1[p_usize] = rd2[p_usize];
    prediction_view.pos = next_p as int32_t;
    rd2[next_p_usize] = reconstructed_difference;
    &mut rd2[next_p_usize] as *mut int32_t
}
```
