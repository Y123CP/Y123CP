#[inline]
unsafe fn aptx_qmf_polyphase_analysis(
    mut signal: *mut aptx_filter_signal,
    mut coeffs: *const [int32_t; 16],
    mut shift: c_uint,
    mut samples: *const int32_t,
    mut low_subband_output: *mut int32_t,
    mut high_subband_output: *mut int32_t,
