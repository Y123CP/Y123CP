          "replacement_region_source": "hclen = 15 as c_uint;\nwhile hclen > 0 as c_uint\n    && clcounts[order[hclen\n        .wrapping_add(4 as c_uint)\n        .wrapping_sub(1 as c_uint) as usize] as usize]\n        == 0 as size_t\n{\n    hclen = hclen.wrapping_sub(1);\n}\nif size_only == 0 {\n    AddBits(hlit, 5 as c_uint, bp, out, outsize);\n    AddBits(hdist, 5 as c_uint, bp, out, outsize);\n    AddBits(hclen, 4 as c_uint, bp, out, outsize);\n    i = 0 as size_t;\n    while i < hclen.wrapping_add(4 as c_uint) as size_t {\n        let order_idx = i as usize;\n        // SAFETY: i < hclen + 4 by the loop bound, and hclen starts at 15 then only decreases,\n        // so i < 19 and order_idx is in-bounds for the 19-element `order` table.\n        let ord = unsafe { *order.get_unchecked(order_idx) } as usize;\n        // SAFETY: `ord` comes from the fixed deflate code-length order table whose values are all in 0..19.\n        let cl = unsafe { *clcl.get_unchecked(ord) };\n        AddBits(cl, 3 as c_uint, bp, out, outsize);\n        i = i.wrapping_add(1);\n    }\n    i = 0 as size_t;\n    while i < rle_size {\n        let symbol = *rle.offset(i as isize);\n        let bits = *rle_bits.offset(i as isize);\n        let symbol_idx = symbol as usize;\n        let symbol_0: c_uint = clsymbols[symbol_idx];\n        AddHuffmanBits(symbol_0, clcl[symbol_idx], bp, out, outsize);\n        if symbol == 16 as c_uint {\n            AddBits(bits, 2 as c_uint, bp, out, outsize);\n        } else if symbol == 17 as c_uint {\n            AddBits(bits, 3 as c_uint, bp, out, outsize);\n        } else if symbol == 18 as c_uint {\n            AddBits(bits, 7 as c_uint, bp, out, outsize);\n        }\n        i = i.wrapping_add(1);\n    }\n}\nresult_size = result_size.wrapping_add(14 as size_t);\nresult_size = result_size.wrapping_add(\n    hclen\n        .wrapping_add(4 as c_uint)\n        .wrapping_mul(3 as c_uint) as size_t,\n);\ni = 0 as size_t;\nwhile i < 19 as size_t {\n    result_size = result_size\n        .wrapping_add((clcl[i as usize] as size_t).wrapping_mul(clcounts[i as usize]));\n    i = i.wrapping_add(1);\n}\nresult_size = result_size\n    .wrapping_add(clcounts[16 as c_int as usize].wrapping_mul(2 as size_t));\nresult_size = result_size\n    .wrapping_add(clcounts[17 as c_int as usize].wrapping_mul(3 as size_t));\nresult_size = result_size\n    .wrapping_add(clcounts[18 as c_int as usize].wrapping_mul(7 as size_t));\nfree(rle as *mut c_void);\nfree(rle_bits as *mut c_void);\nreturn result_size;",
