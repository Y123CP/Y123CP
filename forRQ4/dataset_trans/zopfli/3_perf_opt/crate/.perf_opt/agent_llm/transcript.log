        // index range including index `length`. This mutable slice is the only mutable view
        // created for this output region in this function.
        core::slice::from_raw_parts_mut(sublen, length.wrapping_add(1))
    };

    while j < ZOPFLI_CACHE_LENGTH as size_t {
        let row = &cache[j.wrapping_mul(3 as size_t)..j.wrapping_mul(3 as size_t).wrapping_add(3)];
