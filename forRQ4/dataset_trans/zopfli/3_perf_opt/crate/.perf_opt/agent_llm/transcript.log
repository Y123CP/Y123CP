    log2sum = (if sum == 0 as c_uint {
        log(n as c_double)
    } else {
        log(sum as c_double)
    }) * kInvLog2;
    i = 0 as c_uint;
    while (i as size_t) < n {
        if *count.offset(i as isize) == 0 as size_t {
            *bitlengths.offset(i as isize) = log2sum;
