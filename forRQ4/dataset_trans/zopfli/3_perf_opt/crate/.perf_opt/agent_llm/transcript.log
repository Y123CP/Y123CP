        if lastcount < numsymbols && sum > (*leaves.offset(lastcount as isize)).weight {
            InitNode(
                (*leaves.offset(lastcount as isize)).weight,
                lastcount + 1 as c_int,
                (*oldchain).tail,
                newchain,
