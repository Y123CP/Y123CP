        core::slice::from_raw_parts_mut(dist_ptr, blocksize)
    };
    for dst in dist_slice.iter_mut() {
        *dst = 0 as c_ushort;
    }

    let sublen_slice = unsafe {
        // SAFETY: `sublen_ptr` was just allocated for `sublen_len` `c_uchar` elements,
        // is used here as the only mutable view, and `sublen_len` is the exact length.
        core::slice::from_raw_parts_mut(sublen_ptr, sublen_len)
    };
    for dst in sublen_slice.iter_mut() {
        *dst = 0 as c_uchar;
    }
}
