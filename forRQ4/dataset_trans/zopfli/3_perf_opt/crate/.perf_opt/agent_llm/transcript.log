        } else {
            InitNode(
                sum,
                lastcount,
                (*lists.offset((index - 1 as c_int) as isize))
                    [1 as c_int as usize],
                newchain,
            );
            BoundaryPM(
                lists,
                leaves,
                numsymbols,
                pool,
                index - 1 as c_int,
            );
            BoundaryPM(
                lists,
                leaves,
                numsymbols,
                pool,
                index - 1 as c_int,
