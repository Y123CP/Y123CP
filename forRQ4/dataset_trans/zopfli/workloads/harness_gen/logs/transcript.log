fn write_seed_files_for_op(dir: &str, op: &str, s1: &[u8], s2: &[u8], out: &mut Vec<String>) {
    let p1 = format!("{}/{}.1.bin", dir, op);
    let p2 = format!("{}/{}.2.bin", dir, op);
    fs::write(&p1, s1).unwrap();
    fs::write(&p2, s2).unwrap();
    out.push(format!("seed {} {}", op, p1));
    out.push(format!("seed {} {}", op, p2));
}

pub fn op_raw_deflate(data: &[u8], iters: u64) -> String {
    let input_ck = checksum_bytes(data);
    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut options = MaybeUninit::<zopfli_raw::src::util::ZopfliOptions>::zeroed();
            ZopfliInitOptions(options.as_mut_ptr());

            let mut bp: c_uchar = 0;
            let mut out: *mut c_uchar = ptr::null_mut();
            let mut outsize: usize = 0;

            ZopfliDeflate(
                options.as_ptr() as *const _,
                2,
                1,
                data.as_ptr(),
                data.len(),
                &mut bp,
                &mut out,
                &mut outsize,
            );

            let out_slice = if out.is_null() || outsize == 0 {
                &[][..]
            } else {
                std::slice::from_raw_parts(out as *const u8, outsize)
            };

            let mut d = 0u64;
            d = fold(d, input_ck);
            d = fold(d, outsize as u64);
            d = fold(d, (!out.is_null()) as u64);
            d = fold(d, bp as u64);
            d = fold(d, sample_slice_digest(out_slice));
            digest = fold(digest, d);

            free_c_ptr(out);
        }
    }

    format!("op=raw_deflate digest={:016x}", digest)
}

pub fn op_zlib_compress(data: &[u8], iters: u64) -> String {
    let input_ck = checksum_bytes(data);
    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut options = MaybeUninit::<zopfli_raw::src::util::ZopfliOptions>::zeroed();
            ZopfliInitOptions(options.as_mut_ptr());

            let mut out: *mut c_uchar = ptr::null_mut();
            let mut outsize: usize = 0;

            ZopfliZlibCompress(
                options.as_ptr() as *const _,
                data.as_ptr(),
                data.len(),
                &mut out,
                &mut outsize,
            );

            let out_slice = if out.is_null() || outsize == 0 {
                &[][..]
            } else {
                std::slice::from_raw_parts(out as *const u8, outsize)
            };

            let mut d = 0u64;
            d = fold(d, input_ck);
            d = fold(d, outsize as u64);
            d = fold(d, (!out.is_null()) as u64);
            d = fold(d, sample_slice_digest(out_slice));
            digest = fold(digest, d);

            free_c_ptr(out);
        }
    }

    format!("op=zlib_compress digest={:016x}", digest)
}

pub fn op_lz77_blocksplit_analysis(data: &[u8], iters: u64) -> String {
    let input_ck = checksum_bytes(data);
    let mut digest = 0u64;
    let window_size = 32_768usize;

    for _ in 0..iters {
        unsafe {
            let mut options = MaybeUninit::<zopfli_raw::src::util::ZopfliOptions>::zeroed();
            ZopfliInitOptions(options.as_mut_ptr());

            let mut state = MaybeUninit::<zopfli_raw::src::lz77::ZopfliBlockState>::zeroed();
            ZopfliInitBlockState(
                options.as_ptr() as *const _,
                0,
                data.len(),
                1,
                state.as_mut_ptr(),
            );

            let mut store = MaybeUninit::<zopfli_raw::src::lz77::ZopfliLZ77Store>::zeroed();
            ZopfliInitLZ77Store(data.as_ptr(), store.as_mut_ptr());

            let mut h = MaybeUninit::<zopfli_raw::src::hash::ZopfliHash>::zeroed();
            ZopfliAllocHash(window_size, h.as_mut_ptr());
            ZopfliResetHash(window_size, h.as_mut_ptr());
            ZopfliWarmupHash(data.as_ptr(), 0, data.len(), h.as_mut_ptr());
            ZopfliUpdateHash(data.as_ptr(), 0, data.len(), h.as_mut_ptr());

            ZopfliLZ77Greedy(
                state.as_mut_ptr(),
                data.as_ptr(),
                0,
                data.len(),
                store.as_mut_ptr(),
                h.as_mut_ptr() as *mut _,
            );

            let lzsize = (*store.as_ptr()).size;

            let byte_range = ZopfliLZ77GetByteRange(store.as_ptr(), 0, lzsize);

            let mut ll_counts = vec![0usize; 288];
            let mut d_counts = vec![0usize; 32];
            ZopfliLZ77GetHistogram(
                store.as_ptr(),
                0,
                lzsize,
                ll_counts.as_mut_ptr(),
                d_counts.as_mut_ptr(),
            );

            let block_cost_fixed = ZopfliCalculateBlockSize(store.as_ptr() as *const _, 0, lzsize, 1);
            let block_cost_dynamic =
                ZopfliCalculateBlockSizeAutoType(store.as_ptr() as *const _, 0, lzsize);

            let mut raw_splitpoints: *mut usize = ptr::null_mut();
            let mut raw_npoints: usize = 0;
            ZopfliBlockSplit(
                options.as_ptr() as *const _,
                data.as_ptr(),
                0,
                data.len(),
                16,
                &mut raw_splitpoints,
                &mut raw_npoints,
            );

            let raw_points = if raw_splitpoints.is_null() || raw_npoints == 0 {
                &[][..]
            } else {
                std::slice::from_raw_parts(raw_splitpoints as *const usize, raw_npoints)
            };

            let mut lz_splitpoints: *mut usize = ptr::null_mut();
            let mut lz_npoints: usize = 0;
            ZopfliBlockSplitLZ77(
                options.as_ptr() as *const _,
                store.as_ptr() as *const _,
                16,
                &mut lz_splitpoints,
                &mut lz_npoints,
            );

            let lz_points = if lz_splitpoints.is_null() || lz_npoints == 0 {
                &[][..]
            } else {
                std::slice::from_raw_parts(lz_splitpoints as *const usize, lz_npoints)
            };

            let mut raw_sum = 0u64;
            let mut raw_xor = 0u64;
            for &p in raw_points {
                raw_sum = raw_sum.wrapping_add(p as u64);
                raw_xor ^= p as u64;
            }

            let mut lz_sum = 0u64;
            let mut lz_xor = 0u64;
            for &p in lz_points {
                lz_sum = lz_sum.wrapping_add(p as u64);
                lz_xor ^= p as u64;
            }

            let ll_total = ll_counts.iter().copied().fold(0usize, |a, b| a.wrapping_add(b));
            let d_total = d_counts.iter().copied().fold(0usize, |a, b| a.wrapping_add(b));
            let ll_head = ll_counts
                .iter()
                .take(16)
                .copied()
                .fold(0usize, |a, b| a.wrapping_add(b));
            let d_head = d_counts
                .iter()
                .take(8)
                .copied()
                .fold(0usize, |a, b| a.wrapping_add(b));

            let mut d = 0u64;
            d = fold(d, input_ck);
            d = fold(d, byte_range as u64);
            d = fold(d, lzsize as u64);
            d = fold(d, ll_total as u64);
            d = fold(d, d_total as u64);
            d = fold(d, ll_head as u64);
            d = fold(d, d_head as u64);
            d = fold(d, block_cost_fixed.to_bits());
            d = fold(d, block_cost_dynamic.to_bits());
            d = fold(d, raw_npoints as u64);
            d = fold(d, raw_sum);
            d = fold(d, raw_xor);
            d = fold(d, lz_npoints as u64);
            d = fold(d, lz_sum);
            d = fold(d, lz_xor);
            digest = fold(digest, d);

            free_c_ptr(raw_splitpoints);
            free_c_ptr(lz_splitpoints);
            ZopfliCleanHash(h.as_mut_ptr());
            ZopfliCleanLZ77Store(store.as_mut_ptr());
            ZopfliCleanBlockState(state.as_mut_ptr());
        }
    }

    format!("op=lz77_blocksplit_analysis digest={:016x}", digest)
}

pub fn op_tree_codegen(data: &[u8], iters: u64) -> String {
    let input_ck = checksum_bytes(data);

    let mut freqs = vec![0usize; 256];
    for &b in data {
        freqs[b as usize] = freqs[b as usize].wrapping_add(1);
    }
    if freqs.iter().all(|&x| x == 0) {
        freqs[0] = 1;
    }

    let mut digest = 0u64;
    for _ in 0..iters {
        let mut entropy = vec![0f64; 256];
        let mut bitlengths = vec![0u32; 256];
        let mut ll_bitlengths = vec![0u32; 256];
        let mut symbols = vec![0u32; 256];

        let mut counts_for_rle = freqs.clone();
        unsafe {
            OptimizeHuffmanForRle(counts_for_rle.len() as c_int, counts_for_rle.as_mut_ptr());
            ZopfliCalculateEntropy(freqs.as_ptr(), freqs.len(), entropy.as_mut_ptr());
            ZopfliCalculateBitLengths(freqs.as_ptr(), freqs.len(), 15, bitlengths.as_mut_ptr());
            let rc = ZopfliLengthLimitedCodeLengths(
                counts_for_rle.as_ptr(),
                counts_for_rle.len() as c_int,
                15,
                ll_bitlengths.as_mut_ptr(),
            );
            ZopfliLengthsToSymbols(
                ll_bitlengths.as_ptr(),
                ll_bitlengths.len(),
                15,
                symbols.as_mut_ptr(),
            );

            let sum_bl = bitlengths
                .iter()
                .copied()
                .fold(0u64, |a, b| a.wrapping_add(b as u64));
            let sum_ll = ll_bitlengths
                .iter()
                .copied()
                .fold(0u64, |a, b| a.wrapping_add(b as u64));
            let sum_sym = symbols
                .iter()
                .copied()
                .fold(0u64, |a, b| a.wrapping_add(b as u64));

            let mut d = 0u64;
            d = fold(d, input_ck);
            d = fold(d, rc as u64);
            d = fold(d, sum_bl);
            d = fold(d, sum_ll);
            d = fold(d, sum_sym);

            for &idx in &[0usize, 1, 10, 65, 127, 255] {
                d = fold(d, entropy[idx].to_bits());
                d = fold(d, bitlengths[idx] as u64);
                d = fold(d, ll_bitlengths[idx] as u64);
                d = fold(d, symbols[idx] as u64);
            }

            digest = fold(digest, d);
        }
    }

    format!("op=tree_codegen digest={:016x}", digest)
}

pub fn op_cache_roundtrip(data: &[u8], iters: u64) -> String {
    let input_ck = checksum_bytes(data);
    let blocksize = data.len().clamp(1, 1024);
    let positions = blocksize.min(8);
    let mut digest = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut cache = MaybeUninit::<zopfli_raw::src::cache::ZopfliLongestMatchCache>::zeroed();
            ZopfliInitCache(blocksize, cache.as_mut_ptr());

            for pos in 0..positions {
                let seed = data.get(pos).copied().unwrap_or((pos as u8).wrapping_mul(17));
                let length = 3usize + (seed as usize % 32);
                let mut sublen = [0u16; 259];
                for l in 3..=length {
                    let val = (((pos + l) * 13) ^ (seed as usize) ^ (blocksize * 3)) % 32_768;
                    sublen[l] = val as c_ushort;
                }
                ZopfliSublenToCache(sublen.as_ptr(), pos, length, cache.as_mut_ptr());
            }

            let mut recovered_sum = 0u64;
            let mut max_sum = 0u64;

            for pos in 0..positions {
                let seed = data.get(pos).copied().unwrap_or((pos as u8).wrapping_mul(17));
                let length = 3usize + (seed as usize % 32);
                let mut recovered = [0u16; 259];
                ZopfliCacheToSublen(cache.as_ptr(), pos, length, recovered.as_mut_ptr());
                let max_cached = ZopfliMaxCachedSublen(cache.as_ptr(), pos, length);

                let mut local = 0u64;
                for &idx in &[3usize, length / 2 + 2, length] {
                    if idx < recovered.len() {
                        local = fold(local, recovered[idx] as u64);
                    }
                }
                recovered_sum = recovered_sum.wrapping_add(local);
                max_sum = max_sum.wrapping_add(max_cached as u64);
            }

            let mut d = 0u64;
            d = fold(d, input_ck);
            d = fold(d, blocksize as u64);
            d = fold(d, positions as u64);
            d = fold(d, recovered_sum);
            d = fold(d, max_sum);
            digest = fold(digest, d);

            ZopfliCleanCache(cache.as_mut_ptr());
        }
    }

    format!("op=cache_roundtrip digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("raw_deflate", op_raw_deflate as fn(&[u8], u64) -> String),
        ("zlib_compress", op_zlib_compress as fn(&[u8], u64) -> String),
        (
            "lz77_blocksplit_analysis",
            op_lz77_blocksplit_analysis as fn(&[u8], u64) -> String,
        ),
        ("tree_codegen", op_tree_codegen as fn(&[u8], u64) -> String),
        (
            "cache_roundtrip",
            op_cache_roundtrip as fn(&[u8], u64) -> String,
        ),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let s1 = make_corpus_one();
    let s2 = make_corpus_two();
    let mut lines = Vec::new();

    for op in [
        "raw_deflate",
        "zlib_compress",
        "lz77_blocksplit_analysis",
        "tree_codegen",
        "cache_roundtrip",
    ] {
        write_seed_files_for_op(dir, op, &s1, &s2, &mut lines);
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let big = make_perf_corpus();
    let mut lines = Vec::new();

    for op in ["raw_deflate", "zlib_compress", "lz77_blocksplit_analysis"] {
        let path = format!("{}/{}.perf.bin", dir, op);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf {} {}", op, path));
    }

    lines
}
