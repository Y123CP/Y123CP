                    0 => "INFO",
                    1 => "WARN",
                    2 => "DEBUG",
                    3 => "TRACE",
                    _ => "ERROR",
                };
                let service = match (day + hour) % 6 {
                    0 => "auth",
                    1 => "search",
                    2 => "billing",
                    3 => "cache",
                    4 => "worker",
                    _ => "frontend",
                };
                let region = match day % 4 {
                    0 => "eu-west-1",
                    1 => "us-east-1",
                    2 => "ap-south-1",
                    _ => "sa-east-1",
                };
                let line = format!(
                    "2024-05-{day:02}T{hour:02}:{minute:02}:00Z level={level} service={service} region={region} req_id=req-{day:02}{hour:02}{minute:02} user=user{:04} msg=\"operation completed\" path=/api/v1/{service}/items/{:03} status={} bytes={} retry={} note=Café-Δ\n",
                    (day * 17 + hour * 13 + minute) % 10000,
                    (day + hour + minute) % 200,
                    if level == "ERROR" { 500 } else { 200 + ((day + hour) % 5) },
                    1200 + ((day * 31 + hour * 7 + minute) % 9000),
                    (minute / 15) % 3
                );
                v.extend_from_slice(line.as_bytes());
                if hour % 6 == 0 {
                    let extra = format!(
                        "kv session=sess-{day:02}-{hour:02} shard={} feature=rollout bucket={} msg=\"prefix_common prefix_common prefix_common\"\n",
                        (day + hour) % 32,
                        (day * 9 + hour * 5) % 100
                    );
                    v.extend_from_slice(extra.as_bytes());
                }
            }
        }
    }
    v
}

