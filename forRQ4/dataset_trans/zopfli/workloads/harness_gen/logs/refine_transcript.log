fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9e37_79b9_7f4a_7c15)
}

fn checksum_bytes(data: &[u8]) -> u64 {
    let mut acc = 0x243f_6a88_85a3_08d3u64;
    for &b in data {
        acc = fold(acc, b as u64);
    }
    acc ^ (data.len() as u64).wrapping_mul(0x1000_0000_01b3)
}

fn sample_slice_digest(data: &[u8]) -> u64 {
    let mut acc = 0u64;
    let len = data.len();
    let idxs = [
        0usize,
        1,
        2,
        3,
        len.saturating_div(3),
        len.saturating_div(2),
        len.saturating_mul(2).saturating_div(3),
        len.saturating_sub(4),
        len.saturating_sub(3),
        len.saturating_sub(2),
        len.saturating_sub(1),
    ];
    for &i in &idxs {
        if let Some(&b) = data.get(i) {
            acc = fold(acc, ((i as u64) << 8) ^ (b as u64));
        } else {
            acc = fold(acc, (i as u64) ^ 0xff00);
        }
    }
    acc
}

unsafe fn free_c_ptr<T>(p: *mut T) {
    if !p.is_null() {
        free(p as *mut c_void);
    }
}

fn make_corpus_one() -> Vec<u8> {
    let mut v = Vec::new();
    for day in 1..=28u32 {
