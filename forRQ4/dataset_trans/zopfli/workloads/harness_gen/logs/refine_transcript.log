            block.wrapping_mul(104729) ^ 0x55aa33,
            block % 1000,
            if block % 9 == 0 {
                "UTF8-данные"
            } else if block % 9 == 1 {
                "UTF8-日本語"
            } else {
                "UTF8-normal"
            },
            if block % 11 == 0 { "false" } else { "true" }
        );
        v.extend_from_slice(template.as_bytes());
        if block % 8 == 0 {
            v.extend_from_slice(
                b"copy-range|AAAAABBBBBCCCCCDDDDDEEEEE|AAAAABBBBBCCCCCDDDDDEEEEE|AAAAABBBBBCCCCCDDDDDEEEEE\n",
            );
        }
        if block % 13 == 0 {
            let hdr = format!(
                "header version=3 source=node-{:03} partition={} watermark={} comment=\"repeated repeated repeated marker\"\n",
                block % 97,
                block % 16,
                1_700_000_000u64 + block as u64
            );
            v.extend_from_slice(hdr.as_bytes());
        }
    }
    v
}

fn make_perf_corpus() -> Vec<u8> {
    let mut v = Vec::new();
    for chunk in 0..22_000u32 {
        let app = match chunk % 6 {
            0 => "payments",
            1 => "search",
            2 => "gateway",
            3 => "worker",
            4 => "notifier",
            _ => "profile",
        };
        let status = if chunk % 29 == 0 {
            503
        } else if chunk % 17 == 0 {
            429
        } else {
            200
        };
        let line1 = format!(
            "ts=2024-06-{:02}T{:02}:{:02}:{:02}Z app={app} env=prod cluster=c{:02} pod={app}-{:05} req=req-{:08} path=/v1/{app}/resource/{:04} status={status} bytes={} latency_ms={} user=u{:06} msg=\"request completed with repeated common prefix\"\n",
            (chunk % 28) + 1,
            chunk % 24,
            (chunk / 2) % 60,
            (chunk / 3) % 60,
            chunk % 12,
            chunk % 10000,
            chunk.wrapping_mul(2654435761),
            chunk % 4096,
            700 + (chunk % 8000),
            1 + (chunk % 250),
            chunk % 500000
        );
        let line2 = format!(
            "metrics cpu={} mem_mb={} queue={} region={} flags=hot,cacheable,stable body=\"aaaaaaaaabbbbbbbbbbccccccccccddddddddddeeeeeeeeee copied-fragment copied-fragment copied-fragment\"\n",
            20 + (chunk % 70),
            256 + (chunk % 2048),
            chunk % 1000,
            match chunk % 4 {
                0 => "us-east",
                1 => "eu-west",
                2 => "ap-south",
                _ => "sa-east",
            }
        );
        v.extend_from_slice(line1.as_bytes());
        v.extend_from_slice(line2.as_bytes());
