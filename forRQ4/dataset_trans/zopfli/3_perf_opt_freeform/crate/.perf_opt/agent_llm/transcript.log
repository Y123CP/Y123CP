    let mut cache_available: c_uchar = (!s_view.lmc.is_null()
        && (*(*s_view.lmc).length.offset(lmcpos as isize) as c_int
            == 0 as c_int
            || *(*s_view.lmc).dist.offset(lmcpos as isize) as c_int
                != 0 as c_int))
