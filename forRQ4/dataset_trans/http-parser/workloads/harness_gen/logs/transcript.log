fn write_seed(dir: &str, op: &str, idx: usize, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.{}.bin", dir, op, idx);
    fs::write(&path, bytes).unwrap();
    out.push(format!("seed {} {}", op, path));
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let req1 = b"POST /chunked-ok HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nConnection: keep-alive\r\nX-Lenient: value\twith-tab\r\n\r\n5\r\nhello\r\n0\r\n\r\n";
    let req2 = b"GET http://user:pass@example.com:8080/a/b?x=1&y=two HTTP/1.1\r\nHost: example.com\r\nUser-Agent: harness\r\nAccept: */*\r\nConnection: close\r\nX-Weird@Header: lenient\r\n\r\n";
    write_seed(dir, "execute_request_stream", 1, req1, &mut out);
    write_seed(dir, "execute_request_stream", 2, req2, &mut out);

    let resp1 = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 11\r\nConnection: keep-alive\r\nX-Server\tHint: lenient\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n";
    let resp2 = b"HTTP/1.0 204 No Content\r\nConnection: close\r\nContent-Length: 0\r\nX-Test@Resp: value\r\n\r\n";
    write_seed(dir, "execute_response_stream", 1, resp1, &mut out);
    write_seed(dir, "execute_response_stream", 2, resp2, &mut out);

    let pause1 = b"POST /upload HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 24\r\nConnection: keep-alive\r\nX-Pause: lenient\tresume\r\n\r\nc\r\nabcdefghijkl\r\nc\r\nmnopqrstuvwx\r\n0\r\n\r\n";
    let pause2 = b"GET /very/long/path/with/query?alpha=1&beta=two&gamma=three HTTP/1.1\r\nHost: example.com\r\nUser-Agent: pause-test\r\nX-Extra@Odd: 1234567890abcdef\r\nConnection: close\r\n\r\n";
    write_seed(dir, "pause_resume_request", 1, pause1, &mut out);
    write_seed(dir, "pause_resume_request", 2, pause2, &mut out);

    let url1 = b"https://user:pass@example.com:8443/a/b/c?x=1&y=two#frag";
    let url2 = b"example.com:443";
    write_seed(dir, "parse_url_and_meta", 1, url1, &mut out);
    write_seed(dir, "parse_url_and_meta", 2, url2, &mut out);

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let mut req_big = Vec::new();
    for i in 0..80_000u32 {
        let body = format!("item={}&value={}&ok=true&tag=lenient", i, i.wrapping_mul(7));
        let msg = if i % 2 == 0 {
            format!(
                "POST /api/v1/update?id={} HTTP/1.1\r\nHost: example.com\r\nUser-Agent: perf-client/1.0\r\nAccept: */*\r\nConnection: keep-alive\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: {}\r\nX-Trace@Perf: {:08x}\r\n\r\n{}",
                i,
                body.len(),
                i ^ 0x55aa_33cc,
                body
            )
        } else {
            let chunk_a = &body[..body.len() / 2];
            let chunk_b = &body[body.len() / 2..];
            format!(
                "POST /api/v1/update?id={} HTTP/1.1\r\nHost: example.com\r\nUser-Agent: perf-client/1.0\r\nAccept: */*\r\nConnection: keep-alive\r\nTransfer-Encoding: chunked\r\nContent-Length: {}\r\nX-Lenient: value\t{}\r\n\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n0\r\n\r\n",
                i,
                body.len(),
                i,
                chunk_a.len(),
                chunk_a,
                chunk_b.len(),
                chunk_b
            )
        };
        req_big.extend_from_slice(msg.as_bytes());
    }
    let req_path = format!("{}/execute_request_stream.perf.bin", dir);
    fs::write(&req_path, &req_big).unwrap();
    out.push(format!("perf execute_request_stream {}", req_path));

    let mut resp_big = Vec::new();
    for i in 0..70_000u32 {
        let body = format!(
            "<html><body><h1>OK {}</h1><p>value={}</p><p>tag=response</p></body></html>",
            i,
            i.wrapping_mul(13)
        );
        let msg = if i % 2 == 0 {
            format!(
                "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: keep-alive\r\nContent-Type: text/html\r\nServer: perf-server\r\nX-Req-Id@Perf: {:08x}\r\n\r\n{}",
                body.len(),
                i ^ 0xa5a5_1234,
                body
            )
        } else {
            let chunk_a = &body[..body.len() / 2];
            let chunk_b = &body[body.len() / 2..];
            format!(
                "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: {}\r\nConnection: keep-alive\r\nContent-Type: text/html\r\nServer: perf-server\r\nX-Mode: lenient\tchunked\r\n\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n0\r\n\r\n",
                body.len(),
                chunk_a.len(),
                chunk_a,
                chunk_b.len(),
                chunk_b
            )
        };
        resp_big.extend_from_slice(msg.as_bytes());
    }
    let resp_path = format!("{}/execute_response_stream.perf.bin", dir);
    fs::write(&resp_path, &resp_big).unwrap();
    out.push(format!("perf execute_response_stream {}", resp_path));

    let mut pause_big = Vec::new();
    for i in 0..60_000u32 {
        let body = format!("segment={}&payload=abcdefghijklmnopqrstuvwxyz{}", i, i ^ 0x1234);
        let mid = body.len() / 2;
        let a = &body[..mid];
        let b = &body[mid..];
        let msg = format!(
            "POST /stream/{} HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: {}\r\nConnection: keep-alive\r\nX-Pause@Perf: {}\tresume\r\n\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n0\r\n\r\n",
            i,
            body.len(),
            i,
            a.len(),
            a,
            b.len(),
            b
        );
        pause_big.extend_from_slice(msg.as_bytes());
    }
    let pause_path = format!("{}/pause_resume_request.perf.bin", dir);
    fs::write(&pause_path, &pause_big).unwrap();
    out.push(format!("perf pause_resume_request {}", pause_path));

    out
}
