            h = fold(h, parsed as u64);
            h = fold(h, (*p).allow_chunked_length() as u64);
            h = fold(h, (*p).lenient_http_headers() as u64);

            // Also clone the parser and digest the clone
            let mut parser2: http_parser = (*p).clone();
            let p2 = &mut parser2 as *mut http_parser;
            let h2 = digest_parser(p2);
            h = fold(h, h2);

            digest = fold(digest, h);
        }
    }
    format!("op=parse_response_chunked_lenient digest={:016x}", digest)
