fn wrapping_fold(acc: u64, val: u64) -> u64 {
    acc.wrapping_mul(6364136223846793005).wrapping_add(val)
}

fn parse_request_runner(input: &[u8], iters: u64) -> String {
    let mut checksum: u64 = 0;
    for _ in 0..iters {
        let mut iter_hash: u64 = 0;
        unsafe {
            let mut parser: http_parser = std::mem::zeroed();
            let mut settings: http_parser_settings = std::mem::zeroed();
            http_parser_settings_init(&mut settings);
            http_parser_init(&mut parser, http_parser_type::HTTP_REQUEST);

            let parsed = http_parser_execute(
                &mut parser,
                &settings,
                input.as_ptr() as *const ::core::ffi::c_char,
                input.len(),
            );

            iter_hash = wrapping_fold(iter_hash, parsed as u64);

            // Access bit fields via the parser struct
            // http_errno is stored in bits; we read it via the getter pattern
            // The c2rust struct uses bitfields; we need to read them carefully
            let errno_val = parser.http_errno();
            let method_val = parser.method();
            let status_code = parser.status_code;
            let http_major = parser.http_major as u64;
            let http_minor = parser.http_minor as u64;

            iter_hash = wrapping_fold(iter_hash, errno_val as u64);
            iter_hash = wrapping_fold(iter_hash, method_val as u64);
            iter_hash = wrapping_fold(iter_hash, status_code as u64);
            iter_hash = wrapping_fold(iter_hash, http_major);
            iter_hash = wrapping_fold(iter_hash, http_minor);

            let keep_alive = http_should_keep_alive(&parser);
            let body_final = http_body_is_final(&parser);
            let needs_eof = http_message_needs_eof(&parser);

            iter_hash = wrapping_fold(iter_hash, keep_alive as u64);
            iter_hash = wrapping_fold(iter_hash, body_final as u64);
            iter_hash = wrapping_fold(iter_hash, needs_eof as u64);
        }
        checksum = wrapping_fold(checksum, iter_hash);
    }
    format!("op=parse_request digest={}", checksum)
}

fn parse_response_runner(input: &[u8], iters: u64) -> String {
    let mut checksum: u64 = 0;
    for _ in 0..iters {
        let mut iter_hash: u64 = 0;
        unsafe {
            let mut parser: http_parser = std::mem::zeroed();
            let mut settings: http_parser_settings = std::mem::zeroed();
            http_parser_settings_init(&mut settings);
            http_parser_init(&mut parser, http_parser_type::HTTP_RESPONSE);

            let parsed = http_parser_execute(
                &mut parser,
                &settings,
                input.as_ptr() as *const ::core::ffi::c_char,
                input.len(),
            );

            iter_hash = wrapping_fold(iter_hash, parsed as u64);

            let errno_val = parser.http_errno();
            let status_code = parser.status_code;
            let http_major = parser.http_major as u64;
            let http_minor = parser.http_minor as u64;

            iter_hash = wrapping_fold(iter_hash, errno_val as u64);
            iter_hash = wrapping_fold(iter_hash, status_code as u64);
            iter_hash = wrapping_fold(iter_hash, http_major);
            iter_hash = wrapping_fold(iter_hash, http_minor);

            let keep_alive = http_should_keep_alive(&parser);
            let body_final = http_body_is_final(&parser);
            let needs_eof = http_message_needs_eof(&parser);

            iter_hash = wrapping_fold(iter_hash, keep_alive as u64);
            iter_hash = wrapping_fold(iter_hash, body_final as u64);
            iter_hash = wrapping_fold(iter_hash, needs_eof as u64);

            // Fold errno name and description lengths
            let err_enum: http_errno = std::mem::transmute(errno_val);
            let name_ptr = http_errno_name(err_enum);
            if !name_ptr.is_null() {
                let name_len = libc_strlen(name_ptr);
                iter_hash = wrapping_fold(iter_hash, name_len as u64);
            }
            let desc_ptr = http_errno_description(err_enum);
            if !desc_ptr.is_null() {
                let desc_len = libc_strlen(desc_ptr);
                iter_hash = wrapping_fold(iter_hash, desc_len as u64);
            }
        }
        checksum = wrapping_fold(checksum, iter_hash);
    }
    format!("op=parse_response digest={}", checksum)
}

unsafe fn libc_strlen(s: *const ::core::ffi::c_char) -> usize {
    let mut len = 0usize;
    while *s.add(len) != 0 {
        len += 1;
    }
    len
}

fn parse_url_runner(input: &[u8], iters: u64) -> String {
    let mut checksum: u64 = 0;
    for _ in 0..iters {
        let mut iter_hash: u64 = 0;
        unsafe {
            // Try non-connect mode
            let mut u: http_parser_url = std::mem::zeroed();
            http_parser_url_init(&mut u);
            let rc = http_parser_parse_url(
                input.as_ptr() as *const ::core::ffi::c_char,
                input.len(),
                0,
                &mut u,
            );
            iter_hash = wrapping_fold(iter_hash, rc as u64);
            if rc == 0 {
                iter_hash = wrapping_fold(iter_hash, u.field_set as u64);
                iter_hash = wrapping_fold(iter_hash, u.port as u64);
                for i in 0..7 {
                    iter_hash = wrapping_fold(iter_hash, u.field_data[i].off as u64);
                    iter_hash = wrapping_fold(iter_hash, u.field_data[i].len as u64);
                }
            }

            // Try connect mode
            let mut u2: http_parser_url = std::mem::zeroed();
            http_parser_url_init(&mut u2);
            let rc2 = http_parser_parse_url(
                input.as_ptr() as *const ::core::ffi::c_char,
                input.len(),
                1,
                &mut u2,
            );
            iter_hash = wrapping_fold(iter_hash, rc2 as u64);
            if rc2 == 0 {
                iter_hash = wrapping_fold(iter_hash, u2.field_set as u64);
                iter_hash = wrapping_fold(iter_hash, u2.port as u64);
                for i in 0..7 {
                    iter_hash = wrapping_fold(iter_hash, u2.field_data[i].off as u64);
                    iter_hash = wrapping_fold(iter_hash, u2.field_data[i].len as u64);
                }
            }
        }
        checksum = wrapping_fold(checksum, iter_hash);
    }
    format!("op=parse_url digest={}", checksum)
}

fn method_status_version_runner(_input: &[u8], iters: u64) -> String {
    let mut checksum: u64 = 0;
    for _ in 0..iters {
        let mut iter_hash: u64 = 0;
        unsafe {
            // Version
            let ver = http_parser_version();
            iter_hash = wrapping_fold(iter_hash, ver as u64);

            // Method strings (0..33 covers all standard methods)
            for m in 0..34u32 {
                let method_enum: http_method = std::mem::transmute(m);
                let s = http_method_str(method_enum);
                if !s.is_null() {
                    let len = libc_strlen(s);
                    iter_hash = wrapping_fold(iter_hash, len as u64);
                    // fold first byte
                    if len > 0 {
                        iter_hash = wrapping_fold(iter_hash, *s as u64);
                    }
                }
            }

            // Status strings for common codes
            let status_codes: &[u32] = &[
                100, 101, 200, 201, 204, 301, 302, 304, 400, 401, 403, 404, 500, 502, 503,
            ];
            for &code in status_codes {
                let status_enum: http_status = std::mem::transmute(code);
                let s = http_status_str(status_enum);
                if !s.is_null() {
                    let len = libc_strlen(s);
                    iter_hash = wrapping_fold(iter_hash, len as u64);
                }
            }

            // Set max header size
            http_parser_set_max_header_size(8192);
            iter_hash = wrapping_fold(iter_hash, 8192u64);

            // Pause/unpause
            let mut parser: http_parser = std::mem::zeroed();
            http_parser_init(&mut parser, http_parser_type::HTTP_REQUEST);
            http_parser_pause(&mut parser, 1);
            iter_hash = wrapping_fold(iter_hash, parser.http_errno() as u64);
            http_parser_pause(&mut parser, 0);
            iter_hash = wrapping_fold(iter_hash, parser.http_errno() as u64);
        }
        checksum = wrapping_fold(checksum, iter_hash);
    }
    format!("op=method_status_version digest={}", checksum)
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut results = Vec::new();

    // parse_request seeds
    {
        let req1 = b"GET /index.html HTTP/1.1\r\nHost: example.com\r\nConnection: keep-alive\r\n\r\n";
        let path1 = format!("{}/parse_request.1.bin", dir);
        std::fs::write(&path1, req1).unwrap();
        results.push(format!("seed parse_request {}", path1));

        let req2 = b"POST /api/data HTTP/1.0\r\nHost: test.org\r\nContent-Length: 13\r\nConnection: close\r\n\r\nHello, World!";
        let path2 = format!("{}/parse_request.2.bin", dir);
        std::fs::write(&path2, req2).unwrap();
        results.push(format!("seed parse_request {}", path2));
    }

    // parse_response seeds
    {
        let resp1 = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\nHello";
        let path1 = format!("{}/parse_response.1.bin", dir);
        std::fs::write(&path1, resp1).unwrap();
        results.push(format!("seed parse_response {}", path1));

        let resp2 = b"HTTP/1.1 404 Not Found\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n4\r\nWiki\r\n0\r\n\r\n";
        let path2 = format!("{}/parse_response.2.bin", dir);
        std::fs::write(&path2, resp2).unwrap();
        results.push(format!("seed parse_response {}", path2));
    }

    // parse_url seeds
    {
        let url1 = b"http://www.example.com:8080/path/to/resource?query=value#fragment";
        let path1 = format!("{}/parse_url.1.bin", dir);
        std::fs::write(&path1, url1).unwrap();
        results.push(format!("seed parse_url {}", path1));

        let url2 = b"https://api.test.org:443/v2/users?id=42&name=foo";
        let path2 = format!("{}/parse_url.2.bin", dir);
        std::fs::write(&path2, url2).unwrap();
        results.push(format!("seed parse_url {}", path2));
    }

    results
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut results = Vec::new();

    // parse_request perf: many pipelined requests
    {
        let single_req = b"GET /path/to/resource?key=value&foo=bar HTTP/1.1\r\nHost: www.example.com\r\nUser-Agent: Mozilla/5.0\r\nAccept: text/html,application/xhtml+xml\r\nAccept-Language: en-US,en;q=0.5\r\nAccept-Encoding: gzip, deflate\r\nConnection: keep-alive\r\nCache-Control: max-age=0\r\nX-Custom-Header: some-value-here\r\n\r\n";
        let mut buf = Vec::new();
        // ~300KB of pipelined requests
        let count = 300 * 1024 / single_req.len();
        for _ in 0..count {
            buf.extend_from_slice(single_req);
        }
        let path = format!("{}/parse_request.perf.bin", dir);
        std::fs::write(&path, &buf).unwrap();
        results.push(format!("perf parse_request {}", path));
    }

    // parse_response perf: many pipelined responses
    {
        let single_resp = b"HTTP/1.1 200 OK\r\nContent-Type: application/json\r\nContent-Length: 27\r\nServer: TestServer/1.0\r\nX-Request-Id: abcdef123456\r\nCache-Control: no-cache\r\n\r\n{\"status\":\"ok\",\"count\":42}\n";
        let mut buf = Vec::new();
        let count = 300 * 1024 / single_resp.len();
        for _ in 0..count {
            buf.extend_from_slice(single_resp);
        }
        let path = format!("{}/parse_response.perf.bin", dir);
        std::fs::write(&path, &buf).unwrap();
        results.push(format!("perf parse_response {}", path));
    }

    // parse_url perf: many URLs concatenated won't work since parse_url expects single URL
    // Instead we make a very long URL with many query params
    {
        let mut url = Vec::new();
        url.extend_from_slice(b"http://www.example.com:8080/very/long/path/to/resource?");
        for i in 0..5000 {
            if i > 0 {
                url.push(b'&');
            }
            write!(&mut url, "param{}=value{}", i, i).unwrap();
        }
        let path = format!("{}/parse_url.perf.bin", dir);
        std::fs::write(&path, &url).unwrap();
        results.push(format!("perf parse_url {}", path));
    }

    results
}
