pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("parse_request", parse_request_runner),
        ("parse_response", parse_response_runner),
        ("parse_url", parse_url_runner),
        ("method_status_version", method_status_version_runner),
    ]
