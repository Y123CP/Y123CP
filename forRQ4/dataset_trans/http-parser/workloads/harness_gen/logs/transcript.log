/// Parse requests with various HTTP methods
fn op_parse_request_methods(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let settings = setup_settings();
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Normal
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 0 as http_parser_type);
                let parsed = http_parser_execute(
                    p,
                    &settings as *const http_parser_settings,
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                );
                h = fold(h, digest_parser(p));
                h = fold(h, parsed as u64);

                // Method string for the parsed method
                let ms = http_method_str((*p).method() as http_method);
                h = fold(h, cstr_len(ms));
            }

            // Lenient
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 0 as http_parser_type);
                (*p).set_lenient_http_headers(1);
                let parsed = http_parser_execute(
                    p,
                    &settings as *const http_parser_settings,
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                );
                h = fold(h, digest_parser(p));
                h = fold(h, parsed as u64);
            }

            digest = fold(digest, h);
        }
    }
    format!("op=parse_request_methods digest={:016x}", digest)
}

/// Parse with pause/resume to exercise pause paths
fn op_parse_pause_resume(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;

    // We need a settings that pauses on message_begin
    unsafe extern "C" fn on_msg_begin_pause(parser: *mut http_parser) -> ::core::ffi::c_int {
        http_parser_pause(parser, 1);
        0
    }

    let settings = unsafe {
        let mut s = MaybeUninit::<http_parser_settings>::zeroed();
        http_parser_settings_init(s.as_mut_ptr());
        let sp = s.as_mut_ptr();
        (*sp).on_message_begin = Some(on_msg_begin_pause);
        (*sp).on_url = Some(on_url);
        (*sp).on_status = Some(on_status);
        (*sp).on_header_field = Some(on_header_field);
        (*sp).on_header_value = Some(on_header_value);
        (*sp).on_headers_complete = Some(on_headers_complete);
        (*sp).on_body = Some(on_body);
        (*sp).on_message_complete = Some(on_message_complete);
        (*sp).on_chunk_header = Some(on_chunk_header);
        (*sp).on_chunk_complete = Some(on_chunk_complete);
        s.assume_init()
    };

    let normal_settings = setup_settings();

    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Parse as request with pause on message_begin, then resume
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 0 as http_parser_type);

                let parsed = http_parser_execute(
                    p,
                    &settings as *const http_parser_settings,
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                );
                h = fold(h, parsed as u64);
                h = fold(h, digest_parser(p));

                // If paused, unpause and continue
                if (*p).http_errno() == 31 {
                    // HPE_PAUSED
                    http_parser_pause(p, 0);
                    if parsed < data.len() {
                        let remaining = data.len() - parsed;
                        let parsed2 = http_parser_execute(
                            p,
                            &normal_settings as *const http_parser_settings,
                            data.as_ptr().add(parsed) as *const ::core::ffi::c_char,
                            remaining,
                        );
                        h = fold(h, parsed2 as u64);
                        h = fold(h, digest_parser(p));
                    }
                }
            }

            // Parse as response with pause
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 1 as http_parser_type);

                let parsed = http_parser_execute(
                    p,
                    &settings as *const http_parser_settings,
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                );
                h = fold(h, parsed as u64);
                h = fold(h, digest_parser(p));

                if (*p).http_errno() == 31 {
                    http_parser_pause(p, 0);
                    if parsed < data.len() {
                        let remaining = data.len() - parsed;
                        let parsed2 = http_parser_execute(
                            p,
                            &normal_settings as *const http_parser_settings,
                            data.as_ptr().add(parsed) as *const ::core::ffi::c_char,
                            remaining,
                        );
                        h = fold(h, parsed2 as u64);
                        h = fold(h, digest_parser(p));
                    }
                }
            }

            digest = fold(digest, h);
        }
    }
    format!("op=parse_pause_resume digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("parse_request", op_parse_request as fn(&[u8], u64) -> String),
        ("parse_response", op_parse_response as fn(&[u8], u64) -> String),
        ("parse_url", op_parse_url as fn(&[u8], u64) -> String),
        ("method_status_version", op_method_status_version as fn(&[u8], u64) -> String),
        ("parse_both", op_parse_both as fn(&[u8], u64) -> String),
        ("parse_request_lenient", op_parse_request_lenient as fn(&[u8], u64) -> String),
        ("parse_response_chunked_lenient", op_parse_response_chunked_lenient as fn(&[u8], u64) -> String),
        ("parse_incremental", op_parse_incremental as fn(&[u8], u64) -> String),
        ("parse_response_varied", op_parse_response_varied as fn(&[u8], u64) -> String),
        ("parse_request_methods", op_parse_request_methods as fn(&[u8], u64) -> String),
        ("parse_pause_resume", op_parse_pause_resume as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_request seeds - diverse methods and features
    {
        let s1 = b"GET /index.html HTTP/1.1\r\nHost: example.com\r\nConnection: keep-alive\r\nAccept: text/html\r\nAccept-Encoding: gzip, deflate\r\nIf-None-Match: \"etag123\"\r\nIf-Modified-Since: Mon, 01 Jan 2024 00:00:00 GMT\r\n\r\n";
        let s2 = b"POST /submit HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Type: application/json\r\nTrailer: X-Checksum\r\n\r\n5\r\nHello\r\n6\r\n World\r\n0\r\nX-Checksum: abc123\r\n\r\n";
        let p1 = format!("{}/parse_request.1.bin", dir);
        let p2 = format!("{}/parse_request.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_request {}", p1));
        lines.push(format!("seed parse_request {}", p2));
    }

    // parse_response seeds - diverse status codes and body types
    {
        let s1 = b"HTTP/1.1 200 OK\r\nContent-Length: 13\r\nContent-Type: text/plain\r\nConnection: keep-alive\r\nSet-Cookie: id=abc; Path=/\r\n\r\nHello, World!";
        // 304 Not Modified (no body), Connection: close
        let s2 = b"HTTP/1.1 304 Not Modified\r\nETag: \"etag123\"\r\nConnection: close\r\n\r\n";
        let p1 = format!("{}/parse_response.1.bin", dir);
        let p2 = format!("{}/parse_response.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_response {}", p1));
        lines.push(format!("seed parse_response {}", p2));
    }

    // parse_url seeds
    {
        let s1 = b"http://www.example.com:8080/path/to/resource?query=value&foo=bar#fragment";
        let s2 = b"https://user:pass@api.test.org:443/v2/users?id=42#top";
        let p1 = format!("{}/parse_url.1.bin", dir);
        let p2 = format!("{}/parse_url.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_url {}", p1));
        lines.push(format!("seed parse_url {}", p2));
    }

    // parse_both seeds
    {
        let s1 = b"GET / HTTP/1.0\r\nHost: example.com\r\n\r\n";
        let s2 = b"HTTP/1.0 301 Moved\r\nLocation: /new\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
        let p1 = format!("{}/parse_both.1.bin", dir);
        let p2 = format!("{}/parse_both.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_both {}", p1));
        lines.push(format!("seed parse_both {}", p2));
    }

    // parse_request_lenient seeds
    {
