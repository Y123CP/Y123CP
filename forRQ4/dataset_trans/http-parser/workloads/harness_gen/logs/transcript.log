use std::cell::RefCell;
use std::ffi::CStr;
use std::fs;
use std::mem::MaybeUninit;

use http_parser_raw::src::http_parser::*;

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9e37_79b9_7f4a_7c15)
}

fn bytes_checksum(data: &[u8]) -> u64 {
    let mut d = 0u64;
    for &b in data {
        d = fold(d, b as u64);
    }
    d ^ (data.len() as u64)
}

unsafe fn cstr_checksum(p: *const ::core::ffi::c_char) -> u64 {
    if p.is_null() {
        return 0;
    }
    bytes_checksum(unsafe { CStr::from_ptr(p) }.to_bytes())
}

unsafe fn as_http_parser_type(v: u32) -> http_parser_type {
    unsafe { std::mem::transmute::<u32, http_parser_type>(v) }
}

unsafe fn as_http_method(v: u32) -> http_method {
    unsafe { std::mem::transmute::<u32, http_method>(v) }
}

unsafe fn as_http_status(v: u32) -> http_status {
    unsafe { std::mem::transmute::<u32, http_status>(v) }
}

unsafe fn as_http_errno(v: u32) -> http_errno {
    unsafe { std::mem::transmute::<u32, http_errno>(v) }
}

fn settings_presence_digest(s: &http_parser_settings) -> u64 {
    let mut d = 0u64;
    d = fold(d, s.on_message_begin.is_some() as u64);
    d = fold(d, s.on_url.is_some() as u64);
    d = fold(d, s.on_status.is_some() as u64);
    d = fold(d, s.on_header_field.is_some() as u64);
    d = fold(d, s.on_header_value.is_some() as u64);
    d = fold(d, s.on_headers_complete.is_some() as u64);
    d = fold(d, s.on_body.is_some() as u64);
    d = fold(d, s.on_message_complete.is_some() as u64);
    d = fold(d, s.on_chunk_header.is_some() as u64);
    d = fold(d, s.on_chunk_complete.is_some() as u64);
    d
}

#[derive(Clone, Copy, Default)]
struct CallbackState {
    digest: u64,
    calls: u64,
    url_bytes: u64,
    status_bytes: u64,
    header_field_bytes: u64,
    header_value_bytes: u64,
    body_bytes: u64,
}

thread_local! {
    static CALLBACK_STATE: RefCell<CallbackState> = RefCell::new(CallbackState::default());
}

fn cb_reset(seed: u64) {
    CALLBACK_STATE.with(|s| {
        *s.borrow_mut() = CallbackState {
            digest: fold(0, seed),
            ..CallbackState::default()
        };
    });
}

fn cb_take() -> CallbackState {
    CALLBACK_STATE.with(|s| *s.borrow())
}

fn cb_mix(x: u64) {
    CALLBACK_STATE.with(|s| {
        let mut st = s.borrow_mut();
        st.digest = fold(st.digest, x);
    });
}

fn cb_mix_bytes(kind: u64, at: *const ::core::ffi::c_char, len: usize) {
    let sum = if at.is_null() || len == 0 {
        0
    } else {
        unsafe { bytes_checksum(std::slice::from_raw_parts(at as *const u8, len)) }
    };
    CALLBACK_STATE.with(|s| {
        let mut st = s.borrow_mut();
        st.calls = st.calls.wrapping_add(1);
        st.digest = fold(st.digest, kind);
        st.digest = fold(st.digest, len as u64);
        st.digest = fold(st.digest, sum);
        match kind {
            2 => st.url_bytes = st.url_bytes.wrapping_add(len as u64),
            3 => st.status_bytes = st.status_bytes.wrapping_add(len as u64),
            4 => st.header_field_bytes = st.header_field_bytes.wrapping_add(len as u64),
            5 => st.header_value_bytes = st.header_value_bytes.wrapping_add(len as u64),
            7 => st.body_bytes = st.body_bytes.wrapping_add(len as u64),
            _ => {}
        }
    });
}

unsafe fn cb_parser_snapshot(parser: *mut http_parser, tag: u64) {
    if parser.is_null() {
        cb_mix(tag);
        return;
    }
    let p = unsafe { &*parser };
    let p_clone = p.clone();
    let mut d = 0u64;
    d = fold(d, tag);
    d = fold(d, p.http_major as u64);
    d = fold(d, p.http_minor as u64);
    d = fold(d, p.method() as u64);
    d = fold(d, p.status_code() as u64);
    d = fold(d, p.http_errno() as u64);
    d = fold(d, p.flags() as u64);
    d = fold(d, p.allow_chunked_length() as u64);
    d = fold(d, p.lenient_http_headers() as u64);
    d = fold(d, http_should_keep_alive(parser as *const _) as u64);
    d = fold(d, http_message_needs_eof(parser as *const _) as u64);
    d = fold(d, http_body_is_final(parser as *const _) as u64);
    d = fold(d, p_clone.method() as u64);
    d = fold(d, p_clone.status_code() as u64);
    d = fold(d, p_clone.http_errno() as u64);
    cb_mix(d);
}

