pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_request perf
    {
        let reqs: &[&[u8]] = &[
            b"GET /path/to/resource?key=value HTTP/1.1\r\nHost: example.com\r\nAccept: text/html\r\nAccept-Language: en-US\r\nUser-Agent: Mozilla/5.0\r\nConnection: keep-alive\r\n\r\n",
            b"POST /api/data HTTP/1.1\r\nHost: example.com\r\nContent-Length: 13\r\nContent-Type: application/json\r\nConnection: keep-alive\r\n\r\n{\"key\":\"val\"}\n",
            b"DELETE /api/item/42 HTTP/1.1\r\nHost: example.com\r\nAuthorization: Bearer token123\r\nConnection: keep-alive\r\n\r\n",
        ];
        let mut big = Vec::new();
        for i in 0..1000 {
            big.extend_from_slice(reqs[i % reqs.len()]);
        }
        let path = format!("{}/parse_request.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_request {}", path));
    }

    // parse_response perf
    {
        let resps: &[&[u8]] = &[
            b"HTTP/1.1 200 OK\r\nContent-Length: 27\r\nContent-Type: text/plain\r\nServer: TestServer/1.0\r\n\r\nThis is the response body.\n",
            b"HTTP/1.1 204 No Content\r\nServer: TestServer/1.0\r\n\r\n",
        ];
        let mut big = Vec::new();
        for i in 0..2000 {
            big.extend_from_slice(resps[i % resps.len()]);
        }
        let path = format!("{}/parse_response.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_response {}", path));
    }

    // parse_url perf
    {
        let mut big = Vec::new();
        big.extend_from_slice(b"http://user:pass@www.example.com:8080/");
        for i in 0..50000u32 {
            big.extend_from_slice(format!("seg{}/", i).as_bytes());
        }
        big.extend_from_slice(b"?key=value&foo=bar#frag");
        let path = format!("{}/parse_url.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_url {}", path));
    }

    // parse_both perf
    {
        let req = b"GET /path HTTP/1.1\r\nHost: example.com\r\nAccept: */*\r\nConnection: keep-alive\r\n\r\n";
        let mut big = Vec::new();
        for _ in 0..3000 {
            big.extend_from_slice(req);
        }
        let path = format!("{}/parse_both.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_both {}", path));
    }

    // parse_request_lenient perf
    {
        let req = b"GET /path HTTP/1.1\r\nHost: example.com\r\nX Custom: value\r\nAccept: */*\r\nConnection: keep-alive\r\n\r\n";
        let mut big = Vec::new();
        for _ in 0..3000 {
            big.extend_from_slice(req);
        }
        let path = format!("{}/parse_request_lenient.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_request_lenient {}", path));
    }

    // parse_response_chunked_lenient perf
    {
        let resp = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nHello\r\n0\r\n\r\n";
        let mut big = Vec::new();
        for _ in 0..2000 {
            big.extend_from_slice(resp);
        }
        let path = format!("{}/parse_response_chunked_lenient.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_response_chunked_lenient {}", path));
    }

    lines
}
