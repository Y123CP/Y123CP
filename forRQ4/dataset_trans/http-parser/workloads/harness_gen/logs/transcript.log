use std::ffi::CStr;
use std::fs;
use std::mem::MaybeUninit;

use http_parser_raw::src::http_parser::*;

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9e37_79b9_7f4a_7c15)
}

fn bytes_checksum(data: &[u8]) -> u64 {
    let mut d = 0u64;
    for &b in data {
        d = fold(d, b as u64);
    }
    d ^ (data.len() as u64)
}

unsafe fn cstr_checksum(p: *const ::core::ffi::c_char) -> u64 {
    if p.is_null() {
        return 0;
    }
    bytes_checksum(unsafe { CStr::from_ptr(p) }.to_bytes())
}

unsafe fn as_http_parser_type(v: u32) -> http_parser_type {
    unsafe { std::mem::transmute::<u32, http_parser_type>(v) }
}

unsafe fn as_http_method(v: u32) -> http_method {
    unsafe { std::mem::transmute::<u32, http_method>(v) }
}

unsafe fn as_http_status(v: u32) -> http_status {
    unsafe { std::mem::transmute::<u32, http_status>(v) }
}

unsafe fn as_http_errno(v: u32) -> http_errno {
    unsafe { std::mem::transmute::<u32, http_errno>(v) }
}

pub fn execute_request_stream(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for _ in 0..iters {
        let iter_digest = unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let mut settings = MaybeUninit::<http_parser_settings>::zeroed();

            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(0));
            http_parser_settings_init(settings.as_mut_ptr());

            let p = parser.as_mut_ptr();
            let s = settings.as_mut_ptr();

            let consumed = http_parser_execute(
                p,
                s,
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
            );

            let parser_ref = &*p;
            let method_u = parser_ref.method() as u32;
            let err_u = parser_ref.http_errno() as u32;
            last_err = err_u as u64;

            let keep_alive = http_should_keep_alive(p as *const _) as u64;
            let needs_eof = http_message_needs_eof(p as *const _) as u64;
            let body_final = http_body_is_final(p as *const _) as u64;

            let method_str = cstr_checksum(http_method_str(as_http_method(method_u)));
            let err_name = cstr_checksum(http_errno_name(as_http_errno(err_u)));
            let err_desc = cstr_checksum(http_errno_description(as_http_errno(err_u)));

            let mut d = 0u64;
            d = fold(d, bytes_checksum(data));
            d = fold(d, consumed as u64);
            d = fold(d, parser_ref.http_major as u64);
            d = fold(d, parser_ref.http_minor as u64);
            d = fold(d, parser_ref.status_code() as u64);
            d = fold(d, method_u as u64);
            d = fold(d, keep_alive);
            d = fold(d, needs_eof);
            d = fold(d, body_final);
            d = fold(d, (consumed != data.len()) as u64);
            d = fold(d, method_str);
            d = fold(d, err_name);
            d = fold(d, err_desc);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=execute_request_stream err={} digest={:016x}",
        last_err, digest
    )
}

pub fn execute_response_stream(data: &[u8], iters: u64) -> String {
