        } else {
            let a = &body[..body.len() / 2];
            let b = &body[body.len() / 2..];
            format!(
                "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: {}\r\nConnection: keep-alive\r\nContent-Type: text/html\r\nTrailer: X-Resp-Trail\r\nServer: perf-server\r\nX-Mode: lenient\tchunked\r\n\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n0\r\nX-Resp-Trail: ok\r\n\r\n",
                body.len(),
                a.len(),
