fn op_parse_url(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Non-connect mode (is_connect = 0)
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    0,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
