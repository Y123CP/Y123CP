pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let req1 = b"GET /hello?x=1 HTTP/1.1\r\nHost: example.com\r\nUser-Agent: harness\r\nAccept: */*\r\nConnection: keep-alive\r\n\r\n";
    let req2 = b"POST /submit HTTP/1.1\r\nHost: example.com\r\nContent-Length: 11\r\nConnection: close\r\nContent-Type: text/plain\r\n\r\nhello world";
    write_seed(dir, "execute_request_stream", 1, req1, &mut out);
    write_seed(dir, "execute_request_stream", 2, req2, &mut out);

    let resp1 = b"HTTP/1.1 200 OK\r\nContent-Length: 13\r\nConnection: keep-alive\r\nContent-Type: text/plain\r\n\r\nHello, world!";
    let resp2 = b"HTTP/1.1 404 Not Found\r\nTransfer-Encoding: chunked\r\nConnection: keep-alive\r\nContent-Type: text/plain\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n";
    write_seed(dir, "execute_response_stream", 1, resp1, &mut out);
    write_seed(dir, "execute_response_stream", 2, resp2, &mut out);

    let pause1 = b"POST /upload HTTP/1.1\r\nHost: example.com\r\nContent-Length: 24\r\nConnection: keep-alive\r\nContent-Type: text/plain\r\n\r\nabcdefghijklmnopqrstuvwx";
    let pause2 = b"GET /very/long/path/with/query?alpha=1&beta=two&gamma=three HTTP/1.1\r\nHost: example.com\r\nUser-Agent: pause-test\r\nX-Extra: 1234567890abcdef\r\nConnection: close\r\n\r\n";
    write_seed(dir, "pause_resume_request", 1, pause1, &mut out);
    write_seed(dir, "pause_resume_request", 2, pause2, &mut out);

    let url1 = b"https://user:pass@example.com:8443/a/b/c?x=1&y=two#frag";
    let url2 = b"example.com:443";
    write_seed(dir, "parse_url_and_meta", 1, url1, &mut out);
    write_seed(dir, "parse_url_and_meta", 2, url2, &mut out);

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let mut req_big = Vec::new();
    for i in 0..80_000u32 {
        let body = format!("item={}&value={}&ok=true", i, i.wrapping_mul(7));
        let msg = format!(
            "POST /api/v1/update?id={} HTTP/1.1\r\nHost: example.com\r\nUser-Agent: perf-client/1.0\r\nAccept: */*\r\nConnection: keep-alive\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: {}\r\nX-Trace: {:08x}\r\n\r\n{}",
            i,
            body.len(),
            i ^ 0x55aa_33cc,
            body
        );
        req_big.extend_from_slice(msg.as_bytes());
    }
    let req_path = format!("{}/execute_request_stream.perf.bin", dir);
    fs::write(&req_path, &req_big).unwrap();
    out.push(format!("perf execute_request_stream {}", req_path));

    let mut resp_big = Vec::new();
    for i in 0..70_000u32 {
        let body = format!(
            "<html><body><h1>OK {}</h1><p>value={}</p><p>tag=response</p></body></html>",
            i,
            i.wrapping_mul(13)
        );
        let msg = format!(
            "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: keep-alive\r\nContent-Type: text/html\r\nServer: perf-server\r\nX-Req-Id: {:08x}\r\n\r\n{}",
            body.len(),
            i ^ 0xa5a5_1234,
            body
        );
        resp_big.extend_from_slice(msg.as_bytes());
    }
    let resp_path = format!("{}/execute_response_stream.perf.bin", dir);
    fs::write(&resp_path, &resp_big).unwrap();
    out.push(format!("perf execute_response_stream {}", resp_path));

    out
}
