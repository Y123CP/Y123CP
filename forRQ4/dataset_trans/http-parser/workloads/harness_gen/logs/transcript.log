    http_parser_url_init, http_parser_version, http_should_keep_alive, http_status,
    http_status_str,
};

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(5).wrapping_add(x).wrapping_mul(0x517cc1b727220a95)
}

unsafe extern "C" fn on_message_begin(_parser: *mut http_parser) -> ::core::ffi::c_int {
    0
}
