fn op_parse_request(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let settings = setup_settings();
    for _ in 0..iters {
        unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let p = parser.as_mut_ptr();
            // HTTP_REQUEST = 0
            http_parser_init(p, 0 as http_parser_type);

            let parsed = http_parser_execute(
                p,
                &settings as *const http_parser_settings,
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
            );

            let keep_alive = http_should_keep_alive(p as *const http_parser);
            let body_final = http_body_is_final(p as *const http_parser);
            let needs_eof = http_message_needs_eof(p as *const http_parser);

            // Access parser fields. The http_parser struct uses bitfields via c2rust.
            // We read the fields we can access.
            let errno_val = (*p).errno_upgrade();
            let method_val = (*p).method();
            let status_code = (*p).status_code;
            let http_major = (*p).http_major;
            let http_minor = (*p).http_minor;

            let mut h = 0u64;
            h = fold(h, parsed as u64);
            h = fold(h, errno_val as u64);
            h = fold(h, method_val as u64);
            h = fold(h, status_code as u64);
            h = fold(h, http_major as u64);
            h = fold(h, http_minor as u64);
            h = fold(h, keep_alive as u64);
            h = fold(h, body_final as u64);
            h = fold(h, needs_eof as u64);

            digest = fold(digest, h);
        }
    }
    format!("op=parse_request digest={:016x}", digest)
}

fn op_parse_response(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let settings = setup_settings();
    for _ in 0..iters {
        unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let p = parser.as_mut_ptr();
            // HTTP_RESPONSE = 1
            http_parser_init(p, 1 as http_parser_type);

            let parsed = http_parser_execute(
                p,
                &settings as *const http_parser_settings,
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
            );

            let keep_alive = http_should_keep_alive(p as *const http_parser);
            let body_final = http_body_is_final(p as *const http_parser);
            let needs_eof = http_message_needs_eof(p as *const http_parser);

            let errno_val = (*p).errno_upgrade();
            let status_code = (*p).status_code;
            let http_major = (*p).http_major;
            let http_minor = (*p).http_minor;

            // Get errno name and description
            let ename_ptr = http_errno_name(errno_val as http_errno);
            let ename_len = if ename_ptr.is_null() {
                0u64
            } else {
                let mut l = 0usize;
                while *ename_ptr.add(l) != 0 {
                    l += 1;
                }
                l as u64
            };

            let edesc_ptr = http_errno_description(errno_val as http_errno);
            let edesc_len = if edesc_ptr.is_null() {
                0u64
            } else {
                let mut l = 0usize;
                while *edesc_ptr.add(l) != 0 {
                    l += 1;
                }
                l as u64
            };

            let mut h = 0u64;
            h = fold(h, parsed as u64);
            h = fold(h, errno_val as u64);
            h = fold(h, status_code as u64);
            h = fold(h, http_major as u64);
            h = fold(h, http_minor as u64);
            h = fold(h, keep_alive as u64);
            h = fold(h, body_final as u64);
            h = fold(h, needs_eof as u64);
            h = fold(h, ename_len);
            h = fold(h, edesc_len);

            digest = fold(digest, h);
        }
    }
    format!("op=parse_response digest={:016x}", digest)
}

fn op_parse_url(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Non-connect mode (is_connect = 0)
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    0,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
                    h = fold(h, u.field_data[i].off as u64);
                    h = fold(h, u.field_data[i].len as u64);
                }
            }

            // Connect mode (is_connect = 1)
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    1,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
                    h = fold(h, u.field_data[i].off as u64);
                    h = fold(h, u.field_data[i].len as u64);
                }
            }

            digest = fold(digest, h);
        }
    }
    format!("op=parse_url digest={:016x}", digest)
}

fn op_method_status_version(_data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Version
            let ver = http_parser_version();
            h = fold(h, ver as u64);

            // Set max header size
            http_parser_set_max_header_size(8192);
            h = fold(h, 8192u64);

            // Method strings: iterate over method values 0..=33 (covers all known methods)
            for m in 0u32..=33 {
                let s = http_method_str(m as http_method);
                let slen = if s.is_null() {
                    0u64
                } else {
                    let mut l = 0usize;
                    while *s.add(l) != 0 {
                        l += 1;
                    }
                    l as u64
                };
                h = fold(h, m as u64);
                h = fold(h, slen);
                // Also fold first char if available
                if !s.is_null() && slen > 0 {
                    h = fold(h, *s as u8 as u64);
                }
            }

            // Status strings for common codes
            let status_codes: &[u32] = &[
                100, 101, 200, 201, 204, 206, 301, 302, 303, 304, 307, 308, 400, 401, 403, 404,
                405, 408, 409, 410, 411, 413, 414, 415, 416, 417, 426, 429, 500, 501, 502, 503,
                504, 505,
            ];
            for &sc in status_codes {
                let s = http_status_str(sc as http_status);
                let slen = if s.is_null() {
                    0u64
                } else {
                    let mut l = 0usize;
                    while *s.add(l) != 0 {
                        l += 1;
                    }
                    l as u64
                };
                h = fold(h, sc as u64);
                h = fold(h, slen);
            }

            // Pause/unpause test
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 0 as http_parser_type);
                http_parser_pause(p, 1);
                // Read flags to fold
                let flags_paused = (*p).flags();
                h = fold(h, flags_paused as u64);
                http_parser_pause(p, 0);
                let flags_unpaused = (*p).flags();
                h = fold(h, flags_unpaused as u64);
            }

            // Restore max header size
            http_parser_set_max_header_size(80 * 1024);

            digest = fold(digest, h);
        }
    }
    format!("op=method_status_version digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("parse_request", op_parse_request as fn(&[u8], u64) -> String),
        (
            "parse_response",
            op_parse_response as fn(&[u8], u64) -> String,
        ),
        ("parse_url", op_parse_url as fn(&[u8], u64) -> String),
