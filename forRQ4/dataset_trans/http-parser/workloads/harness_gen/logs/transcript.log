    len: size_t,
) -> ::core::ffi::c_int {
    unsafe { cb_parser_snapshot(parser, 0x1701) };
    cb_mix_bytes(7, at, len);
    0
}

unsafe extern "C" fn cb_message_complete(parser: *mut http_parser) -> ::core::ffi::c_int {
    cb_mix(0x1801);
    unsafe { cb_parser_snapshot(parser, 0x1802) };
    0
}

unsafe extern "C" fn cb_chunk_header(parser: *mut http_parser) -> ::core::ffi::c_int {
    cb_mix(0x1901);
    unsafe { cb_parser_snapshot(parser, 0x1902) };
    0
}

unsafe extern "C" fn cb_chunk_complete(parser: *mut http_parser) -> ::core::ffi::c_int {
    cb_mix(0x1a01);
    unsafe { cb_parser_snapshot(parser, 0x1a02) };
    0
}

unsafe fn make_settings(mask: u8) -> http_parser_settings {
    let mut s = MaybeUninit::<http_parser_settings>::zeroed();
    unsafe { http_parser_settings_init(s.as_mut_ptr()) };
    let mut s = unsafe { s.assume_init() };

    if mask & 0x01 != 0 {
        s.on_message_begin = Some(cb_message_begin);
    }
    if mask & 0x02 != 0 {
        s.on_url = Some(cb_url);
    }
    if mask & 0x04 != 0 {
        s.on_status = Some(cb_status);
    }
    if mask & 0x08 != 0 {
        s.on_header_field = Some(cb_header_field);
    }
    if mask & 0x10 != 0 {
        s.on_header_value = Some(cb_header_value);
    }
    if mask & 0x20 != 0 {
        s.on_headers_complete = Some(cb_headers_complete);
    }
    if mask & 0x40 != 0 {
        s.on_body = Some(cb_body);
    }
    s.on_message_complete = Some(cb_message_complete);
    s.on_chunk_header = Some(cb_chunk_header);
    s.on_chunk_complete = Some(cb_chunk_complete);
    s
}

unsafe fn configure_parser_features(p: *mut http_parser, data: &[u8]) -> u64 {
    let parser = unsafe { &mut *p };

    let want_allow_chunked = if data
        .windows(b"Transfer-Encoding".len())
        .any(|w| w == b"Transfer-Encoding")
        && data
            .windows(b"Content-Length".len())
            .any(|w| w == b"Content-Length")
    {
        1
    } else if data.len() % 2 == 0 {
        1
    } else {
        0
    };

    let want_lenient = if data
        .iter()
        .any(|&b| matches!(b, b'\t' | 0x7f | b'@' | b'|'))
        || data
            .windows(b"lenient".len())
            .any(|w| w.eq_ignore_ascii_case(b"lenient"))
    {
        1
    } else if data.len() % 3 == 0 {
        1
    } else {
        0
    };

    parser.set_allow_chunked_length(want_allow_chunked);
    parser.set_lenient_http_headers(want_lenient);

    let mut d = 0u64;
    d = fold(d, want_allow_chunked as u64);
    d = fold(d, want_lenient as u64);
    d = fold(d, parser.allow_chunked_length() as u64);
    d = fold(d, parser.lenient_http_headers() as u64);

    let parser_clone = parser.clone();
    d = fold(d, parser_clone.allow_chunked_length() as u64);
    d = fold(d, parser_clone.lenient_http_headers() as u64);
    d = fold(d, parser_clone.http_errno() as u64);
    d = fold(d, parser_clone.flags() as u64);
    d
}

unsafe fn execute_segmented(
    p: *mut http_parser,
    s: *const http_parser_settings,
    data: &[u8],
    seed: u64,
) -> (usize, u64) {
    let mut off = 0usize;
    let mut d = 0u64;

    while off < data.len() {
        let step = 1usize + (((off as u64) ^ seed ^ (data[off] as u64)) as usize % 23);
        let end = data.len().min(off + step);
        let chunk = &data[off..end];
        let n = unsafe {
            http_parser_execute(
                p,
                s,
                chunk.as_ptr() as *const ::core::ffi::c_char,
                chunk.len(),
            )
        };
        d = fold(d, n as u64);
        d = fold(d, unsafe { (*p).http_errno() as u64 });
        d = fold(d, unsafe { (*p).flags() as u64 });
        off += n;
        if n != chunk.len() {
            break;
        }
    }

    let empty = b"";
    let n0 = unsafe {
        http_parser_execute(
            p,
            s,
            empty.as_ptr() as *const ::core::ffi::c_char,
            0usize,
        )
    };
    d = fold(d, n0 as u64);
    d = fold(d, unsafe { (*p).http_errno() as u64 });

    (off, d)
}

unsafe fn parser_digest_common(
    p: *const http_parser,
    settings: &http_parser_settings,
    input: &[u8],
) -> (u64, u64) {
    let parser_ref = unsafe { &*p };
    let parser_clone = parser_ref.clone();
    let settings_clone = settings.clone();

    let method_u = parser_ref.method() as u32;
    let err_u = parser_ref.http_errno() as u32;
    let status_u = parser_ref.status_code() as u32;

    let method_str = unsafe { cstr_checksum(http_method_str(as_http_method(method_u))) };
    let err_name = unsafe { cstr_checksum(http_errno_name(as_http_errno(err_u))) };
    let err_desc = unsafe { cstr_checksum(http_errno_description(as_http_errno(err_u))) };
    let status_str = if status_u == 0 {
        0
    } else {
        unsafe { cstr_checksum(http_status_str(as_http_status(status_u))) }
    };

    let cb = cb_take();

    let mut d = 0u64;
    d = fold(d, bytes_checksum(input));
    d = fold(d, parser_ref.http_major as u64);
    d = fold(d, parser_ref.http_minor as u64);
    d = fold(d, parser_ref.status_code() as u64);
    d = fold(d, parser_ref.method() as u64);
    d = fold(d, parser_ref.flags() as u64);
    d = fold(d, parser_ref.http_errno() as u64);
    d = fold(d, unsafe { http_should_keep_alive(p) as u64 });
    d = fold(d, unsafe { http_message_needs_eof(p) as u64 });
    d = fold(d, unsafe { http_body_is_final(p) as u64 });
    d = fold(d, method_str);
    d = fold(d, status_str);
    d = fold(d, err_name);
    d = fold(d, err_desc);
    d = fold(d, parser_clone.method() as u64);
    d = fold(d, parser_clone.status_code() as u64);
    d = fold(d, parser_clone.http_errno() as u64);
    d = fold(d, parser_clone.allow_chunked_length() as u64);
    d = fold(d, parser_clone.lenient_http_headers() as u64);
    d = fold(d, settings_presence_digest(&settings_clone));
    d = fold(d, cb.digest);
    d = fold(d, cb.calls);
    d = fold(d, cb.url_bytes);
    d = fold(d, cb.status_bytes);
    d = fold(d, cb.header_field_bytes);
    d = fold(d, cb.header_value_bytes);
    d = fold(d, cb.body_bytes);

    (d, err_u as u64)
}

pub fn execute_request_stream(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(0));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7f);
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x2001, i));
            let (consumed, seg_digest) = execute_segmented(p, &settings as *const _, data, i ^ 0x55);
            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, consumed as u64);
            d = fold(d, seg_digest);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=execute_request_stream err={} digest={:016x}",
        last_err, digest
    )
}

pub fn execute_response_stream(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(1));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7f);
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x3001, i));
            let (consumed, seg_digest) = execute_segmented(p, &settings as *const _, data, i ^ 0xaa);
            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, consumed as u64);
            d = fold(d, seg_digest);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=execute_response_stream err={} digest={:016x}",
        last_err, digest
    )
}

pub fn pause_resume_request(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let split = if data.len() <= 1 {
                data.len() / 2
            } else {
                1 + (data.len() / 2)
            }
            .min(data.len());

            let (prefix, suffix) = data.split_at(split);

            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(0));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7b);
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x4001, i));
            let before_pause = http_parser_execute(
                p,
                &settings as *const _,
                prefix.as_ptr() as *const ::core::ffi::c_char,
                prefix.len(),
            );
            let clone_after_prefix = (*p).clone();
            let cb_prefix = cb_take();

            let mut while_paused = 0usize;
            let mut paused_err = (*p).http_errno() as u64;
            if (*p).http_errno() as u32 == 0 {
                http_parser_pause(p, 1);
                while_paused = http_parser_execute(
                    p,
                    &settings as *const _,
                    suffix.as_ptr() as *const ::core::ffi::c_char,
                    suffix.len(),
                );
                paused_err = (*p).http_errno() as u64;
                http_parser_pause(p, 0);
            }

            cb_reset(fold(0x4002, i));
            let after_resume = http_parser_execute(
                p,
                &settings as *const _,
                suffix.as_ptr() as *const ::core::ffi::c_char,
                suffix.len(),
            );
            let cb_suffix = cb_take();

            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, split as u64);
            d = fold(d, before_pause as u64);
            d = fold(d, while_paused as u64);
            d = fold(d, after_resume as u64);
            d = fold(d, paused_err);
            d = fold(d, clone_after_prefix.method() as u64);
            d = fold(d, clone_after_prefix.http_errno() as u64);
            d = fold(d, clone_after_prefix.flags() as u64);
            d = fold(d, cb_prefix.digest);
            d = fold(d, cb_prefix.calls);
            d = fold(d, cb_suffix.digest);
            d = fold(d, cb_suffix.calls);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=pause_resume_request err={} digest={:016x}",
        last_err, digest
    )
}

pub fn parse_url_and_meta(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for i in 0..iters {
        let iter_digest = unsafe {
            let version = http_parser_version();
            let hdr_limit =
                1024u32.wrapping_add((data.len() as u32).wrapping_mul(17)).wrapping_add(13);
            http_parser_set_max_header_size(hdr_limit);

            let is_connect_a = if data.starts_with(b"http://") || data.starts_with(b"https://") {
                0
            } else if data.windows(3).any(|w| w == b"://") {
                0
            } else {
                1
            };

            let mut url_a = MaybeUninit::<http_parser_url>::zeroed();
            http_parser_url_init(url_a.as_mut_ptr());
            let rc_a = http_parser_parse_url(
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
                is_connect_a,
                url_a.as_mut_ptr(),
            );

            let trimmed = if data.len() > 2 { &data[1..data.len() - 1] } else { data };
            let is_connect_b = if is_connect_a == 0 { 1 } else { 0 };
            let mut url_b = MaybeUninit::<http_parser_url>::zeroed();
            http_parser_url_init(url_b.as_mut_ptr());
            let rc_b = http_parser_parse_url(
                trimmed.as_ptr() as *const ::core::ffi::c_char,
                trimmed.len(),
                is_connect_b,
                url_b.as_mut_ptr(),
            );

            last_rc = rc_a ^ rc_b;

            let u_a = &*url_a.as_mut_ptr();
            let u_a_clone = u_a.clone();
            let u_b = &*url_b.as_mut_ptr();
            let u_b_clone = u_b.clone();

            let mut d = 0u64;
            d = fold(d, bytes_checksum(data));
            d = fold(d, version as u64);
            d = fold(d, hdr_limit as u64);
            d = fold(d, rc_a as u64);
            d = fold(d, rc_b as u64);
            d = fold(d, is_connect_a as u64);
            d = fold(d, is_connect_b as u64);
            d = fold(d, i);

            for u in [u_a, &u_a_clone, u_b, &u_b_clone] {
                d = fold(d, u.field_set as u64);
                d = fold(d, u.port as u64);
                let mut idx = 0usize;
                while idx < u.field_data.len() {
                    d = fold(d, u.field_data[idx].off as u64);
                    d = fold(d, u.field_data[idx].len as u64);
                    idx += 1;
                }
            }

            d
        };
        digest = fold(digest, iter_digest);
    }

    format!("op=parse_url_and_meta rc={} digest={:016x}", last_rc, digest)
}

pub fn execute_auto_stream(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(2));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7f);
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x5001, i));
            let (consumed, seg_digest) = execute_segmented(p, &settings as *const _, data, i ^ 0x1234);
            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, consumed as u64);
            d = fold(d, seg_digest);
            d = fold(d, data.starts_with(b"HTTP/") as u64);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!("op=execute_auto_stream err={} digest={:016x}", last_err, digest)
}

pub fn clone_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let ty = if data.starts_with(b"HTTP/") { 1 } else { 0 };
            let split = data.len().min(1 + data.len() / 2);

            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(ty));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7f);
            let settings_clone = settings.clone();
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x6001, i));
            let n1 = http_parser_execute(
                p,
                &settings as *const _,
                data[..split].as_ptr() as *const ::core::ffi::c_char,
                split,
            );
            let cb1 = cb_take();
            let parser_mid = (*p).clone();
            let parser_mid_clone = parser_mid.clone();

            let mut parser_copy = parser_mid.clone();

            cb_reset(fold(0x6002, i));
            let n2 = http_parser_execute(
                p,
                &settings as *const _,
                data[split..].as_ptr() as *const ::core::ffi::c_char,
                data.len() - split,
            );
            let cb2 = cb_take();

            cb_reset(fold(0x6003, i));
            let n3 = http_parser_execute(
                &mut parser_copy as *mut _,
                &settings_clone as *const _,
                data[split..].as_ptr() as *const ::core::ffi::c_char,
                data.len() - split,
            );
            let cb3 = cb_take();

            let final_clone = parser_copy.clone();
            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, split as u64);
            d = fold(d, n1 as u64);
            d = fold(d, n2 as u64);
            d = fold(d, n3 as u64);
            d = fold(d, parser_mid.method() as u64);
            d = fold(d, parser_mid.status_code() as u64);
            d = fold(d, parser_mid.http_errno() as u64);
            d = fold(d, parser_mid.flags() as u64);
            d = fold(d, parser_mid_clone.method() as u64);
            d = fold(d, parser_mid_clone.status_code() as u64);
            d = fold(d, parser_mid_clone.http_errno() as u64);
            d = fold(d, final_clone.method() as u64);
            d = fold(d, final_clone.status_code() as u64);
            d = fold(d, final_clone.http_errno() as u64);
            d = fold(d, final_clone.allow_chunked_length() as u64);
            d = fold(d, final_clone.lenient_http_headers() as u64);
            d = fold(d, settings_presence_digest(&settings_clone));
            d = fold(d, cb1.digest);
            d = fold(d, cb2.digest);
            d = fold(d, cb3.digest);
            d = fold(d, cb1.calls);
            d = fold(d, cb2.calls);
            d = fold(d, cb3.calls);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!("op=clone_roundtrip err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        (
            "execute_request_stream",
            execute_request_stream as fn(&[u8], u64) -> String,
        ),
        (
            "execute_response_stream",
            execute_response_stream as fn(&[u8], u64) -> String,
        ),
        (
            "pause_resume_request",
            pause_resume_request as fn(&[u8], u64) -> String,
        ),
        (
            "parse_url_and_meta",
            parse_url_and_meta as fn(&[u8], u64) -> String,
        ),
        (
            "execute_auto_stream",
            execute_auto_stream as fn(&[u8], u64) -> String,
        ),
        (
            "clone_roundtrip",
            clone_roundtrip as fn(&[u8], u64) -> String,
        ),
    ]
}

fn write_seed(dir: &str, op: &str, idx: usize, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.{}.bin", dir, op, idx);
    let _ = fs::write(&path, bytes);
    out.push(format!("seed {} {}", op, path));
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let req1 = b"POST /chunked-ok HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nConnection: keep-alive\r\nTrailer: X-Trailer\r\nExpect: 100-continue\r\nX-Lenient: value\twith-tab\r\n\r\n5\r\nhello\r\n0\r\nX-Trailer: done\r\n\r\n";
    let req2 = b"CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\nProxy-Connection: keep-alive\r\nUser-Agent: harness\r\nX-Weird@Header: lenient|mode\r\n\r\n";
    write_seed(dir, "execute_request_stream", 1, req1, &mut out);
    write_seed(dir, "execute_request_stream", 2, req2, &mut out);

    let resp1 = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 11\r\nConnection: keep-alive\r\nTrailer: X-Trailer\r\nX-Server\tHint: lenient\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\nX-Trailer: yes\r\n\r\n";
    let resp2 = b"HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Accept: abcdefghijklmnop\r\n\r\n";
    write_seed(dir, "execute_response_stream", 1, resp1, &mut out);
    write_seed(dir, "execute_response_stream", 2, resp2, &mut out);

    let pause1 = b"POST /upload HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 24\r\nConnection: keep-alive\r\nX-Pause: lenient\tresume\r\n\r\nc\r\nabcdefghijkl\r\nc\r\nmnopqrstuvwx\r\n0\r\n\r\n";
    let pause2 = b"HEAD /very/long/path/with/query?alpha=1&beta=two&gamma=three HTTP/1.1\r\nHost: example.com\r\nUser-Agent: pause-test\r\nIf-Modified-Since: Tue, 15 Nov 1994 08:12:31 GMT\r\nX-Extra@Odd: 1234567890abcdef\r\nConnection: close\r\n\r\n";
    write_seed(dir, "pause_resume_request", 1, pause1, &mut out);
    write_seed(dir, "pause_resume_request", 2, pause2, &mut out);

    let url1 = b"https://user:pass@example.com:8443/a/b/c?x=1&y=two#frag";
    let url2 = b"example.com:443";
    write_seed(dir, "parse_url_and_meta", 1, url1, &mut out);
    write_seed(dir, "parse_url_and_meta", 2, url2, &mut out);

    let auto1 = b"GET /auto?x=1 HTTP/1.1\r\nHost: example.com\r\nConnection: keep-alive\r\nContent-Length: 0\r\n\r\n";
    let auto2 = b"HTTP/1.0 204 No Content\r\nConnection: close\r\nContent-Length: 0\r\nX-Test@Resp: value\r\n\r\n";
    write_seed(dir, "execute_auto_stream", 1, auto1, &mut out);
    write_seed(dir, "execute_auto_stream", 2, auto2, &mut out);

    let clone1 = b"POST /clone HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 10\r\nConnection: keep-alive\r\nX-Clone: yes\tlenient\r\n\r\n5\r\nabcde\r\n5\r\n12345\r\n0\r\n\r\n";
    let clone2 = b"HTTP/1.1 206 Partial Content\r\nContent-Length: 9\r\nConnection: keep-alive\r\nContent-Range: bytes 0-8/9\r\nX-Clone@Resp: mirrored\r\n\r\n123456789";
    write_seed(dir, "clone_roundtrip", 1, clone1, &mut out);
    write_seed(dir, "clone_roundtrip", 2, clone2, &mut out);

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let mut req_big = Vec::new();
    for i in 0..80_000u32 {
        let body = format!(
            "item={}&value={}&ok=true&tag=lenient&category=parser&note=chunked-message-{}",
            i,
            i.wrapping_mul(7),
            i % 31
        );
        let msg = if i % 2 == 0 {
            format!(
                "POST /api/v1/update?id={} HTTP/1.1\r\nHost: example.com\r\nUser-Agent: perf-client/1.0\r\nAccept: */*\r\nConnection: keep-alive\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: {}\r\nX-Trace@Perf: {:08x}\r\n\r\n{}",
                i,
                body.len(),
                i ^ 0x55aa_33cc,
                body
            )
        } else {
            let a = &body[..body.len() / 3];
            let b = &body[body.len() / 3..(2 * body.len()) / 3];
            let c = &body[(2 * body.len()) / 3..];
            format!(
                "POST /api/v1/update?id={} HTTP/1.1\r\nHost: example.com\r\nUser-Agent: perf-client/1.0\r\nAccept: */*\r\nConnection: keep-alive\r\nTransfer-Encoding: chunked\r\nContent-Length: {}\r\nTrailer: X-Perf-Trailer\r\nX-Lenient: value\t{}\r\n\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n0\r\nX-Perf-Trailer: done\r\n\r\n",
                i,
                body.len(),
                i,
                a.len(),
                a,
                b.len(),
                b,
                c.len(),
                c
            )
        };
        req_big.extend_from_slice(msg.as_bytes());
    }
    let req_path = format!("{}/execute_request_stream.perf.bin", dir);
    let _ = fs::write(&req_path, &req_big);
    out.push(format!("perf execute_request_stream {}", req_path));

    let mut resp_big = Vec::new();
    for i in 0..70_000u32 {
        let body = format!(
            "<html><body><h1>OK {}</h1><p>value={}</p><p>tag=response</p><p>cluster=node-{}</p></body></html>",
            i,
            i.wrapping_mul(13),
            i % 17
        );
        let msg = if i % 2 == 0 {
            format!(
                "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: keep-alive\r\nContent-Type: text/html\r\nServer: perf-server\r\nX-Req-Id@Perf: {:08x}\r\n\r\n{}",
                body.len(),
                i ^ 0xa5a5_1234,
                body
            )
        } else {
            let a = &body[..body.len() / 2];
            let b = &body[body.len() / 2..];
            format!(
                "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: {}\r\nConnection: keep-alive\r\nContent-Type: text/html\r\nTrailer: X-Resp-Trail\r\nServer: perf-server\r\nX-Mode: lenient\tchunked\r\n\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n0\r\nX-Resp-Trail: ok\r\n\r\n",
                body.len(),
                a.len(),
                a,
                b.len(),
                b
            )
        };
        resp_big.extend_from_slice(msg.as_bytes());
    }
    let resp_path = format!("{}/execute_response_stream.perf.bin", dir);
    let _ = fs::write(&resp_path, &resp_big);
    out.push(format!("perf execute_response_stream {}", resp_path));

    let mut pause_big = Vec::new();
    for i in 0..60_000u32 {
        let body = format!(
            "segment={}&payload=abcdefghijklmnopqrstuvwxyz{}&mode=pause-resume",
            i,
            i ^ 0x1234
        );
        let msg = format!(
            "POST /stream/{} HTTP/1.1\r\nHost: example.com\r\nContent-Length: {}\r\nConnection: keep-alive\r\nContent-Type: application/x-www-form-urlencoded\r\nX-Pause-Perf: {}\r\n\r\n{}",
            i,
            body.len(),
            i,
            body
        );
        pause_big.extend_from_slice(msg.as_bytes());
    }
    let pause_path = format!("{}/pause_resume_request.perf.bin", dir);
    let _ = fs::write(&pause_path, &pause_big);
    out.push(format!("perf pause_resume_request {}", pause_path));

    let mut auto_big = Vec::new();
    for i in 0..75_000u32 {
        if i % 2 == 0 {
            let msg = format!(
                "GET /auto/perf/{}?q={}&k=lenient HTTP/1.1\r\nHost: example.com\r\nConnection: keep-alive\r\nUser-Agent: auto-client/1.0\r\nAccept: */*\r\nContent-Length: 0\r\n\r\n",
                i,
                i.wrapping_mul(9)
            );
            auto_big.extend_from_slice(msg.as_bytes());
        } else {
            let body = format!("response-{}-payload-{}", i, i.wrapping_mul(5));
            let msg = format!(
                "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: keep-alive\r\nContent-Type: text/plain\r\nServer: auto-perf\r\n\r\n{}",
                body.len(),
                body
            );
            auto_big.extend_from_slice(msg.as_bytes());
        }
    }
    let auto_path = format!("{}/execute_auto_stream.perf.bin", dir);
    let _ = fs::write(&auto_path, &auto_big);
    out.push(format!("perf execute_auto_stream {}", auto_path));

    out
}
