            // Parse with allow_chunked_length and lenient_http_headers
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let p = parser.as_mut_ptr();
            http_parser_init(p, 1 as http_parser_type); // HTTP_RESPONSE

            (*p).set_allow_chunked_length(1);
