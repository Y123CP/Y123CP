            format!(
                "POST /api/v1/update?id={} HTTP/1.1\r\nHost: example.com\r\nUser-Agent: perf-client/1.0\r\nAccept: */*\r\nConnection: keep-alive\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: {}\r\nX-Trace@Perf: {:08x}\r\n\r\n{}",
                i,
                body.len(),
                i ^ 0x55aa_33cc,
                body
            )
        } else {
            let a = &body[..body.len() / 3];
            let b = &body[body.len() / 3..(2 * body.len()) / 3];
            let c = &body[(2 * body.len()) / 3..];
            format!(
                "POST /api/v1/update?id={} HTTP/1.1\r\nHost: example.com\r\nUser-Agent: perf-client/1.0\r\nAccept: */*\r\nConnection: keep-alive\r\nTransfer-Encoding: chunked\r\nContent-Length: {}\r\nTrailer: X-Perf-Trailer\r\nX-Lenient: value\t{}\r\n\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n{:x}\r\n{}\r\n0\r\nX-Perf-Trailer: done\r\n\r\n",
                i,
                body.len(),
                i,
                a.len(),
                a,
                b.len(),
                b,
                c.len(),
                c
            )
        };
        req_big.extend_from_slice(msg.as_bytes());
    }
    let req_path = format!("{}/execute_request_stream.perf.bin", dir);
    let _ = fs::write(&req_path, &req_big);
    out.push(format!("perf execute_request_stream {}", req_path));

    let mut resp_big = Vec::new();
    for i in 0..70_000u32 {
        let body = format!(
            "<html><body><h1>OK {}</h1><p>value={}</p><p>tag=response</p><p>cluster=node-{}</p></body></html>",
            i,
            i.wrapping_mul(13),
            i % 17
