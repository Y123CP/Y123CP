unsafe fn make_settings(mask: u8) -> http_parser_settings {
    let mut s = MaybeUninit::<http_parser_settings>::zeroed();
    unsafe { http_parser_settings_init(s.as_mut_ptr()) };
    let mut s = unsafe { s.assume_init() };

    if mask & 0x01 != 0 {
        s.on_message_begin = Some(cb_message_begin);
    }
    if mask & 0x02 != 0 {
        s.on_url = Some(cb_url);
    }
    if mask & 0x04 != 0 {
        s.on_status = Some(cb_status);
    }
    if mask & 0x08 != 0 {
        s.on_header_field = Some(cb_header_field);
    }
    if mask & 0x10 != 0 {
        s.on_header_value = Some(cb_header_value);
    }
    if mask & 0x20 != 0 {
        s.on_headers_complete = Some(cb_headers_complete);
    }
    if mask & 0x40 != 0 {
        s.on_body = Some(cb_body);
    }
    s.on_message_complete = Some(cb_message_complete);
    s.on_chunk_header = Some(cb_chunk_header);
    s.on_chunk_complete = Some(cb_chunk_complete);
    s
}

unsafe fn configure_parser_features(p: *mut http_parser, data: &[u8]) -> u64 {
    let parser = unsafe { &mut *p };

    let want_allow_chunked = if data
        .windows(b"Transfer-Encoding".len())
        .any(|w| w == b"Transfer-Encoding")
        && data
            .windows(b"Content-Length".len())
            .any(|w| w == b"Content-Length")
    {
        1
    } else if data.len() % 2 == 0 {
        1
    } else {
        0
    };

    let want_lenient = if data
        .iter()
        .any(|&b| matches!(b, b'\t' | 0x7f | b'@' | b'|'))
        || data
            .windows(b"lenient".len())
            .any(|w| w.eq_ignore_ascii_case(b"lenient"))
    {
        1
    } else if data.len() % 3 == 0 {
        1
    } else {
        0
    };

    parser.set_allow_chunked_length(want_allow_chunked);
    parser.set_lenient_http_headers(want_lenient);

    let mut d = 0u64;
    d = fold(d, want_allow_chunked as u64);
    d = fold(d, want_lenient as u64);
    d = fold(d, parser.allow_chunked_length() as u64);
    d = fold(d, parser.lenient_http_headers() as u64);

    let parser_clone = parser.clone();
    d = fold(d, parser_clone.allow_chunked_length() as u64);
    d = fold(d, parser_clone.lenient_http_headers() as u64);
    d = fold(d, parser_clone.http_errno() as u64);
    d = fold(d, parser_clone.flags() as u64);
    d
}

unsafe fn execute_segmented(
    p: *mut http_parser,
    s: *const http_parser_settings,
    data: &[u8],
    seed: u64,
) -> (usize, u64) {
    let mut off = 0usize;
    let mut d = 0u64;

    while off < data.len() {
        let step = 1usize + (((off as u64) ^ seed ^ (data[off] as u64)) as usize % 23);
        let end = data.len().min(off + step);
        let chunk = &data[off..end];
        let n = unsafe {
            http_parser_execute(
                p,
                s,
                chunk.as_ptr() as *const ::core::ffi::c_char,
                chunk.len(),
            )
        };
        d = fold(d, n as u64);
        d = fold(d, unsafe { (*p).http_errno() as u64 });
        d = fold(d, unsafe { (*p).flags() as u64 });
        off += n;
        if n != chunk.len() {
            break;
        }
    }

    let empty = b"";
    let n0 = unsafe {
        http_parser_execute(
            p,
            s,
            empty.as_ptr() as *const ::core::ffi::c_char,
            0usize,
        )
    };
    d = fold(d, n0 as u64);
    d = fold(d, unsafe { (*p).http_errno() as u64 });

    (off, d)
}

unsafe fn parser_digest_common(
    p: *const http_parser,
    settings: &http_parser_settings,
    input: &[u8],
) -> (u64, u64) {
    let parser_ref = unsafe { &*p };
    let parser_clone = parser_ref.clone();
    let settings_clone = settings.clone();

    let method_u = parser_ref.method() as u32;
    let err_u = parser_ref.http_errno() as u32;
    let status_u = parser_ref.status_code() as u32;

    let method_str = unsafe { cstr_checksum(http_method_str(as_http_method(method_u))) };
    let err_name = unsafe { cstr_checksum(http_errno_name(as_http_errno(err_u))) };
    let err_desc = unsafe { cstr_checksum(http_errno_description(as_http_errno(err_u))) };
    let status_str = if status_u == 0 {
        0
    } else {
        unsafe { cstr_checksum(http_status_str(as_http_status(status_u))) }
    };

    let cb = cb_take();

    let mut d = 0u64;
    d = fold(d, bytes_checksum(input));
    d = fold(d, parser_ref.http_major as u64);
    d = fold(d, parser_ref.http_minor as u64);
    d = fold(d, parser_ref.status_code() as u64);
    d = fold(d, parser_ref.method() as u64);
    d = fold(d, parser_ref.flags() as u64);
    d = fold(d, parser_ref.http_errno() as u64);
    d = fold(d, unsafe { http_should_keep_alive(p) as u64 });
    d = fold(d, unsafe { http_message_needs_eof(p) as u64 });
    d = fold(d, unsafe { http_body_is_final(p) as u64 });
    d = fold(d, method_str);
    d = fold(d, status_str);
    d = fold(d, err_name);
    d = fold(d, err_desc);
    d = fold(d, parser_clone.method() as u64);
    d = fold(d, parser_clone.status_code() as u64);
    d = fold(d, parser_clone.http_errno() as u64);
    d = fold(d, parser_clone.allow_chunked_length() as u64);
    d = fold(d, parser_clone.lenient_http_headers() as u64);
    d = fold(d, settings_presence_digest(&settings_clone));
    d = fold(d, cb.digest);
    d = fold(d, cb.calls);
    d = fold(d, cb.url_bytes);
    d = fold(d, cb.status_bytes);
    d = fold(d, cb.header_field_bytes);
    d = fold(d, cb.header_value_bytes);
    d = fold(d, cb.body_bytes);

    (d, err_u as u64)
}

pub fn execute_request_stream(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(0));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7f);
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x2001, i));
            let (consumed, seg_digest) = execute_segmented(p, &settings as *const _, data, i ^ 0x55);
            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, consumed as u64);
            d = fold(d, seg_digest);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=execute_request_stream err={} digest={:016x}",
        last_err, digest
    )
}

pub fn execute_response_stream(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(1));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7f);
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x3001, i));
            let (consumed, seg_digest) = execute_segmented(p, &settings as *const _, data, i ^ 0xaa);
            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, consumed as u64);
            d = fold(d, seg_digest);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=execute_response_stream err={} digest={:016x}",
        last_err, digest
    )
}

pub fn pause_resume_request(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let split = if data.len() <= 1 {
                data.len() / 2
            } else {
                1 + (data.len() / 2)
            }
            .min(data.len());

            let (prefix, suffix) = data.split_at(split);

            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(0));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7b);
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x4001, i));
            let before_pause = http_parser_execute(
                p,
                &settings as *const _,
                prefix.as_ptr() as *const ::core::ffi::c_char,
                prefix.len(),
            );
            let clone_after_prefix = (*p).clone();
            let cb_prefix = cb_take();

            http_parser_pause(p, 1);
            let while_paused = http_parser_execute(
                p,
                &settings as *const _,
                suffix.as_ptr() as *const ::core::ffi::c_char,
                suffix.len(),
            );
            let paused_err = (*p).http_errno() as u64;

            http_parser_pause(p, 0);
            cb_reset(fold(0x4002, i));
            let after_resume = http_parser_execute(
                p,
                &settings as *const _,
                suffix.as_ptr() as *const ::core::ffi::c_char,
                suffix.len(),
            );
            let cb_suffix = cb_take();

            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, split as u64);
            d = fold(d, before_pause as u64);
            d = fold(d, while_paused as u64);
            d = fold(d, after_resume as u64);
            d = fold(d, paused_err);
            d = fold(d, clone_after_prefix.method() as u64);
            d = fold(d, clone_after_prefix.http_errno() as u64);
            d = fold(d, clone_after_prefix.flags() as u64);
            d = fold(d, cb_prefix.digest);
            d = fold(d, cb_prefix.calls);
            d = fold(d, cb_suffix.digest);
            d = fold(d, cb_suffix.calls);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=pause_resume_request err={} digest={:016x}",
        last_err, digest
    )
}

pub fn parse_url_and_meta(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for i in 0..iters {
        let iter_digest = unsafe {
            let version = http_parser_version();
            let hdr_limit =
                1024u32.wrapping_add((data.len() as u32).wrapping_mul(17)).wrapping_add(13);
            http_parser_set_max_header_size(hdr_limit);

            let is_connect_a = if data.starts_with(b"http://") || data.starts_with(b"https://") {
                0
            } else if data.windows(3).any(|w| w == b"://") {
                0
            } else {
                1
            };

            let mut url_a = MaybeUninit::<http_parser_url>::zeroed();
            http_parser_url_init(url_a.as_mut_ptr());
            let rc_a = http_parser_parse_url(
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
                is_connect_a,
                url_a.as_mut_ptr(),
            );

            let trimmed = if data.len() > 2 { &data[1..data.len() - 1] } else { data };
            let is_connect_b = if is_connect_a == 0 { 1 } else { 0 };
            let mut url_b = MaybeUninit::<http_parser_url>::zeroed();
            http_parser_url_init(url_b.as_mut_ptr());
            let rc_b = http_parser_parse_url(
                trimmed.as_ptr() as *const ::core::ffi::c_char,
                trimmed.len(),
                is_connect_b,
                url_b.as_mut_ptr(),
            );

            last_rc = rc_a ^ rc_b;

            let u_a = &*url_a.as_mut_ptr();
            let u_a_clone = u_a.clone();
            let u_b = &*url_b.as_mut_ptr();
            let u_b_clone = u_b.clone();

            let mut d = 0u64;
            d = fold(d, bytes_checksum(data));
            d = fold(d, version as u64);
            d = fold(d, hdr_limit as u64);
            d = fold(d, rc_a as u64);
            d = fold(d, rc_b as u64);
            d = fold(d, is_connect_a as u64);
            d = fold(d, is_connect_b as u64);
            d = fold(d, i);

            for u in [u_a, &u_a_clone, u_b, &u_b_clone] {
                d = fold(d, u.field_set as u64);
                d = fold(d, u.port as u64);
                let mut idx = 0usize;
                while idx < u.field_data.len() {
                    d = fold(d, u.field_data[idx].off as u64);
                    d = fold(d, u.field_data[idx].len as u64);
                    idx += 1;
                }
            }

            d
        };
        digest = fold(digest, iter_digest);
    }

    format!("op=parse_url_and_meta rc={} digest={:016x}", last_rc, digest)
}

pub fn execute_auto_stream(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(2));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7f);
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x5001, i));
            let (consumed, seg_digest) = execute_segmented(p, &settings as *const _, data, i ^ 0x1234);
            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, consumed as u64);
            d = fold(d, seg_digest);
            d = fold(d, (data.starts_with(b"HTTP/") as u64));
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!("op=execute_auto_stream err={} digest={:016x}", last_err, digest)
}

pub fn clone_roundtrip(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for i in 0..iters {
        let iter_digest = unsafe {
            let ty = if data.starts_with(b"HTTP/") { 1 } else { 0 };
            let split = data.len().min(1 + data.len() / 2);

            let mut parser = MaybeUninit::<http_parser>::zeroed();
            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(ty));
            let p = parser.as_mut_ptr();

            let settings = make_settings(0x7f);
            let settings_clone = settings.clone();
            let feature_digest = configure_parser_features(p, data);

            cb_reset(fold(0x6001, i));
            let n1 = http_parser_execute(
                p,
                &settings as *const _,
                data[..split].as_ptr() as *const ::core::ffi::c_char,
                split,
            );
            let cb1 = cb_take();
            let parser_mid = (*p).clone();
            let parser_mid_clone = parser_mid.clone();

            let mut parser_copy = parser_mid.clone();

            cb_reset(fold(0x6002, i));
            let n2 = http_parser_execute(
                p,
                &settings as *const _,
                data[split..].as_ptr() as *const ::core::ffi::c_char,
                data.len() - split,
            );
            let cb2 = cb_take();

            cb_reset(fold(0x6003, i));
            let n3 = http_parser_execute(
                &mut parser_copy as *mut _,
                &settings_clone as *const _,
                data[split..].as_ptr() as *const ::core::ffi::c_char,
                data.len() - split,
            );
            let cb3 = cb_take();

            let final_clone = parser_copy.clone();
            let (mut d, err) = parser_digest_common(p as *const _, &settings, data);
            last_err = err;
            d = fold(d, feature_digest);
            d = fold(d, split as u64);
            d = fold(d, n1 as u64);
            d = fold(d, n2 as u64);
            d = fold(d, n3 as u64);
            d = fold(d, parser_mid.method() as u64);
            d = fold(d, parser_mid.status_code() as u64);
            d = fold(d, parser_mid.http_errno() as u64);
            d = fold(d, parser_mid.flags() as u64);
            d = fold(d, parser_mid_clone.method() as u64);
            d = fold(d, parser_mid_clone.status_code() as u64);
            d = fold(d, parser_mid_clone.http_errno() as u64);
            d = fold(d, final_clone.method() as u64);
            d = fold(d, final_clone.status_code() as u64);
            d = fold(d, final_clone.http_errno() as u64);
            d = fold(d, final_clone.allow_chunked_length() as u64);
            d = fold(d, final_clone.lenient_http_headers() as u64);
            d = fold(d, settings_presence_digest(&settings_clone));
            d = fold(d, cb1.digest);
            d = fold(d, cb2.digest);
            d = fold(d, cb3.digest);
            d = fold(d, cb1.calls);
            d = fold(d, cb2.calls);
            d = fold(d, cb3.calls);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!("op=clone_roundtrip err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        (
            "execute_request_stream",
            execute_request_stream as fn(&[u8], u64) -> String,
        ),
        (
            "execute_response_stream",
            execute_response_stream as fn(&[u8], u64) -> String,
        ),
