pub fn pause_resume_request(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u64;

    for _ in 0..iters {
        let iter_digest = unsafe {
            let split = if data.len() <= 1 {
                data.len() / 2
            } else {
                1 + (data.len() / 2)
            }
            .min(data.len());

            let (prefix, suffix) = data.split_at(split);

            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let mut settings = MaybeUninit::<http_parser_settings>::zeroed();

            http_parser_init(parser.as_mut_ptr(), as_http_parser_type(0));
            http_parser_settings_init(settings.as_mut_ptr());

            let p = parser.as_mut_ptr();
            let s = settings.as_mut_ptr();

            let feature_digest = configure_parser_features(p, data);

            let before_pause = http_parser_execute(
                p,
                s,
                prefix.as_ptr() as *const ::core::ffi::c_char,
                prefix.len(),
            );

            let clone_after_prefix = (*p).clone();

            http_parser_pause(p, 1);

            let while_paused = http_parser_execute(
                p,
                s,
                suffix.as_ptr() as *const ::core::ffi::c_char,
                suffix.len(),
            );

            http_parser_pause(p, 0);

            let after_resume = http_parser_execute(
                p,
                s,
                suffix.as_ptr() as *const ::core::ffi::c_char,
                suffix.len(),
            );

            let parser_ref = &*p;
            let parser_clone = parser_ref.clone();
            let err_u = parser_ref.http_errno() as u32;
            last_err = err_u as u64;

            let keep_alive = http_should_keep_alive(p as *const _) as u64;
            let body_final = http_body_is_final(p as *const _) as u64;
            let needs_eof = http_message_needs_eof(p as *const _) as u64;
            let err_name = cstr_checksum(http_errno_name(as_http_errno(err_u)));
            let err_desc = cstr_checksum(http_errno_description(as_http_errno(err_u)));

            let mut d = 0u64;
            d = fold(d, bytes_checksum(data));
            d = fold(d, feature_digest);
            d = fold(d, split as u64);
            d = fold(d, before_pause as u64);
            d = fold(d, while_paused as u64);
            d = fold(d, after_resume as u64);
            d = fold(d, parser_ref.http_major as u64);
            d = fold(d, parser_ref.http_minor as u64);
            d = fold(d, parser_ref.method() as u64);
            d = fold(d, keep_alive);
            d = fold(d, needs_eof);
            d = fold(d, body_final);
            d = fold(d, err_u as u64);
            d = fold(d, err_name);
            d = fold(d, err_desc);
            d = fold(d, clone_after_prefix.method() as u64);
            d = fold(d, clone_after_prefix.http_errno() as u64);
            d = fold(d, parser_clone.allow_chunked_length() as u64);
            d = fold(d, parser_clone.lenient_http_headers() as u64);
            d
        };
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=pause_resume_request err={} digest={:016x}",
        last_err, digest
    )
}

pub fn parse_url_and_meta(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_rc = 0i32;

    for _ in 0..iters {
        let iter_digest = unsafe {
            let mut url = MaybeUninit::<http_parser_url>::zeroed();
            http_parser_url_init(url.as_mut_ptr());

            let is_connect = if data.starts_with(b"http://") || data.starts_with(b"https://") {
                0
            } else if data.windows(3).any(|w| w == b"://") {
                0
            } else {
                1
            };

            let hdr_limit =
                1024u32.wrapping_add((data.len() as u32).wrapping_mul(17)).wrapping_add(13);
            http_parser_set_max_header_size(hdr_limit);

            let rc = http_parser_parse_url(
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
                is_connect,
                url.as_mut_ptr(),
            );
            last_rc = rc;

            let version = http_parser_version();
            let u = &*url.as_mut_ptr();
            let u_clone = u.clone();

            let mut d = 0u64;
            d = fold(d, bytes_checksum(data));
            d = fold(d, rc as u64);
            d = fold(d, is_connect as u64);
            d = fold(d, version as u64);
            d = fold(d, hdr_limit as u64);
            d = fold(d, u.field_set as u64);
            d = fold(d, u.port as u64);

            let fields_len = u.field_data.len();
            d = fold(d, fields_len as u64);
            let mut i = 0usize;
            while i < fields_len {
                d = fold(d, u.field_data[i].off as u64);
                d = fold(d, u.field_data[i].len as u64);
                i += 1;
            }

            d = fold(d, u_clone.field_set as u64);
            d = fold(d, u_clone.port as u64);

            let clone_fields_len = u_clone.field_data.len();
            d = fold(d, clone_fields_len as u64);
            let mut j = 0usize;
            while j < clone_fields_len {
                d = fold(d, u_clone.field_data[j].off as u64);
                d = fold(d, u_clone.field_data[j].len as u64);
                j += 1;
            }

            d
        };
        digest = fold(digest, iter_digest);
    }

    format!("op=parse_url_and_meta rc={} digest={:016x}", last_rc, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        (
            "execute_request_stream",
            execute_request_stream as fn(&[u8], u64) -> String,
        ),
        (
            "execute_response_stream",
            execute_response_stream as fn(&[u8], u64) -> String,
        ),
        (
            "pause_resume_request",
            pause_resume_request as fn(&[u8], u64) -> String,
        ),
        (
            "parse_url_and_meta",
            parse_url_and_meta as fn(&[u8], u64) -> String,
        ),
    ]
}

fn write_seed(dir: &str, op: &str, idx: usize, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.{}.bin", dir, op, idx);
    let _ = fs::write(&path, bytes);
    out.push(format!("seed {} {}", op, path));
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let req1 = b"POST /chunked-ok HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nConnection: keep-alive\r\nX-Lenient: value\twith-tab\r\n\r\n5\r\nhello\r\n0\r\n\r\n";
    let req2 = b"GET http://user:pass@example.com:8080/a/b?x=1&y=two HTTP/1.1\r\nHost: example.com\r\nUser-Agent: harness\r\nAccept: */*\r\nConnection: close\r\nX-Weird@Header: lenient\r\n\r\n";
    write_seed(dir, "execute_request_stream", 1, req1, &mut out);
    write_seed(dir, "execute_request_stream", 2, req2, &mut out);

    let resp1 = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 11\r\nConnection: keep-alive\r\nX-Server\tHint: lenient\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\n\r\n";
    let resp2 =
        b"HTTP/1.0 204 No Content\r\nConnection: close\r\nContent-Length: 0\r\nX-Test@Resp: value\r\n\r\n";
    write_seed(dir, "execute_response_stream", 1, resp1, &mut out);
    write_seed(dir, "execute_response_stream", 2, resp2, &mut out);

    let pause1 = b"POST /upload HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 24\r\nConnection: keep-alive\r\nX-Pause: lenient\tresume\r\n\r\nc\r\nabcdefghijkl\r\nc\r\nmnopqrstuvwx\r\n0\r\n\r\n";
    let pause2 = b"GET /very/long/path/with/query?alpha=1&beta=two&gamma=three HTTP/1.1\r\nHost: example.com\r\nUser-Agent: pause-test\r\nX-Extra@Odd: 1234567890abcdef\r\nConnection: close\r\n\r\n";
    write_seed(dir, "pause_resume_request", 1, pause1, &mut out);
    write_seed(dir, "pause_resume_request", 2, pause2, &mut out);

    let url1 = b"https://user:pass@example.com:8443/a/b/c?x=1&y=two#frag";
    let url2 = b"example.com:443";
    write_seed(dir, "parse_url_and_meta", 1, url1, &mut out);
    write_seed(dir, "parse_url_and_meta", 2, url2, &mut out);

    out
}

