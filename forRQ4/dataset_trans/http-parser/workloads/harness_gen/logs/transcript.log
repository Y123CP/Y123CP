fn op_parse_url(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Non-connect mode
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    0,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
                    h = fold(h, u.field_data[i].off as u64);
                    h = fold(h, u.field_data[i].len as u64);
                }
            }

            // Connect mode
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    1,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
                    h = fold(h, u.field_data[i].off as u64);
                    h = fold(h, u.field_data[i].len as u64);
                }
            }

            digest = fold(digest, h);
        }
    }
    format!("op=parse_url digest={:016x}", digest)
}

fn op_method_status_version(_data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            let ver = http_parser_version();
            h = fold(h, ver as u64);

            http_parser_set_max_header_size(8192);
            h = fold(h, 8192u64);

            for m in 0u32..=33 {
                let s = http_method_str(m as http_method);
                let slen = cstr_len(s);
                h = fold(h, m as u64);
                h = fold(h, slen);
                if !s.is_null() && slen > 0 {
                    h = fold(h, *s as u8 as u64);
                }
            }

            for sc in 0u32..=600 {
                let s = http_status_str(sc as http_status);
                let slen = cstr_len(s);
                h = fold(h, sc as u64);
                h = fold(h, slen);
            }

            for e in 0u32..=30 {
                let ename = http_errno_name(e as http_errno);
                let edesc = http_errno_description(e as http_errno);
                h = fold(h, cstr_len(ename));
                h = fold(h, cstr_len(edesc));
            }

            // Pause/unpause
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 0 as http_parser_type);
                http_parser_pause(p, 1);
                h = fold(h, (*p).flags() as u64);
                http_parser_pause(p, 0);
                h = fold(h, (*p).flags() as u64);
            }

            // Clone test
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 1 as http_parser_type);
                (*p).set_lenient_http_headers(1);
                (*p).set_allow_chunked_length(1);
                let cloned = (*p).clone();
                h = fold(h, cloned.http_errno() as u64);
                h = fold(h, cloned.lenient_http_headers() as u64);
                h = fold(h, cloned.allow_chunked_length() as u64);
                h = fold(h, cloned.type_0() as u64);
                h = fold(h, cloned.method() as u64);
            }

            http_parser_set_max_header_size(80 * 1024);

            digest = fold(digest, h);
        }
    }
    format!("op=method_status_version digest={:016x}", digest)
}

/// Parse request data byte-by-byte to exercise incremental parsing paths
fn op_parse_incremental(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let settings = setup_settings();
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Feed one byte at a time
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 0 as http_parser_type);

                let mut total_parsed = 0usize;
                for i in 0..data.len() {
                    let parsed = http_parser_execute(
                        p,
                        &settings as *const http_parser_settings,
                        data.as_ptr().add(i) as *const ::core::ffi::c_char,
                        1,
                    );
                    total_parsed += parsed;
                    // If error, stop
                    if (*p).http_errno() != 0 {
                        break;
                    }
                }
                h = fold(h, digest_parser(p));
                h = fold(h, total_parsed as u64);
            }

            // Feed as response one byte at a time
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 1 as http_parser_type);

                let mut total_parsed = 0usize;
                for i in 0..data.len() {
                    let parsed = http_parser_execute(
                        p,
                        &settings as *const http_parser_settings,
                        data.as_ptr().add(i) as *const ::core::ffi::c_char,
                        1,
                    );
                    total_parsed += parsed;
                    if (*p).http_errno() != 0 {
                        break;
                    }
                }
                h = fold(h, digest_parser(p));
                h = fold(h, total_parsed as u64);
            }

            // Feed in 2-byte chunks as HTTP_BOTH
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 2 as http_parser_type);

                let mut total_parsed = 0usize;
                let mut offset = 0usize;
                while offset < data.len() {
                    let chunk = if offset + 2 <= data.len() { 2 } else { data.len() - offset };
                    let parsed = http_parser_execute(
                        p,
                        &settings as *const http_parser_settings,
                        data.as_ptr().add(offset) as *const ::core::ffi::c_char,
                        chunk,
                    );
                    total_parsed += parsed;
                    offset += chunk;
                    if (*p).http_errno() != 0 {
                        break;
                    }
                }
                h = fold(h, digest_parser(p));
                h = fold(h, total_parsed as u64);
            }

            digest = fold(digest, h);
        }
    }
    format!("op=parse_incremental digest={:016x}", digest)
}

