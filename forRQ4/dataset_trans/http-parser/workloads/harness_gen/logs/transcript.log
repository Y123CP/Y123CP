fn op_parse_request_lenient(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let settings = setup_settings();
    for _ in 0..iters {
        unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let p = parser.as_mut_ptr();
            http_parser_init(p, 0 as http_parser_type);

            // Set lenient HTTP headers
            (*p).set_lenient_http_headers(1);

            let parsed = http_parser_execute(
                p,
                &settings as *const http_parser_settings,
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
            );

            let mut h = digest_parser(p);
            h = fold(h, parsed as u64);
            h = fold(h, (*p).lenient_http_headers() as u64);
            digest = fold(digest, h);
        }
    }
    format!("op=parse_request_lenient digest={:016x}", digest)
}

fn op_parse_response_chunked_lenient(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let settings = setup_settings();
    for _ in 0..iters {
        unsafe {
            // Parse with allow_chunked_length and lenient_http_headers
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let p = parser.as_mut_ptr();
            http_parser_init(p, 1 as http_parser_type); // HTTP_RESPONSE

            (*p).set_allow_chunked_length(1);
            (*p).set_lenient_http_headers(1);

            let parsed = http_parser_execute(
                p,
                &settings as *const http_parser_settings,
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
            );

            let mut h = digest_parser(p);
            h = fold(h, parsed as u64);
            h = fold(h, (*p).allow_chunked_length() as u64);
            h = fold(h, (*p).lenient_http_headers() as u64);

            // Also clone the parser and digest the clone
            let mut parser2: http_parser = (*p).clone();
            let p2 = &mut parser2 as *mut http_parser;
            let h2 = digest_parser(p2);
            h = fold(h, h2);

            digest = fold(digest, h);
        }
    }
    format!("op=parse_response_chunked_lenient digest={:016x}", digest)
}

fn op_parse_url(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Non-connect mode (is_connect = 0)
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    0,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
                    h = fold(h, u.field_data[i].off as u64);
                    h = fold(h, u.field_data[i].len as u64);
                }
            }

            // Connect mode (is_connect = 1)
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    1,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
                    h = fold(h, u.field_data[i].off as u64);
                    h = fold(h, u.field_data[i].len as u64);
                }
            }

            digest = fold(digest, h);
        }
    }
    format!("op=parse_url digest={:016x}", digest)
}

fn op_method_status_version(_data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            let ver = http_parser_version();
            h = fold(h, ver as u64);

            http_parser_set_max_header_size(8192);
            h = fold(h, 8192u64);

            // Method strings
            for m in 0u32..=33 {
                let s = http_method_str(m as http_method);
                let slen = cstr_len(s);
                h = fold(h, m as u64);
                h = fold(h, slen);
                if !s.is_null() && slen > 0 {
                    h = fold(h, *s as u8 as u64);
                }
            }

            // Status strings for many codes
            for sc in 0u32..=600 {
                let s = http_status_str(sc as http_status);
                let slen = cstr_len(s);
                h = fold(h, sc as u64);
                h = fold(h, slen);
            }

            // Errno names and descriptions for all error codes 0..=30
            for e in 0u32..=30 {
                let ename = http_errno_name(e as http_errno);
                let edesc = http_errno_description(e as http_errno);
                h = fold(h, cstr_len(ename));
                h = fold(h, cstr_len(edesc));
            }

            // Pause/unpause test
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 0 as http_parser_type);
                http_parser_pause(p, 1);
                let flags_paused = (*p).flags();
                h = fold(h, flags_paused as u64);
                http_parser_pause(p, 0);
                let flags_unpaused = (*p).flags();
                h = fold(h, flags_unpaused as u64);
            }

            // Test clone
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 1 as http_parser_type);
                (*p).set_lenient_http_headers(1);
                (*p).set_allow_chunked_length(1);
                let cloned = (*p).clone();
                h = fold(h, cloned.http_errno() as u64);
                h = fold(h, cloned.lenient_http_headers() as u64);
                h = fold(h, cloned.allow_chunked_length() as u64);
            }

            http_parser_set_max_header_size(80 * 1024);

            digest = fold(digest, h);
        }
    }
    format!("op=method_status_version digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("parse_request", op_parse_request as fn(&[u8], u64) -> String),
        ("parse_response", op_parse_response as fn(&[u8], u64) -> String),
        ("parse_url", op_parse_url as fn(&[u8], u64) -> String),
        ("method_status_version", op_method_status_version as fn(&[u8], u64) -> String),
        ("parse_both", op_parse_both as fn(&[u8], u64) -> String),
        ("parse_request_lenient", op_parse_request_lenient as fn(&[u8], u64) -> String),
        ("parse_response_chunked_lenient", op_parse_response_chunked_lenient as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_request seeds
    {
        // Seed 1: simple GET with keep-alive
        let s1 = b"GET /index.html HTTP/1.1\r\nHost: example.com\r\nConnection: keep-alive\r\n\r\n";
        // Seed 2: POST with body, chunked transfer encoding, multiple headers
        let s2 = b"POST /submit HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Type: application/json\r\nX-Custom: value\r\n\r\n5\r\nHello\r\n6\r\n World\r\n0\r\n\r\n";
        let p1 = format!("{}/parse_request.1.bin", dir);
        let p2 = format!("{}/parse_request.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_request {}", p1));
        lines.push(format!("seed parse_request {}", p2));
    }

    // parse_response seeds
    {
        // Seed 1: simple 200 with content-length
        let s1 = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: keep-alive\r\n\r\nHello";
        // Seed 2: chunked response with trailers
        let s2 = b"HTTP/1.1 404 Not Found\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nHello\r\n0\r\n\r\n";
        let p1 = format!("{}/parse_response.1.bin", dir);
        let p2 = format!("{}/parse_response.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_response {}", p1));
        lines.push(format!("seed parse_response {}", p2));
    }

    // parse_url seeds
    {
        let s1 = b"http://www.example.com:8080/path/to/resource?query=value&foo=bar#fragment";
        let s2 = b"https://user:pass@api.test.org:443/v2/users?id=42#top";
        let p1 = format!("{}/parse_url.1.bin", dir);
        let p2 = format!("{}/parse_url.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_url {}", p1));
        lines.push(format!("seed parse_url {}", p2));
    }

    // parse_both seeds
    {
        let s1 = b"GET / HTTP/1.0\r\n\r\n";
        let s2 = b"HTTP/1.0 301 Moved\r\nLocation: /new\r\nContent-Length: 0\r\n\r\n";
        let p1 = format!("{}/parse_both.1.bin", dir);
        let p2 = format!("{}/parse_both.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_both {}", p1));
        lines.push(format!("seed parse_both {}", p2));
    }

    // parse_request_lenient seeds - with malformed headers that lenient mode tolerates
    {
        let s1 = b"GET /path HTTP/1.1\r\nHost: example.com\r\nX-Bad Header: value\r\n\r\n";
        let s2 = b"PUT /data HTTP/1.1\r\nHost: example.com\r\nContent-Length: 4\r\nX Weird: yes\r\n\r\ntest";
        let p1 = format!("{}/parse_request_lenient.1.bin", dir);
        let p2 = format!("{}/parse_request_lenient.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_request_lenient {}", p1));
        lines.push(format!("seed parse_request_lenient {}", p2));
    }

    // parse_response_chunked_lenient seeds - chunked with Content-Length (allow_chunked_length)
