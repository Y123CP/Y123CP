        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_request_lenient {}", p1));
        lines.push(format!("seed parse_request_lenient {}", p2));
    }

    // parse_response_chunked_lenient seeds - chunked with Content-Length (allow_chunked_length)
    {
        // Response with both Content-Length and Transfer-Encoding: chunked
        let s1 = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nHello\r\n0\r\n\r\n";
        let s2 = b"HTTP/1.1 201 Created\r\nContent-Length: 11\r\nTransfer-Encoding: chunked\r\nX Bad: val\r\n\r\nb\r\nHello World\r\n0\r\n\r\n";
