        ),
    ]
}

fn write_seed(dir: &str, op: &str, idx: usize, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.{}.bin", dir, op, idx);
    let _ = fs::write(&path, bytes);
    out.push(format!("seed {} {}", op, path));
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let req1 = b"POST /chunked-ok HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 5\r\nConnection: keep-alive\r\nTrailer: X-Trailer\r\nExpect: 100-continue\r\nX-Lenient: value\twith-tab\r\n\r\n5\r\nhello\r\n0\r\nX-Trailer: done\r\n\r\n";
    let req2 = b"CONNECT example.com:443 HTTP/1.1\r\nHost: example.com:443\r\nProxy-Connection: keep-alive\r\nUser-Agent: harness\r\nX-Weird@Header: lenient|mode\r\n\r\n";
    write_seed(dir, "execute_request_stream", 1, req1, &mut out);
    write_seed(dir, "execute_request_stream", 2, req2, &mut out);

    let resp1 = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nContent-Length: 11\r\nConnection: keep-alive\r\nTrailer: X-Trailer\r\nX-Server\tHint: lenient\r\n\r\n5\r\nhello\r\n6\r\n world\r\n0\r\nX-Trailer: yes\r\n\r\n";
    let resp2 = b"HTTP/1.1 101 Switching Protocols\r\nConnection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Accept: abcdefghijklmnop\r\n\r\n";
    write_seed(dir, "execute_response_stream", 1, resp1, &mut out);
    write_seed(dir, "execute_response_stream", 2, resp2, &mut out);

    let pause1 = b"POST /upload HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 24\r\nConnection: keep-alive\r\nX-Pause: lenient\tresume\r\n\r\nc\r\nabcdefghijkl\r\nc\r\nmnopqrstuvwx\r\n0\r\n\r\n";
    let pause2 = b"HEAD /very/long/path/with/query?alpha=1&beta=two&gamma=three HTTP/1.1\r\nHost: example.com\r\nUser-Agent: pause-test\r\nIf-Modified-Since: Tue, 15 Nov 1994 08:12:31 GMT\r\nX-Extra@Odd: 1234567890abcdef\r\nConnection: close\r\n\r\n";
    write_seed(dir, "pause_resume_request", 1, pause1, &mut out);
    write_seed(dir, "pause_resume_request", 2, pause2, &mut out);

    let url1 = b"https://user:pass@example.com:8443/a/b/c?x=1&y=two#frag";
    let url2 = b"example.com:443";
    write_seed(dir, "parse_url_and_meta", 1, url1, &mut out);
    write_seed(dir, "parse_url_and_meta", 2, url2, &mut out);

    let auto1 = b"GET /auto?x=1 HTTP/1.1\r\nHost: example.com\r\nConnection: keep-alive\r\nContent-Length: 0\r\n\r\n";
    let auto2 = b"HTTP/1.0 204 No Content\r\nConnection: close\r\nContent-Length: 0\r\nX-Test@Resp: value\r\n\r\n";
    write_seed(dir, "execute_auto_stream", 1, auto1, &mut out);
    write_seed(dir, "execute_auto_stream", 2, auto2, &mut out);

    let clone1 = b"POST /clone HTTP/1.1\r\nHost: example.com\r\nTransfer-Encoding: chunked\r\nContent-Length: 10\r\nConnection: keep-alive\r\nX-Clone: yes\tlenient\r\n\r\n5\r\nabcde\r\n5\r\n12345\r\n0\r\n\r\n";
    let clone2 = b"HTTP/1.1 206 Partial Content\r\nContent-Length: 9\r\nConnection: keep-alive\r\nContent-Range: bytes 0-8/9\r\nX-Clone@Resp: mirrored\r\n\r\n123456789";
    write_seed(dir, "clone_roundtrip", 1, clone1, &mut out);
    write_seed(dir, "clone_roundtrip", 2, clone2, &mut out);

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let mut req_big = Vec::new();
    for i in 0..80_000u32 {
