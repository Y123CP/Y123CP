    if ptr.is_null() {
        return 0;
    }
    let mut l = 0usize;
    while *ptr.add(l) != 0 {
        l += 1;
    }
    l as u64
}

fn op_parse_request(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let settings = setup_settings();
    for _ in 0..iters {
        unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let p = parser.as_mut_ptr();
            // HTTP_REQUEST = 0
            http_parser_init(p, 0 as http_parser_type);

            let parsed = http_parser_execute(
                p,
                &settings as *const http_parser_settings,
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
            );

            let keep_alive = http_should_keep_alive(p as *const http_parser);
            let body_final = http_body_is_final(p as *const http_parser);
            let needs_eof = http_message_needs_eof(p as *const http_parser);

            // Access parser fields via bitfield accessors
            let errno_val = (*p).errno();
            let upgrade_val = (*p).upgrade();
            let method_val = (*p).method();
            let status_code = (*p).status_code();
            let http_major = (*p).http_major;
            let http_minor = (*p).http_minor;

            let mut h = 0u64;
            h = fold(h, parsed as u64);
            h = fold(h, errno_val as u64);
            h = fold(h, upgrade_val as u64);
            h = fold(h, method_val as u64);
            h = fold(h, status_code as u64);
            h = fold(h, http_major as u64);
            h = fold(h, http_minor as u64);
            h = fold(h, keep_alive as u64);
            h = fold(h, body_final as u64);
            h = fold(h, needs_eof as u64);

            digest = fold(digest, h);
        }
    }
    format!("op=parse_request digest={:016x}", digest)
}

fn op_parse_response(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let settings = setup_settings();
    for _ in 0..iters {
        unsafe {
            let mut parser = MaybeUninit::<http_parser>::zeroed();
            let p = parser.as_mut_ptr();
            // HTTP_RESPONSE = 1
            http_parser_init(p, 1 as http_parser_type);

            let parsed = http_parser_execute(
                p,
                &settings as *const http_parser_settings,
                data.as_ptr() as *const ::core::ffi::c_char,
                data.len(),
            );

            let keep_alive = http_should_keep_alive(p as *const http_parser);
            let body_final = http_body_is_final(p as *const http_parser);
            let needs_eof = http_message_needs_eof(p as *const http_parser);

            let errno_val = (*p).errno();
            let upgrade_val = (*p).upgrade();
            let status_code = (*p).status_code();
            let http_major = (*p).http_major;
            let http_minor = (*p).http_minor;

            // Get errno name and description
            let ename_len = cstr_len(http_errno_name(errno_val as http_errno));
            let edesc_len = cstr_len(http_errno_description(errno_val as http_errno));

            let mut h = 0u64;
            h = fold(h, parsed as u64);
            h = fold(h, errno_val as u64);
            h = fold(h, upgrade_val as u64);
            h = fold(h, status_code as u64);
            h = fold(h, http_major as u64);
            h = fold(h, http_minor as u64);
            h = fold(h, keep_alive as u64);
            h = fold(h, body_final as u64);
            h = fold(h, needs_eof as u64);
            h = fold(h, ename_len);
            h = fold(h, edesc_len);

            digest = fold(digest, h);
        }
    }
    format!("op=parse_response digest={:016x}", digest)
}

fn op_parse_url(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Non-connect mode (is_connect = 0)
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    0,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
                    h = fold(h, u.field_data[i].off as u64);
                    h = fold(h, u.field_data[i].len as u64);
                }
            }

            // Connect mode (is_connect = 1)
            {
                let mut url = MaybeUninit::<http_parser_url>::zeroed();
                http_parser_url_init(url.as_mut_ptr());
                let rc = http_parser_parse_url(
                    data.as_ptr() as *const ::core::ffi::c_char,
                    data.len(),
                    1,
                    url.as_mut_ptr(),
                );
                let u = url.assume_init();
                h = fold(h, rc as u64);
                h = fold(h, u.field_set as u64);
                h = fold(h, u.port as u64);
                for i in 0..7 {
                    h = fold(h, u.field_data[i].off as u64);
                    h = fold(h, u.field_data[i].len as u64);
                }
            }

            digest = fold(digest, h);
        }
    }
    format!("op=parse_url digest={:016x}", digest)
}

fn op_method_status_version(_data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    for _ in 0..iters {
        unsafe {
            let mut h = 0u64;

            // Version
            let ver = http_parser_version();
            h = fold(h, ver as u64);

            // Set max header size
            http_parser_set_max_header_size(8192);
            h = fold(h, 8192u64);

            // Method strings: iterate over method values 0..=33 (covers all known methods)
            for m in 0u32..=33 {
                let s = http_method_str(m as http_method);
                let slen = cstr_len(s);
                h = fold(h, m as u64);
                h = fold(h, slen);
                // Also fold first char if available
                if !s.is_null() && slen > 0 {
                    h = fold(h, *s as u8 as u64);
                }
            }

            // Status strings for common codes
            let status_codes: &[u32] = &[
                100, 101, 200, 201, 204, 206, 301, 302, 303, 304, 307, 308, 400, 401, 403, 404,
                405, 408, 409, 410, 411, 413, 414, 415, 416, 417, 426, 429, 500, 501, 502, 503,
                504, 505,
            ];
            for &sc in status_codes {
                let s = http_status_str(sc as http_status);
                let slen = cstr_len(s);
                h = fold(h, sc as u64);
                h = fold(h, slen);
            }

            // Pause/unpause test
            {
                let mut parser = MaybeUninit::<http_parser>::zeroed();
                let p = parser.as_mut_ptr();
                http_parser_init(p, 0 as http_parser_type);
                http_parser_pause(p, 1);
                let flags_paused = (*p).flags();
                h = fold(h, flags_paused as u64);
                http_parser_pause(p, 0);
                let flags_unpaused = (*p).flags();
                h = fold(h, flags_unpaused as u64);
            }

            // Restore max header size
            http_parser_set_max_header_size(80 * 1024);

            digest = fold(digest, h);
        }
    }
    format!("op=method_status_version digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("parse_request", op_parse_request as fn(&[u8], u64) -> String),
        (
            "parse_response",
            op_parse_response as fn(&[u8], u64) -> String,
        ),
        ("parse_url", op_parse_url as fn(&[u8], u64) -> String),
        (
            "method_status_version",
            op_method_status_version as fn(&[u8], u64) -> String,
        ),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_request seeds
    {
        let s1 = b"GET /index.html HTTP/1.1\r\nHost: example.com\r\nConnection: keep-alive\r\n\r\n";
        let s2 = b"POST /submit HTTP/1.1\r\nHost: example.com\r\nContent-Length: 13\r\nConnection: close\r\n\r\nHello, World!";
        let p1 = format!("{}/parse_request.1.bin", dir);
        let p2 = format!("{}/parse_request.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_request {}", p1));
        lines.push(format!("seed parse_request {}", p2));
    }

    // parse_response seeds
    {
        let s1 = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nHello";
        let s2 = b"HTTP/1.1 404 Not Found\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nHello\r\n0\r\n\r\n";
        let p1 = format!("{}/parse_response.1.bin", dir);
        let p2 = format!("{}/parse_response.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_response {}", p1));
        lines.push(format!("seed parse_response {}", p2));
    }

    // parse_url seeds
    {
        let s1 = b"http://www.example.com:8080/path/to/resource?query=value&foo=bar#fragment";
        let s2 = b"https://api.test.org:443/v2/users?id=42";
        let p1 = format!("{}/parse_url.1.bin", dir);
        let p2 = format!("{}/parse_url.2.bin", dir);
        fs::write(&p1, s1).unwrap();
        fs::write(&p2, s2).unwrap();
        lines.push(format!("seed parse_url {}", p1));
        lines.push(format!("seed parse_url {}", p2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // parse_request perf: many pipelined GET requests
    {
        let single_req = b"GET /path/to/resource?key=value HTTP/1.1\r\nHost: example.com\r\nAccept: text/html\r\nAccept-Language: en-US\r\nUser-Agent: Mozilla/5.0\r\nConnection: keep-alive\r\n\r\n";
        let mut big = Vec::new();
        for _ in 0..3000 {
            big.extend_from_slice(single_req);
        }
        let path = format!("{}/parse_request.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_request {}", path));
    }

    // parse_response perf: many pipelined responses
    {
        let single_resp = b"HTTP/1.1 200 OK\r\nContent-Length: 27\r\nContent-Type: text/plain\r\nServer: TestServer/1.0\r\n\r\nThis is the response body.\n";
        let mut big = Vec::new();
        for _ in 0..3000 {
            big.extend_from_slice(single_resp);
        }
        let path = format!("{}/parse_response.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_response {}", path));
    }

    // parse_url perf: a very long URL
    {
        let mut big = Vec::new();
        big.extend_from_slice(b"http://www.example.com:8080/");
        for i in 0..50000u32 {
            big.extend_from_slice(format!("seg{}/", i).as_bytes());
        }
        big.extend_from_slice(b"?key=value#frag");
        let path = format!("{}/parse_url.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf parse_url {}", path));
    }

    lines
}
