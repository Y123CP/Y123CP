#[derive(Clone, Copy, Default)]
struct CallbackState {
    digest: u64,
    calls: u64,
    url_bytes: u64,
    status_bytes: u64,
    header_field_bytes: u64,
    header_value_bytes: u64,
    body_bytes: u64,
}

thread_local! {
    static CALLBACK_STATE: RefCell<CallbackState> = RefCell::new(CallbackState::default());
}

fn cb_reset(seed: u64) {
    CALLBACK_STATE.with(|s| {
        *s.borrow_mut() = CallbackState {
            digest: fold(0, seed),
            ..CallbackState::default()
        };
    });
}

fn cb_take() -> CallbackState {
    CALLBACK_STATE.with(|s| *s.borrow())
}

fn cb_mix(x: u64) {
    CALLBACK_STATE.with(|s| {
        let mut st = s.borrow_mut();
        st.digest = fold(st.digest, x);
    });
}

fn cb_mix_bytes(kind: u64, at: *const ::core::ffi::c_char, len: usize) {
    let sum = if at.is_null() || len == 0 {
        0
    } else {
        unsafe { bytes_checksum(std::slice::from_raw_parts(at as *const u8, len)) }
    };
    CALLBACK_STATE.with(|s| {
        let mut st = s.borrow_mut();
        st.calls = st.calls.wrapping_add(1);
        st.digest = fold(st.digest, kind);
        st.digest = fold(st.digest, len as u64);
        st.digest = fold(st.digest, sum);
        match kind {
            2 => st.url_bytes = st.url_bytes.wrapping_add(len as u64),
            3 => st.status_bytes = st.status_bytes.wrapping_add(len as u64),
            4 => st.header_field_bytes = st.header_field_bytes.wrapping_add(len as u64),
