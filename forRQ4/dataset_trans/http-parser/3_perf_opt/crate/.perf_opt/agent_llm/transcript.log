#[inline(always)]
pub unsafe fn http_message_needs_eof(
    mut parser: *const http_parser,
) -> c_int {
    let parser_view: &http_parser = unsafe { &*parser };
    if parser_view.type_0() as c_int == HTTP_REQUEST as c_int {
        return 0 as c_int;
    }
    if parser_view.status_code() as c_int / 100 as c_int
        == 1 as c_int
        || parser_view.status_code() as c_int == 204 as c_int
        || parser_view.status_code() as c_int == 304 as c_int
        || parser_view.flags() as c_int & F_SKIPBODY as c_int != 0
    {
        return 0 as c_int;
    }
    if parser_view.uses_transfer_encoding() as c_int == 1 as c_int
        && parser_view.flags() as c_int & F_CHUNKED as c_int
            == 0 as c_int
    {
        return 1 as c_int;
