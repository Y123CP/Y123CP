          "replacement_function_source": "#[inline]\npub unsafe fn http_message_needs_eof(\n    mut parser: *const http_parser,\n) -> c_int {\n    let parser_view: &http_parser = unsafe { &*parser }; // SAFETY: caller guarantees `parser` is a valid pointer to `http_parser` for reads.\n\n    let bits0 = u32::from_ne_bytes(\n        parser_view\n            .type_0_flags_state_header_state_index_uses_transfer_encoding_allow_chunked_length_lenient_http_headers,\n    );\n    let bits1 = u32::from_ne_bytes(parser_view.status_code_method_http_errno_upgrade);\n\n    let type_0 = bits0 & 0x3;\n    if type_0 == HTTP_REQUEST as u32 {\n        return 0;\n    }\n\n    let flags = (bits0 >> 2) & 0xff;\n    let status_code = bits1 & 0xffff;\n\n    if status_code / 100 == 1\n        || status_code == 204\n        || status_code == 304\n        || (flags & F_SKIPBODY as u32) != 0\n    {\n        return 0;\n    }\n\n    let uses_transfer_encoding = (bits0 >> 29) & 0x1;\n    if uses_transfer_encoding == 1 && (flags & F_CHUNKED as u32) == 0 {\n        return 1;\n    }\n\n    if (flags & F_CHUNKED as u32) != 0 || parser_view.content_length as c_ulonglong != ULLONG_MAX {\n        return 0;\n    }\n\n    1\n}",
