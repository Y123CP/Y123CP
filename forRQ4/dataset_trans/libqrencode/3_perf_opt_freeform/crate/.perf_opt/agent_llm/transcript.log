unsafe fn Mask_calcN2(
    mut width: c_int,
    mut frame: *mut c_uchar,
) -> c_int {
    // Applied rules:
    // - Hoist invariant width conversion out of inner loop.
    // - Use row-based traversal to reduce pointer arithmetic in the hot path.
    // Skipped rules:
    // - No widened/vectorized loads: exact byte semantics must be preserved.

    let mut demerit: c_int = 0;
    if width <= 1 {
        return demerit;
    }

    let w = width as isize;
    let mut y: c_int = 1;
    // SAFETY: Caller guarantees `frame` points to a valid `width * width` byte grid;
    // width > 1 here, so advancing to row 1, col 1 stays within the allocation.
    let mut row = unsafe { frame.offset(w).offset(1) };

    while y < width {
        let mut x: c_int = 1;
        let mut p = row;
        while x < width {
            // SAFETY: For 1 <= x,y < width, p points at frame[y][x], and the offsets
            // -1, -w, and -w-1 refer to frame[y][x-1], frame[y-1][x], frame[y-1][x-1],
            // all within the same valid allocation.
            let c = unsafe { *p } as c_int;
            // SAFETY: See above; p.offset(-1) is in-bounds.
            let l = unsafe { *p.offset(-1) } as c_int;
            // SAFETY: See above; p.offset(-w) is in-bounds.
            let u = unsafe { *p.offset(-w) } as c_int;
            // SAFETY: See above; p.offset(-w - 1) is in-bounds.
            let ul = unsafe { *p.offset(-w - 1) } as c_int;

            let b22 = c & l & u & ul;
            let w22 = c | l | u | ul;
            if ((b22 | (w22 ^ 1)) & 1) != 0 {
                demerit += N2;
            }

            // SAFETY: Advancing within the current row; loop bounds ensure p remains
            // within or one-past the row segment being traversed.
            p = unsafe { p.offset(1) };
            x += 1;
        }
        // Match original pointer progression exactly: after inner loop p is one-past
        // the processed row segment, then advance one more to the next row's col 1.
        // SAFETY: row points to col 1 of row y; adding w + 1 reaches col 1 of row y+1,
        // or one-past the allocation after the final iteration, which is not dereferenced.
        row = unsafe { row.offset(w + 1) };
        y += 1;
    }

    demerit
}
