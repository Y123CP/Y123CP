                        b as *mut _,
                        2 as QRencodeMode,
                        tail.len().min(i32::MAX as usize) as i32,
                        if tail.is_empty() {
                            ptr::null()
                        } else {
                            tail.as_ptr()
                        },
                    );
                    digest = fold(digest, rc as u64);
                    let rc2 = QRinput_Struct_appendInput(s as *mut _, b as *mut _);
                    digest = fold(digest, rc2 as u64);
                }
                let rc = QRinput_Struct_insertStructuredAppendHeaders(s as *mut _);
                digest = fold(digest, rc as u64);
                let ql = QRcode_encodeInputStructured(s as *mut _);
                let (ld2, sz2) = qrcode_list_digest(ql as *mut _);
                digest = fold(digest, ld2);
                digest = fold(digest, sz2 as u64);
                if !ql.is_null() {
                    QRcode_List_free(ql as *mut _);
                }
                QRinput_Struct_free(s as *mut _);
            }

            let cbytes = sanitize_c_string_bytes(data);
            let split_input = QRinput_new2(version, level);
            if !split_input.is_null() {
                let rc = Split_splitStringToQRinput(
                    cbytes.as_ptr() as *const i8,
                    split_input as *mut _,
                    mode,
                    (*data.get(6).unwrap_or(&1) & 1) as i32,
                );
                digest = fold(digest, rc as u64);
                let q = QRcode_encodeInput(split_input as *mut _);
                digest = fold(digest, qrcode_digest(q as *mut _));
                if !q.is_null() {
                    QRcode_free(q as *mut _);
                }
                QRinput_free(split_input as *mut _);
            }
        }
    }

    format!("op=encode_data_and_input err={} digest={:016x}", last_err, digest)
}

fn op_spec_mask_ecc(data: &[u8], iters: u64) -> String {
    let mut digest = checksum_bytes(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let b0 = *data.get(0).unwrap_or(&1);
            let b1 = *data.get(1).unwrap_or(&1);
            let b2 = *data.get(2).unwrap_or(&0);
            let b3 = *data.get(3).unwrap_or(&0);

            let version = safe_qr_version(b0);
            let mqr_version = safe_mqr_version(b1);
            let level = choose_level_qr(b2);
            let mlevel = choose_level_mqr(b2);
            let qr_mask = safe_qr_mask(b3);
            let mqr_mask = safe_mqr_mask(b3);
            let mode = choose_mode_qr(*data.get(4).unwrap_or(&2));
            let mmode = choose_mode_mqr(*data.get(4).unwrap_or(&2));
            let payload = if data.len() > 5 { &data[5..] } else { &[][..] };

            digest = fold(digest, QRspec_getDataLength(version, level) as u64);
            digest = fold(digest, QRspec_getECCLength(version, level) as u64);
            digest = fold(
                digest,
                QRspec_getMinimumVersion(payload.len().min(i32::MAX as usize) as i32, level) as u64,
            );
            let width = QRspec_getWidth(version);
            digest = fold(digest, width as u64);
            digest = fold(digest, QRspec_getRemainder(version) as u64);
            digest = fold(digest, QRspec_lengthIndicator(mode, version) as u64);
            digest = fold(digest, QRspec_maximumWords(mode, version) as u64);

            let mut spec = [0i32; 5];
            QRspec_getEccSpec(version, level, spec.as_mut_ptr());
            for &x in &spec {
                digest = fold(digest, x as u64);
            }

            digest = fold(digest, QRspec_getVersionPattern(version) as u64);
            digest = fold(digest, QRspec_getFormatInfo(qr_mask, level) as u64);

            let frame = QRspec_newFrame(version);
            digest = fold(digest, (!frame.is_null()) as u64);
            if !frame.is_null() && width > 0 {
                let flen = (width as usize).saturating_mul(width as usize);
                let fbytes = std::slice::from_raw_parts(frame, flen);
                digest = fold(digest, checksum_bytes(fbytes));

                let masked1 = Mask_makeMask(width, frame, qr_mask, level);
                digest = fold(digest, (!masked1.is_null()) as u64);
                if !masked1.is_null() {
                    let mbytes = std::slice::from_raw_parts(masked1, flen);
                    digest = fold(digest, checksum_bytes(mbytes));
                }

                let masked2 = Mask_mask(width, frame, level);
                digest = fold(digest, (!masked2.is_null()) as u64);
                if !masked2.is_null() {
                    let mbytes = std::slice::from_raw_parts(masked2, flen);
                    digest = fold(digest, checksum_bytes(mbytes));
                }
            }

            digest = fold(digest, MQRspec_getDataLengthBit(mqr_version, mlevel) as u64);
            digest = fold(digest, MQRspec_getDataLength(mqr_version, mlevel) as u64);
            digest = fold(digest, MQRspec_getECCLength(mqr_version, mlevel) as u64);
            let mwidth = MQRspec_getWidth(mqr_version);
            digest = fold(digest, mwidth as u64);
            digest = fold(digest, MQRspec_lengthIndicator(mmode, mqr_version) as u64);
            digest = fold(digest, MQRspec_maximumWords(mmode, mqr_version) as u64);
            digest = fold(digest, MQRspec_getFormatInfo(mqr_mask, mqr_version, mlevel) as u64);

            let mframe = MQRspec_newFrame(mqr_version);
            digest = fold(digest, (!mframe.is_null()) as u64);
            if !mframe.is_null() && mwidth > 0 {
                let flen = (mwidth as usize).saturating_mul(mwidth as usize);
                let fbytes = std::slice::from_raw_parts(mframe, flen);
                digest = fold(digest, checksum_bytes(fbytes));

                let masked1 = MMask_makeMask(mqr_version, mframe, mqr_mask, mlevel);
                digest = fold(digest, (!masked1.is_null()) as u64);
                if !masked1.is_null() {
                    let mbytes = std::slice::from_raw_parts(masked1, flen);
                    digest = fold(digest, checksum_bytes(mbytes));
                }

                let masked2 = MMask_mask(mqr_version, mframe, mlevel);
                digest = fold(digest, (!masked2.is_null()) as u64);
                if !masked2.is_null() {
                    let mbytes = std::slice::from_raw_parts(masked2, flen);
                    digest = fold(digest, checksum_bytes(mbytes));
                }
            }

            let bs1 = BitStream_new();
            let bs2 = BitStream_new();
            digest = fold(digest, (!bs1.is_null()) as u64);
            digest = fold(digest, (!bs2.is_null()) as u64);
            if !bs1.is_null() && !bs2.is_null() {
                let rc1 = BitStream_appendNum(bs1 as *mut _, 8, b0 as u32);
                let rc2 = BitStream_appendNum(bs1 as *mut _, 6, b1 as u32);
                let rc3 = BitStream_appendBytes(
                    bs1 as *mut _,
                    payload.len(),
                    if payload.is_empty() {
                        ptr::null_mut()
                    } else {
                        payload.as_ptr() as *mut u8
                    },
                );
                let rc4 = BitStream_appendNum(bs2 as *mut _, 4, b2 as u32);
                let rc5 = BitStream_appendBytes(
                    bs2 as *mut _,
                    payload.len().min(32),
                    if payload.is_empty() {
                        ptr::null_mut()
                    } else {
                        payload.as_ptr() as *mut u8
                    },
                );
                let rc6 = BitStream_append(bs1 as *mut _, bs2 as *mut _);
                last_err = rc1 ^ rc2 ^ rc3 ^ rc4 ^ rc5 ^ rc6;
                digest = fold(digest, rc1 as u64);
                digest = fold(digest, rc2 as u64);
                digest = fold(digest, rc3 as u64);
                digest = fold(digest, rc4 as u64);
                digest = fold(digest, rc5 as u64);
                digest = fold(digest, rc6 as u64);

                let out = BitStream_toByte(bs1 as *mut _);
                digest = fold(digest, (!out.is_null()) as u64);
                if !out.is_null() {
                    let guess = payload.len().saturating_add(8);
                    let bytes = std::slice::from_raw_parts(out, guess.min(4096));
                    digest = fold(digest, checksum_bytes(bytes));
                }
            }
            if !bs2.is_null() {
                BitStream_free(bs2 as *mut _);
            }
            if !bs1.is_null() {
                BitStream_free(bs1 as *mut _);
            }

            let data_len = payload.len().min(255);
            let ecc_len = 16usize + (b3 as usize % 32);
            let mut ecc = vec![0u8; ecc_len];
            let rc = RSECC_encode(
                data_len,
                ecc_len,
                if data_len == 0 {
                    ptr::null()
                } else {
                    payload.as_ptr()
                },
                ecc.as_mut_ptr(),
            );
            digest = fold(digest, rc as u64);
            digest = fold(digest, checksum_bytes(&ecc));
            last_err ^= rc;
        }
    }

    format!("op=spec_mask_ecc err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        (
            "encode_string_api",
            op_encode_string_api as fn(&[u8], u64) -> String,
        ),
        (
            "encode_data_and_input",
            op_encode_data_and_input as fn(&[u8], u64) -> String,
        ),
        (
            "spec_mask_ecc",
            op_spec_mask_ecc as fn(&[u8], u64) -> String,
        ),
    ]
}

fn write_seed(dir: &str, op: &str, idx: usize, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.{}.bin", dir, op, idx);
    let _ = fs::write(&path, bytes);
    out.push(format!("seed {} {}", op, path));
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let s1 = b"https://example.com/pay?id=42&amt=19.95\nNAME:ALICE;TEL:+12025550123;".to_vec();
    let s2 = b"MECARD:N:Doe,John;TEL:5551234567;EMAIL:john.doe@example.org;NOTE:HELLO-QR_123!"
        .to_vec();
    write_seed(dir, "encode_string_api", 1, &s1, &mut out);
    write_seed(dir, "encode_string_api", 2, &s2, &mut out);

    let d1 =
        b"BEGIN:VCARD\nVERSION:3.0\nN:Smith;Jane;;;\nFN:Jane Smith\nTEL:+1-555-0100\nEND:VCARD\n"
            .to_vec();
    let mut d2 = Vec::new();
    for i in 0..256u32 {
        d2.extend_from_slice(format!("REC{:04}|ITEM{:03}|{}\n", i, i % 97, i ^ 0x55aa).as_bytes());
        d2.push((i & 0xff) as u8);
        d2.push(((i * 7) & 0xff) as u8);
    }
    write_seed(dir, "encode_data_and_input", 1, &d1, &mut out);
    write_seed(dir, "encode_data_and_input", 2, &d2, &mut out);

    let mut c1 = vec![3, 1, 0, 0, 2];
    c1.extend_from_slice(b"HELLO1234-QR-PAYLOAD");
    let mut c2 = vec![8, 2, 1, 3, 1];
    c2.extend_from_slice(b"\x10\x20\x30ECC-and-bitstream-test-987654321");
    write_seed(dir, "spec_mask_ecc", 1, &c1, &mut out);
    write_seed(dir, "spec_mask_ecc", 2, &c2, &mut out);

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let mut big_text = Vec::new();
    for i in 0..120_000u32 {
        big_text.extend_from_slice(
            format!(
                "https://example.org/item/{:06}?cat=books&sku={:08}&name=ALPHA-BETA-GAMMA-{}\n",
