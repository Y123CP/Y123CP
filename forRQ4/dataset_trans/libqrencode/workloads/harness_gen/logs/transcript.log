            digest = fold(digest, QRinput_isSplittableMode(mode) as u64);
            digest = fold(digest, QRinput_estimateBitsModeNum(size_i32) as u64);
            digest = fold(digest, QRinput_estimateBitsModeAn(size_i32) as u64);
            digest = fold(digest, QRinput_estimateBitsMode8(size_i32) as u64);
            digest = fold(digest, QRinput_estimateBitsModeKanji(size_i32) as u64);
