                    cur = (*cur).next;
                }

                QRcode_List_free(list);
                digest = fold(digest, h);
            }
        }
    }
    format!("op=structured_encode err={} digest={:016x}", last_err, digest)
}

fn op_spec_queries(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;

    for _ in 0..iters {
        // We need at least a few bytes to derive parameters
        let get = |idx: usize| -> u8 {
            if idx < data.len() {
                data[idx]
            } else {
                0
            }
        };

        let version = (get(0) % 40) as i32 + 1; // 1-40
        let level = (get(1) % 4) as u32;
        let mask = (get(2) % 8) as i32;
        let mqr_version = (get(3) % 4) as i32 + 1; // 1-4
        let mode = (get(4) % 4) as i32; // QR_MODE_NUL=0..QR_MODE_KANJI=3

        let mut h = 0u64;

        unsafe {
            // QRspec queries
            let dl = QRspec_getDataLength(version, level);
            h = fold(h, dl as u64);

            let el = QRspec_getECCLength(version, level);
            h = fold(h, el as u64);

            let w = QRspec_getWidth(version);
            h = fold(h, w as u64);

            let rem = QRspec_getRemainder(version);
            h = fold(h, rem as u64);

            let mv = QRspec_getMinimumVersion(10, level);
            h = fold(h, mv as u64);

            let li = QRspec_lengthIndicator(mode, version);
            h = fold(h, li as u64);

            let mw = QRspec_maximumWords(mode, version);
            h = fold(h, mw as u64);

            let vp = QRspec_getVersionPattern(version);
            h = fold(h, vp as u64);

            let fi = QRspec_getFormatInfo(mask, level);
            h = fold(h, fi as u64);

            // MQRspec queries
            let mdl = MQRspec_getDataLength(mqr_version, level);
            h = fold(h, mdl as u64);

            let mel = MQRspec_getECCLength(mqr_version, level);
            h = fold(h, mel as u64);

            let mw2 = MQRspec_getWidth(mqr_version);
            h = fold(h, mw2 as u64);

            let mli = MQRspec_lengthIndicator(mode, mqr_version);
            h = fold(h, mli as u64);

            let mmw = MQRspec_maximumWords(mode, mqr_version);
            h = fold(h, mmw as u64);

            let mfi = MQRspec_getFormatInfo(mask % 4, mqr_version, level);
            h = fold(h, mfi as u64);

            // RSECC_encode
            let data_len: usize = 4;
            let ecc_len: usize = 4;
            let rsecc_data: [u8; 4] = [get(5), get(6), get(7), get(8)];
            let mut ecc_out: [u8; 4] = [0; 4];
            let rret = RSECC_encode(
                data_len,
                ecc_len,
                rsecc_data.as_ptr(),
                ecc_out.as_mut_ptr(),
            );
            h = fold(h, rret as u64);
            for b in &ecc_out {
                h = fold(h, *b as u64);
            }

            // BitStream ops
            let bs = BitStream_new();
            if !bs.is_null() {
                let num_val = ((get(9) as u32) << 8) | (get(10) as u32);
                BitStream_appendNum(bs, 16, num_val);

                let bs_data: [u8; 3] = [get(11), get(12), get(13)];
                BitStream_appendBytes(bs, 3, bs_data.as_ptr() as *mut u8);

                let out = BitStream_toByte(bs);
                if !out.is_null() {
                    // The output length is ceil((16+24)/8) = 5 bytes
                    for i in 0..5usize {
                        h = fold(h, *out.add(i) as u64);
                    }
                    libc_free(out as *mut _);
                }
                BitStream_free(bs);
            }

            // APIVersion
            let mut major: i32 = 0;
            let mut minor: i32 = 0;
            let mut micro: i32 = 0;
            QRcode_APIVersion(&mut major, &mut minor, &mut micro);
            h = fold(h, major as u64);
            h = fold(h, minor as u64);
            h = fold(h, micro as u64);
        }

        digest = fold(digest, h);
    }
    format!("op=spec_queries err=0 digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("encode_string", op_encode_string as fn(&[u8], u64) -> String),
        ("encode_mqr", op_encode_mqr as fn(&[u8], u64) -> String),
        ("input_build", op_input_build as fn(&[u8], u64) -> String),
        (
            "structured_encode",
            op_structured_encode as fn(&[u8], u64) -> String,
        ),
        ("spec_queries", op_spec_queries as fn(&[u8], u64) -> String),
    ]
}

