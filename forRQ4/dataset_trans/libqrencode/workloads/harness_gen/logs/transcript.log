    QRinput_append, QRinput_dup, QRinput_estimateBitsMode8,
    QRinput_estimateBitsModeNum, QRinput_free, QRinput_getByteStream,
    QRinput_getErrorCorrectionLevel, QRinput_getVersion, QRinput_new2,
    QRinput_setErrorCorrectionLevel, QRinput_setVersion,
};
use libqrencode_raw::src::qrspec::{
    QRspec_getDataLength, QRspec_getECCLength, QRspec_getFormatInfo, QRspec_getMinimumVersion,
    QRspec_getRemainder, QRspec_getVersionPattern, QRspec_getWidth, QRspec_lengthIndicator,
    QRspec_maximumWords,
};
use libqrencode_raw::src::rsecc::RSECC_encode;

extern "C" {
    fn free(ptr: *mut std::ffi::c_void);
}

unsafe fn libc_free(ptr: *mut std::ffi::c_void) {
    free(ptr);
}

fn fold(acc: u64, x: u64) -> u64 {
    acc.wrapping_mul(6364136223846793005).wrapping_add(x)
}

/// Compute a quick checksum of the input bytes to ensure input-sensitivity
fn input_checksum(data: &[u8]) -> u64 {
    let mut h: u64 = data.len() as u64;
    for (i, &b) in data.iter().enumerate() {
        h = h.wrapping_mul(31).wrapping_add(b as u64).wrapping_add(i as u64);
    }
    h
}

fn digest_qrcode(qr: *mut QRcode) -> u64 {
    if qr.is_null() {
        return 0;
    }
    unsafe {
        let width = (*qr).width as u64;
        let mut h = width;
        let total = ((*qr).width * (*qr).width) as usize;
        let data = (*qr).data;
        if !data.is_null() {
            for i in 0..total {
                h = fold(h, *data.add(i) as u64);
            }
        }
        h
    }
}

fn op_encode_string(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    // Always fold input checksum for input-sensitivity
    digest = fold(digest, input_checksum(data));

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let level = (data[0] % 4) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let qr = QRcode_encodeData(
                payload.len() as i32,
                payload.as_ptr(),
                0,
                level,
            );
            if qr.is_null() {
                last_err = -1;
                digest = fold(digest, 0xFFFF);
            } else {
                last_err = 0;
                let h = digest_qrcode(qr);
                digest = fold(digest, h);
                QRcode_free(qr);
            }
        }
    }
    format!("op=encode_string err={} digest={:016x}", last_err, digest)
}

fn op_encode_mqr(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    digest = fold(digest, input_checksum(data));

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let ctrl = data[0];
        let version = ((ctrl & 0x03) as i32) + 1;
        let level_raw = ((ctrl >> 2) & 0x03) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let qr = QRcode_encodeDataMQR(
                payload.len() as i32,
                payload.as_ptr(),
                version,
                level_raw,
            );
            if qr.is_null() {
                last_err = -1;
                digest = fold(digest, 0xFFFF);
            } else {
                last_err = 0;
                let h = digest_qrcode(qr);
                digest = fold(digest, h);
                QRcode_free(qr);
            }
        }
    }
    format!("op=encode_mqr err={} digest={:016x}", last_err, digest)
}

fn op_input_build(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    digest = fold(digest, input_checksum(data));

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let version = (data[0] % 40) as i32 + 1;
        let level = (data[1] % 4) as u32;
        let payload = if data.len() > 2 { &data[2..] } else { &[] };

        unsafe {
            let input = QRinput_new2(version, level);
            if input.is_null() {
                last_err = -1;
                digest = fold(digest, 0);
                continue;
            }

            let mode_8: i32 = 2;
            let ret = if !payload.is_empty() {
                QRinput_append(input, mode_8, payload.len() as i32, payload.as_ptr())
            } else {
                -1
            };

            let mut h = 0u64;

            let ver = QRinput_getVersion(input);
            let lvl = QRinput_getErrorCorrectionLevel(input);
            h = fold(h, ver as u64);
            h = fold(h, lvl as u64);

            let est_num = QRinput_estimateBitsModeNum(payload.len() as i32);
            let est_8 = QRinput_estimateBitsMode8(payload.len() as i32);
            h = fold(h, est_num as u64);
            h = fold(h, est_8 as u64);

            let sv = QRinput_setVersion(input, version);
            h = fold(h, sv as u64);
            let sl = QRinput_setErrorCorrectionLevel(input, level);
            h = fold(h, sl as u64);

            let dup = QRinput_dup(input);
            if !dup.is_null() {
                let dv = QRinput_getVersion(dup);
                h = fold(h, dv as u64);

                if ret == 0 {
                    let bs = QRinput_getByteStream(dup);
                    if !bs.is_null() {
                        libc_free(bs as *mut _);
                    }
                }

                let qr = QRcode_encodeInput(dup as *mut _);
                if !qr.is_null() {
                    let qh = digest_qrcode(qr as *mut _);
                    h = fold(h, qh);
                    QRcode_free(qr as *mut _);
                } else {
                    h = fold(h, 0xDEAD);
                }

                QRinput_free(dup);
            } else {
                h = fold(h, 0xBEEF);
            }

            if ret != 0 {
                last_err = ret;
            } else {
                last_err = 0;
            }

            QRinput_free(input);
            digest = fold(digest, h);
        }
    }
    format!("op=input_build err={} digest={:016x}", last_err, digest)
}

fn op_structured_encode(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    // Fold input checksum so digest always depends on input bytes
    digest = fold(digest, input_checksum(data));

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0xDEAD);
            continue;
        }
        let level = (data[0] % 4) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let list = QRcode_encodeDataStructured(
                payload.len() as i32,
                payload.as_ptr(),
                0,
                level,
            );
            if list.is_null() {
                last_err = -1;
                // Fold payload length and a sample of payload bytes
                let mut h = payload.len() as u64;
                for (i, &b) in payload.iter().enumerate().take(64) {
                    h = fold(h, (b as u64).wrapping_add(i as u64));
                }
                digest = fold(digest, h);
            } else {
                last_err = 0;
                let size = QRcode_List_size(list);
                let mut h = size as u64;

                let mut cur = list;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    let qh = digest_qrcode(qr as *mut _);
                    h = fold(h, qh);
                    cur = (*cur).next;
                }

                QRcode_List_free(list);
                digest = fold(digest, h);
            }
        }
    }
    format!("op=structured_encode err={} digest={:016x}", last_err, digest)
}

fn op_spec_queries(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;

    digest = fold(digest, input_checksum(data));

    for _ in 0..iters {
        let get = |idx: usize| -> u8 {
            if idx < data.len() {
                data[idx]
            } else {
                0
            }
        };

        let version = (get(0) % 40) as i32 + 1;
        let level = (get(1) % 4) as u32;
        let mask = (get(2) % 8) as i32;
        let mqr_version = (get(3) % 4) as i32 + 1;
        let mode = (get(4) % 4) as i32;

        let mut h = 0u64;

        unsafe {
            let dl = QRspec_getDataLength(version, level);
            h = fold(h, dl as u64);

            let el = QRspec_getECCLength(version, level);
            h = fold(h, el as u64);

            let w = QRspec_getWidth(version);
            h = fold(h, w as u64);

            let rem = QRspec_getRemainder(version);
            h = fold(h, rem as u64);

            let mv = QRspec_getMinimumVersion(10, level);
            h = fold(h, mv as u64);

            let li = QRspec_lengthIndicator(mode, version);
            h = fold(h, li as u64);

            let mw = QRspec_maximumWords(mode, version);
            h = fold(h, mw as u64);

            let vp = QRspec_getVersionPattern(version);
            h = fold(h, vp as u64);

            let fi = QRspec_getFormatInfo(mask, level);
            h = fold(h, fi as u64);

            let mdl = MQRspec_getDataLength(mqr_version, level);
            h = fold(h, mdl as u64);

            let mel = MQRspec_getECCLength(mqr_version, level);
            h = fold(h, mel as u64);

            let mw2 = MQRspec_getWidth(mqr_version);
            h = fold(h, mw2 as u64);

            let mli = MQRspec_lengthIndicator(mode, mqr_version);
            h = fold(h, mli as u64);

            let mmw = MQRspec_maximumWords(mode, mqr_version);
            h = fold(h, mmw as u64);

            let mfi = MQRspec_getFormatInfo(mask % 4, mqr_version, level);
            h = fold(h, mfi as u64);

            let data_len: usize = 4;
            let ecc_len: usize = 4;
            let rsecc_data: [u8; 4] = [get(5), get(6), get(7), get(8)];
            let mut ecc_out: [u8; 4] = [0; 4];
            let rret = RSECC_encode(
                data_len,
                ecc_len,
                rsecc_data.as_ptr(),
                ecc_out.as_mut_ptr(),
            );
            h = fold(h, rret as u64);
            for b in &ecc_out {
                h = fold(h, *b as u64);
            }

            let bs = BitStream_new();
            if !bs.is_null() {
                let num_val = ((get(9) as u32) << 8) | (get(10) as u32);
                BitStream_appendNum(bs, 16, num_val);

                let bs_data: [u8; 3] = [get(11), get(12), get(13)];
                BitStream_appendBytes(bs, 3, bs_data.as_ptr() as *mut u8);

                let out = BitStream_toByte(bs);
                if !out.is_null() {
                    for i in 0..5usize {
                        h = fold(h, *out.add(i) as u64);
                    }
                    libc_free(out as *mut _);
                }
                BitStream_free(bs);
            }

            let mut major: i32 = 0;
            let mut minor: i32 = 0;
            let mut micro: i32 = 0;
            QRcode_APIVersion(&mut major, &mut minor, &mut micro);
            h = fold(h, major as u64);
            h = fold(h, minor as u64);
            h = fold(h, micro as u64);
        }

        digest = fold(digest, h);
    }
    format!("op=spec_queries err=0 digest={:016x}", digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("encode_string", op_encode_string as fn(&[u8], u64) -> String),
        ("encode_mqr", op_encode_mqr as fn(&[u8], u64) -> String),
        ("input_build", op_input_build as fn(&[u8], u64) -> String),
        (
            "structured_encode",
            op_structured_encode as fn(&[u8], u64) -> String,
        ),
        ("spec_queries", op_spec_queries as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // encode_string seeds
    {
        let mut s1 = vec![0u8]; // level L
        s1.extend_from_slice(b"HELLO WORLD");
        let path1 = format!("{}/encode_string.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_string {}", path1));

        let mut s2 = vec![1u8]; // level M
        s2.extend_from_slice(b"1234567890");
        let path2 = format!("{}/encode_string.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_string {}", path2));
    }

    // encode_mqr seeds
    {
        let mut s1 = vec![0u8]; // version 1, level L
        s1.extend_from_slice(b"01234");
        let path1 = format!("{}/encode_mqr.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_mqr {}", path1));

        let mut s2 = vec![1u8]; // version 2, level L
        s2.extend_from_slice(b"AB");
        let path2 = format!("{}/encode_mqr.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_mqr {}", path2));
    }

    // input_build seeds
    {
        let mut s1 = vec![1u8, 0u8]; // version 1, level L
        s1.extend_from_slice(b"TEST DATA 123");
        let path1 = format!("{}/input_build.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed input_build {}", path1));

        let mut s2 = vec![5u8, 2u8]; // version 5, level Q
        s2.extend_from_slice(b"DIFFERENT");
        let path2 = format!("{}/input_build.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed input_build {}", path2));
    }

    // structured_encode seeds - use distinctly different data
    {
        let mut s1 = vec![0u8]; // level L
        let pattern: Vec<u8> = (0..300).map(|i| (i % 256) as u8).collect();
        s1.extend_from_slice(&pattern);
        let path1 = format!("{}/structured_encode.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed structured_encode {}", path1));

        let mut s2 = vec![1u8]; // level M
        let pattern2: Vec<u8> = (0..300).map(|i| ((i * 7 + 13) % 256) as u8).collect();
        s2.extend_from_slice(&pattern2);
        let path2 = format!("{}/structured_encode.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed structured_encode {}", path2));
    }

    // spec_queries seeds
    {
        let s1: Vec<u8> = (0..16).collect();
        let path1 = format!("{}/spec_queries.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed spec_queries {}", path1));

        let s2: Vec<u8> = (16..32).collect();
        let path2 = format!("{}/spec_queries.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed spec_queries {}", path2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // encode_string: large data payload
    {
        let mut big = vec![0u8]; // level L
        for i in 0..2000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/encode_string.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_string {}", path));
    }

    // structured_encode: large data to trigger splitting
    {
        let mut big = vec![0u8]; // level L
        for i in 0..5000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/structured_encode.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf structured_encode {}", path));
    }

    // input_build: moderately large payload
    {
        let mut big = vec![1u8, 0u8]; // version 1 (auto), level L
        for i in 0..1000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/input_build.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf input_build {}", path));
    }

    lines
}
