    QRspec_getDataLength, QRspec_getECCLength, QRspec_getEccSpec, QRspec_getFormatInfo,
    QRspec_getMinimumVersion, QRspec_getRemainder, QRspec_getVersionPattern, QRspec_getWidth,
    QRspec_lengthIndicator, QRspec_maximumWords, QRspec_newFrame,
};
