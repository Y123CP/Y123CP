use libqrencode_raw::src::bitstream::{
    BitStream, BitStream_appendBytes, BitStream_appendNum, BitStream_free,
    BitStream_new, BitStream_toByte,
};
use libqrencode_raw::src::mqrspec::{
    MQRspec_getDataLength, MQRspec_getECCLength, MQRspec_getFormatInfo, MQRspec_getWidth,
    MQRspec_lengthIndicator, MQRspec_maximumWords,
};
use libqrencode_raw::src::qrencode::{
    QRcode, QRcode_APIVersion, QRcode_List_free, QRcode_List_size,
    QRcode_encodeData, QRcode_encodeDataMQR, QRcode_encodeDataStructured, QRcode_encodeInput,
    QRcode_free,
};
