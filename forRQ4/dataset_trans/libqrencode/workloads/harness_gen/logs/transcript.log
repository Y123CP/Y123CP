                    digest = fold(digest, *verstr.add(n) as u8 as u64);
                    n += 1;
                }
                digest = fold(digest, n as u64);
            }

            QRcode_clearCache();
        }
    }

    format!("op=encode_string_api err={} digest={:016x}", last_err, digest)
