extern "C" {
    fn free(ptr: *mut std::ffi::c_void);
}

unsafe fn libc_free(ptr: *mut std::ffi::c_void) {
    free(ptr);
}

fn fold(acc: u64, x: u64) -> u64 {
    acc.wrapping_mul(6364136223846793005).wrapping_add(x)
}

fn input_checksum(data: &[u8]) -> u64 {
    let mut h: u64 = data.len() as u64;
    for (i, &b) in data.iter().enumerate() {
        h = h.wrapping_mul(31).wrapping_add(b as u64).wrapping_add(i as u64);
    }
    h
}

fn digest_qrcode(qr: *mut QRcode) -> u64 {
    if qr.is_null() {
        return 0;
    }
    unsafe {
        let width = (*qr).width as u64;
        let mut h = width;
        let total = ((*qr).width * (*qr).width) as usize;
        let data = (*qr).data;
        if !data.is_null() {
            for i in 0..total {
                h = fold(h, *data.add(i) as u64);
            }
        }
        h
    }
}

fn get_byte(data: &[u8], idx: usize) -> u8 {
    if idx < data.len() { data[idx] } else { 0 }
}

fn op_encode_string(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let level = (data[0] % 4) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let qr = QRcode_encodeData(
                payload.len() as i32,
                payload.as_ptr(),
                0,
                level,
            );
            if qr.is_null() {
                last_err = -1;
                digest = fold(digest, 0xFFFF);
            } else {
                last_err = 0;
                digest = fold(digest, digest_qrcode(qr));
                QRcode_free(qr);
            }
        }
    }
    format!("op=encode_string err={} digest={:016x}", last_err, digest)
}

fn op_encode_mqr(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let ctrl = data[0];
        let version = ((ctrl & 0x03) as i32) + 1;
        let level_raw = ((ctrl >> 2) & 0x03) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let qr = QRcode_encodeDataMQR(
                payload.len() as i32,
                payload.as_ptr(),
                version,
                level_raw,
            );
            if qr.is_null() {
                last_err = -1;
                digest = fold(digest, 0xFFFF);
            } else {
                last_err = 0;
                digest = fold(digest, digest_qrcode(qr));
                QRcode_free(qr);
            }
        }
    }
    format!("op=encode_mqr err={} digest={:016x}", last_err, digest)
}

fn op_input_build(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let version = (data[0] % 40) as i32 + 1;
        let level = (data[1] % 4) as u32;
        let payload = if data.len() > 2 { &data[2..] } else { &[] };

        unsafe {
            let input = QRinput_new2(version, level);
            if input.is_null() {
                last_err = -1;
                digest = fold(digest, 0);
                continue;
            }

            // Try different modes
            let mode_8: i32 = 2; // QR_MODE_8
            let mode_num: i32 = 0; // QR_MODE_NUM
            let mode_an: i32 = 1; // QR_MODE_AN
            let mode_kanji: i32 = 3; // QR_MODE_KANJI

            let mut h = 0u64;

            // Append mode 8
            let ret = if !payload.is_empty() {
                QRinput_append(input, mode_8, payload.len() as i32, payload.as_ptr())
            } else {
                -1
            };
            h = fold(h, ret as u64);

            // Check modes
            if !payload.is_empty() {
                let c8 = QRinput_check(mode_8, payload.len() as i32, payload.as_ptr());
                h = fold(h, c8 as u64);
                let cn = QRinput_check(mode_num, payload.len() as i32, payload.as_ptr());
                h = fold(h, cn as u64);
                let ca = QRinput_check(mode_an, payload.len() as i32, payload.as_ptr());
                h = fold(h, ca as u64);
                let ck = QRinput_check(mode_kanji, payload.len() as i32, payload.as_ptr());
                h = fold(h, ck as u64);
            }

            // isSplittableMode
            for m in 0..5 {
                let sp = QRinput_isSplittableMode(m);
                h = fold(h, sp as u64);
            }

            let ver = QRinput_getVersion(input);
            let lvl = QRinput_getErrorCorrectionLevel(input);
            h = fold(h, ver as u64);
            h = fold(h, lvl as u64);

            // estimateBits for all modes
            let est_num = QRinput_estimateBitsModeNum(payload.len() as i32);
            let est_8 = QRinput_estimateBitsMode8(payload.len() as i32);
            let est_an = QRinput_estimateBitsModeAn(payload.len() as i32);
            let est_kanji = QRinput_estimateBitsModeKanji(payload.len() as i32);
            h = fold(h, est_num as u64);
            h = fold(h, est_8 as u64);
            h = fold(h, est_an as u64);
            h = fold(h, est_kanji as u64);

            // setVersionAndErrorCorrectionLevel
            let svl = QRinput_setVersionAndErrorCorrectionLevel(input, version, level);
            h = fold(h, svl as u64);

            // setFNC1First / setFNC1Second
            let fnc1 = QRinput_setFNC1First(input);
            h = fold(h, fnc1 as u64);
            let fnc2 = QRinput_setFNC1Second(input, 0x25);
            h = fold(h, fnc2 as u64);

            // appendECIheader
            let eci = QRinput_appendECIheader(input, 26);
            h = fold(h, eci as u64);

            let sv = QRinput_setVersion(input, version);
            h = fold(h, sv as u64);
            let sl = QRinput_setErrorCorrectionLevel(input, level);
            h = fold(h, sl as u64);

            let dup = QRinput_dup(input);
            if !dup.is_null() {
                let dv = QRinput_getVersion(dup);
                h = fold(h, dv as u64);

                if ret == 0 {
                    let bs = QRinput_getByteStream(dup);
                    if !bs.is_null() {
                        libc_free(bs as *mut _);
                    }
                }

                let qr = QRcode_encodeInput(dup as *mut _);
                if !qr.is_null() {
                    h = fold(h, digest_qrcode(qr as *mut _));
                    QRcode_free(qr as *mut _);
                } else {
                    h = fold(h, 0xDEAD);
                }

                QRinput_free(dup);
            } else {
                h = fold(h, 0xBEEF);
            }

            if ret != 0 {
                last_err = ret;
            } else {
                last_err = 0;
            }

            QRinput_free(input);
            digest = fold(digest, h);
        }
    }
    format!("op=input_build err={} digest={:016x}", last_err, digest)
}

fn op_structured_encode(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0xDEAD);
            continue;
        }
        let level = (data[0] % 4) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let list = QRcode_encodeDataStructured(
                payload.len() as i32,
                payload.as_ptr(),
                0,
                level,
            );
            if list.is_null() {
                last_err = -1;
                let mut h = payload.len() as u64;
                for (i, &b) in payload.iter().enumerate().take(64) {
                    h = fold(h, (b as u64).wrapping_add(i as u64));
                }
                digest = fold(digest, h);
            } else {
                last_err = 0;
                let size = QRcode_List_size(list);
                let mut h = size as u64;

                let mut cur = list;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    h = fold(h, digest_qrcode(qr as *mut _));
                    cur = (*cur).next;
                }

                QRcode_List_free(list);
                digest = fold(digest, h);
            }
        }
    }
    format!("op=structured_encode err={} digest={:016x}", last_err, digest)
}

fn op_spec_queries(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);

    for _ in 0..iters {
        let version = (get_byte(data, 0) % 40) as i32 + 1;
        let level = (get_byte(data, 1) % 4) as u32;
        let mask = (get_byte(data, 2) % 8) as i32;
        let mqr_version = (get_byte(data, 3) % 4) as i32 + 1;
        let mode = (get_byte(data, 4) % 4) as i32;

        let mut h = 0u64;

        unsafe {
            h = fold(h, QRspec_getDataLength(version, level) as u64);
            h = fold(h, QRspec_getECCLength(version, level) as u64);
            h = fold(h, QRspec_getWidth(version) as u64);
            h = fold(h, QRspec_getRemainder(version) as u64);
            h = fold(h, QRspec_getMinimumVersion(10, level) as u64);
            h = fold(h, QRspec_lengthIndicator(mode, version) as u64);
            h = fold(h, QRspec_maximumWords(mode, version) as u64);
            h = fold(h, QRspec_getVersionPattern(version) as u64);
            h = fold(h, QRspec_getFormatInfo(mask, level) as u64);

            // EccSpec
            let mut spec: [i32; 5] = [0; 5];
            QRspec_getEccSpec(version, level, spec.as_mut_ptr());
            for s in &spec {
                h = fold(h, *s as u64);
            }

            // QRspec_newFrame
            let frame = QRspec_newFrame(version);
            if !frame.is_null() {
                let w = QRspec_getWidth(version) as usize;
                for i in 0..std::cmp::min(w * w, 100) {
                    h = fold(h, *frame.add(i) as u64);
                }
                libc_free(frame as *mut _);
            }

            h = fold(h, MQRspec_getDataLength(mqr_version, level) as u64);
            h = fold(h, MQRspec_getECCLength(mqr_version, level) as u64);
            h = fold(h, MQRspec_getWidth(mqr_version) as u64);
            h = fold(h, MQRspec_lengthIndicator(mode, mqr_version) as u64);
            h = fold(h, MQRspec_maximumWords(mode, mqr_version) as u64);
            h = fold(h, MQRspec_getFormatInfo(mask % 4, mqr_version, level) as u64);
            h = fold(h, MQRspec_getDataLengthBit(mqr_version, level) as u64);

            // MQRspec_newFrame
            let mframe = MQRspec_newFrame(mqr_version);
            if !mframe.is_null() {
                let mw = MQRspec_getWidth(mqr_version) as usize;
                for i in 0..std::cmp::min(mw * mw, 100) {
                    h = fold(h, *mframe.add(i) as u64);
                }
                libc_free(mframe as *mut _);
            }

            // RSECC
            let rsecc_data: [u8; 4] = [get_byte(data, 5), get_byte(data, 6), get_byte(data, 7), get_byte(data, 8)];
            let mut ecc_out: [u8; 4] = [0; 4];
            let rret = RSECC_encode(4, 4, rsecc_data.as_ptr(), ecc_out.as_mut_ptr());
            h = fold(h, rret as u64);
            for b in &ecc_out {
                h = fold(h, *b as u64);
            }

            // BitStream
            let bs = BitStream_new();
            if !bs.is_null() {
                let num_val = ((get_byte(data, 9) as u32) << 8) | (get_byte(data, 10) as u32);
                BitStream_appendNum(bs, 16, num_val);
                let bs_data: [u8; 3] = [get_byte(data, 11), get_byte(data, 12), get_byte(data, 13)];
                BitStream_appendBytes(bs, 3, bs_data.as_ptr() as *mut u8);
                let out = BitStream_toByte(bs);
                if !out.is_null() {
                    for i in 0..5usize {
                        h = fold(h, *out.add(i) as u64);
                    }
                    libc_free(out as *mut _);
                }
                BitStream_free(bs);
            }

            // API version
            let mut major: i32 = 0;
            let mut minor: i32 = 0;
            let mut micro: i32 = 0;
            QRcode_APIVersion(&mut major, &mut minor, &mut micro);
            h = fold(h, major as u64);
            h = fold(h, minor as u64);
            h = fold(h, micro as u64);

            let vs = QRcode_APIVersionString();
            if !vs.is_null() {
                let mut i = 0usize;
                loop {
                    let c = *vs.add(i);
                    if c == 0 { break; }
                    h = fold(h, c as u64);
                    i += 1;
                    if i > 32 { break; }
                }
            }

            QRcode_clearCache();
        }

        digest = fold(digest, h);
    }
    format!("op=spec_queries err=0 digest={:016x}", digest)
}

fn op_encode_string_api(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let ctrl = data[0];
        let level = (ctrl & 0x03) as u32;
        let hint = if (ctrl >> 2) & 1 == 0 { 2i32 } else { 0i32 }; // QR_MODE_8 or QR_MODE_NUM
        let casesensitive = ((ctrl >> 3) & 1) as i32;
        let payload = &data[1..];

        // Need null-terminated string
        let mut cstr = payload.to_vec();
        // Remove any internal nulls
        cstr.retain(|&b| b != 0);
        if cstr.is_empty() {
            cstr.push(b'A');
        }
        cstr.push(0);

        let mut h = 0u64;

        unsafe {
            // QRcode_encodeString
            let qr = QRcode_encodeString(
                cstr.as_ptr() as *const i8,
                0,
                level,
                hint,
                casesensitive,
            );
            if qr.is_null() {
                h = fold(h, 0xAAAA);
                last_err = -1;
            } else {
                h = fold(h, digest_qrcode(qr));
                last_err = 0;
                QRcode_free(qr);
            }

            // QRcode_encodeString8bit
            let qr8 = QRcode_encodeString8bit(
                cstr.as_ptr() as *const i8,
                0,
                level,
            );
            if qr8.is_null() {
                h = fold(h, 0xBBBB);
            } else {
                h = fold(h, digest_qrcode(qr8));
                QRcode_free(qr8);
            }

            // QRcode_encodeStringMQR
            let mqr_version = ((ctrl >> 4) & 0x03) as i32 + 1;
            let qrm = QRcode_encodeStringMQR(
                cstr.as_ptr() as *const i8,
                mqr_version,
                level,
                hint,
                casesensitive,
            );
            if qrm.is_null() {
                h = fold(h, 0xCCCC);
            } else {
                h = fold(h, digest_qrcode(qrm));
                QRcode_free(qrm);
            }

            // QRcode_encodeString8bitMQR
            let qr8m = QRcode_encodeString8bitMQR(
                cstr.as_ptr() as *const i8,
                mqr_version,
                level,
            );
            if qr8m.is_null() {
                h = fold(h, 0xDDDD);
            } else {
                h = fold(h, digest_qrcode(qr8m));
                QRcode_free(qr8m);
            }
        }

        digest = fold(digest, h);
    }
    format!("op=encode_string_api err={} digest={:016x}", last_err, digest)
}

fn op_encode_string_structured(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let ctrl = data[0];
        let level = (ctrl & 0x03) as u32;
        let hint = 2i32; // QR_MODE_8
        let casesensitive = ((ctrl >> 2) & 1) as i32;
        let payload = &data[1..];

        let mut cstr = payload.to_vec();
        cstr.retain(|&b| b != 0);
        if cstr.is_empty() {
            cstr.push(b'X');
        }
        cstr.push(0);

        let mut h = 0u64;

        unsafe {
            // QRcode_encodeStringStructured
            let list = QRcode_encodeStringStructured(
                cstr.as_ptr() as *const i8,
                0,
                level,
                hint,
                casesensitive,
            );
            if list.is_null() {
                h = fold(h, 0x1111);
                last_err = -1;
            } else {
                last_err = 0;
                let size = QRcode_List_size(list);
                h = fold(h, size as u64);
                let mut cur = list;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    h = fold(h, digest_qrcode(qr as *mut _));
                    cur = (*cur).next;
                }
                QRcode_List_free(list);
            }

            // QRcode_encodeString8bitStructured
            let list8 = QRcode_encodeString8bitStructured(
                cstr.as_ptr() as *const i8,
                0,
                level,
            );
            if list8.is_null() {
                h = fold(h, 0x2222);
            } else {
                let size8 = QRcode_List_size(list8);
                h = fold(h, size8 as u64);
                let mut cur = list8;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    h = fold(h, digest_qrcode(qr as *mut _));
                    cur = (*cur).next;
                }
                QRcode_List_free(list8);
            }
        }

        digest = fold(digest, h);
    }
    format!("op=encode_string_structured err={} digest={:016x}", last_err, digest)
}

fn op_input_struct(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 3 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let version = (data[0] % 40) as i32 + 1;
        let level = (data[1] % 4) as u32;
        let parity = data[2];
        let payload = if data.len() > 3 { &data[3..] } else { &[] };

        let mut h = 0u64;

        unsafe {
            // QRinput_new (no version)
            let inp_plain = QRinput_new();
            if !inp_plain.is_null() {
                let v0 = QRinput_getVersion(inp_plain);
                h = fold(h, v0 as u64);
                QRinput_free(inp_plain);
            }

            // Create QRinput_Struct
            let s = QRinput_Struct_new();
            if s.is_null() {
                last_err = -1;
                digest = fold(digest, 0xBEEF);
                continue;
            }

            QRinput_Struct_setParity(s, parity);

            // Create two inputs and append to struct
            let inp1 = QRinput_new2(version, level);
            let inp2 = QRinput_new2(version, level);

            if !inp1.is_null() && !payload.is_empty() {
                let half = payload.len() / 2;
                let half = if half == 0 { payload.len() } else { half };
                QRinput_append(inp1, 2, half as i32, payload.as_ptr());
                let r1 = QRinput_Struct_appendInput(s, inp1);
                h = fold(h, r1 as u64);
            }

            if !inp2.is_null() && payload.len() > 1 {
                let half = payload.len() / 2;
                if half > 0 {
                    QRinput_append(inp2, 2, (payload.len() - half) as i32, payload[half..].as_ptr());
                    let r2 = QRinput_Struct_appendInput(s, inp2);
                    h = fold(h, r2 as u64);
                }
            }

            // Insert structured append headers
            let ih = QRinput_Struct_insertStructuredAppendHeaders(s);
            h = fold(h, ih as u64);

            // Encode input structured
            let list = QRcode_encodeInputStructured(s as *mut _);
            if list.is_null() {
                h = fold(h, 0xFADE);
            } else {
                let size = QRcode_List_size(list);
                h = fold(h, size as u64);
                let mut cur = list;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    h = fold(h, digest_qrcode(qr as *mut _));
                    cur = (*cur).next;
                }
                QRcode_List_free(list);
            }

            // Free struct (which frees the inputs it owns)
            QRinput_Struct_free(s);

            // Free inputs that weren't appended
            if inp1.is_null() {
                // nothing
            }
            if inp2.is_null() {
                // nothing
            }
            // Note: inputs that were successfully appended are owned by the struct
            // Only free if they weren't appended
            if inp1.is_null() || payload.is_empty() {
                if !inp1.is_null() { QRinput_free(inp1); }
            }
            if inp2.is_null() || payload.len() <= 1 {
                if !inp2.is_null() { QRinput_free(inp2); }
            }

            last_err = 0;
        }

        digest = fold(digest, h);
    }
    format!("op=input_struct err={} digest={:016x}", last_err, digest)
}

fn op_split_input(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let version = (data[0] % 40) as i32 + 1;
        let level = (data[1] % 4) as u32;
        let payload = if data.len() > 2 { &data[2..] } else { &[] };

        let mut cstr = payload.to_vec();
        cstr.retain(|&b| b != 0);
        if cstr.is_empty() {
            cstr.push(b'0');
        }
        cstr.push(0);

        let mut h = 0u64;

        unsafe {
            // Split_splitStringToQRinput
            let input = QRinput_new2(version, level);
            if input.is_null() {
                last_err = -1;
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let hint = 2i32; // QR_MODE_8
            let ret = Split_splitStringToQRinput(
                cstr.as_ptr() as *const i8,
                input as *mut _,
                hint,
                1,
            );
            h = fold(h, ret as u64);

            if ret == 0 {
                // Try to encode
                let qr = QRcode_encodeInput(input);
                if !qr.is_null() {
                    h = fold(h, digest_qrcode(qr));
                    QRcode_free(qr);
                } else {
                    h = fold(h, 0xAAAA);
                }
            }

            // splitQRinputToStruct
            let input2 = QRinput_new2(version, level);
            if !input2.is_null() {
                if !payload.is_empty() {
                    QRinput_append(input2, 2, payload.len() as i32, payload.as_ptr());
                }
                let st = QRinput_splitQRinputToStruct(input2);
                if !st.is_null() {
                    h = fold(h, 0x5555);
                    QRinput_Struct_free(st);
                } else {
                    h = fold(h, 0x6666);
                }
                QRinput_free(input2);
            }

            QRinput_free(input);
            last_err = ret;
        }

        digest = fold(digest, h);
    }
    format!("op=split_input err={} digest={:016x}", last_err, digest)
}

fn op_mask_ops(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        let version = (get_byte(data, 0) % 40) as i32 + 1;
        let level = (get_byte(data, 1) % 4) as u32;
        let mask_num = (get_byte(data, 2) % 8) as i32;
        let mqr_version = (get_byte(data, 3) % 4) as i32 + 1;

        let mut h = 0u64;

        unsafe {
            // QR mask
            let frame = QRspec_newFrame(version);
            if !frame.is_null() {
                let width = QRspec_getWidth(version);

                // Mask_makeMask
                let masked = Mask_makeMask(width, frame, mask_num, level);
                if !masked.is_null() {
                    let total = (width * width) as usize;
                    for i in (0..std::cmp::min(total, 200)).step_by(7) {
                        h = fold(h, *masked.add(i) as u64);
                    }
                    libc_free(masked as *mut _);
                } else {
                    h = fold(h, 0xAAAA);
                }

                // Mask_mask (auto-select)
                let frame2 = QRspec_newFrame(version);
                if !frame2.is_null() {
                    let auto_masked = Mask_mask(width, frame2, level);
                    if !auto_masked.is_null() {
                        let total = (width * width) as usize;
                        for i in (0..std::cmp::min(total, 200)).step_by(11) {
                            h = fold(h, *auto_masked.add(i) as u64);
                        }
                        libc_free(auto_masked as *mut _);
                    }
                    libc_free(frame2 as *mut _);
                }

                libc_free(frame as *mut _);
                last_err = 0;
            } else {
                last_err = -1;
                h = fold(h, 0xBBBB);
            }

            // MQR mask
            let mframe = MQRspec_newFrame(mqr_version);
            if !mframe.is_null() {
                let mwidth = MQRspec_getWidth(mqr_version);

                // MMask_makeMask
                let mmasked = MMask_makeMask(mqr_version, mframe, mask_num % 4, level);
                if !mmasked.is_null() {
                    let total = (mwidth * mwidth) as usize;
                    for i in (0..std::cmp::min(total, 200)).step_by(5) {
                        h = fold(h, *mmasked.add(i) as u64);
                    }
                    libc_free(mmasked as *mut _);
                } else {
                    h = fold(h, 0xCCCC);
                }

                // MMask_mask (auto-select)
                let mframe2 = MQRspec_newFrame(mqr_version);
                if !mframe2.is_null() {
                    let auto_mmasked = MMask_mask(mqr_version, mframe2, level);
                    if !auto_mmasked.is_null() {
                        let total = (mwidth * mwidth) as usize;
                        for i in (0..std::cmp::min(total, 200)).step_by(7) {
                            h = fold(h, *auto_mmasked.add(i) as u64);
                        }
                        libc_free(auto_mmasked as *mut _);
                    }
                    libc_free(mframe2 as *mut _);
                }

                libc_free(mframe as *mut _);
            } else {
                h = fold(h, 0xDDDD);
            }
        }

        digest = fold(digest, h);
    }
    format!("op=mask_ops err={} digest={:016x}", last_err, digest)
}

fn op_bitstream_ops(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        let mut h = 0u64;

        unsafe {
            let bs1 = BitStream_new();
            let bs2 = BitStream_new();

            if bs1.is_null() || bs2.is_null() {
                last_err = -1;
                if !bs1.is_null() { BitStream_free(bs1); }
                if !bs2.is_null() { BitStream_free(bs2); }
                digest = fold(digest, 0);
                continue;
            }

            // Append data to bs1
            let chunk_size = std::cmp::min(data.len(), 64);
            if chunk_size > 0 {
                BitStream_appendBytes(bs1, chunk_size, data.as_ptr() as *mut u8);
            }

            // Append some numbers
            let val = if data.len() >= 2 {
                ((data[0] as u32) << 8) | (data[1] as u32)
            } else if data.len() == 1 {
                data[0] as u32
            } else {
                0u32
            };
            BitStream_appendNum(bs1, 16, val);

            // Append data to bs2
            if data.len() > 2 {
                let chunk2 = std::cmp::min(data.len() - 2, 32);
                BitStream_appendBytes(bs2, chunk2, data[2..].as_ptr() as *mut u8);
            }
            BitStream_appendNum(bs2, 8, get_byte(data, 0) as u32);

            // BitStream_append (bs1 += bs2)
            let ar = BitStream_append(bs1, bs2);
            h = fold(h, ar as u64);

            // Convert to bytes
            let out = BitStream_toByte(bs1);
            if !out.is_null() {
                // Read some output bytes
                let expected_bits = chunk_size * 8 + 16 + (if data.len() > 2 { std::cmp::min(data.len() - 2, 32) * 8 } else { 0 }) + 8;
                let expected_bytes = (expected_bits + 7) / 8;
                for i in 0..std::cmp::min(expected_bytes, 128) {
                    h = fold(h, *out.add(i) as u64);
                }
                libc_free(out as *mut _);
                last_err = 0;
            } else {
                last_err = -1;
                h = fold(h, 0xEEEE);
            }

            BitStream_free(bs1);
            BitStream_free(bs2);
        }

        digest = fold(digest, h);
    }
    format!("op=bitstream_ops err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("encode_string", op_encode_string as fn(&[u8], u64) -> String),
        ("encode_mqr", op_encode_mqr as fn(&[u8], u64) -> String),
        ("input_build", op_input_build as fn(&[u8], u64) -> String),
        ("structured_encode", op_structured_encode as fn(&[u8], u64) -> String),
        ("spec_queries", op_spec_queries as fn(&[u8], u64) -> String),
        ("encode_string_api", op_encode_string_api as fn(&[u8], u64) -> String),
        ("encode_string_structured", op_encode_string_structured as fn(&[u8], u64) -> String),
        ("input_struct", op_input_struct as fn(&[u8], u64) -> String),
        ("split_input", op_split_input as fn(&[u8], u64) -> String),
        ("mask_ops", op_mask_ops as fn(&[u8], u64) -> String),
        ("bitstream_ops", op_bitstream_ops as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // encode_string seeds
    {
        let mut s1 = vec![0u8]; // level L
        s1.extend_from_slice(b"HELLO WORLD");
        let path1 = format!("{}/encode_string.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_string {}", path1));

        let mut s2 = vec![1u8]; // level M
        s2.extend_from_slice(b"1234567890");
        let path2 = format!("{}/encode_string.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_string {}", path2));
    }

    // encode_mqr seeds
    {
        let mut s1 = vec![0u8]; // version 1, level L
        s1.extend_from_slice(b"01234");
        let path1 = format!("{}/encode_mqr.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_mqr {}", path1));

        let mut s2 = vec![1u8]; // version 2, level L
        s2.extend_from_slice(b"AB");
        let path2 = format!("{}/encode_mqr.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_mqr {}", path2));
    }

    // input_build seeds
    {
        let mut s1 = vec![1u8, 0u8]; // version 1, level L
        s1.extend_from_slice(b"TEST DATA 123");
        let path1 = format!("{}/input_build.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed input_build {}", path1));

        let mut s2 = vec![5u8, 2u8]; // version 5, level Q
        s2.extend_from_slice(b"DIFFERENT");
        let path2 = format!("{}/input_build.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed input_build {}", path2));
    }

    // structured_encode seeds
    {
        let mut s1 = vec![0u8]; // level L
        let pattern: Vec<u8> = (0..300).map(|i| (i % 256) as u8).collect();
        s1.extend_from_slice(&pattern);
        let path1 = format!("{}/structured_encode.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed structured_encode {}", path1));

        let mut s2 = vec![1u8]; // level M
        let pattern2: Vec<u8> = (0..300).map(|i| ((i * 7 + 13) % 256) as u8).collect();
        s2.extend_from_slice(&pattern2);
        let path2 = format!("{}/structured_encode.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed structured_encode {}", path2));
    }

    // spec_queries seeds
    {
        let s1: Vec<u8> = (0..16).collect();
        let path1 = format!("{}/spec_queries.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed spec_queries {}", path1));

        let s2: Vec<u8> = (16..32).collect();
        let path2 = format!("{}/spec_queries.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed spec_queries {}", path2));
    }

    // encode_string_api seeds
    {
        // Seed with numeric data to trigger QR_MODE_NUM path
        let mut s1 = vec![0b00000100u8]; // level L, hint=NUM, casesensitive=0
        s1.extend_from_slice(b"0123456789");
        let path1 = format!("{}/encode_string_api.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_string_api {}", path1));

        // Seed with alphanumeric data
        let mut s2 = vec![0b00110001u8]; // level M, hint=8, casesensitive=1, mqr_version offset
        s2.extend_from_slice(b"HELLO WORLD 123 TEST");
        let path2 = format!("{}/encode_string_api.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_string_api {}", path2));
    }

    // encode_string_structured seeds
    {
        let mut s1 = vec![0u8]; // level L
        // Large enough to potentially split
        let mut payload = Vec::new();
        for i in 0..200u32 {
            payload.push(b'A' + (i % 26) as u8);
        }
        s1.extend_from_slice(&payload);
        let path1 = format!("{}/encode_string_structured.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_string_structured {}", path1));

        let mut s2 = vec![1u8]; // level M
        s2.extend_from_slice(b"STRUCTURED TEST DATA FOR QR CODE ENCODING");
        let path2 = format!("{}/encode_string_structured.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_string_structured {}", path2));
    }

    // input_struct seeds
    {
        let mut s1 = vec![1u8, 0u8, 0xAAu8]; // version 1, level L, parity 0xAA
        s1.extend_from_slice(b"HELLO WORLD STRUCT TEST");
        let path1 = format!("{}/input_struct.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed input_struct {}", path1));

        let mut s2 = vec![5u8, 1u8, 0x55u8]; // version 5, level M, parity 0x55
        s2.extend_from_slice(b"DIFFERENT STRUCT DATA");
        let path2 = format!("{}/input_struct.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed input_struct {}", path2));
    }

    // split_input seeds
    {
        // Mixed numeric + alpha + 8bit to exercise split paths
        let mut s1 = vec![5u8, 0u8]; // version 5, level L
        s1.extend_from_slice(b"0123456789ABCDEF hello world");
        let path1 = format!("{}/split_input.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed split_input {}", path1));

        let mut s2 = vec![10u8, 1u8]; // version 10, level M
        s2.extend_from_slice(b"HTTP://EXAMPLE.COM/PATH?Q=123&A=B");
        let path2 = format!("{}/split_input.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed split_input {}", path2));
    }

    // mask_ops seeds
    {
        let s1: Vec<u8> = vec![1, 0, 3, 1]; // version 2, level L, mask 3, mqr_version 2
        let path1 = format!("{}/mask_ops.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed mask_ops {}", path1));

        let s2: Vec<u8> = vec![5, 2, 7, 3]; // version 6, level Q, mask 7, mqr_version 4
        let path2 = format!("{}/mask_ops.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed mask_ops {}", path2));
    }

    // bitstream_ops seeds
    {
        let s1: Vec<u8> = (0..32).collect();
        let path1 = format!("{}/bitstream_ops.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed bitstream_ops {}", path1));

        let s2: Vec<u8> = (32..96).collect();
        let path2 = format!("{}/bitstream_ops.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed bitstream_ops {}", path2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // encode_string: large data payload
    {
        let mut big = vec![0u8]; // level L
        for i in 0..2000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/encode_string.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_string {}", path));
    }

    // structured_encode: large data to trigger splitting
    {
        let mut big = vec![0u8]; // level L
        for i in 0..5000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/structured_encode.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf structured_encode {}", path));
    }

    // input_build: moderately large payload
    {
        let mut big = vec![1u8, 0u8]; // version 1 (auto), level L
        for i in 0..1000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/input_build.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf input_build {}", path));
    }

    // encode_string_api: medium string
    {
        let mut big = vec![0u8];
        for i in 0..500u32 {
            big.push(b'A' + (i % 26) as u8);
        }
        let path = format!("{}/encode_string_api.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_string_api {}", path));
    }

    // split_input: large mixed string
    {
        let mut big = vec![10u8, 0u8]; // version 10, level L
        for i in 0..500u32 {
            if i % 3 == 0 {
                big.push(b'0' + (i % 10) as u8);
            } else if i % 3 == 1 {
                big.push(b'A' + (i % 26) as u8);
            } else {
                big.push(b'a' + (i % 26) as u8);
            }
        }
        let path = format!("{}/split_input.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf split_input {}", path));
    }

    // mask_ops: larger version
    {
        let s = vec![10u8, 0, 5, 3];
        let path = format!("{}/mask_ops.perf.bin", dir);
        fs::write(&path, &s).unwrap();
        lines.push(format!("perf mask_ops {}", path));
    }

    lines
}
