fn fold(acc: u64, x: u64) -> u64 {
    acc.wrapping_mul(6364136223846793005).wrapping_add(x)
}

fn input_checksum(data: &[u8]) -> u64 {
    let mut h: u64 = data.len() as u64;
    for (i, &b) in data.iter().enumerate() {
        h = h.wrapping_mul(31).wrapping_add(b as u64).wrapping_add(i as u64);
    }
    h
}

fn digest_qrcode(qr: *mut QRcode) -> u64 {
    if qr.is_null() {
        return 0;
    }
    unsafe {
        let width = (*qr).width as u64;
        let mut h = width;
        let total = ((*qr).width * (*qr).width) as usize;
        let data = (*qr).data;
        if !data.is_null() {
            for i in 0..total {
                h = fold(h, *data.add(i) as u64);
            }
        }
        h
    }
}

fn get_byte(data: &[u8], idx: usize) -> u8 {
    if idx < data.len() { data[idx] } else { 0 }
}

fn op_encode_string(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let level = (data[0] % 4) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let qr = QRcode_encodeData(
                payload.len() as i32,
                payload.as_ptr(),
                0,
                level,
            );
            if qr.is_null() {
                last_err = -1;
                digest = fold(digest, 0xFFFF);
            } else {
                last_err = 0;
                digest = fold(digest, digest_qrcode(qr));
                QRcode_free(qr);
            }
        }
    }
    format!("op=encode_string err={} digest={:016x}", last_err, digest)
}

fn op_encode_mqr(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let ctrl = data[0];
        let version = ((ctrl & 0x03) as i32) + 1;
        let level_raw = ((ctrl >> 2) & 0x03) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let qr = QRcode_encodeDataMQR(
                payload.len() as i32,
                payload.as_ptr(),
                version,
                level_raw,
            );
            if qr.is_null() {
                last_err = -1;
                digest = fold(digest, 0xFFFF);
            } else {
                last_err = 0;
                digest = fold(digest, digest_qrcode(qr));
                QRcode_free(qr);
            }
        }
    }
    format!("op=encode_mqr err={} digest={:016x}", last_err, digest)
}

fn op_input_build(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let version = (data[0] % 40) as i32 + 1;
        let level = (data[1] % 4) as u32;
        let payload = if data.len() > 2 { &data[2..] } else { &[] };

        unsafe {
            let input = QRinput_new2(version, level);
            if input.is_null() {
                last_err = -1;
                digest = fold(digest, 0);
                continue;
            }

            let mode_8: i32 = 2;
            let mode_num: i32 = 0;
            let mode_an: i32 = 1;
            let mode_kanji: i32 = 3;

            let mut h = 0u64;

            let ret = if !payload.is_empty() {
                QRinput_append(input, mode_8, payload.len() as i32, payload.as_ptr())
            } else {
                -1
            };
            h = fold(h, ret as u64);

            if !payload.is_empty() {
                let c8 = QRinput_check(mode_8, payload.len() as i32, payload.as_ptr());
                h = fold(h, c8 as u64);
                let cn = QRinput_check(mode_num, payload.len() as i32, payload.as_ptr());
                h = fold(h, cn as u64);
                let ca = QRinput_check(mode_an, payload.len() as i32, payload.as_ptr());
                h = fold(h, ca as u64);
                let ck = QRinput_check(mode_kanji, payload.len() as i32, payload.as_ptr());
                h = fold(h, ck as u64);
            }

            for m in 0..5 {
                let sp = QRinput_isSplittableMode(m);
                h = fold(h, sp as u64);
            }

            let ver = QRinput_getVersion(input);
            let lvl = QRinput_getErrorCorrectionLevel(input);
            h = fold(h, ver as u64);
            h = fold(h, lvl as u64);

            let est_num = QRinput_estimateBitsModeNum(payload.len() as i32);
            let est_8 = QRinput_estimateBitsMode8(payload.len() as i32);
            let est_an = QRinput_estimateBitsModeAn(payload.len() as i32);
            let est_kanji = QRinput_estimateBitsModeKanji(payload.len() as i32);
            h = fold(h, est_num as u64);
            h = fold(h, est_8 as u64);
            h = fold(h, est_an as u64);
            h = fold(h, est_kanji as u64);

            let svl = QRinput_setVersionAndErrorCorrectionLevel(input, version, level);
            h = fold(h, svl as u64);

            let fnc1 = QRinput_setFNC1First(input);
            h = fold(h, fnc1 as u64);
            let fnc2 = QRinput_setFNC1Second(input, 0x25);
            h = fold(h, fnc2 as u64);

            let eci = QRinput_appendECIheader(input, 26);
            h = fold(h, eci as u64);

            let sv = QRinput_setVersion(input, version);
            h = fold(h, sv as u64);
            let sl = QRinput_setErrorCorrectionLevel(input, level);
            h = fold(h, sl as u64);

            let dup = QRinput_dup(input);
            if !dup.is_null() {
                let dv = QRinput_getVersion(dup);
                h = fold(h, dv as u64);

                if ret == 0 {
                    let bs = QRinput_getByteStream(dup);
                    if !bs.is_null() {
                        libc_free(bs as *mut _);
                    }
                }

                // Cast dup (qrinput::_QRinput) to qrencode::_QRinput for QRcode_encodeInput
                let qr = QRcode_encodeInput(dup as *mut _);
                if !qr.is_null() {
                    h = fold(h, digest_qrcode(qr));
                    QRcode_free(qr);
                } else {
                    h = fold(h, 0xDEAD);
                }

                // dup is consumed by encodeInput, don't free it
                // Actually, QRcode_encodeInput may or may not free the input.
                // To be safe, let's not double-free. The C API docs say it doesn't free input.
                QRinput_free(dup);
            } else {
                h = fold(h, 0xBEEF);
            }

            if ret != 0 {
                last_err = ret;
            } else {
                last_err = 0;
            }

            QRinput_free(input);
            digest = fold(digest, h);
        }
    }
    format!("op=input_build err={} digest={:016x}", last_err, digest)
}

fn op_structured_encode(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.is_empty() {
            last_err = -1;
            digest = fold(digest, 0xDEAD);
            continue;
        }
        let level = (data[0] % 4) as u32;
        let payload = if data.len() > 1 { &data[1..] } else { &[] };

        unsafe {
            let list = QRcode_encodeDataStructured(
                payload.len() as i32,
                payload.as_ptr(),
                0,
                level,
            );
            if list.is_null() {
                last_err = -1;
                let mut h = payload.len() as u64;
                for (i, &b) in payload.iter().enumerate().take(64) {
                    h = fold(h, (b as u64).wrapping_add(i as u64));
                }
                digest = fold(digest, h);
            } else {
                last_err = 0;
                let size = QRcode_List_size(list);
                let mut h = size as u64;

                let mut cur = list;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    h = fold(h, digest_qrcode(qr as *mut _));
                    cur = (*cur).next;
                }

                QRcode_List_free(list);
                digest = fold(digest, h);
            }
        }
    }
    format!("op=structured_encode err={} digest={:016x}", last_err, digest)
}

fn op_spec_queries(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);

    for _ in 0..iters {
        let version = (get_byte(data, 0) % 40) as i32 + 1;
        let level = (get_byte(data, 1) % 4) as u32;
        let mask = (get_byte(data, 2) % 8) as i32;
        let mqr_version = (get_byte(data, 3) % 4) as i32 + 1;
        let mode = (get_byte(data, 4) % 4) as i32;

        let mut h = 0u64;

        unsafe {
            h = fold(h, QRspec_getDataLength(version, level) as u64);
            h = fold(h, QRspec_getECCLength(version, level) as u64);
            h = fold(h, QRspec_getWidth(version) as u64);
            h = fold(h, QRspec_getRemainder(version) as u64);
            h = fold(h, QRspec_getMinimumVersion(10, level) as u64);
            h = fold(h, QRspec_lengthIndicator(mode, version) as u64);
            h = fold(h, QRspec_maximumWords(mode, version) as u64);
            h = fold(h, QRspec_getVersionPattern(version) as u64);
            h = fold(h, QRspec_getFormatInfo(mask, level) as u64);

            let mut spec: [i32; 5] = [0; 5];
            QRspec_getEccSpec(version, level, spec.as_mut_ptr());
            for s in &spec {
                h = fold(h, *s as u64);
            }

            let frame = QRspec_newFrame(version);
            if !frame.is_null() {
                let w = QRspec_getWidth(version) as usize;
                for i in 0..std::cmp::min(w * w, 100) {
                    h = fold(h, *frame.add(i) as u64);
                }
                libc_free(frame as *mut _);
            }

            h = fold(h, MQRspec_getDataLength(mqr_version, level) as u64);
            h = fold(h, MQRspec_getECCLength(mqr_version, level) as u64);
            h = fold(h, MQRspec_getWidth(mqr_version) as u64);
            h = fold(h, MQRspec_lengthIndicator(mode, mqr_version) as u64);
            h = fold(h, MQRspec_maximumWords(mode, mqr_version) as u64);
            h = fold(h, MQRspec_getFormatInfo(mask % 4, mqr_version, level) as u64);
            h = fold(h, MQRspec_getDataLengthBit(mqr_version, level) as u64);

            let mframe = MQRspec_newFrame(mqr_version);
            if !mframe.is_null() {
                let mw = MQRspec_getWidth(mqr_version) as usize;
                for i in 0..std::cmp::min(mw * mw, 100) {
                    h = fold(h, *mframe.add(i) as u64);
                }
                libc_free(mframe as *mut _);
            }

            let rsecc_data: [u8; 4] = [get_byte(data, 5), get_byte(data, 6), get_byte(data, 7), get_byte(data, 8)];
            let mut ecc_out: [u8; 4] = [0; 4];
            let rret = RSECC_encode(4, 4, rsecc_data.as_ptr(), ecc_out.as_mut_ptr());
            h = fold(h, rret as u64);
            for b in &ecc_out {
                h = fold(h, *b as u64);
            }

            let bs = BitStream_new();
            if !bs.is_null() {
                let num_val = ((get_byte(data, 9) as u32) << 8) | (get_byte(data, 10) as u32);
                BitStream_appendNum(bs, 16, num_val);
                let bs_data: [u8; 3] = [get_byte(data, 11), get_byte(data, 12), get_byte(data, 13)];
                BitStream_appendBytes(bs, 3, bs_data.as_ptr() as *mut u8);
                let out = BitStream_toByte(bs);
                if !out.is_null() {
                    for i in 0..5usize {
                        h = fold(h, *out.add(i) as u64);
                    }
                    libc_free(out as *mut _);
                }
                BitStream_free(bs);
            }

            let mut major: i32 = 0;
            let mut minor: i32 = 0;
            let mut micro: i32 = 0;
            QRcode_APIVersion(&mut major, &mut minor, &mut micro);
            h = fold(h, major as u64);
            h = fold(h, minor as u64);
            h = fold(h, micro as u64);

            let vs = QRcode_APIVersionString();
            if !vs.is_null() {
                let mut i = 0usize;
                loop {
                    let c = *vs.add(i);
                    if c == 0 { break; }
                    h = fold(h, c as u64);
                    i += 1;
                    if i > 32 { break; }
                }
            }

            QRcode_clearCache();
        }

        digest = fold(digest, h);
    }
    format!("op=spec_queries err=0 digest={:016x}", digest)
}

fn op_encode_string_api(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let ctrl = data[0];
        let level = (ctrl & 0x03) as u32;
        let hint = if (ctrl >> 2) & 1 == 0 { 2i32 } else { 0i32 };
        let casesensitive = ((ctrl >> 3) & 1) as i32;
        let payload = &data[1..];

        let mut cstr = payload.to_vec();
        cstr.retain(|&b| b != 0);
        if cstr.is_empty() {
            cstr.push(b'A');
        }
        cstr.push(0);

        let mut h = 0u64;

        unsafe {
            let qr = QRcode_encodeString(
                cstr.as_ptr() as *const i8,
                0,
                level,
                hint,
                casesensitive,
            );
            if qr.is_null() {
                h = fold(h, 0xAAAA);
                last_err = -1;
            } else {
                h = fold(h, digest_qrcode(qr));
                last_err = 0;
                QRcode_free(qr);
            }

            let qr8 = QRcode_encodeString8bit(
                cstr.as_ptr() as *const i8,
                0,
                level,
            );
            if qr8.is_null() {
                h = fold(h, 0xBBBB);
            } else {
                h = fold(h, digest_qrcode(qr8));
                QRcode_free(qr8);
            }

            let mqr_version = ((ctrl >> 4) & 0x03) as i32 + 1;
            let qrm = QRcode_encodeStringMQR(
                cstr.as_ptr() as *const i8,
                mqr_version,
                level,
                hint,
                casesensitive,
            );
            if qrm.is_null() {
                h = fold(h, 0xCCCC);
            } else {
                h = fold(h, digest_qrcode(qrm));
                QRcode_free(qrm);
            }

            let qr8m = QRcode_encodeString8bitMQR(
                cstr.as_ptr() as *const i8,
                mqr_version,
                level,
            );
            if qr8m.is_null() {
                h = fold(h, 0xDDDD);
            } else {
                h = fold(h, digest_qrcode(qr8m));
                QRcode_free(qr8m);
            }
        }

        digest = fold(digest, h);
    }
    format!("op=encode_string_api err={} digest={:016x}", last_err, digest)
}

fn op_encode_string_structured(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let ctrl = data[0];
        let level = (ctrl & 0x03) as u32;
        let hint = 2i32;
        let casesensitive = ((ctrl >> 2) & 1) as i32;
        let payload = &data[1..];

        let mut cstr = payload.to_vec();
        cstr.retain(|&b| b != 0);
        if cstr.is_empty() {
            cstr.push(b'X');
        }
        cstr.push(0);

        let mut h = 0u64;

        unsafe {
            let list = QRcode_encodeStringStructured(
                cstr.as_ptr() as *const i8,
                0,
                level,
                hint,
                casesensitive,
            );
            if list.is_null() {
                h = fold(h, 0x1111);
                last_err = -1;
            } else {
                last_err = 0;
                let size = QRcode_List_size(list);
                h = fold(h, size as u64);
                let mut cur = list;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    h = fold(h, digest_qrcode(qr as *mut _));
                    cur = (*cur).next;
                }
                QRcode_List_free(list);
            }

            let list8 = QRcode_encodeString8bitStructured(
                cstr.as_ptr() as *const i8,
                0,
                level,
            );
            if list8.is_null() {
                h = fold(h, 0x2222);
            } else {
                let size8 = QRcode_List_size(list8);
                h = fold(h, size8 as u64);
                let mut cur = list8;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    h = fold(h, digest_qrcode(qr as *mut _));
                    cur = (*cur).next;
                }
                QRcode_List_free(list8);
            }
        }

        digest = fold(digest, h);
    }
    format!("op=encode_string_structured err={} digest={:016x}", last_err, digest)
}

fn op_input_struct(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 3 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let version = (data[0] % 40) as i32 + 1;
        let level = (data[1] % 4) as u32;
        let parity = data[2];
        let payload = if data.len() > 3 { &data[3..] } else { &[] };

        let mut h = 0u64;

        unsafe {
            let inp_plain = QRinput_new();
            if !inp_plain.is_null() {
                let v0 = QRinput_getVersion(inp_plain);
                h = fold(h, v0 as u64);
                QRinput_free(inp_plain);
            }

            let s = QRinput_Struct_new();
            if s.is_null() {
                last_err = -1;
                digest = fold(digest, 0xBEEF);
                continue;
            }

            QRinput_Struct_setParity(s, parity);

            let inp1 = QRinput_new2(version, level);
            let inp2 = QRinput_new2(version, level);

            let mut inp1_appended = false;
            let mut inp2_appended = false;

            if !inp1.is_null() && !payload.is_empty() {
                let half = payload.len() / 2;
                let half = if half == 0 { payload.len() } else { half };
                QRinput_append(inp1, 2, half as i32, payload.as_ptr());
                let r1 = QRinput_Struct_appendInput(s, inp1);
                h = fold(h, r1 as u64);
                if r1 >= 0 {
                    inp1_appended = true;
                }
            }

            if !inp2.is_null() && payload.len() > 1 {
                let half = payload.len() / 2;
                if half > 0 {
                    QRinput_append(inp2, 2, (payload.len() - half) as i32, payload[half..].as_ptr());
                    let r2 = QRinput_Struct_appendInput(s, inp2);
                    h = fold(h, r2 as u64);
                    if r2 >= 0 {
                        inp2_appended = true;
                    }
                }
            }

            let ih = QRinput_Struct_insertStructuredAppendHeaders(s);
            h = fold(h, ih as u64);

            // Cast s to the type expected by QRcode_encodeInputStructured
            let list = QRcode_encodeInputStructured(s as *mut _);
            if list.is_null() {
                h = fold(h, 0xFADE);
            } else {
                let size = QRcode_List_size(list);
                h = fold(h, size as u64);
                let mut cur = list;
                while !cur.is_null() {
                    let qr = (*cur).code;
                    h = fold(h, digest_qrcode(qr as *mut _));
                    cur = (*cur).next;
                }
                QRcode_List_free(list);
            }

            QRinput_Struct_free(s);

            // Free inputs that weren't appended (struct owns appended ones)
            if !inp1.is_null() && !inp1_appended {
                QRinput_free(inp1);
            }
            if !inp2.is_null() && !inp2_appended {
                QRinput_free(inp2);
            }

            last_err = 0;
        }

        digest = fold(digest, h);
    }
    format!("op=input_struct err={} digest={:016x}", last_err, digest)
}

fn op_split_input(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        if data.len() < 2 {
            last_err = -1;
            digest = fold(digest, 0);
            continue;
        }
        let version = (data[0] % 40) as i32 + 1;
        let level = (data[1] % 4) as u32;
        let payload = if data.len() > 2 { &data[2..] } else { &[] };

        let mut cstr = payload.to_vec();
        cstr.retain(|&b| b != 0);
        if cstr.is_empty() {
            cstr.push(b'0');
        }
        cstr.push(0);

        let mut h = 0u64;

        unsafe {
            let input = QRinput_new2(version, level);
            if input.is_null() {
                last_err = -1;
                digest = fold(digest, 0xDEAD);
                continue;
            }

            let hint = 2i32;
            // Cast input to the type expected by Split_splitStringToQRinput
            let ret = Split_splitStringToQRinput(
                cstr.as_ptr() as *const i8,
                input as *mut _,
                hint,
                1,
            );
            h = fold(h, ret as u64);

            if ret == 0 {
                // Cast input to the type expected by QRcode_encodeInput
                let qr = QRcode_encodeInput(input as *mut _);
                if !qr.is_null() {
                    h = fold(h, digest_qrcode(qr));
                    QRcode_free(qr);
                } else {
                    h = fold(h, 0xAAAA);
                }
            }

            let input2 = QRinput_new2(version, level);
            if !input2.is_null() {
                if !payload.is_empty() {
                    QRinput_append(input2, 2, payload.len() as i32, payload.as_ptr());
                }
                let st = QRinput_splitQRinputToStruct(input2);
                if !st.is_null() {
                    h = fold(h, 0x5555);
                    QRinput_Struct_free(st);
                } else {
                    h = fold(h, 0x6666);
                }
                QRinput_free(input2);
            }

            QRinput_free(input);
            last_err = ret;
        }

        digest = fold(digest, h);
    }
    format!("op=split_input err={} digest={:016x}", last_err, digest)
}

fn op_mask_ops(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        let version = (get_byte(data, 0) % 40) as i32 + 1;
        let level = (get_byte(data, 1) % 4) as u32;
        let mask_num = (get_byte(data, 2) % 8) as i32;
        let mqr_version = (get_byte(data, 3) % 4) as i32 + 1;

        let mut h = 0u64;

        unsafe {
            let frame = QRspec_newFrame(version);
            if !frame.is_null() {
                let width = QRspec_getWidth(version);

                let masked = Mask_makeMask(width, frame, mask_num, level);
                if !masked.is_null() {
                    let total = (width * width) as usize;
                    for i in (0..std::cmp::min(total, 200)).step_by(7) {
                        h = fold(h, *masked.add(i) as u64);
                    }
                    libc_free(masked as *mut _);
                } else {
                    h = fold(h, 0xAAAA);
                }

                let frame2 = QRspec_newFrame(version);
                if !frame2.is_null() {
                    let auto_masked = Mask_mask(width, frame2, level);
                    if !auto_masked.is_null() {
                        let total = (width * width) as usize;
                        for i in (0..std::cmp::min(total, 200)).step_by(11) {
                            h = fold(h, *auto_masked.add(i) as u64);
                        }
                        libc_free(auto_masked as *mut _);
                    }
                    libc_free(frame2 as *mut _);
                }

                libc_free(frame as *mut _);
                last_err = 0;
            } else {
                last_err = -1;
                h = fold(h, 0xBBBB);
            }

            let mframe = MQRspec_newFrame(mqr_version);
            if !mframe.is_null() {
                let mwidth = MQRspec_getWidth(mqr_version);

                let mmasked = MMask_makeMask(mqr_version, mframe, mask_num % 4, level);
                if !mmasked.is_null() {
                    let total = (mwidth * mwidth) as usize;
                    for i in (0..std::cmp::min(total, 200)).step_by(5) {
                        h = fold(h, *mmasked.add(i) as u64);
                    }
                    libc_free(mmasked as *mut _);
                } else {
                    h = fold(h, 0xCCCC);
                }

                let mframe2 = MQRspec_newFrame(mqr_version);
                if !mframe2.is_null() {
                    let auto_mmasked = MMask_mask(mqr_version, mframe2, level);
                    if !auto_mmasked.is_null() {
                        let total = (mwidth * mwidth) as usize;
                        for i in (0..std::cmp::min(total, 200)).step_by(7) {
                            h = fold(h, *auto_mmasked.add(i) as u64);
                        }
                        libc_free(auto_mmasked as *mut _);
                    }
                    libc_free(mframe2 as *mut _);
                }

                libc_free(mframe as *mut _);
            } else {
                h = fold(h, 0xDDDD);
            }
        }

        digest = fold(digest, h);
    }
    format!("op=mask_ops err={} digest={:016x}", last_err, digest)
}

fn op_bitstream_ops(data: &[u8], iters: u64) -> String {
    let mut digest = input_checksum(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        let mut h = 0u64;

        unsafe {
            let bs1 = BitStream_new();
            let bs2 = BitStream_new();

            if bs1.is_null() || bs2.is_null() {
                last_err = -1;
                if !bs1.is_null() { BitStream_free(bs1); }
                if !bs2.is_null() { BitStream_free(bs2); }
                digest = fold(digest, 0);
                continue;
            }

            let chunk_size = std::cmp::min(data.len(), 64);
            if chunk_size > 0 {
                BitStream_appendBytes(bs1, chunk_size, data.as_ptr() as *mut u8);
            }

            let val = if data.len() >= 2 {
                ((data[0] as u32) << 8) | (data[1] as u32)
            } else if data.len() == 1 {
                data[0] as u32
            } else {
                0u32
            };
            BitStream_appendNum(bs1, 16, val);

            if data.len() > 2 {
                let chunk2 = std::cmp::min(data.len() - 2, 32);
                BitStream_appendBytes(bs2, chunk2, data[2..].as_ptr() as *mut u8);
            }
            BitStream_appendNum(bs2, 8, get_byte(data, 0) as u32);

            let ar = BitStream_append(bs1, bs2);
            h = fold(h, ar as u64);

            let out = BitStream_toByte(bs1);
            if !out.is_null() {
                let expected_bits = chunk_size * 8 + 16 + (if data.len() > 2 { std::cmp::min(data.len() - 2, 32) * 8 } else { 0 }) + 8;
                let expected_bytes = (expected_bits + 7) / 8;
                for i in 0..std::cmp::min(expected_bytes, 128) {
                    h = fold(h, *out.add(i) as u64);
                }
                libc_free(out as *mut _);
                last_err = 0;
            } else {
                last_err = -1;
                h = fold(h, 0xEEEE);
            }

            BitStream_free(bs1);
            BitStream_free(bs2);
        }

        digest = fold(digest, h);
    }
    format!("op=bitstream_ops err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("encode_string", op_encode_string as fn(&[u8], u64) -> String),
        ("encode_mqr", op_encode_mqr as fn(&[u8], u64) -> String),
        ("input_build", op_input_build as fn(&[u8], u64) -> String),
        ("structured_encode", op_structured_encode as fn(&[u8], u64) -> String),
        ("spec_queries", op_spec_queries as fn(&[u8], u64) -> String),
        ("encode_string_api", op_encode_string_api as fn(&[u8], u64) -> String),
        ("encode_string_structured", op_encode_string_structured as fn(&[u8], u64) -> String),
        ("input_struct", op_input_struct as fn(&[u8], u64) -> String),
        ("split_input", op_split_input as fn(&[u8], u64) -> String),
        ("mask_ops", op_mask_ops as fn(&[u8], u64) -> String),
        ("bitstream_ops", op_bitstream_ops as fn(&[u8], u64) -> String),
    ]
}

