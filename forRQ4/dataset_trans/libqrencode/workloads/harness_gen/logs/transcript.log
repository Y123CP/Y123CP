fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9e37_79b9_7f4a_7c15)
}

fn checksum_bytes(bytes: &[u8]) -> u64 {
    let mut d = 0u64;
    for &b in bytes {
        d = fold(d, b as u64);
    }
    d ^ (bytes.len() as u64).wrapping_mul(0x517c_c1b7_2722_0a95)
}

fn sanitize_c_string_bytes(data: &[u8]) -> Vec<u8> {
    let mut v = Vec::with_capacity(data.len() + 1);
    for &b in data {
        v.push(if b == 0 { b'A' } else { b });
    }
    v.push(0);
    v
}

fn choose_level_qr(x: u8) -> QRecLevel {
    match x % 4 {
        0 => 0 as QRecLevel,
        1 => 1 as QRecLevel,
        2 => 2 as QRecLevel,
        _ => 3 as QRecLevel,
    }
}

fn choose_level_mqr(x: u8) -> QRecLevel {
    match x % 2 {
        0 => 0 as QRecLevel,
        _ => 1 as QRecLevel,
    }
}

fn choose_mode_qr(x: u8) -> QRencodeMode {
    match x % 5 {
        0 => 0 as QRencodeMode,
        1 => 1 as QRencodeMode,
        2 => 2 as QRencodeMode,
        3 => 3 as QRencodeMode,
        _ => 4 as QRencodeMode,
    }
}

fn choose_mode_mqr(x: u8) -> QRencodeMode {
    match x % 4 {
        0 => 0 as QRencodeMode,
        1 => 1 as QRencodeMode,
        2 => 2 as QRencodeMode,
        _ => 3 as QRencodeMode,
    }
}

fn safe_qr_version(b: u8) -> i32 {
    1 + (b % 10) as i32
}

fn safe_mqr_version(b: u8) -> i32 {
    1 + (b % 4) as i32
}

fn safe_qr_mask(b: u8) -> i32 {
    (b % 4) as i32
}

fn safe_mqr_mask(b: u8) -> i32 {
    (b % 4) as i32
}

unsafe fn qrcode_digest(qr: *mut QRcode) -> u64 {
    if qr.is_null() {
        return 0;
    }
    let q = &*qr;
    let mut d = 0u64;
    d = fold(d, q.version as u64);
    d = fold(d, q.width as u64);
    let width = if q.width > 0 { q.width as usize } else { 0 };
    let len = width.saturating_mul(width);
    if !q.data.is_null() && len > 0 {
        let bytes = std::slice::from_raw_parts(q.data, len);
        d = fold(d, checksum_bytes(bytes));
    } else {
        d = fold(d, 0);
    }
    d
}

unsafe fn qrcode_list_digest(list: *mut QRcode_List) -> (u64, i32) {
    if list.is_null() {
        return (0, -1);
    }
    let sz = QRcode_List_size(list as *mut _);
    (fold(0, sz as u64), sz)
}

