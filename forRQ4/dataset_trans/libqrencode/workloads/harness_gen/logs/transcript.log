            let mut min = MaybeUninit::<i32>::zeroed();
            let mut mic = MaybeUninit::<i32>::zeroed();
            QRcode_APIVersion(maj.as_mut_ptr(), min.as_mut_ptr(), mic.as_mut_ptr());
            let majv = maj.assume_init();
            let minv = min.assume_init();
            let micv = mic.assume_init();
            digest = fold(digest, majv as u64);
            digest = fold(digest, minv as u64);
            digest = fold(digest, micv as u64);

