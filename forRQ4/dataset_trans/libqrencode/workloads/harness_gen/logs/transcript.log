    QRcode_encodeInput, QRcode_encodeInputStructured, QRcode_encodeString,
    QRcode_encodeString8bit, QRcode_encodeString8bitMQR, QRcode_encodeString8bitStructured,
    QRcode_encodeStringMQR, QRcode_encodeStringStructured, QRcode_free,
};
