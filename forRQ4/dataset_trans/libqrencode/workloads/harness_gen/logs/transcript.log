pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // encode_string seeds
    {
        let mut s1 = vec![0u8];
        s1.extend_from_slice(b"HELLO WORLD");
        let path1 = format!("{}/encode_string.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_string {}", path1));

        let mut s2 = vec![1u8];
        s2.extend_from_slice(b"1234567890");
        let path2 = format!("{}/encode_string.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_string {}", path2));
    }

    // encode_mqr seeds
    {
        let mut s1 = vec![0u8];
        s1.extend_from_slice(b"01234");
        let path1 = format!("{}/encode_mqr.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_mqr {}", path1));

        let mut s2 = vec![1u8];
        s2.extend_from_slice(b"AB");
        let path2 = format!("{}/encode_mqr.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_mqr {}", path2));
    }

    // input_build seeds
    {
        let mut s1 = vec![1u8, 0u8];
        s1.extend_from_slice(b"TEST DATA 123");
        let path1 = format!("{}/input_build.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed input_build {}", path1));

        let mut s2 = vec![5u8, 2u8];
        s2.extend_from_slice(b"DIFFERENT");
        let path2 = format!("{}/input_build.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed input_build {}", path2));
    }

    // structured_encode seeds
    {
        let mut s1 = vec![0u8];
        let pattern: Vec<u8> = (0..300).map(|i| (i % 256) as u8).collect();
        s1.extend_from_slice(&pattern);
        let path1 = format!("{}/structured_encode.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed structured_encode {}", path1));

        let mut s2 = vec![1u8];
        let pattern2: Vec<u8> = (0..300).map(|i| ((i * 7 + 13) % 256) as u8).collect();
        s2.extend_from_slice(&pattern2);
        let path2 = format!("{}/structured_encode.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed structured_encode {}", path2));
    }

    // spec_queries seeds
    {
        let s1: Vec<u8> = (0..16).collect();
        let path1 = format!("{}/spec_queries.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed spec_queries {}", path1));

        let s2: Vec<u8> = (16..32).collect();
        let path2 = format!("{}/spec_queries.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed spec_queries {}", path2));
    }

    // encode_string_api seeds
    {
        let mut s1 = vec![0b00000100u8];
        s1.extend_from_slice(b"0123456789");
        let path1 = format!("{}/encode_string_api.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_string_api {}", path1));

        let mut s2 = vec![0b00110001u8];
        s2.extend_from_slice(b"HELLO WORLD 123 TEST");
        let path2 = format!("{}/encode_string_api.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_string_api {}", path2));
    }

    // encode_string_structured seeds
    {
        let mut s1 = vec![0u8];
        let mut payload = Vec::new();
        for i in 0..200u32 {
            payload.push(b'A' + (i % 26) as u8);
        }
        s1.extend_from_slice(&payload);
        let path1 = format!("{}/encode_string_structured.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed encode_string_structured {}", path1));

        let mut s2 = vec![1u8];
        s2.extend_from_slice(b"STRUCTURED TEST DATA FOR QR CODE ENCODING");
        let path2 = format!("{}/encode_string_structured.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed encode_string_structured {}", path2));
    }

    // input_struct seeds
    {
        let mut s1 = vec![1u8, 0u8, 0xAAu8];
        s1.extend_from_slice(b"HELLO WORLD STRUCT TEST");
        let path1 = format!("{}/input_struct.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed input_struct {}", path1));

        let mut s2 = vec![5u8, 1u8, 0x55u8];
        s2.extend_from_slice(b"DIFFERENT STRUCT DATA");
        let path2 = format!("{}/input_struct.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed input_struct {}", path2));
    }

    // split_input seeds
    {
        let mut s1 = vec![5u8, 0u8];
        s1.extend_from_slice(b"0123456789ABCDEF hello world");
        let path1 = format!("{}/split_input.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed split_input {}", path1));

        let mut s2 = vec![10u8, 1u8];
        s2.extend_from_slice(b"HTTP://EXAMPLE.COM/PATH?Q=123&A=B");
        let path2 = format!("{}/split_input.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed split_input {}", path2));
    }

    // mask_ops seeds
    {
        let s1: Vec<u8> = vec![1, 0, 3, 1];
        let path1 = format!("{}/mask_ops.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed mask_ops {}", path1));

        let s2: Vec<u8> = vec![5, 2, 7, 3];
        let path2 = format!("{}/mask_ops.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed mask_ops {}", path2));
    }

    // bitstream_ops seeds
    {
        let s1: Vec<u8> = (0..32).collect();
        let path1 = format!("{}/bitstream_ops.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
        lines.push(format!("seed bitstream_ops {}", path1));

        let s2: Vec<u8> = (32..96).collect();
        let path2 = format!("{}/bitstream_ops.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed bitstream_ops {}", path2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // encode_string: large data payload
    {
        let mut big = vec![0u8];
        for i in 0..2000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/encode_string.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_string {}", path));
    }

    // structured_encode: large data to trigger splitting
    {
        let mut big = vec![0u8];
        for i in 0..5000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/structured_encode.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf structured_encode {}", path));
    }

    // input_build: moderately large payload
    {
        let mut big = vec![1u8, 0u8];
        for i in 0..1000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/input_build.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf input_build {}", path));
    }

    // encode_string_api: medium string
    {
        let mut big = vec![0u8];
        for i in 0..500u32 {
            big.push(b'A' + (i % 26) as u8);
        }
        let path = format!("{}/encode_string_api.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_string_api {}", path));
    }

    // split_input: large mixed string
    {
        let mut big = vec![10u8, 0u8];
        for i in 0..500u32 {
            if i % 3 == 0 {
                big.push(b'0' + (i % 10) as u8);
            } else if i % 3 == 1 {
                big.push(b'A' + (i % 26) as u8);
            } else {
                big.push(b'a' + (i % 26) as u8);
            }
        }
        let path = format!("{}/split_input.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf split_input {}", path));
    }

    // mask_ops: larger version
    {
        let s = vec![10u8, 0, 5, 3];
        let path = format!("{}/mask_ops.perf.bin", dir);
        fs::write(&path, &s).unwrap();
        lines.push(format!("perf mask_ops {}", path));
    }

    lines
}

