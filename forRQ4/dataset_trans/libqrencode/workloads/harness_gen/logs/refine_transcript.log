        // Mixed content: numbers, alpha, 8-bit, kanji-like
        s1.extend_from_slice(b"0123456789ABCDEF");
        s1.extend_from_slice(&[0x93, 0xFA, 0x96, 0x7B]); // kanji bytes
        s1.extend_from_slice(b"hello world test data for splitting");
        let path1 = format!("{}/split_structured.1.bin", dir);
