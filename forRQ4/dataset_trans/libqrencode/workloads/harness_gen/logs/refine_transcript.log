        s2.extend_from_slice(b"9876543210ZYXWVU");
        s2.extend_from_slice(&[0x82, 0xA0, 0x82, 0xA2]); // kanji
        for i in 0..100u32 {
            s2.push(b'a' + (i % 26) as u8);
