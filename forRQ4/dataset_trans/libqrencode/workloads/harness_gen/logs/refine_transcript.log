        s1.extend_from_slice(&[0x83, 0x65]); // テ
        s1.extend_from_slice(&[0x83, 0x58]); // ス
        s1.extend_from_slice(&[0x83, 0x67]); // ト
        let path1 = format!("{}/kanji_encode.1.bin", dir);
        fs::write(&path1, &s1).unwrap();
