fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9e37_79b9_7f4a_7c15)
}

fn checksum_bytes(bytes: &[u8]) -> u64 {
    let mut d = 0u64;
    for &b in bytes {
        d = fold(d, b as u64);
    }
    d ^ (bytes.len() as u64).wrapping_mul(0x517c_c1b7_2722_0a95)
}

fn sanitize_c_string_bytes(data: &[u8]) -> Vec<u8> {
    let mut v = Vec::with_capacity(data.len() + 1);
    for &b in data {
        v.push(if b == 0 { b'A' } else { b });
    }
    v.push(0);
    v
}

fn choose_level_qr(x: u8) -> QRecLevel {
    match x % 4 {
        0 => 0 as QRecLevel,
        1 => 1 as QRecLevel,
        2 => 2 as QRecLevel,
        _ => 3 as QRecLevel,
    }
}

fn choose_level_mqr(x: u8) -> QRecLevel {
    match x % 2 {
        0 => 0 as QRecLevel,
        _ => 1 as QRecLevel,
    }
}

fn choose_mode_qr(x: u8) -> QRencodeMode {
    match x % 5 {
        0 => 0 as QRencodeMode,
        1 => 1 as QRencodeMode,
        2 => 2 as QRencodeMode,
        3 => 3 as QRencodeMode,
        _ => 4 as QRencodeMode,
    }
}

fn choose_mode_mqr(x: u8) -> QRencodeMode {
    match x % 4 {
        0 => 0 as QRencodeMode,
        1 => 1 as QRencodeMode,
        2 => 2 as QRencodeMode,
        _ => 3 as QRencodeMode,
    }
}

fn safe_qr_version(b: u8) -> i32 {
    1 + (b % 10) as i32
}

fn safe_mqr_version(b: u8) -> i32 {
    1 + (b % 4) as i32
}

fn safe_qr_mask(b: u8) -> i32 {
    (b % 4) as i32
}

fn safe_mqr_mask(b: u8) -> i32 {
    (b % 4) as i32
}

unsafe fn qrcode_digest(qr: *mut QRcode) -> u64 {
    if qr.is_null() {
        return 0;
    }
    let q = &*qr;
    let mut d = 0u64;
    d = fold(d, q.version as u64);
    d = fold(d, q.width as u64);
    let width = if q.width > 0 { q.width as usize } else { 0 };
    let len = width.saturating_mul(width);
    if !q.data.is_null() && len > 0 {
        let bytes = std::slice::from_raw_parts(q.data, len);
        d = fold(d, checksum_bytes(bytes));
    } else {
        d = fold(d, 0);
    }
    d
}

unsafe fn qrcode_list_digest(list: *mut QRcode_List) -> (u64, i32) {
    if list.is_null() {
        return (0, -1);
    }
    let sz = QRcode_List_size(list as *mut _);
    (fold(0, sz as u64), sz)
}

fn op_encode_string_api(data: &[u8], iters: u64) -> String {
    let mut digest = checksum_bytes(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let cbytes = sanitize_c_string_bytes(data);
            let cptr = cbytes.as_ptr() as *const i8;

            let version = if data.is_empty() {
                1
            } else {
                safe_qr_version(data[0])
            };
            let mqr_version = if data.len() < 2 {
                1
            } else {
                safe_mqr_version(data[1])
            };
            let level = choose_level_qr(*data.get(2).unwrap_or(&0));
            let mlevel = choose_level_mqr(*data.get(2).unwrap_or(&0));
            let hint = choose_mode_qr(*data.get(3).unwrap_or(&2));
            let mhint = choose_mode_mqr(*data.get(3).unwrap_or(&2));
            let casesensitive = (*data.get(4).unwrap_or(&1) & 1) as i32;

            let qr1 = QRcode_encodeString(cptr, version, level, hint, casesensitive);
            digest = fold(digest, qrcode_digest(qr1));
            digest = fold(digest, (!qr1.is_null()) as u64);
            if !qr1.is_null() {
                QRcode_free(qr1 as *mut _);
            }

            let qr2 = QRcode_encodeStringMQR(cptr, mqr_version, mlevel, mhint, casesensitive);
            digest = fold(digest, qrcode_digest(qr2));
            digest = fold(digest, (!qr2.is_null()) as u64);
            if !qr2.is_null() {
                QRcode_free(qr2 as *mut _);
            }

            let qr3 = QRcode_encodeString8bit(cptr, version, level);
            digest = fold(digest, qrcode_digest(qr3));
            digest = fold(digest, (!qr3.is_null()) as u64);
            if !qr3.is_null() {
                QRcode_free(qr3 as *mut _);
            }

            let qr4 = QRcode_encodeString8bitMQR(cptr, mqr_version, mlevel);
            digest = fold(digest, qrcode_digest(qr4));
            digest = fold(digest, (!qr4.is_null()) as u64);
            if !qr4.is_null() {
                QRcode_free(qr4 as *mut _);
            }

            let list1 = QRcode_encodeStringStructured(cptr, version, level, hint, casesensitive);
            let (ld1, sz1) = qrcode_list_digest(list1);
            digest = fold(digest, ld1);
            digest = fold(digest, (!list1.is_null()) as u64);
            last_err = sz1;
            if !list1.is_null() {
                QRcode_List_free(list1 as *mut _);
            }

            let list2 = QRcode_encodeString8bitStructured(cptr, version, level);
            let (ld2, sz2) = qrcode_list_digest(list2);
            digest = fold(digest, ld2);
            digest = fold(digest, (!list2.is_null()) as u64);
            last_err = last_err.wrapping_add(sz2);
            if !list2.is_null() {
                QRcode_List_free(list2 as *mut _);
            }

            let mut maj = MaybeUninit::<i32>::zeroed();
            let mut min = MaybeUninit::<i32>::zeroed();
            let mut mic = MaybeUninit::<i32>::zeroed();
            QRcode_APIVersion(maj.as_mut_ptr(), min.as_mut_ptr(), mic.as_mut_ptr());
            let majv = maj.assume_init();
            let minv = min.assume_init();
            let micv = mic.assume_init();
            digest = fold(digest, majv as u64);
            digest = fold(digest, minv as u64);
            digest = fold(digest, micv as u64);

            let verstr = QRcode_APIVersionString();
            digest = fold(digest, (!verstr.is_null()) as u64);
            if !verstr.is_null() {
                let mut n = 0usize;
                while *verstr.add(n) != 0 && n < 256 {
                    digest = fold(digest, *verstr.add(n) as u8 as u64);
                    n += 1;
                }
                digest = fold(digest, n as u64);
            }

            QRcode_clearCache();
        }
    }

    format!("op=encode_string_api err={} digest={:016x}", last_err, digest)
}

fn op_encode_data_and_input(data: &[u8], iters: u64) -> String {
    let mut digest = checksum_bytes(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let version = if data.is_empty() {
                1
            } else {
                safe_qr_version(data[0])
            };
            let mqr_version = if data.len() < 2 {
                1
            } else {
                safe_mqr_version(data[1])
            };
            let level = choose_level_qr(*data.get(2).unwrap_or(&1));
            let mlevel = choose_level_mqr(*data.get(2).unwrap_or(&1));
            let mode = choose_mode_qr(*data.get(3).unwrap_or(&2));
            let size_i32 = if data.len() > i32::MAX as usize {
                i32::MAX
            } else {
                data.len() as i32
            };

            digest = fold(digest, QRinput_isSplittableMode(mode) as u64);
            digest = fold(digest, QRinput_estimateBitsModeNum(size_i32) as u64);
            digest = fold(digest, QRinput_estimateBitsModeAn(size_i32) as u64);
            digest = fold(digest, QRinput_estimateBitsMode8(size_i32) as u64);
            digest = fold(digest, QRinput_estimateBitsModeKanji(size_i32) as u64);
            digest = fold(
                digest,
                QRinput_check(
                    mode,
                    size_i32,
                    if data.is_empty() {
                        ptr::null()
                    } else {
                        data.as_ptr()
                    },
                ) as u64,
            );

            let input = QRinput_new();
            digest = fold(digest, (!input.is_null()) as u64);

            if !input.is_null() {
                let rc1 = QRinput_setVersion(input as *mut _, version);
                let rc2 = QRinput_setErrorCorrectionLevel(input as *mut _, level);
                let rc3 =
                    QRinput_setVersionAndErrorCorrectionLevel(input as *mut _, version, level);
                let rc4 = QRinput_append(
                    input as *mut _,
                    mode,
                    size_i32,
                    if data.is_empty() {
                        ptr::null()
                    } else {
                        data.as_ptr()
                    },
                );
                let rc5 = QRinput_appendECIheader(input as *mut _, 26);
                let rc6 = QRinput_setFNC1First(input as *mut _);
                let rc7 = QRinput_setFNC1Second(input as *mut _, *data.get(4).unwrap_or(&0x30));
                digest = fold(digest, rc1 as u64);
                digest = fold(digest, rc2 as u64);
                digest = fold(digest, rc3 as u64);
                digest = fold(digest, rc4 as u64);
                digest = fold(digest, rc5 as u64);
                digest = fold(digest, rc6 as u64);
                digest = fold(digest, rc7 as u64);
                last_err = rc1 ^ rc2 ^ rc3 ^ rc4 ^ rc5 ^ rc6 ^ rc7;

                digest = fold(digest, QRinput_getVersion(input as *mut _) as u64);
                digest = fold(
                    digest,
                    QRinput_getErrorCorrectionLevel(input as *mut _) as u64,
                );

                let bs = QRinput_getByteStream(input as *mut _);
                digest = fold(digest, (!bs.is_null()) as u64);

                let qd = QRcode_encodeInput(input as *mut _);
                digest = fold(digest, qrcode_digest(qd as *mut _));
                if !qd.is_null() {
                    QRcode_free(qd as *mut _);
                }

                let dup = QRinput_dup(input as *mut _);
                digest = fold(digest, (!dup.is_null()) as u64);
                if !dup.is_null() {
                    let qd2 = QRcode_encodeInput(dup as *mut _);
                    digest = fold(digest, qrcode_digest(qd2 as *mut _));
                    if !qd2.is_null() {
                        QRcode_free(qd2 as *mut _);
                    }
                    QRinput_free(dup as *mut _);
                }

                let split_struct = QRinput_splitQRinputToStruct(input as *mut _);
                digest = fold(digest, (!split_struct.is_null()) as u64);
                if !split_struct.is_null() {
                    let rc = QRinput_Struct_insertStructuredAppendHeaders(split_struct as *mut _);
                    digest = fold(digest, rc as u64);
                    let ql = QRcode_encodeInputStructured(split_struct as *mut _);
                    let (ld, sz) = qrcode_list_digest(ql as *mut _);
                    digest = fold(digest, ld);
                    digest = fold(digest, sz as u64);
                    if !ql.is_null() {
                        QRcode_List_free(ql as *mut _);
                    }
                    QRinput_Struct_free(split_struct as *mut _);
                }

                QRinput_free(input as *mut _);
            }

            let input2 = QRinput_new2(version, level);
            digest = fold(digest, (!input2.is_null()) as u64);
            if !input2.is_null() {
                let rc = QRinput_append(
                    input2 as *mut _,
                    2 as QRencodeMode,
                    size_i32,
                    if data.is_empty() {
                        ptr::null()
                    } else {
                        data.as_ptr()
                    },
                );
                digest = fold(digest, rc as u64);
                QRinput_free(input2 as *mut _);
            }

            let input3 = QRinput_newMQR(mqr_version, mlevel);
            digest = fold(digest, (!input3.is_null()) as u64);
            if !input3.is_null() {
                let rc = QRinput_append(
                    input3 as *mut _,
                    2 as QRencodeMode,
                    size_i32,
                    if data.is_empty() {
                        ptr::null()
                    } else {
                        data.as_ptr()
                    },
                );
                digest = fold(digest, rc as u64);
                QRinput_free(input3 as *mut _);
            }

            let qd = QRcode_encodeData(
                size_i32,
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr()
                },
                version,
                level,
            );
            digest = fold(digest, qrcode_digest(qd as *mut _));
            if !qd.is_null() {
                QRcode_free(qd as *mut _);
            }

            let qdm = QRcode_encodeDataMQR(
                size_i32,
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr()
                },
                mqr_version,
                mlevel,
            );
            digest = fold(digest, qrcode_digest(qdm as *mut _));
            if !qdm.is_null() {
                QRcode_free(qdm as *mut _);
            }

            let qls = QRcode_encodeDataStructured(
                size_i32,
                if data.is_empty() {
                    ptr::null()
                } else {
                    data.as_ptr()
                },
                version,
                level,
            );
            let (ld, sz) = qrcode_list_digest(qls as *mut _);
            digest = fold(digest, ld);
            digest = fold(digest, sz as u64);
            if !qls.is_null() {
                QRcode_List_free(qls as *mut _);
            }

            let s = QRinput_Struct_new();
            digest = fold(digest, (!s.is_null()) as u64);
            if !s.is_null() {
                QRinput_Struct_setParity(s as *mut _, *data.get(5).unwrap_or(&0x5a));
                let a = QRinput_new2(version, level);
                let b = QRinput_new2(version, level);
                if !a.is_null() {
                    let half = data.len() / 2;
                    let rc = QRinput_append(
                        a as *mut _,
                        2 as QRencodeMode,
                        half.min(i32::MAX as usize) as i32,
                        if half == 0 {
                            ptr::null()
                        } else {
                            data[..half].as_ptr()
                        },
                    );
                    digest = fold(digest, rc as u64);
                    let rc2 = QRinput_Struct_appendInput(s as *mut _, a as *mut _);
                    digest = fold(digest, rc2 as u64);
                }
                if !b.is_null() {
                    let half = data.len() / 2;
                    let tail = &data[half..];
                    let rc = QRinput_append(
                        b as *mut _,
                        2 as QRencodeMode,
                        tail.len().min(i32::MAX as usize) as i32,
                        if tail.is_empty() {
                            ptr::null()
                        } else {
                            tail.as_ptr()
                        },
                    );
                    digest = fold(digest, rc as u64);
                    let rc2 = QRinput_Struct_appendInput(s as *mut _, b as *mut _);
                    digest = fold(digest, rc2 as u64);
                }
                let rc = QRinput_Struct_insertStructuredAppendHeaders(s as *mut _);
                digest = fold(digest, rc as u64);
                let ql = QRcode_encodeInputStructured(s as *mut _);
                let (ld2, sz2) = qrcode_list_digest(ql as *mut _);
                digest = fold(digest, ld2);
                digest = fold(digest, sz2 as u64);
                if !ql.is_null() {
                    QRcode_List_free(ql as *mut _);
                }
                QRinput_Struct_free(s as *mut _);
            }

            let cbytes = sanitize_c_string_bytes(data);
            let split_input = QRinput_new2(version, level);
            if !split_input.is_null() {
                let rc = Split_splitStringToQRinput(
                    cbytes.as_ptr() as *const i8,
                    split_input as *mut _,
                    mode,
                    (*data.get(6).unwrap_or(&1) & 1) as i32,
                );
                digest = fold(digest, rc as u64);
                let q = QRcode_encodeInput(split_input as *mut _);
                digest = fold(digest, qrcode_digest(q as *mut _));
                if !q.is_null() {
                    QRcode_free(q as *mut _);
                }
                QRinput_free(split_input as *mut _);
            }
        }
    }

    format!("op=encode_data_and_input err={} digest={:016x}", last_err, digest)
}

fn op_spec_mask_ecc(data: &[u8], iters: u64) -> String {
    let mut digest = checksum_bytes(data);
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let b0 = *data.get(0).unwrap_or(&1);
            let b1 = *data.get(1).unwrap_or(&1);
            let b2 = *data.get(2).unwrap_or(&0);
            let b3 = *data.get(3).unwrap_or(&0);

            let version = safe_qr_version(b0);
            let mqr_version = safe_mqr_version(b1);
            let level = choose_level_qr(b2);
            let mlevel = choose_level_mqr(b2);
            let qr_mask = safe_qr_mask(b3);
            let mqr_mask = safe_mqr_mask(b3);
            let mode = choose_mode_qr(*data.get(4).unwrap_or(&2));
            let mmode = choose_mode_mqr(*data.get(4).unwrap_or(&2));
            let payload = if data.len() > 5 { &data[5..] } else { &[][..] };

            digest = fold(digest, QRspec_getDataLength(version, level) as u64);
            digest = fold(digest, QRspec_getECCLength(version, level) as u64);
            digest = fold(
                digest,
                QRspec_getMinimumVersion(payload.len().min(i32::MAX as usize) as i32, level) as u64,
            );
            let width = QRspec_getWidth(version);
            digest = fold(digest, width as u64);
            digest = fold(digest, QRspec_getRemainder(version) as u64);
            digest = fold(digest, QRspec_lengthIndicator(mode, version) as u64);
            digest = fold(digest, QRspec_maximumWords(mode, version) as u64);

            let mut spec = [0i32; 5];
            QRspec_getEccSpec(version, level, spec.as_mut_ptr());
            for &x in &spec {
                digest = fold(digest, x as u64);
            }

            digest = fold(digest, QRspec_getVersionPattern(version) as u64);
            digest = fold(digest, QRspec_getFormatInfo(qr_mask, level) as u64);

            let frame = QRspec_newFrame(version);
            digest = fold(digest, (!frame.is_null()) as u64);
            if !frame.is_null() && width > 0 {
                let flen = (width as usize).saturating_mul(width as usize);
                let fbytes = std::slice::from_raw_parts(frame, flen);
                digest = fold(digest, checksum_bytes(fbytes));

                let masked1 = Mask_makeMask(width, frame, qr_mask, level);
                digest = fold(digest, (!masked1.is_null()) as u64);
                if !masked1.is_null() {
                    let mbytes = std::slice::from_raw_parts(masked1, flen);
                    digest = fold(digest, checksum_bytes(mbytes));
                }

                let masked2 = Mask_mask(width, frame, level);
                digest = fold(digest, (!masked2.is_null()) as u64);
                if !masked2.is_null() {
                    let mbytes = std::slice::from_raw_parts(masked2, flen);
                    digest = fold(digest, checksum_bytes(mbytes));
                }
            }

            digest = fold(digest, MQRspec_getDataLengthBit(mqr_version, mlevel) as u64);
            digest = fold(digest, MQRspec_getDataLength(mqr_version, mlevel) as u64);
            digest = fold(digest, MQRspec_getECCLength(mqr_version, mlevel) as u64);
            let mwidth = MQRspec_getWidth(mqr_version);
            digest = fold(digest, mwidth as u64);
            digest = fold(digest, MQRspec_lengthIndicator(mmode, mqr_version) as u64);
            digest = fold(digest, MQRspec_maximumWords(mmode, mqr_version) as u64);
            digest = fold(digest, MQRspec_getFormatInfo(mqr_mask, mqr_version, mlevel) as u64);

            let mframe = MQRspec_newFrame(mqr_version);
            digest = fold(digest, (!mframe.is_null()) as u64);
            if !mframe.is_null() && mwidth > 0 {
                let flen = (mwidth as usize).saturating_mul(mwidth as usize);
                let fbytes = std::slice::from_raw_parts(mframe, flen);
                digest = fold(digest, checksum_bytes(fbytes));

                let masked1 = MMask_makeMask(mqr_version, mframe, mqr_mask, mlevel);
                digest = fold(digest, (!masked1.is_null()) as u64);
                if !masked1.is_null() {
                    let mbytes = std::slice::from_raw_parts(masked1, flen);
                    digest = fold(digest, checksum_bytes(mbytes));
                }

                let masked2 = MMask_mask(mqr_version, mframe, mlevel);
                digest = fold(digest, (!masked2.is_null()) as u64);
                if !masked2.is_null() {
                    let mbytes = std::slice::from_raw_parts(masked2, flen);
                    digest = fold(digest, checksum_bytes(mbytes));
                }
            }

            let bs1 = BitStream_new();
            let bs2 = BitStream_new();
            digest = fold(digest, (!bs1.is_null()) as u64);
            digest = fold(digest, (!bs2.is_null()) as u64);
            if !bs1.is_null() && !bs2.is_null() {
                let rc1 = BitStream_appendNum(bs1 as *mut _, 8, b0 as u32);
                let rc2 = BitStream_appendNum(bs1 as *mut _, 6, b1 as u32);
                let rc3 = BitStream_appendBytes(
                    bs1 as *mut _,
                    payload.len(),
                    if payload.is_empty() {
                        ptr::null_mut()
                    } else {
                        payload.as_ptr() as *mut u8
                    },
                );
                let rc4 = BitStream_appendNum(bs2 as *mut _, 4, b2 as u32);
                let rc5 = BitStream_appendBytes(
                    bs2 as *mut _,
                    payload.len().min(32),
                    if payload.is_empty() {
                        ptr::null_mut()
                    } else {
                        payload.as_ptr() as *mut u8
                    },
                );
                let rc6 = BitStream_append(bs1 as *mut _, bs2 as *mut _);
                last_err = rc1 ^ rc2 ^ rc3 ^ rc4 ^ rc5 ^ rc6;
                digest = fold(digest, rc1 as u64);
                digest = fold(digest, rc2 as u64);
                digest = fold(digest, rc3 as u64);
                digest = fold(digest, rc4 as u64);
                digest = fold(digest, rc5 as u64);
                digest = fold(digest, rc6 as u64);

                let out = BitStream_toByte(bs1 as *mut _);
                digest = fold(digest, (!out.is_null()) as u64);
                if !out.is_null() {
                    // BitStream_toByte returns a malloc'd buffer of exactly
                    // ceil(bit_length / 8) bytes. Read that exact length from
                    // the stream, never a guess: a guessed length longer than
                    // the allocation makes checksum_bytes read uninitialized
                    // heap past the buffer, producing a nondeterministic digest.
                    let nbytes = ((*(bs1 as *const BitStream)).length as usize)
                        .saturating_add(7)
                        / 8;
                    let bytes = std::slice::from_raw_parts(out, nbytes.min(4096));
                    digest = fold(digest, checksum_bytes(bytes));
                }
            }
            if !bs2.is_null() {
                BitStream_free(bs2 as *mut _);
            }
            if !bs1.is_null() {
                BitStream_free(bs1 as *mut _);
            }

            let data_len = payload.len().min(255);
            let ecc_len = 16usize + (b3 as usize % 32);
            let mut ecc = vec![0u8; ecc_len];
            let rc = RSECC_encode(
                data_len,
                ecc_len,
                if data_len == 0 {
                    ptr::null()
                } else {
                    payload.as_ptr()
                },
                ecc.as_mut_ptr(),
            );
            digest = fold(digest, rc as u64);
            digest = fold(digest, checksum_bytes(&ecc));
            last_err ^= rc;
        }
    }

    format!("op=spec_mask_ecc err={} digest={:016x}", last_err, digest)
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        (
            "encode_string_api",
            op_encode_string_api as fn(&[u8], u64) -> String,
        ),
        (
            "encode_data_and_input",
            op_encode_data_and_input as fn(&[u8], u64) -> String,
        ),
        (
            "spec_mask_ecc",
            op_spec_mask_ecc as fn(&[u8], u64) -> String,
        ),
    ]
}

fn write_seed(dir: &str, op: &str, idx: usize, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.{}.bin", dir, op, idx);
    let _ = fs::write(&path, bytes);
    out.push(format!("seed {} {}", op, path));
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let s1 = b"https://ex.co/a1".to_vec();
    let s2 = b"MECARD:N:DOE,JOE;TEL:5551;;".to_vec();
    write_seed(dir, "encode_string_api", 1, &s1, &mut out);
    write_seed(dir, "encode_string_api", 2, &s2, &mut out);

    let d1 = b"\t\x03\x00\x02A12345-BYTE-DATA".to_vec();
    let d2 = b"\t\x03\x00\x02BIZCARD|ID=42|X=19".to_vec();
    write_seed(dir, "encode_data_and_input", 1, &d1, &mut out);
    write_seed(dir, "encode_data_and_input", 2, &d2, &mut out);

    let mut c1 = vec![3, 1, 0, 0, 2];
    c1.extend_from_slice(b"HELLO1234-QR-PAYLOAD");
    let mut c2 = vec![8, 2, 1, 3, 1];
    c2.extend_from_slice(b"\x10\x20\x30ECC-and-bitstream-test-987654321");
    write_seed(dir, "spec_mask_ecc", 1, &c1, &mut out);
    write_seed(dir, "spec_mask_ecc", 2, &c2, &mut out);

    out
}

fn build_large_encode_string_api_perf() -> Vec<u8> {
    let mut v = Vec::with_capacity(6_500_000);
    v.extend_from_slice(b"https://ex.co/a1?");
    for i in 0..48_000u32 {
        let line = format!(
            "u=USER{u:06}&tel=555{t:07}&amt={a:05}&city=METRO{c:03}&memo=MECARD:N:DOE,JOE{j:03};TEL:555{t:07};EMAIL:joe{u:06}@example.com;URL:https://ex.co/p/{u:06};ADR:Suite-{s:04}-North;NOTE=ALPHA-BETA-GAMMA-{g:02};;\n",
            u = i,
            t = (i.wrapping_mul(97)) % 10_000_000,
            a = (i.wrapping_mul(13)) % 100_000,
            c = i % 1000,
            j = i % 1000,
            s = i % 10000,
            g = i % 100
        );
        v.extend_from_slice(line.as_bytes());
    }
    v
}

fn build_large_encode_data_and_input_perf() -> Vec<u8> {
    let mut v = Vec::with_capacity(6_500_000);
    v.extend_from_slice(b"\t\x03\x00\x02");
    for i in 0..70_000u32 {
        let rec = format!(
            "BIZCARD|ID={id:06}|TYPE=CONTACT|NAME=DOE,JOE{id2:03}|TEL=555{tel:07}|MAIL=joe{id:06}@example.com|ADDR={blk:04} MARKET ST|CITY=METRO{city:03}|ZIP={zip:05}|SKU=QR-{sku:08}|NOTE=BYTE-DATA-ALPHA-{note:03}|",
            id = i,
            id2 = i % 1000,
            tel = (i.wrapping_mul(37)) % 10_000_000,
            blk = i % 10000,
            city = i % 1000,
            zip = (i.wrapping_mul(19)) % 100000,
            sku = i ^ 0x00ab_cdef,
            note = i % 1000
        );
        v.extend_from_slice(rec.as_bytes());
        v.push(0x1d);
        v.extend_from_slice(format!("LOT={:06}|QTY={:05}|", i % 1_000_000, i % 100_000).as_bytes());
        v.push(b'\n');
    }
    v
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut out = Vec::new();

    let big_string = build_large_encode_string_api_perf();
    let p1 = format!("{}/encode_string_api.perf.bin", dir);
    let _ = fs::write(&p1, &big_string);
    out.push(format!("perf encode_string_api {}", p1));

    let big_data = build_large_encode_data_and_input_perf();
    let p2 = format!("{}/encode_data_and_input.perf.bin", dir);
    let _ = fs::write(&p2, &big_data);
    out.push(format!("perf encode_data_and_input {}", p2));

    let mut big_ctrl = vec![7, 2, 0, 3, 1];
    for i in 0..300_000u32 {
        big_ctrl.extend_from_slice(
            format!(
                "BLK{:06}|REC={:08}|TYPE=PAYLOAD|USER=ALPHA{:03}|AMT={:05}|NOTE=ECC-and-bitstream-test|\n",
                i,
                i ^ 0x00ab_cdef,
                i % 1000,
                i % 100000
            )
            .as_bytes(),
        );
        big_ctrl.push((i & 0xff) as u8);
        big_ctrl.push(((i * 5) & 0xff) as u8);
    }
    let p3 = format!("{}/spec_mask_ecc.perf.bin", dir);
    let _ = fs::write(&p3, &big_ctrl);
    out.push(format!("perf spec_mask_ecc {}", p3));

    out
}
