        let path2 = format!("{}/split_structured.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed split_structured {}", path2));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    // encode_string: large data payload
    {
        let mut big = vec![0u8]; // level = 0
        for i in 0..2000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/encode_string.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_string {}", path));
    }

    // encode_mqr: exercises QRcode_encodeDataMQR
    // MQR version 4 (ctrl byte: version bits = 3 → (3&3)+1=4), level L (bits 2-3 = 0)
    // MQR v4 L can hold up to 15 bytes of 8-bit data
    // We use numeric data which allows more: up to 35 numeric digits for M4-L
    {
        // ctrl byte: version=4 → bits 0-1 = 0x03, level=L → bits 2-3 = 0x00 → ctrl = 0x03
        let mut big = vec![0x03u8];
        // Fill with numeric digits (MQR v4 can hold up to 35 numeric chars)
        for i in 0..35u32 {
            big.push(b'0' + (i % 10) as u8);
        }
        let path = format!("{}/encode_mqr.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_mqr {}", path));
    }

    // structured_encode: large data to trigger splitting
    {
        let mut big = vec![0u8];
        for i in 0..5000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/structured_encode.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf structured_encode {}", path));
    }

    // input_build: moderately large payload
    {
        let mut big = vec![1u8, 0u8];
        for i in 0..1000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/input_build.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf input_build {}", path));
    }

    // spec_queries: exercises QRcode_APIVersion, QRcode_APIVersionString, QRcode_clearCache
    // The op iterates over all versions/levels/masks from the data bytes.
    // We provide a large input so the per-iteration work (frame alloc for large versions,
    // RSECC, bitstream ops, API version queries, clearCache) dominates.
    // Use a high version number to make QRspec_newFrame allocate large frames.
    {
        // byte 0: version = (val % 40) + 1. Use 39 → version 40 (largest QR)
        // byte 1: level = (val % 4). Use 0 → L
        // byte 2: mask = (val % 8). Use 3
        // byte 3: mqr_version = (val % 4) + 1. Use 3 → version 4
        // byte 4: mode = (val % 4). Use 2
        // bytes 5-13: RSECC + bitstream data
        let mut big = vec![39u8, 0, 3, 3, 2];
        // Fill remaining bytes for RSECC and bitstream operations
        for i in 5..64u32 {
            big.push((i * 17 + 5) as u8);
        }
        let path = format!("{}/spec_queries.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf spec_queries {}", path));
    }

    // encode_string_api: medium string
    {
        let mut big = vec![0u8];
        for i in 0..500u32 {
            big.push(b'A' + (i % 26) as u8);
        }
        let path = format!("{}/encode_string_api.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_string_api {}", path));
    }

    // encode_string_structured: exercises QRcode_encodeStringStructured and
    // QRcode_encodeString8bitStructured
    // Need a large string that forces structured encoding (splitting into multiple QR symbols)
    {
        // ctrl byte: level=0 (L), hint=2 (8bit), casesensitive=0
        let mut big = vec![0x00u8];
        // Large payload of printable ASCII (no nulls) to force structured splitting
        // Version 0 (auto) with lots of data → multiple structured symbols
        for i in 0..2000u32 {
            big.push(b'A' + (i % 26) as u8);
        }
        let path = format!("{}/encode_string_structured.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf encode_string_structured {}", path));
    }

    // input_struct: exercises QRinput_new (plain, no version) and structured input encoding
    // The op creates QRinput_new() each iteration, plus builds QRinput_Struct with two inputs
    {
        // byte 0: version = (val % 40) + 1 → use 1 for small version (forces more struct splits)
        // byte 1: level = (val % 4) → 0 = L
        // byte 2: parity
        // bytes 3+: payload split into two halves for two QRinput entries
        let mut big = vec![1u8, 0u8, 0xAAu8];
        // Large payload to make the structured encoding do real work
        for i in 0..1000u32 {
            big.push(b'A' + (i % 26) as u8);
        }
        let path = format!("{}/input_struct.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf input_struct {}", path));
    }

    // split_input: large mixed string
    {
        let mut big = vec![10u8, 0u8];
        for i in 0..500u32 {
            if i % 3 == 0 {
                big.push(b'0' + (i % 10) as u8);
            } else if i % 3 == 1 {
                big.push(b'A' + (i % 26) as u8);
            } else {
                big.push(b'a' + (i % 26) as u8);
            }
        }
        let path = format!("{}/split_input.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf split_input {}", path));
    }

    // mask_ops: larger version for bigger frames
    {
        let s = vec![10u8, 0, 5, 3];
        let path = format!("{}/mask_ops.perf.bin", dir);
        fs::write(&path, &s).unwrap();
        lines.push(format!("perf mask_ops {}", path));
    }

    // bitstream_ops: exercises BitStream_append with large data
    // The op creates two bitstreams, appends data to each, then appends bs2 to bs1.
    // We need a large input so the appendBytes and append operations do substantial work.
    {
        // Build a large input. The op uses:
        //   - first 64 bytes → appendBytes to bs1
        //   - 16-bit num from bytes 0-1 → appendNum to bs1
        //   - bytes 2..min(len-2, 32) → appendBytes to bs2
        //   - appendNum 8 bits to bs2
        //   - BitStream_append(bs1, bs2)
        // To maximize BitStream_append work, we want both streams to be large.
        // The op caps chunk_size at 64 and chunk2 at 32, so we need the data to be
        // at least 64+2=66 bytes. But the real scaling is in the append + toByte.
        // Let's provide a large input so the loop runs many iterations with substantial data.
        let mut big: Vec<u8> = Vec::with_capacity(200);
        for i in 0..200u32 {
            big.push(((i * 37 + 0x20) % 256) as u8);
        }
        let path = format!("{}/bitstream_ops.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf bitstream_ops {}", path));
    }

    // kanji_encode: large kanji payload
    {
        let mut big = vec![10u8, 0u8];
        for i in 0..200u32 {
            // Valid Shift-JIS kanji range
            big.push(0x82);
            big.push(0xA0 + (i % 80) as u8);
        }
        let path = format!("{}/kanji_encode.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf kanji_encode {}", path));
    }

    // fnc1_encode: medium payload
    {
        let mut big = vec![10u8, 0u8, 0x25u8];
        for i in 0..200u32 {
            big.push(b'0' + (i % 10) as u8);
        }
        let path = format!("{}/fnc1_encode.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf fnc1_encode {}", path));
    }

    // structured_input_encode: large data
    {
        let mut big = vec![1u8, 0u8];
        for i in 0..2000u32 {
            big.push((i % 256) as u8);
        }
        let path = format!("{}/structured_input_encode.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf structured_input_encode {}", path));
    }

    // mqr_input_build: exercises QRinput_newMQR and MQR encoding paths
    // MQR version 4, level L (0) can hold up to ~15 bytes 8-bit or ~35 numeric digits
    {
        // byte 0: mqr_version = (val % 4) + 1. Use 3 → version 4
        // byte 1: level = (val % 4). Use 0 → L
        let mut big = vec![3u8, 0u8];
        // Numeric data that fits in MQR v4
        for i in 0..30u32 {
            big.push(b'0' + (i % 10) as u8);
        }
        let path = format!("{}/mqr_input_build.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf mqr_input_build {}", path));
    }

    // split_structured: large mixed data
    {
        let mut big = vec![1u8, 0u8, 0x03u8];
        for i in 0..500u32 {
            if i % 4 == 0 {
                big.push(b'0' + (i % 10) as u8);
            } else if i % 4 == 1 {
                big.push(b'A' + (i % 26) as u8);
            } else {
                big.push(b'a' + (i % 26) as u8);
            }
        }
        let path = format!("{}/split_structured.perf.bin", dir);
        fs::write(&path, &big).unwrap();
        lines.push(format!("perf split_structured {}", path));
    }

    lines
}
