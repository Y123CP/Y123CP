        s2.extend_from_slice(&[0x82, 0xA4]); // う
        s2.extend_from_slice(&[0x82, 0xA6]); // え
        s2.extend_from_slice(&[0x82, 0xA8]); // お
        s2.extend_from_slice(&[0xE0, 0x40]); // high range kanji
        s2.extend_from_slice(&[0xE0, 0x41]);
        let path2 = format!("{}/kanji_encode.2.bin", dir);
        fs::write(&path2, &s2).unwrap();
        lines.push(format!("seed kanji_encode {}", path2));
