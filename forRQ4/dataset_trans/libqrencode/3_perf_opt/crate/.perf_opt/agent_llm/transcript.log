    if frame[0] as c_int & 1 as c_int != 0 {
        run_length[0] = -(1 as c_int);
        head = 1 as c_int;
    } else {
        head = 0 as c_int;
    }
    run_length[head as usize] = 1 as c_int;
    prev = frame[0];

    let mut i: c_int = 1 as c_int;
    while i < width {
        let pixel = frame[(i * width) as usize];
        if (pixel as c_int ^ prev as c_int) & 1 as c_int != 0 {
            head += 1;
            run_length[head as usize] = 1 as c_int;
            prev = pixel;
        } else {
            run_length[head as usize] += 1;
        }
        i += 1;
    }
    return head + 1 as c_int;
