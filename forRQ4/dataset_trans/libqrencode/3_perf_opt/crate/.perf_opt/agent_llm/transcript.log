        } else {
            // SAFETY: same bound as above; `head <= width`, so this mutable
            // access stays within the `run_length` view.
            unsafe {
                let slot = run_length.get_unchecked_mut(head as usize);
                *slot += 1;
            }
        }
        i += 1;
    }
    head + 1 as c_int
}
```
