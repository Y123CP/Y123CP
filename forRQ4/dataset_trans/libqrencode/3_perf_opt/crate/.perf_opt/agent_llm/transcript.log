    // SAFETY: caller guarantees `buf` points to `len` T's with no aliasing.
    let buf = unsafe { core::slice::from_raw_parts_mut(buf, len) };
    for (i, dst) in buf.iter_mut().enumerate() {
        *dst = compute(i);
    }
}
```

### 3.2 P2 — post-increment → iterator

