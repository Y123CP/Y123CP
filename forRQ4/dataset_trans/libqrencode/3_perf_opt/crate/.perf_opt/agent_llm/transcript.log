```rust
// Applied rules: [III④]
// Skipped rules: []
unsafe fn Mask_calcN2(
    mut width: c_int,
    mut frame: *mut c_uchar,
) -> c_int {
    let width_usize = width as usize;
    // SAFETY: `width` is the explicit length source (L1); the original code
    // accesses elements within a `width * width` frame, so caller must provide
    // a non-null pointer to at least that many `c_uchar`s. This function
    // creates only one mutable slice for the region and does not create any
    // other references to it across the rewrite region.
    let frame = unsafe { core::slice::from_raw_parts_mut(frame, width_usize * width_usize) };

    let mut demerit: c_int = 0;
    let mut y = 1usize;
    while y < width_usize {
        let prev_row = &frame[(y - 1) * width_usize..y * width_usize];
        let row = &frame[y * width_usize..(y + 1) * width_usize];

        for (top, bottom) in prev_row.windows(2).zip(row.windows(2)) {
            let b22 = (top[0] & top[1] & bottom[0] & bottom[1]) as c_uchar;
            let w22 = (top[0] | top[1] | bottom[0] | bottom[1]) as c_uchar;
            if ((b22 as c_int) | ((w22 as c_int) ^ 1 as c_int)) & 1 as c_int != 0 {
                demerit += N2;
            }
        }
        y += 1;
    }
    demerit
}
