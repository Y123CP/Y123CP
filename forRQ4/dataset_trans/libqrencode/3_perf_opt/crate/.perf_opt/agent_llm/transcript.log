// two regions do not overlap.
let src = unsafe { core::slice::from_raw_parts(src, count) };
let dst = unsafe { core::slice::from_raw_parts_mut(dst, count) };
dst.copy_from_slice(src);           // if T: Copy; otherwise use zip
```

