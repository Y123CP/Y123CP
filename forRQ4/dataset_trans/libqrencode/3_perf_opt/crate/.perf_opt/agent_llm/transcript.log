            != 0
        {
            head += 1;
            *runLength.offset(head as isize) = 1 as c_int;
            prev = *frame.offset((i * width) as isize);
        } else {
            let ref mut fresh0 = *runLength.offset(head as isize);
            *fresh0 += 1;
        }
        i += 1;
    }
