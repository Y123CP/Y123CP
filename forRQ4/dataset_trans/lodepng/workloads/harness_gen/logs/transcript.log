    }
}

fn encode_palette_png_with_features(seed: &[u8]) -> Vec<u8> {
    unsafe {
        let mut st = MaybeUninit::<LodePNGState>::zeroed();
        lodepng_state_init(st.as_mut_ptr());
        let stp = st.as_mut_ptr();

        (*stp).info_raw = lodepng_color_mode_make(3 as _, 8);
        (*stp).info_png.color = lodepng_color_mode_make(3 as _, 8);
        (*stp).info_png.interlace_method = 1;
        (*stp).encoder.auto_convert = 0;
        (*stp).encoder.force_palette = 1;
        (*stp).encoder.text_compression = 1;

        for i in 0..16u8 {
            let r = i.wrapping_mul(17);
            let g = i.wrapping_mul(11).wrapping_add(23);
            let b = i.wrapping_mul(29).wrapping_add(7);
            let a = if i % 5 == 0 { 96 } else { 255 };
            let _ = lodepng_palette_add(&mut (*stp).info_raw, r, g, b, a);
            let _ = lodepng_palette_add(&mut (*stp).info_png.color, r, g, b, a);
        }

        let key1 = b"Comment\0";
        let val1 = b"palette/interlace seed\0";
        let key2 = b"LangComment\0";
        let lang = b"en\0";
        let tr = b"comment\0";
        let val2 = b"international text payload\0";
        let _ = lodepng_add_text(
            &mut (*stp).info_png,
            key1.as_ptr() as *const c_char,
            val1.as_ptr() as *const c_char,
        );
        let _ = lodepng_add_itext(
            &mut (*stp).info_png,
            key2.as_ptr() as *const c_char,
            lang.as_ptr() as *const c_char,
            tr.as_ptr() as *const c_char,
            val2.as_ptr() as *const c_char,
        );

        let icc_name = b"sRGB\0";
        let icc_profile: [u8; 25] = *b"FakeICCProfileData1234567";
        let exif_blob: [u8; 20] = [
            0x4d, 0x4d, 0x00, 0x2a, 0, 0, 0, 8, 0, 1, 0x01, 0x12, 0, 3, 0, 0, 0, 1, 0, 1,
        ];
        let _ = lodepng_set_icc(
            &mut (*stp).info_png,
            icc_name.as_ptr() as *const c_char,
            icc_profile.as_ptr(),
            icc_profile.len() as c_uint,
        );
        let _ = lodepng_set_exif(
            &mut (*stp).info_png,
            exif_blob.as_ptr(),
            exif_blob.len() as c_uint,
        );

        let w = 64u32;
        let h = 64u32;
        let mut image = vec![0u8; (w * h) as usize];
        for (i, px) in image.iter_mut().enumerate() {
            let b = if seed.is_empty() { i as u8 } else { seed[i % seed.len()] };
            *px = b & 15;
        }

        let mut out_ptr: *mut c_uchar = ptr::null_mut();
        let mut out_size: size_t = 0;
        let err = lodepng_encode(
            &mut out_ptr,
            &mut out_size,
            image.as_ptr(),
            w as c_uint,
            h as c_uint,
            stp,
        );

        let out = if err == 0 && !out_ptr.is_null() {
            let v = std::slice::from_raw_parts(out_ptr, out_size as usize).to_vec();
            free_c_buffer(out_ptr);
            v
        } else {
            free_c_buffer(out_ptr);
            Vec::new()
        };

        lodepng_state_cleanup(stp);
        out
    }
}

fn encode_gray1_interlaced_png(seed: &[u8]) -> Vec<u8> {
    unsafe {
        let mut st = MaybeUninit::<LodePNGState>::zeroed();
        lodepng_state_init(st.as_mut_ptr());
        let stp = st.as_mut_ptr();

        (*stp).info_raw = lodepng_color_mode_make(0 as _, 1);
        (*stp).info_png.color = lodepng_color_mode_make(0 as _, 1);
        (*stp).info_png.interlace_method = 1;
        (*stp).encoder.auto_convert = 0;

        let w = 33u32;
        let h = 35u32;
        let rowbytes = ((w + 7) / 8) as usize;
        let mut image = vec![0u8; rowbytes.saturating_mul(h as usize)];

        for y in 0..h as usize {
            for x in 0..w as usize {
                let s = if seed.is_empty() {
                    ((x * 13 + y * 7) & 255) as u8
                } else {
                    seed[(x + y * rowbytes) % seed.len()]
                };
                let bit = ((s.rotate_left((x & 7) as u32) ^ (y as u8).wrapping_mul(11)) >> 5) & 1;
                if bit != 0 {
                    let idx = y * rowbytes + x / 8;
                    image[idx] |= 1u8 << (7 - (x & 7));
                }
            }
        }

        let mut out_ptr: *mut c_uchar = ptr::null_mut();
        let mut out_size: size_t = 0;
        let err = lodepng_encode(
            &mut out_ptr,
            &mut out_size,
            image.as_ptr(),
            w as c_uint,
            h as c_uint,
            stp,
        );

        let out = if err == 0 && !out_ptr.is_null() {
            let v = std::slice::from_raw_parts(out_ptr, out_size as usize).to_vec();
            free_c_buffer(out_ptr);
            v
        } else {
            free_c_buffer(out_ptr);
            Vec::new()
        };

        lodepng_state_cleanup(stp);
        out
    }
}

fn encode_rgba16_interlaced_png(seed: &[u8]) -> Vec<u8> {
    unsafe {
        let mut st = MaybeUninit::<LodePNGState>::zeroed();
        lodepng_state_init(st.as_mut_ptr());
        let stp = st.as_mut_ptr();

        (*stp).info_raw = lodepng_color_mode_make(6 as _, 16);
        (*stp).info_png.color = lodepng_color_mode_make(6 as _, 16);
        (*stp).info_png.interlace_method = 1;
        (*stp).encoder.auto_convert = 0;

        let w = 19u32;
        let h = 17u32;
        let mut image = vec![0u8; (w as usize).saturating_mul(h as usize).saturating_mul(8)];

        for y in 0..h {
            for x in 0..w {
                let i = ((y * w + x) as usize) * 8;
                let s0 = if seed.is_empty() {
                    (x.wrapping_mul(9) ^ y.wrapping_mul(13)) as u8
                } else {
                    seed[(i + 0) % seed.len()]
                };
                let s1 = if seed.is_empty() {
                    (x.wrapping_mul(5) + y.wrapping_mul(7)) as u8
                } else {
                    seed[(i + 1) % seed.len()]
                };
                let s2 = if seed.is_empty() {
                    (x.wrapping_mul(17) + y.wrapping_mul(3)) as u8
                } else {
                    seed[(i + 2) % seed.len()]
                };
                let s3 = if seed.is_empty() {
                    (x ^ y) as u8
                } else {
                    seed[(i + 3) % seed.len()]
                };
                let r = (((s0 as u16) << 8) | (s1 as u16)).to_be_bytes();
                let g = ((((s1 ^ 0x5a) as u16) << 8) | (s2 as u16)).to_be_bytes();
                let b = ((((s2 ^ 0xa5) as u16) << 8) | (s3 as u16)).to_be_bytes();
                let a = (((255u16.wrapping_sub(s3 as u16)) << 8) | (s0 as u16)).to_be_bytes();
                image[i..i + 2].copy_from_slice(&r);
                image[i + 2..i + 4].copy_from_slice(&g);
                image[i + 4..i + 6].copy_from_slice(&b);
                image[i + 6..i + 8].copy_from_slice(&a);
            }
        }

        let mut out_ptr: *mut c_uchar = ptr::null_mut();
        let mut out_size: size_t = 0;
        let err = lodepng_encode(
            &mut out_ptr,
            &mut out_size,
            image.as_ptr(),
            w as c_uint,
            h as c_uint,
            stp,
        );

        let out = if err == 0 && !out_ptr.is_null() {
            let v = std::slice::from_raw_parts(out_ptr, out_size as usize).to_vec();
            free_c_buffer(out_ptr);
            v
        } else {
            free_c_buffer(out_ptr);
            Vec::new()
        };

        lodepng_state_cleanup(stp);
        out
    }
}

fn temp_path(op: &str, tag: &str, data: &[u8], ext: &str) -> PathBuf {
    let mut p = std::env::temp_dir();
    p.push("lodepng_harness_fixed");
    let _ = fs::create_dir_all(&p);
    p.push(format!("{}_{}_{}{}", op, tag, checksum(data), ext));
    p
}

fn path_cstring(path: &PathBuf) -> Option<CString> {
    CString::new(path.to_string_lossy().as_bytes()).ok()
}

fn fold_error_text(mut digest: u64, code: u32) -> u64 {
    unsafe {
        let p = lodepng_error_text(code as c_uint);
        if p.is_null() {
            return fold(digest, 0);
        }
        let s = CStr::from_ptr(p).to_bytes();
        digest = fold(digest, checksum_prefix(s, 128));
        digest
    }
}

fn choose_distinct_nonempty_png_pair(
    primary1: Vec<u8>,
    primary2: Vec<u8>,
    fallback1: Vec<u8>,
    fallback2: Vec<u8>,
) -> (Vec<u8>, Vec<u8>) {
    let a = if !primary1.is_empty() {
        primary1
    } else if !fallback1.is_empty() {
        fallback1.clone()
    } else {
        fallback2.clone()
    };

    let mut b = if !primary2.is_empty() {
        primary2
    } else if !fallback2.is_empty() {
        fallback2.clone()
    } else {
        fallback1.clone()
    };

    if b.is_empty() {
        b = fallback2.clone();
    }
    if b == a {
        if !fallback1.is_empty() && fallback1 != a {
            b = fallback1;
        } else if !fallback2.is_empty() && fallback2 != a {
            b = fallback2;
        }
    }
    (a, b)
}

pub fn decode32_png(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut out_ptr: *mut c_uchar = ptr::null_mut();
            let mut w: c_uint = 0;
            let mut h: c_uint = 0;
            let err = lodepng_decode32(
                &mut out_ptr,
                &mut w,
                &mut h,
                data.as_ptr(),
                data.len() as size_t,
            );
            last_err = err as u32;

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, err as u64);

            if err == 0 {
                let size_u64 = (w as u64).wrapping_mul(h as u64).wrapping_mul(4);
                iter_digest = fold(iter_digest, w as u64);
                iter_digest = fold(iter_digest, h as u64);
                iter_digest = fold(iter_digest, size_u64);

                if !out_ptr.is_null() {
                    if let Ok(sz) = usize::try_from(size_u64) {
                        let out = std::slice::from_raw_parts(out_ptr, sz);
                        iter_digest = fold(iter_digest, checksum(out));
                        iter_digest = fold(iter_digest, lodepng_crc32(out.as_ptr(), out.len() as size_t) as u64);
                    } else {
                        iter_digest = fold(iter_digest, 0);
                        iter_digest = fold(iter_digest, 0);
                    }
                } else {
                    iter_digest = fold(iter_digest, 0);
                    iter_digest = fold(iter_digest, 0);
                }
            } else {
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
            }

            iter_digest = fold_error_text(iter_digest, err as u32);
            free_c_buffer(out_ptr);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=decode32_png err={} digest={:016x}", last_err, digest)
}

pub fn decode24_png(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut out_ptr: *mut c_uchar = ptr::null_mut();
            let mut w: c_uint = 0;
