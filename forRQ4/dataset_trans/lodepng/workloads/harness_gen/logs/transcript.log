                let iend = b"IEND\0";
                let text = b"tEXt\0";

                let p_idat = lodepng_chunk_find_const(cur, end, idat.as_ptr() as *const c_char);
                iter_digest = fold(iter_digest, (!p_idat.is_null()) as u64);
                if !p_idat.is_null() {
                    iter_digest = fold(
                        iter_digest,
                        (p_idat as usize).wrapping_sub(base as usize) as u64,
                    );
                }

                let p_iend = lodepng_chunk_find_const(cur, end, iend.as_ptr() as *const c_char);
                iter_digest = fold(iter_digest, (!p_iend.is_null()) as u64);

                let p_text = lodepng_chunk_find_const(cur, end, text.as_ptr() as *const c_char);
                iter_digest = fold(iter_digest, (!p_text.is_null()) as u64);

                let mut owned = data.to_vec();
                let mbase = owned.as_mut_ptr();
                let mend = mbase.add(owned.len());
                let mcur = mbase.add(8);

                let mp = lodepng_chunk_find(mcur, mend, idat.as_ptr() as *const c_char);
                iter_digest = fold(iter_digest, (!mp.is_null()) as u64);
                if !mp.is_null() {
                    let d = lodepng_chunk_data(mp);
                    iter_digest = fold(iter_digest, (!d.is_null()) as u64);
                    let mn = lodepng_chunk_next(mp, mend);
                    iter_digest = fold(iter_digest, (!mn.is_null()) as u64);
                    if !mn.is_null() && mn >= mbase && mn <= mend {
                        iter_digest =
                            fold(iter_digest, (mn as usize).wrapping_sub(mbase as usize) as u64);
                    }
                }

                while !cur.is_null() && cur < end && steps < data.len() {
                    let remaining = (end as usize).wrapping_sub(cur as usize);
                    if remaining < 12 {
                        break;
                    }

                    let off = (cur as usize).wrapping_sub(base as usize);
                    let chk_err = lodepng_inspect_chunk(
                        state.as_mut_ptr(),
                        off as size_t,
                        base,
                        data.len() as size_t,
                    );
                    iter_digest = fold(iter_digest, chk_err as u64);

                    let len = lodepng_chunk_length(cur) as usize;
                    let total = match len.checked_add(12) {
                        Some(v) => v,
                        None => break,
                    };
                    if total > remaining {
                        break;
                    }

                    let mut tbuf = [0i8; 5];
                    lodepng_chunk_type(tbuf.as_mut_ptr(), cur);

                    iter_digest = fold(iter_digest, off as u64);
                    iter_digest = fold(iter_digest, len as u64);
                    for &ch in &tbuf[..4] {
                        iter_digest = fold(iter_digest, ch as u8 as u64);
                    }

                    let is_idat =
                        lodepng_chunk_type_equals(cur, idat.as_ptr() as *const c_char) as u64;
                    let is_iend =
                        lodepng_chunk_type_equals(cur, iend.as_ptr() as *const c_char) as u64;
                    iter_digest = fold(iter_digest, is_idat);
                    iter_digest = fold(iter_digest, is_iend);

                    iter_digest = fold(iter_digest, lodepng_chunk_ancillary(cur) as u64);
                    iter_digest = fold(iter_digest, lodepng_chunk_private(cur) as u64);
                    iter_digest = fold(iter_digest, lodepng_chunk_safetocopy(cur) as u64);
                    iter_digest = fold(iter_digest, lodepng_chunk_check_crc(cur) as u64);

                    let dptr = lodepng_chunk_data_const(cur);
                    if !dptr.is_null() && len > 0 {
                        let ds = std::slice::from_raw_parts(dptr, len);
                        iter_digest = fold(iter_digest, checksum_prefix(ds, 32));
                    } else {
                        iter_digest = fold(iter_digest, 0);
                    }

                    let next = lodepng_chunk_next_const(cur, end);
                    if next.is_null() {
                        iter_digest = fold(iter_digest, 0);
                        break;
                    } else {
                        let next_off = (next as usize).wrapping_sub(base as usize) as u64;
                        iter_digest = fold(iter_digest, next_off);
                    }

                    if next <= cur || next > end {
                        break;
                    }
                    cur = next;
                    steps += 1;
                }
            }

            iter_digest = fold_error_text(iter_digest, err as u32);
            lodepng_state_cleanup(state.as_mut_ptr());
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=inspect_png err={} digest={:016x}", last_err, digest)
}

pub fn zlib_decompress(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut settings = MaybeUninit::<LodePNGDecompressSettings>::zeroed();
            lodepng_decompress_settings_init(settings.as_mut_ptr());

            let mut out_ptr: *mut c_uchar = ptr::null_mut();
            let mut out_size: size_t = 0;
            let err = lodepng_zlib_decompress(
                &mut out_ptr,
                &mut out_size,
                data.as_ptr(),
                data.len() as size_t,
                settings.as_ptr(),
            );
            last_err = err as u32;

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, err as u64);

            if err == 0 && !out_ptr.is_null() {
                let out = std::slice::from_raw_parts(out_ptr, out_size as usize);
                iter_digest = fold(iter_digest, out_size as u64);
                iter_digest = fold(iter_digest, checksum(out));
            } else {
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
            }

            iter_digest = fold_error_text(iter_digest, err as u32);
            free_c_buffer(out_ptr);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=zlib_decompress err={} digest={:016x}", last_err, digest)
}

pub fn raw_deflate_inflate(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut csettings = MaybeUninit::<LodePNGCompressSettings>::zeroed();
            lodepng_compress_settings_init(csettings.as_mut_ptr());

            let mut dsettings = MaybeUninit::<LodePNGDecompressSettings>::zeroed();
            lodepng_decompress_settings_init(dsettings.as_mut_ptr());

            let mut def_ptr: *mut c_uchar = ptr::null_mut();
            let mut def_size: size_t = 0;
            let def_err = lodepng_deflate(
                &mut def_ptr,
                &mut def_size,
                data.as_ptr(),
                data.len() as size_t,
                csettings.as_ptr(),
            );

            let mut iter_digest = 0u64;
            iter_digest = fold(iter_digest, def_err as u64);

            if def_err == 0 && !def_ptr.is_null() {
                let deflated = std::slice::from_raw_parts(def_ptr, def_size as usize);
                iter_digest = fold(iter_digest, def_size as u64);
                iter_digest = fold(iter_digest, checksum_prefix(deflated, 128));

                let mut out_ptr: *mut c_uchar = ptr::null_mut();
                let mut out_size: size_t = 0;
                let inf_err = lodepng_inflate(
                    &mut out_ptr,
                    &mut out_size,
                    def_ptr,
                    def_size,
                    dsettings.as_ptr(),
                );
                last_err = inf_err as u32;
                iter_digest = fold(iter_digest, inf_err as u64);
                if inf_err == 0 && !out_ptr.is_null() {
                    let out = std::slice::from_raw_parts(out_ptr, out_size as usize);
                    iter_digest = fold(iter_digest, out_size as u64);
                    iter_digest = fold(iter_digest, checksum(out));
                } else {
                    iter_digest = fold(iter_digest, 0);
                    iter_digest = fold(iter_digest, 0);
                }
                iter_digest = fold_error_text(iter_digest, inf_err as u32);
                free_c_buffer(out_ptr);
            } else {
                last_err = def_err as u32;
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold_error_text(iter_digest, def_err as u32);
            }

            free_c_buffer(def_ptr);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=raw_deflate_inflate err={} digest={:016x}", last_err, digest)
}

pub fn encode_png(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;
            let err: u32;

            if let Some((w, h, rgba)) = parse_raw_rgba(data) {
                let rgb = rgb_from_rgba(rgba);

                let mut out32_ptr: *mut c_uchar = ptr::null_mut();
                let mut out32_size: size_t = 0;
                let err32 = lodepng_encode32(
                    &mut out32_ptr,
                    &mut out32_size,
                    rgba.as_ptr(),
                    w as c_uint,
                    h as c_uint,
                ) as u32;

                iter_digest = fold(iter_digest, err32 as u64);
                if err32 == 0 && !out32_ptr.is_null() {
                    let out = std::slice::from_raw_parts(out32_ptr, out32_size as usize);
                    iter_digest = fold(iter_digest, out32_size as u64);
                    iter_digest = fold(iter_digest, checksum(out));
                } else {
                    iter_digest = fold(iter_digest, 0);
                    iter_digest = fold(iter_digest, 0);
                }
                free_c_buffer(out32_ptr);

                let mut out24_ptr: *mut c_uchar = ptr::null_mut();
                let mut out24_size: size_t = 0;
                let err24 = lodepng_encode24(
                    &mut out24_ptr,
                    &mut out24_size,
                    rgb.as_ptr(),
                    w as c_uint,
                    h as c_uint,
                ) as u32;

                iter_digest = fold(iter_digest, err24 as u64);
                if err24 == 0 && !out24_ptr.is_null() {
                    let out = std::slice::from_raw_parts(out24_ptr, out24_size as usize);
                    iter_digest = fold(iter_digest, out24_size as u64);
                    iter_digest = fold(iter_digest, checksum_prefix(out, 256));
                } else {
                    iter_digest = fold(iter_digest, 0);
                    iter_digest = fold(iter_digest, 0);
                }
                free_c_buffer(out24_ptr);

                err = err32 ^ err24;
            } else {
                err = 0xE000;
                iter_digest = fold(iter_digest, err as u64);
                iter_digest = fold(iter_digest, checksum_prefix(data, 64));
            }

            last_err = err;
            iter_digest = fold_error_text(iter_digest, err);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=encode_png err={} digest={:016x}", last_err, digest)
}

pub fn color_convert(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            if let Some((w, h, rgba)) = parse_raw_rgba(data) {
                let rgba_mode = lodepng_color_mode_make(6 as _, 8);
                let rgb_mode = lodepng_color_mode_make(2 as _, 8);

                let mut rgb_out =
                    vec![0u8; (w as usize).saturating_mul(h as usize).saturating_mul(3)];
                let conv_err = lodepng_convert(
                    rgb_out.as_mut_ptr(),
                    rgba.as_ptr(),
                    &rgb_mode,
                    &rgba_mode,
                    w as c_uint,
                    h as c_uint,
                ) as u32;
                last_err = conv_err;
                iter_digest = fold(iter_digest, conv_err as u64);
                iter_digest = fold(iter_digest, checksum(&rgb_out));

                let mut r = 0u32;
                let mut g = 0u32;
                let mut b = 0u32;
                let cr_err = lodepng_convert_rgb(
                    &mut r,
                    &mut g,
                    &mut b,
                    rgba.get(0).copied().unwrap_or(0) as u32,
                    rgba.get(1).copied().unwrap_or(0) as u32,
                    rgba.get(2).copied().unwrap_or(0) as u32,
                    &rgb_mode,
                    &rgba_mode,
                ) as u32;
                iter_digest = fold(iter_digest, cr_err as u64);
                iter_digest = fold(iter_digest, r as u64);
                iter_digest = fold(iter_digest, g as u64);
                iter_digest = fold(iter_digest, b as u64);

                iter_digest = fold(iter_digest, lodepng_get_channels(&rgba_mode) as u64);
                iter_digest = fold(iter_digest, lodepng_get_channels(&rgb_mode) as u64);

                let mut pal_a = MaybeUninit::<LodePNGColorMode>::zeroed();
                let mut pal_b = MaybeUninit::<LodePNGColorMode>::zeroed();
                lodepng_color_mode_init(pal_a.as_mut_ptr());
                lodepng_color_mode_init(pal_b.as_mut_ptr());
                let pa = pal_a.as_mut_ptr();
                let pb = pal_b.as_mut_ptr();

                (*pa).colortype = 3 as _;
                (*pa).bitdepth = 8;
                let _ = lodepng_palette_add(pa, 255, 0, 0, 255);
                let _ = lodepng_palette_add(pa, 0, 255, 0, 128);
                let _ = lodepng_palette_add(pa, 0, 0, 255, 255);
                let copy_err = lodepng_color_mode_copy(pb, pa) as u32;

                iter_digest = fold(iter_digest, copy_err as u64);
                iter_digest = fold(iter_digest, lodepng_is_palette_type(pa) as u64);
                iter_digest = fold(iter_digest, lodepng_has_palette_alpha(pa) as u64);
                iter_digest = fold(iter_digest, lodepng_get_channels(pa) as u64);
                iter_digest = fold(iter_digest, lodepng_is_palette_type(pb) as u64);
                iter_digest = fold(iter_digest, lodepng_has_palette_alpha(pb) as u64);

                lodepng_color_mode_cleanup(pa);
                lodepng_color_mode_cleanup(pb);

                iter_digest = fold_error_text(iter_digest, conv_err);
            } else {
                last_err = 0xE100;
                iter_digest = fold(iter_digest, last_err as u64);
                iter_digest = fold(iter_digest, checksum_prefix(data, 64));
                iter_digest = fold_error_text(iter_digest, last_err);
            }

            digest = fold(digest, iter_digest);
        }
    }

    format!("op=color_convert err={} digest={:016x}", last_err, digest)
}

pub fn chunk_ops(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;
            let mut err = 0u32;

            let payload_len = data.len().min(31);
            let ctype = b"vpAg\0";

            let mut chunk_ptr: *mut c_uchar = ptr::null_mut();
            let mut chunk_size: size_t = 0;
            let create_err = lodepng_chunk_create(
                &mut chunk_ptr,
                &mut chunk_size,
                payload_len as size_t,
                ctype.as_ptr() as *const c_char,
                data.as_ptr(),
            ) as u32;
            iter_digest = fold(iter_digest, create_err as u64);

            if create_err == 0 && !chunk_ptr.is_null() {
                lodepng_chunk_generate_crc(chunk_ptr);
                iter_digest = fold(iter_digest, lodepng_chunk_check_crc(chunk_ptr) as u64);
                iter_digest = fold(iter_digest, lodepng_chunk_length(chunk_ptr) as u64);
                let dp = lodepng_chunk_data(chunk_ptr);
                if !dp.is_null() && payload_len > 0 {
                    let ds = std::slice::from_raw_parts(dp, payload_len);
                    iter_digest = fold(iter_digest, checksum(ds));
                } else {
                    iter_digest = fold(iter_digest, 0);
                }

                let mut out_ptr: *mut c_uchar = ptr::null_mut();
                let mut out_size: size_t = 0;
                let append_err =
                    lodepng_chunk_append(&mut out_ptr, &mut out_size, chunk_ptr) as u32;
                iter_digest = fold(iter_digest, append_err as u64);

                if append_err == 0 && !out_ptr.is_null() {
                    let end = out_ptr.add(out_size as usize);
                    let found = lodepng_chunk_find(out_ptr, end, ctype.as_ptr() as *const c_char);
                    iter_digest = fold(iter_digest, (!found.is_null()) as u64);
                    if !found.is_null() {
                        iter_digest = fold(
                            iter_digest,
                            (found as usize).wrapping_sub(out_ptr as usize) as u64,
                        );
                        let next = lodepng_chunk_next(found, end);
                        iter_digest = fold(iter_digest, (!next.is_null()) as u64);
                        if !next.is_null() && next >= out_ptr && next <= end {
                            iter_digest = fold(
                                iter_digest,
                                (next as usize).wrapping_sub(out_ptr as usize) as u64,
                            );
                        }
                    }
                    let out = std::slice::from_raw_parts(out_ptr, out_size as usize);
                    iter_digest = fold(iter_digest, checksum(out));
                } else {
                    err = append_err;
                }

                free_c_buffer(out_ptr);
            } else {
                err = create_err;
            }

            free_c_buffer(chunk_ptr);
            last_err = err;
            iter_digest = fold_error_text(iter_digest, err);
            digest = fold(digest, iter_digest);
        }
    }

    format!("op=chunk_ops err={} digest={:016x}", last_err, digest)
}

pub fn file_codec(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            if let Some((w, h, rgba)) = parse_raw_rgba(data) {
                let rgb = rgb_from_rgba(rgba);
                let png = encode_png_bytes(rgba, w, h);
                let path_mem = temp_path("file_codec", "mem", data, ".png");
                let path_32 = temp_path("file_codec", "e32", data, ".png");
                let path_24 = temp_path("file_codec", "e24", data, ".png");
                let path_any = temp_path("file_codec", "eany", data, ".png");

                let c_mem = path_cstring(&path_mem);
                let c32 = path_cstring(&path_32);
                let c24 = path_cstring(&path_24);
                let c_any = path_cstring(&path_any);

                if let (Some(c_mem), Some(c32), Some(c24), Some(c_any)) =
                    (c_mem, c32, c24, c_any)
                {
                    let save_err =
                        lodepng_save_file(png.as_ptr(), png.len() as size_t, c_mem.as_ptr()) as u32;
                    iter_digest = fold(iter_digest, save_err as u64);

                    let e32 =
                        lodepng_encode32_file(c32.as_ptr(), rgba.as_ptr(), w as c_uint, h as c_uint)
                            as u32;
                    let e24 =
                        lodepng_encode24_file(c24.as_ptr(), rgb.as_ptr(), w as c_uint, h as c_uint)
                            as u32;
                    let eany = lodepng_encode_file(
                        c_any.as_ptr(),
                        rgb.as_ptr(),
                        w as c_uint,
                        h as c_uint,
                        2 as _,
                        8,
                    ) as u32;
                    iter_digest = fold(iter_digest, e32 as u64);
                    iter_digest = fold(iter_digest, e24 as u64);
                    iter_digest = fold(iter_digest, eany as u64);

                    let mut load_ptr: *mut c_uchar = ptr::null_mut();
                    let mut load_size: size_t = 0;
                    let load_err =
                        lodepng_load_file(&mut load_ptr, &mut load_size, c_mem.as_ptr()) as u32;
                    iter_digest = fold(iter_digest, load_err as u64);
                    if load_err == 0 && !load_ptr.is_null() {
                        let loaded = std::slice::from_raw_parts(load_ptr, load_size as usize);
                        iter_digest = fold(iter_digest, load_size as u64);
                        iter_digest = fold(iter_digest, checksum(loaded));
                    } else {
                        iter_digest = fold(iter_digest, 0);
                        iter_digest = fold(iter_digest, 0);
                    }
                    free_c_buffer(load_ptr);

                    let mut out_ptr: *mut c_uchar = ptr::null_mut();
                    let mut dw = 0u32;
                    let mut dh = 0u32;

                    let d32 =
                        lodepng_decode32_file(&mut out_ptr, &mut dw, &mut dh, c32.as_ptr()) as u32;
                    iter_digest = fold(iter_digest, d32 as u64);
                    iter_digest = fold(iter_digest, dw as u64);
                    iter_digest = fold(iter_digest, dh as u64);
                    free_c_buffer(out_ptr);

                    out_ptr = ptr::null_mut();
                    dw = 0;
                    dh = 0;
                    let d24 =
                        lodepng_decode24_file(&mut out_ptr, &mut dw, &mut dh, c24.as_ptr()) as u32;
                    iter_digest = fold(iter_digest, d24 as u64);
                    iter_digest = fold(iter_digest, dw as u64);
                    iter_digest = fold(iter_digest, dh as u64);
                    free_c_buffer(out_ptr);

                    out_ptr = ptr::null_mut();
                    dw = 0;
                    dh = 0;
                    let dany =
                        lodepng_decode_file(&mut out_ptr, &mut dw, &mut dh, c_any.as_ptr(), 6 as _, 8)
                            as u32;
                    iter_digest = fold(iter_digest, dany as u64);
                    iter_digest = fold(iter_digest, dw as u64);
                    iter_digest = fold(iter_digest, dh as u64);
                    if dany == 0 && !out_ptr.is_null() {
                        let out = std::slice::from_raw_parts(
                            out_ptr,
                            (dw as usize).saturating_mul(dh as usize).saturating_mul(4),
                        );
                        iter_digest = fold(iter_digest, checksum_prefix(out, 256));
                    } else {
                        iter_digest = fold(iter_digest, 0);
                    }
                    free_c_buffer(out_ptr);

                    last_err = save_err ^ e32 ^ e24 ^ eany ^ load_err ^ d32 ^ d24 ^ dany;
                    iter_digest = fold_error_text(iter_digest, last_err);
                } else {
                    last_err = 0xE201;
                    iter_digest = fold(iter_digest, last_err as u64);
                }
            } else {
                last_err = 0xE200;
                iter_digest = fold(iter_digest, last_err as u64);
                iter_digest = fold(iter_digest, checksum_prefix(data, 64));
            }

            digest = fold(digest, iter_digest);
        }
    }

    format!("op=file_codec err={} digest={:016x}", last_err, digest)
}

pub fn stateful_palette_encode(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0u32;

    for _ in 0..iters {
        unsafe {
            let mut iter_digest = 0u64;

            let mut src = MaybeUninit::<LodePNGState>::zeroed();
            let mut dst = MaybeUninit::<LodePNGState>::zeroed();
            lodepng_state_init(src.as_mut_ptr());
            lodepng_state_init(dst.as_mut_ptr());
            let sp = src.as_mut_ptr();
            let dp = dst.as_mut_ptr();

            (*sp).info_raw = lodepng_color_mode_make(3 as _, 8);
            (*sp).info_png.color = lodepng_color_mode_make(3 as _, 8);
            (*sp).info_png.interlace_method = 1;
            (*sp).encoder.auto_convert = 0;
            (*sp).encoder.force_palette = 1;
            (*sp).encoder.text_compression = 1;

            for i in 0..16u8 {
                let srcb = if data.is_empty() {
                    i
                } else {
                    data[(i as usize) % data.len()]
                };
                let r = srcb.wrapping_mul(13).wrapping_add(i);
                let g = srcb.wrapping_mul(7).wrapping_add(41);
                let b = srcb.wrapping_mul(19).wrapping_add(3);
                let a = if srcb & 1 == 0 { 255 } else { 80 };
                let _ = lodepng_palette_add(&mut (*sp).info_raw, r, g, b, a);
                let _ = lodepng_palette_add(&mut (*sp).info_png.color, r, g, b, a);
            }

            let key = b"Author\0";
            let val = b"harness\0";
            let ikey = b"Note\0";
            let ilang = b"en\0";
            let itr = b"note\0";
            let ival = b"palette+interlace+metadata\0";
            let _ = lodepng_add_text(
                &mut (*sp).info_png,
                key.as_ptr() as *const c_char,
                val.as_ptr() as *const c_char,
            );
            let _ = lodepng_add_itext(
                &mut (*sp).info_png,
                ikey.as_ptr() as *const c_char,
                ilang.as_ptr() as *const c_char,
                itr.as_ptr() as *const c_char,
                ival.as_ptr() as *const c_char,
            );

            let icc_name = b"sRGB\0";
            let icc_profile: [u8; 25] = *b"FakeICCProfileData1234567";
            let exif_blob: [u8; 20] = [
                0x4d, 0x4d, 0x00, 0x2a, 0, 0, 0, 8, 0, 1, 0x01, 0x12, 0, 3, 0, 0, 0, 1, 0, 2,
            ];
            let icc_err = lodepng_set_icc(
                &mut (*sp).info_png,
                icc_name.as_ptr() as *const c_char,
                icc_profile.as_ptr(),
                icc_profile.len() as c_uint,
            ) as u32;
            let exif_err =
                lodepng_set_exif(&mut (*sp).info_png, exif_blob.as_ptr(), exif_blob.len() as c_uint)
                    as u32;
            iter_digest = fold(iter_digest, icc_err as u64);
            iter_digest = fold(iter_digest, exif_err as u64);

            let copy_err = lodepng_state_copy(dp, sp) as u32;
            iter_digest = fold(iter_digest, copy_err as u64);

            let mut info_copy = MaybeUninit::<LodePNGInfo>::zeroed();
            lodepng_info_init(info_copy.as_mut_ptr());
            let icopy_err = lodepng_info_copy(info_copy.as_mut_ptr(), &(*sp).info_png) as u32;
            iter_digest = fold(iter_digest, icopy_err as u64);
            lodepng_clear_text(info_copy.as_mut_ptr());
            lodepng_clear_itext(info_copy.as_mut_ptr());
            lodepng_info_cleanup(info_copy.as_mut_ptr());

            iter_digest = fold(iter_digest, lodepng_is_palette_type(&(*sp).info_png.color) as u64);
            iter_digest = fold(iter_digest, lodepng_has_palette_alpha(&(*sp).info_png.color) as u64);
            iter_digest = fold(iter_digest, lodepng_get_channels(&(*sp).info_png.color) as u64);

            let w = 64u32;
            let h = 64u32;
            let mut image = vec![0u8; (w * h) as usize];
            for (i, px) in image.iter_mut().enumerate() {
                let b = if data.is_empty() { i as u8 } else { data[i % data.len()] };
                *px = b & 15;
            }

            let mut out_ptr: *mut c_uchar = ptr::null_mut();
            let mut out_size: size_t = 0;
            let enc_err = lodepng_encode(
                &mut out_ptr,
                &mut out_size,
                image.as_ptr(),
                w as c_uint,
                h as c_uint,
                dp,
            ) as u32;
            last_err = enc_err;
            iter_digest = fold(iter_digest, enc_err as u64);

            if enc_err == 0 && !out_ptr.is_null() {
                let out = std::slice::from_raw_parts(out_ptr, out_size as usize);
                iter_digest = fold(iter_digest, out_size as u64);
                iter_digest = fold(iter_digest, checksum(out));

                let mut dec_ptr: *mut c_uchar = ptr::null_mut();
                let mut dw = 0u32;
                let mut dh = 0u32;
                let dec_err =
                    lodepng_decode32(&mut dec_ptr, &mut dw, &mut dh, out_ptr, out_size) as u32;
                iter_digest = fold(iter_digest, dec_err as u64);
                iter_digest = fold(iter_digest, dw as u64);
                iter_digest = fold(iter_digest, dh as u64);
                free_c_buffer(dec_ptr);
            } else {
                iter_digest = fold(iter_digest, 0);
                iter_digest = fold(iter_digest, 0);
            }

            iter_digest = fold_error_text(iter_digest, enc_err);

            free_c_buffer(out_ptr);
            lodepng_state_cleanup(dp);
            lodepng_state_cleanup(sp);

            digest = fold(digest, iter_digest);
        }
    }

    format!(
        "op=stateful_palette_encode err={} digest={:016x}",
        last_err, digest
    )
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("decode32_png", decode32_png as fn(&[u8], u64) -> String),
        ("decode24_png", decode24_png as fn(&[u8], u64) -> String),
        ("inspect_png", inspect_png as fn(&[u8], u64) -> String),
        ("zlib_decompress", zlib_decompress as fn(&[u8], u64) -> String),
        (
            "raw_deflate_inflate",
            raw_deflate_inflate as fn(&[u8], u64) -> String,
        ),
        ("encode_png", encode_png as fn(&[u8], u64) -> String),
        ("color_convert", color_convert as fn(&[u8], u64) -> String),
        ("chunk_ops", chunk_ops as fn(&[u8], u64) -> String),
        ("file_codec", file_codec as fn(&[u8], u64) -> String),
        (
            "stateful_palette_encode",
            stateful_palette_encode as fn(&[u8], u64) -> String,
        ),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let img1 = rgba_pattern_a(64, 48);
    let img2 = rgba_pattern_b(73, 55);

    let png1 = encode_png_bytes(&img1, 64, 48);
    let png2 = encode_png_bytes(&img2, 73, 55);
    let rich1 = encode_palette_png_with_features(&img1);
    let rich2 = encode_palette_png_with_features(&img2);

    for (op, idx, bytes) in [
        ("decode32_png", 1usize, &png1),
        ("decode32_png", 2usize, &rich2),
        ("decode24_png", 1usize, &png2),
        ("decode24_png", 2usize, &rich1),
        ("inspect_png", 1usize, &rich1),
        ("inspect_png", 2usize, &rich2),
    ] {
        let path = format!("{}/{}.{}.bin", dir, op, idx);
        let _ = fs::write(&path, bytes);
        lines.push(format!("seed {} {}", op, path));
    }

    let plain1 = synth_plaintext_a(24 * 1024);
    let plain2 = synth_plaintext_b(28 * 1024);
    let z1 = compress_zlib_bytes(&plain1);
    let z2 = compress_zlib_bytes(&plain2);

    for (idx, bytes) in [(1usize, &z1), (2usize, &z2)] {
        let path = format!("{}/zlib_decompress.{}.bin", dir, idx);
        let _ = fs::write(&path, bytes);
        lines.push(format!("seed zlib_decompress {}", path));
    }

    for (idx, bytes) in [(1usize, &plain1), (2usize, &plain2)] {
        let path = format!("{}/raw_deflate_inflate.{}.bin", dir, idx);
        let _ = fs::write(&path, bytes);
        lines.push(format!("seed raw_deflate_inflate {}", path));
    }

    let raw1 = raw_container(40, 30, &rgba_pattern_a(40, 30));
    let raw2 = raw_container(57, 41, &rgba_pattern_b(57, 41));
    for op in ["encode_png", "color_convert", "file_codec"] {
        for (idx, bytes) in [(1usize, &raw1), (2usize, &raw2)] {
            let path = format!("{}/{}.{}.bin", dir, op, idx);
            let _ = fs::write(&path, bytes);
            lines.push(format!("seed {} {}", op, path));
        }
    }

    let chunk1 = png1.clone();
    let chunk2 = rich2.clone();
    for (idx, bytes) in [(1usize, &chunk1), (2usize, &chunk2)] {
        let path = format!("{}/chunk_ops.{}.bin", dir, idx);
        let _ = fs::write(&path, bytes);
        lines.push(format!("seed chunk_ops {}", path));
    }

    let sp1 = synth_plaintext_a(1024);
    let sp2 = synth_plaintext_b(1536);
    for (idx, bytes) in [(1usize, &sp1), (2usize, &sp2)] {
        let path = format!("{}/stateful_palette_encode.{}.bin", dir, idx);
        let _ = fs::write(&path, bytes);
        lines.push(format!("seed stateful_palette_encode {}", path));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let w = 2048u32;
    let h = 2048u32;
    let big_rgba = rgba_pattern_b(w, h);

    let big_png = encode_png_bytes(&big_rgba, w, h);
    let big_rich_png = encode_palette_png_with_features(&big_rgba);

    for (op, bytes) in [
        ("decode32_png", &big_png),
        ("decode24_png", &big_rich_png),
        ("inspect_png", &big_rich_png),
    ] {
        let path = format!("{}/{}.perf.bin", dir, op);
        let _ = fs::write(&path, bytes);
        lines.push(format!("perf {} {}", op, path));
    }

    let big_raw = raw_container(w, h, &big_rgba);
    for op in ["encode_png", "color_convert", "file_codec"] {
        let path = format!("{}/{}.perf.bin", dir, op);
        let _ = fs::write(&path, &big_raw);
        lines.push(format!("perf {} {}", op, path));
    }

    let big_plain = synth_plaintext_b(8 * 1024 * 1024);
    let big_z = compress_zlib_bytes(&big_plain);

    let path = format!("{}/zlib_decompress.perf.bin", dir);
    let _ = fs::write(&path, &big_z);
    lines.push(format!("perf zlib_decompress {}", path));

    let path = format!("{}/raw_deflate_inflate.perf.bin", dir);
    let _ = fs::write(&path, &big_plain);
    lines.push(format!("perf raw_deflate_inflate {}", path));

    let stateful_seed = synth_plaintext_b(2 * 1024 * 1024);
    let path = format!("{}/stateful_palette_encode.perf.bin", dir);
    let _ = fs::write(&path, &stateful_seed);
    lines.push(format!("perf stateful_palette_encode {}", path));

    lines
}
