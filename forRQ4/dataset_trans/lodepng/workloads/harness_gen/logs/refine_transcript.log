            iter_digest = fold(iter_digest, h as u64);

            if err == 0 && !out_ptr.is_null() {
                let size_u64 = (w as u64).wrapping_mul(h as u64).wrapping_mul(3);
                if let Ok(sz) = usize::try_from(size_u64) {
                    let out = std::slice::from_raw_parts(out_ptr, sz);
                    iter_digest = fold(iter_digest, size_u64);
