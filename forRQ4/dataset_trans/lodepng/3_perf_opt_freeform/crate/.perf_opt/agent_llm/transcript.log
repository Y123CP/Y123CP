                            && b as c_int == stats_ref.key_b as c_int) as c_int as c_uint;

                    if a as c_int != 255 && (a as c_int != 0 || (stats_ref.key != 0 && matchkey == 0)) {
                        stats_ref.alpha = 1;
                        stats_ref.key = 0;
                        alpha_done = 1;
                        if stats_ref.bits < 8 {
                            stats_ref.bits = 8;
                        }
                    } else if a as c_int == 0 && stats_ref.alpha == 0 && stats_ref.key == 0 {
                        stats_ref.key = 1;
                        stats_ref.key_r = r as c_ushort;
                        stats_ref.key_g = g as c_ushort;
                        stats_ref.key_b = b as c_ushort;
                    } else if a as c_int == 255 && stats_ref.key != 0 && matchkey != 0 {
                        stats_ref.alpha = 1;
                        stats_ref.key = 0;
                        alpha_done = 1;
                        if stats_ref.bits < 8 {
                            stats_ref.bits = 8;
                        }
                    }
                }

                if numcolors_done == 0 && color_tree_has(&raw mut tree, r, g, b, a) == 0 {
                    error = color_tree_add(&raw mut tree, r, g, b, a, stats_ref.numcolors);
                    if error != 0 {
                        color_tree_cleanup(&raw mut tree);
                        return error;
                    }

                    if stats_ref.numcolors < 256 {
                        let n = stats_ref.numcolors as usize;
                        let base = n * 4;
                        unsafe {
                            // SAFETY: numcolors < 256, so base..base+3 is within the 1024-byte palette buffer.
                            *palette_ptr.add(base + 0) = r;
                            *palette_ptr.add(base + 1) = g;
                            *palette_ptr.add(base + 2) = b;
                            *palette_ptr.add(base + 3) = a;
                        }
                    }

                    stats_ref.numcolors = stats_ref.numcolors.wrapping_add(1);
                    numcolors_done = (stats_ref.numcolors >= maxnumcolors) as c_int as c_uint;
                }

                if alpha_done != 0 && numcolors_done != 0 && colored_done != 0 && bits_done != 0 {
                    break;
                }
            }

            i = i.wrapping_add(1);
        }

        if stats_ref.key != 0 && stats_ref.alpha == 0 {
            let mut i2: size_t = 0;
            while i2 != numpixels {
                getPixelColorRGBA8(&raw mut r, &raw mut g, &raw mut b, &raw mut a, in_0, i2, mode_in);
                if a as c_int != 0
                    && r as c_int == stats_ref.key_r as c_int
                    && g as c_int == stats_ref.key_g as c_int
                    && b as c_int == stats_ref.key_b as c_int
                {
                    stats_ref.alpha = 1;
                    stats_ref.key = 0;
                    alpha_done = 1;
                    if stats_ref.bits < 8 {
                        stats_ref.bits = 8;
                    }
                }
                i2 = i2.wrapping_add(1);
            }
        }

        stats_ref.key_r = (stats_ref.key_r as c_int + ((stats_ref.key_r as c_int) << 8)) as c_ushort;
        stats_ref.key_g = (stats_ref.key_g as c_int + ((stats_ref.key_g as c_int) << 8)) as c_ushort;
        stats_ref.key_b = (stats_ref.key_b as c_int + ((stats_ref.key_b as c_int) << 8)) as c_ushort;
    }

    color_tree_cleanup(&raw mut tree);
    error
}
