          "replacement_function_source": "unsafe fn huffmanDecodeSymbol(\n    mut reader: *mut LodePNGBitReader,\n    mut codetree: *const HuffmanTree,\n) -> c_uint {\n    // SAFETY: caller provides valid pointers as required by the original function.\n    let tree = unsafe { &*codetree };\n\n    let code = peekBits(reader, FIRSTBITS as size_t) as usize;\n    let table_len = tree.table_len;\n    let table_value = tree.table_value;\n\n    // SAFETY: `code` is produced exactly as in the original function and indexes the same table.\n    let l = unsafe { *table_len.add(code) } as c_uint;\n    // SAFETY: `code` is produced exactly as in the original function and indexes the same table.\n    let value = unsafe { *table_value.add(code) } as usize;\n\n    if l <= FIRSTBITS {\n        advanceBits(reader, l as size_t);\n        value as c_uint\n    } else {\n        advanceBits(reader, FIRSTBITS as size_t);\n        let idx = value\n            .wrapping_add(peekBits(reader, (l.wrapping_sub(FIRSTBITS)) as size_t) as usize);\n        // SAFETY: `idx` is computed exactly as in the original function and indexes the same table.\n        let len2 = unsafe { *table_len.add(idx) } as c_uint;\n        advanceBits(reader, len2.wrapping_sub(FIRSTBITS) as size_t);\n        // SAFETY: `idx` is computed exactly as in the original function and indexes the same table.\n        unsafe { *table_value.add(idx) as c_uint }\n    }\n}",
