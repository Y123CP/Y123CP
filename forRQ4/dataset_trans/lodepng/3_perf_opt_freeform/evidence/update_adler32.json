    "rust_source": "unsafe fn update_adler32(\n    mut adler: c_uint,\n    mut data: *const c_uchar,\n    mut len: c_uint,\n) -> c_uint {\n    let mut s1: c_uint = adler & 0xffff as c_uint;\n    let mut s2: c_uint =\n        adler >> 16 as c_uint & 0xffff as c_uint;\n    while len != 0 as c_uint {\n        let mut i: c_uint = 0;\n        let mut amount: c_uint = if len > 5552 as c_uint {\n            5552 as c_uint\n        } else {\n            len\n        };\n        len = len.wrapping_sub(amount);\n        i = 0 as c_uint;\n        while i != amount {\n            let fresh35 = data;\n            data = data.offset(1);\n            s1 = s1.wrapping_add(*fresh35 as c_uint);\n            s2 = s2.wrapping_add(s1);\n            i = i.wrapping_add(1);\n        }\n        s1 = s1.wrapping_rem(65521 as c_uint);\n        s2 = s2.wrapping_rem(65521 as c_uint);\n    }\n    return s2 << 16 as c_uint | s1;\n}",
