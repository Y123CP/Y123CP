          "replacement_region_source": "let mut r: c_uint = 0xffffffff as c_uint;\n// SAFETY: `length` is the explicit L1 length parameter, used immutably to\n// define the full readable byte range for this region; callers of this unsafe\n// function must provide a non-null `data` pointer valid for `length` bytes;\n// this creates only an immutable slice, so no mutable aliasing is introduced.\nlet bytes = unsafe { core::slice::from_raw_parts(data, length as usize) };\nlet mut chunks = bytes.chunks_exact(8);\nfor chunk in &mut chunks {\n    r = lodepng_crc32_table7[((chunk[0] as c_uint) ^ (r & 0xff as c_uint)) as usize]\n        ^ lodepng_crc32_table6\n            [((chunk[1] as c_uint) ^ (r >> 8 as c_int & 0xff as c_uint)) as usize]\n        ^ lodepng_crc32_table5\n            [((chunk[2] as c_uint) ^ (r >> 16 as c_int & 0xff as c_uint)) as usize]\n        ^ lodepng_crc32_table4\n            [((chunk[3] as c_uint) ^ (r >> 24 as c_int & 0xff as c_uint)) as usize]\n        ^ lodepng_crc32_table3[chunk[4] as usize]\n        ^ lodepng_crc32_table2[chunk[5] as usize]\n        ^ lodepng_crc32_table1[chunk[6] as usize]\n        ^ lodepng_crc32_table0[chunk[7] as usize];\n}\nfor &b in chunks.remainder() {\n    r = lodepng_crc32_table0[((r ^ b as c_uint) & 0xff as c_uint) as usize]\n        ^ r >> 8 as c_int;\n}\nreturn r ^ 0xffffffff as c_uint;",
          "rule_id": "III④"
        }
