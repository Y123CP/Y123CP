          "replacement_region_source": "let mut r: c_uint = 0xffffffff as c_uint;\n    while length >= 8 as size_t {\n        let one = (data as *const u32).read_unaligned() ^ r;\n        let two = (data.offset(4) as *const u32).read_unaligned();\n        r = lodepng_crc32_table7[(one & 0xff) as usize]\n            ^ lodepng_crc32_table6[((one >> 8) & 0xff) as usize]\n            ^ lodepng_crc32_table5[((one >> 16) & 0xff) as usize]\n            ^ lodepng_crc32_table4[((one >> 24) & 0xff) as usize]\n            ^ lodepng_crc32_table3[(two & 0xff) as usize]\n            ^ lodepng_crc32_table2[((two >> 8) & 0xff) as usize]\n            ^ lodepng_crc32_table1[((two >> 16) & 0xff) as usize]\n            ^ lodepng_crc32_table0[((two >> 24) & 0xff) as usize];\n        data = data.offset(8);\n        length = length.wrapping_sub(8 as size_t);\n    }\n    while length != 0 {\n        let byte = *data;\n        data = data.offset(1);\n        length = length.wrapping_sub(1);\n        r = lodepng_crc32_table0[((r ^ byte as c_uint) & 0xff as c_uint) as usize]\n            ^ r >> 8;\n    }\n    return r ^ 0xffffffff as c_uint;",
          "rule_id": "III④,C8"
        }
