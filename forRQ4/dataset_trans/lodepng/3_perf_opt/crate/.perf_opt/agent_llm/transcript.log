    }
    if lodepng_chunk_reserved(chunk) != 0 {
        return 122 as c_uint;
    }
    if lodepng_addofl(
        lodepng_chunk_length(chunk) as size_t,
        12 as size_t,
        &raw mut total_chunk_length,
    ) != 0
    {
        return 77 as c_uint;
    }
    let old_outsize = *outsize;
    if lodepng_addofl(old_outsize, total_chunk_length, &raw mut new_length) != 0 {
        return 77 as c_uint;
    }
    let old_out = *out;
    new_buffer = lodepng_realloc(old_out as *mut c_void, new_length) as *mut c_uchar;
    if new_buffer.is_null() {
        return 83 as c_uint;
    }
    *out = new_buffer;
    *outsize = new_length;
    chunk_start =
        new_buffer.offset(new_length.wrapping_sub(total_chunk_length) as isize) as *mut c_uchar;
    let copy_len = total_chunk_length;
    let copy_len_usize = copy_len as usize;
    let src = unsafe {
        // SAFETY: `copy_len` is the exact stable byte count computed before the copy;
        // callers of this unsafe function provide `chunk` as a valid non-null pointer to
        // at least `copy_len` bytes; the source region is only read for the duration of
        // this local reborrow and does not alias the destination mutable slice.
        ::core::slice::from_raw_parts(chunk, copy_len_usize)
    };
    let dst = unsafe {
        // SAFETY: `chunk_start` points into the newly reallocated output buffer at the
        // start of a `copy_len`-byte tail region; `copy_len` is stable across the copy;
        // `new_buffer` was checked non-null above, so this derived pointer is valid for
        // `copy_len` bytes, and no other reference to this destination region is live.
        ::core::slice::from_raw_parts_mut(chunk_start, copy_len_usize)
    };
    dst.copy_from_slice(src);
