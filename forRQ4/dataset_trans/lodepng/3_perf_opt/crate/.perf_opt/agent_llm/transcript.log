```rust
unsafe fn update_adler32(
    mut adler: c_uint,
    mut data: *const c_uchar,
    mut len: c_uint,
) -> c_uint {
    let mut s1: c_uint = adler & 0xffff as c_uint;
    let mut s2: c_uint =
        adler >> 16 as c_uint & 0xffff as c_uint;
    while len != 0 as c_uint {
        let mut i: c_uint = 0;
        let mut amount: c_uint = if len > 5552 as c_uint {
            5552 as c_uint
        } else {
            len
        };
        len = len.wrapping_sub(amount);
        i = 0 as c_uint;
        while i != amount {
            let fresh35 = data;
            data = data.offset(1);
            s1 = s1.wrapping_add(*fresh35 as c_uint);
            s2 = s2.wrapping_add(s1);
            i = i.wrapping_add(1);
        }
        s1 = s1.wrapping_rem(65521 as c_uint);
        s2 = s2.wrapping_rem(65521 as c_uint);
    }
    return s2 << 16 as c_uint | s1;
}
```

