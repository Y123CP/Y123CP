    "rust_source": "unsafe fn readBitsFromReversedStream(\n    mut bitpointer: *mut size_t,\n    mut bitstream: *const c_uchar,\n    mut nbits: size_t,\n) -> c_uint {\n    let mut result: c_uint = 0 as c_uint;\n    let mut i: size_t = 0;\n    i = 0 as size_t;\n    while i < nbits {\n        result <<= 1 as c_uint;\n        result |= readBitFromReversedStream(bitpointer, bitstream) as c_uint;\n        i = i.wrapping_add(1);\n    }\n    return result;\n}",
