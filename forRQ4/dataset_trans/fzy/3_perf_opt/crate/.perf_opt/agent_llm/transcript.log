        needle_len: 0,
        haystack_len: 0,
        lower_needle: [0; 1024],
        lower_haystack: [0; 1024],
        match_bonus: [0.; 1024],
    };
    setup_match_struct(&raw mut match_1, needle, haystack);

    let n: c_int = match_1.needle_len;
    let m: c_int = match_1.haystack_len;
    if m > MATCH_MAX_LEN || n > m {
        return -::core::f32::INFINITY as score_t;
    } else if n == m {
        return ::core::f32::INFINITY as score_t;
    }

    let mut d_store = [::core::mem::MaybeUninit::<score_t>::uninit(); 1024];
    let mut m_store = [::core::mem::MaybeUninit::<score_t>::uninit(); 1024];
    let (D, M): (&mut [score_t], &mut [score_t]) = unsafe {
        // SAFETY: `m <= MATCH_MAX_LEN <= 1024` was checked above. `write_bytes`
        // initializes exactly the prefix `..m` of each backing array with the
        // same all-zero bit pattern the original `[0.; 1024]` produced, and
        // `score_t` is an f32-compatible scalar where all-zero is valid. The
        // only reads/writes performed by `match_row` and the final return are
        // within `0..m`.
        let d_ptr = d_store.as_mut_ptr() as *mut score_t;
        let m_ptr = m_store.as_mut_ptr() as *mut score_t;
        ::core::ptr::write_bytes(d_ptr, 0, m as usize);
        ::core::ptr::write_bytes(m_ptr, 0, m as usize);
        (
            ::core::slice::from_raw_parts_mut(d_ptr, m as usize),
            ::core::slice::from_raw_parts_mut(m_ptr, m as usize),
        )
    };

    let mut i: c_int = 0;
    while i < n {
        match_row(
            &raw mut match_1,
            i,
            D.as_mut_ptr(),
            M.as_mut_ptr(),
            D.as_mut_ptr(),
            M.as_mut_ptr(),
