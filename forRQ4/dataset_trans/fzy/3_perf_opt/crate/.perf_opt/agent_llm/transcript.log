#[inline]
unsafe fn match_row(
    mut match_1: *const match_struct,
    mut row: c_int,
    mut curr_D: *mut score_t,
    mut curr_M: *mut score_t,
    mut last_D: *const score_t,
    mut last_M: *const score_t,
) {
    let n: c_int = (*match_1).needle_len;
    let m: c_int = (*match_1).haystack_len;
    let i: c_int = row;

    let m_usize = m as usize;
    let i_usize = i as usize;

    // SAFETY: `match_1` is assumed by the caller to be non-null and valid for reads.
    // `m` is taken from the stable `haystack_len` field and this function does not mutate
    // `match_1`, so the length is stable across the loop. The arrays are fields of
    // `match_struct` with capacity 1024, and the caller invariant for this routine is that
    // `0 <= m <= 1024` and `0 <= row < n <= 1024`, so slicing to `m_usize` and indexing
