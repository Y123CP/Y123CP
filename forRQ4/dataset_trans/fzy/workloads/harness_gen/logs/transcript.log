fn big_match_perf() -> Vec<u8> {
    let mut v = Vec::with_capacity(3_000_000);
    v.extend_from_slice(b"ttyint");
    v.push(0);
    for i in 0..90_000u32 {
        let line = format!(
            "src/module_{:03}/tty_interface_impl_{:06}.rs src/module_{:03}/tty_internal_{:06}.rs docs/tty_interface_notes_{:06}.md ",
            i % 127,
            i,
            i % 97,
            i,
            i
        );
        v.extend_from_slice(line.as_bytes());
    }
    v
}

fn big_choices_perf_path_corpus(query: &str) -> Vec<u8> {
    let mut v = Vec::with_capacity(7_000_000);
    v.extend_from_slice(query.as_bytes());
    v.push(b'\n');

    for i in 0..180_000u32 {
        let a = format!(
            "src/project_{:03}/module_{:03}/tty_interface_{:06}.rs\n",
            i % 64,
            i % 257,
            i
        );
        let b = format!(
            "src/project_{:03}/module_{:03}/match_engine_{:06}.rs\n",
            i % 64,
            i % 211,
            i
        );
        let c = format!(
            "target/debug/build/project_{:03}/out/generated_symbol_{:06}.txt\n",
            i % 64,
            i
        );
        let d = format!(
            "examples/demo_{:03}/history_command_{:06}.log\n",
            i % 32,
            i
        );
        v.extend_from_slice(a.as_bytes());
        v.extend_from_slice(b.as_bytes());
        v.extend_from_slice(c.as_bytes());
        v.extend_from_slice(d.as_bytes());
    }

    v
}

fn big_options_perf() -> Vec<u8> {
    let mut v = Vec::new();
    v.extend_from_slice(b"-i -l 32 -q tty\n");
    for i in 0..220_000u32 {
        let a = format!("src/module_{:03}/tty_interface_{:06}.rs\n", i % 64, i);
        let b = format!("src/module_{:03}/tty_draw_{:06}.rs\n", i % 32, i);
        let c = format!("README_section_{:06}_tty_interface.md\n", i);
        v.extend_from_slice(a.as_bytes());
        v.extend_from_slice(b.as_bytes());
        v.extend_from_slice(c.as_bytes());
    }
    v
}

fn write_file(path: &str, bytes: &[u8]) {
    let parent = Path::new(path).parent().unwrap_or_else(|| Path::new("."));
    let _ = fs::create_dir_all(parent);
    let _ = fs::write(path, bytes);
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let _ = fs::create_dir_all(dir);
    let mut out = Vec::new();

    let seeds: [(&str, usize, Vec<u8>); 12] = [
        ("match_primitives", 1, seed_match_1()),
        ("match_primitives", 2, seed_match_2()),
        ("choices_add_search", 1, seed_choices_add_1()),
        ("choices_add_search", 2, seed_choices_add_2()),
        ("choices_fread_search", 1, seed_choices_fread_1()),
        ("choices_fread_search", 2, seed_choices_fread_2()),
        ("options_parse_choices", 1, seed_options_1()),
        ("options_parse_choices", 2, seed_options_2()),
        ("tty_smoke", 1, seed_tty_1()),
        ("tty_smoke", 2, seed_tty_2()),
        ("tty_interface_script", 1, seed_tty_interface_1()),
        ("tty_interface_script", 2, seed_tty_interface_2()),
    ];

    for (op, idx, bytes) in seeds {
        let path = format!("{}/{}.{}.bin", dir, op, idx);
        write_file(&path, &bytes);
        out.push(format!("seed {} {}", op, path));
    }

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let _ = fs::create_dir_all(dir);
    let mut out = Vec::new();

    let perf_inputs: [(&str, Vec<u8>); 4] = [
        ("match_primitives", big_match_perf()),
        ("choices_add_search", big_choices_perf_path_corpus("ttyint")),
        ("choices_fread_search", big_choices_perf_path_corpus("match")),
        ("options_parse_choices", big_options_perf()),
    ];

    for (op, bytes) in perf_inputs {
        let path = format!("{}/{}.perf.bin", dir, op);
        write_file(&path, &bytes);
        out.push(format!("perf {} {}", op, path));
    }

    out
}
