unsafe extern "C" {
    fn tmpfile() -> *mut c_void;
    fn fwrite(ptr: *const c_void, size: usize, nmemb: usize, stream: *mut c_void) -> usize;
    fn rewind(stream: *mut c_void);
    fn fclose(stream: *mut c_void) -> c_int;
}

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(5) ^ x.wrapping_mul(0x9E37_79B1_85EB_CA87)
}

fn fold_bytes(mut acc: u64, bytes: &[u8]) -> u64 {
    for &b in bytes {
        acc = fold(acc, b as u64);
    }
    acc
}

fn fold_usize(acc: u64, x: usize) -> u64 {
    fold(acc, x as u64)
}

fn fold_i32(acc: u64, x: i32) -> u64 {
    fold(acc, x as u32 as u64)
}

fn fold_mem<T>(acc: u64, v: &T) -> u64 {
    let p = v as *const T as *const u8;
    let n = std::mem::size_of::<T>();
    if n == 0 {
        return fold(acc, 0);
    }
    let bytes = unsafe { std::slice::from_raw_parts(p, n) };
    fold_bytes(acc, bytes)
}

fn sanitize_c_bytes(input: &[u8]) -> Vec<u8> {
    let mut out = Vec::with_capacity(input.len() + 1);
    for &b in input {
        out.push(if b == 0 { b' ' } else { b });
    }
    out.push(0);
    out
}

fn sanitize_no_nul(input: &[u8]) -> Vec<u8> {
    let mut out = Vec::with_capacity(input.len());
    for &b in input {
        out.push(if b == 0 { b' ' } else { b });
    }
    out
}

fn split_once_nul(data: &[u8]) -> (&[u8], &[u8]) {
    if let Some(i) = data.iter().position(|&b| b == 0) {
        (&data[..i], &data[i + 1..])
    } else {
        (data, &[])
    }
}

fn split_query_and_rest(data: &[u8]) -> (&[u8], &[u8]) {
    if let Some(i) = data.iter().position(|&b| b == b'\n') {
        (&data[..i], &data[i + 1..])
    } else {
        (data, &[])
    }
}

fn split_sections(data: &[u8]) -> (&[u8], &[u8], &[u8]) {
    let mut first = None;
    let mut second = None;
    let mut i = 0usize;
    while i + 1 < data.len() {
        if data[i] == b'\n' && data[i + 1] == b'\n' {
            if first.is_none() {
                first = Some(i);
                i += 2;
                continue;
            }
            second = Some(i);
            break;
        }
        i += 1;
    }

    match (first, second) {
        (Some(a), Some(b)) => (&data[..a], &data[a + 2..b], &data[b + 2..]),
        (Some(a), None) => (&data[..a], &data[a + 2..], &[]),
        (None, _) => (data, &[], &[]),
    }
}

fn checksum_cstr_ptr(mut acc: u64, s: *const c_char) -> u64 {
    if s.is_null() {
        return fold(acc, 0);
    }
    unsafe {
        let bytes = CStr::from_ptr(s).to_bytes();
        acc = fold_bytes(acc, bytes);
        fold(acc, bytes.len() as u64)
    }
}

fn build_line_cstrings(data: &[u8]) -> (Vec<u8>, Vec<Vec<u8>>) {
    let mut parts = data.split(|&b| b == b'\n');
    let query = sanitize_c_bytes(parts.next().unwrap_or(&[]));
    let mut lines = Vec::new();
    for part in parts {
        if !part.is_empty() {
            lines.push(sanitize_c_bytes(part));
        }
    }
    (query, lines)
}

fn build_args_and_lines(data: &[u8]) -> (Vec<Vec<u8>>, Vec<Vec<u8>>) {
    let (arg_block, line_block) = split_query_and_rest(data);
    let arg_text = sanitize_no_nul(arg_block);
    let mut args = Vec::new();
    args.push(b"fzy\0".to_vec());
    for tok in arg_text.split(|b| *b == b' ' || *b == b'\t') {
        if !tok.is_empty() {
            args.push(sanitize_c_bytes(tok));
        }
    }

    let mut lines = Vec::new();
    for line in line_block.split(|&b| b == b'\n') {
        if !line.is_empty() {
            lines.push(sanitize_c_bytes(line));
        }
    }
    if lines.is_empty() {
        lines.push(b"default-choice\0".to_vec());
        lines.push(b"tty_interface.rs\0".to_vec());
        lines.push(b"match.rs\0".to_vec());
    }

    (args, lines)
}

unsafe fn with_temp_file_bytes(bytes: &[u8]) -> Result<*mut c_void, i32> {
    let f = unsafe { tmpfile() };
    if f.is_null() {
        return Err(1);
    }
    if !bytes.is_empty() {
        let wrote = unsafe { fwrite(bytes.as_ptr() as *const c_void, 1, bytes.len(), f) };
        if wrote != bytes.len() {
            unsafe {
                fclose(f);
            }
            return Err(2);
        }
    }
    unsafe {
        rewind(f);
    }
    Ok(f)
}

fn stable_name(tag: &str, bytes: &[u8]) -> String {
    let mut h = 0x1234_5678_9abc_def0u64;
    h = fold_bytes(h, tag.as_bytes());
    h = fold_bytes(h, bytes);
    format!("{}_{}.tmp", tag, h)
}

fn make_temp_path(tag: &str, bytes: &[u8]) -> PathBuf {
    let mut p = std::env::temp_dir();
    p.push("fzy_raw_harness");
    let _ = fs::create_dir_all(&p);
    p.push(stable_name(tag, bytes));
    p
}

fn write_temp_input(tag: &str, bytes: &[u8]) -> Option<Vec<u8>> {
    let path = make_temp_path(tag, bytes);
    if fs::write(&path, bytes).is_err() {
        return None;
    }
    let mut b = sanitize_no_nul(path.to_string_lossy().as_bytes());
    b.push(0);
    Some(b)
}

unsafe fn digest_choices_state(chp: *mut choices_t, mut acc: u64) -> u64 {
    let avail = unsafe { choices_available(chp) };
    acc = fold_usize(acc, avail);
    let limit = std::cmp::min(avail, 8);
    for i in 0..limit {
        acc = checksum_cstr_ptr(acc, unsafe { choices_get(chp, i) });
        let sc = unsafe { choices_getscore(chp, i) };
        acc = fold_mem(acc, &sc);
    }

    let g0 = unsafe { choices_get(chp, 0) };
    acc = checksum_cstr_ptr(acc, g0);
    let s0 = unsafe { choices_getscore(chp, 0) };
    acc = fold_mem(acc, &s0);

    unsafe {
        choices_prev(chp);
    }
    acc = checksum_cstr_ptr(acc, unsafe { choices_get(chp, 0) });
    let sp = unsafe { choices_getscore(chp, 0) };
    acc = fold_mem(acc, &sp);

    unsafe {
        choices_next(chp);
    }
    acc = checksum_cstr_ptr(acc, unsafe { choices_get(chp, 0) });
    let sn = unsafe { choices_getscore(chp, 0) };
    acc = fold_mem(acc, &sn);

    acc
}

pub fn op_match_primitives(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        let (needle_raw, hay_raw) = split_once_nul(data);
        let needle = sanitize_c_bytes(needle_raw);
        let haystack = sanitize_c_bytes(hay_raw);

        let mut iter_digest = 0u64;
        unsafe {
            let needle_ptr = needle.as_ptr() as *const c_char;
            let hay_ptr = haystack.as_ptr() as *const c_char;

            let first_ch = needle_raw.first().copied().unwrap_or(0) as c_char;
            let p = strcasechr(hay_ptr, first_ch);
            let offset = if p.is_null() {
                usize::MAX
            } else {
                (p as usize).wrapping_sub(hay_ptr as usize)
            };
            iter_digest = fold_usize(iter_digest, offset);

            let hm = has_match(needle_ptr, hay_ptr);
            iter_digest = fold(iter_digest, hm as u64);

            let s1 = match_0(needle_ptr, hay_ptr);
            iter_digest = fold_mem(iter_digest, &s1);

            let pos_len = needle_raw.len();
            let mut positions = vec![usize::MAX; pos_len];
            let pos_ptr = if positions.is_empty() {
                ptr::null_mut()
            } else {
                positions.as_mut_ptr()
            };
            let s2 = match_positions(needle_ptr, hay_ptr, pos_ptr);
            iter_digest = fold_mem(iter_digest, &s2);

            for &pos in &positions {
                iter_digest = fold_usize(iter_digest, pos);
            }

            let rev_needle_raw: Vec<u8> = needle_raw.iter().rev().copied().collect();
            let rev_needle = sanitize_c_bytes(&rev_needle_raw);
            let s3 = match_0(rev_needle.as_ptr() as *const c_char, hay_ptr);
            iter_digest = fold_mem(iter_digest, &s3);

            iter_digest = fold_usize(iter_digest, needle_raw.len());
            iter_digest = fold_usize(iter_digest, hay_raw.len());
            last_err = 0;
        }

        digest = fold(digest, iter_digest);
    }

    format!("op=match_primitives err={} digest={:016x}", last_err, digest)
}

pub fn op_choices_add_search(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        let (query, lines) = build_line_cstrings(data);
        let mut iter_digest = 0u64;

        unsafe {
            let mut opt = MaybeUninit::<options_t>::zeroed();
            options_init(opt.as_mut_ptr());

            let mut ch = MaybeUninit::<choices_t>::zeroed();
            let chp = ch.as_mut_ptr();
            choices_init(chp, opt.as_mut_ptr() as *mut _);

            for line in &lines {
                choices_add(chp, line.as_ptr() as *const c_char);
            }

            choices_search(chp, query.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            let mut upper_query = Vec::new();
            for &b in &query[..query.len().saturating_sub(1)] {
                upper_query.push(b.to_ascii_uppercase());
            }
            upper_query.push(0);
            choices_search(chp, upper_query.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            let empty = [0u8];
            choices_search(chp, empty.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            iter_digest = fold_usize(iter_digest, lines.len());
            iter_digest = fold_usize(iter_digest, query.len().saturating_sub(1));

            choices_destroy(chp);
            last_err = 0;
        }

        digest = fold(digest, iter_digest);
    }

    format!("op=choices_add_search err={} digest={:016x}", last_err, digest)
}

pub fn op_choices_fread_search(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        let (query_raw, payload) = split_query_and_rest(data);
        let query = sanitize_c_bytes(query_raw);
        let mut iter_digest = 0u64;

        unsafe {
            let mut opt = MaybeUninit::<options_t>::zeroed();
            options_init(opt.as_mut_ptr());

            let mut ch = MaybeUninit::<choices_t>::zeroed();
            let chp = ch.as_mut_ptr();
            choices_init(chp, opt.as_mut_ptr() as *mut _);

            match with_temp_file_bytes(payload) {
                Ok(f) => {
                    choices_fread(chp, f as *mut _, b'\n' as c_char);
                    let _ = fclose(f);
                    last_err = 0;
                }
                Err(code) => {
                    last_err = code;
                }
            }

            choices_search(chp, query.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            let alt_delim_payload: Vec<u8> = payload
                .iter()
                .map(|&b| if b == b'\n' { b'|' } else { b })
                .collect();

            let mut ch2 = MaybeUninit::<choices_t>::zeroed();
            let ch2p = ch2.as_mut_ptr();
            choices_init(ch2p, opt.as_mut_ptr() as *mut _);

            match with_temp_file_bytes(&alt_delim_payload) {
                Ok(f) => {
                    choices_fread(ch2p, f as *mut _, b'|' as c_char);
                    let _ = fclose(f);
                    choices_search(ch2p, query.as_ptr() as *const c_char);
                    iter_digest = digest_choices_state(ch2p, iter_digest);
                }
                Err(code) => {
                    last_err = code;
                }
            }

            iter_digest = fold_usize(iter_digest, payload.len());
            iter_digest = fold_usize(iter_digest, query_raw.len());

            choices_destroy(ch2p);
            choices_destroy(chp);
        }

        digest = fold(digest, iter_digest ^ (last_err as u32 as u64));
    }

    format!(
        "op=choices_fread_search err={} digest={:016x}",
        last_err, digest
    )
}

pub fn op_options_parse_choices(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        let (mut args, lines) = build_args_and_lines(data);
        let query_src = lines
            .first()
            .map(|v| &v[..v.len().saturating_sub(1)])
            .unwrap_or(&[]);
        let query = sanitize_c_bytes(query_src);
        let mut iter_digest = 0u64;

        unsafe {
            let mut opt = MaybeUninit::<options_t>::zeroed();
            options_init(opt.as_mut_ptr());

            let mut argv: Vec<*mut c_char> = args
                .iter_mut()
                .map(|v| v.as_mut_ptr() as *mut c_char)
                .collect();

            options_parse(opt.as_mut_ptr(), argv.len() as c_int, argv.as_mut_ptr());

            let mut ch = MaybeUninit::<choices_t>::zeroed();
            let chp = ch.as_mut_ptr();
            choices_init(chp, opt.as_mut_ptr() as *mut _);

            for line in &lines {
                choices_add(chp, line.as_ptr() as *const c_char);
            }

            choices_search(chp, query.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            let empty = [0u8];
            choices_search(chp, empty.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            iter_digest = fold_usize(iter_digest, args.len());
            iter_digest = fold_usize(iter_digest, lines.len());
            choices_destroy(chp);
            last_err = 0;
        }

        digest = fold(digest, iter_digest);
    }

    format!(
        "op=options_parse_choices err={} digest={:016x}",
        last_err, digest
    )
}

pub fn op_tty_smoke(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        let (script_raw, rest) = split_once_nul(data);
        let script = if script_raw.is_empty() {
            b"abc\x1b[A\x1b[B\x08\x7f\r\n".to_vec()
        } else {
            sanitize_no_nul(script_raw)
        };
        let msg = sanitize_c_bytes(rest);
        let path_bytes = match write_temp_input("tty_smoke", &script) {
            Some(p) => p,
            None => {
                digest = fold(digest, 1);
                last_err = 1;
                continue;
            }
        };

        let mut iter_digest = 0u64;
        unsafe {
            let mut tty = MaybeUninit::<tty_t>::zeroed();
            let ttyp = tty.as_mut_ptr();

            tty_init(ttyp, path_bytes.as_ptr() as *const c_char);
            tty_getwinsz(ttyp);

            let w = tty_getwidth(ttyp);
            let h = tty_getheight(ttyp);
            iter_digest = fold_usize(iter_digest, w);
            iter_digest = fold_usize(iter_digest, h);

            let ready0 = tty_input_ready(ttyp, 0 as c_long, 0);
            iter_digest = fold_i32(iter_digest, ready0);

            tty_setfg(ttyp, (script.len() % 9) as c_int);
            tty_setinvert(ttyp);
            tty_setunderline(ttyp);
            tty_setnormal(ttyp);
            tty_setnowrap(ttyp);
            tty_setwrap(ttyp);
            tty_newline(ttyp);
            tty_clearline(ttyp);
            tty_setcol(ttyp, (script.len() % 7) as c_int);
            tty_moveup(ttyp, (script.len() % 3) as c_int);

            let fmt = b"%s\0";
            tty_printf(
                ttyp,
                fmt.as_ptr() as *const c_char,
                msg.as_ptr() as *const c_char,
            );
            tty_putc(ttyp, b'X' as c_char);
            tty_flush(ttyp);

            let c1 = tty_getchar(ttyp) as i32;
            let c2 = tty_getchar(ttyp) as i32;
            iter_digest = fold_i32(iter_digest, c1);
            iter_digest = fold_i32(iter_digest, c2);

            let ready1 = tty_input_ready(ttyp, 0 as c_long, 1);
            iter_digest = fold_i32(iter_digest, ready1);

            tty_reset(ttyp);
            tty_close(ttyp);
            last_err = 0;
        }

        let path_str =
            std::str::from_utf8(&path_bytes[..path_bytes.len().saturating_sub(1)]).unwrap_or("");
        let path = Path::new(path_str);
        let _ = fs::remove_file(path);
        digest = fold(digest, iter_digest);
    }

    format!("op=tty_smoke err={} digest={:016x}", last_err, digest)
}

pub fn op_tty_interface_script(data: &[u8], iters: u64) -> String {
    let mut digest = 0u64;
    let mut last_err = 0i32;

    for _ in 0..iters {
        let (arg_block, choices_block, script_block) = split_sections(data);
        let mut all = Vec::new();
        all.extend_from_slice(arg_block);
        all.push(b'\n');
        all.extend_from_slice(choices_block);
        let (mut args, mut lines) = build_args_and_lines(&all);
        if lines.is_empty() {
            lines.push(b"alpha\0".to_vec());
            lines.push(b"alphabet\0".to_vec());
            lines.push(b"alphanumeric\0".to_vec());
            lines.push(b"src/tty_interface.rs\0".to_vec());
        }

        let script = if script_block.is_empty() {
            b"ab\t\x01\x05\x02\x06\x17\x15xyz\x1b[A\x1b[B\x1b[5~\x1b[6~\x7f\r".to_vec()
        } else {
            sanitize_no_nul(script_block)
        };

        let path_bytes = match write_temp_input("tty_interface", &script) {
            Some(p) => p,
            None => {
                digest = fold(digest, 2);
                last_err = 2;
                continue;
            }
        };

        let mut iter_digest = 0u64;
        unsafe {
            let mut opt = MaybeUninit::<options_t>::zeroed();
            options_init(opt.as_mut_ptr());

            let mut argv: Vec<*mut c_char> = args
                .iter_mut()
                .map(|v| v.as_mut_ptr() as *mut c_char)
                .collect();
            options_parse(opt.as_mut_ptr(), argv.len() as c_int, argv.as_mut_ptr());

            let mut ch = MaybeUninit::<choices_t>::zeroed();
            let chp = ch.as_mut_ptr();
            choices_init(chp, opt.as_mut_ptr() as *mut _);
            for line in &lines {
                choices_add(chp, line.as_ptr() as *const c_char);
            }

            let mut tty = MaybeUninit::<tty_t>::zeroed();
            let ttyp = tty.as_mut_ptr();
            tty_init(ttyp, path_bytes.as_ptr() as *const c_char);
            tty_getwinsz(ttyp);

            let mut state = MaybeUninit::<tty_interface_t>::zeroed();
            let statep = state.as_mut_ptr();
            tty_interface_init(
                statep,
                ttyp as *mut _,
                chp as *mut _,
                opt.as_mut_ptr() as *mut _,
            );

            let rc = tty_interface_run(statep);
            iter_digest = fold_i32(iter_digest, rc);
            iter_digest = fold_usize(iter_digest, tty_getwidth(ttyp));
            iter_digest = fold_usize(iter_digest, tty_getheight(ttyp));
            iter_digest = digest_choices_state(chp, iter_digest);

            tty_reset(ttyp);
            tty_close(ttyp);
            choices_destroy(chp);
            last_err = 0;
        }

        let path_str =
            std::str::from_utf8(&path_bytes[..path_bytes.len().saturating_sub(1)]).unwrap_or("");
        let path = Path::new(path_str);
        let _ = fs::remove_file(path);
        digest = fold(digest, iter_digest);
    }

    format!(
        "op=tty_interface_script err={} digest={:016x}",
        last_err, digest
    )
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("match_primitives", op_match_primitives as fn(&[u8], u64) -> String),
        (
            "choices_add_search",
            op_choices_add_search as fn(&[u8], u64) -> String,
        ),
        (
            "choices_fread_search",
            op_choices_fread_search as fn(&[u8], u64) -> String,
        ),
        (
            "options_parse_choices",
            op_options_parse_choices as fn(&[u8], u64) -> String,
        ),
        ("tty_smoke", op_tty_smoke as fn(&[u8], u64) -> String),
        (
            "tty_interface_script",
            op_tty_interface_script as fn(&[u8], u64) -> String,
        ),
    ]
}

