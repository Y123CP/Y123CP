fn write_file(path: &str, bytes: &[u8]) {
    let parent = Path::new(path).parent().unwrap_or_else(|| Path::new("."));
    let _ = fs::create_dir_all(parent);
    let _ = fs::write(path, bytes);
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let _ = fs::create_dir_all(dir);
    let mut out = Vec::new();

    let seeds: [(&str, usize, Vec<u8>); 12] = [
        ("match_primitives", 1, seed_match_1()),
        ("match_primitives", 2, seed_match_2()),
        ("choices_add_search", 1, seed_choices_add_1()),
        ("choices_add_search", 2, seed_choices_add_2()),
        ("choices_fread_search", 1, seed_choices_fread_1()),
        ("choices_fread_search", 2, seed_choices_fread_2()),
        ("options_parse_choices", 1, seed_options_1()),
        ("options_parse_choices", 2, seed_options_2()),
        ("tty_smoke", 1, seed_tty_1()),
        ("tty_smoke", 2, seed_tty_2()),
        ("tty_interface_script", 1, seed_tty_interface_1()),
        ("tty_interface_script", 2, seed_tty_interface_2()),
    ];

    for (op, idx, bytes) in seeds {
        let path = format!("{}/{}.{}.bin", dir, op, idx);
        write_file(&path, &bytes);
        out.push(format!("seed {} {}", op, path));
    }

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let _ = fs::create_dir_all(dir);
