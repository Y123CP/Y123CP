fn big_choices_perf_path_corpus(query: &str) -> Vec<u8> {
    let mut v = Vec::with_capacity(7_000_000);
    v.extend_from_slice(query.as_bytes());
    v.push(b'\n');

    for i in 0..180_000u32 {
        let a = format!(
            "src/project_{:03}/module_{:03}/tty_interface_{:06}.rs\n",
            i % 64,
            i % 257,
            i
        );
        let b = format!(
            "src/project_{:03}/module_{:03}/match_engine_{:06}.rs\n",
            i % 64,
            i % 211,
            i
        );
        let c = format!(
            "target/debug/build/project_{:03}/out/generated_symbol_{:06}.txt\n",
            i % 64,
            i
        );
        let d = format!(
            "examples/demo_{:03}/history_command_{:06}.log\n",
            i % 32,
            i
        );
        v.extend_from_slice(a.as_bytes());
