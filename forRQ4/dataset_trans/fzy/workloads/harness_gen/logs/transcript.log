    let mut v = Vec::with_capacity(7_000_000);
    v.extend_from_slice(query.as_bytes());
    v.push(b'\n');

    for i in 0..180_000u32 {
        let a = format!(
            "src/project_{:03}/module_{:03}/tty_interface_{:06}.rs\n",
            i % 64,
            i % 257,
