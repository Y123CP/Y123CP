                choices_add(chp, line.as_ptr() as *const c_char);
            }

            choices_search(chp, query.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            let mut upper_query = Vec::new();
            for &b in &query[..query.len().saturating_sub(1)] {
                upper_query.push(b.to_ascii_uppercase());
            }
            upper_query.push(0);
            choices_search(chp, upper_query.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            let empty = [0u8];
            choices_search(chp, empty.as_ptr() as *const c_char);
            iter_digest = digest_choices_state(chp, iter_digest);

            iter_digest = fold_usize(iter_digest, lines.len());
            iter_digest = fold_usize(iter_digest, query.len().saturating_sub(1));

            choices_destroy(chp);
            last_err = 0;
        }

        digest = fold(digest, iter_digest);
    }

    format!("op=choices_add_search err={} digest={:016x}", last_err, digest)
