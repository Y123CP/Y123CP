extern "C" fn png_read_filter_row_sub(
    mut row_info: png_row_infop,
    mut row: png_bytep,
    mut prev_row: png_const_bytep,
) { unsafe {
    let istop: png_size_t = (*row_info).rowbytes;
    let bpp: usize = (((*row_info).pixel_depth as c_int + 7 as c_int) >> 3 as c_int) as usize;

    if (istop as usize) <= bpp {
        return;
    }

    let mut rp = row.add(bpp);
    let mut left = row;

    let mut remaining = (istop as usize) - bpp;

    while remaining >= 8 {
        *rp = ((*rp as c_int + *left as c_int) & 0xff) as png_byte;
        *rp.add(1) = ((*rp.add(1) as c_int + *left.add(1) as c_int) & 0xff) as png_byte;
        *rp.add(2) = ((*rp.add(2) as c_int + *left.add(2) as c_int) & 0xff) as png_byte;
        *rp.add(3) = ((*rp.add(3) as c_int + *left.add(3) as c_int) & 0xff) as png_byte;
        *rp.add(4) = ((*rp.add(4) as c_int + *left.add(4) as c_int) & 0xff) as png_byte;
        *rp.add(5) = ((*rp.add(5) as c_int + *left.add(5) as c_int) & 0xff) as png_byte;
        *rp.add(6) = ((*rp.add(6) as c_int + *left.add(6) as c_int) & 0xff) as png_byte;
        *rp.add(7) = ((*rp.add(7) as c_int + *left.add(7) as c_int) & 0xff) as png_byte;

        rp = rp.add(8);
        left = left.add(8);
        remaining -= 8;
    }

    while remaining != 0 {
        *rp = ((*rp as c_int + *left as c_int) & 0xff) as png_byte;
        rp = rp.add(1);
        left = left.add(1);
        remaining -= 1;
    }

    let _ = prev_row;
} }
