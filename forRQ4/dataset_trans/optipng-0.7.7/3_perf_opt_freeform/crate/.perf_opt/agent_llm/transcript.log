            channels: pp.channels,
            pixel_depth: pp.pixel_depth,
        };

        let pixel_depth = row_info.pixel_depth as png_size_t;
        let width = row_info.width as png_size_t;
        row_info.rowbytes = if row_info.pixel_depth as c_int >= 8 {
            width.wrapping_mul(pixel_depth >> 3)
        } else {
            width.wrapping_mul(pixel_depth).wrapping_add(7) >> 3
        };

        let interlace_xform =
            pp.interlaced as c_int != 0 && (pp.transformations as c_uint & PNG_INTERLACE) != 0;

        if interlace_xform {
            let row_number = pp.row_number as c_uint;
            let pass = pp.pass as c_int;
            let width_u = pp.width;

            match pass {
                0 => {
                    if row_number & 0x7 != 0 {
                        if !dsp_row.is_null() {
                            png_combine_row(png_ptr, dsp_row, 1);
                        }
                        png_read_finish_row(png_ptr);
                        return;
                    }
                }
                1 => {
                    if row_number & 0x7 != 0 || width_u < 5 {
                        if !dsp_row.is_null() {
                            png_combine_row(png_ptr, dsp_row, 1);
                        }
                        png_read_finish_row(png_ptr);
                        return;
                    }
                }
                2 => {
                    if row_number & 0x7 != 4 {
                        if !dsp_row.is_null() && (row_number & 4) != 0 {
                            png_combine_row(png_ptr, dsp_row, 1);
                        }
                        png_read_finish_row(png_ptr);
                        return;
                    }
                }
                3 => {
                    if row_number & 3 != 0 || width_u < 3 {
                        if !dsp_row.is_null() {
                            png_combine_row(png_ptr, dsp_row, 1);
                        }
                        png_read_finish_row(png_ptr);
                        return;
                    }
                }
                4 => {
                    if row_number & 3 != 2 {
                        if !dsp_row.is_null() && (row_number & 2) != 0 {
                            png_combine_row(png_ptr, dsp_row, 1);
                        }
                        png_read_finish_row(png_ptr);
                        return;
                    }
                }
                5 => {
                    if row_number & 1 != 0 || width_u < 2 {
                        if !dsp_row.is_null() {
                            png_combine_row(png_ptr, dsp_row, 1);
                        }
                        png_read_finish_row(png_ptr);
                        return;
                    }
                }
                _ => {
                    if row_number & 1 == 0 {
                        png_read_finish_row(png_ptr);
                        return;
                    }
                }
            }
        }

        if pp.mode as c_uint & PNG_HAVE_IDAT == 0 {
            png_error(
                png_ptr,
                b"Invalid attempt to read row data\0" as *const u8 as png_const_charp,
            );
        }

        let row_buf = pp.row_buf;
        let prev_row = pp.prev_row;

        *row_buf.offset(0) = 255 as png_byte;
        png_read_IDAT_data(
            png_ptr,
            row_buf,
            (row_info.rowbytes as png_alloc_size_t).wrapping_add(1),
        );

        let filter = *row_buf.offset(0) as c_int;
        if filter > PNG_FILTER_VALUE_NONE {
            if filter < PNG_FILTER_VALUE_LAST {
                png_read_filter_row(
                    png_ptr,
                    &raw mut row_info,
                    row_buf.offset(1),
                    prev_row.offset(1) as png_const_bytep,
                    filter,
                );
            } else {
                png_error(
                    png_ptr,
                    b"bad adaptive filter value\0" as *const u8 as png_const_charp,
                );
            }
        }

        memcpy(
            prev_row as *mut c_void,
            row_buf as *const c_void,
            (row_info.rowbytes as size_t).wrapping_add(1),
        );

        if pp.transformations != 0 {
            png_do_read_transformations(png_ptr, &raw mut row_info);
        }

        if pp.transformed_pixel_depth as c_int == 0 {
            pp.transformed_pixel_depth = row_info.pixel_depth;
            if row_info.pixel_depth as c_int > pp.maximum_pixel_depth as c_int {
                png_error(
                    png_ptr,
                    b"sequential row overflow\0" as *const u8 as png_const_charp,
                );
            }
        } else if pp.transformed_pixel_depth as c_int != row_info.pixel_depth as c_int {
            png_error(
                png_ptr,
                b"internal sequential row size calculation error\0" as *const u8
                    as png_const_charp,
            );
        }

        if interlace_xform {
            if (pp.pass as c_int) < 6 {
                png_do_read_interlace(
                    &raw mut row_info,
                    row_buf.offset(1),
                    pp.pass as c_int,
                    pp.transformations,
                );
            }
            if !dsp_row.is_null() {
                png_combine_row(png_ptr, dsp_row, 1);
            }
            if !row.is_null() {
                png_combine_row(png_ptr, row, 0);
            }
        } else {
            if !row.is_null() {
                png_combine_row(png_ptr, row, -1);
            }
            if !dsp_row.is_null() {
                png_combine_row(png_ptr, dsp_row, -1);
            }
        }

        png_read_finish_row(png_ptr);

        if let Some(read_row_fn) = pp.read_row_fn {
            read_row_fn(png_ptr as png_structp, pp.row_number, pp.pass as c_int);
        }
    }
}
