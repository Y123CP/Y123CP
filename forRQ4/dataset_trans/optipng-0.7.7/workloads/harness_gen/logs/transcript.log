fn write_seed(dir: &str, op: &str, idx: usize, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.{}.bin", dir, op, idx);
    let _ = fs::write(&path, bytes);
    out.push(format!("seed {} {}", op, path));
}

fn write_perf(dir: &str, op: &str, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.perf.bin", dir, op);
    let _ = fs::write(&path, bytes);
    out.push(format!("perf {} {}", op, path));
}

fn zlib_compress_bytes(data: &[u8], level: c_int) -> Vec<u8> {
    unsafe {
        let bound = compressBound(data.len() as c_ulong) as usize;
        let mut out = vec![0u8; bound.max(1)];
        let mut out_len = out.len() as c_ulong;
        let rc = compress2(
            out.as_mut_ptr(),
            &mut out_len,
            data.as_ptr(),
            data.len() as c_ulong,
            level,
        );
        if rc == 0 {
            out.truncate(out_len as usize);
            out
        } else {
            Vec::new()
        }
    }
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let _ = fs::create_dir_all(dir);
    let mut out = Vec::new();

    let a = make_text_seed_a();
    let b = make_text_seed_b();
    write_seed(dir, "zlib_compress_uncompress", 1, &a, &mut out);
    write_seed(dir, "zlib_compress_uncompress", 2, &b, &mut out);
    write_seed(dir, "zlib_deflate_inflate_stream", 1, &a, &mut out);
    write_seed(dir, "zlib_deflate_inflate_stream", 2, &b, &mut out);
    write_seed(dir, "zlib_gzip_advanced", 1, &a, &mut out);
    write_seed(dir, "zlib_gzip_advanced", 2, &b, &mut out);

    let c1 = zlib_compress_bytes(&a, 6);
    let c2 = zlib_compress_bytes(&b, 9);
    write_seed(dir, "zlib_inflate_back", 1, &c1, &mut out);
    write_seed(dir, "zlib_inflate_back", 2, &c2, &mut out);

    let p1 = make_gray_pixels_a();
    let p2 = make_gray_pixels_b();
    write_seed(dir, "png_write_read_roundtrip", 1, &p1, &mut out);
    write_seed(dir, "png_write_read_roundtrip", 2, &p2, &mut out);

    let pp1 = make_palette_pixels_a();
    let pp2 = make_palette_pixels_b();
    write_seed(dir, "png_palette_roundtrip", 1, &pp1, &mut out);
    write_seed(dir, "png_palette_roundtrip", 2, &pp2, &mut out);

    let g1 = make_gif_seed_a();
    let g2 = make_gif_seed_b();
    write_seed(dir, "gif_decode_blocks", 1, &g1, &mut out);
    write_seed(dir, "gif_decode_blocks", 2, &g2, &mut out);

    let n1 = make_pnm_seed_a();
    let n2 = make_pnm_seed_b();
    write_seed(dir, "pnm_roundtrip", 1, &n1, &mut out);
    write_seed(dir, "pnm_roundtrip", 2, &n2, &mut out);

    let r1 = make_rangeset_seed_a();
    let r2 = make_rangeset_seed_b();
    write_seed(dir, "bitset_and_ratio", 1, &r1, &mut out);
    write_seed(dir, "bitset_and_ratio", 2, &r2, &mut out);
    write_seed(dir, "ioutil_paths_and_files", 1, &a, &mut out);
    write_seed(dir, "ioutil_paths_and_files", 2, &b, &mut out);

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let _ = fs::create_dir_all(dir);
    let mut out = Vec::new();
    let big = make_perf_corpus();
    write_perf(dir, "zlib_compress_uncompress", &big, &mut out);
    write_perf(dir, "zlib_deflate_inflate_stream", &big, &mut out);
    write_perf(dir, "zlib_gzip_advanced", &big, &mut out);
    let big_comp = zlib_compress_bytes(&big, 6);
    write_perf(dir, "zlib_inflate_back", &big_comp, &mut out);
    write_perf(dir, "ioutil_paths_and_files", &big, &mut out);

    let mut png_big = vec![0u8; 512 * 512];
    for y in 0..512usize {
        for x in 0..512usize {
            png_big[y * 512 + x] = ((x * 3 + y * 5 + ((x ^ y) & 31)) & 0xff) as u8;
        }
    }
    write_perf(dir, "png_write_read_roundtrip", &png_big, &mut out);

    let mut pal_big = vec![0u8; 512 * 512];
    for y in 0..512usize {
        for x in 0..512usize {
            pal_big[y * 512 + x] = (((x / 8) + (y / 8) * 3) & 3) as u8;
        }
    }
    write_perf(dir, "png_palette_roundtrip", &pal_big, &mut out);

    let mut pnm_big = Vec::new();
    pnm_big.extend_from_slice(b"P5\n512 512\n255\n");
    pnm_big.extend_from_slice(&png_big);
    write_perf(dir, "pnm_roundtrip", &pnm_big, &mut out);

    out
}

pub fn zlib_compress_uncompress(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let input_crc_z = unsafe { crc32_z(0, data.as_ptr(), data.len()) as u64 };
    let input_adler = unsafe { adler32(1, data.as_ptr(), data.len() as c_uint) as u64 };
    let input_adler_z = unsafe { adler32_z(1, data.as_ptr(), data.len()) as u64 };
    let compile_flags = unsafe { zlibCompileFlags() as u64 };
    let crc_table_nonnull = unsafe { (!get_crc_table().is_null()) as u64 };
    let ver_len = unsafe {
        let p = zlibVersion();
        if p.is_null() {
            0
        } else {
            let mut n = 0usize;
            while *p.add(n) != 0 {
                n += 1;
            }
            n as u64
        }
    };

    let mut digest = fold(0, data.len() as u64);
    let mut last_c_rc = 0i32;
    let mut last_c1_rc = 0i32;
    let mut last_u_rc = 0i32;
    let mut last_u1_rc = 0i32;
    let mut last_eq = 0u64;
    let mut last_comp_len = 0u64;
    let mut last_decomp_len = 0u64;
    let mut last_out_crc = 0u64;
    let mut last_err_strlen = 0u64;
    let mut last_comb_crc = 0u64;
    let mut last_comb_adler = 0u64;

    for _ in 0..iters {
        unsafe {
            let bound = compressBound(data.len() as c_ulong) as usize;
            let mut comp = vec![0u8; bound.max(1)];
            let mut comp_len = bound as c_ulong;
            let c_rc = compress2(
                comp.as_mut_ptr(),
                &mut comp_len,
                data.as_ptr(),
                data.len() as c_ulong,
                6,
            );
            last_c_rc = c_rc;

            let mut comp1 = vec![0u8; bound.max(1)];
            let mut comp1_len = bound as c_ulong;
            let c1_rc = compress(
                comp1.as_mut_ptr(),
                &mut comp1_len,
                data.as_ptr(),
                data.len() as c_ulong,
            );
            last_c1_rc = c1_rc;
            last_comp_len = comp_len as u64;

            let mut decomp = vec![0u8; data.len().max(1)];
            let mut src_len = comp_len;
            let mut decomp_len = decomp.len() as c_ulong;
            let u_rc = uncompress2(
                decomp.as_mut_ptr(),
                &mut decomp_len,
                comp.as_ptr(),
                &mut src_len,
            );
            last_u_rc = u_rc;

            let mut decomp1 = vec![0u8; data.len().max(1)];
            let mut decomp1_len = decomp1.len() as c_ulong;
            let u1_rc = uncompress(
                decomp1.as_mut_ptr(),
                &mut decomp1_len,
                comp1.as_ptr(),
                comp1_len,
            );
            last_u1_rc = u1_rc;
            last_decomp_len = decomp_len as u64;

            let out_slice = &decomp[..(decomp_len as usize).min(decomp.len())];
            last_out_crc = crc32(0, out_slice.as_ptr(), out_slice.len() as c_uint) as u64;
            last_eq = (u_rc == 0 && out_slice == data) as u64;

            let mid = data.len() / 2;
            let crc_a = crc32(0, data.as_ptr(), mid as c_uint);
            let crc_b = crc32(0, data.as_ptr().add(mid), (data.len() - mid) as c_uint);
            last_comb_crc = crc32_combine(crc_a, crc_b, (data.len() - mid) as _) as u64
                ^ crc32_combine64(crc_a, crc_b, (data.len() - mid) as _) as u64;

            let ad_a = adler32(1, data.as_ptr(), mid as c_uint);
            let ad_b = adler32(1, data.as_ptr().add(mid), (data.len() - mid) as c_uint);
            last_comb_adler = adler32_combine(ad_a, ad_b, (data.len() - mid) as _) as u64
                ^ adler32_combine64(ad_a, ad_b, (data.len() - mid) as _) as u64;

            let err_ptr = zError(u_rc);
            last_err_strlen = if err_ptr.is_null() {
                0
            } else {
                let mut n = 0usize;
                while *err_ptr.add(n) != 0 {
                    n += 1;
                }
                n as u64
            };

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, input_crc_z);
            d = fold(d, input_adler);
            d = fold(d, input_adler_z);
            d = fold(d, compile_flags);
            d = fold(d, crc_table_nonnull);
            d = fold(d, ver_len);
            d = fold(d, c_rc as u32 as u64);
            d = fold(d, c1_rc as u32 as u64);
            d = fold(d, u_rc as u32 as u64);
            d = fold(d, u1_rc as u32 as u64);
            d = fold(d, comp_len as u64);
            d = fold(d, decomp_len as u64);
            d = fold(d, last_out_crc);
            d = fold(d, last_eq);
            d = fold(d, last_err_strlen);
            d = fold(d, last_comb_crc);
            d = fold(d, last_comb_adler);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=zlib_compress_uncompress in_len={} in_crc={:08x} in_crc_z={:08x} in_adler={:08x} in_adler_z={:08x} c_rc={} c1_rc={} u_rc={} u1_rc={} comp_len={} decomp_len={} out_crc={:08x} eq={} comb_crc={:08x} comb_adler={:08x} digest={:016x}",
        data.len(),
        input_crc,
        input_crc_z,
        input_adler,
        input_adler_z,
        last_c_rc,
        last_c1_rc,
        last_u_rc,
        last_u1_rc,
        last_comp_len,
        last_decomp_len,
        last_out_crc,
        last_eq,
        last_comb_crc,
        last_comb_adler,
        digest
    )
}

pub fn zlib_deflate_inflate_stream(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let ver_len = unsafe {
        let p = zlibVersion();
        if p.is_null() {
            0
        } else {
            let mut n = 0usize;
            while *p.add(n) != 0 {
                n += 1;
            }
            n as u64
        }
    };

    let dict_len = data.len().min(256);
    let dict = &data[..dict_len];
    let mut digest = fold(0, data.len() as u64);
    let mut last_init_d = 0i32;
    let mut last_set_dict = 0i32;
    let mut last_get_dict = 0i32;
    let mut last_params = 0i32;
    let mut last_tune = 0i32;
    let mut last_prime = 0i32;
    let mut last_pending = 0i32;
    let mut last_copy = 0i32;
    let mut last_def = 0i32;
    let mut last_reset_keep_d = 0i32;
    let mut last_reset_d = 0i32;
    let mut last_end_d = 0i32;
    let mut last_init_i = 0i32;
    let mut last_inf = 0i32;
    let mut last_set_idict = 0i32;
    let mut last_get_idict = 0i32;
    let mut last_copy_i = 0i32;
    let mut last_validate = 0i32;
    let mut last_undermine = 0i32;
    let mut last_sync = 0i32;
    let mut last_sync_point = 0i32;
    let mut last_reset_keep_i = 0i32;
    let mut last_reset2_i = 0i32;
    let mut last_reset_i = 0i32;
    let mut last_end_i = 0i32;
    let mut last_comp_size = 0u64;
    let mut last_decomp_size = 0u64;
    let mut last_out_crc = 0u64;
    let mut last_eq = 0u64;
    let mut last_err_strlen = 0u64;
    let mut last_pending_bits = 0u64;
    let mut last_pending_bytes = 0u64;
    let mut last_mark = 0u64;
    let mut last_codes_used = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut zs_def =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::deflate::z_stream_s>::zeroed()
                    .assume_init();
            let mut zs_def_copy =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::deflate::z_stream_s>::zeroed()
                    .assume_init();
            let mut zs_inf =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>::zeroed()
                    .assume_init();
            let mut zs_inf_copy =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>::zeroed()
                    .assume_init();

            let ver = zlibVersion();

            last_init_d = deflateInit2_(
                &mut zs_def as *mut _ as *mut _,
                6,
                8,
                15,
                8,
                0,
                ver,
                size_of::<optipng_0_7_7_raw::src::zlib::deflate::z_stream_s>() as c_int,
            );

            let mut dict_buf = vec![0u8; dict_len.max(1)];
            let mut got_dict_len = 0u32;
            if last_init_d == 0 {
                last_set_dict = deflateSetDictionary(
                    &mut zs_def as *mut _ as *mut _,
                    dict.as_ptr(),
                    dict_len as c_uint,
                );
                last_get_dict = deflateGetDictionary(
                    &mut zs_def as *mut _ as *mut _,
                    dict_buf.as_mut_ptr(),
                    &mut got_dict_len,
                );
                last_params = deflateParams(&mut zs_def as *mut _ as *mut _, 5, 1);
                last_tune = deflateTune(&mut zs_def as *mut _ as *mut _, 4, 4, 16, 32);
                last_prime = deflatePrime(&mut zs_def as *mut _ as *mut _, 3, 5);
            } else {
                last_set_dict = -9999;
                last_get_dict = -9999;
                last_params = -9999;
                last_tune = -9999;
                last_prime = -9999;
            }

            let bound = if last_init_d == 0 {
                deflateBound(&mut zs_def as *mut _ as *mut _, data.len() as c_ulong) as usize + 64
            } else {
                data.len().saturating_mul(2).saturating_add(64)
            };
            let mut comp = vec![0u8; bound.max(1)];

            zs_def.next_in = data.as_ptr() as *mut _;
            zs_def.avail_in = data.len() as c_uint;
            zs_def.next_out = comp.as_mut_ptr();
            zs_def.avail_out = comp.len() as c_uint;

            let mut pending = 0u32;
            let mut bits = 0i32;
            last_pending = if last_init_d == 0 {
                deflatePending(&mut zs_def as *mut _ as *mut _, &mut pending, &mut bits)
            } else {
                -9999
            };

            last_copy = if last_init_d == 0 {
                deflateCopy(
                    &mut zs_def_copy as *mut _ as *mut _,
                    &mut zs_def as *mut _ as *mut _,
                )
            } else {
                -9999
            };

            last_def = if last_init_d == 0 {
                deflate(&mut zs_def as *mut _ as *mut _, 4)
            } else {
                -9999
            };
            last_comp_size = (comp.len() as u64).wrapping_sub(zs_def.avail_out as u64);
            last_pending_bytes = pending as u64;
            last_pending_bits = bits as u64;

            if last_copy == 0 {
                let _ = deflateEnd(&mut zs_def_copy as *mut _ as *mut _);
            }

            last_reset_keep_d = if last_init_d == 0 {
                deflateResetKeep(&mut zs_def as *mut _ as *mut _)
            } else {
                -9999
            };
            last_reset_d = if last_init_d == 0 {
                deflateReset(&mut zs_def as *mut _ as *mut _)
            } else {
                -9999
            };
            last_end_d = if last_init_d == 0 {
                deflateEnd(&mut zs_def as *mut _ as *mut _)
            } else {
                -9999
            };

            last_init_i = inflateInit2_(
                &mut zs_inf as *mut _ as *mut _,
                15,
                ver,
                size_of::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>() as c_int,
            );

            let mut decomp = vec![0u8; data.len().max(1)];
            zs_inf.next_in = comp.as_ptr() as *mut _;
            zs_inf.avail_in = last_comp_size as c_uint;
            zs_inf.next_out = decomp.as_mut_ptr();
            zs_inf.avail_out = decomp.len() as c_uint;

            if last_init_i == 0 {
                last_validate = inflateValidate(&mut zs_inf as *mut _ as *mut _, 1);
                last_undermine = inflateUndermine(&mut zs_inf as *mut _ as *mut _, 0);
                let mut hdr = MaybeUninit::<gz_header_s>::zeroed().assume_init();
                let _ = inflateGetHeader(&mut zs_inf as *mut _ as *mut _, &mut hdr as *mut _);
                let _ = inflatePrime(&mut zs_inf as *mut _ as *mut _, 0, 0);
            } else {
                last_validate = -9999;
                last_undermine = -9999;
            }

            last_inf = if last_init_i == 0 {
                let rc = inflate(&mut zs_inf as *mut _ as *mut _, 4);
                if rc == 2 && dict_len > 0 {
                    last_set_idict = inflateSetDictionary(
                        &mut zs_inf as *mut _ as *mut _,
                        dict.as_ptr(),
                        dict_len as c_uint,
                    );
                    inflate(&mut zs_inf as *mut _ as *mut _, 4)
                } else {
                    last_set_idict = -7777;
                    rc
                }
            } else {
                -9999
            };
            last_decomp_size = (decomp.len() as u64).wrapping_sub(zs_inf.avail_out as u64);
            let out_slice = &decomp[..(last_decomp_size as usize).min(decomp.len())];
            last_out_crc = crc32(0, out_slice.as_ptr(), out_slice.len() as c_uint) as u64;
            last_eq = (out_slice == data) as u64;

            let mut idict = vec![0u8; dict_len.max(1)];
            let mut idict_len = 0u32;
            last_get_idict = if last_init_i == 0 {
                inflateGetDictionary(
                    &mut zs_inf as *mut _ as *mut _,
                    idict.as_mut_ptr(),
                    &mut idict_len,
                )
            } else {
                -9999
            };
            last_copy_i = if last_init_i == 0 {
                inflateCopy(
                    &mut zs_inf_copy as *mut _ as *mut _,
                    &mut zs_inf as *mut _ as *mut _,
                )
            } else {
                -9999
            };
            if last_copy_i == 0 {
                let _ = inflateEnd(&mut zs_inf_copy as *mut _ as *mut _);
            }

            last_sync = if last_init_i == 0 {
                inflateSync(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };
            last_sync_point = if last_init_i == 0 {
                inflateSyncPoint(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };
            last_mark = if last_init_i == 0 {
                inflateMark(&mut zs_inf as *mut _ as *mut _) as u64
            } else {
                0
            };
            last_codes_used = if last_init_i == 0 {
                inflateCodesUsed(&mut zs_inf as *mut _ as *mut _) as u64
            } else {
                0
            };
            last_reset_keep_i = if last_init_i == 0 {
                inflateResetKeep(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };
            last_reset2_i = if last_init_i == 0 {
                inflateReset2(&mut zs_inf as *mut _ as *mut _, 15)
            } else {
                -9999
            };
            last_reset_i = if last_init_i == 0 {
                inflateReset(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };
            last_end_i = if last_init_i == 0 {
                inflateEnd(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };

            let err_ptr = zError(last_inf);
            last_err_strlen = if err_ptr.is_null() {
                0
            } else {
                let mut n = 0usize;
                while *err_ptr.add(n) != 0 {
                    n += 1;
                }
                n as u64
            };

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, ver_len);
            d = fold(d, last_init_d as u32 as u64);
            d = fold(d, last_set_dict as u32 as u64);
            d = fold(d, last_get_dict as u32 as u64);
            d = fold(d, got_dict_len as u64);
            d = fold(d, last_params as u32 as u64);
            d = fold(d, last_tune as u32 as u64);
            d = fold(d, last_prime as u32 as u64);
            d = fold(d, last_pending as u32 as u64);
            d = fold(d, last_pending_bytes);
            d = fold(d, last_pending_bits);
            d = fold(d, last_copy as u32 as u64);
            d = fold(d, last_def as u32 as u64);
            d = fold(d, last_reset_keep_d as u32 as u64);
            d = fold(d, last_reset_d as u32 as u64);
            d = fold(d, last_end_d as u32 as u64);
            d = fold(d, last_init_i as u32 as u64);
            d = fold(d, last_inf as u32 as u64);
            d = fold(d, last_set_idict as u32 as u64);
            d = fold(d, last_get_idict as u32 as u64);
            d = fold(d, idict_len as u64);
            d = fold(d, last_copy_i as u32 as u64);
            d = fold(d, last_validate as u32 as u64);
            d = fold(d, last_undermine as u32 as u64);
            d = fold(d, last_sync as u32 as u64);
            d = fold(d, last_sync_point as u32 as u64);
            d = fold(d, last_mark);
            d = fold(d, last_codes_used);
            d = fold(d, last_reset_keep_i as u32 as u64);
            d = fold(d, last_reset2_i as u32 as u64);
            d = fold(d, last_reset_i as u32 as u64);
            d = fold(d, last_end_i as u32 as u64);
            d = fold(d, last_comp_size);
            d = fold(d, last_decomp_size);
            d = fold(d, last_out_crc);
            d = fold(d, last_eq);
            d = fold(d, last_err_strlen);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=zlib_deflate_inflate_stream in_len={} in_crc={:08x} dinit={} setdict={} getdict={} params={} tune={} prime={} pending={} copy={} def={} dresetk={} dreset={} dend={} iinit={} inf={} setidict={} getidict={} copyi={} validate={} undermine={} sync={} syncpt={} iresetk={} ireset2={} ireset={} iend={} comp={} decomp={} out_crc={:08x} eq={} digest={:016x}",
        data.len(),
        input_crc,
        last_init_d,
        last_set_dict,
        last_get_dict,
        last_params,
        last_tune,
        last_prime,
        last_pending,
        last_copy,
        last_def,
        last_reset_keep_d,
        last_reset_d,
        last_end_d,
        last_init_i,
        last_inf,
        last_set_idict,
        last_get_idict,
        last_copy_i,
        last_validate,
        last_undermine,
        last_sync,
        last_sync_point,
        last_reset_keep_i,
        last_reset2_i,
        last_reset_i,
        last_end_i,
        last_comp_size,
        last_decomp_size,
        last_out_crc,
        last_eq,
        digest
    )
}

pub fn zlib_gzip_advanced(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);

    let mut last_w = 0i32;
    let mut last_fw = 0u64;
    let mut last_putc = 0i32;
    let mut last_puts = 0i32;
    let mut last_setparams = 0i32;
    let mut last_flush = 0i32;
    let mut last_tell_w = 0u64;
    let mut last_off_w = 0u64;
    let mut last_close_w = 0i32;
    let mut last_r = 0i32;
    let mut last_fr = 0u64;
    let mut last_getc = 0i32;
    let mut last_getc2 = 0i32;
    let mut last_ungetc = 0i32;
    let mut last_gets_len = 0u64;
    let mut last_direct = 0i32;
    let mut last_seek = 0u64;
    let mut last_seek64 = 0u64;
    let mut last_tell = 0u64;
    let mut last_tell64 = 0u64;
    let mut last_off = 0u64;
    let mut last_off64 = 0u64;
    let mut last_rewind = 0i32;
    let mut last_eof = 0i32;
    let mut last_errnum = 0i32;
    let mut last_close_r = 0i32;
    let mut last_total_read = 0u64;
    let mut last_out_crc = 0u64;
    let mut last_eq = 0u64;
    let mut last_err_strlen = 0u64;
    let line = match CString::new("line-from-gzputs\n") {
        Ok(v) => v,
        Err(_) => unsafe { CString::from_vec_unchecked(vec![b'x']) },
    };

    for iter in 0..iters {
        let path = format!(
            "{}/optipng_raw_harness_gzip_adv_{}_{}.gz",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let c_path = cstring_lossy_no_nul(&path);
        let mode_w = match CString::new("wb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'w', b'b']) },
        };
        let mode_r = match CString::new("rb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b']) },
        };

        unsafe {
            let wf = gzopen64(c_path.as_ptr(), mode_w.as_ptr());
            if (wf as *mut c_void).is_null() {
                digest = fold(digest, 0x1111);
                let _ = fs::remove_file(&path);
                continue;
            }

            let _ = gzbuffer(wf as *mut _, 32768);
            let split = data.len().min(64);
            last_w = gzwrite(wf as *mut _, data.as_ptr() as *const c_void, split as c_uint);
            last_fw = gzfwrite(
                data[split..].as_ptr() as *const c_void,
                1,
                data.len().saturating_sub(split),
                wf as *mut _,
            ) as u64;
            last_putc = gzputc(wf as *mut _, b'!' as c_int);
            last_puts = gzputs(wf as *mut _, line.as_ptr());
            last_setparams = gzsetparams(wf as *mut _, 6, 0);
            last_flush = gzflush(wf as *mut _, 2);
            last_tell_w = gztell(wf as *mut _) as u64;
            last_off_w = gzoffset(wf as *mut _) as u64;
            last_close_w = gzclose_w(wf as *mut _);

            let rf = gzopen(c_path.as_ptr(), mode_r.as_ptr());
            if (rf as *mut c_void).is_null() {
                digest = fold(digest, 0x2222);
                let _ = fs::remove_file(&path);
                continue;
            }

            let _ = gzbuffer(rf as *mut _, 16384);
            last_direct = gzdirect(rf as *mut _);
            last_getc = gzgetc(rf as *mut _);
            last_ungetc = gzungetc(last_getc, rf as *mut _);
            last_getc2 = gzgetc_(rf as *mut _);

            let mut linebuf = vec![0i8; 128];
            let gp = gzgets(rf as *mut _, linebuf.as_mut_ptr(), linebuf.len() as c_int);
            last_gets_len = if gp.is_null() {
                0
            } else {
                let mut n = 0usize;
                while n < linebuf.len() && linebuf[n] != 0 {
                    n += 1;
                }
                n as u64
            };

            last_seek = gzseek(rf as *mut _, 0, 0) as u64;
            last_tell = gztell(rf as *mut _) as u64;
            last_off = gzoffset(rf as *mut _) as u64;

            let mut out = Vec::with_capacity(data.len().saturating_add(64));
            let mut buf = vec![0u8; 4096];
            loop {
                let n = gzread(rf as *mut _, buf.as_mut_ptr() as *mut c_void, buf.len() as c_uint);
                last_r = n;
                if n > 0 {
                    out.extend_from_slice(&buf[..n as usize]);
                } else {
                    break;
                }
            }

            last_seek64 = gzseek64(rf as *mut _, 0, 0) as u64;
            last_tell64 = gztell64(rf as *mut _) as u64;
            last_off64 = gzoffset64(rf as *mut _) as u64;

            let mut out2 = vec![0u8; 256];
            last_fr =
                gzfread(out2.as_mut_ptr() as *mut c_void, 1, out2.len(), rf as *mut _) as u64;
            last_rewind = gzrewind(rf as *mut _);
            last_eof = gzeof(rf as *mut _);
            let mut errnum = 0i32;
            let errp = gzerror(rf as *mut _, &mut errnum);
            last_errnum = errnum;
            last_err_strlen = if errp.is_null() {
                0
            } else {
                let mut n = 0usize;
                while *errp.add(n) != 0 {
                    n += 1;
                }
                n as u64
            };
            gzclearerr(rf as *mut _);
            last_close_r = gzclose_r(rf as *mut _);

            last_total_read = out.len() as u64;
            last_out_crc = crc32(0, out.as_ptr(), out.len() as c_uint) as u64;
            last_eq = out.starts_with(data) as u64;

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, last_w as u32 as u64);
            d = fold(d, last_fw);
            d = fold(d, last_putc as u32 as u64);
            d = fold(d, last_puts as u32 as u64);
            d = fold(d, last_setparams as u32 as u64);
            d = fold(d, last_flush as u32 as u64);
            d = fold(d, last_tell_w);
            d = fold(d, last_off_w);
            d = fold(d, last_close_w as u32 as u64);
            d = fold(d, last_r as u32 as u64);
            d = fold(d, last_fr);
            d = fold(d, last_getc as u32 as u64);
            d = fold(d, last_getc2 as u32 as u64);
            d = fold(d, last_ungetc as u32 as u64);
            d = fold(d, last_gets_len);
            d = fold(d, last_direct as u32 as u64);
            d = fold(d, last_seek);
            d = fold(d, last_seek64);
            d = fold(d, last_tell);
            d = fold(d, last_tell64);
            d = fold(d, last_off);
            d = fold(d, last_off64);
            d = fold(d, last_rewind as u32 as u64);
            d = fold(d, last_eof as u32 as u64);
            d = fold(d, last_errnum as u32 as u64);
            d = fold(d, last_close_r as u32 as u64);
            d = fold(d, last_total_read);
            d = fold(d, last_out_crc);
            d = fold(d, last_eq);
            d = fold(d, last_err_strlen);
            digest = fold(digest, d);
        }

        let _ = fs::remove_file(&path);
    }

    format!(
        "op=zlib_gzip_advanced in_len={} in_crc={:08x} w={} fw={} putc={} puts={} setp={} flush={} tellw={} offw={} closew={} r={} fr={} getc={} getc2={} ungetc={} getslen={} direct={} seek={} seek64={} tell={} tell64={} off={} off64={} rewind={} eof={} errnum={} closer={} total_read={} out_crc={:08x} eq={} digest={:016x}",
        data.len(),
        input_crc,
        last_w,
        last_fw,
        last_putc,
        last_puts,
        last_setparams,
        last_flush,
        last_tell_w,
        last_off_w,
        last_close_w,
        last_r,
        last_fr,
        last_getc,
        last_getc2,
        last_ungetc,
        last_gets_len,
        last_direct,
        last_seek,
        last_seek64,
        last_tell,
        last_tell64,
        last_off,
        last_off64,
        last_rewind,
        last_eof,
        last_errnum,
        last_close_r,
        last_total_read,
        last_out_crc,
        last_eq,
        digest
    )
}

#[repr(C)]
struct InflateBackIn {
    data: Vec<u8>,
    pos: usize,
    scratch: Vec<u8>,
}

#[repr(C)]
struct InflateBackOut {
    out: Vec<u8>,
}

unsafe extern "C" fn infback_in(desc: *mut c_void, buf: *mut *mut c_uchar) -> c_uint {
    if desc.is_null() || buf.is_null() {
        return 0;
    }
    let st = &mut *(desc as *mut InflateBackIn);
    if st.pos >= st.data.len() {
        *buf = ptr::null_mut();
        return 0;
    }
    let take = (st.data.len() - st.pos).min(4096);
    st.scratch.clear();
    st.scratch
        .extend_from_slice(&st.data[st.pos..st.pos + take]);
    st.pos += take;
    *buf = st.scratch.as_mut_ptr();
    take as c_uint
}

unsafe extern "C" fn infback_out(desc: *mut c_void, buf: *mut c_uchar, len: c_uint) -> c_int {
    if desc.is_null() || (buf.is_null() && len != 0) {
        return 1;
    }
    let st = &mut *(desc as *mut InflateBackOut);
    let slice = std::slice::from_raw_parts(buf as *const u8, len as usize);
    st.out.extend_from_slice(slice);
    0
}

pub fn zlib_inflate_back(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);
    let mut last_init = 0i32;
    let mut last_back = 0i32;
    let mut last_end = 0i32;
    let mut last_out_len = 0u64;
    let mut last_out_crc = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut zs =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>::zeroed()
                    .assume_init();
            let mut window = vec![0u8; 1 << 15];
            let ver = zlibVersion();
            last_init = inflateBackInit_(
                &mut zs as *mut _ as *mut _,
                15,
                window.as_mut_ptr(),
                ver,
                size_of::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>() as c_int,
            );

            let mut in_state = InflateBackIn {
                data: data.to_vec(),
                pos: 0,
                scratch: Vec::new(),
            };
            let mut out_state = InflateBackOut { out: Vec::new() };

            last_back = if last_init == 0 {
                inflateBack(
                    &mut zs as *mut _ as *mut _,
                    Some(infback_in),
                    &mut in_state as *mut _ as *mut c_void,
                    Some(infback_out),
                    &mut out_state as *mut _ as *mut c_void,
                )
            } else {
                -9999
            };
            last_end = if last_init == 0 {
                inflateBackEnd(&mut zs as *mut _ as *mut _)
            } else {
                -9999
            };
            last_out_len = out_state.out.len() as u64;
            last_out_crc = crc32(0, out_state.out.as_ptr(), out_state.out.len() as c_uint) as u64;

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, last_init as u32 as u64);
            d = fold(d, last_back as u32 as u64);
            d = fold(d, last_end as u32 as u64);
            d = fold(d, last_out_len);
            d = fold(d, last_out_crc);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=zlib_inflate_back in_len={} in_crc={:08x} init={} back={} end={} out_len={} out_crc={:08x} digest={:016x}",
        data.len(),
        input_crc,
        last_init,
        last_back,
        last_end,
        last_out_len,
        last_out_crc,
        digest
    )
}

#[repr(C)]
struct MemWriter {
    buf: Vec<u8>,
    failed: c_int,
}

#[repr(C)]
struct MemReader {
    data: Vec<u8>,
    pos: usize,
    failed: c_int,
}

extern "C" fn png_write_cb(
    png_ptr: *mut optipng_0_7_7_raw::src::libpng::pngwio::png_struct_def,
    data: *mut optipng_0_7_7_raw::src::libpng::pngwio::png_byte,
    length: optipng_0_7_7_raw::src::libpng::pngwio::png_size_t,
) {
    unsafe {
        let io_ptr = png_get_io_ptr(png_ptr as *const _);
        if io_ptr.is_null() {
            return;
        }
        let st = &mut *(io_ptr as *mut MemWriter);
        let len = length as usize;
        if data.is_null() {
            st.failed = 1;
            return;
        }
        let slice = std::slice::from_raw_parts(data as *const u8, len);
        st.buf.extend_from_slice(slice);
    }
}

extern "C" fn png_flush_cb(_png_ptr: *mut optipng_0_7_7_raw::src::libpng::pngwio::png_struct_def) {}

extern "C" fn png_read_cb(
    png_ptr: *mut optipng_0_7_7_raw::src::libpng::pngrio::png_struct_def,
    out_bytes: *mut optipng_0_7_7_raw::src::libpng::pngrio::png_byte,
    length: optipng_0_7_7_raw::src::libpng::pngrio::png_size_t,
) {
    unsafe {
        let io_ptr = png_get_io_ptr(png_ptr as *const _);
        if io_ptr.is_null() {
            return;
        }
        let st = &mut *(io_ptr as *mut MemReader);
        let len = length as usize;
        if out_bytes.is_null() || st.pos > st.data.len() || st.pos + len > st.data.len() {
            st.failed = 1;
            return;
        }
        ptr::copy_nonoverlapping(st.data.as_ptr().add(st.pos), out_bytes, len);
        st.pos += len;
    }
}

extern "C" fn png_noop_error(
    _png_ptr: *mut optipng_0_7_7_raw::src::libpng::pngerror::png_struct_def,
    _msg: *const c_char,
) {
}

extern "C" fn png_noop_warn(
    _png_ptr: *mut optipng_0_7_7_raw::src::libpng::pngerror::png_struct_def,
    _msg: *const c_char,
) {
}

pub fn png_write_read_roundtrip(data: &[u8], iters: u64) -> String {
    let width = 32u32;
    let height = ((data.len() as u32).saturating_add(width - 1) / width).max(1);
    let rowbytes = width as usize;
    let total = rowbytes * height as usize;

    let mut pixels = vec![0u8; total];
    let copy_len = data.len().min(total);
    pixels[..copy_len].copy_from_slice(&data[..copy_len]);

    let mut row_ptrs: Vec<*mut c_uchar> = Vec::with_capacity(height as usize);
    for y in 0..height as usize {
        row_ptrs.push(pixels[y * rowbytes..].as_mut_ptr());
    }

    let input_fold = fold_bytes(0, &pixels);
    let version_num = unsafe { png_access_version_number() as u64 };

    let mut digest = fold(0, data.len() as u64);
    let mut last_sig_cmp = -1i32;
    let mut last_png_size = 0u64;
    let mut last_w = 0u64;
    let mut last_h = 0u64;
    let mut last_rb = 0u64;
    let mut last_rows_null = 1u64;
    let mut last_dec_crc = 0u64;
    let mut last_eq = 0u64;
    let mut last_write_ok = 0u64;
    let mut last_read_ok = 0u64;
    let mut last_bd = 0u64;
    let mut last_ct = 0u64;
    let mut last_ch = 0u64;
    let mut last_it = 0u64;
    let mut last_ft = 0u64;
    let mut last_cmp = 0u64;
    let mut last_valid = 0u64;
    let mut last_reduce = 0u64;
    let mut last_validate = 0u64;
    let mut last_fmt_len = 0u64;
    let mut last_warnbuf = 0u64;
    let mut last_alloc_fold = 0u64;

    for _ in 0..iters {
        unsafe {
            let ver = png_get_libpng_ver(ptr::null());
            let mut writer = MemWriter {
                buf: Vec::new(),
                failed: 0,
            };

            let png_w = png_create_write_struct(ver, ptr::null_mut(), None, None);
            if png_w.is_null() {
                digest = fold(digest, 1);
                continue;
            }
            let info_w = png_create_info_struct(png_w as *const _);
            if info_w.is_null() {
                let mut pw = png_w;
                png_destroy_write_struct(&mut pw, ptr::null_mut());
                digest = fold(digest, 2);
                continue;
            }

            png_set_error_fn(
                png_w as *mut _,
                ptr::null_mut(),
                Some(png_noop_error),
                Some(png_noop_warn),
            );
            png_set_compression_level(png_w as *mut _, 6);
            png_set_compression_mem_level(png_w as *mut _, 8);
            png_set_compression_window_bits(png_w as *mut _, 15);
            png_set_compression_method(png_w as *mut _, 8);
            png_set_compression_strategy(png_w as *mut _, 0);
            png_set_filter(png_w as *mut _, 0, 0x08 | 0x10);
            png_set_flush(png_w as *mut _, 4);
            png_set_compression_buffer_size(png_w as *mut _, 8192);
            png_set_user_limits(png_w as *mut _, width, height);
            png_set_chunk_cache_max(png_w as *mut _, 64);
            png_set_chunk_malloc_max(png_w as *mut _, 1 << 20);
            png_set_benign_errors(png_w as *mut _, 1);
            png_set_check_for_invalid_index(png_w as *mut _, 1);
            png_set_keep_unknown_chunks(png_w as *mut _, 2, ptr::null(), 0);

            png_set_IHDR(
                png_w as *const _,
                info_w as *mut _,
                width,
                height,
                8,
                0,
                0,
                0,
                0,
            );
            png_set_rows(png_w as *const _, info_w as *mut _, row_ptrs.as_mut_ptr() as *mut _);
            png_set_write_fn(
                png_w as *mut _,
                &mut writer as *mut _ as *mut c_void,
                Some(png_write_cb),
                Some(png_flush_cb),
            );
            png_write_png(png_w as *mut _, info_w as *mut _, 0, ptr::null_mut());
            last_write_ok = (writer.failed == 0) as u64;
            last_png_size = writer.buf.len() as u64;

            let mut pw = png_w;
            let mut iw = info_w;
            png_destroy_write_struct(&mut pw, &mut iw as *mut _ as *mut _);

            last_sig_cmp = if writer.buf.len() >= 8 {
                png_sig_cmp(writer.buf.as_ptr(), 0, 8)
            } else {
                -1
            };

            let mut reader = MemReader {
                data: writer.buf,
                pos: 0,
                failed: 0,
            };

            let png_r = png_create_read_struct(ver, ptr::null_mut(), None, None);
            if png_r.is_null() {
                digest = fold(digest, 3);
                continue;
            }
            let info_r = png_create_info_struct(png_r as *const _);
            if info_r.is_null() {
                let mut pr = png_r;
                png_destroy_read_struct(&mut pr, ptr::null_mut(), ptr::null_mut());
                digest = fold(digest, 4);
                continue;
            }

            png_set_error_fn(
                png_r as *mut _,
                ptr::null_mut(),
                Some(png_noop_error),
                Some(png_noop_warn),
            );
            png_set_crc_action(png_r as *mut _, 1, 1);
            png_set_user_limits(png_r as *mut _, width * 2, height * 2);
            png_set_benign_errors(png_r as *mut _, 1);
            png_set_check_for_invalid_index(png_r as *mut _, 1);
            png_set_read_fn(
                png_r as *mut _,
                &mut reader as *mut _ as *mut c_void,
                Some(png_read_cb),
            );
            png_read_png(png_r as *mut _, info_r as *mut _, 0, ptr::null_mut());
            last_read_ok = (reader.failed == 0) as u64;

            last_w = png_get_image_width(png_r as *const _, info_r as *const _) as u64;
            last_h = png_get_image_height(png_r as *const _, info_r as *const _) as u64;
            last_rb = png_get_rowbytes(png_r as *const _, info_r as *const _) as u64;
            last_bd = png_get_bit_depth(png_r as *const _, info_r as *const _) as u64;
            last_ct = png_get_color_type(png_r as *const _, info_r as *const _) as u64;
            last_ch = png_get_channels(png_r as *const _, info_r as *const _) as u64;
            last_it = png_get_interlace_type(png_r as *const _, info_r as *const _) as u64;
            last_ft = png_get_filter_type(png_r as *const _, info_r as *const _) as u64;
            last_cmp = png_get_compression_type(png_r as *const _, info_r as *const _) as u64;
            last_valid = png_get_valid(png_r as *const _, info_r as *const _, 0xffff_ffff) as u64;
            let rows = png_get_rows(png_r as *const _, info_r as *const _);
            last_rows_null = rows.is_null() as u64;

            let mut ih_w = 0u32;
            let mut ih_h = 0u32;
            let mut ih_bd = 0i32;
            let mut ih_ct = 0i32;
            let mut ih_it = 0i32;
            let mut ih_cmp = 0i32;
            let mut ih_ft = 0i32;
            let _ = png_get_IHDR(
                png_r as *const _,
                info_r as *const _,
                &mut ih_w,
                &mut ih_h,
                &mut ih_bd,
                &mut ih_ct,
                &mut ih_it,
                &mut ih_cmp,
                &mut ih_ft,
            );

            let mut dec = Vec::new();
            if !rows.is_null() && last_h > 0 && last_rb > 0 {
                let h = last_h as usize;
                let rb = last_rb as usize;
                dec.reserve(h.saturating_mul(rb));
                for y in 0..h {
                    let rp = *rows.add(y);
                    if rp.is_null() {
                        break;
                    }
                    let slice = std::slice::from_raw_parts(rp as *const u8, rb);
                    dec.extend_from_slice(slice);
                }
            }

            last_dec_crc = crc32(0, dec.as_ptr(), dec.len() as c_uint) as u64;
            last_eq = (dec == pixels) as u64;
            last_validate = opng_validate_image(png_r as *mut _, info_r as *mut _) as u64;
            last_reduce = opng_reduce_image(png_r as *mut _, info_r as *mut _, 0xffff_ffff) as u64;

            let mut numbuf = vec![0i8; 64];
            let endp = numbuf.as_mut_ptr().add(numbuf.len() - 1);
            let p = png_format_number(ptr::null(), endp, 0, last_png_size as _);
            last_fmt_len = if p.is_null() {
                0
            } else {
                let mut n = 0usize;
                while n < numbuf.len() && numbuf[n] != 0 {
                    n += 1;
                }
                n as u64
            };

            let mut warn_params = [[0i8; 32]; 8];
            png_warning_parameter(
                warn_params.as_mut_ptr(),
                0,
                cstring_lossy_no_nul("gray").as_ptr(),
            );
            png_warning_parameter_unsigned(warn_params.as_mut_ptr(), 1, 0, last_png_size as _);
            png_warning_parameter_signed(warn_params.as_mut_ptr(), 2, 0, ih_bd as _);
            let mut wb = 0u64;
            for arr in &warn_params {
                for &ch in arr {
                    wb = fold(wb, ch as u8 as u64);
                }
            }
            last_warnbuf = wb;

            let a1 = png_malloc_base(png_r as *const _, 32);
            let a2 = png_malloc_warn(png_r as *const _, 16);
            let a3 = png_malloc(png_r as *const _, 24);
            let a4 = png_calloc(png_r as *const _, 40);
            let a5 = png_malloc_array(png_r as *const _, 4, 8);
            let a6 = png_realloc_array(png_r as *const _, a5, 4, 2, 8);
            let mut af = 0u64;
            af = fold(af, (!a1.is_null()) as u64);
            af = fold(af, (!a2.is_null()) as u64);
            af = fold(af, (!a3.is_null()) as u64);
            af = fold(af, (!a4.is_null()) as u64);
            af = fold(af, (!a5.is_null()) as u64);
            af = fold(af, (!a6.is_null()) as u64);
            if !a1.is_null() {
                png_free(png_r as *const _, a1);
            }
            if !a2.is_null() {
                png_free(png_r as *const _, a2);
            }
            if !a3.is_null() {
                png_free(png_r as *const _, a3);
            }
            if !a4.is_null() {
                png_free(png_r as *const _, a4);
            }
            if !a6.is_null() {
                png_free(png_r as *const _, a6);
            } else if !a5.is_null() {
                png_free(png_r as *const _, a5);
            }
            last_alloc_fold = af;

            let mut pr = png_r;
            let mut ir = info_r;
            png_destroy_read_struct(&mut pr, &mut ir as *mut _ as *mut _, ptr::null_mut());

            let mut d = 0u64;
            d = fold(d, input_fold);
            d = fold(d, version_num);
            d = fold(d, last_sig_cmp as u32 as u64);
            d = fold(d, last_png_size);
            d = fold(d, last_w);
            d = fold(d, last_h);
            d = fold(d, last_rb);
            d = fold(d, last_rows_null);
            d = fold(d, last_dec_crc);
            d = fold(d, last_eq);
            d = fold(d, last_write_ok);
            d = fold(d, last_read_ok);
            d = fold(d, last_bd);
            d = fold(d, last_ct);
            d = fold(d, last_ch);
            d = fold(d, last_it);
            d = fold(d, last_ft);
            d = fold(d, last_cmp);
            d = fold(d, last_valid);
            d = fold(d, last_reduce);
            d = fold(d, last_validate);
            d = fold(d, last_fmt_len);
            d = fold(d, last_warnbuf);
            d = fold(d, last_alloc_fold);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=png_write_read_roundtrip in_len={} sig_cmp={} png_size={} width={} height={} rowbytes={} rows_null={} dec_crc={:08x} eq={} w_ok={} r_ok={} bd={} ct={} ch={} it={} ft={} cmp={} valid={} reduce={} validate={} digest={:016x}",
        data.len(),
        last_sig_cmp,
        last_png_size,
        last_w,
        last_h,
        last_rb,
        last_rows_null,
        last_dec_crc,
        last_eq,
        last_write_ok,
        last_read_ok,
        last_bd,
        last_ct,
        last_ch,
        last_it,
        last_ft,
        last_cmp,
        last_valid,
        last_reduce,
        last_validate,
        digest
    )
}

pub fn png_palette_roundtrip(data: &[u8], iters: u64) -> String {
    let width = 32u32;
    let height = ((data.len() as u32).saturating_add(width - 1) / width).max(1);
    let rowbytes = width as usize;
    let total = rowbytes * height as usize;

    let mut pixels = vec![0u8; total];
    for i in 0..total {
        pixels[i] = data.get(i).copied().unwrap_or(0) & 3;
    }

    let mut row_ptrs: Vec<*mut c_uchar> = Vec::with_capacity(height as usize);
    for y in 0..height as usize {
        row_ptrs.push(pixels[y * rowbytes..].as_mut_ptr());
    }

    let input_fold = fold_bytes(0, &pixels);
    let mut digest = fold(0, data.len() as u64);
    let mut last_png_size = 0u64;
    let mut last_plte = 0u64;
    let mut last_hist = 0u64;
    let mut last_trns = 0u64;
    let mut last_bkgd = 0u64;
    let mut last_interlace_passes = 0u64;
    let mut last_dec_crc = 0u64;
    let mut last_eq = 0u64;

    for _ in 0..iters {
        unsafe {
            let ver = png_get_libpng_ver(ptr::null());
            let mut writer = MemWriter {
                buf: Vec::new(),
                failed: 0,
            };

            let png_w = png_create_write_struct(ver, ptr::null_mut(), None, None);
            if png_w.is_null() {
                digest = fold(digest, 11);
                continue;
            }
            let info_w = png_create_info_struct(png_w as *const _);
            if info_w.is_null() {
                let mut pw = png_w;
                png_destroy_write_struct(&mut pw, ptr::null_mut());
                digest = fold(digest, 12);
                continue;
            }

            png_set_error_fn(
                png_w as *mut _,
                ptr::null_mut(),
                Some(png_noop_error),
                Some(png_noop_warn),
            );
            png_set_compression_level(png_w as *mut _, 9);
            png_set_filter(png_w as *mut _, 0, 0x08);
            png_set_IHDR(
                png_w as *const _,
                info_w as *mut _,
                width,
                height,
                8,
                3,
                1,
                0,
                0,
            );

            let mut palette = [
                png_color {
                    red: 0,
                    green: 0,
                    blue: 0,
                },
                png_color {
                    red: 255,
                    green: 0,
                    blue: 0,
                },
                png_color {
                    red: 0,
                    green: 255,
                    blue: 0,
                },
                png_color {
                    red: 255,
                    green: 255,
                    blue: 255,
                },
            ];
            png_set_PLTE(png_w as *mut _, info_w as *mut _, palette.as_ptr(), 4);

            let hist: [u16; 4] = [10, 20, 30, 40];
            png_set_hIST(png_w as *const _, info_w as *mut _, hist.as_ptr());

            let mut trans_color = MaybeUninit::<png_color_16>::zeroed().assume_init();
            trans_color.index = 3;
            let trans: [u8; 4] = [255, 128, 255, 0];
            png_set_tRNS(
                png_w as *mut _,
                info_w as *mut _,
                trans.as_ptr(),
                4,
                &trans_color as *const _,
            );

            let mut bkgd = MaybeUninit::<png_color_16>::zeroed().assume_init();
            bkgd.index = 1;
            png_set_bKGD(png_w as *const _, info_w as *mut _, &bkgd as *const _);

            png_set_rows(png_w as *const _, info_w as *mut _, row_ptrs.as_mut_ptr() as *mut _);
            png_set_write_fn(
                png_w as *mut _,
                &mut writer as *mut _ as *mut c_void,
                Some(png_write_cb),
                Some(png_flush_cb),
            );
            png_write_png(png_w as *mut _, info_w as *mut _, 0, ptr::null_mut());
            last_png_size = writer.buf.len() as u64;

            let mut pw = png_w;
            let mut iw = info_w;
            png_destroy_write_struct(&mut pw, &mut iw as *mut _ as *mut _);

            let mut reader = MemReader {
                data: writer.buf,
                pos: 0,
                failed: 0,
            };

            let png_r = png_create_read_struct(ver, ptr::null_mut(), None, None);
            if png_r.is_null() {
                digest = fold(digest, 13);
                continue;
            }
            let info_r = png_create_info_struct(png_r as *const _);
            if info_r.is_null() {
                let mut pr = png_r;
                png_destroy_read_struct(&mut pr, ptr::null_mut(), ptr::null_mut());
                digest = fold(digest, 14);
                continue;
            }

            png_set_error_fn(
                png_r as *mut _,
                ptr::null_mut(),
                Some(png_noop_error),
                Some(png_noop_warn),
            );
            png_set_read_fn(
                png_r as *mut _,
                &mut reader as *mut _ as *mut c_void,
                Some(png_read_cb),
            );
            png_read_info(png_r as *mut _, info_r as *mut _);
            last_interlace_passes = png_set_interlace_handling(png_r as *mut _) as u64;
            png_read_update_info(png_r as *mut _, info_r as *mut _);

            let rb = png_get_rowbytes(png_r as *const _, info_r as *const _) as usize;
            let h = png_get_image_height(png_r as *const _, info_r as *const _) as usize;
            let mut rows: Vec<Vec<u8>> = (0..h).map(|_| vec![0u8; rb]).collect();
            let mut row_ptrs_r: Vec<*mut u8> = rows.iter_mut().map(|r| r.as_mut_ptr()).collect();
            png_read_image(png_r as *mut _, row_ptrs_r.as_mut_ptr());
            png_read_end(png_r as *mut _, info_r as *mut _);

            let mut pal_ptr = ptr::null_mut();
            let mut pal_num = 0i32;
            last_plte = optipng_0_7_7_raw::src::libpng::pngget::png_get_PLTE(
                png_r as *const _,
                info_r as *mut _,
                &mut pal_ptr,
                &mut pal_num,
            ) as u64;

            let mut hist_ptr = ptr::null_mut();
            last_hist = optipng_0_7_7_raw::src::libpng::pngget::png_get_hIST(
                png_r as *const _,
                info_r as *mut _,
                &mut hist_ptr,
            ) as u64;

            let mut bkgd_ptr = ptr::null_mut();
            last_bkgd = optipng_0_7_7_raw::src::libpng::pngget::png_get_bKGD(
                png_r as *const _,
                info_r as *mut _,
                &mut bkgd_ptr,
            ) as u64;

            let mut dec = Vec::with_capacity(h * rb);
            for r in &rows {
                dec.extend_from_slice(r);
            }
            last_dec_crc = crc32(0, dec.as_ptr(), dec.len() as c_uint) as u64;
            last_eq = (dec == pixels) as u64;
            last_trns = pal_num as u64;

            let mut pr = png_r;
            let mut ir = info_r;
            png_destroy_read_struct(&mut pr, &mut ir as *mut _ as *mut _, ptr::null_mut());

            let mut d = 0u64;
            d = fold(d, input_fold);
            d = fold(d, last_png_size);
            d = fold(d, last_plte);
            d = fold(d, last_hist);
            d = fold(d, last_trns);
            d = fold(d, last_bkgd);
            d = fold(d, last_interlace_passes);
            d = fold(d, last_dec_crc);
            d = fold(d, last_eq);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=png_palette_roundtrip in_len={} png_size={} plte={} hist={} trns={} bkgd={} passes={} dec_crc={:08x} eq={} digest={:016x}",
        data.len(),
        last_png_size,
        last_plte,
        last_hist,
        last_trns,
        last_bkgd,
        last_interlace_passes,
        last_dec_crc,
        last_eq,
        digest
    )
}

pub fn gif_decode_blocks(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);
    let mut last_screen_ok = 0u64;
    let mut last_blocks = 0u64;
    let mut last_colors = 0u64;
    let mut last_color_bytes = 0u64;
    let mut last_graphic = 0u64;

    for iter in 0..iters {
        let path = format!(
            "{}/optipng_raw_harness_gif_{}_{}.gif",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let _ = fs::write(&path, data);
        let c_path = cstring_lossy_no_nul(&path);
        let mode = match CString::new("rb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b']) },
        };

        unsafe {
            let fp = fopen(c_path.as_ptr(), mode.as_ptr()) as *mut FILE;
            if fp.is_null() {
                digest = fold(digest, 0x3333);
                let _ = fs::remove_file(&path);
                continue;
            }

            let mut screen =
                MaybeUninit::<optipng_0_7_7_raw::src::gifread::gifread::GIFScreen>::zeroed()
                    .assume_init();
            GIFReadScreen(&mut screen, fp as *mut _);
            last_screen_ok = 1;

            let mut rows: Vec<*mut c_uchar> = Vec::new();
            let mut image =
                MaybeUninit::<optipng_0_7_7_raw::src::gifread::gifread::GIFImage>::zeroed()
                    .assume_init();
            GIFInitImage(&mut image, &mut screen, rows.as_mut_ptr());

            let mut ext =
                MaybeUninit::<optipng_0_7_7_raw::src::gifread::gifread::GIFExtension>::zeroed()
                    .assume_init();
            GIFInitExtension(&mut ext, &mut screen, 64);

            let mut blocks = 0u64;
            for _ in 0..32 {
                let rc = GIFReadNextBlock(&mut image, &mut ext, fp as *mut _);
                blocks = blocks.wrapping_add((rc as i64 as u64).wrapping_add(1));
                if rc == 0 {
                    break;
                }
            }
            last_blocks = blocks;

            let mut colors = ptr::null_mut();
            let mut num_colors = 0u32;
            GIFGetColorTable(&mut colors, &mut num_colors, &mut image);
            last_colors = num_colors as u64;
            last_color_bytes = ((!colors.is_null()) as u64) * (num_colors as u64) * 3;

            let mut gctl =
                MaybeUninit::<optipng_0_7_7_raw::src::gifread::gifread::GIFGraphicCtlExt>::zeroed()
                    .assume_init();
            GIFGetGraphicCtl(&mut gctl, &mut ext);
            last_graphic = fold(
                0,
                gctl.DisposalMethod as u64
                    ^ ((gctl.InputFlag as u64) << 8)
                    ^ ((gctl.TransparentFlag as u64) << 16)
                    ^ ((gctl.DelayTime as u64) << 24)
                    ^ ((gctl.Transparent as u64) << 40),
            );

            GIFDestroyExtension(&mut ext);
            GIFDestroyImage(&mut image);
            let _ = fclose(fp as *mut _);
        }

        let _ = fs::remove_file(&path);

        let mut d = 0u64;
        d = fold(d, input_crc);
        d = fold(d, last_screen_ok);
        d = fold(d, last_blocks);
        d = fold(d, last_colors);
        d = fold(d, last_color_bytes);
        d = fold(d, last_graphic);
        digest = fold(digest, d);
    }

    format!(
        "op=gif_decode_blocks in_len={} in_crc={:08x} screen_ok={} blocks={} colors={} color_bytes={} graphic={} digest={:016x}",
        data.len(),
        input_crc,
        last_screen_ok,
        last_blocks,
        last_colors,
        last_color_bytes,
        last_graphic,
        digest
    )
}

pub fn pnm_roundtrip(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);
    let mut last_hdr = 0i32;
    let mut last_valid = 0i32;
    let mut last_sample_size = 0u64;
    let mut last_mem_size = 0u64;
    let mut last_get_bytes = 0i32;
    let mut last_get_values = 0i32;
    let mut last_put_hdr = 0i32;
    let mut last_put_bytes = 0i32;
    let mut last_put_values = 0i32;
    let mut last_out_size = 0u64;

    for iter in 0..iters {
        let in_path = format!(
            "{}/optipng_raw_harness_pnm_in_{}_{}.pnm",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let out_path = format!(
            "{}/optipng_raw_harness_pnm_out_{}_{}.pnm",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let _ = fs::write(&in_path, data);
        let c_in = cstring_lossy_no_nul(&in_path);
        let c_out = cstring_lossy_no_nul(&out_path);
        let rb = match CString::new("rb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b']) },
        };
        let wb = match CString::new("wb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'w', b'b']) },
        };

        unsafe {
            let fin = fopen(c_in.as_ptr(), rb.as_ptr()) as *mut FILE;
            if fin.is_null() {
                digest = fold(digest, 0x4444);
                let _ = fs::remove_file(&in_path);
                let _ = fs::remove_file(&out_path);
                continue;
            }

            let mut pnm_in = MaybeUninit::<pnmin_struct>::zeroed().assume_init();
            last_hdr = pnm_fget_header(&mut pnm_in as *mut _, fin as *mut _);

            let pnm_util = pnmutil_from_in_ptr(&pnm_in as *const _);
            last_valid = pnm_is_valid(pnm_util);
            last_sample_size = pnm_raw_sample_size(pnm_util) as u64;
            last_mem_size = pnm_mem_size(pnm_util, last_sample_size as _, 1) as u64;

            let mut bytes = vec![0u8; (last_mem_size as usize).max(1).min(1 << 20)];
            last_get_bytes = pnm_fget_bytes(
                &pnm_in as *const _,
                bytes.as_mut_ptr(),
                last_sample_size as _,
                1,
                fin as *mut _,
            );

            let _ = opng_fseeko(fin as *mut _, 0, 0);
            let _ = pnm_fget_header(&mut pnm_in as *mut _, fin as *mut _);
            let mut vals = vec![0u32; 4096];
            last_get_values = pnm_fget_values(&pnm_in as *const _, vals.as_mut_ptr(), 1, fin as *mut _);

            let _ = fclose(fin as *mut _);

            let mut pnm_out = MaybeUninit::<pnmout_struct>::zeroed().assume_init();
            ptr::copy_nonoverlapping(
                (&pnm_in as *const pnmin_struct) as *const u8,
                (&mut pnm_out as *mut pnmout_struct) as *mut u8,
                size_of::<pnmin_struct>().min(size_of::<pnmout_struct>()),
            );

            let fout = fopen(c_out.as_ptr(), wb.as_ptr()) as *mut FILE;
            if fout.is_null() {
                digest = fold(digest, 0x5555);
                let _ = fs::remove_file(&in_path);
                let _ = fs::remove_file(&out_path);
                continue;
            }

            last_put_hdr = pnm_fput_header(&pnm_out as *const _, fout as *mut _);
            last_put_bytes = pnm_fput_bytes(
                &pnm_out as *const _,
                bytes.as_ptr(),
                last_sample_size as _,
                1,
                fout as *mut _,
            );
            last_put_values = pnm_fput_values(&pnm_out as *const _, vals.as_ptr(), 1, fout as *mut _);
            let _ = fflush(fout as *mut _);
            let _ = fclose(fout as *mut _);

            last_out_size = fs::metadata(&out_path).map(|m| m.len()).unwrap_or(0);
        }

        let _ = fs::remove_file(&in_path);
        let _ = fs::remove_file(&out_path);

        let mut d = 0u64;
        d = fold(d, input_crc);
        d = fold(d, last_hdr as u32 as u64);
        d = fold(d, last_valid as u32 as u64);
        d = fold(d, last_sample_size);
        d = fold(d, last_mem_size);
        d = fold(d, last_get_bytes as u32 as u64);
        d = fold(d, last_get_values as u32 as u64);
        d = fold(d, last_put_hdr as u32 as u64);
        d = fold(d, last_put_bytes as u32 as u64);
        d = fold(d, last_put_values as u32 as u64);
        d = fold(d, last_out_size);
        digest = fold(digest, d);
    }

    format!(
        "op=pnm_roundtrip in_len={} in_crc={:08x} hdr={} valid={} sample_size={} mem_size={} get_bytes={} get_values={} put_hdr={} put_bytes={} put_values={} out_size={} digest={:016x}",
        data.len(),
        input_crc,
        last_hdr,
        last_valid,
        last_sample_size,
        last_mem_size,
        last_get_bytes,
        last_get_values,
        last_put_hdr,
        last_put_bytes,
        last_put_values,
        last_out_size,
        digest
    )
}

pub fn bitset_and_ratio(data: &[u8], iters: u64) -> String {
    let input_fold = fold_bytes(0, data);
    let s = String::from_utf8_lossy(data);
    let c = cstring_lossy_no_nul(&s);
    let mut digest = fold(0, data.len() as u64);
    let mut last_parse = 0i32;
    let mut last_count = 0u64;
    let mut last_first = 0u64;
    let mut last_next = 0u64;
    let mut last_last = 0u64;
    let mut last_prev = 0u64;
    let mut last_ratio_fold = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut set: optipng_0_7_7_raw::src::optipng::bitset::opng_bitset_t = 0;
            last_parse = opng_strparse_rangeset_to_bitset(&mut set, c.as_ptr(), !0);
            last_count = opng_bitset_count(set) as u64;
            last_first = opng_bitset_find_first(set) as u64;
            last_next = opng_bitset_find_next(set, last_first as c_int) as u64;
            last_last = opng_bitset_find_last(set) as u64;
            last_prev = opng_bitset_find_prev(set, last_last as c_int) as u64;

            let mut buf1 = vec![0i8; 64];
            let mut buf2 = vec![0i8; 64];
            let mut buf3 = vec![0i8; 64];
            let mut buf4 = vec![0i8; 64];

            let ratio_ul = optipng_0_7_7_raw::src::optipng::ratio::opng_ulratio {
                num: (data.len() as u64).saturating_add(1),
                denom: last_count.saturating_add(1),
            };
            let ratio_ull = optipng_0_7_7_raw::src::optipng::ratio::opng_ullratio {
                num: input_fold | 1,
                denom: (data.len() as u64).saturating_add(1),
            };

            let r1 = opng_ulratio_to_factor_string(buf1.as_mut_ptr(), buf1.len(), &ratio_ul);
            let r2 = opng_ulratio_to_percent_string(buf2.as_mut_ptr(), buf2.len(), &ratio_ul);
            let r3 = opng_ullratio_to_factor_string(buf3.as_mut_ptr(), buf3.len(), &ratio_ull);
            let r4 = opng_ullratio_to_percent_string(buf4.as_mut_ptr(), buf4.len(), &ratio_ull);

            let mut rf = 0u64;
            rf = fold(rf, r1 as u32 as u64);
            rf = fold(rf, r2 as u32 as u64);
            rf = fold(rf, r3 as u32 as u64);
            rf = fold(rf, r4 as u32 as u64);
            for b in [&buf1, &buf2, &buf3, &buf4] {
                for &ch in b.iter() {
                    rf = fold(rf, ch as u8 as u64);
                }
            }
            last_ratio_fold = rf;

            let mut d = 0u64;
            d = fold(d, input_fold);
            d = fold(d, last_parse as u32 as u64);
            d = fold(d, last_count);
            d = fold(d, last_first);
            d = fold(d, last_next);
            d = fold(d, last_last);
            d = fold(d, last_prev);
            d = fold(d, last_ratio_fold);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=bitset_and_ratio in_len={} parse={} count={} first={} next={} last={} prev={} ratio_fold={} digest={:016x}",
        data.len(),
        last_parse,
        last_count,
        last_first,
        last_next,
        last_last,
        last_prev,
        last_ratio_fold,
        digest
    )
}

pub fn ioutil_paths_and_files(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);
    let mut last_size = 0u64;
    let mut last_tell = 0u64;
    let mut last_read_crc = 0u64;
    let mut last_write_n = 0u64;
    let mut last_test = 0i32;
    let mut last_test_eq = 0i32;
    let mut last_rename = 0i32;
    let mut last_copy_attr = 0i32;
    let mut last_unlink = 0i32;
    let mut last_path_fold = 0u64;

    for iter in 0..iters {
        let base_dir = format!(
            "{}/optipng_raw_harness_io_{}_{}",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let src_path = format!("{}/src.dat", base_dir);
        let dst_path = format!("{}/dst.dat", base_dir);
        let ren_path = format!("{}/renamed.dat", base_dir);
        let _ = fs::create_dir_all(&base_dir);
        let _ = fs::write(&src_path, data);

        let c_dir = cstring_lossy_no_nul(&base_dir);
        let c_src = cstring_lossy_no_nul(&src_path);
        let c_dst = cstring_lossy_no_nul(&dst_path);
        let c_ren = cstring_lossy_no_nul(&ren_path);
        let rbp = match CString::new("rb+") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b', b'+']) },
        };
        let test_mode = match CString::new("f") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'f']) },
        };

        unsafe {
            let _ = opng_os_create_dir(c_dir.as_ptr());
            let mut p1 = vec![0i8; 256];
            let mut p2 = vec![0i8; 256];
            let mut p3 = vec![0i8; 256];
            let ext = match CString::new(".bak") {
                Ok(v) => v,
                Err(_) => unsafe { CString::from_vec_unchecked(vec![b'.', b'b', b'a', b'k']) },
            };
            let ndir = match CString::new("/tmp") {
                Ok(v) => v,
                Err(_) => unsafe { CString::from_vec_unchecked(vec![b'/', b't', b'm', b'p']) },
            };
            let _ = opng_path_replace_ext(p1.as_mut_ptr(), p1.len(), c_src.as_ptr(), ext.as_ptr());
            let _ =
                opng_path_replace_dir(p2.as_mut_ptr(), p2.len(), c_src.as_ptr(), ndir.as_ptr());
            let _ = opng_path_make_backup(p3.as_mut_ptr(), p3.len(), c_src.as_ptr());
            let mut pf = 0u64;
            for b in [&p1, &p2, &p3] {
                for &ch in b.iter() {
                    pf = fold(pf, ch as u8 as u64);
                }
            }
            last_path_fold = pf;

            let fp = fopen(c_src.as_ptr(), rbp.as_ptr()) as *mut FILE;
            if fp.is_null() {
                digest = fold(digest, 0x6666);
                let _ = fs::remove_file(&src_path);
                let _ = fs::remove_file(&dst_path);
                let _ = fs::remove_file(&ren_path);
                let _ = fs::remove_dir_all(&base_dir);
                continue;
            }

            let mut sz = 0u64;
            let _ = opng_fgetsize(fp as *mut _, &mut sz);
            last_size = sz;
            last_tell = opng_ftello(fp as *mut _) as u64;

            let mut buf = vec![0u8; data.len().min(4096).max(1)];
            let nr = opng_freado(
                fp as *mut _,
                0,
                0,
                buf.as_mut_ptr() as *mut c_void,
                buf.len(),
            );
            last_read_crc = crc32(0, buf.as_ptr(), nr as c_uint) as u64;

            let tail = b"TAIL";
            last_write_n = opng_fwriteo(
                fp as *mut _,
                0,
                2,
                tail.as_ptr() as *const c_void,
                tail.len(),
            ) as u64;
            let _ = fclose(fp as *mut _);

            let _ = fs::copy(&src_path, &dst_path);
            last_test = opng_os_test(c_src.as_ptr(), test_mode.as_ptr());
            last_test_eq = opng_os_test_eq(c_src.as_ptr(), c_dst.as_ptr());
            last_copy_attr = opng_os_copy_attr(c_src.as_ptr(), c_dst.as_ptr());
            last_rename = opng_os_rename(c_dst.as_ptr(), c_ren.as_ptr(), 1);
            last_unlink = opng_os_unlink(c_ren.as_ptr());

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, last_size);
            d = fold(d, last_tell);
            d = fold(d, last_read_crc);
            d = fold(d, last_write_n);
            d = fold(d, last_test as u32 as u64);
            d = fold(d, last_test_eq as u32 as u64);
            d = fold(d, last_rename as u32 as u64);
            d = fold(d, last_copy_attr as u32 as u64);
            d = fold(d, last_unlink as u32 as u64);
            d = fold(d, last_path_fold);
            digest = fold(digest, d);
        }

        let _ = fs::remove_file(&src_path);
        let _ = fs::remove_file(&dst_path);
        let _ = fs::remove_file(&ren_path);
        let _ = fs::remove_dir_all(&base_dir);
    }

    format!(
        "op=ioutil_paths_and_files in_len={} in_crc={:08x} size={} tell={} read_crc={:08x} write_n={} test={} test_eq={} rename={} copy_attr={} unlink={} path_fold={} digest={:016x}",
        data.len(),
        input_crc,
        last_size,
        last_tell,
        last_read_crc,
        last_write_n,
        last_test,
        last_test_eq,
        last_rename,
        last_copy_attr,
        last_unlink,
        last_path_fold,
        digest
    )
}

