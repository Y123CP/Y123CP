            last_ratio_fold = rf;

            let mut d = 0u64;
            d = fold(d, input_fold);
            d = fold(d, last_parse as u32 as u64);
            d = fold(d, last_count);
            d = fold(d, last_first);
            d = fold(d, last_next);
            d = fold(d, last_last);
            d = fold(d, last_prev);
            d = fold(d, last_ratio_fold);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=bitset_and_ratio in_len={} parse={} count={} first={} next={} last={} prev={} ratio_fold={} digest={:016x}",
        data.len(),
        last_parse,
        last_count,
        last_first,
        last_next,
        last_last,
