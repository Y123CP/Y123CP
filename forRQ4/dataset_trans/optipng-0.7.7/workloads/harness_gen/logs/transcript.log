) {
}

pub fn png_write_read_roundtrip(data: &[u8], iters: u64) -> String {
    let width = 32u32;
    let height = ((data.len() as u32).saturating_add(width - 1) / width).max(1);
    let rowbytes = width as usize;
    let total = rowbytes * height as usize;

    let mut pixels = vec![0u8; total];
    let copy_len = data.len().min(total);
    pixels[..copy_len].copy_from_slice(&data[..copy_len]);

    let mut row_ptrs: Vec<*mut c_uchar> = Vec::with_capacity(height as usize);
    for y in 0..height as usize {
        row_ptrs.push(pixels[y * rowbytes..].as_mut_ptr());
    }

    let input_fold = fold_bytes(0, &pixels);
    let version_num = unsafe { png_access_version_number() as u64 };

    let mut digest = fold(0, data.len() as u64);
    let mut last_sig_cmp = -1i32;
    let mut last_png_size = 0u64;
    let mut last_w = 0u64;
    let mut last_h = 0u64;
    let mut last_rb = 0u64;
    let mut last_rows_null = 1u64;
    let mut last_dec_crc = 0u64;
    let mut last_eq = 0u64;
    let mut last_write_ok = 0u64;
    let mut last_read_ok = 0u64;
    let mut last_bd = 0u64;
    let mut last_ct = 0u64;
    let mut last_ch = 0u64;
    let mut last_it = 0u64;
    let mut last_ft = 0u64;
    let mut last_cmp = 0u64;
    let mut last_valid = 0u64;
    let mut last_reduce = 0u64;
    let mut last_validate = 0u64;
    let mut last_fmt_len = 0u64;
    let mut last_warnbuf = 0u64;
    let mut last_alloc_fold = 0u64;

    for _ in 0..iters {
        unsafe {
            let ver = png_get_libpng_ver(ptr::null());
            let mut writer = MemWriter {
                buf: Vec::new(),
                failed: 0,
            };

            let png_w = png_create_write_struct(ver, ptr::null_mut(), None, None);
            if png_w.is_null() {
                digest = fold(digest, 1);
                continue;
            }
            let info_w = png_create_info_struct(png_w as *const _);
            if info_w.is_null() {
                let mut pw = png_w;
                png_destroy_write_struct(&mut pw, ptr::null_mut());
                digest = fold(digest, 2);
                continue;
            }

            png_set_error_fn(
                png_w as *mut _,
                ptr::null_mut(),
                Some(png_noop_error),
                Some(png_noop_warn),
            );
            png_set_compression_level(png_w as *mut _, 6);
            png_set_compression_mem_level(png_w as *mut _, 8);
            png_set_compression_window_bits(png_w as *mut _, 15);
            png_set_compression_method(png_w as *mut _, 8);
            png_set_compression_strategy(png_w as *mut _, 0);
            png_set_filter(png_w as *mut _, 0, 0x08 | 0x10);
            png_set_flush(png_w as *mut _, 4);
            png_set_compression_buffer_size(png_w as *mut _, 8192);
            png_set_user_limits(png_w as *mut _, width, height);
            png_set_chunk_cache_max(png_w as *mut _, 64);
            png_set_chunk_malloc_max(png_w as *mut _, 1 << 20);
            png_set_benign_errors(png_w as *mut _, 1);
            png_set_check_for_invalid_index(png_w as *mut _, 1);
            png_set_keep_unknown_chunks(png_w as *mut _, 2, ptr::null(), 0);

            png_set_IHDR(
                png_w as *const _,
                info_w as *mut _,
                width,
                height,
                8,
                0,
                0,
                0,
                0,
            );
            png_set_rows(png_w as *const _, info_w as *mut _, row_ptrs.as_mut_ptr() as *mut _);
            png_set_write_fn(
                png_w as *mut _,
                &mut writer as *mut _ as *mut c_void,
                Some(png_write_cb),
                Some(png_flush_cb),
            );
            png_write_png(png_w as *mut _, info_w as *mut _, 0, ptr::null_mut());
            last_write_ok = (writer.failed == 0) as u64;
            last_png_size = writer.buf.len() as u64;

            let mut pw = png_w;
            let mut iw = info_w;
            png_destroy_write_struct(&mut pw, &mut iw as *mut _ as *mut _);

            last_sig_cmp = if writer.buf.len() >= 8 {
                png_sig_cmp(writer.buf.as_ptr(), 0, 8)
            } else {
                -1
            };

            let mut reader = MemReader {
                data: writer.buf,
                pos: 0,
                failed: 0,
            };

            let png_r = png_create_read_struct(ver, ptr::null_mut(), None, None);
            if png_r.is_null() {
                digest = fold(digest, 3);
                continue;
            }
            let info_r = png_create_info_struct(png_r as *const _);
            if info_r.is_null() {
                let mut pr = png_r;
                png_destroy_read_struct(&mut pr, ptr::null_mut(), ptr::null_mut());
                digest = fold(digest, 4);
                continue;
            }

            png_set_error_fn(
                png_r as *mut _,
                ptr::null_mut(),
                Some(png_noop_error),
                Some(png_noop_warn),
            );
            png_set_crc_action(png_r as *mut _, 1, 1);
            png_set_user_limits(png_r as *mut _, width * 2, height * 2);
            png_set_benign_errors(png_r as *mut _, 1);
            png_set_check_for_invalid_index(png_r as *mut _, 1);
            png_set_read_fn(
                png_r as *mut _,
                &mut reader as *mut _ as *mut c_void,
                Some(png_read_cb),
            );
            png_read_png(png_r as *mut _, info_r as *mut _, 0, ptr::null_mut());
            last_read_ok = (reader.failed == 0) as u64;

            last_w = png_get_image_width(png_r as *const _, info_r as *const _) as u64;
            last_h = png_get_image_height(png_r as *const _, info_r as *const _) as u64;
            last_rb = png_get_rowbytes(png_r as *const _, info_r as *const _) as u64;
            last_bd = png_get_bit_depth(png_r as *const _, info_r as *const _) as u64;
            last_ct = png_get_color_type(png_r as *const _, info_r as *const _) as u64;
            last_ch = png_get_channels(png_r as *const _, info_r as *const _) as u64;
            last_it = optipng_0_7_7_raw::src::libpng::pngget::png_get_interlace_type(
                png_r as *const _,
                info_r as *const _,
            ) as u64;
            last_ft = png_get_filter_type(png_r as *const _, info_r as *const _) as u64;
            last_cmp = png_get_compression_type(png_r as *const _, info_r as *const _) as u64;
            last_valid = png_get_valid(png_r as *const _, info_r as *const _, 0xffff_ffff) as u64;
            let rows = png_get_rows(png_r as *const _, info_r as *const _);
            last_rows_null = rows.is_null() as u64;

            let mut ih_w = 0u32;
            let mut ih_h = 0u32;
            let mut ih_bd = 0i32;
            let mut ih_ct = 0i32;
            let mut ih_it = 0i32;
            let mut ih_cmp = 0i32;
            let mut ih_ft = 0i32;
            let _ = png_get_IHDR(
                png_r as *const _,
                info_r as *const _,
                &mut ih_w,
                &mut ih_h,
                &mut ih_bd,
                &mut ih_ct,
                &mut ih_it,
                &mut ih_cmp,
                &mut ih_ft,
            );

            let mut dec = Vec::new();
            if !rows.is_null() && last_h > 0 && last_rb > 0 {
                let h = last_h as usize;
                let rb = last_rb as usize;
                dec.reserve(h.saturating_mul(rb));
                for y in 0..h {
                    let rp = *rows.add(y);
                    if rp.is_null() {
                        break;
                    }
                    let slice = std::slice::from_raw_parts(rp as *const u8, rb);
                    dec.extend_from_slice(slice);
                }
            }

            last_dec_crc = crc32(0, dec.as_ptr(), dec.len() as c_uint) as u64;
            last_eq = (dec == pixels) as u64;
            last_validate = opng_validate_image(png_r as *mut _, info_r as *mut _) as u64;
            last_reduce = opng_reduce_image(png_r as *mut _, info_r as *mut _, 0xffff_ffff) as u64;

            let mut numbuf = vec![0i8; 64];
            let endp = numbuf.as_mut_ptr().add(numbuf.len() - 1);
            let p = png_format_number(ptr::null(), endp, 0, last_png_size as _);
            last_fmt_len = if p.is_null() {
                0
            } else {
                let mut n = 0usize;
                while n < numbuf.len() && numbuf[n] != 0 {
                    n += 1;
                }
                n as u64
            };

            let mut warn_params = [[0i8; 32]; 8];
            png_warning_parameter(
                warn_params.as_mut_ptr(),
                0,
                cstring_lossy_no_nul("gray").as_ptr(),
            );
            png_warning_parameter_unsigned(warn_params.as_mut_ptr(), 1, 0, last_png_size as _);
            png_warning_parameter_signed(warn_params.as_mut_ptr(), 2, 0, ih_bd as _);
            let mut wb = 0u64;
            for arr in &warn_params {
                for &ch in arr {
                    wb = fold(wb, ch as u8 as u64);
                }
            }
            last_warnbuf = wb;

            let a1 = png_malloc_base(png_r as *const _, 32);
            let a2 = png_malloc_warn(png_r as *const _, 16);
            let a3 = png_malloc(png_r as *const _, 24);
            let a4 = png_calloc(png_r as *const _, 40);
            let a5 = png_malloc_array(png_r as *const _, 4, 8);
            let a6 = png_realloc_array(png_r as *const _, a5, 4, 2, 8);
            let mut af = 0u64;
            af = fold(af, (!a1.is_null()) as u64);
            af = fold(af, (!a2.is_null()) as u64);
            af = fold(af, (!a3.is_null()) as u64);
            af = fold(af, (!a4.is_null()) as u64);
            af = fold(af, (!a5.is_null()) as u64);
            af = fold(af, (!a6.is_null()) as u64);
            if !a1.is_null() {
                png_free(png_r as *const _, a1);
            }
            if !a2.is_null() {
                png_free(png_r as *const _, a2);
            }
            if !a3.is_null() {
                png_free(png_r as *const _, a3);
            }
            if !a4.is_null() {
                png_free(png_r as *const _, a4);
            }
            if !a6.is_null() {
                png_free(png_r as *const _, a6);
            } else if !a5.is_null() {
                png_free(png_r as *const _, a5);
            }
            last_alloc_fold = af;

            let mut pr = png_r;
            let mut ir = info_r;
            png_destroy_read_struct(&mut pr, &mut ir as *mut _ as *mut _, ptr::null_mut());

            let mut d = 0u64;
            d = fold(d, input_fold);
            d = fold(d, version_num);
            d = fold(d, last_sig_cmp as u32 as u64);
            d = fold(d, last_png_size);
            d = fold(d, last_w);
            d = fold(d, last_h);
            d = fold(d, last_rb);
            d = fold(d, last_rows_null);
            d = fold(d, last_dec_crc);
            d = fold(d, last_eq);
            d = fold(d, last_write_ok);
            d = fold(d, last_read_ok);
            d = fold(d, last_bd);
            d = fold(d, last_ct);
            d = fold(d, last_ch);
            d = fold(d, last_it);
            d = fold(d, last_ft);
            d = fold(d, last_cmp);
            d = fold(d, last_valid);
            d = fold(d, last_reduce);
            d = fold(d, last_validate);
            d = fold(d, last_fmt_len);
            d = fold(d, last_warnbuf);
            d = fold(d, last_alloc_fold);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=png_write_read_roundtrip in_len={} sig_cmp={} png_size={} width={} height={} rowbytes={} rows_null={} dec_crc={:08x} eq={} w_ok={} r_ok={} bd={} ct={} ch={} it={} ft={} cmp={} valid={} reduce={} validate={} digest={:016x}",
        data.len(),
        last_sig_cmp,
        last_png_size,
        last_w,
        last_h,
        last_rb,
        last_rows_null,
        last_dec_crc,
        last_eq,
        last_write_ok,
        last_read_ok,
        last_bd,
        last_ct,
        last_ch,
        last_it,
        last_ft,
        last_cmp,
        last_valid,
        last_reduce,
        last_validate,
        digest
    )
}

pub fn png_palette_roundtrip(data: &[u8], iters: u64) -> String {
    let width = 32u32;
    let height = ((data.len() as u32).saturating_add(width - 1) / width).max(1);
