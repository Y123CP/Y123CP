    }

    format!(
        "op=zlib_compress_uncompress in_len={} in_crc={:08x} in_adler={:08x} c_rc={} u_rc={} comp_len={} decomp_len={} out_crc={:08x} eq={} digest={:016x}",
        data.len(),
