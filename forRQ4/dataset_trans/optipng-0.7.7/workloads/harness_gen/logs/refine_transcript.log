            last_ft = png_get_filter_type(png_r as *const _, info_r as *const _) as u64;
            last_cmp = png_get_compression_type(png_r as *const _, info_r as *const _) as u64;
            last_valid = png_get_valid(png_r as *const _, info_r as *const _, 0xffff_ffff) as u64;
            let rows = png_get_rows(png_r as *const _, info_r as *const _);
            last_rows_null = rows.is_null() as u64;

            let mut ih_w = 0u32;
            let mut ih_h = 0u32;
            let mut ih_bd = 0i32;
            let mut ih_ct = 0i32;
            let mut ih_it = 0i32;
            let mut ih_cmp = 0i32;
            let mut ih_ft = 0i32;
