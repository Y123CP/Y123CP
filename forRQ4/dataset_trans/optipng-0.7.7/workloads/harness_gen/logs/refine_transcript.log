    let mut digest = fold(0, data.len() as u64);
    let mut last_screen_ok = 0u64;
    let mut last_blocks = 0u64;
    let mut last_colors = 0u64;
    let mut last_color_bytes = 0u64;
    let mut last_graphic = 0u64;

    for iter in 0..iters {
        let path = format!(
            "{}/optipng_raw_harness_gif_{}_{}.gif",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let _ = fs::write(&path, data);
        let c_path = cstring_lossy_no_nul(&path);
        let mode = match CString::new("rb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b']) },
        };

        unsafe {
            let fp = fopen(c_path.as_ptr(), mode.as_ptr()) as *mut FILE;
            if fp.is_null() {
                digest = fold(digest, 0x3333);
                let _ = fs::remove_file(&path);
                continue;
            }

            let mut screen =
                MaybeUninit::<optipng_0_7_7_raw::src::gifread::gifread::GIFScreen>::zeroed()
                    .assume_init();
            GIFReadScreen(&mut screen, fp as *mut _);
            last_screen_ok = 1;

            let mut rows: Vec<*mut c_uchar> = Vec::new();
            let mut image =
                MaybeUninit::<optipng_0_7_7_raw::src::gifread::gifread::GIFImage>::zeroed()
                    .assume_init();
            GIFInitImage(&mut image, &mut screen, rows.as_mut_ptr());

            let mut ext =
                MaybeUninit::<optipng_0_7_7_raw::src::gifread::gifread::GIFExtension>::zeroed()
                    .assume_init();
            GIFInitExtension(&mut ext, &mut screen, 64);

            let mut blocks = 0u64;
            for _ in 0..32 {
                let rc = GIFReadNextBlock(&mut image, &mut ext, fp as *mut _);
                blocks = blocks.wrapping_add((rc as i64 as u64).wrapping_add(1));
                if rc == 0 {
                    break;
                }
            }
            last_blocks = blocks;

            let mut colors = ptr::null_mut();
            let mut num_colors = 0u32;
            GIFGetColorTable(&mut colors, &mut num_colors, &mut image);
            last_colors = num_colors as u64;
            last_color_bytes = ((!colors.is_null()) as u64) * (num_colors as u64) * 3;

            let mut gctl =
                MaybeUninit::<optipng_0_7_7_raw::src::gifread::gifread::GIFGraphicCtlExt>::zeroed()
                    .assume_init();
            GIFGetGraphicCtl(&mut gctl, &mut ext);
            last_graphic = fold(
                0,
                gctl.DisposalMethod as u64
                    ^ ((gctl.InputFlag as u64) << 8)
                    ^ ((gctl.TransparentFlag as u64) << 16)
                    ^ ((gctl.DelayTime as u64) << 24)
                    ^ ((gctl.Transparent as u64) << 40),
            );

            GIFDestroyExtension(&mut ext);
            GIFDestroyImage(&mut image);
            let _ = fclose(fp as *mut _);
        }

        let _ = fs::remove_file(&path);

        let mut d = 0u64;
        d = fold(d, input_crc);
        d = fold(d, last_screen_ok);
        d = fold(d, last_blocks);
        d = fold(d, last_colors);
        d = fold(d, last_color_bytes);
        d = fold(d, last_graphic);
        digest = fold(digest, d);
    }

    format!(
        "op=gif_decode_blocks in_len={} in_crc={:08x} screen_ok={} blocks={} colors={} color_bytes={} graphic={} digest={:016x}",
        data.len(),
        input_crc,
        last_screen_ok,
        last_blocks,
        last_colors,
        last_color_bytes,
        last_graphic,
        digest
    )
}

pub fn pnm_roundtrip(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);
    let mut last_hdr = 0i32;
    let mut last_valid = 0i32;
    let mut last_sample_size = 0u64;
    let mut last_mem_size = 0u64;
    let mut last_get_bytes = 0i32;
    let mut last_get_values = 0i32;
    let mut last_put_hdr = 0i32;
    let mut last_put_bytes = 0i32;
    let mut last_put_values = 0i32;
    let mut last_out_size = 0u64;

    for iter in 0..iters {
        let in_path = format!(
            "{}/optipng_raw_harness_pnm_in_{}_{}.pnm",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let out_path = format!(
            "{}/optipng_raw_harness_pnm_out_{}_{}.pnm",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let _ = fs::write(&in_path, data);
        let c_in = cstring_lossy_no_nul(&in_path);
        let c_out = cstring_lossy_no_nul(&out_path);
        let rb = match CString::new("rb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b']) },
        };
        let wb = match CString::new("wb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'w', b'b']) },
        };

        unsafe {
            let fin = fopen(c_in.as_ptr(), rb.as_ptr()) as *mut FILE;
            if fin.is_null() {
                digest = fold(digest, 0x4444);
                let _ = fs::remove_file(&in_path);
                let _ = fs::remove_file(&out_path);
                continue;
            }

            let mut pnm_in = MaybeUninit::<pnmin_struct>::zeroed().assume_init();
            last_hdr = pnm_fget_header(&mut pnm_in as *mut _, fin as *mut _);

            let pnm_util = pnmutil_from_in_ptr(&pnm_in as *const _);
            last_valid = pnm_is_valid(pnm_util);
            last_sample_size = pnm_raw_sample_size(pnm_util) as u64;
            last_mem_size = pnm_mem_size(pnm_util, last_sample_size as _, 1) as u64;

            let mut bytes = vec![0u8; (last_mem_size as usize).max(1).min(1 << 20)];
            last_get_bytes = pnm_fget_bytes(
                &pnm_in as *const _,
                bytes.as_mut_ptr(),
                last_sample_size as _,
                1,
                fin as *mut _,
            );

            let _ = opng_fseeko(fin as *mut _, 0, 0);
            let _ = pnm_fget_header(&mut pnm_in as *mut _, fin as *mut _);
            let mut vals = vec![0u32; 4096];
            last_get_values =
                pnm_fget_values(&pnm_in as *const _, vals.as_mut_ptr(), 1, fin as *mut _);

            let _ = fclose(fin as *mut _);

            let mut pnm_out = MaybeUninit::<pnmout_struct>::zeroed().assume_init();
            ptr::copy_nonoverlapping(
                (&pnm_in as *const pnmin_struct) as *const u8,
                (&mut pnm_out as *mut pnmout_struct) as *mut u8,
                size_of::<pnmin_struct>().min(size_of::<pnmout_struct>()),
            );

            let fout = fopen(c_out.as_ptr(), wb.as_ptr()) as *mut FILE;
            if fout.is_null() {
                digest = fold(digest, 0x5555);
                let _ = fs::remove_file(&in_path);
                let _ = fs::remove_file(&out_path);
                continue;
            }

            last_put_hdr = pnm_fput_header(&pnm_out as *const _, fout as *mut _);
            last_put_bytes = pnm_fput_bytes(
                &pnm_out as *const _,
                bytes.as_ptr(),
                last_sample_size as _,
                1,
                fout as *mut _,
            );
            last_put_values =
                pnm_fput_values(&pnm_out as *const _, vals.as_ptr(), 1, fout as *mut _);
            let _ = fflush(fout as *mut _);
            let _ = fclose(fout as *mut _);

            last_out_size = fs::metadata(&out_path).map(|m| m.len()).unwrap_or(0);
        }

        let _ = fs::remove_file(&in_path);
        let _ = fs::remove_file(&out_path);

        let mut d = 0u64;
        d = fold(d, input_crc);
        d = fold(d, last_hdr as u32 as u64);
        d = fold(d, last_valid as u32 as u64);
        d = fold(d, last_sample_size);
        d = fold(d, last_mem_size);
        d = fold(d, last_get_bytes as u32 as u64);
        d = fold(d, last_get_values as u32 as u64);
        d = fold(d, last_put_hdr as u32 as u64);
        d = fold(d, last_put_bytes as u32 as u64);
        d = fold(d, last_put_values as u32 as u64);
        d = fold(d, last_out_size);
        digest = fold(digest, d);
    }

    format!(
        "op=pnm_roundtrip in_len={} in_crc={:08x} hdr={} valid={} sample_size={} mem_size={} get_bytes={} get_values={} put_hdr={} put_bytes={} put_values={} out_size={} digest={:016x}",
        data.len(),
        input_crc,
        last_hdr,
        last_valid,
        last_sample_size,
        last_mem_size,
        last_get_bytes,
        last_get_values,
        last_put_hdr,
        last_put_bytes,
        last_put_values,
        last_out_size,
        digest
    )
}

pub fn bitset_and_ratio(data: &[u8], iters: u64) -> String {
    let input_fold = fold_bytes(0, data);
    let s = String::from_utf8_lossy(data);
    let c = cstring_lossy_no_nul(&s);
    let mut digest = fold(0, data.len() as u64);
    let mut last_parse = 0i32;
    let mut last_count = 0u64;
    let mut last_first = 0u64;
    let mut last_next = 0u64;
    let mut last_last = 0u64;
    let mut last_prev = 0u64;
    let mut last_ratio_fold = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut set: optipng_0_7_7_raw::src::optipng::bitset::opng_bitset_t = 0;
            last_parse = opng_strparse_rangeset_to_bitset(&mut set, c.as_ptr(), !0);
            last_count = opng_bitset_count(set) as u64;
            last_first = opng_bitset_find_first(set) as u64;
            last_next = opng_bitset_find_next(set, last_first as c_int) as u64;
            last_last = opng_bitset_find_last(set) as u64;
            last_prev = opng_bitset_find_prev(set, last_last as c_int) as u64;

            let mut buf1 = vec![0i8; 64];
            let mut buf2 = vec![0i8; 64];
            let mut buf3 = vec![0i8; 64];
            let mut buf4 = vec![0i8; 64];

            let ratio_ul = optipng_0_7_7_raw::src::optipng::ratio::opng_ulratio {
                num: (data.len() as u64).saturating_add(1),
                denom: last_count.saturating_add(1),
            };
            let ratio_ull = optipng_0_7_7_raw::src::optipng::ratio::opng_ullratio {
                num: input_fold | 1,
                denom: (data.len() as u64).saturating_add(1),
            };

            let r1 = opng_ulratio_to_factor_string(buf1.as_mut_ptr(), buf1.len(), &ratio_ul);
            let r2 = opng_ulratio_to_percent_string(buf2.as_mut_ptr(), buf2.len(), &ratio_ul);
            let r3 = opng_ullratio_to_factor_string(buf3.as_mut_ptr(), buf3.len(), &ratio_ull);
            let r4 = opng_ullratio_to_percent_string(buf4.as_mut_ptr(), buf4.len(), &ratio_ull);

            let mut rf = 0u64;
            rf = fold(rf, r1 as u32 as u64);
            rf = fold(rf, r2 as u32 as u64);
            rf = fold(rf, r3 as u32 as u64);
            rf = fold(rf, r4 as u32 as u64);
            for b in [&buf1, &buf2, &buf3, &buf4] {
                for &ch in b.iter() {
                    rf = fold(rf, ch as u8 as u64);
                }
            }
            last_ratio_fold = rf;

            let mut d = 0u64;
            d = fold(d, input_fold);
            d = fold(d, last_parse as u32 as u64);
            d = fold(d, last_count);
            d = fold(d, last_first);
            d = fold(d, last_next);
            d = fold(d, last_last);
            d = fold(d, last_prev);
            d = fold(d, last_ratio_fold);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=bitset_and_ratio in_len={} parse={} count={} first={} next={} last={} prev={} ratio_fold={} digest={:016x}",
        data.len(),
        last_parse,
        last_count,
        last_first,
        last_next,
        last_last,
        last_prev,
        last_ratio_fold,
        digest
    )
}

pub fn ioutil_paths_and_files(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);
    let mut last_size = 0u64;
    let mut last_tell = 0u64;
    let mut last_read_crc = 0u64;
    let mut last_write_n = 0u64;
    let mut last_test = 0i32;
    let mut last_test_eq = 0i32;
    let mut last_rename = 0i32;
    let mut last_copy_attr = 0i32;
    let mut last_unlink = 0i32;
    let mut last_path_fold = 0u64;

    for iter in 0..iters {
        let base_dir = format!(
            "{}/optipng_raw_harness_io_{}_{}",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let src_path = format!("{}/src.dat", base_dir);
        let dst_path = format!("{}/dst.dat", base_dir);
        let ren_path = format!("{}/renamed.dat", base_dir);
        let _ = fs::create_dir_all(&base_dir);
        let _ = fs::write(&src_path, data);

        let c_dir = cstring_lossy_no_nul(&base_dir);
        let c_src = cstring_lossy_no_nul(&src_path);
        let c_dst = cstring_lossy_no_nul(&dst_path);
        let c_ren = cstring_lossy_no_nul(&ren_path);
        let rbp = match CString::new("rb+") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b', b'+']) },
        };
        let test_mode = match CString::new("f") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'f']) },
        };

        unsafe {
            let _ = opng_os_create_dir(c_dir.as_ptr());
            let mut p1 = vec![0i8; 256];
            let mut p2 = vec![0i8; 256];
            let mut p3 = vec![0i8; 256];
            let ext = match CString::new(".bak") {
                Ok(v) => v,
                Err(_) => unsafe { CString::from_vec_unchecked(vec![b'.', b'b', b'a', b'k']) },
            };
            let ndir = match CString::new("/tmp") {
                Ok(v) => v,
                Err(_) => unsafe { CString::from_vec_unchecked(vec![b'/', b't', b'm', b'p']) },
            };
            let _ = opng_path_replace_ext(p1.as_mut_ptr(), p1.len(), c_src.as_ptr(), ext.as_ptr());
            let _ =
                opng_path_replace_dir(p2.as_mut_ptr(), p2.len(), c_src.as_ptr(), ndir.as_ptr());
            let _ = opng_path_make_backup(p3.as_mut_ptr(), p3.len(), c_src.as_ptr());
            let mut pf = 0u64;
            for b in [&p1, &p2, &p3] {
                for &ch in b.iter() {
                    pf = fold(pf, ch as u8 as u64);
                }
            }
            last_path_fold = pf;

            let fp = fopen(c_src.as_ptr(), rbp.as_ptr()) as *mut FILE;
            if fp.is_null() {
                digest = fold(digest, 0x6666);
                let _ = fs::remove_file(&src_path);
                let _ = fs::remove_file(&dst_path);
                let _ = fs::remove_file(&ren_path);
                let _ = fs::remove_dir_all(&base_dir);
                continue;
            }

            let mut sz = 0u64;
            let _ = opng_fgetsize(fp as *mut _, &mut sz);
            last_size = sz;
            last_tell = opng_ftello(fp as *mut _) as u64;

            let mut buf = vec![0u8; data.len().min(4096).max(1)];
            let nr = opng_freado(
                fp as *mut _,
                0,
                0,
                buf.as_mut_ptr() as *mut c_void,
                buf.len(),
            );
            last_read_crc = crc32(0, buf.as_ptr(), nr as c_uint) as u64;

            let tail = b"TAIL";
            last_write_n = opng_fwriteo(
                fp as *mut _,
                0,
                2,
                tail.as_ptr() as *const c_void,
                tail.len(),
            ) as u64;
            let _ = fclose(fp as *mut _);

            let _ = fs::copy(&src_path, &dst_path);
            last_test = opng_os_test(c_src.as_ptr(), test_mode.as_ptr());
            last_test_eq = opng_os_test_eq(c_src.as_ptr(), c_dst.as_ptr());
            last_copy_attr = opng_os_copy_attr(c_src.as_ptr(), c_dst.as_ptr());
            last_rename = opng_os_rename(c_dst.as_ptr(), c_ren.as_ptr(), 1);
            last_unlink = opng_os_unlink(c_ren.as_ptr());

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, last_size);
            d = fold(d, last_tell);
            d = fold(d, last_read_crc);
            d = fold(d, last_write_n);
            d = fold(d, last_test as u32 as u64);
            d = fold(d, last_test_eq as u32 as u64);
            d = fold(d, last_rename as u32 as u64);
            d = fold(d, last_copy_attr as u32 as u64);
            d = fold(d, last_unlink as u32 as u64);
            d = fold(d, last_path_fold);
            digest = fold(digest, d);
        }

        let _ = fs::remove_file(&src_path);
        let _ = fs::remove_file(&dst_path);
        let _ = fs::remove_file(&ren_path);
        let _ = fs::remove_dir_all(&base_dir);
    }

    format!(
        "op=ioutil_paths_and_files in_len={} in_crc={:08x} size={} tell={} read_crc={:08x} write_n={} test={} test_eq={} rename={} copy_attr={} unlink={} path_fold={} digest={:016x}",
        data.len(),
        input_crc,
        last_size,
        last_tell,
        last_read_crc,
        last_write_n,
        last_test,
        last_test_eq,
        last_rename,
        last_copy_attr,
        last_unlink,
        last_path_fold,
        digest
    )
}

