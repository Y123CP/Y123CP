            last_warnbuf = wb;

            let a1 = png_malloc_base(png_r as *const _, 32);
            let a2 = png_malloc_warn(png_r as *const _, 16);
            let a3 = png_malloc(png_r as *const _, 24);
            let a4 = png_calloc(png_r as *const _, 40);
            let a5 = png_malloc_array(png_r as *const _, 4, 8);
