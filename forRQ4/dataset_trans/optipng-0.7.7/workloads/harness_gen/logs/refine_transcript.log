            }
            if !a2.is_null() {
                png_free(png_r as *const _, a2);
            }
            if !a3.is_null() {
                png_free(png_r as *const _, a3);
            }
            if !a4.is_null() {
                png_free(png_r as *const _, a4);
            }
            if !a6.is_null() {
                png_free(png_r as *const _, a6);
            } else if !a5.is_null() {
