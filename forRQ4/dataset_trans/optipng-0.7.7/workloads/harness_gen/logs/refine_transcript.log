            last_h = png_get_image_height(png_r as *const _, info_r as *const _) as u64;
            last_rb = png_get_rowbytes(png_r as *const _, info_r as *const _) as u64;
            last_bd = png_get_bit_depth(png_r as *const _, info_r as *const _) as u64;
            last_ct = png_get_color_type(png_r as *const _, info_r as *const _) as u64;
            last_ch = png_get_channels(png_r as *const _, info_r as *const _) as u64;
            last_it = optipng_0_7_7_raw::src::libpng::pngget::png_get_interlace_type(
