type FILE = c_void;

fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9e37_79b9_7f4a_7c15)
}

fn fold_bytes(mut acc: u64, bytes: &[u8]) -> u64 {
    for &b in bytes {
        acc = fold(acc, b as u64);
    }
    acc
}

fn cstring_lossy_no_nul(s: &str) -> CString {
    let mut v = s.as_bytes().to_vec();
    for b in &mut v {
        if *b == 0 {
            *b = b'_';
        }
    }
    match CString::new(v) {
        Ok(c) => c,
        Err(_) => match CString::new("x") {
            Ok(c) => c,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'x']) },
        },
    }
}

