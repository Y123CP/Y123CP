            last_reduce = opng_reduce_image(png_r as *mut _, info_r as *mut _, 0xffff_ffff) as u64;

            let mut numbuf = vec![0i8; 64];
            let endp = numbuf.as_mut_ptr().add(numbuf.len() - 1);
            let p = png_format_number(ptr::null(), endp, 0, last_png_size as _);
