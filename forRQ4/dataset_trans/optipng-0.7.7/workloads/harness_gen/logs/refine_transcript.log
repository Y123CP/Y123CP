            png_set_compression_mem_level(png_w as *mut _, 8);
            png_set_compression_window_bits(png_w as *mut _, 15);
            png_set_compression_method(png_w as *mut _, 8);
            png_set_compression_strategy(png_w as *mut _, 0);
            png_set_filter(png_w as *mut _, 0, 0x08 | 0x10);
            png_set_flush(png_w as *mut _, 4);
            png_set_compression_buffer_size(png_w as *mut _, 8192);
            png_set_user_limits(png_w as *mut _, width, height);
            png_set_chunk_cache_max(png_w as *mut _, 64);
            png_set_chunk_malloc_max(png_w as *mut _, 1 << 20);
            png_set_benign_errors(png_w as *mut _, 1);
            png_set_check_for_invalid_index(png_w as *mut _, 1);
            png_set_keep_unknown_chunks(png_w as *mut _, 2, ptr::null(), 0);

