            png_warning_parameter_unsigned(warn_params.as_mut_ptr(), 1, 0, last_png_size as _);
            png_warning_parameter_signed(warn_params.as_mut_ptr(), 2, 0, ih_bd as _);
            let mut wb = 0u64;
            for arr in &warn_params {
