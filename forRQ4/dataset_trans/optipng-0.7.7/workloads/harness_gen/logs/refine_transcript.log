#[repr(C)]
struct MemWriter {
    buf: Vec<u8>,
    failed: c_int,
}

#[repr(C)]
struct MemReader {
    data: Vec<u8>,
    pos: usize,
    failed: c_int,
}

extern "C" fn png_write_cb(
    png_ptr: *mut optipng_0_7_7_raw::src::libpng::pngwio::png_struct_def,
    data: *mut optipng_0_7_7_raw::src::libpng::pngwio::png_byte,
    length: optipng_0_7_7_raw::src::libpng::pngwio::png_size_t,
) {
    unsafe {
        let io_ptr = png_get_io_ptr(png_ptr as *const _);
        if io_ptr.is_null() {
            return;
        }
        let st = &mut *(io_ptr as *mut MemWriter);
        let len = length as usize;
        if data.is_null() {
            st.failed = 1;
            return;
        }
        let slice = std::slice::from_raw_parts(data as *const u8, len);
        st.buf.extend_from_slice(slice);
    }
}

extern "C" fn png_flush_cb(_png_ptr: *mut optipng_0_7_7_raw::src::libpng::pngwio::png_struct_def) {}

extern "C" fn png_read_cb(
    png_ptr: *mut optipng_0_7_7_raw::src::libpng::pngrio::png_struct_def,
    out_bytes: *mut optipng_0_7_7_raw::src::libpng::pngrio::png_byte,
    length: optipng_0_7_7_raw::src::libpng::pngrio::png_size_t,
) {
    unsafe {
        let io_ptr = png_get_io_ptr(png_ptr as *const _);
        if io_ptr.is_null() {
            return;
        }
        let st = &mut *(io_ptr as *mut MemReader);
        let len = length as usize;
        if out_bytes.is_null() || st.pos > st.data.len() || st.pos + len > st.data.len() {
            st.failed = 1;
            return;
        }
        ptr::copy_nonoverlapping(st.data.as_ptr().add(st.pos), out_bytes, len);
        st.pos += len;
    }
}

