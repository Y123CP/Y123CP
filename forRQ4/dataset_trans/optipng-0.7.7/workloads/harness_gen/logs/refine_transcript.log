            let mut writer = MemWriter {
                buf: Vec::new(),
                failed: 0,
            };

            let png_w = png_create_write_struct(ver, ptr::null_mut(), None, None);
            if png_w.is_null() {
                digest = fold(digest, 1);
                continue;
