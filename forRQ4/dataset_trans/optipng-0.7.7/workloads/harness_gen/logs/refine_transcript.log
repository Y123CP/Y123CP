            let mut dec = Vec::with_capacity(h * rb);
            for r in &rows {
                dec.extend_from_slice(r);
            }
            last_dec_crc = crc32(0, dec.as_ptr(), dec.len() as c_uint) as u64;
            last_eq = (dec == pixels) as u64;
            last_trns = pal_num as u64;

            let mut pr = png_r;
            let mut ir = info_r;
            png_destroy_read_struct(&mut pr, &mut ir as *mut _ as *mut _, ptr::null_mut());

            let mut d = 0u64;
            d = fold(d, input_fold);
            d = fold(d, last_png_size);
            d = fold(d, last_plte);
            d = fold(d, last_hist);
            d = fold(d, last_trns);
            d = fold(d, last_bkgd);
            d = fold(d, last_interlace_passes);
            d = fold(d, last_dec_crc);
            d = fold(d, last_eq);
