            af = fold(af, (!a3.is_null()) as u64);
            af = fold(af, (!a4.is_null()) as u64);
            af = fold(af, (!a5.is_null()) as u64);
            af = fold(af, (!a6.is_null()) as u64);
            if !a1.is_null() {
                png_free(png_r as *const _, a1);
            }
            if !a2.is_null() {
                png_free(png_r as *const _, a2);
            }
            if !a3.is_null() {
                png_free(png_r as *const _, a3);
            }
            if !a4.is_null() {
