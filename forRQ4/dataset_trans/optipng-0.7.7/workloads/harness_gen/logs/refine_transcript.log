            let a2 = png_malloc_warn(png_r as *const _, 16);
            let a3 = png_malloc(png_r as *const _, 24);
            let a4 = png_calloc(png_r as *const _, 40);
            let a5 = png_malloc_array(png_r as *const _, 4, 8);
            let a6 = png_realloc_array(png_r as *const _, a5, 4, 2, 8);
            let mut af = 0u64;
            af = fold(af, (!a1.is_null()) as u64);
            af = fold(af, (!a2.is_null()) as u64);
            af = fold(af, (!a3.is_null()) as u64);
            af = fold(af, (!a4.is_null()) as u64);
            af = fold(af, (!a5.is_null()) as u64);
            af = fold(af, (!a6.is_null()) as u64);
            if !a1.is_null() {
