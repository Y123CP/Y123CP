fn make_text_seed_a() -> Vec<u8> {
    let mut v = Vec::new();
    for i in 0..2048u32 {
        let line = format!(
            "INFO ts=2024-01-01T00:{:02}:{:02}Z host=node{:02} service=ingest user=u{:05} action=update status=ok region=us-east-1 msg=record {} repeated repeated repeated payload=alpha-beta-gamma-delta\n",
            (i / 60) % 60,
            i % 60,
            i % 17,
            i % 1000,
            i
        );
        v.extend_from_slice(line.as_bytes());
        if i % 7 == 0 {
            v.extend_from_slice(
                b"DETAIL key=session value=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\n",
            );
        }
    }
    v
}

fn make_text_seed_b() -> Vec<u8> {
    let mut v = Vec::new();
    for i in 0..1800u32 {
        let line = format!(
            "REC|id={:06}|kind=order|acct=A{:05}|ccy=USD|qty={}|px={}|flags=NEW,ROUTE,ACK|note=customer-visible-text-block-{:03}\n",
            i,
            (i * 13) % 10000,
            10 + (i % 97),
            1000 + (i % 251),
            i % 113
        );
        v.extend_from_slice(line.as_bytes());
        if i % 5 == 0 {
            v.extend_from_slice(
                b"ITEM|sku=BOOK-STD|desc=standardized repeated catalog entry|warehouse=W1|bin=B-17\n",
            );
            v.extend_from_slice(
                b"ITEM|sku=BOOK-PRM|desc=premium repeated catalog entry|warehouse=W1|bin=B-18\n",
            );
        }
    }
    v
}

fn make_perf_corpus() -> Vec<u8> {
    let mut v = Vec::with_capacity(3_000_000);
    for block in 0..24000u32 {
        let s = format!(
            "BLOCK {:06}\nheader:type=journal source=app{:02} env=prod shard={:03}\nmessage=The quick brown fox jumps over the lazy dog. Repeated structured content improves compression behavior.\nmetrics=count:{} sum:{} xor:{}\nfooter=end\n",
            block,
            block % 23,
            block % 128,
            block * 3,
            block * 17,
            block ^ 0x55aa
        );
        v.extend_from_slice(s.as_bytes());
        match block % 3 {
            0 => v.extend_from_slice(
                b"payload=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA\n",
            ),
            1 => v.extend_from_slice(
                b"payload=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB\n",
            ),
            _ => v.extend_from_slice(
                b"payload=CCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCCC\n",
            ),
        }
    }
    v
}

fn make_gray_pixels_a() -> Vec<u8> {
    let w = 32usize;
    let h = 32usize;
    let mut v = vec![0u8; w * h];
    for y in 0..h {
        for x in 0..w {
            v[y * w + x] = ((x * 7 + y * 11) & 0xff) as u8;
        }
    }
    v
}

fn make_gray_pixels_b() -> Vec<u8> {
    let w = 32usize;
    let h = 32usize;
    let mut v = vec![0u8; w * h];
    for y in 0..h {
        for x in 0..w {
            let c = (((x / 4) ^ (y / 4)) & 1) as u8;
            v[y * w + x] = if c == 0 { 32 } else { 224 };
        }
    }
    v
}

fn make_palette_pixels_a() -> Vec<u8> {
    let w = 32usize;
    let h = 32usize;
    let mut v = vec![0u8; w * h];
    for y in 0..h {
        for x in 0..w {
            v[y * w + x] = ((x + y * 3) & 3) as u8;
        }
    }
    v
}

fn make_palette_pixels_b() -> Vec<u8> {
    let w = 32usize;
    let h = 32usize;
    let mut v = vec![0u8; w * h];
    for y in 0..h {
        for x in 0..w {
            let idx = if (x / 8 + y / 8) % 2 == 0 { 1 } else { 2 };
            v[y * w + x] = if x % 5 == 0 { 3 } else { idx };
        }
    }
    v
}

fn make_pnm_seed_a() -> Vec<u8> {
    let mut v = Vec::new();
    v.extend_from_slice(b"P5\n16 16\n255\n");
    for y in 0..16u8 {
        for x in 0..16u8 {
            v.push(x.wrapping_mul(13).wrapping_add(y.wrapping_mul(7)));
        }
    }
    v
}

fn make_pnm_seed_b() -> Vec<u8> {
    let mut v = Vec::new();
    v.extend_from_slice(b"P2\n8 8\n15\n");
    for y in 0..8u32 {
        for x in 0..8u32 {
            let n = ((x * 3 + y * 5) & 15) as u32;
            let s = format!("{}{}", n, if x == 7 { "\n" } else { " " });
            v.extend_from_slice(s.as_bytes());
        }
    }
    v
}

fn make_rangeset_seed_a() -> Vec<u8> {
    b"1-3,5,8-10,12,15-18".to_vec()
}

fn make_rangeset_seed_b() -> Vec<u8> {
    b"0,2,4,6,7-9,11,13-15,31".to_vec()
}

fn make_gif_seed_a() -> Vec<u8> {
    vec![
        0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 0x02, 0x00, 0x02, 0x00, 0x81, 0x00, 0x00, 0x00,
        0x00, 0x00, 0xff, 0xff, 0xff, 0xff, 0x00, 0x00, 0x21, 0xf9, 0x04, 0x01, 0x00, 0x00,
        0x00, 0x00, 0x2c, 0x00, 0x00, 0x00, 0x00, 0x02, 0x00, 0x02, 0x00, 0x00, 0x02, 0x03,
        0x44, 0x02, 0x05, 0x00, 0x3b,
    ]
}

fn make_gif_seed_b() -> Vec<u8> {
    vec![
        0x47, 0x49, 0x46, 0x38, 0x39, 0x61, 0x03, 0x00, 0x01, 0x00, 0x81, 0x00, 0x00, 0x00,
        0x00, 0x00, 0xff, 0xff, 0xff, 0x00, 0xff, 0x00, 0x21, 0xf9, 0x04, 0x05, 0x02, 0x00,
        0x01, 0x00, 0x2c, 0x00, 0x00, 0x00, 0x00, 0x03, 0x00, 0x01, 0x00, 0x00, 0x02, 0x02,
        0x4c, 0x01, 0x00, 0x3b,
    ]
}

fn write_seed(dir: &str, op: &str, idx: usize, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.{}.bin", dir, op, idx);
    let _ = fs::write(&path, bytes);
    out.push(format!("seed {} {}", op, path));
}

fn write_perf(dir: &str, op: &str, bytes: &[u8], out: &mut Vec<String>) {
    let path = format!("{}/{}.perf.bin", dir, op);
    let _ = fs::write(&path, bytes);
    out.push(format!("perf {} {}", op, path));
}

fn zlib_compress_bytes(data: &[u8], level: c_int) -> Vec<u8> {
    unsafe {
        let bound = compressBound(data.len() as c_ulong) as usize;
        let mut out = vec![0u8; bound.max(1)];
        let mut out_len = out.len() as c_ulong;
        let rc = compress2(
            out.as_mut_ptr(),
            &mut out_len,
            data.as_ptr(),
            data.len() as c_ulong,
            level,
        );
        if rc == 0 {
            out.truncate(out_len as usize);
            out
        } else {
            Vec::new()
        }
    }
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let _ = fs::create_dir_all(dir);
    let mut out = Vec::new();

    let a = make_text_seed_a();
    let b = make_text_seed_b();
    write_seed(dir, "zlib_compress_uncompress", 1, &a, &mut out);
    write_seed(dir, "zlib_compress_uncompress", 2, &b, &mut out);
    write_seed(dir, "zlib_deflate_inflate_stream", 1, &a, &mut out);
    write_seed(dir, "zlib_deflate_inflate_stream", 2, &b, &mut out);
    write_seed(dir, "zlib_gzip_advanced", 1, &a, &mut out);
    write_seed(dir, "zlib_gzip_advanced", 2, &b, &mut out);
    write_seed(dir, "gzip_file_roundtrip", 1, &a, &mut out);
    write_seed(dir, "gzip_file_roundtrip", 2, &b, &mut out);

    let c1 = zlib_compress_bytes(&a, 6);
    let c2 = zlib_compress_bytes(&b, 9);
    write_seed(dir, "zlib_inflate_back", 1, &c1, &mut out);
    write_seed(dir, "zlib_inflate_back", 2, &c2, &mut out);

    let p1 = make_gray_pixels_a();
    let p2 = make_gray_pixels_b();
    write_seed(dir, "png_write_read_roundtrip", 1, &p1, &mut out);
    write_seed(dir, "png_write_read_roundtrip", 2, &p2, &mut out);

    let pp1 = make_palette_pixels_a();
    let pp2 = make_palette_pixels_b();
    write_seed(dir, "png_palette_roundtrip", 1, &pp1, &mut out);
    write_seed(dir, "png_palette_roundtrip", 2, &pp2, &mut out);

    let g1 = make_gif_seed_a();
    let g2 = make_gif_seed_b();
    write_seed(dir, "gif_decode_blocks", 1, &g1, &mut out);
    write_seed(dir, "gif_decode_blocks", 2, &g2, &mut out);

    let n1 = make_pnm_seed_a();
    let n2 = make_pnm_seed_b();
    write_seed(dir, "pnm_roundtrip", 1, &n1, &mut out);
    write_seed(dir, "pnm_roundtrip", 2, &n2, &mut out);

    let r1 = make_rangeset_seed_a();
    let r2 = make_rangeset_seed_b();
    write_seed(dir, "bitset_and_ratio", 1, &r1, &mut out);
    write_seed(dir, "bitset_and_ratio", 2, &r2, &mut out);
    write_seed(dir, "ioutil_paths_and_files", 1, &a, &mut out);
    write_seed(dir, "ioutil_paths_and_files", 2, &b, &mut out);

    out
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let _ = fs::create_dir_all(dir);
    let mut out = Vec::new();
    let big = make_perf_corpus();
    write_perf(dir, "zlib_compress_uncompress", &big, &mut out);
    write_perf(dir, "zlib_deflate_inflate_stream", &big, &mut out);
    write_perf(dir, "zlib_gzip_advanced", &big, &mut out);
    write_perf(dir, "gzip_file_roundtrip", &big, &mut out);
    let big_comp = zlib_compress_bytes(&big, 6);
    write_perf(dir, "zlib_inflate_back", &big_comp, &mut out);
    write_perf(dir, "ioutil_paths_and_files", &big, &mut out);

    let mut png_big = vec![0u8; 512 * 512];
    for y in 0..512usize {
        for x in 0..512usize {
            png_big[y * 512 + x] = ((x * 3 + y * 5 + ((x ^ y) & 31)) & 0xff) as u8;
        }
    }
    write_perf(dir, "png_write_read_roundtrip", &png_big, &mut out);

    let mut pal_big = vec![0u8; 512 * 512];
    for y in 0..512usize {
        for x in 0..512usize {
            pal_big[y * 512 + x] = (((x / 8) + (y / 8) * 3) & 3) as u8;
        }
    }
    write_perf(dir, "png_palette_roundtrip", &pal_big, &mut out);

    let mut pnm_big = Vec::new();
    pnm_big.extend_from_slice(b"P5\n512 512\n255\n");
    pnm_big.extend_from_slice(&png_big);
    write_perf(dir, "pnm_roundtrip", &pnm_big, &mut out);

    out
}

pub fn zlib_compress_uncompress(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let input_crc_z = unsafe { crc32_z(0, data.as_ptr(), data.len()) as u64 };
    let input_adler = unsafe { adler32(1, data.as_ptr(), data.len() as c_uint) as u64 };
    let input_adler_z = unsafe { adler32_z(1, data.as_ptr(), data.len()) as u64 };
    let compile_flags = unsafe { zlibCompileFlags() as u64 };
    let crc_table_nonnull = unsafe { (!get_crc_table().is_null()) as u64 };
    let ver_len = unsafe {
        let p = zlibVersion();
        if p.is_null() {
            0
        } else {
            let mut n = 0usize;
            while *p.add(n) != 0 {
                n += 1;
            }
            n as u64
        }
    };

    let mut digest = fold(0, data.len() as u64);
    let mut last_c_rc = 0i32;
    let mut last_c1_rc = 0i32;
    let mut last_u_rc = 0i32;
    let mut last_u1_rc = 0i32;
    let mut last_eq = 0u64;
    let mut last_comp_len = 0u64;
    let mut last_decomp_len = 0u64;
    let mut last_out_crc = 0u64;
    let mut last_err_strlen = 0u64;
    let mut last_comb_crc = 0u64;
    let mut last_comb_adler = 0u64;

    for _ in 0..iters {
        unsafe {
            let bound = compressBound(data.len() as c_ulong) as usize;
            let mut comp = vec![0u8; bound.max(1)];
            let mut comp_len = bound as c_ulong;
            let c_rc = compress2(
                comp.as_mut_ptr(),
                &mut comp_len,
                data.as_ptr(),
                data.len() as c_ulong,
                6,
            );
            last_c_rc = c_rc;

            let mut comp1 = vec![0u8; bound.max(1)];
            let mut comp1_len = bound as c_ulong;
            let c1_rc = compress(
                comp1.as_mut_ptr(),
                &mut comp1_len,
                data.as_ptr(),
                data.len() as c_ulong,
            );
            last_c1_rc = c1_rc;
            last_comp_len = comp_len as u64;

            let mut decomp = vec![0u8; data.len().max(1)];
            let mut src_len = comp_len;
            let mut decomp_len = decomp.len() as c_ulong;
            let u_rc = uncompress2(
                decomp.as_mut_ptr(),
                &mut decomp_len,
                comp.as_ptr(),
                &mut src_len,
            );
            last_u_rc = u_rc;

            let mut decomp1 = vec![0u8; data.len().max(1)];
            let mut decomp1_len = decomp1.len() as c_ulong;
            let u1_rc = uncompress(
                decomp1.as_mut_ptr(),
                &mut decomp1_len,
                comp1.as_ptr(),
                comp1_len,
            );
            last_u1_rc = u1_rc;
            last_decomp_len = decomp_len as u64;

            let out_slice = &decomp[..(decomp_len as usize).min(decomp.len())];
            last_out_crc = crc32(0, out_slice.as_ptr(), out_slice.len() as c_uint) as u64;
            last_eq = (u_rc == 0 && out_slice == data) as u64;

            let mid = data.len() / 2;
            let crc_a = crc32(0, data.as_ptr(), mid as c_uint);
            let crc_b = crc32(0, data.as_ptr().add(mid), (data.len() - mid) as c_uint);
            last_comb_crc = crc32_combine(crc_a, crc_b, (data.len() - mid) as _) as u64
                ^ crc32_combine64(crc_a, crc_b, (data.len() - mid) as _) as u64;

            let ad_a = adler32(1, data.as_ptr(), mid as c_uint);
            let ad_b = adler32(1, data.as_ptr().add(mid), (data.len() - mid) as c_uint);
            last_comb_adler = adler32_combine(ad_a, ad_b, (data.len() - mid) as _) as u64
                ^ adler32_combine64(ad_a, ad_b, (data.len() - mid) as _) as u64;

            let err_ptr = zError(u_rc);
            last_err_strlen = if err_ptr.is_null() {
                0
            } else {
                let mut n = 0usize;
                while *err_ptr.add(n) != 0 {
                    n += 1;
                }
                n as u64
            };

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, input_crc_z);
            d = fold(d, input_adler);
            d = fold(d, input_adler_z);
            d = fold(d, compile_flags);
            d = fold(d, crc_table_nonnull);
            d = fold(d, ver_len);
            d = fold(d, c_rc as u32 as u64);
            d = fold(d, c1_rc as u32 as u64);
            d = fold(d, u_rc as u32 as u64);
            d = fold(d, u1_rc as u32 as u64);
            d = fold(d, comp_len as u64);
            d = fold(d, decomp_len as u64);
            d = fold(d, last_out_crc);
            d = fold(d, last_eq);
            d = fold(d, last_err_strlen);
            d = fold(d, last_comb_crc);
            d = fold(d, last_comb_adler);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=zlib_compress_uncompress in_len={} in_crc={:08x} in_crc_z={:08x} in_adler={:08x} in_adler_z={:08x} c_rc={} c1_rc={} u_rc={} u1_rc={} comp_len={} decomp_len={} out_crc={:08x} eq={} comb_crc={:08x} comb_adler={:08x} digest={:016x}",
        data.len(),
        input_crc,
        input_crc_z,
        input_adler,
        input_adler_z,
        last_c_rc,
        last_c1_rc,
        last_u_rc,
        last_u1_rc,
        last_comp_len,
        last_decomp_len,
        last_out_crc,
        last_eq,
        last_comb_crc,
        last_comb_adler,
        digest
    )
}

pub fn zlib_deflate_inflate_stream(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let ver_len = unsafe {
        let p = zlibVersion();
        if p.is_null() {
            0
        } else {
            let mut n = 0usize;
            while *p.add(n) != 0 {
                n += 1;
            }
            n as u64
        }
    };

    let dict_len = data.len().min(256);
    let dict = &data[..dict_len];
    let mut digest = fold(0, data.len() as u64);
    let mut last_init_d = 0i32;
    let mut last_set_dict = 0i32;
    let mut last_get_dict = 0i32;
    let mut last_params = 0i32;
    let mut last_tune = 0i32;
    let mut last_prime = 0i32;
    let mut last_pending = 0i32;
    let mut last_copy = 0i32;
    let mut last_def = 0i32;
    let mut last_reset_keep_d = 0i32;
    let mut last_reset_d = 0i32;
    let mut last_end_d = 0i32;
    let mut last_init_i = 0i32;
    let mut last_inf = 0i32;
    let mut last_set_idict = 0i32;
    let mut last_get_idict = 0i32;
    let mut last_copy_i = 0i32;
    let mut last_validate = 0i32;
    let mut last_undermine = 0i32;
    let mut last_sync = 0i32;
    let mut last_sync_point = 0i32;
    let mut last_reset_keep_i = 0i32;
    let mut last_reset2_i = 0i32;
    let mut last_reset_i = 0i32;
    let mut last_end_i = 0i32;
    let mut last_comp_size = 0u64;
    let mut last_decomp_size = 0u64;
    let mut last_out_crc = 0u64;
    let mut last_eq = 0u64;
    let mut last_err_strlen = 0u64;
    let mut last_pending_bits = 0u64;
    let mut last_pending_bytes = 0u64;
    let mut last_mark = 0u64;
    let mut last_codes_used = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut zs_def =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::deflate::z_stream_s>::zeroed()
                    .assume_init();
            let mut zs_def_copy =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::deflate::z_stream_s>::zeroed()
                    .assume_init();
            let mut zs_inf =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>::zeroed()
                    .assume_init();
            let mut zs_inf_copy =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>::zeroed()
                    .assume_init();

            let ver = zlibVersion();

            last_init_d = deflateInit2_(
                &mut zs_def as *mut _ as *mut _,
                6,
                8,
                15,
                8,
                0,
                ver,
                size_of::<optipng_0_7_7_raw::src::zlib::deflate::z_stream_s>() as c_int,
            );

            let mut dict_buf = vec![0u8; dict_len.max(1)];
            let mut got_dict_len = 0u32;
            if last_init_d == 0 {
                last_set_dict = deflateSetDictionary(
                    &mut zs_def as *mut _ as *mut _,
                    dict.as_ptr(),
                    dict_len as c_uint,
                );
                last_get_dict = deflateGetDictionary(
                    &mut zs_def as *mut _ as *mut _,
                    dict_buf.as_mut_ptr(),
                    &mut got_dict_len,
                );
                last_params = deflateParams(&mut zs_def as *mut _ as *mut _, 5, 1);
                last_tune = deflateTune(&mut zs_def as *mut _ as *mut _, 4, 4, 16, 32);
                last_prime = deflatePrime(&mut zs_def as *mut _ as *mut _, 3, 5);
            } else {
                last_set_dict = -9999;
                last_get_dict = -9999;
                last_params = -9999;
                last_tune = -9999;
                last_prime = -9999;
            }

            let bound = if last_init_d == 0 {
                deflateBound(&mut zs_def as *mut _ as *mut _, data.len() as c_ulong) as usize + 64
            } else {
                data.len().saturating_mul(2).saturating_add(64)
            };
            let mut comp = vec![0u8; bound.max(1)];

            zs_def.next_in = data.as_ptr() as *mut _;
            zs_def.avail_in = data.len() as c_uint;
            zs_def.next_out = comp.as_mut_ptr();
            zs_def.avail_out = comp.len() as c_uint;

            let mut pending = 0u32;
            let mut bits = 0i32;
            last_pending = if last_init_d == 0 {
                deflatePending(&mut zs_def as *mut _ as *mut _, &mut pending, &mut bits)
            } else {
                -9999
            };

            last_copy = if last_init_d == 0 {
                deflateCopy(
                    &mut zs_def_copy as *mut _ as *mut _,
                    &mut zs_def as *mut _ as *mut _,
                )
            } else {
                -9999
            };

            last_def = if last_init_d == 0 {
                deflate(&mut zs_def as *mut _ as *mut _, 4)
            } else {
                -9999
            };
            last_comp_size = (comp.len() as u64).wrapping_sub(zs_def.avail_out as u64);
            last_pending_bytes = pending as u64;
            last_pending_bits = bits as u64;

            if last_copy == 0 {
                let _ = deflateEnd(&mut zs_def_copy as *mut _ as *mut _);
            }

            last_reset_keep_d = if last_init_d == 0 {
                deflateResetKeep(&mut zs_def as *mut _ as *mut _)
            } else {
                -9999
            };
            last_reset_d = if last_init_d == 0 {
                deflateReset(&mut zs_def as *mut _ as *mut _)
            } else {
                -9999
            };
            last_end_d = if last_init_d == 0 {
                deflateEnd(&mut zs_def as *mut _ as *mut _)
            } else {
                -9999
            };

            last_init_i = inflateInit2_(
                &mut zs_inf as *mut _ as *mut _,
                15,
                ver,
                size_of::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>() as c_int,
            );

            let mut decomp = vec![0u8; data.len().max(1)];
            zs_inf.next_in = comp.as_ptr() as *mut _;
            zs_inf.avail_in = last_comp_size as c_uint;
            zs_inf.next_out = decomp.as_mut_ptr();
            zs_inf.avail_out = decomp.len() as c_uint;

            if last_init_i == 0 {
                last_validate = inflateValidate(&mut zs_inf as *mut _ as *mut _, 1);
                last_undermine = inflateUndermine(&mut zs_inf as *mut _ as *mut _, 0);
                let mut hdr = MaybeUninit::<gz_header_s>::zeroed().assume_init();
                let _ = inflateGetHeader(&mut zs_inf as *mut _ as *mut _, &mut hdr as *mut _);
                let _ = inflatePrime(&mut zs_inf as *mut _ as *mut _, 0, 0);
            } else {
                last_validate = -9999;
                last_undermine = -9999;
            }

            last_inf = if last_init_i == 0 {
                let rc = inflate(&mut zs_inf as *mut _ as *mut _, 4);
                if rc == 2 && dict_len > 0 {
                    last_set_idict = inflateSetDictionary(
                        &mut zs_inf as *mut _ as *mut _,
                        dict.as_ptr(),
                        dict_len as c_uint,
                    );
                    inflate(&mut zs_inf as *mut _ as *mut _, 4)
                } else {
                    last_set_idict = -7777;
                    rc
                }
            } else {
                -9999
            };
            last_decomp_size = (decomp.len() as u64).wrapping_sub(zs_inf.avail_out as u64);
            let out_slice = &decomp[..(last_decomp_size as usize).min(decomp.len())];
            last_out_crc = crc32(0, out_slice.as_ptr(), out_slice.len() as c_uint) as u64;
            last_eq = (out_slice == data) as u64;

            let mut idict = vec![0u8; dict_len.max(1)];
            let mut idict_len = 0u32;
            last_get_idict = if last_init_i == 0 {
                inflateGetDictionary(
                    &mut zs_inf as *mut _ as *mut _,
                    idict.as_mut_ptr(),
                    &mut idict_len,
                )
            } else {
                -9999
            };
            last_copy_i = if last_init_i == 0 {
                inflateCopy(
                    &mut zs_inf_copy as *mut _ as *mut _,
                    &mut zs_inf as *mut _ as *mut _,
                )
            } else {
                -9999
            };
            if last_copy_i == 0 {
                let _ = inflateEnd(&mut zs_inf_copy as *mut _ as *mut _);
            }

            last_sync = if last_init_i == 0 {
                inflateSync(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };
            last_sync_point = if last_init_i == 0 {
                inflateSyncPoint(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };
            last_mark = if last_init_i == 0 {
                inflateMark(&mut zs_inf as *mut _ as *mut _) as u64
            } else {
                0
            };
            last_codes_used = if last_init_i == 0 {
                inflateCodesUsed(&mut zs_inf as *mut _ as *mut _) as u64
            } else {
                0
            };
            last_reset_keep_i = if last_init_i == 0 {
                inflateResetKeep(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };
            last_reset2_i = if last_init_i == 0 {
                inflateReset2(&mut zs_inf as *mut _ as *mut _, 15)
            } else {
                -9999
            };
            last_reset_i = if last_init_i == 0 {
                inflateReset(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };
            last_end_i = if last_init_i == 0 {
                inflateEnd(&mut zs_inf as *mut _ as *mut _)
            } else {
                -9999
            };

            let err_ptr = zError(last_inf);
            last_err_strlen = if err_ptr.is_null() {
                0
            } else {
                let mut n = 0usize;
                while *err_ptr.add(n) != 0 {
                    n += 1;
                }
                n as u64
            };

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, ver_len);
            d = fold(d, last_init_d as u32 as u64);
            d = fold(d, last_set_dict as u32 as u64);
            d = fold(d, last_get_dict as u32 as u64);
            d = fold(d, got_dict_len as u64);
            d = fold(d, last_params as u32 as u64);
            d = fold(d, last_tune as u32 as u64);
            d = fold(d, last_prime as u32 as u64);
            d = fold(d, last_pending as u32 as u64);
            d = fold(d, last_pending_bytes);
            d = fold(d, last_pending_bits);
            d = fold(d, last_copy as u32 as u64);
            d = fold(d, last_def as u32 as u64);
            d = fold(d, last_reset_keep_d as u32 as u64);
            d = fold(d, last_reset_d as u32 as u64);
            d = fold(d, last_end_d as u32 as u64);
            d = fold(d, last_init_i as u32 as u64);
            d = fold(d, last_inf as u32 as u64);
            d = fold(d, last_set_idict as u32 as u64);
            d = fold(d, last_get_idict as u32 as u64);
            d = fold(d, idict_len as u64);
            d = fold(d, last_copy_i as u32 as u64);
            d = fold(d, last_validate as u32 as u64);
            d = fold(d, last_undermine as u32 as u64);
            d = fold(d, last_sync as u32 as u64);
            d = fold(d, last_sync_point as u32 as u64);
            d = fold(d, last_mark);
            d = fold(d, last_codes_used);
            d = fold(d, last_reset_keep_i as u32 as u64);
            d = fold(d, last_reset2_i as u32 as u64);
            d = fold(d, last_reset_i as u32 as u64);
            d = fold(d, last_end_i as u32 as u64);
            d = fold(d, last_comp_size);
            d = fold(d, last_decomp_size);
            d = fold(d, last_out_crc);
            d = fold(d, last_eq);
            d = fold(d, last_err_strlen);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=zlib_deflate_inflate_stream in_len={} in_crc={:08x} dinit={} setdict={} getdict={} params={} tune={} prime={} pending={} copy={} def={} dresetk={} dreset={} dend={} iinit={} inf={} setidict={} getidict={} copyi={} validate={} undermine={} sync={} syncpt={} iresetk={} ireset2={} ireset={} iend={} comp={} decomp={} out_crc={:08x} eq={} digest={:016x}",
        data.len(),
        input_crc,
        last_init_d,
        last_set_dict,
        last_get_dict,
        last_params,
        last_tune,
        last_prime,
        last_pending,
        last_copy,
        last_def,
        last_reset_keep_d,
        last_reset_d,
        last_end_d,
        last_init_i,
        last_inf,
        last_set_idict,
        last_get_idict,
        last_copy_i,
        last_validate,
        last_undermine,
        last_sync,
        last_sync_point,
        last_reset_keep_i,
        last_reset2_i,
        last_reset_i,
        last_end_i,
        last_comp_size,
        last_decomp_size,
        last_out_crc,
        last_eq,
        digest
    )
}

pub fn zlib_gzip_advanced(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);

    let mut last_w = 0i32;
    let mut last_fw = 0u64;
    let mut last_putc = 0i32;
    let mut last_puts = 0i32;
    let mut last_setparams = 0i32;
    let mut last_flush = 0i32;
    let mut last_tell_w = 0u64;
    let mut last_off_w = 0u64;
    let mut last_close_w = 0i32;
    let mut last_r = 0i32;
    let mut last_fr = 0u64;
    let mut last_getc = 0i32;
    let mut last_getc2 = 0i32;
    let mut last_ungetc = 0i32;
    let mut last_gets_len = 0u64;
    let mut last_direct = 0i32;
    let mut last_seek = 0u64;
    let mut last_seek64 = 0u64;
    let mut last_tell = 0u64;
    let mut last_tell64 = 0u64;
    let mut last_off = 0u64;
    let mut last_off64 = 0u64;
    let mut last_rewind = 0i32;
    let mut last_eof = 0i32;
    let mut last_errnum = 0i32;
    let mut last_close_r = 0i32;
    let mut last_total_read = 0u64;
    let mut last_out_crc = 0u64;
    let mut last_eq = 0u64;
    let mut last_err_strlen = 0u64;
    let line = match CString::new("line-from-gzputs\n") {
        Ok(v) => v,
        Err(_) => unsafe { CString::from_vec_unchecked(vec![b'x']) },
    };

    for iter in 0..iters {
        let path = format!(
            "{}/optipng_raw_harness_gzip_adv_{}_{}.gz",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let c_path = cstring_lossy_no_nul(&path);
        let mode_w = match CString::new("wb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'w', b'b']) },
        };
        let mode_r = match CString::new("rb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b']) },
        };

        unsafe {
            let wf = gzopen64(c_path.as_ptr(), mode_w.as_ptr());
            if (wf as *mut c_void).is_null() {
                digest = fold(digest, 0x1111);
                let _ = fs::remove_file(&path);
                continue;
            }

            let _ = gzbuffer(wf as *mut _, 32768);
            let split = data.len().min(64);
            last_w = gzwrite(wf as *mut _, data.as_ptr() as *const c_void, split as c_uint);
            last_fw = gzfwrite(
                data[split..].as_ptr() as *const c_void,
                1,
                data.len().saturating_sub(split),
                wf as *mut _,
            ) as u64;
            last_putc = gzputc(wf as *mut _, b'!' as c_int);
            last_puts = gzputs(wf as *mut _, line.as_ptr());
            last_setparams = gzsetparams(wf as *mut _, 6, 0);
            last_flush = gzflush(wf as *mut _, 2);
            last_tell_w = gztell(wf as *mut _) as u64;
            last_off_w = gzoffset(wf as *mut _) as u64;
            last_close_w = gzclose_w(wf as *mut _);

            let rf = gzopen(c_path.as_ptr(), mode_r.as_ptr());
            if (rf as *mut c_void).is_null() {
                digest = fold(digest, 0x2222);
                let _ = fs::remove_file(&path);
                continue;
            }

            let _ = gzbuffer(rf as *mut _, 16384);
            last_direct = gzdirect(rf as *mut _);
            last_getc = gzgetc(rf as *mut _);
            last_ungetc = gzungetc(last_getc, rf as *mut _);
            last_getc2 = gzgetc_(rf as *mut _);

            let mut linebuf = vec![0i8; 128];
            let gp = gzgets(rf as *mut _, linebuf.as_mut_ptr(), linebuf.len() as c_int);
            last_gets_len = if gp.is_null() {
                0
            } else {
                let mut n = 0usize;
                while n < linebuf.len() && linebuf[n] != 0 {
                    n += 1;
                }
                n as u64
            };

            last_seek = gzseek(rf as *mut _, 0, 0) as u64;
            last_tell = gztell(rf as *mut _) as u64;
            last_off = gzoffset(rf as *mut _) as u64;

            let mut out = Vec::with_capacity(data.len().saturating_add(64));
            let mut buf = vec![0u8; 4096];
            loop {
                let n = gzread(rf as *mut _, buf.as_mut_ptr() as *mut c_void, buf.len() as c_uint);
                last_r = n;
                if n > 0 {
                    out.extend_from_slice(&buf[..n as usize]);
                } else {
                    break;
                }
            }

            last_seek64 = gzseek64(rf as *mut _, 0, 0) as u64;
            last_tell64 = gztell64(rf as *mut _) as u64;
            last_off64 = gzoffset64(rf as *mut _) as u64;

            let mut out2 = vec![0u8; 256];
            last_fr =
                gzfread(out2.as_mut_ptr() as *mut c_void, 1, out2.len(), rf as *mut _) as u64;
            last_rewind = gzrewind(rf as *mut _);
            last_eof = gzeof(rf as *mut _);
            let mut errnum = 0i32;
            let errp = gzerror(rf as *mut _, &mut errnum);
            last_errnum = errnum;
            last_err_strlen = if errp.is_null() {
                0
            } else {
                let mut n = 0usize;
                while *errp.add(n) != 0 {
                    n += 1;
                }
                n as u64
            };
            gzclearerr(rf as *mut _);
            last_close_r = gzclose_r(rf as *mut _);

            last_total_read = out.len() as u64;
            last_out_crc = crc32(0, out.as_ptr(), out.len() as c_uint) as u64;
            last_eq = out.starts_with(data) as u64;

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, last_w as u32 as u64);
            d = fold(d, last_fw);
            d = fold(d, last_putc as u32 as u64);
            d = fold(d, last_puts as u32 as u64);
            d = fold(d, last_setparams as u32 as u64);
            d = fold(d, last_flush as u32 as u64);
            d = fold(d, last_tell_w);
            d = fold(d, last_off_w);
            d = fold(d, last_close_w as u32 as u64);
            d = fold(d, last_r as u32 as u64);
            d = fold(d, last_fr);
            d = fold(d, last_getc as u32 as u64);
            d = fold(d, last_getc2 as u32 as u64);
            d = fold(d, last_ungetc as u32 as u64);
            d = fold(d, last_gets_len);
            d = fold(d, last_direct as u32 as u64);
            d = fold(d, last_seek);
            d = fold(d, last_seek64);
            d = fold(d, last_tell);
            d = fold(d, last_tell64);
            d = fold(d, last_off);
            d = fold(d, last_off64);
            d = fold(d, last_rewind as u32 as u64);
            d = fold(d, last_eof as u32 as u64);
            d = fold(d, last_errnum as u32 as u64);
            d = fold(d, last_close_r as u32 as u64);
            d = fold(d, last_total_read);
            d = fold(d, last_out_crc);
            d = fold(d, last_eq);
            d = fold(d, last_err_strlen);
            digest = fold(digest, d);
        }

        let _ = fs::remove_file(&path);
    }

    format!(
        "op=zlib_gzip_advanced in_len={} in_crc={:08x} w={} fw={} putc={} puts={} setp={} flush={} tellw={} offw={} closew={} r={} fr={} getc={} getc2={} ungetc={} getslen={} direct={} seek={} seek64={} tell={} tell64={} off={} off64={} rewind={} eof={} errnum={} closer={} total_read={} out_crc={:08x} eq={} digest={:016x}",
        data.len(),
        input_crc,
        last_w,
        last_fw,
        last_putc,
        last_puts,
        last_setparams,
        last_flush,
        last_tell_w,
        last_off_w,
        last_close_w,
        last_r,
        last_fr,
        last_getc,
        last_getc2,
        last_ungetc,
        last_gets_len,
        last_direct,
        last_seek,
        last_seek64,
        last_tell,
        last_tell64,
        last_off,
        last_off64,
        last_rewind,
        last_eof,
        last_errnum,
        last_close_r,
        last_total_read,
        last_out_crc,
        last_eq,
        digest
    )
}

pub fn gzip_file_roundtrip(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let input_adler = unsafe { adler32(1, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);

    let mut last_open_w = 0u64;
    let mut last_write1 = 0i32;
    let mut last_write2 = 0i32;
    let mut last_flush = 0i32;
    let mut last_close_w = 0i32;
    let mut last_open_r = 0u64;
    let mut last_read_total = 0u64;
    let mut last_read_calls = 0u64;
    let mut last_eof = 0i32;
    let mut last_close_r = 0i32;
    let mut last_out_crc = 0u64;
    let mut last_out_adler = 0u64;
    let mut last_eq = 0u64;
    let mut last_errnum = 0i32;
    let mut last_errstrlen = 0u64;

    for iter in 0..iters {
        let path = format!(
            "{}/optipng_raw_harness_gzip_roundtrip_{}_{}.gz",
            std::env::temp_dir().display(),
            data.len(),
            iter
        );
        let c_path = cstring_lossy_no_nul(&path);
        let mode_w = match CString::new("wb9") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'w', b'b', b'9']) },
        };
        let mode_r = match CString::new("rb") {
            Ok(v) => v,
            Err(_) => unsafe { CString::from_vec_unchecked(vec![b'r', b'b']) },
        };

        unsafe {
            let wf = gzopen64(c_path.as_ptr(), mode_w.as_ptr());
            last_open_w = (!((wf as *mut c_void).is_null())) as u64;
            if (wf as *mut c_void).is_null() {
                digest = fold(digest, 0x7771);
                let _ = fs::remove_file(&path);
                continue;
            }

            let _ = gzbuffer(wf as *mut _, 32768);
            let split = data.len() / 2;
            last_write1 =
                gzwrite(wf as *mut _, data.as_ptr() as *const c_void, split as c_uint);
            last_write2 = gzwrite(
                wf as *mut _,
                data[split..].as_ptr() as *const c_void,
                (data.len() - split) as c_uint,
            );
            last_flush = gzflush(wf as *mut _, 4);
            last_close_w = gzclose_w(wf as *mut _);

            let rf = gzopen(c_path.as_ptr(), mode_r.as_ptr());
            last_open_r = (!((rf as *mut c_void).is_null())) as u64;
            if (rf as *mut c_void).is_null() {
                digest = fold(digest, 0x7772);
                let _ = fs::remove_file(&path);
                continue;
            }

            let _ = gzbuffer(rf as *mut _, 32768);
            let mut out = Vec::with_capacity(data.len().saturating_add(16));
            let mut buf = vec![0u8; 8192];
            loop {
                let n = gzread(rf as *mut _, buf.as_mut_ptr() as *mut c_void, buf.len() as c_uint);
                last_read_calls = last_read_calls.wrapping_add(1);
                if n > 0 {
                    out.extend_from_slice(&buf[..n as usize]);
                } else {
                    break;
                }
            }

            last_eof = gzeof(rf as *mut _);
            let mut errnum = 0i32;
            let errp = gzerror(rf as *mut _, &mut errnum);
            last_errnum = errnum;
            last_errstrlen = if errp.is_null() {
                0
            } else {
                let mut n = 0usize;
                while *errp.add(n) != 0 {
                    n += 1;
                }
                n as u64
            };
            gzclearerr(rf as *mut _);
            last_close_r = gzclose_r(rf as *mut _);

            last_read_total = out.len() as u64;
            last_out_crc = crc32(0, out.as_ptr(), out.len() as c_uint) as u64;
            last_out_adler = adler32(1, out.as_ptr(), out.len() as c_uint) as u64;
            last_eq = (out == data) as u64;

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, input_adler);
            d = fold(d, last_open_w);
            d = fold(d, last_write1 as u32 as u64);
            d = fold(d, last_write2 as u32 as u64);
            d = fold(d, last_flush as u32 as u64);
            d = fold(d, last_close_w as u32 as u64);
            d = fold(d, last_open_r);
            d = fold(d, last_read_total);
            d = fold(d, last_read_calls);
            d = fold(d, last_eof as u32 as u64);
            d = fold(d, last_close_r as u32 as u64);
            d = fold(d, last_out_crc);
            d = fold(d, last_out_adler);
            d = fold(d, last_eq);
            d = fold(d, last_errnum as u32 as u64);
            d = fold(d, last_errstrlen);
            digest = fold(digest, d);
        }

        let _ = fs::remove_file(&path);
    }

    format!(
        "op=gzip_file_roundtrip in_len={} in_crc={:08x} in_adler={:08x} open_w={} w1={} w2={} flush={} close_w={} open_r={} read_total={} read_calls={} eof={} close_r={} out_crc={:08x} out_adler={:08x} eq={} errnum={} errstrlen={} digest={:016x}",
        data.len(),
        input_crc,
        input_adler,
        last_open_w,
        last_write1,
        last_write2,
        last_flush,
        last_close_w,
        last_open_r,
        last_read_total,
        last_read_calls,
        last_eof,
        last_close_r,
        last_out_crc,
        last_out_adler,
        last_eq,
        last_errnum,
        last_errstrlen,
        digest
    )
}

#[repr(C)]
struct InflateBackIn {
    data: Vec<u8>,
    pos: usize,
    scratch: Vec<u8>,
}

#[repr(C)]
struct InflateBackOut {
    out: Vec<u8>,
}

unsafe extern "C" fn infback_in(desc: *mut c_void, buf: *mut *mut c_uchar) -> c_uint {
    if desc.is_null() || buf.is_null() {
        return 0;
    }
    let st = &mut *(desc as *mut InflateBackIn);
    if st.pos >= st.data.len() {
        *buf = ptr::null_mut();
        return 0;
    }
    let take = (st.data.len() - st.pos).min(4096);
    st.scratch.clear();
    st.scratch
        .extend_from_slice(&st.data[st.pos..st.pos + take]);
    st.pos += take;
    *buf = st.scratch.as_mut_ptr();
    take as c_uint
}

unsafe extern "C" fn infback_out(desc: *mut c_void, buf: *mut c_uchar, len: c_uint) -> c_int {
    if desc.is_null() || (buf.is_null() && len != 0) {
        return 1;
    }
    let st = &mut *(desc as *mut InflateBackOut);
    let slice = std::slice::from_raw_parts(buf as *const u8, len as usize);
    st.out.extend_from_slice(slice);
    0
}

pub fn zlib_inflate_back(data: &[u8], iters: u64) -> String {
    let input_crc = unsafe { crc32(0, data.as_ptr(), data.len() as c_uint) as u64 };
    let mut digest = fold(0, data.len() as u64);
    let mut last_init = 0i32;
    let mut last_back = 0i32;
    let mut last_end = 0i32;
    let mut last_out_len = 0u64;
    let mut last_out_crc = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut zs =
                MaybeUninit::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>::zeroed()
                    .assume_init();
            let mut window = vec![0u8; 1 << 15];
            let ver = zlibVersion();
            last_init = inflateBackInit_(
                &mut zs as *mut _ as *mut _,
                15,
                window.as_mut_ptr(),
                ver,
                size_of::<optipng_0_7_7_raw::src::zlib::inflate::z_stream_s>() as c_int,
            );

            let mut in_state = InflateBackIn {
                data: data.to_vec(),
                pos: 0,
                scratch: Vec::new(),
            };
            let mut out_state = InflateBackOut { out: Vec::new() };

            last_back = if last_init == 0 {
                inflateBack(
                    &mut zs as *mut _ as *mut _,
                    Some(infback_in),
                    &mut in_state as *mut _ as *mut c_void,
                    Some(infback_out),
                    &mut out_state as *mut _ as *mut c_void,
                )
            } else {
                -9999
            };
            last_end = if last_init == 0 {
                inflateBackEnd(&mut zs as *mut _ as *mut _)
            } else {
                -9999
            };
            last_out_len = out_state.out.len() as u64;
            last_out_crc = crc32(0, out_state.out.as_ptr(), out_state.out.len() as c_uint) as u64;

            let mut d = 0u64;
            d = fold(d, input_crc);
            d = fold(d, last_init as u32 as u64);
            d = fold(d, last_back as u32 as u64);
            d = fold(d, last_end as u32 as u64);
            d = fold(d, last_out_len);
            d = fold(d, last_out_crc);
            digest = fold(digest, d);
        }
    }

    format!(
        "op=zlib_inflate_back in_len={} in_crc={:08x} init={} back={} end={} out_len={} out_crc={:08x} digest={:016x}",
