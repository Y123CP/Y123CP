    mut max_code: c_int,
    mut bl_count: *mut ushf,
) {
    let mut next_code: [ush; 16] = [0; 16];
    let mut code: c_uint = 0 as c_uint;
    let mut bits: c_int = 0;

    // SAFETY: `bl_count` is read repeatedly for indices 0..=(MAX_BITS - 1); by caller
    // contract it points to at least `MAX_BITS` contiguous `ushf` elements, is non-null,
    // and no Rust reference aliases that memory for the duration of this shared view.
    let bl_count = unsafe { core::slice::from_raw_parts(bl_count, MAX_BITS as usize) };
    // SAFETY: the loop walks entries 0..=max_code; by caller contract `tree` points to
    // at least `max_code + 1` contiguous `ct_data` elements, is non-null, and no other
    // Rust reference aliases that region while this mutable view is live.
    let tree = unsafe { core::slice::from_raw_parts_mut(tree, max_code.wrapping_add(1) as usize) };

    bits = 1 as c_int;
    while bits <= MAX_BITS {
        // SAFETY: `bits` runs from 1 through `MAX_BITS`, so `(bits - 1) as usize`
        // is in 0..MAX_BITS, which is in-bounds for the `bl_count` slice above.
        let prev_count = unsafe { *bl_count.get_unchecked((bits - 1 as c_int) as usize) };
        code = code.wrapping_add(prev_count as c_uint) << 1 as c_int;
        next_code[bits as usize] = code as ush;
        bits += 1;
    }

    for node in tree.iter_mut() {
        let len: c_int = node.dl.len as c_int;
        if len != 0 as c_int {
            // SAFETY: nonzero code lengths in `tree` satisfy the deflate invariant
            // `1 <= len <= MAX_BITS`; `next_code` has length 16, so `len as usize`
            // is in-bounds for `next_code`.
            let slot = unsafe { next_code.get_unchecked_mut(len as usize) };
            let code_for_len = *slot;
            *slot = (*slot).wrapping_add(1);
            node.fc.code = bi_reverse(code_for_len as c_uint, len) as ush;
