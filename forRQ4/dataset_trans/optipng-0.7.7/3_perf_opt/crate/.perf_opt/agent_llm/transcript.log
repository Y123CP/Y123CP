    // NUL-terminated C string within one allocation; this function only reads it,
    // and no Rust references to the same storage are created elsewhere here.
    let bytes = unsafe { core::ffi::CStr::from_ptr(rangeset_str).to_bytes() };
    let len = bytes.len();
    let mut idx: usize = 0;

    #[inline(always)]
    fn is_space_byte(b: u8) -> bool {
        matches!(b, b' ' | b'\t' | b'\n' | b'\r' | 0x0b | 0x0c)
    }

    loop {
        while idx < len {
            let b = unsafe { *bytes.get_unchecked(idx) };
            if !is_space_byte(b) {
                break;
            }
            idx += 1;
        }

        let cur = if idx < len {
            unsafe { *bytes.get_unchecked(idx) }
        } else {
            0
        };

        if state == 1 && cur == b'-' {
            idx += 1;
            num2 = OPNG_BITSET_ELT_MAX as c_int;
            state += 1;
            continue;
