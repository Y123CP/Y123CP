        let mut i: usize = 0;
        while i < 256 {
            S8[0][i] = crc_table[0][i];
            i += 1;
        }
        let mut s: usize = 1;
        while s < 8 {
            let mut j: usize = 0;
            while j < 256 {
                let prev = S8[s - 1][j];
                S8[s][j] = (prev >> 8) ^ S8[0][(prev & 0xff) as usize];
                j += 1;
            }
            s += 1;
        }
        S8_INIT = true;
    }

    c = !c;

    if len != 0 {
        let prefix = len;
