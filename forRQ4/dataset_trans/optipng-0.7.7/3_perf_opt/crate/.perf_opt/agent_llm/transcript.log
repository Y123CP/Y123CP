                row_width.wrapping_mul(pixel_depth as size_t >> 3 as c_int)
            } else {
                row_width
                    .wrapping_mul(pixel_depth as size_t)
                    .wrapping_add(7 as size_t)
                    >> 3 as c_int
            },
        );
    }
    if !end_ptr.is_null() {
        *end_ptr = (end_byte as c_uint & end_mask
            | *end_ptr as c_uint & !end_mask) as png_byte;
    }
} 
```

