    if (*png_ptr).transformed_pixel_depth as c_int == 0 as c_int {
        (*png_ptr).transformed_pixel_depth = row_info.pixel_depth;
        if row_info.pixel_depth as c_int
            > (*png_ptr).maximum_pixel_depth as c_int
        {
