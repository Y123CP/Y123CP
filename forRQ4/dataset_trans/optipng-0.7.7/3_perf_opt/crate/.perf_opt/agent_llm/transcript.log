                    png_read_finish_row(png_ptr);
                    return;
                }
            }
            4 => {
                if (*png_ptr).row_number as c_uint & 3 as c_uint
                    != 2 as c_uint
                {
                    if !dsp_row.is_null()
                        && (*png_ptr).row_number as c_uint & 2 as c_uint
                            != 0
