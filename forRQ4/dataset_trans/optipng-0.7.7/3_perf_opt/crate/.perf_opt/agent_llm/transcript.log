let pixels_per_byte: png_uint_32 =
    (8 as png_uint_32).wrapping_div(pixel_depth as png_uint_32);
let depth_idx = if pixel_depth == 1 as c_uint {
    0usize
} else if pixel_depth == 2 as c_uint {
    1usize
} else {
    2usize
