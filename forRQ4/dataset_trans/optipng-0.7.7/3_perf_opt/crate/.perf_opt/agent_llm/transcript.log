        let cur = if idx < len {
            unsafe { *bytes.get_unchecked(idx) }
        } else {
            0
        };
        if cur == b',' || cur == b';' {
            idx += 1;
        } else {
            if !(cur == b'-') {
                break;
            }
            err_invalid = 1 as c_int;
            break;
        }
    }

    while idx < len {
        let b = unsafe { *bytes.get_unchecked(idx) };
        if !is_space_byte(b) {
            break;
        }
        idx += 1;
    }

    if idx != len {
        err_invalid = 1 as c_int;
    }

    if err_invalid != 0 {
        *__errno_location() = EINVAL;
        *out_set = OPNG_BITSET_EMPTY as opng_bitset_t;
        return -(1 as c_int);
    } else if err_range != 0 {
        *__errno_location() = ERANGE;
        *out_set = OPNG_BITSET_FULL as opng_bitset_t;
        return -(1 as c_int);
    } else {
        *out_set = result;
        return 0 as c_int;
    };
}
