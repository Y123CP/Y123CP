                err_range = 1 as c_int;
            }
            if state == 0 as c_int {
                num1 = num;
            }
            num2 = num;
            state += 1;
            continue;
        }

        if state > 0 as c_int {
            if num1 <= num2 {
                result |= if num1 <= num2 {
                    ((1 as c_uint) << num2 - num1 << 1 as c_int).wrapping_sub(1 as c_uint) << num1
