          },
          "replacement_region_source": "{\n    // SAFETY: this match arm is entered only when `bytes_to_copy == 3`, so\n    // both `sp` and `dp` are valid for at least 3 contiguous bytes at the\n    // current cursor positions; the original code already dereferenced these\n    // raw pointers. We create short-lived slice views only for these 3-byte\n    // accesses, and no Rust references to the same memory are otherwise live\n    // across this region.\n    let src = unsafe { ::core::slice::from_raw_parts(sp, 3) };\n    // SAFETY: same reasoning as above; `dp` is valid for 3 writable bytes.\n    let dst = unsafe { ::core::slice::from_raw_parts_mut(dp, 3) };\n    dst.copy_from_slice(src);\n\n    if row_width <= bytes_to_jump as png_alloc_size_t {\n        return;\n    }\n    sp = sp.offset(bytes_to_jump as isize);\n    dp = dp.offset(bytes_to_jump as isize);\n    row_width = (row_width as c_ulong)\n        .wrapping_sub(bytes_to_jump as c_ulong)\n        as png_alloc_size_t as png_alloc_size_t;\n}",
          "rule_id": "III④"
        }
