          "replacement_region_source": "let pixels_per_byte: png_uint_32 =\n    (8 as png_uint_32).wrapping_div(pixel_depth as png_uint_32);\nlet depth_idx = if pixel_depth == 1 as c_uint {\n    0usize\n} else if pixel_depth == 2 as c_uint {\n    1usize\n} else {\n    2usize\n};\nlet mut mask: png_uint_32 = if display != 0 {\n    display_mask[1usize][depth_idx][(pass >> 1 as c_int) as usize] as png_uint_32\n} else {\n    row_mask[1usize][depth_idx][pass as usize] as png_uint_32\n};\n\nwhile row_width > 0 as png_alloc_size_t {\n    let m = mask & 0xff as c_uint;\n    mask = mask >> 8 as c_int | mask << 24 as c_int;\n\n    if m != 0 as c_uint {\n        if m != 0xff as c_uint {\n            *dp = (*dp as png_uint_32 & !m | *sp as png_uint_32 & m) as png_byte;\n        } else {\n            *dp = *sp;\n        }\n    }\n\n    if row_width <= pixels_per_byte as png_alloc_size_t {\n        break;\n    }\n    row_width = (row_width as c_ulong).wrapping_sub(pixels_per_byte as c_ulong)\n        as png_alloc_size_t as png_alloc_size_t;\n    dp = dp.offset(1);\n    sp = sp.offset(1);\n}",
          "rule_id": "II_vec"
        }
