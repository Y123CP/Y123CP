    "rust_source": "pub fn CombineLengthCodes(\n    mut inscode: uint16_t,\n    mut copycode: uint16_t,\n    mut use_last_distance: c_int,\n) -> uint16_t { {\n    let mut bits64: uint16_t = (copycode as c_uint & 0x7 as c_uint\n        | (inscode as c_uint & 0x7 as c_uint) << 3 as c_uint)\n        as uint16_t;\n    if use_last_distance != 0\n        && (inscode as c_uint) < 8 as c_uint\n        && (copycode as c_uint) < 16 as c_uint\n    {\n        return (if (copycode as c_uint) < 8 as c_uint {\n            bits64 as c_uint\n        } else {\n            bits64 as c_uint | 64 as c_uint\n        }) as uint16_t;\n    } else {\n        let mut offset: uint32_t = (2 as uint32_t).wrapping_mul(\n            ((copycode as c_int >> 3 as c_uint) as uint32_t)\n                .wrapping_add((3 as uint32_t).wrapping_mul(\n                    (inscode as c_int >> 3 as c_uint) as uint32_t,\n                )),\n        );\n        offset = (offset << 5 as c_uint)\n            .wrapping_add(0x40 as uint32_t)\n            .wrapping_add(0x520d40 as uint32_t >> offset & 0xc0 as uint32_t);\n        return (offset | bits64 as uint32_t) as uint16_t;\n    };\n} }",
