          "replacement_region_source": "let b0 = *input.offset(0 as c_int as isize) as c_int;\nif b0 & 0x80 as c_int == 0 as c_int {\n    *symbol = b0;\n    if b0 > 0 as c_int {\n        return 1 as size_t;\n    }\n}\nif size > 1 as size_t {\n    let b1 = *input.offset(1 as c_int as isize) as c_int;\n    if b0 & 0xe0 as c_int == 0xc0 as c_int\n        && b1 & 0xc0 as c_int == 0x80 as c_int\n    {\n        *symbol = (b0 & 0x1f as c_int) << 6 as c_int | b1 & 0x3f as c_int;\n        if *symbol > 0x7f as c_int {\n            return 2 as size_t;\n        }\n    }\n}\nif size > 2 as size_t {\n    let b1 = *input.offset(1 as c_int as isize) as c_int;\n    let b2 = *input.offset(2 as c_int as isize) as c_int;\n    if b0 & 0xf0 as c_int == 0xe0 as c_int\n        && b1 & 0xc0 as c_int == 0x80 as c_int\n        && b2 & 0xc0 as c_int == 0x80 as c_int\n    {\n        *symbol = (b0 & 0xf as c_int) << 12 as c_int\n            | (b1 & 0x3f as c_int) << 6 as c_int\n            | b2 & 0x3f as c_int;\n        if *symbol > 0x7ff as c_int {\n            return 3 as size_t;\n        }\n    }\n}\nif size > 3 as size_t {\n    let b1 = *input.offset(1 as c_int as isize) as c_int;\n    let b2 = *input.offset(2 as c_int as isize) as c_int;\n    let b3 = *input.offset(3 as c_int as isize) as c_int;\n    if b0 & 0xf8 as c_int == 0xf0 as c_int\n        && b1 & 0xc0 as c_int == 0x80 as c_int\n        && b2 & 0xc0 as c_int == 0x80 as c_int\n        && b3 & 0xc0 as c_int == 0x80 as c_int\n    {\n        *symbol = (b0 & 0x7 as c_int) << 18 as c_int\n            | (b1 & 0x3f as c_int) << 12 as c_int\n            | (b2 & 0x3f as c_int) << 6 as c_int\n            | b3 & 0x3f as c_int;\n        if *symbol > 0xffff as c_int && *symbol <= 0x10ffff as c_int {\n            return 4 as size_t;\n        }\n    }\n}\n*symbol = 0x110000 as c_int | b0;\nreturn 1 as size_t;",
