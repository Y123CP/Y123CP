          "replacement_region_source": "let s1_orig: *const uint8_t = s1;\n    let mut matched: size_t = 0;\n    while limit >= 8 as size_t {\n        let x: uint64_t = BrotliUnalignedRead64(s2 as *const c_void)\n            ^ BrotliUnalignedRead64(s1 as *const c_void);\n        if x != 0 as uint64_t {\n            let matching_bits: size_t =\n                (x as c_ulonglong).trailing_zeros() as i32 as size_t;\n            return matched.wrapping_add(matching_bits >> 3 as c_int);\n        }\n        s1 = s1.offset(8 as c_int as isize);\n        s2 = s2.offset(8 as c_int as isize);\n        matched = matched.wrapping_add(8 as size_t);\n        limit = (limit as c_ulong).wrapping_sub(8 as c_ulong) as size_t\n            as size_t;\n    }\n    // SAFETY: `s1` and `s2` are valid for `limit` remaining bytes by the\n    // function's cursor+limit contract; they are read-only here, non-null per\n    // caller invariants, and no mutable references are created.\n    let s1_tail = unsafe { ::core::slice::from_raw_parts(s1, limit) };\n    // SAFETY: same as above for `s2`.\n    let s2_tail = unsafe { ::core::slice::from_raw_parts(s2, limit) };\n    for (&b1, &b2) in s1_tail.iter().zip(s2_tail.iter()) {\n        if b1 != b2 {\n            break;\n        }\n        matched = matched.wrapping_add(1);\n    }\n    return matched;",
          "rule_id": "III④,C3"
