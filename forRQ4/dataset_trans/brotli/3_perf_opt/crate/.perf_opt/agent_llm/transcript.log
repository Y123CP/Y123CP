            != *data.offset(prev_ix as isize) as c_int
            || *data.offset(cur_ix_masked.wrapping_add(1 as size_t) as isize) as c_int
                != *data.offset(prev_ix.wrapping_add(1 as size_t) as isize) as c_int)
