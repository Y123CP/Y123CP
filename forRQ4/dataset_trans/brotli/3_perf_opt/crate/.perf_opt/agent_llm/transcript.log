#[inline(always)]
pub unsafe fn BrotliDropBits(br: *mut BrotliBitReader, mut n_bits: uint64_t) {
    (*br).bit_pos_ = ((*br).bit_pos_ as c_ulong)
        .wrapping_sub(n_bits as c_ulong) as uint64_t as uint64_t;
    (*br).val_ >>= n_bits;
}
```

