fn make_binaryish_corpus(records: usize, variant: u32) -> Vec<u8> {
    let mut out = Vec::new();
    let header = make_corpus(records / 8 + 1, variant);
    out.extend_from_slice(&header[..header.len().min(4096)]);
    for i in 0..records {
        out.extend_from_slice(b"PKT");
        out.push((i & 0xff) as u8);
        out.push(((i >> 8) & 0xff) as u8);
        out.extend_from_slice(&(0xA5A5_0000u32 ^ (i as u32) ^ variant).to_le_bytes());
        let block = if i % 4 == 0 {
            b"AAAAABBBBBCCCCCDDDDDEEEEEFFFFF".as_slice()
        } else if i % 4 == 1 {
            b"\x00\x01\x02\x03\x00\x01\x02\x03\xff\xfe\xfd\xfc".as_slice()
        } else if i % 4 == 2 {
            b"brotli-brotli-brotli-static-dictionary".as_slice()
        } else {
            b"UTF8:\xE2\x98\x83:\xD0\xB4\xD0\xB0\xD0\xBD\xD0\xBD\xD1\x8B\xD0\xB5".as_slice()
        };
        out.extend_from_slice(block);
        out.extend_from_slice(b"\n");
    }
    out
}

fn clamp_to_char_boundary(s: &str, idx: usize) -> usize {
    let mut i = idx.min(s.len());
    while i > 0 && !s.is_char_boundary(i) {
        i -= 1;
    }
    i
}

fn make_shared_dict_input(dict_len: usize, body_records: usize, variant: u32) -> Vec<u8> {
    let mut dict = make_corpus(dict_len.max(1), variant);
    if dict.len() > dict_len {
        dict.truncate(dict_len);
    }
    while dict.len() < dict_len {
        dict.extend_from_slice(
            b"DICT reusable phrase path=/api/v1/items template=/tenant/{id}/resource/{name}\n",
        );
    }
    dict.truncate(dict_len);

    let phrases = String::from_utf8_lossy(&dict[..dict.len().min(384)]).into_owned();
    let mut body = String::new();
    let plen = phrases.len().max(1);
    for i in 0..body_records {
        body.push_str("body record=");
        body.push_str(&i.to_string());
        body.push_str(" copied=\"");
        let raw_start = (i * 13) % plen;
        let raw_end = (raw_start + 72).min(plen);
        let start = clamp_to_char_boundary(&phrases, raw_start);
        let end = clamp_to_char_boundary(&phrases, raw_end);
        if start < end {
            body.push_str(&phrases[start..end]);
        }
        body.push_str(
            "\" tail=\"reusable phrase reusable phrase /api/v1/items template=/tenant/{id}/resource/{name}\" lang=\"東京 résumé данные\" \n",
        );
    }

    let mut out = dict;
    out.extend_from_slice(body.as_bytes());
    out
}

fn encode_oneshot_with_params(
    data: &[u8],
    quality: i32,
    lgwin: i32,
    mode: u32,
) -> (i32, Vec<u8>) {
    unsafe {
        let max_size = BrotliEncoderMaxCompressedSize(data.len()) as usize;
        let mut out = vec![0u8; max_size.max(1)];
        let mut encoded_size = out.len();
        let ok = BrotliEncoderCompress(
            quality,
            lgwin,
            mode,
            data.len() as _,
            data.as_ptr(),
            &mut encoded_size as *mut usize as *mut _,
            out.as_mut_ptr(),
        );
        if ok == 0 {
            (0, Vec::new())
        } else {
            out.truncate(encoded_size.min(out.len()));
            (ok, out)
        }
    }
}

struct StreamEncResult {
    status: i32,
    finished: i32,
    compressed: Vec<u8>,
    total_out: usize,
    prep_size: usize,
    attach_ok: i32,
}

unsafe fn stream_encode_with_quality(
    data: &[u8],
    dict: Option<&[u8]>,
