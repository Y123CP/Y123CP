    if st.is_null() {
        return StreamEncResult {
            status: 0,
            finished: 0,
            compressed: Vec::new(),
            total_out: 0,
            prep_size: 0,
            attach_ok: 0,
        };
    }

    let mut prep = ptr::null_mut();
    let mut prep_size = 0usize;
    let mut attach_ok = 0i32;

    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_MODE, mode);
    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_QUALITY, quality);
    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_LGWIN, lgwin);

    if let Some(d) = dict {
        prep = BrotliEncoderPrepareDictionary(
            BROTLI_SHARED_DICTIONARY_RAW,
            d.len() as _,
            d.as_ptr(),
            quality as i32,
            None,
            None,
            ptr::null_mut(),
        );
