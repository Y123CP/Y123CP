fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9E37_79B9_7F4A_7C15)
}

fn sample_checksum(bytes: &[u8]) -> u64 {
    let mut d = bytes.len() as u64;
    if bytes.is_empty() {
        return d;
    }
    let stride = bytes.len().saturating_div(32).max(1);
    let mut i = 0usize;
    let mut taken = 0usize;
    while i < bytes.len() && taken < 64 {
        d = fold(d, ((i as u64) << 8) | bytes[i] as u64);
        i = i.saturating_add(stride);
        taken += 1;
    }
    d = fold(d, bytes[0] as u64);
    d = fold(d, bytes[bytes.len() - 1] as u64);
    d
}

fn cstr_checksum(p: *const std::ffi::c_char) -> u64 {
    if p.is_null() {
        return 0;
    }
    let s = unsafe { CStr::from_ptr(p) }.to_bytes();
    sample_checksum(&s[..s.len().min(96)])
}

fn write_file(path: &str, bytes: &[u8]) {
    let _ = fs::create_dir_all(
        std::path::Path::new(path)
            .parent()
            .unwrap_or(std::path::Path::new(".")),
    );
    let _ = fs::write(path, bytes);
}

fn make_corpus(records: usize, variant: u32) -> Vec<u8> {
    let mut s = String::new();
    let words = [
        "alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "gamma", "hotel", "india",
        "juliet", "kilo", "lima", "mike", "november", "oscar", "papa", "québec", "résumé",
        "東京", "данные",
    ];
    let paths = [
        "/api/v1/items",
        "/srv/app/cache",
        "/var/log/service",
        "/home/user/project",
        "/static/assets/img",
        "/data/archive/2024",
        "/tenant/{id}/resource/{name}",
    ];
    let levels = ["INFO", "WARN", "DEBUG", "TRACE", "ERROR"];
    for i in 0..records {
        let w1 = words[(i + variant as usize) % words.len()];
        let w2 = words[(i * 7 + 3 + variant as usize) % words.len()];
        let p = paths[(i * 5 + variant as usize) % paths.len()];
        let lvl = levels[(i * 3 + variant as usize) % levels.len()];
        let ts = 1_700_000_000u64 + (i as u64 * 17) + variant as u64;
        let id = (i as u64).wrapping_mul(1315423911) ^ (variant as u64 * 0x9e37);

        s.push_str(lvl);
        s.push_str(" ts=");
        s.push_str(&ts.to_string());
        s.push_str(" path=");
        s.push_str(p);
        s.push_str(" msg=\"");
        s.push_str(w1);
        s.push(' ');
        s.push_str(w2);
        s.push_str(" request completed status=");
        s.push_str(if i % 11 == 0 { "500" } else { "200" });
        s.push_str(" template=/tenant/{id}/resource/{name}\" user=u");
        s.push_str(&(i % 97).to_string());
        s.push_str(" region=us-east-1 json={\"kind\":\"event\",\"id\":");
        s.push_str(&id.to_string());
        s.push_str(",\"name\":\"");
        s.push_str(w1);
        s.push_str("\",\"path\":\"");
        s.push_str(p);
        s.push_str("\",\"tags\":[\"");
        s.push_str(w1);
        s.push_str("\",\"");
        s.push_str(w2);
        s.push_str("\",\"repeated-template\"],\"ok\":");
        s.push_str(if i % 2 == 0 { "true" } else { "false" });
        s.push_str("}\n");

        if i % 3 == 0 {
            s.push_str(
                "repeat repeat repeat common prefix common suffix reusable phrase reusable phrase\n",
            );
        }
        if i % 5 == 0 {
            s.push_str(
                "GET /healthz HTTP/1.1 host=service.local ua=synthetic-benchmark/1.0 accept=*/*\n",
            );
        }
        if i % 7 == 0 {
            s.push_str("csv,");
            s.push_str(w1);
            s.push(',');
            s.push_str(w2);
            s.push(',');
            s.push_str(&i.to_string());
            s.push_str(",42,17,17,17\n");
        }
        if i % 13 == 0 {
            s.push_str("xml=<item key=\"repeated\">value value value value</item>\n");
        }
    }
    s.into_bytes()
}

fn make_binaryish_corpus(records: usize, variant: u32) -> Vec<u8> {
    let mut out = Vec::new();
    let header = make_corpus(records / 8 + 1, variant);
    out.extend_from_slice(&header[..header.len().min(4096)]);
    for i in 0..records {
        out.extend_from_slice(b"PKT");
        out.push((i & 0xff) as u8);
        out.push(((i >> 8) & 0xff) as u8);
        out.extend_from_slice(&(0xA5A5_0000u32 ^ (i as u32) ^ variant).to_le_bytes());
        let block = if i % 4 == 0 {
            b"AAAAABBBBBCCCCCDDDDDEEEEEFFFFF".as_slice()
        } else if i % 4 == 1 {
            b"\x00\x01\x02\x03\x00\x01\x02\x03\xff\xfe\xfd\xfc".as_slice()
        } else if i % 4 == 2 {
            b"brotli-brotli-brotli-static-dictionary".as_slice()
        } else {
            b"UTF8:\xE2\x98\x83:\xD0\xB4\xD0\xB0\xD0\xBD\xD0\xBD\xD1\x8B\xD0\xB5".as_slice()
        };
        out.extend_from_slice(block);
        out.extend_from_slice(b"\n");
    }
    out
}

fn make_shared_dict_input(dict_len: usize, body_records: usize, variant: u32) -> Vec<u8> {
    let mut dict = make_corpus(dict_len.max(1), variant);
    if dict.len() > dict_len {
        dict.truncate(dict_len);
    }
    while dict.len() < dict_len {
        dict.extend_from_slice(
            b"DICT reusable phrase path=/api/v1/items template=/tenant/{id}/resource/{name}\n",
        );
    }
    dict.truncate(dict_len);

    let phrases = String::from_utf8_lossy(&dict[..dict.len().min(384)]).into_owned();
    let mut body = String::new();
    let plen = phrases.len().max(1);
    for i in 0..body_records {
        body.push_str("body record=");
        body.push_str(&i.to_string());
        body.push_str(" copied=\"");
        let start = (i * 13) % plen;
        let end = (start + 72).min(plen);
        if start < end {
            body.push_str(&phrases[start..end]);
        }
        body.push_str(
            "\" tail=\"reusable phrase reusable phrase /api/v1/items template=/tenant/{id}/resource/{name}\" lang=\"東京 résumé данные\" \n",
        );
    }

    let mut out = dict;
    out.extend_from_slice(body.as_bytes());
    out
}

fn encode_oneshot_with_params(
    data: &[u8],
    quality: i32,
    lgwin: i32,
    mode: u32,
) -> (i32, Vec<u8>) {
    unsafe {
        let max_size = BrotliEncoderMaxCompressedSize(data.len()) as usize;
        let mut out = vec![0u8; max_size.max(1)];
        let mut encoded_size = out.len();
        let ok = BrotliEncoderCompress(
            quality,
            lgwin,
            mode,
            data.len() as _,
            data.as_ptr(),
            &mut encoded_size as *mut usize as *mut _,
            out.as_mut_ptr(),
        );
        if ok == 0 {
            (0, Vec::new())
        } else {
            out.truncate(encoded_size.min(out.len()));
            (ok, out)
        }
    }
}

struct StreamEncResult {
    status: i32,
    finished: i32,
    compressed: Vec<u8>,
    total_out: usize,
    prep_size: usize,
    attach_ok: i32,
}

unsafe fn stream_encode_with_quality(
    data: &[u8],
    dict: Option<&[u8]>,
    quality: u32,
    lgwin: u32,
    mode: u32,
) -> StreamEncResult {
    let st = BrotliEncoderCreateInstance(None, None, ptr::null_mut());
    if st.is_null() {
        return StreamEncResult {
            status: 0,
            finished: 0,
            compressed: Vec::new(),
            total_out: 0,
            prep_size: 0,
            attach_ok: 0,
        };
    }

    let mut prep = ptr::null_mut();
    let mut prep_size = 0usize;
    let mut attach_ok = 0i32;

    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_MODE, mode);
    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_QUALITY, quality);
    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_LGWIN, lgwin);

    if let Some(d) = dict {
        prep = BrotliEncoderPrepareDictionary(
            BROTLI_SHARED_DICTIONARY_RAW,
            d.len() as _,
            d.as_ptr(),
            quality as i32,
            None,
            None,
            ptr::null_mut(),
        );
        if !prep.is_null() {
            prep_size = BrotliEncoderGetPreparedDictionarySize(prep as *const _) as usize;
            attach_ok = BrotliEncoderAttachPreparedDictionary(st as *mut _, prep as *const _);
        }
    }

    let mut out = Vec::new();
    let mut offset = 0usize;
    let chunk = 1024usize;
    let mut total_out = 0usize;
    let mut status = 0i32;
    let mut steps = 0usize;

    loop {
        let remaining = data.len().saturating_sub(offset);
        let give = remaining.min(chunk);
        let op = if remaining == 0 {
            BROTLI_OPERATION_FINISH
        } else {
            BROTLI_OPERATION_PROCESS
        };
        let mut available_in = give;
        let mut next_in = if give == 0 {
            data.as_ptr()
        } else {
            data[offset..].as_ptr()
        };
        let mut available_out = 0usize;
        let mut next_out = ptr::null_mut::<u8>();
        let mut total_out_now = total_out;
        status = BrotliEncoderCompressStream(
            st as *mut _,
            op,
            &mut available_in as *mut usize as *mut _,
            &mut next_in as *mut *const u8 as *mut _,
            &mut available_out as *mut usize as *mut _,
            &mut next_out as *mut *mut u8 as *mut _,
            &mut total_out_now as *mut usize as *mut _,
        );
        total_out = total_out_now;

        let consumed = give.saturating_sub(available_in);
        offset = offset.saturating_add(consumed);

        loop {
            let mut sz = 0usize;
            let p = BrotliEncoderTakeOutput(st as *mut _, &mut sz as *mut usize as *mut _);
            if p.is_null() || sz == 0 {
                break;
            }
            out.extend_from_slice(std::slice::from_raw_parts(p, sz));
        }

        steps = steps.saturating_add(1);
        if BrotliEncoderIsFinished(st as *mut _) != 0
            && BrotliEncoderHasMoreOutput(st as *mut _) == 0
        {
            break;
        }
        if status == 0 {
            break;
        }
        if steps > data.len().saturating_mul(4).saturating_add(4096) {
            break;
        }
    }

    let finished = BrotliEncoderIsFinished(st as *mut _);
    if !prep.is_null() {
        BrotliEncoderDestroyPreparedDictionary(prep as *mut _);
    }
    BrotliEncoderDestroyInstance(st as *mut _);

    StreamEncResult {
        status,
        finished,
        compressed: out,
        total_out,
        prep_size,
        attach_ok,
    }
}

struct StreamDecResult {
    result: i32,
    used: i32,
    finished: i32,
    err_code: i32,
    output: Vec<u8>,
}

unsafe fn stream_decode(data: &[u8], dict: Option<&[u8]>, disable_realloc: u32) -> StreamDecResult {
    let st = BrotliDecoderCreateInstance(None, None, ptr::null_mut());
    if st.is_null() {
        return StreamDecResult {
            result: 0,
            used: 0,
            finished: 0,
            err_code: 0,
            output: Vec::new(),
        };
    }

    let _ = BrotliDecoderSetMetadataCallbacks(st as *mut _, None, None, ptr::null_mut());
    let _ = BrotliDecoderSetParameter(
        st as *mut _,
        BROTLI_DECODER_PARAM_DISABLE_RING_BUFFER_REALLOCATION,
        disable_realloc,
    );

    if let Some(d) = dict {
        let _ = BrotliDecoderAttachDictionary(
            st as *mut _,
            BROTLI_SHARED_DICTIONARY_RAW,
            d.len() as _,
            d.as_ptr(),
        );
    }

    let mut out = Vec::new();
    let mut offset = 0usize;
    let chunk = 767usize;
    let mut result = 0i32;
    let mut steps = 0usize;

    loop {
        let remaining = data.len().saturating_sub(offset);
        let give = remaining.min(chunk);
        let mut available_in = give;
        let mut next_in = if give == 0 {
            data.as_ptr()
        } else {
            data[offset..].as_ptr()
        };
        let mut available_out = 0usize;
        let mut next_out = ptr::null_mut::<u8>();
        let mut total_out = out.len();

        let r = BrotliDecoderDecompressStream(
            st as *mut _,
            &mut available_in as *mut usize as *mut _,
            &mut next_in as *mut *const u8 as *mut _,
            &mut available_out as *mut usize as *mut _,
            &mut next_out as *mut *mut u8 as *mut _,
            &mut total_out as *mut usize as *mut _,
        );
        result = r as i32;

        let consumed = give.saturating_sub(available_in);
        offset = offset.saturating_add(consumed);

        loop {
            let mut sz = 0usize;
            let p = BrotliDecoderTakeOutput(st as *mut _, &mut sz as *mut usize as *mut _);
            if p.is_null() || sz == 0 {
                break;
            }
            out.extend_from_slice(std::slice::from_raw_parts(p, sz));
        }

        steps = steps.saturating_add(1);
        if result == BROTLI_DECODER_RESULT_SUCCESS as i32
            && BrotliDecoderHasMoreOutput(st as *const _) == 0
        {
            break;
        }
        if result != BROTLI_DECODER_RESULT_NEEDS_MORE_OUTPUT as i32
            && remaining == 0
            && consumed == 0
        {
            break;
        }
        if steps > data.len().saturating_mul(8).saturating_add(4096) {
            break;
        }
    }

    let used = BrotliDecoderIsUsed(st as *const _) as i32;
    let finished = BrotliDecoderIsFinished(st as *const _) as i32;
    let err_code = BrotliDecoderGetErrorCode(st as *const _) as i32;
    BrotliDecoderDestroyInstance(st as *mut _);

    StreamDecResult {
        result,
        used,
        finished,
        err_code,
        output: out,
    }
}

pub fn encode_buffer(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let version = unsafe { BrotliEncoderVersion() as u64 };
    let variants = [
        (0i32, 16i32, BROTLI_MODE_GENERIC),
        (1, 18, BROTLI_MODE_TEXT),
        (4, 20, BROTLI_MODE_FONT),
        (5, 20, BROTLI_MODE_GENERIC),
        (9, 22, BROTLI_MODE_TEXT),
        (10, 22, BROTLI_MODE_FONT),
        (11, 22, BROTLI_MODE_GENERIC),
    ];
    let mut digest = 0u64;
    let mut last_ok = 0i32;
    let mut last_size = 0usize;
    let mut last_peak = 0usize;
    let mut last_mode = 0u32;

    for _ in 0..iters {
        for &(q, lgwin, mode) in &variants {
            let peak =
                unsafe { BrotliEncoderEstimatePeakMemoryUsage(q, lgwin, data.len() as _) } as usize;
            let (ok, out) = encode_oneshot_with_params(data, q, lgwin, mode);
            last_ok = ok;
            last_size = out.len();
            last_peak = peak;
            last_mode = mode;
            digest = fold(digest, input_ck);
            digest = fold(digest, version);
            digest = fold(digest, q as u64);
            digest = fold(digest, lgwin as u64);
            digest = fold(digest, mode as u64);
            digest = fold(digest, peak as u64);
            digest = fold(digest, ok as u64);
            digest = fold(digest, out.len() as u64);
            digest = fold(digest, sample_checksum(&out));
        }
    }

    format!(
        "op=encode_buffer ok={} size={} peak={} mode={} ver={} digest={:016x}",
        last_ok, last_size, last_peak, last_mode, version, digest
    )
}

pub fn decode_buffer(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let version = unsafe { BrotliDecoderVersion() as u64 };
    let err_str_seed = unsafe {
        let zero_code = std::mem::zeroed();
        cstr_checksum(BrotliDecoderErrorString(zero_code))
    };

    let mut digest = 0u64;
    let mut last_result = 0i32;
    let mut last_size = 0usize;
    let mut last_err_ck = 0u64;
    let mut last_stream_used = 0i32;
    let mut last_stream_err = 0i32;

    for _ in 0..iters {
        let mut cap = data.len().saturating_mul(8).saturating_add(4096).max(4096);
        let mut tries = 0usize;
        let mut final_out = Vec::new();
        let mut final_result = 0i32;

        loop {
            let mut out = vec![0u8; cap];
            let mut decoded_size = out.len();
            let result = unsafe {
                BrotliDecoderDecompress(
                    data.len() as _,
                    data.as_ptr(),
                    &mut decoded_size as *mut usize as *mut _,
                    out.as_mut_ptr(),
                )
            } as i32;
            final_result = result;

            if result == BROTLI_DECODER_RESULT_SUCCESS as i32 {
                out.truncate(decoded_size.min(out.len()));
                final_out = out;
                break;
            }
            if result == BROTLI_DECODER_RESULT_NEEDS_MORE_OUTPUT as i32 && tries < 6 {
                cap = cap.saturating_mul(2);
                tries += 1;
                continue;
            }
            final_out.clear();
            break;
        }

        let stream = unsafe { stream_decode(data, None, 0) };

        last_result = final_result;
        last_size = final_out.len();
        last_err_ck = err_str_seed;
        last_stream_used = stream.used;
        last_stream_err = stream.err_code;

        digest = fold(digest, input_ck);
        digest = fold(digest, version);
        digest = fold(digest, final_result as u64);
        digest = fold(digest, last_size as u64);
        digest = fold(digest, sample_checksum(&final_out));
        digest = fold(digest, stream.result as u64);
        digest = fold(digest, stream.used as u64);
        digest = fold(digest, stream.finished as u64);
        digest = fold(digest, stream.err_code as u64);
        digest = fold(digest, sample_checksum(&stream.output));
        digest = fold(digest, last_err_ck);
    }

    format!(
        "op=decode_buffer result={} size={} used={} serr={} ver={} errstr={:016x} digest={:016x}",
        last_result, last_size, last_stream_used, last_stream_err, version, last_err_ck, digest
    )
}

pub fn stream_roundtrip(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let variants = [
        (1u32, 18u32, BROTLI_MODE_GENERIC),
        (5, 20, BROTLI_MODE_TEXT),
        (9, 22, BROTLI_MODE_FONT),
        (11, 22, BROTLI_MODE_GENERIC),
    ];
    let mut digest = 0u64;
    let mut last_est = 0i32;
    let mut last_dst = 0i32;
    let mut last_comp = 0usize;
    let mut last_decomp = 0usize;
    let mut last_finished = 0i32;
    let mut last_used = 0i32;
    let mut last_err = 0i32;
    let mut last_mode = 0u32;

    for _ in 0..iters {
        for &(q, lgwin, mode) in &variants {
            unsafe {
                let enc = stream_encode_with_quality(data, None, q, lgwin, mode);
                let dec = stream_decode(&enc.compressed, None, q & 1);

                last_est = enc.status;
                last_dst = dec.result;
                last_comp = enc.compressed.len();
                last_decomp = dec.output.len();
                last_finished = dec.finished;
                last_used = dec.used;
                last_err = dec.err_code;
                last_mode = mode;

                digest = fold(digest, input_ck);
                digest = fold(digest, q as u64);
                digest = fold(digest, lgwin as u64);
                digest = fold(digest, mode as u64);
                digest = fold(digest, enc.status as u64);
                digest = fold(digest, enc.finished as u64);
                digest = fold(digest, enc.total_out as u64);
                digest = fold(digest, sample_checksum(&enc.compressed));
                digest = fold(digest, dec.result as u64);
                digest = fold(digest, dec.used as u64);
                digest = fold(digest, dec.finished as u64);
                digest = fold(digest, dec.err_code as u64);
                digest = fold(digest, sample_checksum(&dec.output));
            }
        }
    }

    format!(
        "op=stream_roundtrip enc={} dec={} csize={} dsize={} finished={} used={} err={} mode={} digest={:016x}",
        last_est, last_dst, last_comp, last_decomp, last_finished, last_used, last_err, last_mode, digest
    )
}

pub fn shared_dict_roundtrip(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let dict_len = data.len().min(2048).max(data.len().min(128));
    let (dict, body) = data.split_at(dict_len.min(data.len()));
    let mut digest = 0u64;
    let mut last_prep_size = 0usize;
    let mut last_attach_enc = 0i32;
    let mut last_attach_shared = 0i32;
    let mut last_attach_dec = 0i32;
    let mut last_enc = 0i32;
    let mut last_dec = 0i32;
    let mut last_out = 0usize;
    let mut last_err = 0i32;
    let mut last_mode = 0u32;

    for _ in 0..iters {
        unsafe {
            for &(q, lgwin, mode) in &[
                (5u32, 20u32, BROTLI_MODE_TEXT),
                (11u32, 22u32, BROTLI_MODE_GENERIC),
            ] {
                let enc = stream_encode_with_quality(body, Some(dict), q, lgwin, mode);

                let shared = BrotliSharedDictionaryCreateInstance(None, None, ptr::null_mut());
                let mut attach_shared = 0i32;
                if !shared.is_null() {
                    attach_shared = BrotliSharedDictionaryAttach(
                        shared as *mut _,
                        BROTLI_SHARED_DICTIONARY_RAW,
                        dict.len() as _,
                        dict.as_ptr(),
                    );
                }

                let dec = stream_decode(&enc.compressed, Some(dict), q & 1);

                if !shared.is_null() {
                    BrotliSharedDictionaryDestroyInstance(shared as *mut _);
                }

                last_prep_size = enc.prep_size;
                last_attach_enc = enc.attach_ok;
                last_attach_shared = attach_shared;
                last_attach_dec = if dict.is_empty() { 0 } else { 1 };
                last_enc = enc.status;
                last_dec = dec.result;
                last_out = dec.output.len();
                last_err = dec.err_code;
                last_mode = mode;

                digest = fold(digest, input_ck);
                digest = fold(digest, dict.len() as u64);
                digest = fold(digest, q as u64);
                digest = fold(digest, lgwin as u64);
                digest = fold(digest, mode as u64);
                digest = fold(digest, enc.prep_size as u64);
                digest = fold(digest, enc.attach_ok as u64);
                digest = fold(digest, attach_shared as u64);
                digest = fold(digest, last_attach_dec as u64);
                digest = fold(digest, enc.status as u64);
                digest = fold(digest, dec.result as u64);
                digest = fold(digest, dec.err_code as u64);
                digest = fold(digest, sample_checksum(&enc.compressed));
                digest = fold(digest, sample_checksum(&dec.output));
            }
        }
    }

    format!(
        "op=shared_dict_roundtrip prep={} aenc={} ashared={} adec={} enc={} dec={} out={} err={} mode={} digest={:016x}",
        last_prep_size,
        last_attach_enc,
        last_attach_shared,
        last_attach_dec,
        last_enc,
        last_dec,
        last_out,
        last_err,
        last_mode,
        digest
    )
}

pub fn api_sweep(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let utf8_input = if data.is_empty() { b"x".as_slice() } else { data };
    let entropy_pop: Vec<u32> = data
        .chunks(4)
        .take(128)
        .map(|c| c.iter().fold(0u32, |a, &b| a.wrapping_mul(257).wrapping_add(b as u32)) | 1)
        .collect();
    let entropy_pop = if entropy_pop.is_empty() {
        vec![1, 2, 3, 4]
    } else {
        entropy_pop
    };
    let transform_idx = (input_ck % 8) as i32;
    let error_string_ck = unsafe {
        let zero_code = std::mem::zeroed();
        cstr_checksum(BrotliDecoderErrorString(zero_code))
    };

    let mut digest = 0u64;
    let mut last_utf8 = 0i32;
    let mut last_word_len = 0i32;
    let mut last_alloc_nonnull = 0u64;
    let mut last_dict_nonnull = 0u64;
    let mut last_enc_init = 0i32;
    let mut last_dec_init = 0i32;
    let mut last_entropy_ck = 0u64;
    let mut last_transform_ck = 0u64;
    let set_dict_len = data.len().min(64);

    for _ in 0..iters {
        unsafe {
            last_enc_init = BrotliEncoderEnsureStaticInit() as i32;
            last_dec_init = BrotliDecoderEnsureStaticInit() as i32;

            if set_dict_len != 0 {
                BrotliSetDictionaryData(data.as_ptr());
            }

            let dict_ptr = BrotliGetDictionary();
            last_dict_nonnull = (!dict_ptr.is_null()) as u64;

            let transforms = BrotliGetTransforms();
            let word = b"compress\0";
            let mut transformed = [0u8; 128];
            last_word_len = if transforms.is_null() {
                0
            } else {
                BrotliTransformDictionaryWord(
                    transformed.as_mut_ptr(),
                    word.as_ptr(),
                    (word.len() - 1) as i32,
                    transforms,
                    transform_idx,
                )
            };
            let transformed_len = (last_word_len.max(0) as usize).min(transformed.len());
            last_transform_ck = sample_checksum(&transformed[..transformed_len]);

            let mem = BrotliDefaultAllocFunc(ptr::null_mut(), 256);
            last_alloc_nonnull = (!mem.is_null()) as u64;
            if !mem.is_null() {
                ptr::write_bytes(mem, 0xA5, 256);
                BrotliDefaultFreeFunc(ptr::null_mut(), mem);
            }

            last_utf8 = BrotliIsMostlyUTF8(
                utf8_input.as_ptr(),
                0,
                utf8_input.len().saturating_sub(1),
                utf8_input.len(),
                0.25f64,
            ) as i32;

            let bits_entropy = BrotliBitsEntropy(entropy_pop.as_ptr(), entropy_pop.len() as _);
            last_entropy_ck = bits_entropy.to_bits();

            digest = fold(digest, input_ck);
            digest = fold(digest, last_enc_init as u64);
            digest = fold(digest, last_dec_init as u64);
            digest = fold(digest, last_dict_nonnull);
            digest = fold(digest, set_dict_len as u64);
            digest = fold(digest, last_word_len as u64);
            digest = fold(digest, last_transform_ck);
            digest = fold(digest, last_alloc_nonnull);
            digest = fold(digest, last_utf8 as u64);
            digest = fold(digest, last_entropy_ck);
            digest = fold(digest, error_string_ck);
        }
    }

    format!(
        "op=api_sweep utf8={} wordlen={} alloc={} dict={} einit={} dinit={} entropy={:016x} xform={:016x} digest={:016x}",
        last_utf8,
        last_word_len,
        last_alloc_nonnull,
        last_dict_nonnull,
        last_enc_init,
        last_dec_init,
        last_entropy_ck,
        last_transform_ck,
        digest
    )
}

pub fn lowlevel_probe(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let probe_input = if data.is_empty() { b"\x00".as_slice() } else { data };

    let ring_len = probe_input.len().next_power_of_two().max(1);
    let mut ring = vec![0u8; ring_len];
    for (i, b) in ring.iter_mut().enumerate() {
        *b = probe_input[i % probe_input.len()];
    }
    let ring_mask = ring_len - 1;

    let alloc_sz = probe_input.len().min(4096).max(32);
    let read_bits = ((probe_input[0] as u64) & 31).min(24);

    let mut digest = 0u64;
    let mut last_store_ck = 0u64;
    let mut last_store_bits = 0usize;
    let mut last_meta_set = 0u64;
    let mut last_warm = 0i32;
    let mut last_read_ok = 0i32;
    let mut last_read_val = 0u64;
    let mut last_alloc_nonnull = 0u64;
    let mut last_boot_nonnull = 0u64;

    for _ in 0..iters {
        unsafe {
            let mut storage = vec![0u8; probe_input.len().saturating_add(64).max(64)];
            let mut storage_ix = 0usize;
            BrotliStoreUncompressedMetaBlock(
                1,
                ring.as_ptr(),
                0,
                ring_mask,
                probe_input.len(),
                &mut storage_ix as *mut usize as *mut _,
                storage.as_mut_ptr(),
            );
            let bytes_written = ((storage_ix.saturating_add(7)) / 8).min(storage.len());
            last_store_bits = storage_ix;
            last_store_ck = sample_checksum(&storage[..bytes_written]);

            let dec = BrotliDecoderCreateInstance(None, None, ptr::null_mut());
            last_meta_set = 0;
            if !dec.is_null() {
                BrotliDecoderSetMetadataCallbacks(dec as *mut _, None, None, ptr::null_mut());
                last_meta_set = 1;
                BrotliDecoderDestroyInstance(dec as *mut _);
            }

            let mut br: BrotliBitReader = MaybeUninit::zeroed().assume_init();
            BrotliInitBitReader(&mut br as *mut _);
            last_warm = BrotliWarmupBitReader(&mut br as *mut _) as i32;
            let mut val = 0u64;
            last_read_ok =
                BrotliSafeReadBits32Slow(&mut br as *mut _, read_bits, &mut val as *mut _) as i32;
            last_read_val = val;

            let mut mm: MemoryManager = MaybeUninit::zeroed().assume_init();
            BrotliInitMemoryManager(
                &mut mm as *mut _,
                Some(BrotliDefaultAllocFunc),
                Some(BrotliDefaultFreeFunc),
                ptr::null_mut(),
            );
            let p = BrotliAllocate(&mut mm as *mut _, alloc_sz);
            last_alloc_nonnull = (!p.is_null()) as u64;
            if !p.is_null() {
                ptr::write_bytes(p, 0x5A, alloc_sz);
                BrotliFree(&mut mm as *mut _, p);
            }

            let bp = BrotliBootstrapAlloc(
                alloc_sz,
                Some(BrotliDefaultAllocFunc),
                Some(BrotliDefaultFreeFunc),
                ptr::null_mut(),
            );
            last_boot_nonnull = (!bp.is_null()) as u64;
            if !bp.is_null() {
                BrotliBootstrapFree(bp, &mut mm as *mut _);
            }
            BrotliWipeOutMemoryManager(&mut mm as *mut _);

            digest = fold(digest, input_ck);
            digest = fold(digest, ring_mask as u64);
            digest = fold(digest, last_store_bits as u64);
            digest = fold(digest, last_store_ck);
            digest = fold(digest, last_meta_set);
            digest = fold(digest, last_warm as u64);
            digest = fold(digest, last_read_ok as u64);
            digest = fold(digest, last_read_val);
            digest = fold(digest, last_alloc_nonnull);
            digest = fold(digest, last_boot_nonnull);
        }
    }

    format!(
        "op=lowlevel_probe storebits={} storeck={:016x} metaset={} warm={} readok={} readval={} alloc={} boot={} digest={:016x}",
        last_store_bits,
        last_store_ck,
        last_meta_set,
        last_warm,
        last_read_ok,
        last_read_val,
        last_alloc_nonnull,
        last_boot_nonnull,
        digest
    )
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("encode_buffer", encode_buffer as fn(&[u8], u64) -> String),
        ("decode_buffer", decode_buffer as fn(&[u8], u64) -> String),
        ("stream_roundtrip", stream_roundtrip as fn(&[u8], u64) -> String),
        (
            "shared_dict_roundtrip",
            shared_dict_roundtrip as fn(&[u8], u64) -> String,
        ),
        ("api_sweep", api_sweep as fn(&[u8], u64) -> String),
        ("lowlevel_probe", lowlevel_probe as fn(&[u8], u64) -> String),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let enc1 = make_corpus(48, 1);
    let enc2 = make_binaryish_corpus(96, 2);

    for (idx, bytes) in [(1usize, &enc1), (2usize, &enc2)] {
        let path = format!("{}/encode_buffer.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed encode_buffer {}", path));
    }

    let dec1 = encode_oneshot_with_params(&make_corpus(120, 3), 1, 18, BROTLI_MODE_TEXT).1;
    let dec2 = encode_oneshot_with_params(&make_corpus(240, 4), 11, 22, BROTLI_MODE_GENERIC).1;
    for (idx, bytes) in [(1usize, &dec1), (2usize, &dec2)] {
        let path = format!("{}/decode_buffer.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed decode_buffer {}", path));
    }

    let srt1 = make_corpus(128, 5);
    let srt2 = make_binaryish_corpus(256, 6);
    for (idx, bytes) in [(1usize, &srt1), (2usize, &srt2)] {
        let path = format!("{}/stream_roundtrip.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed stream_roundtrip {}", path));
    }

    let sd1 = make_shared_dict_input(512, 64, 7);
    let sd2 = make_shared_dict_input(1024, 128, 8);
    for (idx, bytes) in [(1usize, &sd1), (2usize, &sd2)] {
        let path = format!("{}/shared_dict_roundtrip.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed shared_dict_roundtrip {}", path));
    }

    let api1 = make_corpus(32, 9);
    let api2 = make_binaryish_corpus(48, 10);
    for (idx, bytes) in [(1usize, &api1), (2usize, &api2)] {
        let path = format!("{}/api_sweep.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed api_sweep {}", path));
    }

    let ll1 = make_corpus(20, 15);
    let ll2 = make_binaryish_corpus(40, 16);
    for (idx, bytes) in [(1usize, &ll1), (2usize, &ll2)] {
        let path = format!("{}/lowlevel_probe.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed lowlevel_probe {}", path));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let big_plain = make_corpus(32_000, 11);
    let path = format!("{}/encode_buffer.perf.bin", dir);
    write_file(&path, &big_plain);
    lines.push(format!("perf encode_buffer {}", path));

    let big_comp = encode_oneshot_with_params(&big_plain, 11, 22, BROTLI_MODE_TEXT).1;
    let path = format!("{}/decode_buffer.perf.bin", dir);
    write_file(&path, &big_comp);
    lines.push(format!("perf decode_buffer {}", path));

    let big_stream = make_binaryish_corpus(48_000, 12);
    let path = format!("{}/stream_roundtrip.perf.bin", dir);
    write_file(&path, &big_stream);
    lines.push(format!("perf stream_roundtrip {}", path));

    let big_dict = make_shared_dict_input(4096, 24_000, 13);
    let path = format!("{}/shared_dict_roundtrip.perf.bin", dir);
    write_file(&path, &big_dict);
    lines.push(format!("perf shared_dict_roundtrip {}", path));

    let big_api = make_corpus(8192, 14);
    let path = format!("{}/api_sweep.perf.bin", dir);
    write_file(&path, &big_api);
    lines.push(format!("perf api_sweep {}", path));

    let big_ll = make_binaryish_corpus(16_000, 17);
    let path = format!("{}/lowlevel_probe.perf.bin", dir);
    write_file(&path, &big_ll);
    lines.push(format!("perf lowlevel_probe {}", path));

    lines
}
