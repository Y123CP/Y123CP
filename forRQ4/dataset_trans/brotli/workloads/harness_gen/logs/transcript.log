fn fold(acc: u64, x: u64) -> u64 {
    acc.rotate_left(7) ^ x.wrapping_mul(0x9E37_79B9_7F4A_7C15)
}

fn sample_checksum(bytes: &[u8]) -> u64 {
    let mut d = bytes.len() as u64;
    if bytes.is_empty() {
        return d;
    }
    let stride = bytes.len().saturating_div(32).max(1);
    let mut i = 0usize;
    let mut taken = 0usize;
    while i < bytes.len() && taken < 64 {
        d = fold(d, ((i as u64) << 8) | bytes[i] as u64);
        i = i.saturating_add(stride);
        taken += 1;
    }
    d = fold(d, bytes[0] as u64);
    d = fold(d, bytes[bytes.len() - 1] as u64);
    d
}

fn cstr_checksum(p: *const std::ffi::c_char) -> u64 {
    if p.is_null() {
        return 0;
    }
    let s = unsafe { CStr::from_ptr(p) }.to_bytes();
    sample_checksum(&s[..s.len().min(64)])
}

fn write_file(path: &str, bytes: &[u8]) {
    let _ = fs::create_dir_all(
        std::path::Path::new(path)
            .parent()
            .unwrap_or(std::path::Path::new(".")),
    );
    let _ = fs::write(path, bytes);
}

fn make_corpus(records: usize, variant: u32) -> Vec<u8> {
    let mut s = String::new();
    let words = [
        "alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "gamma", "hotel", "india",
        "juliet", "kilo", "lima", "mike", "november", "oscar", "papa",
    ];
    let paths = [
        "/api/v1/items",
        "/srv/app/cache",
        "/var/log/service",
        "/home/user/project",
        "/static/assets/img",
        "/data/archive/2024",
    ];
    let levels = ["INFO", "WARN", "DEBUG", "TRACE", "ERROR"];
    for i in 0..records {
        let w1 = words[(i + variant as usize) % words.len()];
        let w2 = words[(i * 7 + 3 + variant as usize) % words.len()];
        let p = paths[(i * 5 + variant as usize) % paths.len()];
        let lvl = levels[(i * 3 + variant as usize) % levels.len()];
        let ts = 1_700_000_000u64 + (i as u64 * 17) + variant as u64;
        let id = (i as u64).wrapping_mul(1315423911) ^ (variant as u64 * 0x9e37);
        s.push_str(lvl);
        s.push_str(" ts=");
        s.push_str(&ts.to_string());
        s.push_str(" path=");
        s.push_str(p);
        s.push_str(" msg=\"");
        s.push_str(w1);
        s.push(' ');
        s.push_str(w2);
        s.push_str(" request completed status=");
        s.push_str(if i % 11 == 0 { "500" } else { "200" });
        s.push_str(" template=/tenant/{id}/resource/{name}\" user=u");
        s.push_str(&(i % 97).to_string());
        s.push_str(" region=us-east-1 json={\"kind\":\"event\",\"id\":");
        s.push_str(&id.to_string());
        s.push_str(",\"name\":\"");
        s.push_str(w1);
        s.push_str("\",\"path\":\"");
        s.push_str(p);
        s.push_str("\",\"tags\":[\"");
        s.push_str(w1);
        s.push_str("\",\"");
        s.push_str(w2);
        s.push_str("\",\"repeated-template\"]}\n");
        if i % 4 == 0 {
            s.push_str(
                "repeat repeat repeat common prefix common suffix reusable phrase reusable phrase\n",
            );
        }
        if i % 9 == 0 {
            s.push_str(
                "GET /healthz HTTP/1.1 host=service.local ua=synthetic-benchmark/1.0 accept=*/*\n",
            );
        }
    }
    s.into_bytes()
}

fn make_shared_dict_input(dict_len: usize, body_records: usize, variant: u32) -> Vec<u8> {
    let mut dict = make_corpus(dict_len.max(1), variant);
    if dict.len() > dict_len {
        dict.truncate(dict_len);
    }
    while dict.len() < dict_len {
        dict.extend_from_slice(
            b"DICT reusable phrase path=/api/v1/items template=/tenant/{id}/resource/{name}\n",
        );
    }
    dict.truncate(dict_len);

    let phrases = String::from_utf8_lossy(&dict[..dict.len().min(256)]).into_owned();
    let mut body = String::new();
    for i in 0..body_records {
        body.push_str("body record=");
        body.push_str(&i.to_string());
        body.push_str(" copied=\"");
        let start = (i * 13) % phrases.len().max(1);
        let end = (start + 48).min(phrases.len());
        if start < end {
            body.push_str(&phrases[start..end]);
        }
        body.push_str(
            "\" tail=\"reusable phrase reusable phrase /api/v1/items template=/tenant/{id}/resource/{name}\" \n",
        );
    }

    let mut out = dict;
    out.extend_from_slice(body.as_bytes());
    out
}

fn encode_oneshot_fixed(data: &[u8]) -> Vec<u8> {
    unsafe {
        let max_size = BrotliEncoderMaxCompressedSize(data.len()) as usize;
        let mut out = vec![0u8; max_size.max(1)];
        let mut encoded_size = out.len();
        let ok = BrotliEncoderCompress(
            5,
            20,
            BROTLI_MODE_GENERIC,
            data.len() as _,
            data.as_ptr(),
            &mut encoded_size as *mut usize as *mut _,
            out.as_mut_ptr(),
        );
        if ok == 0 {
            Vec::new()
        } else {
            out.truncate(encoded_size);
            out
        }
    }
}

struct StreamEncResult {
    status: i32,
    finished: i32,
    compressed: Vec<u8>,
    total_out: usize,
    prep_size: usize,
    attach_ok: i32,
}

unsafe fn stream_encode(data: &[u8], dict: Option<&[u8]>) -> StreamEncResult {
    let st = BrotliEncoderCreateInstance(None, None, ptr::null_mut());
    if st.is_null() {
        return StreamEncResult {
            status: 0,
            finished: 0,
            compressed: Vec::new(),
            total_out: 0,
            prep_size: 0,
            attach_ok: 0,
        };
    }

    let mut prep = ptr::null_mut();
    let mut prep_size = 0usize;
    let mut attach_ok = 0i32;

    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_MODE, BROTLI_MODE_GENERIC as u32);
    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_QUALITY, 5);
    let _ = BrotliEncoderSetParameter(st as *mut _, BROTLI_PARAM_LGWIN, 20);

    if let Some(d) = dict {
        prep = BrotliEncoderPrepareDictionary(
            BROTLI_SHARED_DICTIONARY_RAW,
            d.len() as _,
            d.as_ptr(),
            5,
            None,
            None,
            ptr::null_mut(),
        );
        if !prep.is_null() {
            prep_size = BrotliEncoderGetPreparedDictionarySize(prep as *const _) as usize;
            attach_ok = BrotliEncoderAttachPreparedDictionary(st as *mut _, prep as *const _);
        }
    }

    let mut out = Vec::new();
    let mut offset = 0usize;
    let chunk = 1024usize;
    let mut total_out = 0usize;
    let mut status = 0i32;
    let mut steps = 0usize;

    loop {
        let remaining = data.len().saturating_sub(offset);
        let give = remaining.min(chunk);
        let op = if remaining == 0 {
            BROTLI_OPERATION_FINISH
        } else {
            BROTLI_OPERATION_PROCESS
        };
        let mut available_in = give;
        let mut next_in = if give == 0 {
            data.as_ptr()
        } else {
            data[offset..].as_ptr()
        };
        let mut available_out = 0usize;
        let mut next_out = ptr::null_mut::<u8>();
        let mut total_out_now = total_out;
        status = BrotliEncoderCompressStream(
            st as *mut _,
            op,
            &mut available_in as *mut usize as *mut _,
            &mut next_in as *mut *const u8 as *mut _,
            &mut available_out as *mut usize as *mut _,
            &mut next_out as *mut *mut u8 as *mut _,
            &mut total_out_now as *mut usize as *mut _,
        );
        total_out = total_out_now;

        let consumed = give.saturating_sub(available_in);
        offset = offset.saturating_add(consumed);

        loop {
            let mut sz = 0usize;
            let p = BrotliEncoderTakeOutput(st as *mut _, &mut sz as *mut usize as *mut _);
            if p.is_null() || sz == 0 {
                break;
            }
            out.extend_from_slice(std::slice::from_raw_parts(p, sz));
        }

        steps = steps.saturating_add(1);
        if BrotliEncoderIsFinished(st as *mut _) != 0 && BrotliEncoderHasMoreOutput(st as *mut _) == 0
        {
            break;
        }
        if status == 0 {
            break;
        }
        if steps > data.len().saturating_mul(4).saturating_add(2048) {
            break;
        }
    }

    let finished = BrotliEncoderIsFinished(st as *mut _);
    if !prep.is_null() {
        BrotliEncoderDestroyPreparedDictionary(prep as *mut _);
    }
    BrotliEncoderDestroyInstance(st as *mut _);

    StreamEncResult {
        status,
        finished,
        compressed: out,
        total_out,
        prep_size,
        attach_ok,
    }
}

struct StreamDecResult {
    result: i32,
    used: i32,
    finished: i32,
    err_code: i32,
    output: Vec<u8>,
}

unsafe fn stream_decode(data: &[u8], dict: Option<&[u8]>) -> StreamDecResult {
    let st = BrotliDecoderCreateInstance(None, None, ptr::null_mut());
    if st.is_null() {
        return StreamDecResult {
            result: 0,
            used: 0,
            finished: 0,
            err_code: 0,
            output: Vec::new(),
        };
    }

    let _ = BrotliDecoderSetParameter(
        st as *mut _,
        BROTLI_DECODER_PARAM_DISABLE_RING_BUFFER_REALLOCATION,
        0,
    );

    if let Some(d) = dict {
        let _ = BrotliDecoderAttachDictionary(
            st as *mut _,
            BROTLI_SHARED_DICTIONARY_RAW,
            d.len() as _,
            d.as_ptr(),
        );
    }

    let mut out = Vec::new();
    let mut offset = 0usize;
    let chunk = 767usize;
    let mut result = 0i32;
    let mut steps = 0usize;

    loop {
        let remaining = data.len().saturating_sub(offset);
        let give = remaining.min(chunk);
        let mut available_in = give;
        let mut next_in = if give == 0 {
            data.as_ptr()
        } else {
            data[offset..].as_ptr()
        };
        let mut available_out = 0usize;
        let mut next_out = ptr::null_mut::<u8>();
        let mut total_out = out.len();

        let r = BrotliDecoderDecompressStream(
            st as *mut _,
            &mut available_in as *mut usize as *mut _,
            &mut next_in as *mut *const u8 as *mut _,
            &mut available_out as *mut usize as *mut _,
            &mut next_out as *mut *mut u8 as *mut _,
            &mut total_out as *mut usize as *mut _,
        );
        result = r as i32;

        let consumed = give.saturating_sub(available_in);
        offset = offset.saturating_add(consumed);

        loop {
            let _more = BrotliDecoderHasMoreOutput(st as *const _) as i32;
            let mut sz = 0usize;
            let p = BrotliDecoderTakeOutput(st as *mut _, &mut sz as *mut usize as *mut _);
            if p.is_null() || sz == 0 {
                break;
            }
            out.extend_from_slice(std::slice::from_raw_parts(p, sz));
        }

        steps = steps.saturating_add(1);
        if result == BROTLI_DECODER_RESULT_SUCCESS as i32
            && BrotliDecoderHasMoreOutput(st as *const _) == 0
        {
            break;
        }
        if result != BROTLI_DECODER_RESULT_NEEDS_MORE_OUTPUT as i32 && remaining == 0 && consumed == 0 {
            break;
        }
        if steps > data.len().saturating_mul(8).saturating_add(4096) {
            break;
        }
    }

    let used = BrotliDecoderIsUsed(st as *const _) as i32;
    let finished = BrotliDecoderIsFinished(st as *const _) as i32;
    let err_code = BrotliDecoderGetErrorCode(st as *const _) as i32;
    BrotliDecoderDestroyInstance(st as *mut _);

    StreamDecResult {
        result,
        used,
        finished,
        err_code,
        output: out,
    }
}

pub fn encode_buffer(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let version = unsafe { BrotliEncoderVersion() as u64 };
    let mut digest = 0u64;
    let mut last_ok = 0i32;
    let mut last_size = 0usize;

    for _ in 0..iters {
        unsafe {
            let max_size = BrotliEncoderMaxCompressedSize(data.len() as _) as usize;
            let mut out = vec![0u8; max_size.max(1)];
            let mut encoded_size = out.len();
            let ok = BrotliEncoderCompress(
                5,
                20,
                BROTLI_MODE_GENERIC,
                data.len() as _,
                data.as_ptr(),
                &mut encoded_size as *mut usize as *mut _,
                out.as_mut_ptr(),
            );
            last_ok = ok;
            last_size = encoded_size.min(out.len());
            if ok != 0 {
                out.truncate(last_size);
            } else {
                out.clear();
            }
            let out_ck = sample_checksum(&out);
            digest = fold(digest, input_ck);
            digest = fold(digest, version);
            digest = fold(digest, ok as u64);
            digest = fold(digest, last_size as u64);
            digest = fold(digest, out_ck);
        }
    }

    format!(
        "op=encode_buffer ok={} size={} ver={} digest={:016x}",
        last_ok, last_size, version, digest
    )
}

pub fn decode_buffer(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let version = unsafe { BrotliDecoderVersion() as u64 };
    let err_str_seed = unsafe {
        let zero_code = std::mem::zeroed();
        cstr_checksum(BrotliDecoderErrorString(zero_code))
    };

    let mut digest = 0u64;
    let mut last_result = 0i32;
    let mut last_size = 0usize;
    let mut last_err_ck = 0u64;

    for _ in 0..iters {
        let mut cap = data.len().saturating_mul(8).saturating_add(4096).max(4096);
        let mut tries = 0usize;
        let mut final_out = Vec::new();
        let mut final_result = 0i32;

        loop {
            let mut out = vec![0u8; cap];
            let mut decoded_size = out.len();
            let result = unsafe {
                BrotliDecoderDecompress(
                    data.len() as _,
                    data.as_ptr(),
                    &mut decoded_size as *mut usize as *mut _,
                    out.as_mut_ptr(),
                )
            } as i32;
            final_result = result;

            if result == BROTLI_DECODER_RESULT_SUCCESS as i32 {
                out.truncate(decoded_size.min(out.len()));
                final_out = out;
                break;
            }
            if result == BROTLI_DECODER_RESULT_NEEDS_MORE_OUTPUT as i32 && tries < 6 {
                cap = cap.saturating_mul(2);
                tries += 1;
                continue;
            }
            final_out.clear();
            break;
        }

        last_result = final_result;
        last_size = final_out.len();
        last_err_ck = err_str_seed;
        digest = fold(digest, input_ck);
        digest = fold(digest, version);
        digest = fold(digest, final_result as u64);
        digest = fold(digest, last_size as u64);
        digest = fold(digest, sample_checksum(&final_out));
        digest = fold(digest, last_err_ck);
    }

    format!(
        "op=decode_buffer result={} size={} ver={} errstr={:016x} digest={:016x}",
        last_result, last_size, version, last_err_ck, digest
    )
}

pub fn stream_roundtrip(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let mut digest = 0u64;
    let mut last_est = 0i32;
    let mut last_dst = 0i32;
    let mut last_comp = 0usize;
    let mut last_decomp = 0usize;
    let mut last_finished = 0i32;
    let mut last_used = 0i32;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let enc = stream_encode(data, None);
            let dec = stream_decode(&enc.compressed, None);

            last_est = enc.status;
            last_dst = dec.result;
            last_comp = enc.compressed.len();
            last_decomp = dec.output.len();
            last_finished = dec.finished;
            last_used = dec.used;
            last_err = dec.err_code;

            digest = fold(digest, input_ck);
            digest = fold(digest, enc.status as u64);
            digest = fold(digest, enc.finished as u64);
            digest = fold(digest, enc.total_out as u64);
            digest = fold(digest, sample_checksum(&enc.compressed));
            digest = fold(digest, dec.result as u64);
            digest = fold(digest, dec.used as u64);
            digest = fold(digest, dec.finished as u64);
            digest = fold(digest, dec.err_code as u64);
            digest = fold(digest, sample_checksum(&dec.output));
        }
    }

    format!(
        "op=stream_roundtrip enc={} dec={} csize={} dsize={} finished={} used={} err={} digest={:016x}",
        last_est, last_dst, last_comp, last_decomp, last_finished, last_used, last_err, digest
    )
}

pub fn shared_dict_roundtrip(data: &[u8], iters: u64) -> String {
    let input_ck = sample_checksum(data);
    let dict_len = data.len().min(1024).max(data.len().min(64));
    let (dict, body) = data.split_at(dict_len.min(data.len()));
    let mut digest = 0u64;
    let mut last_prep_size = 0usize;
    let mut last_attach_enc = 0i32;
    let mut last_attach_shared = 0i32;
    let mut last_attach_dec = 0i32;
    let mut last_enc = 0i32;
    let mut last_dec = 0i32;
    let mut last_out = 0usize;
    let mut last_err = 0i32;

    for _ in 0..iters {
        unsafe {
            let enc = stream_encode(body, Some(dict));

            let shared = BrotliSharedDictionaryCreateInstance(None, None, ptr::null_mut());
            let mut attach_shared = 0i32;
            if !shared.is_null() {
                attach_shared = BrotliSharedDictionaryAttach(
                    shared as *mut _,
                    BROTLI_SHARED_DICTIONARY_RAW,
                    dict.len() as _,
                    dict.as_ptr(),
                );
            }

            let dec_state = BrotliDecoderCreateInstance(None, None, ptr::null_mut());
            let mut attach_dec = 0i32;
            let mut dec = StreamDecResult {
                result: 0,
                used: 0,
                finished: 0,
                err_code: 0,
                output: Vec::new(),
            };

            if !dec_state.is_null() {
                attach_dec = BrotliDecoderAttachDictionary(
                    dec_state as *mut _,
                    BROTLI_SHARED_DICTIONARY_RAW,
                    dict.len() as _,
                    dict.as_ptr(),
                );

                let _ = BrotliDecoderSetParameter(
                    dec_state as *mut _,
                    BROTLI_DECODER_PARAM_DISABLE_RING_BUFFER_REALLOCATION,
                    0,
                );

                let mut out = Vec::new();
                let mut offset = 0usize;
                let mut result = 0i32;
                let mut steps = 0usize;
                loop {
                    let remaining = enc.compressed.len().saturating_sub(offset);
                    let give = remaining.min(503);
                    let mut available_in = give;
                    let mut next_in = if give == 0 {
                        enc.compressed.as_ptr()
                    } else {
                        enc.compressed[offset..].as_ptr()
                    };
                    let mut available_out = 0usize;
                    let mut next_out = ptr::null_mut::<u8>();
                    let mut total_out = out.len();
                    result = BrotliDecoderDecompressStream(
                        dec_state as *mut _,
                        &mut available_in as *mut usize as *mut _,
                        &mut next_in as *mut *const u8 as *mut _,
                        &mut available_out as *mut usize as *mut _,
                        &mut next_out as *mut *mut u8 as *mut _,
                        &mut total_out as *mut usize as *mut _,
                    ) as i32;
                    offset = offset.saturating_add(give.saturating_sub(available_in));

                    loop {
                        let mut sz = 0usize;
                        let p =
                            BrotliDecoderTakeOutput(dec_state as *mut _, &mut sz as *mut usize as *mut _);
                        if p.is_null() || sz == 0 {
                            break;
                        }
                        out.extend_from_slice(std::slice::from_raw_parts(p, sz));
                    }

                    steps = steps.saturating_add(1);
                    if result == BROTLI_DECODER_RESULT_SUCCESS as i32
                        && BrotliDecoderHasMoreOutput(dec_state as *const _) == 0
                    {
                        break;
                    }
                    if remaining == 0 && give == 0 {
                        break;
                    }
                    if steps > enc.compressed.len().saturating_mul(8).saturating_add(4096) {
                        break;
                    }
                }

                dec = StreamDecResult {
                    result,
                    used: BrotliDecoderIsUsed(dec_state as *const _) as i32,
                    finished: BrotliDecoderIsFinished(dec_state as *const _) as i32,
                    err_code: BrotliDecoderGetErrorCode(dec_state as *const _) as i32,
                    output: out,
                };
                BrotliDecoderDestroyInstance(dec_state as *mut _);
            }

            if !shared.is_null() {
                BrotliSharedDictionaryDestroyInstance(shared as *mut _);
            }

            last_prep_size = enc.prep_size;
            last_attach_enc = enc.attach_ok;
            last_attach_shared = attach_shared;
            last_attach_dec = attach_dec;
            last_enc = enc.status;
            last_dec = dec.result;
            last_out = dec.output.len();
            last_err = dec.err_code;

            digest = fold(digest, input_ck);
            digest = fold(digest, dict.len() as u64);
            digest = fold(digest, enc.prep_size as u64);
            digest = fold(digest, enc.attach_ok as u64);
            digest = fold(digest, attach_shared as u64);
            digest = fold(digest, attach_dec as u64);
            digest = fold(digest, enc.status as u64);
            digest = fold(digest, dec.result as u64);
            digest = fold(digest, dec.err_code as u64);
            digest = fold(digest, sample_checksum(&dec.output));
        }
    }

    format!(
        "op=shared_dict_roundtrip prep={} aenc={} ashared={} adec={} enc={} dec={} out={} err={} digest={:016x}",
        last_prep_size,
        last_attach_enc,
        last_attach_shared,
        last_attach_dec,
        last_enc,
        last_dec,
        last_out,
        last_err,
        digest
    )
}

pub fn ops() -> Vec<(&'static str, fn(&[u8], u64) -> String)> {
    vec![
        ("encode_buffer", encode_buffer as fn(&[u8], u64) -> String),
        ("decode_buffer", decode_buffer as fn(&[u8], u64) -> String),
        ("stream_roundtrip", stream_roundtrip as fn(&[u8], u64) -> String),
        (
            "shared_dict_roundtrip",
            shared_dict_roundtrip as fn(&[u8], u64) -> String,
        ),
    ]
}

pub fn gen_seeds(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let enc1 = make_corpus(32, 1);
    let enc2 = make_corpus(96, 2);

    for (idx, bytes) in [(1usize, &enc1), (2usize, &enc2)] {
        let path = format!("{}/encode_buffer.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed encode_buffer {}", path));
    }

    let dec1 = encode_oneshot_fixed(&make_corpus(40, 3));
    let dec2 = encode_oneshot_fixed(&make_corpus(120, 4));
    for (idx, bytes) in [(1usize, &dec1), (2usize, &dec2)] {
        let path = format!("{}/decode_buffer.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed decode_buffer {}", path));
    }

    let srt1 = make_corpus(48, 5);
    let srt2 = make_corpus(144, 6);
    for (idx, bytes) in [(1usize, &srt1), (2usize, &srt2)] {
        let path = format!("{}/stream_roundtrip.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed stream_roundtrip {}", path));
    }

    let sd1 = make_shared_dict_input(256, 32, 7);
    let sd2 = make_shared_dict_input(512, 96, 8);
    for (idx, bytes) in [(1usize, &sd1), (2usize, &sd2)] {
        let path = format!("{}/shared_dict_roundtrip.{}.bin", dir, idx);
        write_file(&path, bytes);
        lines.push(format!("seed shared_dict_roundtrip {}", path));
    }

    lines
}

pub fn gen_perf(dir: &str) -> Vec<String> {
    let mut lines = Vec::new();

    let big_plain = make_corpus(18_000, 11);
    let path = format!("{}/encode_buffer.perf.bin", dir);
    write_file(&path, &big_plain);
    lines.push(format!("perf encode_buffer {}", path));

    let big_comp = encode_oneshot_fixed(&big_plain);
    let path = format!("{}/decode_buffer.perf.bin", dir);
    write_file(&path, &big_comp);
    lines.push(format!("perf decode_buffer {}", path));

    let big_stream = make_corpus(16_000, 12);
    let path = format!("{}/stream_roundtrip.perf.bin", dir);
    write_file(&path, &big_stream);
    lines.push(format!("perf stream_roundtrip {}", path));

    let big_dict = make_shared_dict_input(2048, 14_000, 13);
    let path = format!("{}/shared_dict_roundtrip.perf.bin", dir);
    write_file(&path, &big_dict);
    lines.push(format!("perf shared_dict_roundtrip {}", path));

    lines
}

