          "replacement_function_source": "#[inline(always)]\nunsafe fn DecodeSymbol(\n    mut bits: uint64_t,\n    mut table: *const HuffmanCode,\n    mut br: *mut BrotliBitReader,\n) -> uint64_t {\n    let idx = (bits & 0xffu64) as isize;\n    // SAFETY: `table` points to a valid Huffman decoding table and `idx` is exactly the same first-level offset as in the original code.\n    let first = unsafe { &*table.offset(idx) };\n    let first_bits = first.bits as c_uint;\n\n    if first_bits > HUFFMAN_TABLE_BITS {\n        let nbits = first_bits.wrapping_sub(HUFFMAN_TABLE_BITS) as uint64_t;\n        BrotliDropBits(br, HUFFMAN_TABLE_BITS as uint64_t);\n        let sub_idx =\n            (first.value as uint64_t).wrapping_add((bits >> 8) & BitMask(nbits)) as isize;\n        // SAFETY: In the original code the second-level lookup is relative to the already-advanced `table` pointer (`table.offset(idx)`), not the original base pointer.\n        let second = unsafe { &*table.offset(idx).offset(sub_idx) };\n        BrotliDropBits(br, second.bits as uint64_t);\n        second.value as uint64_t\n    } else {\n        BrotliDropBits(br, first.bits as uint64_t);\n        first.value as uint64_t\n    }\n}",
