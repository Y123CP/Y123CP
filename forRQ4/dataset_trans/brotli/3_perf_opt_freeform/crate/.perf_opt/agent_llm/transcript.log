unsafe fn ComputeMinimumCopyLength(
    start_cost: c_float,
    mut nodes: *const ZopfliNode,
    num_bytes: size_t,
    pos: size_t,
) -> size_t {
    let mut min_cost: c_float = start_cost;
    let mut len: size_t = 2 as size_t;
    let mut next_len_bucket: size_t = 4 as size_t;
    let mut next_len_offset: size_t = 10 as size_t;

    let remaining = num_bytes.wrapping_sub(pos);
    if remaining < len {
        return len;
    }

    let mut p = nodes.wrapping_add(pos.wrapping_add(len));
    let end = nodes.wrapping_add(num_bytes);

    while p <= end
        && {
            // SAFETY: `p <= end == nodes.add(num_bytes)` and `p` starts at `nodes.add(pos + 2)`;
            // the loop only dereferences while `p <= end`, matching the original valid index range.
            unsafe { (*p).u.cost <= min_cost }
        }
    {
        len = len.wrapping_add(1);
        // SAFETY: advancing by 1 preserves the correspondence with `len`; dereference is guarded by `p <= end`.
        p = unsafe { p.add(1) };
        if len == next_len_offset {
            min_cost += 1.0f32;
            next_len_offset = next_len_offset.wrapping_add(next_len_bucket);
            next_len_bucket = next_len_bucket.wrapping_mul(2 as size_t);
        }
    }
    len
}
