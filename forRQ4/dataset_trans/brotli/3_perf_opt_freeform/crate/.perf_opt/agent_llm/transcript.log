unsafe fn DecodeSymbol(
    mut bits: uint64_t,
    mut table: *const HuffmanCode,
    mut br: *mut BrotliBitReader,
) -> uint64_t {
    table = table.offset((bits & 0xff as uint64_t) as isize);
