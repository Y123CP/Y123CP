    }
    *available_out_view = (*available_out_view as c_ulong)
        .wrapping_sub(num_written as c_ulong) as size_t as size_t;
    (*s).partial_pos_out = ((*s).partial_pos_out as c_ulong)
        .wrapping_add(num_written as c_ulong) as size_t
        as size_t;
